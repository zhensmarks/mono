{
  "id": "com.bengs.revisi",
  "name": "Revisi",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "23.0.0"
    }
  ],
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "revisiPanel",
      "name": "Revisi Actions",
      "minimumSize": {"width": 300, "height": 400},
      "maximumSize": {"width": 800, "height": 1200},
      "preferredDockedSize": {"width": 320, "height": 600},
      "preferredFloatingSize": {"width": 320, "height": 600}
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": true
  }
}
