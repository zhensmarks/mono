<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             mc:Ignorable="d" d:DesignWidth="150" d:DesignHeight="180"
             x:Class="BMachine.UI.Controls.StatWidget"
             x:Name="Root">
    
    <UserControl.Styles>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <Button Classes="Clear" 
                Command="{Binding #Root.Command}"
                Padding="0" 
                BorderThickness="0" 
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Cursor="Hand">
                
            <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="Button:pointerover Border#HoverGlow">
                    <Setter Property="Opacity" Value="0.03" />
                </Style>
                <Style Selector="Button:pointerover Border#NeonPillar">
                    <Setter Property="Margin" Value="0,0,16,0" />
                    <Setter Property="Opacity" Value="1.0" />
                </Style>
                <Style Selector="Button:pointerover PathIcon#Crosshair">
                    <Setter Property="Opacity" Value="1.0" />
                </Style>
                <Style Selector="Button:pointerover TextBlock#LabelText">
                    <Setter Property="Foreground" Value="#AAAAAA" />
                </Style>
            </Button.Styles>

            <!-- No enclosing border. Just floating elements over the canvas. -->
            <Border Padding="8,12,8,8" Background="Transparent">
                <Grid>
                
                <!-- Extremely faint background block on hover -->
                <Border x:Name="HoverGlow" Background="{Binding #Root.Color}" Opacity="0" CornerRadius="0">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                        </Transitions>
                    </Border.Transitions>
                </Border>

                <!-- Mechanical Crosshair (Top Left anchor point) -->
                <Grid Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-2,0,0">
                    <shapes:Rectangle Width="6" Height="1" Fill="{Binding #Root.Color}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <shapes:Rectangle Width="1" Height="6" Fill="{Binding #Root.Color}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <PathIcon x:Name="Crosshair" Data="M12 2v20M2 12h20" Width="10" Height="10" Foreground="{Binding #Root.Color}" Opacity="0.4">
                        <PathIcon.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                            </Transitions>
                        </PathIcon.Transitions>
                    </PathIcon>
                </Grid>

                <!-- Content Grid -->
                <Grid RowDefinitions="Auto,*" Margin="14,0,0,0">
                    
                    <!-- Top Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="LabelText"
                                   Text="{Binding #Root.Label}"
                                   Foreground="#666666"
                                   FontSize="8"
                                   LetterSpacing="4"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center">
                            <TextBlock.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Foreground" Duration="0:0:0.3"/>
                                </Transitions>
                            </TextBlock.Transitions>
                        </TextBlock>
                        
                        <!-- Open Window Command (Sleek Arrow) -->
                        <Button Grid.Column="1" 
                                Command="{Binding #Root.WindowCommand}"
                                IsVisible="{Binding #Root.WindowCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Width="16" Height="16"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                ToolTip.Tip="Open in New Window" Classes="Clear"
                                VerticalAlignment="Center"
                                Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover shapes|Path">
                                    <Setter Property="Fill" Value="{Binding #Root.Color}"/>
                                </Style>
                            </Button.Styles>
                            <shapes:Path Data="M14 3l-1.4 1.4L17.2 9H3v2h14.2l-4.6 4.6L14 17l7-7z" 
                                         Fill="#444444"
                                         Stretch="Uniform"
                                         Width="10" Height="10">
                                <shapes:Path.Transitions>
                                     <Transitions>
                                         <BrushTransition Property="Fill" Duration="0:0:0.2"/>
                                     </Transitions>
                                </shapes:Path.Transitions>
                            </shapes:Path>
                        </Button>
                    </Grid>
                    
                    <!-- MODE: BAR (Default) -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" VerticalAlignment="Bottom" IsVisible="{Binding #Root.IsBarMode}">
                        <!-- Moving Neon Pillar -->
                        <Border x:Name="NeonPillar" Grid.Column="0" Width="2" Background="{Binding #Root.Color}" 
                                Margin="0,0,12,0" CornerRadius="0" Opacity="0.5">
                            <Border.Transitions>
                                <Transitions>
                                    <ThicknessTransition Property="Margin" Duration="0:0:0.5">
                                        <ThicknessTransition.Easing>
                                            <SplineEasing X1="0.1" Y1="0.9" X2="0.2" Y2="1"/>
                                        </ThicknessTransition.Easing>
                                    </ThicknessTransition>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="0">
                            <!-- Monumental Number -->
                            <TextBlock x:Name="PART_BarValue"
                                       Text="{Binding #Root.Value}"
                                       FontSize="32"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       LetterSpacing="-2"
                                       Margin="-2,-4,0,0"/>
                            
                            <!-- Tracking Suffix -->
                            <TextBlock x:Name="PART_BarSuffix"
                                       Text="{Binding #Root.Suffix}"
                                       IsVisible="{Binding #Root.Suffix, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{Binding #Root.Color}"
                                       LetterSpacing="4"
                                       Margin="0,0,0,0"/>
                                       
                            <!-- Asymmetrical Brutalist Progress Line -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                                <Border Grid.Column="0" Height="2" Width="12" Background="{Binding #Root.Color}" CornerRadius="0"/>
                                <Border Grid.Column="1" Height="1" Background="#22FFFFFF" CornerRadius="0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    
                    <!-- MODE: CIRCULAR -->
                    <Grid Grid.Row="1" IsVisible="{Binding #Root.IsCircularMode}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-14,0,0,0">
                        <Panel Width="48" Height="48">
                            <!-- Extremely thin rings -->
                            <shapes:Arc Width="48" Height="48" StartAngle="0" SweepAngle="360" Stroke="#11FFFFFF" StrokeThickness="1"/>
                            
                            <shapes:Arc x:Name="PART_ProgressArc" Width="48" Height="48" StartAngle="-90" SweepAngle="{Binding #Root.SweepAngle}" Stroke="{Binding #Root.Color}" StrokeThickness="2" StrokeLineCap="Flat"/>
                                 
                            <TextBlock Text="{Binding #Root.Value}"
                                       FontSize="14"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Panel>
                    </Grid>
                    
                </Grid>
                </Grid>
            </Border>
        </Button>
    </Panel>
</UserControl>
