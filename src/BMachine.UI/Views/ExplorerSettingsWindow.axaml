<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:BMachine.UI.ViewModels"
        xmlns:views="using:BMachine.UI.Views"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="550"
        x:Class="BMachine.UI.Views.ExplorerSettingsWindow"
        x:DataType="vm:OutputExplorerViewModel"
        Title="Explorer Settings"
        Width="420" Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource CardBackgroundBrush}">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Header -->
        <Border Grid.Row="0" Padding="15,12" Background="{DynamicResource SubCardBackgroundBrush}">
            <DockPanel>
                <TextBlock Text="Explorer Settings" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource SeparatorBrush}"/>
        
        <!-- Tab Content -->
        <TabControl Grid.Row="1" Margin="0" Padding="0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="MinHeight" Value="40"/>
                    <Setter Property="Padding" Value="16,0"/>
                    <Setter Property="Margin" Value="0,0,12,0"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Style>
                <Style Selector="TabItem:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Style>
                <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
                    <Setter Property="IsVisible" Value="False"/>
                </Style>
                
                <!-- Segmented Control Styles for View Mode -->
                <Style Selector="RadioButton.Segmented">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                 <ContentPresenter Content="{TemplateBinding Content}"
                                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter>
                    <Setter Property="Transitions">
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.15"/>
                            <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="RadioButton.Segmented:checked">
                    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <Style Selector="RadioButton.Segmented:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Style>
                
                <!-- Toggle Switch styling for minimalism -->
                <Style Selector="ToggleSwitch">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Style>
            </TabControl.Styles>
            
            <!-- TAB: GENERAL -->
            <TabItem Header="General">
                <ScrollViewer Padding="32">
                    <StackPanel Spacing="32">
                        <!-- View Mode Section -->
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="VIEW MODE" FontWeight="Bold" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Default style for files &amp; folders." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            
                            <Border Background="{DynamicResource SubCardBackgroundBrush}" CornerRadius="6" Padding="4" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <RadioButton Content="List" IsChecked="{Binding IsVerticalLayout}" Classes="Segmented" FontSize="12"/>
                                    <RadioButton Content="Grid" IsChecked="{Binding IsHorizontalLayout}" Classes="Segmented" FontSize="12"/>
                                    <RadioButton Content="Thumbnails" IsChecked="{Binding IsThumbnailLayout}" Classes="Segmented" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                        
                        <!-- Layout Section -->
                        <StackPanel Spacing="16">
                            <TextBlock Text="LAYOUT &amp; NAVIGATION" FontWeight="Bold" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Show Path Bar" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Display the breadcrumb path bar at the top of the explorer." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsShowPathBar}" Margin="0,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- TAB: SHORTCUTS -->
            <TabItem Header="Shortcuts">
                <views:ExplorerSettingsView DataContext="{Binding ExplorerSettingsVM}" />
            </TabItem>
        </TabControl>
        
        <Border Grid.Row="2" Background="{DynamicResource SubCardBackgroundBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SeparatorBrush}" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Click="Close_Click" Classes="Primary" MinWidth="70" FontSize="12" Padding="15,6"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
