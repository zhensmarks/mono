<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BMachine.UI.ViewModels"
             xmlns:models="using:BMachine.UI.Models"
             xmlns:controls="using:BMachine.UI.Controls"
             xmlns:converters="using:BMachine.UI.Converters"
             xmlns:views="using:BMachine.UI.Views"
             x:Class="BMachine.UI.Views.UnifiedTrelloView"
             x:DataType="vm:UnifiedTrelloViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
             
    <Grid x:Name="Part_RootGrid" SizeChanged="OnRootGridSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="400" MinWidth="320" MaxWidth="650"/>
        </Grid.ColumnDefinitions>
        <GridSplitter x:Name="Part_DetailSplitter" Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SeparatorBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.7"
                      IsVisible="{Binding ShouldShowPanelScreen}"
                      ToolTip.Tip="Resize detail panel"/>
        
        <!-- LEFT COLUMN / LIST SCREEN: Status + Tabs + Card List + Bottom (compact: hidden when panel open) -->
        <Grid x:Name="Part_ListScreen" Grid.Column="0" IsVisible="{Binding IsListScreenVisible}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Status (top, window mode) -->
                <RowDefinition Height="Auto"/> <!-- Tab & Header Popup Area -->
                <RowDefinition Height="*"/>    <!-- Main Content List -->
                <RowDefinition Height="Auto"/> <!-- Status (bottom, embedded mode) -->
            </Grid.RowDefinitions>
        
        <!-- ROW 0: Top Status Bar (Window mode only) -->
        <Border Grid.Row="0" Margin="20,10,20,0" Padding="12,8" Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="12" IsVisible="{Binding IsNotEmbedded}">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Status Dot of Active ViewModel -->
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" ToolTip.Tip="{Binding ActiveViewModel.ConnectionStatusText, StringFormat='{}Status: {0}'}">
                        <Ellipse.Styles>
                            <Style Selector="Ellipse">
                                <Setter Property="Fill" Value="#EF4444"/> <!-- Red (Offline) -->
                            </Style>
                            <Style Selector="Ellipse.online">
                                <Setter Property="Fill" Value="#22C55E"/> <!-- Green (Online) -->
                            </Style>
                        </Ellipse.Styles>
                        <Classes.online>
                            <Binding Path="ActiveViewModel.IsOnline"/>
                        </Classes.online>
                        <Ellipse.Transitions>
                            <Transitions>
                                <BrushTransition Property="Fill" Duration="0:0:0.3"/>
                            </Transitions>
                        </Ellipse.Transitions>
                    </Ellipse>
                    <TextBlock Text="{Binding ActiveViewModel.StatusMessage}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>


                <!-- Action Toolbar (Top Right) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            Opacity="{Binding ActiveViewModel.HasSelectedCards, Converter={x:Static BoolConverters.Not}, ConverterParameter=False}"
                            IsHitTestVisible="{Binding !ActiveViewModel.HasSelectedCards}">
                    <!-- Add Manual Card Icon -->
                    <Button Command="{Binding AddManualCardCommand}"
                            IsVisible="{Binding IsEditingSelected}"
                            Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8" Cursor="Hand"
                            ToolTip.Tip="Add Manual Cards">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                            </Style>
                            <Style Selector="Button:pointerover PathIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                        </Button.Styles>
                        <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>

                    <!-- Refresh Icon -->
                    <Button Command="{Binding RefreshActiveListCommand}"
                            IsEnabled="{Binding !ActiveViewModel.IsRefreshing}"
                            Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8" Cursor="Hand"
                            ToolTip.Tip="Refresh Data">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                            </Style>
                            <Style Selector="Button:pointerover PathIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                        </Button.Styles>
                        <PathIcon Data="{StaticResource IconRefresh}" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ROW 1: Tabs & Header Area -->
        <Panel Grid.Row="1" Margin="20,10,40,10">
            
            <!-- Trello Board Tabs - card bordered, no icon (sesuai editing list yang benar) -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    IsVisible="{Binding !ActiveViewModel.HasSelectedCards}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <!-- EDITING Tab -->
                    <RadioButton Classes="TrelloBoardTab CompactTab" GroupName="TrelloBoardTabs" IsChecked="{Binding IsEditingSelected}" Command="{Binding SwitchToEditingCommand}">
                        <TextBlock Text="EDITING" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </RadioButton>
                    <!-- REVISI Tab -->
                    <RadioButton Classes="TrelloBoardTab CompactTab" GroupName="TrelloBoardTabs" IsChecked="{Binding IsRevisionSelected}" Command="{Binding SwitchToRevisionCommand}">
                        <TextBlock Text="REVISI" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </RadioButton>
                    <!-- SUSULAN Tab -->
                    <RadioButton Classes="TrelloBoardTab CompactTab" GroupName="TrelloBoardTabs" IsChecked="{Binding IsLateSelected}" Command="{Binding SwitchToLateCommand}">
                        <TextBlock Text="SUSULAN" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </RadioButton>
                </StackPanel>
            </Border>

             <!-- OVERLAY: Top Header Action Bar (Shows when cards are selected) -->
             <Border Background="#F418181B"
                     BorderBrush="#30FFFFFF" BorderThickness="1"
                     CornerRadius="8" HorizontalAlignment="Center" Padding="8,6"
                     Margin="0,0,0,10"
                     IsVisible="{Binding ActiveViewModel.HasSelectedCards}"
                     BoxShadow="0 4 16 0 #30000000, 0 0 0 1 #10FFFFFF inset" ZIndex="10">
                  <Border.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                      </Transitions>
                  </Border.Transitions>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                      <!-- Left: Selection Info & Toggle -->
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <!-- Select All / Deselect Toolbar Toggle -->
                          <ToggleButton IsChecked="{Binding ActiveViewModel.IsAllSelected, Mode=TwoWay}"
                                        Command="{Binding ActiveViewModel.ToggleSelectAllCardsCommand}"
                                        Classes="Clear" Padding="4" Background="Transparent" 
                                        CornerRadius="6" Cursor="Hand" ToolTip.Tip="Select All">
                              <ToggleButton.Styles>
                                  <Style Selector="ToggleButton">
                                      <Setter Property="Transitions">
                                          <Transitions>
                                              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                                          </Transitions>
                                      </Setter>
                                  </Style>
                                  <Style Selector="ToggleButton:pointerover">
                                      <Setter Property="Background" Value="#10FFFFFF"/>
                                      <Setter Property="RenderTransform" Value="scale(1.05)"/>
                                  </Style>
                                  <Style Selector="ToggleButton:checked PathIcon">
                                       <Setter Property="Data" Value="{StaticResource IconCheckSquare}"/>
                                       <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}"/>
                                  </Style>
                                  <Style Selector="ToggleButton:unchecked PathIcon">
                                       <Setter Property="Data" Value="{StaticResource IconSquare}"/>
                                       <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                  </Style>
                              </ToggleButton.Styles>
                              <PathIcon Width="12" Height="12"/>
                          </ToggleButton>
                          
                          <TextBlock Text="{Binding ActiveViewModel.CardsSelectedCount, StringFormat='Terpilih: {0}'}" 
                                     FontSize="12" FontWeight="SemiBold" 
                                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                      </StackPanel>
                      
                      <!-- Divider -->
                      <Rectangle Width="1" Height="20" Fill="{DynamicResource SeparatorBrush}" Opacity="0.3" VerticalAlignment="Center"/>
                      
                      <!-- Right: Batch Actions -->
                       <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Batch Unlink for Manual Cards -->
                            <Button Command="{Binding ActiveViewModel.BatchUnlinkCommand}"
                                    IsVisible="{Binding ActiveViewModel.HasSelectedManualCards}"
                                    ToolTip.Tip="Putus Tautan"
                                    Background="#18EF4444" BorderBrush="#40EF4444" BorderThickness="1" 
                                    Foreground="#EF4444" Padding="8,4" CornerRadius="6" 
                                    Cursor="Hand" FontSize="11" Height="24">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="#28EF4444"/>
                                        <Setter Property="RenderTransform" Value="scale(1.02)"/>
                                    </Style>
                                    <Style Selector="Button:pressed">
                                        <Setter Property="RenderTransform" Value="scale(0.98)"/>
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="{StaticResource IconTrash}" Width="10" Height="10" Foreground="#EF4444"/>
                                    <TextBlock Text="Unlink" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                                
                                <!-- Batch ACC for Regular Cards -->
                                <Button Command="{Binding ActiveViewModel.BatchAccCommand}"
                                        IsVisible="{Binding ActiveViewModel.HasSelectedRegularCards}"
                                        ToolTip.Tip="ACC Marketing"
                                        Background="#180078D7" BorderBrush="#400078D7" BorderThickness="1" 
                                        Foreground="#0078D7" Padding="8,4" CornerRadius="6" 
                                        Cursor="Hand" FontSize="11" Height="24">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Transitions">
                                                <Transitions>
                                                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                                                </Transitions>
                                            </Setter>
                                        </Style>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="#280078D7"/>
                                            <Setter Property="RenderTransform" Value="scale(1.02)"/>
                                        </Style>
                                        <Style Selector="Button:pressed">
                                            <Setter Property="RenderTransform" Value="scale(0.98)"/>
                                        </Style>
                                    </Button.Styles>
                                    <TextBlock Text="ACC" FontWeight="SemiBold"/>
                                </Button>

                            <Button Command="{Binding ActiveViewModel.ShowBatchMovePanelCommand}"
                                    ToolTip.Tip="Pindah Massal"
                                    Classes="Action" Height="24" Padding="10,0" CornerRadius="6" 
                                    Cursor="Hand" FontSize="11">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="RenderTransform" Value="scale(1.02)"/>
                                    </Style>
                                    <Style Selector="Button:pressed">
                                        <Setter Property="RenderTransform" Value="scale(0.98)"/>
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="{StaticResource IconArrowRight}" Width="10" Height="10" Foreground="#111111"/>
                                    <TextBlock Text="Move" FontWeight="SemiBold" Foreground="#111111"/>
                                </StackPanel>
                            </Button>
                       </StackPanel>
                  </StackPanel>
             </Border>
            
        </Panel>

        <!-- ROW 2: Dynamic Content Area -->
        <ContentControl Grid.Row="2" Content="{Binding ActiveViewModel}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="{x:Type vm:EditingCardListViewModel}">
                    <views:EditingCardListView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:RevisionCardListViewModel}">
                    <views:RevisionCardListView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:LateCardListViewModel}">
                    <views:LateCardListView DataContext="{Binding}" />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

        <!-- Loading Bar (thin, at top of content area) -->
        <ProgressBar Grid.Row="2" VerticalAlignment="Top" ZIndex="5"
                     IsIndeterminate="True"
                     IsVisible="{Binding ActiveViewModel.IsRefreshing}"
                     Height="2" Margin="0"
                     Foreground="{DynamicResource AccentColorBrush}"/>

        <!-- ROW 3: Bottom Status Bar (Embedded/Dashboard mode only) -->
        <Border Grid.Row="3" Margin="20,10,20,10" Padding="12,8" Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="12" IsVisible="{Binding IsEmbedded}">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Status Dot -->
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" ToolTip.Tip="{Binding ActiveViewModel.ConnectionStatusText, StringFormat='{}Status: {0}'}">
                        <Ellipse.Styles>
                            <Style Selector="Ellipse">
                                <Setter Property="Fill" Value="#EF4444"/>
                            </Style>
                            <Style Selector="Ellipse.online">
                                <Setter Property="Fill" Value="#22C55E"/>
                            </Style>
                        </Ellipse.Styles>
                        <Classes.online>
                            <Binding Path="ActiveViewModel.IsOnline"/>
                        </Classes.online>
                        <Ellipse.Transitions>
                            <Transitions>
                                <BrushTransition Property="Fill" Duration="0:0:0.3"/>
                            </Transitions>
                        </Ellipse.Transitions>
                    </Ellipse>
                    <TextBlock Text="{Binding ActiveViewModel.StatusMessage}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Action Toolbar (Bottom Right) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding !ActiveViewModel.HasSelectedCards}">
                    <!-- Add Manual Card -->
                    <Button Command="{Binding AddManualCardCommand}"
                            IsVisible="{Binding IsEditingSelected}"
                            Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8" Cursor="Hand"
                            ToolTip.Tip="Add Manual Cards">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                            </Style>
                            <Style Selector="Button:pointerover PathIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                        </Button.Styles>
                        <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <!-- Refresh -->
                    <Button Command="{Binding RefreshActiveListCommand}"
                            IsEnabled="{Binding !ActiveViewModel.IsRefreshing}"
                            Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8" Cursor="Hand"
                            ToolTip.Tip="Refresh Data">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                            </Style>
                            <Style Selector="Button:pointerover PathIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                        </Button.Styles>
                        <PathIcon Data="{StaticResource IconRefresh}" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        </Grid> <!-- End LEFT column -->

        <!-- RIGHT COLUMN / PANEL SCREEN: Detail and side panel host -->
        <Grid x:Name="Part_RightColumnContainer" Grid.Column="2" IsVisible="{Binding IsPanelScreenVisible}">
            <Grid x:Name="Part_PanelContent">
        <Border x:Name="Part_MainPanelBorder" IsVisible="{Binding ShouldShowRightPanel}" HorizontalAlignment="Stretch" MinWidth="320" MaxWidth="650"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="0">
        <Grid>
            <!-- Add Manual Panel (Editing tab only) -->
            <Border IsVisible="{Binding EditingVM.IsAddManualPanelOpen}" Background="{DynamicResource AppBackgroundBrush}">
                <Grid RowDefinitions="Auto, *" DataContext="{Binding EditingVM}">
                    <!-- Futuristic Header -->
                    <Border Grid.Row="0" Padding="20,15" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SeparatorBrush}">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Add Manual Cards" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Paste Trello links below to manually track them." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CloseAddManualPanelCommand}" Content="X" 
                                    Background="Transparent" BorderThickness="0" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" VerticalAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Foreground" Value="#ef4444"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="16" Margin="20">
                            <!-- Input -->
                            <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
                                <TextBox Text="{Binding ManualCardLinkInput}" AcceptsReturn="True" 
                                         Watermark="https://trello.com/c/..."
                                         Background="Transparent" BorderThickness="0" 
                                         Padding="15" FontSize="13" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                         Height="200" SelectionBrush="{DynamicResource AccentColorBrush}"/>
                            </Border>
                            <Button Command="{Binding ConfirmAddManualCardCommand}"
                                    IsEnabled="{Binding !IsLoadingManualAdd}"
                                    Classes="Action"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Height="38" CornerRadius="6" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12" Foreground="#111111"/>
                                    <TextBlock Text="Import Cards" FontWeight="SemiBold" FontSize="13" Foreground="#111111"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <!-- Card Detail Panel (when not Add Manual) -->
            <ContentControl Content="{Binding ActiveViewModel}"
                            IsVisible="{Binding ActiveViewModel.IsShowingInlineSidePanel}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:EditingCardListViewModel}">
                        <views:CardDetailPanelHost DataContext="{Binding}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:RevisionCardListViewModel}">
                        <views:CardDetailPanelHost DataContext="{Binding}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LateCardListViewModel}">
                        <views:CardDetailPanelHost DataContext="{Binding}"/>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Grid>
        </Border>

        <!-- Global Overlay for Batch Move Panel -->
        <Border x:Name="Part_MovePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" MaxHeight="600" CornerRadius="20"
                Background="#F318181B"
                BorderBrush="#40FFFFFF" BorderThickness="1"
                IsVisible="{Binding ActiveViewModel.IsBatchMoveMode}"
                BoxShadow="0 20 60 0 #40000000, 0 0 0 1 #20FFFFFF inset" ZIndex="20">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25"/>
                </Transitions>
            </Border.Transitions>
            <Grid RowDefinitions="Auto, *">
                <Border Grid.Row="0" Padding="24,18" Background="Transparent" 
                        BorderThickness="0,0,0,1" BorderBrush="#20FFFFFF" CornerRadius="20,20,0,0">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Spacing="6">
                             <TextBlock Text="Move Cards" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       IsVisible="{Binding ActiveViewModel.IsBatchMoveMode}"/>
                             <TextBlock Text="Move Card" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       IsVisible="{Binding !ActiveViewModel.IsBatchMoveMode}"/>
                             
                             <TextBlock Text="{Binding ActiveViewModel.SelectedCard.Name}" FontSize="12" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                       TextTrimming="CharacterEllipsis" MaxWidth="320" Opacity="0.7"
                                       IsVisible="{Binding !ActiveViewModel.IsBatchMoveMode}"/>
                             <TextBlock Text="{Binding ActiveViewModel.CardsSelectedCount, StringFormat='{}{0} Cards Selected'}" 
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"
                                       IsVisible="{Binding ActiveViewModel.IsBatchMoveMode}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ActiveViewModel.CloseMovePanelCommand}" Content="✕" 
                                Background="Transparent" BorderThickness="0" FontSize="18" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" 
                                Padding="6" VerticalAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                                        </Transitions>
                                    </Setter>
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Foreground" Value="#ef4444"/>
                                    <Setter Property="RenderTransform" Value="scale(1.1)"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="22" Margin="24,20">
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding ActiveViewModel.IsLoadingMoveData}" 
                                     Height="3" Margin="0,0,0,12" Foreground="{DynamicResource AccentColorBrush}" 
                                     CornerRadius="2"/>
                        <TextBlock Text="{Binding ActiveViewModel.BatchStatusMessage}" FontSize="12" 
                                   Foreground="{DynamicResource AccentColorBrush}" TextWrapping="Wrap" Opacity="0.9"/>
                        
                        <StackPanel Spacing="9">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Destination Board" FontSize="12" FontWeight="SemiBold" 
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Select or search a board" FontSize="10" 
                                          Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6"/>
                            </StackPanel>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" 
                                   BorderBrush="#30FFFFFF" CornerRadius="12" Padding="0"
                                   BoxShadow="0 2 8 0 #10000000 inset">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                    </Transitions>
                                </Border.Transitions>
                                <AutoCompleteBox x:Name="Part_BatchMoveBoardBox" ItemsSource="{Binding ActiveViewModel.AvailableBoards}" 
                                                 SelectedItem="{Binding ActiveViewModel.SelectedMoveBoard}" 
                                                 Text="{Binding ActiveViewModel.MoveBoardSearchText, Mode=TwoWay}"
                                                 ValueMemberBinding="{Binding Name}"
                                                 Watermark="Search board..." 
                                                 HorizontalAlignment="Stretch"
                                                 FilterMode="Contains" MinimumPrefixLength="0" MaxDropDownHeight="160"
                                                 Background="Transparent" BorderThickness="0" Padding="14,11" FontSize="13"/>
                            </Border>
                        </StackPanel>
                        
                        <StackPanel Spacing="9">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Destination List" FontSize="12" FontWeight="SemiBold" 
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Select or search a list" FontSize="10" 
                                          Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6"/>
                            </StackPanel>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" 
                                   BorderBrush="#30FFFFFF" CornerRadius="12" Padding="0"
                                   BoxShadow="0 2 8 0 #10000000 inset">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                    </Transitions>
                                </Border.Transitions>
                                <AutoCompleteBox x:Name="Part_BatchMoveListBox" ItemsSource="{Binding ActiveViewModel.AvailableLists}" 
                                                 SelectedItem="{Binding ActiveViewModel.SelectedMoveList}" 
                                                 Text="{Binding ActiveViewModel.MoveListSearchText, Mode=TwoWay}"
                                                 ValueMemberBinding="{Binding Name}"
                                                 Watermark="Search list..." 
                                                 HorizontalAlignment="Stretch"
                                                 FilterMode="Contains" MinimumPrefixLength="0" MaxDropDownHeight="160"
                                                 Background="Transparent" BorderThickness="0" Padding="14,11" FontSize="13"
                                                 IsEnabled="{Binding ActiveViewModel.SelectedMoveBoard, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </Border>
                        </StackPanel>
                        
                        <Button Command="{Binding ActiveViewModel.MoveCardCommand}" 
                                Classes="Action"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Height="42" CornerRadius="10" Margin="0,6,0,0" Cursor="Hand"
                                IsEnabled="{Binding ActiveViewModel.SelectedMoveList, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                                        </Transitions>
                                    </Setter>
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="RenderTransform" Value="scale(1.02)"/>
                                </Style>
                                <Style Selector="Button:pressed">
                                    <Setter Property="RenderTransform" Value="scale(0.98)"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                 <PathIcon Data="{StaticResource IconArrowRight}" Foreground="#111111" Width="14" Height="14"/>
                                 <TextBlock Text="Confirm Move" FontWeight="SemiBold" FontSize="14" Foreground="#111111"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

            </Grid> <!-- Part_PanelContent -->
        </Grid> <!-- Part_RightColumnContainer -->
    </Grid> <!-- Part_RootGrid -->
</UserControl>
