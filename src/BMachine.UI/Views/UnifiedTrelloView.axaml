<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BMachine.UI.ViewModels"
             xmlns:models="using:BMachine.UI.Models"
             xmlns:controls="using:BMachine.UI.Controls"
             xmlns:views="using:BMachine.UI.Views"
             x:Class="BMachine.UI.Views.UnifiedTrelloView"
             x:DataType="vm:UnifiedTrelloViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
             
    <Grid x:Name="Part_RootGrid" SizeChanged="OnRootGridSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT COLUMN / LIST SCREEN: Status + Tabs + Card List + Bottom (compact: hidden when panel open) -->
        <Grid x:Name="Part_ListScreen" Grid.Column="0" IsVisible="{Binding IsListScreenVisible}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Status (top, window mode) -->
                <RowDefinition Height="Auto"/> <!-- Tab & Header Popup Area -->
                <RowDefinition Height="*"/>    <!-- Main Content List -->
                <RowDefinition Height="Auto"/> <!-- Status (bottom, embedded mode) -->
            </Grid.RowDefinitions>
        
        <!-- ROW 0: Top Status Bar (Window mode only) -->
        <Border Grid.Row="0" Margin="20,10,20,0" Padding="12,8" Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="12" IsVisible="{Binding IsNotEmbedded}">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Status Dot of Active ViewModel -->
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" ToolTip.Tip="{Binding ActiveViewModel.ConnectionStatusText, StringFormat='{}Status: {0}'}">
                        <Ellipse.Styles>
                            <Style Selector="Ellipse">
                                <Setter Property="Fill" Value="#EF4444"/> <!-- Red (Offline) -->
                            </Style>
                            <Style Selector="Ellipse.online">
                                <Setter Property="Fill" Value="#22C55E"/> <!-- Green (Online) -->
                            </Style>
                        </Ellipse.Styles>
                        <Classes.online>
                            <Binding Path="ActiveViewModel.IsOnline"/>
                        </Classes.online>
                        <Ellipse.Transitions>
                            <Transitions>
                                <BrushTransition Property="Fill" Duration="0:0:0.3"/>
                            </Transitions>
                        </Ellipse.Transitions>
                    </Ellipse>
                    <TextBlock Text="{Binding ActiveViewModel.StatusMessage}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Action Toolbar (Top Right) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding !ActiveViewModel.HasSelectedCards}">
                    <!-- Add Manual Card Icon -->
                    <Button Command="{Binding AddManualCardCommand}"
                            IsVisible="{Binding IsEditingSelected}"
                            Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8" Cursor="Hand"
                            ToolTip.Tip="Add Manual Cards">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                            </Style>
                            <Style Selector="Button:pointerover PathIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                        </Button.Styles>
                        <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>

                    <!-- Refresh Icon -->
                    <Button Command="{Binding RefreshActiveListCommand}"
                            IsEnabled="{Binding !ActiveViewModel.IsRefreshing}"
                            Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8" Cursor="Hand"
                            ToolTip.Tip="Refresh Data">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                            </Style>
                            <Style Selector="Button:pointerover PathIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                        </Button.Styles>
                        <PathIcon Data="{StaticResource IconRefresh}" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ROW 1: Tabs & Header Area -->
        <Panel Grid.Row="1" Margin="20,10,40,10">
            
            <!-- Standard Tab Bar -->
            <Border Background="{DynamicResource AppBackgroundBrush}" 
                    CornerRadius="16" Padding="4"
                    BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    IsVisible="{Binding !ActiveViewModel.HasSelectedCards}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <StackPanel.Styles>
                        <Style Selector="RadioButton.TabButton">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Padding" Value="24,6"/>
                            <Setter Property="CornerRadius" Value="12"/>
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                                </Transitions>
                            </Setter>
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="RadioButton.TabButton:pointerover">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Style>
                        <Style Selector="RadioButton.TabButton:checked">
                             <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                             <Setter Property="BorderBrush" Value="Transparent"/>
                             <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Style>
                    </StackPanel.Styles>
                    
                    <!-- EDITING Tab -->
                    <RadioButton Classes="TabButton" Content="EDITING" IsChecked="{Binding IsEditingSelected}" Command="{Binding SwitchToEditingCommand}"/>
                    <!-- REVISI Tab -->
                    <RadioButton Classes="TabButton" Content="REVISI" IsChecked="{Binding IsRevisionSelected}" Command="{Binding SwitchToRevisionCommand}"/>
                    <!-- SUSULAN Tab -->
                    <RadioButton Classes="TabButton" Content="SUSULAN" IsChecked="{Binding IsLateSelected}" Command="{Binding SwitchToLateCommand}"/>
                </StackPanel>
            </Border>

             <!-- OVERLAY: Top Header Action Bar (Shows when cards are selected) -->
             <Border Background="{DynamicResource CardBackgroundBrush}"
                     BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                     CornerRadius="20" HorizontalAlignment="Center" Padding="12,6"
                     IsVisible="{Binding ActiveViewModel.HasSelectedCards}"
                     BoxShadow="0 4 20 0 #20000000" ZIndex="10">
                  <StackPanel Orientation="Horizontal" Spacing="16">
                      <!-- Left: Selection Info & Deselect All -->
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <!-- Select All / Deselect Toolbar Toggle -->
                          <ToggleButton IsChecked="{Binding ActiveViewModel.IsAllSelected, Mode=TwoWay}"
                                        Command="{Binding ActiveViewModel.ToggleSelectAllCardsCommand}"
                                        Classes="Clear" Padding="2" Background="Transparent" CornerRadius="0" Cursor="Hand" ToolTip.Tip="Select All">
                                <ToggleButton.Styles>
                                    <Style Selector="ToggleButton:checked PathIcon">
                                         <Setter Property="Data" Value="{StaticResource IconCheckSquare}"/>
                                         <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}"/>
                                    </Style>
                                    <Style Selector="ToggleButton:unchecked PathIcon">
                                         <Setter Property="Data" Value="{StaticResource IconSquare}"/>
                                         <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    </Style>
                                </ToggleButton.Styles>
                                <PathIcon Width="14" Height="14"/>
                          </ToggleButton>
                          
                          <TextBlock Text="Terpilih" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                      </StackPanel>
                      
                      <!-- Right: Batch Actions -->
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                           <!-- Batch Unlink for Manual Cards -->
                           <Button Command="{Binding ActiveViewModel.BatchUnlinkCommand}"
                                   IsVisible="{Binding ActiveViewModel.HasSelectedManualCards}"
                                   ToolTip.Tip="Putus Tautan"
                                   Background="#10EF4444" Foreground="#EF4444" Padding="12,6" CornerRadius="16" Cursor="Hand" FontSize="12">
                               <StackPanel Orientation="Horizontal" Spacing="6">
                                   <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" Foreground="#EF4444"/>
                                   <TextBlock Text="Unlink" FontWeight="Medium"/>
                               </StackPanel>
                           </Button>
                               
                               <!-- Batch ACC for Regular Cards -->
                               <Button Command="{Binding ActiveViewModel.BatchAccCommand}"
                                       IsVisible="{Binding ActiveViewModel.HasSelectedRegularCards}"
                                       ToolTip.Tip="ACC Marketing"
                                       Background="#100078D7" Foreground="#0078D7" Padding="12,6" CornerRadius="16" Cursor="Hand" FontSize="12">
                                   <StackPanel Orientation="Horizontal" Spacing="6">
                                       <TextBlock Text="🕒" FontSize="12" VerticalAlignment="Center"/>
                                       <TextBlock Text="ACC" FontWeight="Medium"/>
                                   </StackPanel>
                               </Button>

                           <Button Command="{Binding ActiveViewModel.ShowBatchMovePanelCommand}"
                                   ToolTip.Tip="Pindah Massal"
                                   Classes="Primary" Padding="12,6" CornerRadius="16" Cursor="Hand" FontSize="12">
                               <StackPanel Orientation="Horizontal" Spacing="6">
                                   <PathIcon Data="{StaticResource IconArrowRight}" Width="12" Height="12"/>
                                   <TextBlock Text="Move" FontWeight="Medium"/>
                               </StackPanel>
                           </Button>
                      </StackPanel>
                  </StackPanel>
             </Border>
            
        </Panel>

        <!-- ROW 2: Dynamic Content Area -->
        <ContentControl Grid.Row="2" Content="{Binding ActiveViewModel}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="{x:Type vm:EditingCardListViewModel}">
                    <views:EditingCardListView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:RevisionCardListViewModel}">
                    <views:RevisionCardListView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:LateCardListViewModel}">
                    <views:LateCardListView DataContext="{Binding}" />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>


        <!-- Loading Bar (thin, at top of content area) -->
        <ProgressBar Grid.Row="2" VerticalAlignment="Top" ZIndex="5"
                     IsIndeterminate="True"
                     IsVisible="{Binding ActiveViewModel.IsRefreshing}"
                     Height="2" Margin="0"
                     Foreground="{DynamicResource AccentColorBrush}"/>

        <!-- ROW 3: Bottom Status Bar (Embedded/Dashboard mode only) -->
        <Border Grid.Row="3" Margin="20,10,20,10" Padding="12,8" Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="12" IsVisible="{Binding IsEmbedded}">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Status Dot -->
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" ToolTip.Tip="{Binding ActiveViewModel.ConnectionStatusText, StringFormat='{}Status: {0}'}">
                        <Ellipse.Styles>
                            <Style Selector="Ellipse">
                                <Setter Property="Fill" Value="#EF4444"/>
                            </Style>
                            <Style Selector="Ellipse.online">
                                <Setter Property="Fill" Value="#22C55E"/>
                            </Style>
                        </Ellipse.Styles>
                        <Classes.online>
                            <Binding Path="ActiveViewModel.IsOnline"/>
                        </Classes.online>
                        <Ellipse.Transitions>
                            <Transitions>
                                <BrushTransition Property="Fill" Duration="0:0:0.3"/>
                            </Transitions>
                        </Ellipse.Transitions>
                    </Ellipse>
                    <TextBlock Text="{Binding ActiveViewModel.StatusMessage}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Action Toolbar (Bottom Right) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding !ActiveViewModel.HasSelectedCards}">
                    <!-- Add Manual Card -->
                    <Button Command="{Binding AddManualCardCommand}"
                            IsVisible="{Binding IsEditingSelected}"
                            Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8" Cursor="Hand"
                            ToolTip.Tip="Add Manual Cards">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                            </Style>
                            <Style Selector="Button:pointerover PathIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                        </Button.Styles>
                        <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <!-- Refresh -->
                    <Button Command="{Binding RefreshActiveListCommand}"
                            IsEnabled="{Binding !ActiveViewModel.IsRefreshing}"
                            Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8" Cursor="Hand"
                            ToolTip.Tip="Refresh Data">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                            </Style>
                            <Style Selector="Button:pointerover PathIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                        </Button.Styles>
                        <PathIcon Data="{StaticResource IconRefresh}" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        </Grid> <!-- End LEFT column -->

        <!-- RIGHT COLUMN / PANEL SCREEN: Detail, Comment, etc. (compact: full-screen when panel open) -->
        <Grid x:Name="Part_RightColumnContainer" Grid.Column="1" IsVisible="{Binding IsPanelScreenVisible}">
            <!-- Panel content (Detail, Comment, Add Manual, etc.) - no Back bar, use mouse gesture -->
            <Grid x:Name="Part_PanelContent">
        <Border x:Name="Part_MainPanelBorder" IsVisible="{Binding ShouldShowRightPanel}" HorizontalAlignment="Stretch" MaxWidth="500"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="0">
        <Grid>
            <!-- Add Manual Panel (Editing tab only) -->
            <Border IsVisible="{Binding EditingVM.IsAddManualPanelOpen}" Background="{DynamicResource AppBackgroundBrush}">
                <Grid RowDefinitions="Auto, *" DataContext="{Binding EditingVM}">
                    <!-- Futuristic Header -->
                    <Border Grid.Row="0" Padding="20,15" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SeparatorBrush}">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Add Manual Cards" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Paste Trello links below to manually track them." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CloseAddManualPanelCommand}" Content="✕" 
                                    Background="Transparent" BorderThickness="0" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" VerticalAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Foreground" Value="#ef4444"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="16" Margin="20">
                            <!-- Input -->
                            <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
                                <TextBox Text="{Binding ManualCardLinkInput}" AcceptsReturn="True" 
                                         Watermark="https://trello.com/c/..."
                                         Background="Transparent" BorderThickness="0" 
                                         Padding="15" FontSize="13" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                         Height="200" SelectionBrush="{DynamicResource AccentColorBrush}"/>
                            </Border>
                            <!-- Pill Button -->
                            <Button Command="{Binding ConfirmAddManualCardCommand}"
                                    IsEnabled="{Binding !IsLoadingManualAdd}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="{DynamicResource AccentColorBrush}" Foreground="White" BorderThickness="0" CornerRadius="12" Padding="15,12" Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover">
                                     <Setter Property="Opacity" Value="0.8"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12" Foreground="White"/>
                                <TextBlock Text="Import Cards" FontWeight="SemiBold" FontSize="13" Foreground="White"/>
                            </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <!-- Card Detail Panel (when not Add Manual) -->
            <ContentControl Content="{Binding ActiveViewModel}"
                            IsVisible="{Binding ActiveViewModel.IsShowingInlineSidePanel}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:EditingCardListViewModel}">
                        <views:CardDetailPanelHost DataContext="{Binding}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:RevisionCardListViewModel}">
                        <views:CardDetailPanelHost DataContext="{Binding}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LateCardListViewModel}">
                        <views:CardDetailPanelHost DataContext="{Binding}"/>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Grid>
        </Border>

        <!-- Global Overlay for Batch Move Panel -->
        <Border x:Name="Part_MovePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" MaxHeight="550" CornerRadius="16"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                IsVisible="{Binding ActiveViewModel.IsBatchMoveMode}"
                BoxShadow="0 8 30 0 #30000000" ZIndex="20">
            <Grid RowDefinitions="Auto, *">
                <Border Grid.Row="0" Padding="20,15" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="16,16,0,0">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Spacing="4">
                             <TextBlock Text="Batch Move" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" IsVisible="{Binding ActiveViewModel.IsBatchMoveMode}"/>
                             <TextBlock Text="Move Card" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" IsVisible="{Binding !ActiveViewModel.IsBatchMoveMode}"/>
                             
                             <TextBlock Text="{Binding ActiveViewModel.SelectedCard.Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300" IsVisible="{Binding !ActiveViewModel.IsBatchMoveMode}"/>
                             <TextBlock Text="{Binding ActiveViewModel.CardsSelectedCount, StringFormat='{}{0} Cards Selected'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding ActiveViewModel.IsBatchMoveMode}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ActiveViewModel.CloseMovePanelCommand}" Content="✕" 
                                Background="Transparent" BorderThickness="0" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Foreground" Value="#ef4444"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="20" Margin="20">
                        <TextBlock Text="{Binding ActiveViewModel.BatchStatusMessage}" FontSize="12" Foreground="{DynamicResource AccentColorBrush}" TextWrapping="Wrap"/>
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding ActiveViewModel.IsLoadingMoveData}" Height="4" Margin="0,0,0,10" Foreground="{DynamicResource AccentColorBrush}" CornerRadius="2"/>
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="Destination Board" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="12">
                                <AutoCompleteBox x:Name="Part_BatchMoveBoardBox" ItemsSource="{Binding ActiveViewModel.AvailableBoards}" 
                                                 SelectedItem="{Binding ActiveViewModel.SelectedMoveBoard}" 
                                                 Text="{Binding ActiveViewModel.MoveBoardSearchText, Mode=TwoWay}"
                                                 ValueMemberBinding="{Binding Name}"
                                                 Watermark="Search board..." 
                                                 HorizontalAlignment="Stretch"
                                                 FilterMode="Contains" MinimumPrefixLength="0" MaxDropDownHeight="160"
                                                 Background="Transparent" BorderThickness="0" Padding="12,10" FontSize="13"/>
                            </Border>
                        </StackPanel>
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="Destination List" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="12">
                                <AutoCompleteBox x:Name="Part_BatchMoveListBox" ItemsSource="{Binding ActiveViewModel.AvailableLists}" 
                                                 SelectedItem="{Binding ActiveViewModel.SelectedMoveList}" 
                                                 Text="{Binding ActiveViewModel.MoveListSearchText, Mode=TwoWay}"
                                                 ValueMemberBinding="{Binding Name}"
                                                 Watermark="Search list..." 
                                                 HorizontalAlignment="Stretch"
                                                 FilterMode="Contains" MinimumPrefixLength="0" MaxDropDownHeight="160"
                                                 Background="Transparent" BorderThickness="0" Padding="12,10" FontSize="13"
                                                 IsEnabled="{Binding ActiveViewModel.SelectedMoveBoard, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </Border>
                        </StackPanel>
                        
                        <Button Command="{Binding ActiveViewModel.MoveCardCommand}" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="{DynamicResource AccentColorBrush}" Foreground="White" BorderThickness="0" CornerRadius="12" Padding="15,12" Margin="0,10,0,0" Cursor="Hand"
                                IsEnabled="{Binding ActiveViewModel.SelectedMoveList, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                 <TextBlock Text="Confirm Move" FontWeight="SemiBold" FontSize="13" Foreground="White"/>
                                 <PathIcon Data="{StaticResource IconArrowRight}" Foreground="White" Width="12" Height="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

            </Grid> <!-- Part_PanelContent -->
        </Grid> <!-- Part_RightColumnContainer -->
    </Grid> <!-- Part_RootGrid -->
</UserControl>
