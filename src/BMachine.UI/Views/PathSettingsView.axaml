<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BMachine.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="BMachine.UI.Views.PathSettingsView"
             x:DataType="vm:PathSettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="20">
            <TextBlock Text="Explorer &amp; Paths Configuration" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextControlForeground}"/>
            <TextBlock Text="Set default locations for Local Output, Photoshop, and Master Design assets." 
                       FontSize="14" Foreground="{DynamicResource TextControlForeground}" Opacity="0.7"/>

            <!-- Explorer Defaults (Global Settings - MOVED TO TOP) -->
            <Border Classes="Card" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="0" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="Explorer Defaults" FontWeight="SemiBold" FontSize="16"/>
                    
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Default Local Output (Optional)" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="If set, you only need to pick Input folder." FontSize="10" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PathLocalOutput}" Watermark="Auto-Ask if empty" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Browse" Command="{Binding BrowsePathCommand}" CommandParameter="LocalOutput" Classes="Primary"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Master OKE BASE (Optional)" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PathOkeBase}" Watermark="Not Set (Fitur OKE BASE Non-aktif)" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Browse" Command="{Binding BrowsePathCommand}" CommandParameter="OkeBase" Classes="Primary"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Photoshop Executable (.exe / .app)" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Required for JSX Scripts" FontSize="10" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PathPhotoshop}" Watermark="Select Photoshop.exe or .app" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Browse" Command="{Binding BrowseFileCommand}" CommandParameter="Photoshop" Classes="Primary" Margin="0,0,6,0"/>
                        <Button Grid.Row="1" Grid.Column="2" Command="{Binding FixPhotoshopWarningCommand}"
                                Classes="Primary" Background="#E07020" Padding="8" CornerRadius="0"
                                ToolTip.Tip="Fix PS Warning: Automatically suppress the Photoshop script security warning by writing to PSUserConfig.txt">
                            <PathIcon Data="{StaticResource IconBolt}" Width="16" Height="16" Foreground="White" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- TAMBAHAN MASTER (New Feature) -->
            <Border Classes="Card" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="0" Padding="15">
                <Expander IsExpanded="False" Background="Transparent" BorderThickness="0" Padding="0">
                    <Expander.Header>
                        <TextBlock Text="TAMBAHAN MASTER" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextControlForeground}"/>
                    </Expander.Header>
                    <StackPanel Spacing="10" Margin="0,10,0,0">
                         <TextBlock Text="Folder master tambahan yang akan muncul di Master File Browser." 
                                    FontSize="12" Foreground="{DynamicResource TextControlForeground}" Opacity="0.7"/>
                        
                        <!-- List of Paths -->
                        <ItemsControl ItemsSource="{Binding AdditionalMasterPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,8" BoxShadow="0 2 4 0 #1A000000">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0">
                                            <!-- Up/Down Buttons -->
                                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,0" Spacing="2">
                                                <Button Command="{Binding $parent[UserControl].DataContext.MoveMasterPathUpCommand}" 
                                                        CommandParameter="{Binding}"
                                                        Classes="Clear" Padding="4" ToolTip.Tip="Move Up">
                                                     <TextBlock Text="▲" FontSize="10" Foreground="{DynamicResource AccentBlueBrush}"/>
                                                </Button>
                                                <Button Command="{Binding $parent[UserControl].DataContext.MoveMasterPathDownCommand}" 
                                                        CommandParameter="{Binding}"
                                                        Classes="Clear" Padding="4" ToolTip.Tip="Move Down">
                                                     <TextBlock Text="▼" FontSize="10" Foreground="{DynamicResource AccentBlueBrush}"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Editable TextBox -->
                                            <TextBox Grid.Column="1" Text="{Binding Path, Mode=TwoWay}" VerticalAlignment="Center" 
                                                     Background="Transparent" BorderThickness="0" Padding="5" Margin="0"
                                                     ToolTip.Tip="Edit Path"/>

                                            <!-- Browse Button -->
                                            <Button Grid.Column="2" Command="{Binding $parent[UserControl].DataContext.BrowseEditMasterPathCommand}" 
                                                    CommandParameter="{Binding}"
                                                    Classes="Clear" Margin="5,0,0,0" Padding="6" ToolTip.Tip="Browse Folder">
                                                 <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="{DynamicResource AccentBlueBrush}" Opacity="0.9"/>
                                            </Button>
                                            
                                            <!-- Remove Button -->
                                            <Button Grid.Column="3" Command="{Binding $parent[UserControl].DataContext.RemoveMasterPathCommand}" 
                                                    CommandParameter="{Binding}"
                                                    Classes="Clear" Margin="5,0,0,0" Padding="6" ToolTip.Tip="Remove Folder">
                                                 <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" Foreground="#FF5555"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Add Button -->
                        <Button Command="{Binding AddMasterPathCommand}" Classes="Primary" HorizontalAlignment="Left" Margin="0,5,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Tambah Folder Master" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- TAMBAHAN PHOTOSHOP (New Feature) -->
            <Border Classes="Card" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="0" Padding="15">
                <Expander IsExpanded="False" Background="Transparent" BorderThickness="0" Padding="0">
                    <Expander.Header>
                        <TextBlock Text="TAMBAHAN PHOTOSHOP" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextControlForeground}"/>
                    </Expander.Header>
                    <StackPanel Spacing="10" Margin="0,10,0,0">
                         <TextBlock Text="Folder khusus gambar (jpg/png) yang akan muncul di tab PHOTOSHOP." 
                                    FontSize="12" Foreground="{DynamicResource TextControlForeground}" Opacity="0.7"/>
                        
                        <!-- List of Paths -->
                        <ItemsControl ItemsSource="{Binding AdditionalPhotoshopPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,8" BoxShadow="0 2 4 0 #1A000000">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0">
                                            <!-- Up/Down Buttons -->
                                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,0" Spacing="2">
                                                <Button Command="{Binding $parent[UserControl].DataContext.MovePhotoshopPathUpCommand}" 
                                                        CommandParameter="{Binding}"
                                                        Classes="Clear" Padding="4" ToolTip.Tip="Move Up">
                                                     <TextBlock Text="▲" FontSize="10" Foreground="{DynamicResource AccentBlueBrush}"/>
                                                </Button>
                                                <Button Command="{Binding $parent[UserControl].DataContext.MovePhotoshopPathDownCommand}" 
                                                        CommandParameter="{Binding}"
                                                        Classes="Clear" Padding="4" ToolTip.Tip="Move Down">
                                                     <TextBlock Text="▼" FontSize="10" Foreground="{DynamicResource AccentBlueBrush}"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Editable TextBox -->
                                            <TextBox Grid.Column="1" Text="{Binding Path, Mode=TwoWay}" VerticalAlignment="Center" 
                                                     Background="Transparent" BorderThickness="0" Padding="5" Margin="0"
                                                     ToolTip.Tip="Edit Path"/>

                                            <!-- Browse Button -->
                                            <Button Grid.Column="2" Command="{Binding $parent[UserControl].DataContext.BrowseEditPhotoshopPathCommand}" 
                                                    CommandParameter="{Binding}"
                                                    Classes="Clear" Margin="5,0,0,0" Padding="6" ToolTip.Tip="Browse Folder">
                                                 <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="{DynamicResource AccentBlueBrush}" Opacity="0.9"/>
                                            </Button>
                                            
                                            <!-- Remove Button -->
                                            <Button Grid.Column="3" Command="{Binding $parent[UserControl].DataContext.RemovePhotoshopPathCommand}" 
                                                    CommandParameter="{Binding}"
                                                    Classes="Clear" Margin="5,0,0,0" Padding="6" ToolTip.Tip="Remove Folder">
                                                 <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" Foreground="#FF5555"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Add Button -->
                        <Button Command="{Binding AddPhotoshopPathCommand}" Classes="Primary" HorizontalAlignment="Left" Margin="0,5,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Tambah Folder Photoshop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- Storage Settings -->
            <Border Classes="Card" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="0" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="Storage Settings" FontWeight="SemiBold" FontSize="16"/>
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Attachment Download Path" VerticalAlignment="Center" Margin="0,0,0,5"/>
                         <TextBlock Grid.Row="0" Grid.Column="0" Text="Files from Trello attachments will be saved here." FontSize="10" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding OfflineStoragePath}" Watermark="Select Download Folder" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Browse" Command="{Binding BrowsePathCommand}" CommandParameter="OfflineStorage" Classes="Primary"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Profesi Group -->
            <Border Classes="Card" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="0" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="Profesi &amp; Sporty" FontWeight="SemiBold" FontSize="16"/>
                    
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Master Profesi 10RP (Biasa)" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PathProfesi}" Watermark="Not Set" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Browse" Command="{Binding BrowsePathCommand}" CommandParameter="Profesi" Classes="Primary"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Master Profesi 8R" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PathProfesi8R}" Watermark="Not Set" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Browse" Command="{Binding BrowsePathCommand}" CommandParameter="Profesi8R" Classes="Primary"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Master Sporty" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PathSporty}" Watermark="Not Set" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Browse" Command="{Binding BrowsePathCommand}" CommandParameter="Sporty" Classes="Primary"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Manasik Group -->
            <Border Classes="Card" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="0" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="Manasik" FontWeight="SemiBold" FontSize="16"/>

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Master Manasik 10RP" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PathManasik10RP}" Watermark="Not Set" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Browse" Command="{Binding BrowsePathCommand}" CommandParameter="Manasik10RP" Classes="Primary"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Master Manasik 8R" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PathManasik8R}" Watermark="Not Set" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Browse" Command="{Binding BrowsePathCommand}" CommandParameter="Manasik8R" Classes="Primary"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Wisuda Group -->
            <Border Classes="Card" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="0" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="Wisuda" FontWeight="SemiBold" FontSize="16"/>

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Master Wisuda 10RP" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PathWisuda10RP}" Watermark="Not Set" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Browse" Command="{Binding BrowsePathCommand}" CommandParameter="Wisuda10RP" Classes="Primary"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Master Wisuda 8R" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PathWisuda8R}" Watermark="Not Set" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Browse" Command="{Binding BrowsePathCommand}" CommandParameter="Wisuda8R" Classes="Primary"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Pas Foto Group -->
            <Border Classes="Card" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="0" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="Pas Foto" FontWeight="SemiBold" FontSize="16"/>

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Master Pas Foto" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PathPasFoto}" Watermark="Not Set" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Browse" Command="{Binding BrowsePathCommand}" CommandParameter="PasFoto" Classes="Primary"/>
                    </Grid>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
