<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:BMachine.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="280"
        x:Class="BMachine.UI.Views.SplashWindow"
        x:DataType="vm:SplashViewModel"
        Width="450" Height="280"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        Topmost="True">

    <!-- Super Clean & Compact Card -->
    <Border CornerRadius="12" ClipToBounds="True" Background="#111111" BorderBrush="#2A2A2A" BorderThickness="1">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#18181B" Offset="0.0" />
                    <GradientStop Color="#09090B" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Subtle top glow -->
            <Border Height="1" VerticalAlignment="Top" Background="#3B82F6" Opacity="0.3">
                <Border.Effect>
                    <DropShadowEffect Color="#3B82F6" BlurRadius="20"/>
                </Border.Effect>
            </Border>

            <!-- Main Content: Perfectly Centered -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" Margin="0,-20,0,0">
                <!-- Modern XAML Vector Logo & Typography -->
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <!-- Vector Icon (Stylized abstract layers / B) -->
                    <Viewbox Width="56" Height="56" HorizontalAlignment="Center">
                        <Grid>
                            <Path Data="M12 2L2 7l10 5 10-5-10-5z" Fill="#3B82F6" Opacity="0.9"/>
                            <Path Data="M2 12l10 5 10-5" Stroke="#3B82F6" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/>
                            <Path Data="M2 17l10 5 10-5" Stroke="#60A5FA" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Opacity="0.6"/>
                        </Grid>
                        <Viewbox.Effect>
                            <DropShadowEffect Color="#3B82F6" BlurRadius="25" Opacity="0.6" OffsetX="0" OffsetY="5"/>
                        </Viewbox.Effect>
                    </Viewbox>

                    <!-- Typographic Logo -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock Text="B" 
                                   FontSize="22" 
                                   FontWeight="Black"
                                   FontFamily="Inter, Segoe UI, sans-serif"
                                   Foreground="#3B82F6"
                                   LetterSpacing="1"/>
                        <TextBlock Text="MACHINE" 
                                   FontSize="22" 
                                   FontWeight="Light"
                                   FontFamily="Inter, Segoe UI, sans-serif"
                                   Foreground="#FAFAFA" 
                                   LetterSpacing="4"/>
                    </StackPanel>
                </StackPanel>
                    <TextBlock Text="VERSION 6.5" 
                               FontSize="10" 
                               FontWeight="Medium"
                               FontFamily="Inter, Segoe UI, sans-serif"
                               HorizontalAlignment="Center" 
                               Foreground="#71717A" 
                               LetterSpacing="2"/>
                </StackPanel>

            <!-- Bottom Section: Logs & Edge Progress Bar -->
            <StackPanel VerticalAlignment="Bottom" Spacing="10">
                <!-- Single Line Latest Log -->
                <ItemsControl ItemsSource="{Binding TerminalLogs}" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" 
                                       FontSize="11" 
                                       FontFamily="Consolas, Courier New, monospace"
                                       Foreground="#52525B" 
                                       Opacity="0.8"
                                       TextAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                           
                <!-- Edge-to-Edge Progress Bar -->
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="3" 
                             Background="#18181B"
                             Foreground="#3B82F6" 
                             BorderThickness="0" CornerRadius="0"
                             ShowProgressText="False"
                             HorizontalAlignment="Stretch">
                    <ProgressBar.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Value" Duration="0:0:0.3"/>
                        </Transitions>
                    </ProgressBar.Transitions>
                </ProgressBar>
            </StackPanel>
        </Grid>
    </Border>
</Window>
