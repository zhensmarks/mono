<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:BMachine.UI.Views"
        xmlns:vm="using:BMachine.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="BMachine.UI.Views.ExplorerWindow"
        Title="Explorer"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        TransparencyLevelHint="Mica"
        Padding="0"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        CanResize="True"
        x:DataType="vm:ExplorerWindowViewModel">

    <Grid RowDefinitions="Auto, *">

        <!-- HEADER: Tab bar + window controls -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto"
              Background="{DynamicResource CardBackgroundBrush}"
              PointerPressed="OnDragZonePointerPressed">

            <!-- Left: Tab area -->
            <Grid Grid.Column="0">

                <!-- Single-tab mode: show folder name centered -->
                <TextBlock Text="{Binding SelectedTab.ExplorerViewModel.CurrentFolderName, FallbackValue=Explorer}"
                           IsVisible="{Binding ShowSingleTabTitle}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" Margin="60,0"/>

                <!-- Multi-tab mode: StackPanel with pinned zone + separator + normal tabs -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              IsVisible="{Binding ShowTabBar}"
                              Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- PINNED TABS: compact fixed-width -->
                        <ItemsControl ItemsSource="{Binding Tabs}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExplorerTabItemViewModel">
                                    <!-- Only visible when pinned -->
                                    <Border IsVisible="{Binding IsPinned}"
                                            Width="30" Height="36"
                                            Margin="1,0,0,0"
                                            CornerRadius="4,4,0,0"
                                            Cursor="Hand"
                                            Classes="tabHeader"
                                            Classes.selected="{Binding IsSelected}"
                                            PointerPressed="OnTabHeaderPointerPressed">
                                        <Border.Styles>
                                            <Style Selector="Border.tabHeader">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </Style>
                                            <Style Selector="Border.tabHeader:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </Style>
                                            <Style Selector="Border.tabHeader.selected">
                                                <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
                                                <Setter Property="Margin" Value="1,0,0,-1"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </Style>
                                            <Style Selector="Border.tabHeader.selected:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
                                            </Style>
                                        </Border.Styles>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding PinMenuText}" Command="{Binding TogglePinCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="Change Color" Command="{Binding CyclePinnedColorCommand}"/>
                                                <MenuItem Header="Rename…" Command="{Binding RenamePinnedCommand}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <ToolTip.Tip>
                                            <TextBlock Text="{Binding Title}"/>
                                        </ToolTip.Tip>
                                        <Grid RowDefinitions="*, 2">
                                            <!-- Badge: bound to dynamic color -->
                                            <Border Grid.Row="0"
                                                    Width="20" Height="20"
                                                    CornerRadius="5"
                                                    Background="{Binding BadgeBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayInitials}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           LetterSpacing="-0.5"/>
                                            </Border>
                                            <!-- Active underline -->
                                            <Border Grid.Row="1"
                                                    Background="{DynamicResource AccentColorBrush}"
                                                    CornerRadius="2,2,0,0" Margin="6,0"
                                                    Opacity="0" Name="pinnedTabLine">
                                                <Border.Styles>
                                                    <Style Selector="Border.tabHeader.selected Border[Name=pinnedTabLine]">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </Style>
                                                </Border.Styles>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- SEPARATOR: only when pinned tabs exist -->
                        <Border IsVisible="{Binding HasPinnedTabs}"
                                Width="1" Margin="3,6,3,4"
                                Background="{DynamicResource SeparatorBrush}"
                                VerticalAlignment="Stretch"/>

                        <!-- NORMAL TABS: flexible width -->
                        <ItemsControl ItemsSource="{Binding Tabs}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExplorerTabItemViewModel">
                                    <!-- Only visible when NOT pinned -->
                                    <Border IsVisible="{Binding !IsPinned}"
                                            MinWidth="100" MaxWidth="200" Height="36"
                                            Margin="1,0,0,0"
                                            CornerRadius="4,4,0,0"
                                            Cursor="Hand"
                                            Classes="tabHeader"
                                            Classes.selected="{Binding IsSelected}"
                                            PointerPressed="OnTabHeaderPointerPressed">
                                        <Border.Styles>
                                            <Style Selector="Border.tabHeader">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="Border.tabHeader:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                            </Style>
                                            <Style Selector="Border.tabHeader.selected">
                                                <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
                                                <Setter Property="Margin" Value="2,0,0,-1"/>
                                            </Style>
                                            <Style Selector="Border.tabHeader.selected:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
                                            </Style>
                                            <!-- Close btn: only on hover, explicitly remove avalonia default hover bg -->
                                            <Style Selector="Border.tabHeader Button.tabClose">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Setter Property="IsHitTestVisible" Value="False"/>
                                            </Style>
                                            <Style Selector="Border.tabHeader:pointerover Button.tabClose">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                            </Style>
                                            <Style Selector="Border.tabHeader Button.tabClose:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                            <!-- Label colors -->
                                            <Style Selector="Border.tabHeader TextBlock.tabLabel">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                            </Style>
                                            <Style Selector="Border.tabHeader.selected TextBlock.tabLabel">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </Border.Styles>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding PinMenuText}" Command="{Binding TogglePinCommand}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid RowDefinitions="*, 2">
                                            <!-- Title + Close -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto"
                                                  Margin="10,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0" Classes="tabLabel"
                                                           Text="{Binding Title}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Classes="tabClose Clear"
                                                        Width="16" Height="16" Padding="0"
                                                        Margin="4,0,0,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Click="OnCloseTabClick" ToolTip.Tip="Close Tab">
                                                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                              Width="7" Height="7"
                                                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Button>
                                            </Grid>
                                            <!-- Active underline -->
                                            <Border Grid.Row="1"
                                                    Background="{DynamicResource AccentColorBrush}"
                                                    CornerRadius="2,2,0,0" Margin="6,0"
                                                    Classes="tabLine">
                                                <Border.Styles>
                                                    <Style Selector="Border.tabLine">
                                                        <Setter Property="Opacity" Value="0"/>
                                                    </Style>
                                                    <Style Selector="Border.tabHeader.selected Border.tabLine">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </Style>
                                                </Border.Styles>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Right: Window controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Top" Margin="0,4,8,0" Spacing="2">
                <Button Click="OnCloseWindow"
                        Width="28" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="4" ToolTip.Tip="Close Explorer" Cursor="Hand" Classes="Clear">
                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#22ef4444"/>
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Bottom separator line -->
        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                Background="{DynamicResource SeparatorBrush}" ZIndex="1"/>

        <!-- CONTENT: Explorer views per tab -->
        <Border Grid.Row="1"
                Background="{DynamicResource AppBackgroundBrush}">
            <Grid>
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExplorerTabItemViewModel">
                            <Border IsVisible="{Binding IsSelected}" ClipToBounds="True">
                                <views:OutputExplorerView DataContext="{Binding ExplorerViewModel}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Floating Selection Statusbar -->
                <ItemsControl ItemsSource="{Binding Tabs}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExplorerTabItemViewModel">
                            <!-- Show floating bar only when this tab is selected and has selection -->
                            <Border IsVisible="{Binding IsSelected}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,14"
                                    Padding="12,5,12,5"
                                    CornerRadius="20"
                                    BoxShadow="0 4 16 0 #55000000"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SeparatorBrush}"
                                    IsHitTestVisible="False">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsSelected"/>
                                        <Binding Path="HasSelectionInfo"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"
                                              Width="12" Height="12"
                                              Foreground="{DynamicResource AccentColorBrush}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectionInfo}"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

    </Grid>
</Window>
