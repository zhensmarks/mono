<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BMachine.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
             x:Class="BMachine.UI.Views.SpreadsheetView"
             x:DataType="vm:SpreadsheetViewModel">

    <UserControl.Styles>
        <!-- Typography --><!-- ═══ Excel-Like DataGrid (theme colors only, follow app settings) ═══ -->
        <Style Selector="DataGridCell">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="{Binding Height}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Copy Row ID" Command="{Binding CopyIdCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource IconCopy}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open in Trello" Command="{Binding OpenInTrelloCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource IconExternalLink}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hover: subtle row highlight -->
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource MenuHoverBrush}"/>
        </Style>

        <!-- Selected rows: completely transparent so ONLY the active cell is highlighted (Excel style) -->
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridCell:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridCell:selected /template/ Rectangle">
            <Setter Property="Fill" Value="Transparent"/>
        </Style>

        <!-- Current / focused cell: accent outline only on this single cell (Google Sheets / Excel active cell) -->
        <Style Selector="DataGridCell:current">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource AccentLowOpacityBrush}"/>
        </Style>

        <!-- Selected cell in column range (only the targeted column cells get highlighted!) -->
        <Style Selector="DataGridCell.cell-selected">
            <Setter Property="Background" Value="{DynamicResource AccentLowOpacityBrush}"/>
        </Style>
        <Style Selector="DataGridCell.cell-selected /template/ Rectangle">
            <Setter Property="Fill" Value="{DynamicResource AccentLowOpacityBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.cell-selected">
            <Setter Property="Background" Value="{DynamicResource AccentLowOpacityBrush}"/>
        </Style>
        <Style Selector="DataGridCell.cell-selected:selected">
            <Setter Property="Background" Value="{DynamicResource AccentLowOpacityBrush}"/>
        </Style>

        <!-- Cell Editor TextBox: seamless in-cell editing without outer borders or corner radius -->
        <Style Selector="DataGridCell TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridCell TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Excel-style fill handle (small square on the active cell corner) -->
        <Style Selector="Border.fh">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:current Border.fh">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Grid lines -->
        <Style Selector="DataGrid">
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource SeparatorBrush}"/>
        </Style>

        <!-- Column header: subtle theme bar, not accent colored -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="DataGridColumnHeader /template/ ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="DataGridColumnHeader TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- ═══ Slim header toggle buttons (theme only) ═══ -->
        <Style Selector="Button.Hdr">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.Hdr /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.Hdr:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="Button.Hdr PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- Active (on) state: app accent, still theme driven -->
        <Style Selector="Button.Hdr.on">
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="Button.Hdr.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.Hdr.on PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
        </Style>

        <!-- ═══ In-Cell Date editing buttons (TODAY & Calendar Icon) ═══ -->
        <Style Selector="Button.DateBtn">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.DateBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="Button.DateBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="Button.DateBtn PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ═══ Slim header bar (simple menu-bar look, not wide) ═══ -->
        <Border Grid.Row="0" Padding="10,4"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="10">

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconGrid}" Width="15" Height="15" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="Data Spreadsheet" FontWeight="SemiBold" FontSize="12.5"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Height="18" VerticalAlignment="Center"
                        Background="{DynamicResource SeparatorBrush}"/>

                <!-- Middle: Date filter (compact) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="Hdr" Classes.on="{Binding IsTodayFilterActive}"
                            Command="{Binding FilterTodayCommand}"
                            ToolTip.Tip="Filter pesanan hari ini (TODAY)"
                            Height="26" Padding="10,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconCalendarFilled}" Width="12" Height="12"/>
                            <TextBlock Text="TODAY" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="Hdr" ToolTip.Tip="Pilih tanggal manual"
                            Height="26" Padding="8,0">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border CornerRadius="8" Padding="6"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
                                    <Calendar SelectedDate="{Binding SelectedDateFilter, Mode=TwoWay}"/>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconCalendarFilled}" Width="14" Height="14"/>
                            <TextBlock Text="{Binding FilterDateDisplay}" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120"
                                       IsVisible="{Binding HasManualDateFilter}"/>
                            <TextBlock Text="Pilih Tanggal" FontSize="11" VerticalAlignment="Center"
                                       IsVisible="{Binding !HasManualDateFilter}"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="Hdr" Command="{Binding ClearDateFilterCommand}"
                            ToolTip.Tip="Hapus filter tanggal"
                            Height="26" Width="24" Padding="0"
                            IsVisible="{Binding SelectedDateFilter, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <PathIcon Data="{StaticResource IconX}" Width="11" Height="11"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Right: Search -->
                <Border Grid.Column="3" Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="2,0" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto, *">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconSearch}" Width="14" Height="14"
                                  Margin="8,0,4,0" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText}" Watermark="Smart Search (nama: teks)..."
                                 Classes="Clear" BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" MinWidth="170" FontSize="12"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ DataGrid surface ═══ -->
        <Border Grid.Row="1" x:Name="GridContainer"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,0"/>

        <!-- ═══ Slim status bar ═══ -->
        <Border Grid.Row="2" Padding="10,6"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <!-- Left: Status & sync indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource IconSave}" Width="12" Height="12"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              Opacity="{Binding IsLoading, Converter={x:Static ObjectConverters.IsNull}}"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11.5" VerticalAlignment="Center" FontWeight="Medium"/>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                                 Width="70" Height="2" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Quick controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                    <!-- Zoom controls -->
                    <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="5"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <Button Command="{Binding ZoomOutCommand}" Classes="Clear" ToolTip.Tip="Zoom Out"
                                    Padding="6,2" CornerRadius="4,0,0,4" Height="22">
                                <TextBlock Text="-" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </Button>
                            <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}" VerticalAlignment="Center"
                                       Margin="6,0" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button Command="{Binding ZoomInCommand}" Classes="Clear" ToolTip.Tip="Zoom In"
                                    Padding="6,2" CornerRadius="0,4,4,0" Height="22">
                                <TextBlock Text="+" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Columns menu -->
                    <Button Classes="Clear" ToolTip.Tip="Kelola Kolom"
                            Background="{DynamicResource AppBackgroundBrush}" CornerRadius="5"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Padding="6,2" Height="26">
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <Border CornerRadius="8" Padding="5"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
                                    <ScrollViewer MaxHeight="300">
                                        <ItemsControl ItemsSource="{Binding Columns}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayTitle}" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                              Margin="4,3" FontSize="12"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <PathIcon Data="{StaticResource IconGrid}" Width="14" Height="14"
                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>

                    <!-- Refresh -->
                    <Button x:Name="RefreshBtn" Command="{Binding LoadDataCommand}" Classes="Clear"
                            IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Refresh Data"
                            Background="{DynamicResource AppBackgroundBrush}" CornerRadius="5"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Padding="6,2" Height="26">
                        <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14"
                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>

                    <!-- Save -->
                    <Button Command="{Binding SaveChangesCommand}" Classes="Primary"
                            IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Save All Changes"
                            CornerRadius="5" Padding="12,4" Height="26" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconSave}" Width="14" Height="14" Foreground="White"/>
                            <TextBlock Text="Save" FontWeight="Bold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>