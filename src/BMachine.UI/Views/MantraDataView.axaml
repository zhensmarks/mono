<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BMachine.UI.ViewModels"
             xmlns:models="using:BMachine.UI.Models.MantraData"
             xmlns:local="using:BMachine.UI.Views"
             x:Class="BMachine.UI.Views.MantraDataView"
             x:DataType="vm:MantraDataViewModel"
             Background="Transparent"
             DragDrop.AllowDrop="True">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextSheetCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousSheetCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Resources>
        <local:PhotoFilterEqualsConverter x:Key="FilterEq"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Application Default Typography --><!-- DataGrid Excel-Like Minimalist Dark: Solid border, absolutely no jump/scale animation on click.
             Cell selection is driven by code (per-cell Background/BorderBrush), not by row selection. -->
        <Style Selector="DataGridCell">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="#E8E8E6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#11FFFFFF"/>
        </Style>

        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Mask Avalonia theme row-based cell highlight; real per-cell highlight is applied in code -->
        <Style Selector="DataGridCell:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridCell:current">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="DataGridColumnHeader:pointerover">
            <Setter Property="Background" Value="#212126"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
        </Style>

        <!-- Invisible ScrollBar Style (Scrollable with mouse wheel, but completely hidden visually) -->
        <Style Selector="ScrollBar">
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Tool Buttons: Explicit ContentPresenter background prevents transparent button bug -->
        <Style Selector="Button.ToolBtn">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.ToolBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="TextElement.Foreground" Value="#E4E4E7"/>
        </Style>
        <Style Selector="Button.ToolBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="TextElement.Foreground" Value="#F4F4F5"/>
        </Style>
        <Style Selector="Button.ToolBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#202023"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
        </Style>

        <!-- Primary Action Button: Explicit ContentPresenter background prevents transparent button bug -->
        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.ActionBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="#111111"/>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="TextElement.Foreground" Value="#111111"/>
        </Style>
        <Style Selector="Button.ActionBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#D4D4D4"/>
            <Setter Property="TextElement.Foreground" Value="#111111"/>
        </Style>

        <!-- Multi-sheet Tab Items -->
        <Style Selector="ListBox.SheetTabs ListBoxItem">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.SheetTabs ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="ListBox.SheetTabs ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="TextElement.Foreground" Value="#F4F4F5"/>
        </Style>
        <Style Selector="ListBox.SheetTabs ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.SegTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.SegTab:pointerover">
            <Setter Property="Background" Value="#242429"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
        </Style>
        <Style Selector="Button.SegTab.Active">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" Margin="0,2,0,8" RowDefinitions="Auto, Auto, Auto, Auto">
            <DockPanel Grid.Row="0" LastChildFill="False" Background="#101014">
                <Menu DockPanel.Dock="Left" Background="#101014" Foreground="#D4D4D8" FontSize="12">
                    <MenuItem Header="File">
                        <MenuItem Header="Tabel Baru" Command="{Binding NewTableCommand}" InputGesture="Ctrl+N"/>
                        <MenuItem Header="Buka File Excel/Word..." Click="OnOpenFileClicked" InputGesture="Ctrl+O"/>
                        <MenuItem Header="Simpan ke DATER" Command="{Binding ExportDaterCommand}" InputGesture="Ctrl+S"/>
                        <MenuItem Header="Tutup Data (Clear)" Command="{Binding ClearDataCommand}" InputGesture="Ctrl+W"/>
                    </MenuItem>
                    <MenuItem Header="Edit">
                        <MenuItem Header="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" InputGesture="Ctrl+Z"/>
                        <MenuItem Header="Redo" Command="{Binding RedoLastCommand}" IsEnabled="{Binding CanRedo}" InputGesture="Ctrl+Shift+Z"/>
                    </MenuItem>
                    <MenuItem Header="Data">
                        <MenuItem Header="Pembersihan Cepat (AI/Rule)..." Command="{Binding OpenCleanerDialogCommand}" InputGesture="F3"/>
                        <MenuItem Header="Atur Kolom..." Command="{Binding OpenTransformDialogCommand}" InputGesture="F8"/>
                        <MenuItem Header="Rapikan Semua (Smart Clean)" Command="{Binding CleanupAllCommand}"/>
                    </MenuItem>
                </Menu>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Atur Kolom" Classes="ToolBtn"
                            Height="26" Padding="8,4" Margin="0,0,6,0"
                            ToolTip.Tip="Buka susunan kolom hasil (Atur Kolom, F8)"
                            Command="{Binding OpenTransformDialogCommand}"/>
                    <Button Content="Proses Photoshop" Classes="ToolBtn" Height="26" Padding="8,4"
                            Command="{Binding ProcessPhotoshopCommand}"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,6,0,0" IsVisible="{Binding HasData}">
                <Border x:Name="MasterPsdCard" Grid.Column="0" Background="#151519" BorderBrush="#303038" BorderThickness="1" CornerRadius="7" Padding="12,8"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragEnter="OnFolderDragEnter" DragDrop.DragOver="OnFolderDragOver" DragDrop.DragLeave="OnFolderDragLeave" DragDrop.Drop="OnMasterPsdDrop">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="MASTER PSD" FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                <TextBlock Text="· Tarik folder ke sini" FontSize="10" Foreground="#52525B"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MasterPsdStatus}" FontSize="12" Foreground="#E4E4E7" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Pilih folder" Classes="ToolBtn" Command="{Binding PickMasterPsdFolderCommand}"/>
                    </Grid>
                </Border>
                <Border x:Name="PhotoCard" Grid.Column="1" Background="#151519" BorderBrush="#303038" BorderThickness="1" CornerRadius="7" Padding="12,8"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragEnter="OnFolderDragEnter" DragDrop.DragOver="OnFolderDragOver" DragDrop.DragLeave="OnFolderDragLeave" DragDrop.Drop="OnPhotoDrop">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="FOLDER FOTO" FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                <TextBlock Text="· Tarik folder ke sini" FontSize="10" Foreground="#52525B"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PhotoFolderStatus}" FontSize="12" Foreground="#E4E4E7" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Pilih folder" Classes="ToolBtn" Command="{Binding PickPhotoFolderCommand}"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#121215" BorderBrush="#232326" BorderThickness="1" CornerRadius="4,4,0,0"
                    Padding="4,2" Margin="0,2,0,0" IsVisible="{Binding HasData}">
                <DockPanel>
                    <TextBlock Text="Sheet:" Foreground="#71717A" FontSize="11" VerticalAlignment="Center" Margin="6,0,8,0"/>
                    <ListBox Classes="SheetTabs" ItemsSource="{Binding SheetNames}" SelectedIndex="{Binding CurrentSheetIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Row="3" Background="#101014" BorderBrush="#232326" BorderThickness="1" CornerRadius="4,4,0,0"
                    Padding="8,4" Margin="0,2,0,0" IsVisible="{Binding HasData}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="STATUS FOTO" Foreground="#52525B" FontSize="9.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="2,0,0,0"/>
                    <Border Background="#16161A" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="2">
                        <StackPanel x:Name="SegTabPanel" Orientation="Horizontal">
                            <Button Classes="SegTab" Tag="SEMUA" Click="OnPhotoFilterTabClicked">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Semua"/>
                                    <Border CornerRadius="7" Padding="5,0" Background="#26262C">
                                        <TextBlock Text="{Binding TotalRows}" FontSize="9.5" Foreground="#D4D4D8"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Border Width="1" Background="#27272A" Margin="0,4"/>
                            <Button Classes="SegTab" Tag="REVIEW" Click="OnPhotoFilterTabClicked">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Perlu Review"/>
                                    <Border CornerRadius="7" Padding="5,0" Background="#2A2410">
                                        <TextBlock Text="{Binding ReviewCount}" FontSize="9.5" Foreground="#FBBF24"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Border Width="1" Background="#27272A" Margin="0,4"/>
                            <Button Classes="SegTab" Tag="GANDA" Click="OnPhotoFilterTabClicked">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Ambigu / Ganda"/>
                                    <Border CornerRadius="7" Padding="5,0" Background="#152038">
                                        <TextBlock Text="{Binding GandaCount}" FontSize="9.5" Foreground="#60A5FA"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Border Width="1" Background="#27272A" Margin="0,4"/>
                            <Button Classes="SegTab" Tag="COCOK" Click="OnPhotoFilterTabClicked">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Cocok"/>
                                    <Border CornerRadius="7" Padding="5,0" Background="#0D2818">
                                        <TextBlock Text="{Binding CocokCount}" FontSize="9.5" Foreground="#3FB950"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Border Width="1" Background="#27272A" Margin="0,4"/>
                            <Button Classes="SegTab" Tag="BELUM" Click="OnPhotoFilterTabClicked">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Belum Ada"/>
                                    <Border CornerRadius="7" Padding="5,0" Background="#26262C">
                                        <TextBlock Text="{Binding BelumCount}" FontSize="9.5" Foreground="#8B949E"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Data appears after source file loads. -->
        <!-- Main content area: Empty state shown when no data; DataGrid shown when data loaded -->
        <Border Grid.Row="1" Background="#111113" BorderBrush="#232326" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid x:Name="GridContainer">
                <DataGrid x:Name="MainDataGrid"
                          IsVisible="{Binding HasData}"
                          ItemsSource="{Binding FilteredRows}"
                          AutoGenerateColumns="False"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="True"
                          CanUserSortColumns="False"
                          SelectionMode="Extended"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          BorderThickness="0"
                          Background="Transparent"
                          Foreground="#E8E8E6"
HorizontalGridLinesBrush="#27272A"
                          VerticalGridLinesBrush="#27272A"
SelectionChanged="OnDataGridSelectionChanged"
                          BeginningEdit="OnDataGridBeginningEdit"
                          CellEditEnded="OnDataGridCellEditEnded">

                    <!-- Context Menu -->
                    <!-- Context Menu -->
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#111113" BorderBrush="#232326" BorderThickness="1" Opened="OnContextMenuOpened">
                            <!-- 1. Clipboard & Edit -->
                            <MenuItem Tag="Copy" Header="Salin" InputGesture="Ctrl+C" Click="OnMenuCopyClicked"/>
                            <MenuItem Tag="Paste" Header="Tempel" InputGesture="Ctrl+V" Click="OnMenuPasteClicked"/>
                            <MenuItem Tag="ClearCells" Header="Kosongkan Sel" InputGesture="Delete" Click="OnMenuClearCellsClicked"/>
                            <Separator Background="#232326"/>

                            <!-- 2. Data Actions -->
                            <MenuItem Tag="CustomMerge" Header="Gabung Kolom..." Click="OnMenuCustomMergeClicked"/>
                            <MenuItem Tag="TitleCase" Header="Rapikan Teks (Title Case)" Click="OnMenuTitleCaseClicked"/>
                            <MenuItem Tag="DateFormatFull" Header="Format Tanggal (DD MMMM YYYY)" Click="OnMenuDateFormatFullClicked"/>
                            <MenuItem Tag="PhonePrefix" Header="Format No. HP (+62 / 08)" Click="OnMenuPhonePrefixClicked"/>
                            <MenuItem Tag="FindReplace" Header="Cari dan Ganti..." InputGesture="Ctrl+F" Click="OnMenuFindReplaceClicked"/>
                            <MenuItem Tag="SplitColumn" Header="Pisah Kolom (Split)..." Click="OnMenuSplitColumnClicked"/>
                            <Separator Background="#232326"/>

                            <!-- 3. Manage Columns -->
                            <MenuItem Tag="InsertColumnLeft" Header="Sisipkan Kolom di Kiri" Click="OnMenuInsertColumnLeftClicked"/>
                            <MenuItem Tag="InsertColumnRight" Header="Sisipkan Kolom di Kanan" Click="OnMenuInsertColumnRightClicked"/>
                            <MenuItem Tag="MoveColumnLeft" Header="Pindahkan Kolom ke Kiri" Click="OnMenuMoveColumnLeftClicked"/>
                            <MenuItem Tag="MoveColumnRight" Header="Pindahkan Kolom ke Kanan" Click="OnMenuMoveColumnRightClicked"/>
                            <MenuItem Tag="RenameColumn" Header="Ganti Nama Kolom..." Click="OnMenuRenameColumnClicked"/>
                            <MenuItem Tag="DeleteColumn" Header="Hapus Kolom Ini" Click="OnMenuDeleteColumnClicked"/>
                            <MenuItem Tag="AutoFit" Header="Otomatis Ukuran Kolom" Click="OnMenuAutoFitClicked"/>
                            <Separator Background="#232326"/>

                            <!-- 4. Manage Rows -->
                            <MenuItem Tag="InsertRow" Header="Tambah Baris Baru" Click="OnMenuInsertRowClicked"/>
                            <MenuItem Tag="DeleteRows" Header="Hapus Baris Terpilih" Click="OnMenuDeleteRowsClicked"/>
                            <Separator Background="#232326"/>

                            <!-- 5. Row Color Tagging -->
                            <MenuItem Tag="ColorTag" Header="Tandai Baris (Warna)">
                                <MenuItem Tag="ColorGreen" Header="Hijau (Valid)" Click="OnMenuColorGreenClicked"/>
                                <MenuItem Tag="ColorBlue" Header="Biru (Info)" Click="OnMenuColorBlueClicked"/>
                                <MenuItem Tag="ColorAmber" Header="Kuning (Periksa)" Click="OnMenuColorAmberClicked"/>
                                <MenuItem Tag="ColorRed" Header="Merah (Error)" Click="OnMenuColorRedClicked"/>
                                <Separator Background="#232326"/>
                                <MenuItem Tag="ColorClear" Header="Hapus Tanda Warna" Click="OnMenuColorClearClicked"/>
                            </MenuItem>

                            <!-- 6. Context Menu Settings -->
                            <Separator Background="#232326"/>
                            <MenuItem Header="Atur Menu Klik Kanan..." Click="OnMenuConfigureContextMenuClicked"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <Border x:Name="EmptyPrompt" Background="#111113" BorderBrush="#232326" BorderThickness="1"
                        CornerRadius="10" Margin="24" IsVisible="{Binding !HasData}">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="820" Margin="0,10">
                        <StackPanel Orientation="Vertical" Spacing="22">

                            <!-- Header -->
                            <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="MANTRADATA" FontSize="10" FontWeight="Bold" Foreground="#3F3F46"
                                           HorizontalAlignment="Center" LetterSpacing="3"/>
                                <TextBlock Text="Mulai Pencocokan Data" FontSize="26" FontWeight="SemiBold"
                                           Foreground="#F4F4F5" HorizontalAlignment="Center"/>
                                <TextBlock Text="Pilih data utama untuk mulai. Folder foto dan master PSD bersifat opsional dan bisa diatur kapan saja."
                                           Foreground="#A1A1AA" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="560" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Step Cards -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" MaxWidth="780" HorizontalAlignment="Center">

                                <!-- Step 1 -->
                                <Border Grid.Column="0" Background="#151519" BorderBrush="#27272A" BorderThickness="1"
                                        CornerRadius="8" Padding="16,14">
                                    <StackPanel Orientation="Vertical" Spacing="6">
                                        <TextBlock Text="01" FontSize="11" FontWeight="Bold" Foreground="#3F3F46"/>
                                        <TextBlock Text="Pilih Data Utama" FontSize="13.5" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                        <TextBlock Text="File Excel atau Word berisi tabel nama yang akan dicocokkan dengan foto."
                                                   FontSize="11.5" Foreground="#71717A" TextWrapping="Wrap" LineHeight="16"/>
                                        <Button Classes="ActionBtn" Content="Buka File Excel / Word" Height="30"
                                                HorizontalAlignment="Stretch" Click="OnOpenFileClicked" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Step 2 -->
                                <Border Grid.Column="1" Background="#151519" BorderBrush="#27272A" BorderThickness="1"
                                        CornerRadius="8" Padding="16,14">
                                    <StackPanel Orientation="Vertical" Spacing="6">
                                        <TextBlock Text="02" FontSize="11" FontWeight="Bold" Foreground="#3F3F46"/>
                                        <TextBlock Text="Master PSD" FontSize="13.5" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                        <TextBlock Text="Template Photoshop untuk pengisian otomatis. Opsional."
                                                   FontSize="11.5" Foreground="#71717A" TextWrapping="Wrap" LineHeight="16"/>
                                        <Border Background="#0C0C0E" BorderBrush="#232326" BorderThickness="1" CornerRadius="6"
                                                Padding="8,4" HorizontalAlignment="Left" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding MasterPsdStatus}" FontSize="10.5" Foreground="#8B949E"/>
                                        </Border>
                                        <Button Classes="ToolBtn" Content="Pilih folder PSD" Height="30"
                                                HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                                Command="{Binding PickMasterPsdFolderCommand}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Step 3 -->
                                <Border Grid.Column="2" Background="#151519" BorderBrush="#27272A" BorderThickness="1"
                                        CornerRadius="8" Padding="16,14">
                                    <StackPanel Orientation="Vertical" Spacing="6">
                                        <TextBlock Text="03" FontSize="11" FontWeight="Bold" Foreground="#3F3F46"/>
                                        <TextBlock Text="Folder Foto" FontSize="13.5" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                        <TextBlock Text="Kumpulan foto peserta. Pencocokan otomatis berjalan setelah data dimuat."
                                                   FontSize="11.5" Foreground="#71717A" TextWrapping="Wrap" LineHeight="16"/>
                                        <Border Background="#0C0C0E" BorderBrush="#232326" BorderThickness="1" CornerRadius="6"
                                                Padding="8,4" HorizontalAlignment="Left" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding PhotoFolderStatus}" FontSize="10.5" Foreground="#8B949E"/>
                                        </Border>
                                        <Button Classes="ToolBtn" Content="Pilih folder foto" Height="30"
                                                HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                                Command="{Binding PickPhotoFolderCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Hint + Shortcuts -->
                            <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Center">
                                <TextBlock Text="Seret file langsung ke area ini, atau gunakan pintasan berikut"
                                           Foreground="#52525B" FontSize="11" TextAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="Ctrl+N  Tabel Baru" FontSize="10.5" Foreground="#A1A1AA"/>
                                    </Border>
                                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="F3  Pembersihan AI" FontSize="10.5" Foreground="#A1A1AA"/>
                                    </Border>
                                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="F8  Atur Kolom" FontSize="10.5" Foreground="#A1A1AA"/>
                                    </Border>
                                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="Ctrl+F  Cari &amp; Ganti" FontSize="10.5" Foreground="#A1A1AA"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Drag Glow Overlay (Pure Text, No Icons) -->
                <Border x:Name="DragOverlay" Background="#203B82F6" BorderBrush="#60A5FA" BorderThickness="2"
                        CornerRadius="10" IsVisible="False" IsHitTestVisible="False">
                    <TextBlock Text="Lepaskan file untuk membaca data tabel" FontWeight="SemiBold" FontSize="15"
                               Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
</Grid>
        </Border>

        <!-- Floating: Dropdown Cari & Ganti Cepat (menurun ke bawah, rata tengah dgn kotak Cari data) -->
        <Border Grid.Row="1" IsVisible="{Binding IsAdvancedSearchOpen}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,31,0"
                Background="#111113" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,8" BoxShadow="0 4 16 6 #1A000000">
            <StackPanel Orientation="Vertical" Spacing="6" Width="140">
                <TextBlock Text="Ganti dengan" Foreground="#A1A1AA" FontSize="11"/>
                <TextBox Text="{Binding ReplaceText, Mode=TwoWay}" Height="26"
                         VerticalContentAlignment="Center" Background="#0A0A0C" Foreground="#E8E8E6"
                         BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="6,0" FontSize="11"
                         Watermark="Ganti teks..."/>
                <Button Content="Ganti Semua" Classes="ToolBtn" Height="26" Padding="0,0"
                        FontWeight="SemiBold"
                        Command="{Binding QuickReplaceAllCommand}"/>
            </StackPanel>
        </Border>

        <!-- ═══ 3. STATUS BAR FOOTER BENTO (Pure Text) ═══ -->
        <Border Grid.Row="2" Background="#0C0C0E" BorderBrush="#232326" BorderThickness="1"
                CornerRadius="8" Padding="14,6" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsLoading}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#71717A" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalRows, StringFormat='Data: {0} baris'}"
                               FontSize="11" Foreground="#71717A"/>
                    <TextBlock Text="{Binding SelectedRowCount, StringFormat='Terpilih: {0}'}"
                               FontSize="11" Foreground="#52525B"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
