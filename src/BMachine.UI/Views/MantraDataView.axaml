<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BMachine.UI.ViewModels"
             xmlns:models="using:BMachine.UI.Models.MantraData"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="700"
             x:Class="BMachine.UI.Views.MantraDataView"
             x:DataType="vm:MantraDataViewModel"
Background="Transparent"
             DragDrop.AllowDrop="True">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextSheetCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousSheetCommand}"/>
</UserControl.KeyBindings>

    <UserControl.Styles>
        <!-- DataGrid Excel-Like Minimalist Dark: Solid border, absolutely no jump/scale animation on click.
             Cell selection is driven by code (per-cell Background/BorderBrush), not by row selection. -->
        <Style Selector="DataGridCell">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="#E8E8E6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#11FFFFFF"/>
        </Style>

        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Mask Avalonia theme row-based cell highlight; real per-cell highlight is applied in code -->
        <Style Selector="DataGridCell:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridCell:current">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="DataGridColumnHeader:pointerover">
            <Setter Property="Background" Value="#212126"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
        </Style>

        <!-- Invisible ScrollBar Style (Scrollable with mouse wheel, but completely hidden visually) -->
        <Style Selector="ScrollBar">
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="Button.ToolBtn">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.ToolBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="TextElement.Foreground" Value="#F4F4F5"/>
        </Style>

        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
<Style Selector="Button.ActionBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="TextElement.Foreground" Value="#111111"/>
        </Style>

        <Style Selector="ListBox.SheetTabs ListBoxItem:selected">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto">

<!-- ═══ 1. MINIMALIST MENU BAR + SEARCH + MULTI-SHEET TABS (IDENTICAL TO BDATER) ═══ -->
        <Grid Grid.Row="0" Margin="0,2,0,8" RowDefinitions="Auto, Auto">
            <DockPanel Grid.Row="0" LastChildFill="False" Background="#101014">
                <Menu DockPanel.Dock="Left" Background="#101014" Foreground="#D4D4D8" FontSize="12">
                    <MenuItem Header="File">
                        <MenuItem Header="Tabel Baru" Command="{Binding NewTableCommand}" InputGesture="Ctrl+N"/>
                        <MenuItem Header="Buka File Excel/Word..." Click="OnOpenFileClicked" InputGesture="Ctrl+O"/>
                        <MenuItem Header="Simpan ke DATER" Command="{Binding ExportDaterCommand}" InputGesture="Ctrl+S"/>
                        <MenuItem Header="Tutup Data (Clear)" Command="{Binding ClearDataCommand}" InputGesture="Ctrl+W"/>
                        <Separator Background="#27272A"/>
                        <MenuItem Header="Export ke DATER (TXT + JSON + XLSX)" Click="OnExportDaterMenuClick"/>
                        <MenuItem Header="Export ke Excel (.xlsx)" Tag="xlsx" Click="OnExportFormatMenuClick"/>
                        <MenuItem Header="Export ke CSV (.csv)" Tag="csv" Click="OnExportFormatMenuClick"/>
                        <MenuItem Header="Export ke TXT" Tag="txt" Click="OnExportFormatMenuClick"/>
                    </MenuItem>
                    <MenuItem Header="Edit">
                        <MenuItem Header="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" InputGesture="Ctrl+Z"/>
                        <MenuItem Header="Redo" Command="{Binding RedoLastCommand}" IsEnabled="{Binding CanRedo}" InputGesture="Ctrl+Shift+Z"/>
                        <Separator Background="#27272A"/>
                        <MenuItem Header="Cari &amp; Ganti..." Click="OnMenuFindReplaceClicked" InputGesture="Ctrl+H"/>
                    </MenuItem>
<MenuItem Header="Data">
                        <MenuItem Header="Pembersihan Cepat (AI/Rule)..." Command="{Binding OpenCleanerDialogCommand}" InputGesture="F3"/>
                        <MenuItem Header="Susun Kolom (Layout Pekerjaan)" Command="{Binding ApplyLayoutCommand}"/>
                        <MenuItem Header="Studio Transformasi / Rapikan..." Command="{Binding OpenTransformDialogCommand}" InputGesture="F8"/>
                        <MenuItem Header="Rapikan Semua (Smart Clean)" Command="{Binding CleanupAllCommand}"/>
                        <Separator Background="#27272A"/>
                        <MenuItem Header="Rapikan Huruf (Title Case)" Click="OnMenuTitleCaseClicked"/>
                        <MenuItem Header="Format Tanggal Indonesia" Click="OnMenuDateFormatFullClicked" InputGesture="F11"/>
                        <MenuItem Header="Format No. HP (+62)" Click="OnMenuPhonePrefixClicked"/>
                        <MenuItem Header="Normalisasi Gender (L/P)" Click="OnMenuNormalizeGenderClicked"/>
                        <MenuItem Header="Trim Spasi Berlebih" Click="OnMenuTrimSpacesClicked"/>
                    </MenuItem>
                    <MenuItem Header="Photoshop">
                        <MenuItem Header="Proses ke Photoshop (PSD)..." Command="{Binding ProcessPhotoshopCommand}" InputGesture="Ctrl+Enter"/>
                    </MenuItem>
                </Menu>

                <!-- Right: Search Filter Box + Inline Replace Toggle -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchFilter, Mode=TwoWay}"
                             Height="26" Width="140"
                             VerticalContentAlignment="Center"
                             Background="#0A0A0C" Foreground="#E8E8E6"
                             BorderBrush="#27272A" BorderThickness="1"
                             CornerRadius="4" Padding="6,0" FontSize="11"
                             Watermark="Cari data..."
                             Margin="0,0,2,0"/>
<!-- Mode Lanjutan: Cari & Ganti Cepat langsung di toolbar -->
                    <Button Content="⇄" ToolTip.Tip="Cari &amp; Ganti Cepat"
                            Height="26" Width="26" Padding="0" Margin="0,0,3,0"
                            Background="#18181B" Foreground="#93C5FD" BorderBrush="#27272A" BorderThickness="1"
                            CornerRadius="4"
                            Command="{Binding ToggleAdvancedSearchCommand}"/>
</StackPanel>
            </DockPanel>

            <!-- Multi-Sheet Tabs Bar -->
            <Border Grid.Row="1" Background="#121215" BorderBrush="#232326" BorderThickness="1,0,1,1"
                    CornerRadius="4,4,0,0" Padding="4,2" Margin="0,2,0,0">
                <DockPanel>
                    <TextBlock Text="Sheet:" Foreground="#71717A" FontSize="11" VerticalAlignment="Center" Margin="6,0,8,0"/>
                    <ListBox Classes="SheetTabs" ItemsSource="{Binding SheetNames}" SelectedIndex="{Binding CurrentSheetIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem">
                                <Setter Property="Background" Value="#18181B"/>
                                <Setter Property="Foreground" Value="#A1A1AA"/>
                                <Setter Property="Margin" Value="0,0,4,0"/>
                                <Setter Property="Padding" Value="10,3"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ 2. DATAGRID BENTO CARD SURFACE ═══ -->
        <Border Grid.Row="1" Background="#111113" BorderBrush="#232326" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid x:Name="GridContainer">
                <DataGrid x:Name="MainDataGrid"
                          ItemsSource="{Binding FilteredRows}"
                          AutoGenerateColumns="False"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="True"
                          CanUserSortColumns="False"
                          SelectionMode="Extended"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          BorderThickness="0"
                          Background="Transparent"
                          Foreground="#E8E8E6"
HorizontalGridLinesBrush="#27272A"
                          VerticalGridLinesBrush="#27272A"
SelectionChanged="OnDataGridSelectionChanged"
                          BeginningEdit="OnDataGridBeginningEdit"
                          CellEditEnded="OnDataGridCellEditEnded">

                    <!-- Context Menu -->
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#111113" BorderBrush="#232326" BorderThickness="1">
                            <!-- 1. Clipboard & Edit -->
                            <MenuItem Header="Salin" InputGesture="Ctrl+C" Click="OnMenuCopyClicked"/>
                            <MenuItem Header="Tempel" InputGesture="Ctrl+V" Click="OnMenuPasteClicked"/>
                            <MenuItem Header="Kosongkan Sel" InputGesture="Delete" Click="OnMenuClearCellsClicked"/>
                            <Separator Background="#232326"/>

                            <!-- 2. Data Actions -->
                            <MenuItem Header="Gabung Kolom..." Click="OnMenuCustomMergeClicked"/>
                            <MenuItem Header="Rapikan Teks (Title Case)" Click="OnMenuTitleCaseClicked"/>
                            <MenuItem Header="Format Tanggal (DD MMMM YYYY)" Click="OnMenuDateFormatFullClicked"/>
                            <MenuItem Header="Format No. HP (+62 / 08)" Click="OnMenuPhonePrefixClicked"/>
                            <MenuItem Header="Cari dan Ganti..." InputGesture="Ctrl+H" Click="OnMenuFindReplaceClicked"/>
                            <MenuItem Header="Pisah Kolom (Split)..." Click="OnMenuSplitColumnClicked"/>
                            <Separator Background="#232326"/>

                            <!-- 3. Manage Columns -->
                            <MenuItem Header="Sisipkan Kolom di Kiri" Click="OnMenuInsertColumnLeftClicked"/>
                            <MenuItem Header="Sisipkan Kolom di Kanan" Click="OnMenuInsertColumnRightClicked"/>
                            <MenuItem Header="Pindahkan Kolom ke Kiri" Click="OnMenuMoveColumnLeftClicked"/>
                            <MenuItem Header="Pindahkan Kolom ke Kanan" Click="OnMenuMoveColumnRightClicked"/>
                            <MenuItem Header="Ganti Nama Kolom..." Click="OnMenuRenameColumnClicked"/>
                            <MenuItem Header="Hapus Kolom Ini" Click="OnMenuDeleteColumnClicked"/>
                            <Separator Background="#232326"/>

                            <!-- 4. Manage Rows -->
                            <MenuItem Header="Tambah Baris Baru" Click="OnMenuInsertRowClicked"/>
                            <MenuItem Header="Hapus Baris Terpilih" Click="OnMenuDeleteRowsClicked"/>
                            <Separator Background="#232326"/>

                            <!-- 5. Row Color Tagging -->
                            <MenuItem Header="Tandai Baris (Warna)">
                                <MenuItem Header="Hijau (Valid)" Click="OnMenuColorGreenClicked"/>
                                <MenuItem Header="Biru (Info)" Click="OnMenuColorBlueClicked"/>
                                <MenuItem Header="Kuning (Periksa)" Click="OnMenuColorAmberClicked"/>
                                <MenuItem Header="Merah (Error)" Click="OnMenuColorRedClicked"/>
                                <Separator Background="#232326"/>
                                <MenuItem Header="Hapus Tanda Warna" Click="OnMenuColorClearClicked"/>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- Empty State Prompt (Pure Text, No Icons) -->
                <Border x:Name="EmptyPrompt" Background="#111113" BorderBrush="#232326" BorderThickness="1"
                        CornerRadius="10" Margin="30" IsVisible="False"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="32,28">
                        <TextBlock Text="Tarik &amp; Lepas File Data ke Sini" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#F4F4F5" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Mendukung spreadsheet Excel (.xlsx, .xls) dan biodata Word (.docx). Klik tombol di bawah atau seret dokumen dari folder."
                                   Foreground="#71717A" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,0,0,22" LineHeight="18"/>
                        <Button Classes="ActionBtn" Content="Pilih File dari Komputer"
                                Padding="20,8" Height="36" HorizontalAlignment="Center"
                                Click="OnOpenFileClicked" Margin="0,0,0,10"/>
                        <Button Classes="ToolBtn" Content="Buat tabel buku tahunan / ID card"
                                Padding="18,7" Height="34" HorizontalAlignment="Center"
                                Command="{Binding NewTableCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Drag Glow Overlay (Pure Text, No Icons) -->
                <Border x:Name="DragOverlay" Background="#203B82F6" BorderBrush="#60A5FA" BorderThickness="2"
                        CornerRadius="10" IsVisible="False" IsHitTestVisible="False">
                    <TextBlock Text="Lepaskan file untuk membaca data tabel" FontWeight="SemiBold" FontSize="15"
                               Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
</Grid>
        </Border>

        <!-- Floating: Dropdown Cari & Ganti Cepat (menurun ke bawah, rata tengah dgn kotak Cari data) -->
        <Border Grid.Row="1" IsVisible="{Binding IsAdvancedSearchOpen}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,31,0"
                Background="#111113" BorderBrush="#3F3F46" BorderThickness="1"
                CornerRadius="8" Padding="10,8" BoxShadow="0 4 16 6 #1A000000">
            <StackPanel Orientation="Vertical" Spacing="6" Width="140">
                <TextBlock Text="Ganti dengan" Foreground="#A1A1AA" FontSize="11"/>
                <TextBox Text="{Binding ReplaceText, Mode=TwoWay}" Height="26"
                         VerticalContentAlignment="Center" Background="#0A0A0C" Foreground="#E8E8E6"
                         BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="6,0" FontSize="11"
                         Watermark="Ganti teks..."/>
                <Button Content="Ganti Semua" Classes="ToolBtn" Height="26" Padding="0,0"
                        FontWeight="SemiBold"
                        Command="{Binding QuickReplaceAllCommand}"/>
            </StackPanel>
        </Border>

        <!-- ═══ 3. STATUS BAR FOOTER BENTO (Pure Text) ═══ -->
        <Border Grid.Row="2" Background="#0C0C0E" BorderBrush="#232326" BorderThickness="1"
                CornerRadius="8" Padding="14,6" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsLoading}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#71717A" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalRows, StringFormat='Data: {0} baris'}"
                               FontFamily="'Cascadia Code', Consolas, monospace" FontSize="11" Foreground="#71717A"/>
                    <TextBlock Text="{Binding SelectedRowCount, StringFormat='Terpilih: {0}'}"
                               FontFamily="'Cascadia Code', Consolas, monospace" FontSize="11" Foreground="#52525B"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
