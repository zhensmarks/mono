<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BMachine.UI.ViewModels"
             xmlns:models="using:BMachine.UI.ViewModels"
             xmlns:services="using:BMachine.UI.Services"
             xmlns:converters="using:BMachine.UI.Converters"
             xmlns:views="using:BMachine.UI.Views"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BMachine.UI.Views.OutputExplorerView"
             x:DataType="vm:OutputExplorerViewModel"
             Focusable="True"
             Loaded="OnViewLoaded"
             x:Name="ExplorerRoot">



    <UserControl.Resources>
        <StreamGeometry x:Key="IconChevronRight">M9 18l6-6-6-6</StreamGeometry>
        <StreamGeometry x:Key="IconArrowUp">M12 19V5M5 12l7-7 7 7</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z</StreamGeometry>
        <StreamGeometry x:Key="IconFile">M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z M13 2v7h7</StreamGeometry>
        <StreamGeometry x:Key="IconArrowRight">M5 12h14M12 5l7 7-7 7</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">M9 9h6v6H9z M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M23 4v6h-6 M1 20v-6h6 M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M20 6L9 17l-5-5</StreamGeometry>
        <StreamGeometry x:Key="IconX">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2</StreamGeometry>
        
        <converters:EnumMatchConverter x:Key="EnumMatchConverter"/>

        <!-- BACKGROUND CONTEXT MENU (Shared) -->
    <ContextMenu x:Key="BackgroundMenu" 
                  
                 BorderThickness="1" 
                 BorderBrush="{DynamicResource SeparatorBrush}" 
                 CornerRadius="10" 
                 Padding="5">
        <MenuItem Header="Sort by">
            <MenuItem Header="Name" 
                      ToggleType="Radio"
                      IsChecked="{Binding SortBy, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Name, Mode=TwoWay}">
                <MenuItem.Icon>
                    <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12"
                              IsVisible="{Binding SortBy, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Name}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Date" 
                      ToggleType="Radio"
                      IsChecked="{Binding SortBy, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Date, Mode=TwoWay}">
                <MenuItem.Icon>
                    <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12"
                              IsVisible="{Binding SortBy, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Date}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Type" 
                      ToggleType="Radio"
                      IsChecked="{Binding SortBy, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Type, Mode=TwoWay}">
                <MenuItem.Icon>
                    <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12"
                              IsVisible="{Binding SortBy, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Type}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Descending" 
                      ToggleType="CheckBox"
                      IsChecked="{Binding IsSortDescending, Mode=TwoWay}">
                <MenuItem.Icon>
                    <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12"
                              IsVisible="{Binding IsSortDescending}"/>
                </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
        
        <MenuItem Header="Group by">
            <MenuItem Header="(None)" 
                      ToggleType="Radio"
                      IsChecked="{Binding GroupBy, Converter={StaticResource EnumMatchConverter}, ConverterParameter=None, Mode=TwoWay}">
                <MenuItem.Icon>
                    <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12"
                              IsVisible="{Binding GroupBy, Converter={StaticResource EnumMatchConverter}, ConverterParameter=None}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Date" 
                      ToggleType="Radio"
                      IsChecked="{Binding GroupBy, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Date, Mode=TwoWay}">
                <MenuItem.Icon>
                    <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12"
                              IsVisible="{Binding GroupBy, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Date}"/>
                </MenuItem.Icon>
            </MenuItem>
             <MenuItem Header="Type" 
                       ToggleType="Radio"
                       IsChecked="{Binding GroupBy, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Type, Mode=TwoWay}">
                <MenuItem.Icon>
                    <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12"
                              IsVisible="{Binding GroupBy, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Type}"/>
                </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
        
        <MenuItem Header="Paste" Command="{Binding PasteItemCommand}" InputGesture="Ctrl+V"/>
        
        <Separator/>
        
        <MenuItem Header="New">
            <MenuItem Header="Folder" Command="{Binding OpenNewFolderPopupCommand}"/>
            <MenuItem Header="Text File" Command="{Binding OpenNewFilePopupCommand}"/>
        </MenuItem>
        
        <Separator/>
        
        <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" InputGesture="F5"/>
        
        <MenuItem Header="This Folder Only" 
                  ToggleType="CheckBox"
                  IsChecked="{Binding IsLocalSettings, Mode=TwoWay}">
            <MenuItem.Icon>
                <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12"
                          IsVisible="{Binding IsLocalSettings}"/>
            </MenuItem.Icon>
        </MenuItem>
    </ContextMenu>
    </UserControl.Resources>


    <Grid RowDefinitions="*, Auto">
        <!-- TOP: EXPLORER MAIN AREA -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header (Breadcrumbs) -->
                <RowDefinition Height="*"/>    <!-- Main Content (Sidebar | Splitter | Files) -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER: Navigation & Address Bar (Full Width) -->
            <Border Grid.Row="0" Padding="6,3" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" IsVisible="{Binding IsShowPathBar}">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Left: Navigation Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <Button Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" Classes="Clear" ToolTip.Tip="Back (Alt+Left)" Padding="5,4">
                            <PathIcon Data="{StaticResource IconChevronRight}" Width="11" Height="11" RenderTransform="rotate(180deg)"/>
                        </Button>
                        <Button Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" Classes="Clear" ToolTip.Tip="Forward (Alt+Right)" Padding="5,4">
                            <PathIcon Data="{StaticResource IconChevronRight}" Width="11" Height="11"/>
                        </Button>
                        <Button Command="{Binding NavigateUpCommand}" IsEnabled="{Binding CanNavigateUp}" Classes="Clear" ToolTip.Tip="Up (Alt+Up)" Padding="5,4">
                            <PathIcon Data="{StaticResource IconArrowUp}" Width="11" Height="11"/>
                        </Button>
                        <Rectangle Width="1" Height="14" Fill="{DynamicResource SeparatorBrush}" Margin="3,0" Opacity="0.5"/>
                        <Button Command="{Binding RefreshCommand}" Classes="Clear" ToolTip.Tip="Refresh (F5)" Padding="5,4">
                            <PathIcon Data="{StaticResource IconRefresh}" Width="11" Height="11"/>
                        </Button>
                    </StackPanel>

                    <!-- Center: DUAL-MODE ADDRESS BAR -->
                    <Border Grid.Column="1" Margin="4,0" CornerRadius="5" ClipToBounds="True"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Panel>
                            <!-- MODE 1: Breadcrumb display (default) -->
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding !IsAddressBarEditing}"
                                          Cursor="IBeam" Padding="6,0">
                                <Grid>
                                    <!-- Transparent tap target over entire breadcrumb to activate editing -->
                                    <Border Background="Transparent" Cursor="IBeam">
                                        <i:Interaction.Behaviors>
                                            <ia:EventTriggerBehavior EventName="PointerPressed">
                                                <ia:InvokeCommandAction Command="{Binding ActivateAddressBarCommand}"/>
                                            </ia:EventTriggerBehavior>
                                        </i:Interaction.Behaviors>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Breadcrumbs}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="0"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="26">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Padding="4,0"/>
                                                    <PathIcon Data="{StaticResource IconChevronRight}" Width="8" Height="8"
                                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                                              VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>

                            <!-- MODE 2: Editable TextBox (active when IsAddressBarEditing=true) -->
                            <TextBox x:Name="AddressBarTextBox"
                                     Text="{Binding AddressBarText, Mode=TwoWay}"
                                     IsVisible="{Binding IsAddressBarEditing}"
                                     FontSize="12" Padding="6,0" MinHeight="0" Height="26"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Consolas, Monospace, monospace">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CommitAddressBarCommand}"/>
                                    <KeyBinding Gesture="Escape" Command="{Binding CancelAddressBarCommand}"/>
                                </TextBox.KeyBindings>
                                <i:Interaction.Behaviors>
                                    <ia:EventTriggerBehavior EventName="LostFocus">
                                        <ia:InvokeCommandAction Command="{Binding CancelAddressBarCommand}"/>
                                    </ia:EventTriggerBehavior>
                                </i:Interaction.Behaviors>
                            </TextBox>
                        </Panel>
                    </Border>

                    <!-- Right: Search toggle -->
                    <Button Grid.Column="2" Command="{Binding ToggleSearchCommand}" Classes="Clear"
                            ToolTip.Tip="Search (Ctrl+F)" Padding="5,4">
                        <PathIcon Data="M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm0 0M21 21l-4.35-4.35" Width="13" Height="13"/>
                    </Button>
                </Grid>
            </Border>



            <!-- 2. Main Content (Sidebar | Splitter | Files) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SidebarWidth, Mode=TwoWay}" MinWidth="32" MaxWidth="400"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR (LEFT) -->
                <Grid Grid.Column="0" RowDefinitions="*, Auto">
                    <!-- Sidebar Items List -->
                    <ListBox Grid.Row="0" ItemsSource="{Binding QuickAccessItems}" Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:SidebarItemViewModel">
                                     <Grid ColumnDefinitions="Auto, *" Background="Transparent" Height="28" ToolTip.Tip="{Binding Name}">
                                         <Grid.ContextMenu>
                                             <ContextMenu  BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="10" Padding="5">
                                                 <MenuItem Header="Remove Pin" Command="{Binding #ExplorerRoot.DataContext.RemoveFromQuickAccessCommand}" CommandParameter="{Binding}"/>
                                             </ContextMenu>
                                         </Grid.ContextMenu>
                                         <Interaction.Behaviors>
                                             <EventTriggerBehavior EventName="PointerPressed">
                                                 <InvokeCommandAction Command="{Binding #ExplorerRoot.DataContext.NavigateToQuickAccessCommand}" CommandParameter="{Binding}"/>
                                             </EventTriggerBehavior>
                                         </Interaction.Behaviors>
                                         
                                         <PathIcon Grid.Column="0" Data="{StaticResource IconFolder}" Width="13" Height="13" Margin="8,0,6,0" Foreground="#E8A447"/>
                                         <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                     </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <!-- Custom TypeAhead handles this now -->
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="4,1"/>
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                             </ListBox.Styles>
                         </ListBox>
                         
                    <!-- Settings Button -->
                    <Button Grid.Row="1" Classes="Clear" Margin="4,5" HorizontalAlignment="Center" ToolTip.Tip="Explorer Settings" Click="OpenSettings_Click">
                        <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    
                    <!-- Vertical Separator Decor -->
                    <Border Grid.RowSpan="2" HorizontalAlignment="Right" Width="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.5" Margin="0,10"/>
                </Grid>
                
                <!-- SPLITTER -->
                <GridSplitter Grid.Column="1" Background="{DynamicResource SeparatorBrush}" ResizeDirection="Columns" Opacity="0.5"/>
                
                <!-- MAIN CONTENT (RIGHT) - FILES LIST + PREVIEW PANEL -->
                <Grid Grid.Column="2" DragDrop.AllowDrop="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{Binding PreviewPanelWidth}" MinWidth="0"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- File list area (left) -->
                    <Border Grid.Column="0" Padding="8,0,0,0" Background="Transparent" ContextMenu="{StaticResource BackgroundMenu}">
                    <Grid x:Name="FileAreaGrid"
                          PointerPressed="OnFileAreaPointerPressed"
                          PointerMoved="OnFileAreaPointerMoved"
                          PointerReleased="OnFileAreaPointerReleased"
                          Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Empty state: fills whole area so right-click anywhere shows context menu -->
                    <Grid Grid.Row="0" ContextMenu="{StaticResource BackgroundMenu}"
                          Background="Transparent"
                          DragDrop.AllowDrop="True"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                             <!-- 1. Normal Empty -->
                             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" 
                                         IsVisible="{Binding IsEmpty}">
                                  <PathIcon Data="{StaticResource IconFolder}" Width="40" Height="40" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5"/>
                                  <TextBlock Text="Folder kosong." Foreground="{DynamicResource TextSecondaryBrush}" 
                                         IsVisible="{Binding !IsRootPathMissing}" HorizontalAlignment="Center"/>
                                  
                             </StackPanel>
                             
                             <!-- 2. Config Missing -->
                             <StackPanel Spacing="5" IsVisible="{Binding IsRootPathMissing}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <TextBlock Text="Local Output belum disetting." Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                  <TextBlock Text="Silahkan atur di menu Settings > Paths" Foreground="{DynamicResource AccentBrush}" FontSize="12" HorizontalAlignment="Center" Cursor="Hand"/>
                             </StackPanel>
                    </Grid>

                    <!-- VERTICAL LIST VIEW (Standard) -->
                    <ListBox x:Name="VerticalListBox"
                             ItemsSource="{Binding Items}"
                             SelectedItems="{Binding SelectedItems}"
                             SelectionMode="Multiple"
                             Background="{DynamicResource AppBackgroundBrush}"
                             IsVisible="{Binding IsVerticalLayoutAndNotEmpty}"
                             ClipToBounds="True"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ContextMenu="{StaticResource BackgroundMenu}"
                             Focusable="True">


                        <ListBox.Styles>
                             <Style Selector="ListBoxItem">
                                <!-- Custom TypeAhead handles this now -->
                                <Setter Property="Padding" Value="4,0,8,0"/>
                                <Setter Property="Margin" Value="0,0"/>
                                <Setter Property="MinHeight" Value="26"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <!-- Group headers (IsSelectable=false) are not focusable/clickable to avoid force close -->
                                <Setter Property="IsHitTestVisible" Value="{Binding IsSelectable, FallbackValue=True}"/>
                                <Setter Property="Focusable" Value="{Binding IsSelectable, FallbackValue=True}"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.DataTemplates>
                            <!-- HEADER TEMPLATE (Today, Yesterday, etc. - not selectable) -->
                            <DataTemplate x:DataType="vm:ExplorerGroupHeaderViewModel">
                                 <Border Padding="10,4,0,2" Margin="0,8,0,2" Background="Transparent" IsHitTestVisible="False">
                                     <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Opacity="0.7" LetterSpacing="1"/>
                                 </Border>
                            </DataTemplate>
                            
                            <!-- ITEM TEMPLATE — Details style with name + size + date -->
                            <DataTemplate x:DataType="vm:ExplorerItemViewModel">
                                 <Grid ColumnDefinitions="Auto, *, Auto, Auto" MinWidth="200" Background="Transparent" Height="26" DoubleTapped="OnItemDoubleTapped"
                                       PointerPressed="OnItemPointerPressed"
                                       PointerMoved="OnItemPointerMoved"
                                       PointerReleased="OnItemPointerReleased">
                                      <Grid.ContextMenu>
                                          <ContextMenu  BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="10" Padding="5">
                                              <!-- Open actions -->
                                              <MenuItem Header="Open" Command="{Binding #ExplorerRoot.DataContext.OpenItemCommand}" CommandParameter="{Binding}" FontWeight="Bold"/>
                                              <MenuItem Header="Open in New Tab" Command="{Binding #ExplorerRoot.DataContext.OpenItemInNewTabCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsDirectory}"/>
                                              <MenuItem Header="Open with..." Command="{Binding #ExplorerRoot.DataContext.OpenWithCommand}" CommandParameter="{Binding}" IsVisible="{Binding !IsDirectory}"/>

                                              <!-- Batch Scripts injected dynamically -->
                                              <Separator Tag="BatchMarker"/>
                                              
                                              <MenuItem Header="Pin to Sidebar" Command="{Binding #ExplorerRoot.DataContext.AddToQuickAccessCommand}" CommandParameter="{Binding}"/>
                                              <MenuItem Header="Rename" Command="{Binding #ExplorerRoot.DataContext.RenameItemCommand}" CommandParameter="{Binding}" InputGesture="F2"/>
                                              <MenuItem Header="Batch Rename" Command="{Binding #ExplorerRoot.DataContext.BatchRenameFromClipboardCommand}"/>
                                              <Separator/>
                                              <MenuItem Header="Copy" Command="{Binding #ExplorerRoot.DataContext.CopyItemCommand}" CommandParameter="{Binding}" InputGesture="Ctrl+C"/>
                                              <MenuItem Header="Cut" Command="{Binding #ExplorerRoot.DataContext.CutItemCommand}" CommandParameter="{Binding}" InputGesture="Ctrl+X"/>
                                              <MenuItem Header="Paste" Command="{Binding #ExplorerRoot.DataContext.PasteItemCommand}" InputGesture="Ctrl+V" IsVisible="{Binding #ExplorerRoot.DataContext.HasFileClipboard}"/>
                                              <Separator/>
                                              <MenuItem Header="Delete" Command="{Binding #ExplorerRoot.DataContext.DeleteItemCommand}" CommandParameter="{Binding}" Foreground="#FF453A"/>
                                          </ContextMenu>
                                      </Grid.ContextMenu>

                                      <!-- Icon: folder = warm amber, file = muted -->
                                      <Grid Grid.Column="0" Width="28" VerticalAlignment="Center">
                                          <PathIcon Data="{StaticResource IconFolder}" IsVisible="{Binding IsDirectory}" Width="15" Height="15"
                                                    HorizontalAlignment="Center"
                                                    Foreground="#E8A447"/>
                                          <PathIcon Data="{StaticResource IconFile}" IsVisible="{Binding !IsDirectory}" Width="13" Height="13"
                                                    HorizontalAlignment="Center"
                                                    Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"/>
                                      </Grid>

                                      <!-- Name / Edit Box -->
                                      <Panel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                          <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                     IsVisible="{Binding !IsEditing}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                                          <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="12"
                                                   IsVisible="{Binding IsEditing}"
                                                   Padding="0" MinHeight="0" Margin="0"
                                                   Loaded="OnRenameTextBoxLoaded"
                                                   PropertyChanged="OnAutoSelectTextBoxPropertyChanged"
                                                   KeyDown="OnRenameTextBoxKeyDown">
                                              <TextBox.KeyBindings>
                                                  <KeyBinding Gesture="Enter" Command="{Binding #ExplorerRoot.DataContext.CommitRenameCommand}" CommandParameter="{Binding}"/>
                                                  <KeyBinding Gesture="Escape" Command="{Binding #ExplorerRoot.DataContext.CancelRenameCommand}" CommandParameter="{Binding}"/>
                                              </TextBox.KeyBindings>
                                              <i:Interaction.Behaviors>
                                                  <ia:EventTriggerBehavior EventName="LostFocus">
                                                      <ia:InvokeCommandAction Command="{Binding #ExplorerRoot.DataContext.CommitRenameCommand}" CommandParameter="{Binding}"/>
                                                  </ia:EventTriggerBehavior>
                                              </i:Interaction.Behaviors>
                                          </TextBox>
                                      </Panel>

                                      <!-- File Size -->
                                      <TextBlock Grid.Column="2" Text="{Binding DisplaySize}"
                                                 FontSize="10" Opacity="0.55"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 IsVisible="{Binding !IsEditing}"
                                                 Margin="0,0,16,0" MinWidth="56" TextAlignment="Right"/>

                                      <!-- Date Modified -->
                                      <TextBlock Grid.Column="3" 
                                                 Text="{Binding DateModified, StringFormat='{}{0:dd MMM yyyy}'}"
                                                 FontSize="10" Opacity="0.45"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 IsVisible="{Binding !IsEditing}"
                                                 Margin="0,0,8,0" MinWidth="76" TextAlignment="Right"/>
                                 </Grid>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                    

                    <!-- HORIZONTAL LIST VIEW (Columnar/Right Scroll) -->
                    <ListBox x:Name="HorizontalListBox"
                             ItemsSource="{Binding Items}"
                             SelectedItems="{Binding SelectedItems}"
                             SelectionMode="Multiple"
                             Background="{DynamicResource AppBackgroundBrush}"
                             IsVisible="{Binding IsHorizontalLayoutAndNotEmpty}"
                             ClipToBounds="True"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             PointerWheelChanged="OnHorizontalListPointerWheelChanged"
                             ContextMenu="{StaticResource BackgroundMenu}"
                             Focusable="True">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                             <Style Selector="ListBoxItem">
                                <!-- Custom TypeAhead handles this now -->
                                <Setter Property="Padding" Value="4,0"/>
                                <Setter Property="Margin" Value="0,1,12,1"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Background" Value="Transparent"/>
                                
                                <Setter Property="IsHitTestVisible" Value="{Binding IsSelectable, FallbackValue=True}"/>
                                <Setter Property="Focusable" Value="{Binding IsSelectable, FallbackValue=True}"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.DataTemplates>
                            <!-- HEADER TEMPLATE -->
                            <DataTemplate x:DataType="vm:ExplorerGroupHeaderViewModel">
                                 <!-- Header: Invisible Column Break (Transparent Separator) -->
                                 <Border Width="2" 
                                         Height="{Binding $parent[ListBox].Bounds.Height}" 
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Stretch"
                                         Background="Transparent"
                                         BorderThickness="0,0,2,0"
                                         BorderBrush="Transparent"
                                         IsHitTestVisible="False"
                                         Focusable="False"/>
                            </DataTemplate>

                            <DataTemplate x:DataType="vm:ExplorerItemViewModel">
                                <!-- Item: Fixed Size Card (Compact) -->
                                 <Grid MinWidth="60" MaxWidth="150" MinHeight="20" ColumnDefinitions="Auto, *" Background="Transparent" DoubleTapped="OnItemDoubleTapped" ToolTip.Tip="{Binding Name}"
                                       PointerPressed="OnItemPointerPressed"
                                       PointerMoved="OnItemPointerMoved"
                                       PointerReleased="OnItemPointerReleased">
                                       <Grid.ContextMenu>
                                          <ContextMenu  BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="10" Padding="5">

                                              <!-- Batch Scripts injected dynamically -->
                                              <Separator Tag="BatchMarker"/>
                                              
                                              
                                              <MenuItem Header="Pin to Sidebar" Command="{Binding #ExplorerRoot.DataContext.AddToQuickAccessCommand}" CommandParameter="{Binding}"/>
                                              <MenuItem Header="Rename" Command="{Binding #ExplorerRoot.DataContext.RenameItemCommand}" CommandParameter="{Binding}" InputGesture="F2"/>
                                              <MenuItem Header="Batch Rename" Command="{Binding #ExplorerRoot.DataContext.BatchRenameFromClipboardCommand}"/>
                                              <MenuItem Header="Copy" Command="{Binding #ExplorerRoot.DataContext.CopyItemCommand}" CommandParameter="{Binding}" InputGesture="Ctrl+C"/>
                                              <MenuItem Header="Cut" Command="{Binding #ExplorerRoot.DataContext.CutItemCommand}" CommandParameter="{Binding}" InputGesture="Ctrl+X"/>
                                              <MenuItem Header="Paste" Command="{Binding #ExplorerRoot.DataContext.PasteItemCommand}" InputGesture="Ctrl+V" IsVisible="{Binding #ExplorerRoot.DataContext.HasFileClipboard}"/>
                                              <Separator/>
                                              <!-- REMOVED New Folder/File per request -->
                                              <MenuItem Header="Refresh" Command="{Binding #ExplorerRoot.DataContext.RefreshCommand}"/>
                                              <Separator/>
                                              <MenuItem Header="Delete" Command="{Binding #ExplorerRoot.DataContext.DeleteItemCommand}" CommandParameter="{Binding}" Foreground="#FF453A"/>
                                          </ContextMenu>
                                       </Grid.ContextMenu>
                                       <PathIcon Grid.Column="0" Data="{StaticResource IconFolder}" IsVisible="{Binding IsDirectory}" Width="15" Height="15" Margin="6,0" Foreground="#E8A447"/>
                                       <PathIcon Grid.Column="0" Data="{StaticResource IconFile}" IsVisible="{Binding !IsDirectory}" Width="13" Height="13" Margin="7,0" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"/>
                                       <Panel Grid.Column="1" VerticalAlignment="Center">
                                           <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsEditing}"/>
                                           <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="11" Padding="0" MinHeight="0" Margin="0" IsVisible="{Binding IsEditing}"
                                                    Loaded="OnRenameTextBoxLoaded" PropertyChanged="OnAutoSelectTextBoxPropertyChanged" KeyDown="OnRenameTextBoxKeyDown">
                                               <TextBox.KeyBindings>
                                                   <KeyBinding Gesture="Enter" Command="{Binding #ExplorerRoot.DataContext.CommitRenameCommand}" CommandParameter="{Binding}"/>
                                                   <KeyBinding Gesture="Escape" Command="{Binding #ExplorerRoot.DataContext.CancelRenameCommand}" CommandParameter="{Binding}"/>
                                               </TextBox.KeyBindings>
                                               <i:Interaction.Behaviors>
                                                   <ia:EventTriggerBehavior EventName="LostFocus">
                                                       <ia:InvokeCommandAction Command="{Binding #ExplorerRoot.DataContext.CommitRenameCommand}" CommandParameter="{Binding}"/>
                                                   </ia:EventTriggerBehavior>
                                               </i:Interaction.Behaviors>
                                           </TextBox>
                                       </Panel>
                                 </Grid>
                                    </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>

                    <!-- THUMBNAIL VIEW (Medium Cards with Image Previews) -->
                    <ListBox x:Name="ThumbnailListBox"
                             ItemsSource="{Binding Items}"
                             SelectedItems="{Binding SelectedItems}"
                             SelectionMode="Multiple"
                             Background="{DynamicResource AppBackgroundBrush}"
                             IsVisible="{Binding IsThumbnailLayoutAndNotEmpty}"
                             ClipToBounds="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ContextMenu="{StaticResource BackgroundMenu}"
                             Focusable="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <!-- Custom TypeAhead handles this now -->
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="IsHitTestVisible" Value="{Binding IsSelectable, FallbackValue=True}"/>
                                <Setter Property="Focusable" Value="{Binding IsSelectable, FallbackValue=True}"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.DataTemplates>
                            <!-- HEADER TEMPLATE (hidden in thumbnail view) -->
                            <DataTemplate x:DataType="vm:ExplorerGroupHeaderViewModel">
                                 <Border Height="0" Width="0" IsHitTestVisible="False" Focusable="False"/>
                            </DataTemplate>

                            <DataTemplate x:DataType="vm:ExplorerItemViewModel">
                                <Border Width="{Binding #ExplorerRoot.DataContext.ThumbnailSize}" 
                                        Height="{Binding #ExplorerRoot.DataContext.ThumbnailHeight}" 
                                        CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        DoubleTapped="OnItemDoubleTapped" ToolTip.Tip="{Binding Name}"
                                        PointerPressed="OnItemPointerPressed"
                                        PointerMoved="OnItemPointerMoved"
                                        PointerReleased="OnItemPointerReleased">
                                    <Grid RowDefinitions="*, Auto">
                                        <!-- Thumbnail Image (for image files) -->
                                        <Image Grid.Row="0" Source="{Binding ThumbnailImage}" 
                                               Stretch="UniformToFill" IsVisible="{Binding IsImageFile}"
                                               Margin="0"/>
                                        <!-- Fallback icon for folders (amber) -->
                                        <PathIcon Grid.Row="0" Data="{StaticResource IconFolder}" 
                                                  IsVisible="{Binding IsDirectory}" 
                                                  Width="44" Height="44" Foreground="#E8A447"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <!-- Fallback icon for non-image files -->
                                        <Panel Grid.Row="0" IsVisible="{Binding !IsDirectory}">
                                            <PathIcon Data="{StaticResource IconFile}" 
                                                      Width="38" Height="38" Foreground="{DynamicResource TextSecondaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Opacity="0.6"
                                                      IsVisible="{Binding !IsImageFile}"/>
                                        </Panel>
                                        <!-- File name -->
                                        <Border Grid.Row="1" Padding="6,4" Background="{DynamicResource AppBackgroundBrush}" Opacity="0.92">
                                            <Panel>
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           MaxLines="1"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           IsVisible="{Binding !IsEditing}"/>
                                                <TextBox Text="{Binding Name, Mode=TwoWay}" 
                                                         FontSize="12" IsVisible="{Binding IsEditing}" 
                                                         Padding="0" MinHeight="0" Margin="0"
                                                         Loaded="OnRenameTextBoxLoaded"
                                                         PropertyChanged="OnAutoSelectTextBoxPropertyChanged"
                                                         KeyDown="OnRenameTextBoxKeyDown">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding #ExplorerRoot.DataContext.CommitRenameCommand}" CommandParameter="{Binding}"/>
                                                        <KeyBinding Gesture="Escape" Command="{Binding #ExplorerRoot.DataContext.CancelRenameCommand}" CommandParameter="{Binding}"/>
                                                    </TextBox.KeyBindings>
                                                    <i:Interaction.Behaviors>
                                                        <ia:EventTriggerBehavior EventName="LostFocus">
                                                            <ia:InvokeCommandAction Command="{Binding #ExplorerRoot.DataContext.CommitRenameCommand}" CommandParameter="{Binding}"/>
                                                        </ia:EventTriggerBehavior>
                                                    </i:Interaction.Behaviors>
                                                </TextBox>
                                            </Panel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>


                    <!-- TILES / SMALL ICONS VIEW (Horizontal Flow, Icon + Text side-by-side) -->
                    <ListBox x:Name="TilesListBox"
                             ItemsSource="{Binding Items}"
                             SelectedItems="{Binding SelectedItems}"
                             SelectionMode="Multiple"
                             Background="{DynamicResource AppBackgroundBrush}"
                             IsVisible="{Binding IsTilesLayoutAndNotEmpty}"
                             ClipToBounds="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ContextMenu="{StaticResource BackgroundMenu}"
                             Focusable="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <!-- Custom TypeAhead handles this now -->
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="IsHitTestVisible" Value="{Binding IsSelectable, FallbackValue=True}"/>
                                <Setter Property="Focusable" Value="{Binding IsSelectable, FallbackValue=True}"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.DataTemplates>
                             <!-- HEADER TEMPLATE -->
                            <DataTemplate x:DataType="vm:ExplorerGroupHeaderViewModel">
                                 <Border Height="0" Width="0" IsHitTestVisible="False" Focusable="False"/>
                            </DataTemplate>

                            <DataTemplate x:DataType="vm:ExplorerItemViewModel">
                                <Border CornerRadius="0" ClipToBounds="True"
                                        Background="Transparent" 
                                        DoubleTapped="OnItemDoubleTapped" ToolTip.Tip="{Binding Name}"
                                        PointerPressed="OnItemPointerPressed"
                                        PointerMoved="OnItemPointerMoved"
                                        PointerReleased="OnItemPointerReleased">
                                    <Grid ColumnDefinitions="Auto, *" Width="240" Height="56">
                                        <!-- Icon: Size bound to ThumbnailSize -->
                                        <Grid Grid.Column="0" Width="{Binding #ExplorerRoot.DataContext.ThumbnailSize}" Height="{Binding #ExplorerRoot.DataContext.ThumbnailSize}" Margin="4">
                                            <!-- Thumbnail or Folder Icon -->
                                             <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" IsVisible="{Binding IsImageFile}"/>
                                             <PathIcon Data="{StaticResource IconFolder}" IsVisible="{Binding IsDirectory}" 
                                                       Foreground="#E8A447" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                             <PathIcon Data="{StaticResource IconFile}" IsVisible="{Binding !IsImageFile}" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                  <PathIcon.IsVisible>
                                                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                          <Binding Path="!IsDirectory"/>
                                                          <Binding Path="!IsImageFile"/>
                                                      </MultiBinding>
                                                  </PathIcon.IsVisible>
                                             </PathIcon>
                                        </Grid>
                                        
                                        <!-- Name -->
                                        <Panel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsEditing}"/>
                                            <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="11" Padding="0" MinHeight="0" Margin="0" IsVisible="{Binding IsEditing}"
                                                     Loaded="OnRenameTextBoxLoaded" PropertyChanged="OnAutoSelectTextBoxPropertyChanged" KeyDown="OnRenameTextBoxKeyDown">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding #ExplorerRoot.DataContext.CommitRenameCommand}" CommandParameter="{Binding}"/>
                                                    <KeyBinding Gesture="Escape" Command="{Binding #ExplorerRoot.DataContext.CancelRenameCommand}" CommandParameter="{Binding}"/>
                                                </TextBox.KeyBindings>
                                                <i:Interaction.Behaviors>
                                                    <ia:EventTriggerBehavior EventName="LostFocus">
                                                        <ia:InvokeCommandAction Command="{Binding #ExplorerRoot.DataContext.CommitRenameCommand}" CommandParameter="{Binding}"/>
                                                    </ia:EventTriggerBehavior>
                                                </i:Interaction.Behaviors>
                                            </TextBox>
                                        </Panel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>

                    <!-- SPLIT VIEW (Two Columns: Left / Right) -->
                    <!-- Wrapped in ScrollViewer for single scrolling behavior -->
                    <ScrollViewer x:Name="SplitScrollViewer"
                                  IsVisible="{Binding IsSplitLayoutAndNotEmpty}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent">
                        <Grid x:Name="SplitViewGrid" ColumnDefinitions="*, *" Background="Transparent">
                            <!-- LEFT PANE -->
                            <ListBox x:Name="SplitLeftListBox" Grid.Column="0"
                                     ItemsSource="{Binding SplitLeftItems}"
                                     SelectedItems="{Binding SelectedItems}"
                                     SelectionMode="Multiple"
                                     Background="{DynamicResource AppBackgroundBrush}"
                                     ClipToBounds="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                     ContextMenu="{StaticResource BackgroundMenu}"
                                     Focusable="True">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <!-- Custom TypeAhead handles this now -->
                                        <Setter Property="Padding" Value="4,0"/>
                                        <Setter Property="Margin" Value="0,3"/>
                                        <Setter Property="MinHeight" Value="20"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="IsHitTestVisible" Value="{Binding IsSelectable, FallbackValue=True}"/>
                                        <Setter Property="Focusable" Value="{Binding IsSelectable, FallbackValue=True}"/>
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.DataTemplates>
                                    <DataTemplate x:DataType="vm:ExplorerItemViewModel">
                                         <Grid ColumnDefinitions="Auto, *" Background="Transparent" Height="20" DoubleTapped="OnItemDoubleTapped"
                                               PointerPressed="OnItemPointerPressed"
                                               PointerMoved="OnItemPointerMoved"
                                               PointerReleased="OnItemPointerReleased">
                                              <Grid.ContextMenu>
                                                  <ContextMenu  BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="10" Padding="5">
                                                      <MenuItem Header="Open" Command="{Binding #ExplorerRoot.DataContext.OpenItemCommand}" CommandParameter="{Binding}" FontWeight="Bold"/>
                                                      <MenuItem Header="Open with..." Command="{Binding #ExplorerRoot.DataContext.OpenWithCommand}" CommandParameter="{Binding}" IsVisible="{Binding !IsDirectory}"/>
                                                      <Separator/>

                                                      <!-- Batch Scripts injected dynamically -->
                                                      <Separator Tag="BatchMarker"/>
                                                      <MenuItem Header="Pin to Sidebar" Command="{Binding #ExplorerRoot.DataContext.AddToQuickAccessCommand}" CommandParameter="{Binding}"/>
                                                      <MenuItem Header="Rename" Command="{Binding #ExplorerRoot.DataContext.RenameItemCommand}" CommandParameter="{Binding}" InputGesture="F2"/>
                                                      <MenuItem Header="Batch Rename" Command="{Binding #ExplorerRoot.DataContext.BatchRenameFromClipboardCommand}"/>
                                                      <Separator/>
                                                      <MenuItem Header="Copy" Command="{Binding #ExplorerRoot.DataContext.CopyItemCommand}" CommandParameter="{Binding}" InputGesture="Ctrl+C"/>
                                                      <MenuItem Header="Cut" Command="{Binding #ExplorerRoot.DataContext.CutItemCommand}" CommandParameter="{Binding}" InputGesture="Ctrl+X"/>
                                                      <MenuItem Header="Paste" Command="{Binding #ExplorerRoot.DataContext.PasteItemCommand}" InputGesture="Ctrl+V" IsVisible="{Binding #ExplorerRoot.DataContext.HasFileClipboard}"/>
                                                      <Separator/>
                                                      <MenuItem Header="Delete" Command="{Binding #ExplorerRoot.DataContext.DeleteItemCommand}" CommandParameter="{Binding}" Foreground="#FF453A"/>
                                                  </ContextMenu>
                                              </Grid.ContextMenu>
                                              <PathIcon Grid.Column="0" Data="{StaticResource IconFolder}" IsVisible="{Binding IsDirectory}" Width="14" Height="14" Margin="6,0" Foreground="#E8A447"/>
                                              <PathIcon Grid.Column="0" Data="{StaticResource IconFile}" IsVisible="{Binding !IsDirectory}" Width="12" Height="12" Margin="7,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                              <Panel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                                                  <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" 
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsEditing}"/>
                                                  <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="11" IsVisible="{Binding IsEditing}" Padding="0" MinHeight="0" Margin="0,-2,0,-2" Loaded="OnRenameTextBoxLoaded" PropertyChanged="OnAutoSelectTextBoxPropertyChanged" KeyDown="OnRenameTextBoxKeyDown">
                                                      <TextBox.KeyBindings>
                                                          <KeyBinding Gesture="Enter" Command="{Binding #ExplorerRoot.DataContext.CommitRenameCommand}" CommandParameter="{Binding}"/>
                                                          <KeyBinding Gesture="Escape" Command="{Binding #ExplorerRoot.DataContext.CancelRenameCommand}" CommandParameter="{Binding}"/>
                                                      </TextBox.KeyBindings>
                                                      <i:Interaction.Behaviors>
                                                          <ia:EventTriggerBehavior EventName="LostFocus">
                                                              <ia:InvokeCommandAction Command="{Binding #ExplorerRoot.DataContext.CommitRenameCommand}" CommandParameter="{Binding}"/>
                                                          </ia:EventTriggerBehavior>
                                                      </i:Interaction.Behaviors>
                                                  </TextBox>
                                              </Panel>
                                         </Grid>
                                    </DataTemplate>
                                </ListBox.DataTemplates>
                            </ListBox>

                            <!-- RIGHT PANE -->
                            <ListBox x:Name="SplitRightListBox" Grid.Column="1"
                                     Margin="8,0,0,0"
                                     ItemsSource="{Binding SplitRightItems}"
                                     SelectedItems="{Binding SelectedItems}"
                                     SelectionMode="Multiple"
                                     Background="{DynamicResource AppBackgroundBrush}"
                                     ClipToBounds="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                     ContextMenu="{StaticResource BackgroundMenu}"
                                     Focusable="True">
                                 <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <!-- Custom TypeAhead handles this now -->
                                        <Setter Property="Padding" Value="4,0"/>
                                        <Setter Property="Margin" Value="0,3"/>
                                        <Setter Property="MinHeight" Value="20"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="IsHitTestVisible" Value="{Binding IsSelectable, FallbackValue=True}"/>
                                        <Setter Property="Focusable" Value="{Binding IsSelectable, FallbackValue=True}"/>
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.DataTemplates>
                                    <DataTemplate x:DataType="vm:ExplorerItemViewModel">
                                         <Grid ColumnDefinitions="Auto, *" Background="Transparent" Height="20" DoubleTapped="OnItemDoubleTapped"
                                               PointerPressed="OnItemPointerPressed"
                                               PointerMoved="OnItemPointerMoved"
                                               PointerReleased="OnItemPointerReleased">
                                              <Grid.ContextMenu>
                                                  <ContextMenu  BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="10" Padding="5">
                                                      <MenuItem Header="Open" Command="{Binding #ExplorerRoot.DataContext.OpenItemCommand}" CommandParameter="{Binding}" FontWeight="Bold"/>
                                                      <MenuItem Header="Open with..." Command="{Binding #ExplorerRoot.DataContext.OpenWithCommand}" CommandParameter="{Binding}" IsVisible="{Binding !IsDirectory}"/>
                                                      <Separator/>

                                                      <!-- Batch Scripts injected dynamically -->
                                                      <Separator Tag="BatchMarker"/>
                                                      <MenuItem Header="Pin to Sidebar" Command="{Binding #ExplorerRoot.DataContext.AddToQuickAccessCommand}" CommandParameter="{Binding}"/>
                                                      <MenuItem Header="Rename" Command="{Binding #ExplorerRoot.DataContext.RenameItemCommand}" CommandParameter="{Binding}" InputGesture="F2"/>
                                                      <MenuItem Header="Batch Rename" Command="{Binding #ExplorerRoot.DataContext.BatchRenameFromClipboardCommand}"/>
                                                      <Separator/>
                                                      <MenuItem Header="Copy" Command="{Binding #ExplorerRoot.DataContext.CopyItemCommand}" CommandParameter="{Binding}" InputGesture="Ctrl+C"/>
                                                      <MenuItem Header="Cut" Command="{Binding #ExplorerRoot.DataContext.CutItemCommand}" CommandParameter="{Binding}" InputGesture="Ctrl+X"/>
                                                      <MenuItem Header="Paste" Command="{Binding #ExplorerRoot.DataContext.PasteItemCommand}" InputGesture="Ctrl+V" IsVisible="{Binding #ExplorerRoot.DataContext.HasFileClipboard}"/>
                                                      <Separator/>
                                                      <MenuItem Header="Delete" Command="{Binding #ExplorerRoot.DataContext.DeleteItemCommand}" CommandParameter="{Binding}" Foreground="#FF453A"/>
                                                  </ContextMenu>
                                              </Grid.ContextMenu>
                                              <PathIcon Grid.Column="0" Data="{StaticResource IconFolder}" IsVisible="{Binding IsDirectory}" Width="14" Height="14" Margin="6,0" Foreground="#E8A447"/>
                                              <PathIcon Grid.Column="0" Data="{StaticResource IconFile}" IsVisible="{Binding !IsDirectory}" Width="12" Height="12" Margin="7,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                              <Panel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                                                  <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" 
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsEditing}"/>
                                                  <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="11" IsVisible="{Binding IsEditing}" Padding="0" MinHeight="0" Margin="0,-2,0,-2" Loaded="OnRenameTextBoxLoaded" PropertyChanged="OnAutoSelectTextBoxPropertyChanged" KeyDown="OnRenameTextBoxKeyDown">
                                                      <TextBox.KeyBindings>
                                                          <KeyBinding Gesture="Enter" Command="{Binding #ExplorerRoot.DataContext.CommitRenameCommand}" CommandParameter="{Binding}"/>
                                                          <KeyBinding Gesture="Escape" Command="{Binding #ExplorerRoot.DataContext.CancelRenameCommand}" CommandParameter="{Binding}"/>
                                                      </TextBox.KeyBindings>
                                                      <i:Interaction.Behaviors>
                                                          <ia:EventTriggerBehavior EventName="LostFocus">
                                                              <ia:InvokeCommandAction Command="{Binding #ExplorerRoot.DataContext.CommitRenameCommand}" CommandParameter="{Binding}"/>
                                                          </ia:EventTriggerBehavior>
                                                      </i:Interaction.Behaviors>
                                                  </TextBox>
                                              </Panel>
                                         </Grid>
                                    </DataTemplate>
                                </ListBox.DataTemplates>
                            </ListBox>
                        </Grid>
                    </ScrollViewer>

                    <!-- Rubber Band Selection Overlay -->
                    <Canvas x:Name="RubberBandCanvas" IsHitTestVisible="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Rectangle x:Name="SelectionRect" Fill="#332196F3" Stroke="#2196F3" StrokeThickness="1" IsVisible="False"/>
                    </Canvas>
                    
                    </Grid>
                    </Border>

                    <!-- Preview panel (right): .txt content, .docx placeholder -->
                    <Border Grid.Column="1"  BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1,0,0,0" MinWidth="0" ClipToBounds="True">
                        <Grid RowDefinitions="Auto, *" Margin="8">
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                                <TextBlock Grid.Column="0" Text="{Binding PreviewPanelTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="Clear" Command="{Binding ClosePreviewPanelCommand}" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" ToolTip.Tip="Close Preview">
                                    <PathIcon Data="{StaticResource IconX}" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Button.Styles>
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding PreviewPanelContent, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0" FontFamily="Consolas, monospace" FontSize="12">
                                    <TextBox.Styles>
                                        <Style Selector="TextBox:pointerover /template/ Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style Selector="TextBox:focus /template/ Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </TextBox.Styles>
                                </TextBox>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 3. STATUS BAR (Bottom) -->
        <!-- FLOATING SEARCH BAR (Bottom Right) -->
        <Border Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Margin="0,0,24,24" 
                IsVisible="{Binding IsSearchVisible}"
                BoxShadow="0 4 12 0 #40000000"
                CornerRadius="0"
                BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1"
                
                Padding="6,4" Width="240">
             <Grid ColumnDefinitions="*, Auto">
                 <TextBox x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}" Watermark="Search..." 
                          FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0" Height="20"
                          VerticalAlignment="Center">
                     <TextBox.KeyBindings>
                         <KeyBinding Gesture="Escape" Command="{Binding CloseSearchCommand}"/>
                     </TextBox.KeyBindings>
                 </TextBox>
                 <Button Grid.Column="1" Command="{Binding CloseSearchCommand}" 
                         Background="Transparent" BorderThickness="0" Padding="4" Margin="4,0,0,0" Cursor="Hand">
                     <PathIcon Data="{StaticResource IconX}" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                 </Button>
             </Grid>
        </Border>

        <!-- PREMIUM SPOTLIGHT-STYLE OVERLAYS -->
        
        <!-- NEW FOLDER SPOTLIGHT -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#40000000" IsVisible="{Binding IsNewFolderVisible}" ZIndex="200">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="1" CornerRadius="12"
                    MaxWidth="500"
                    BoxShadow="0 25 50 -12 #80000000"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="15">
                    <PathIcon Grid.Column="0" Data="{StaticResource IconFolder}" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}" Margin="5,0,15,0"/>
                    <TextBox Grid.Column="1" Text="{Binding NewItemName}" 
                             IsVisible="{Binding IsNewFolderVisible}"
                             Watermark="Name for new folder..." 
                             FontSize="18" 
                             BorderThickness="0" 
                             Background="Transparent"
                             Loaded="OnRenameTextBoxLoaded"
                             PropertyChanged="OnAutoSelectTextBoxPropertyChanged"
                             VerticalAlignment="Center">
                        <TextBox.Styles>
                            <Style Selector="TextBox /template/ Border">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="TextBox:focus /template/ Border">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </TextBox.Styles>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ConfirmNewFolderCommand}"/>
                            <KeyBinding Gesture="Escape" Command="{Binding ClosePopupsCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Grid.Column="2" Text="↵ to create  ·  esc to cancel" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,5,0" Opacity="0.5" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <!-- NEW FILE SPOTLIGHT -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#40000000" IsVisible="{Binding IsNewFileVisible}" ZIndex="200">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="1" CornerRadius="12"
                    MaxWidth="500"
                    BoxShadow="0 25 50 -12 #80000000"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="15">
                    <PathIcon Grid.Column="0" Data="{StaticResource IconFile}" Width="24" Height="24" Foreground="{DynamicResource TextPrimaryBrush}" Margin="5,0,15,0"/>
                    <TextBox Grid.Column="1" Text="{Binding NewItemName}" 
                             IsVisible="{Binding IsNewFileVisible}"
                             Watermark="Name for new file (e.g. index.ts)" 
                             FontSize="18" 
                             BorderThickness="0" 
                             Background="Transparent"
                             Loaded="OnRenameTextBoxLoaded"
                             PropertyChanged="OnAutoSelectTextBoxPropertyChanged"
                             VerticalAlignment="Center">
                        <TextBox.Styles>
                            <Style Selector="TextBox /template/ Border">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="TextBox:focus /template/ Border">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </TextBox.Styles>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ConfirmNewFileCommand}"/>
                            <KeyBinding Gesture="Escape" Command="{Binding ClosePopupsCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Grid.Column="2" Text="↵ to create  ·  esc to cancel" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,5,0" Opacity="0.5" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>
        
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000" IsVisible="{Binding IsDuplicateVisible}">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" MinWidth="320" BoxShadow="0 8 32 0 #80000000">
                <StackPanel Spacing="15">
                    <TextBlock Text="Duplicate Items" FontWeight="Bold" FontSize="16"/>
                     <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Quantity:" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding DuplicateCount}" Minimum="1" Maximum="100" Width="100"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding ClosePopupsCommand}" Classes="Secondary"/>
                        <Button Content="Duplicate" Command="{Binding ConfirmDuplicateCommand}" Classes="Accent"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <!-- (Settings Overlay removed, now a separate Window) -->

        <!-- TYPE AHEAD OVERLAY (Premium Glassmorphism Pill) -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#D91E1E1E"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="20"
                Padding="16,6"
                Margin="0,0,0,32"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                IsVisible="{Binding IsTypeAheadVisible}"
                IsHitTestVisible="False"
                BoxShadow="0 8 32 0 #40000000">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Opacity="0.7"/>
                <TextBlock Text="{Binding TypeAheadText}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" LetterSpacing="0.5"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
