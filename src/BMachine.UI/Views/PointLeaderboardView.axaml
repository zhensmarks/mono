<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:BMachine.UI.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BMachine.UI.Views.PointLeaderboardView">
    <Grid>
        <Grid RowDefinitions="Auto, Auto, *">
            <!-- Header / Controls -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="20,0,20,5">
                <TextBlock Text="Leaderboard" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding LoadDataCommand}" ToolTip.Tip="Refresh" Classes="plainLink">
                        <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tab Bar (Compact) -->
            <Border Grid.Row="1" HorizontalAlignment="Center" 
                    Background="{DynamicResource MenuHoverBrush}" 
                    CornerRadius="6" 
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" 
                    Padding="4" Margin="20,0,20,8">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <StackPanel.Styles>
                        <Style Selector="RadioButton.TabButton">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Padding" Value="24,10"/>
                            <Setter Property="CornerRadius" Value="4"/>
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                                </Transitions>
                            </Setter>
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="11" 
                                                   Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="RadioButton.TabButton:pointerover">
                            <Setter Property="Background" Value="#10FFFFFF"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Style>
                        <Style Selector="RadioButton.TabButton:checked">
                             <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                             <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                             <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                        </Style>
                    </StackPanel.Styles>
                    
                    <RadioButton Classes="TabButton" Content="HARIAN" IsChecked="{Binding IsHarianSelected}" Command="{Binding SwitchToHarianCommand}"/>
                    <RadioButton Classes="TabButton" Content="BULANAN" IsChecked="{Binding IsBulananSelected}" Command="{Binding SwitchToBulananCommand}"/>
                </StackPanel>
            </Border>

            <!-- List Content -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0" ClipToBounds="True" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}"/>
                    
                    <ListBox ItemsSource="{Binding ActiveItems}" Background="Transparent" IsVisible="{Binding !IsLoading}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="30, *, Auto" Margin="5">
                                    <TextBlock Text="{Binding Rank}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Border Grid.Column="2" Background="{DynamicResource AccentPointsBrush}" CornerRadius="0" Padding="8,2">
                                        <TextBlock Text="{Binding FormattedPoints, StringFormat='{}{0} Pts'}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
