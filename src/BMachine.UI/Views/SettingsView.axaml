<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BMachine.UI.ViewModels"
             xmlns:views="using:BMachine.UI.Views"
             xmlns:converters="using:BMachine.UI.Converters"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="BMachine.UI.Views.SettingsView">
    
    <UserControl.Resources>
        <converters:BoolToTextConverter x:Key="BoolToInstallText" TrueText="Uninstall" FalseText="Install" />
        <converters:BoolToTextConverter x:Key="BoolToInstallStyle" TrueText="Clear" FalseText="Primary" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Segmented toggle button (theme switcher, nav style, etc.) -->
        <Style Selector="RadioButton.Segmented">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                         <ContentPresenter Content="{TemplateBinding Content}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="RadioButton.Segmented:checked">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="RadioButton.Segmented:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
        </Style>

        <!-- SL = Section Label: uppercase tracking mono label above a group of rows -->
        <Style Selector="TextBlock.SL">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="LetterSpacing" Value="2.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- SR = Setting Row separator -->
        <Style Selector="Border.SR">
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0,12,0,12"/>
        </Style>

        <!-- RL = Row label — primary weight, full color -->
        <Style Selector="TextBlock.RL">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- RD = Row description — muted secondary text -->
        <Style Selector="TextBlock.RD">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>
    
    <Grid x:Name="Part_RootGrid" RowDefinitions="Auto, *" ColumnDefinitions="195, *" Margin="20" SizeChanged="OnRootGridSizeChanged">
        
        <!-- HEADER -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Back button (mobile) -->
            <Button Grid.Column="0" Command="{Binding NavigateBackCommand}"
                    IsVisible="{Binding IsMobileContentOpen}"
                    Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" Margin="0,0,6,0">
                <PathIcon Data="{StaticResource IconArrowLeft}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>
            <!-- Accent dot -->
            <Border Grid.Column="1" Width="4" Height="4" CornerRadius="2"
                    Background="{DynamicResource AccentBlueBrush}"
                    VerticalAlignment="Center" Margin="0,0,8,0"
                    IsVisible="{Binding !IsMobileContentOpen}"/>
            <!-- Title -->
            <TextBlock Grid.Column="2" Text="CONTROL CENTER"
                       FontSize="10" FontWeight="Bold"
                       LetterSpacing="2.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <!-- Version pill -->
            <Border Grid.Column="3" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0" Padding="7,3"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
                <TextBlock Text="{Binding CurrentVersion, StringFormat='v{0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium"/>
            </Border>
        </Grid>

        <!-- SIDEBAR -->
        <Border x:Name="Part_Sidebar" Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" IsVisible="{Binding IsSidebarVisible}"
                BorderBrush="#0AFFFFFF" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ListBox Background="Transparent" SelectedIndex="{Binding SelectedMenuIndex}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="CornerRadius" Value="0"/>
                            <Setter Property="Margin" Value="0,0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="BorderThickness" Value="2,0,0,0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                                    <BrushTransition Property="Foreground" Duration="0:0:0.1"/>
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1"/>
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#07FFFFFF"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#0AFFFFFF"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                            <Setter Property="BorderThickness" Value="2,0,0,0"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected PathIcon">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                        </Style>
                    </ListBox.Styles>

                    <!-- 8 nav items — index must stay 0–7 to match ViewModel.SelectedMenuIndex -->
                    <!-- 0: General -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <PathIcon Data="{StaticResource IconSettings}" Width="13" Height="13" Foreground="{Binding $parent[ListBoxItem].Foreground}"/>
                            <TextBlock Text="{Binding Language[Nav.General]}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <!-- 1: Appearance -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <PathIcon Data="{StaticResource IconImage}" Width="13" Height="13" Foreground="{Binding $parent[ListBoxItem].Foreground}"/>
                            <TextBlock Text="{Binding Language[Nav.Appearance]}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <!-- 2: Account -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <PathIcon Data="{StaticResource IconUser}" Width="13" Height="13" Foreground="{Binding $parent[ListBoxItem].Foreground}"/>
                            <TextBlock Text="{Binding Language[Nav.Account]}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <!-- 3: Extensions -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <PathIcon Data="{StaticResource IconExtension}" Width="13" Height="13" Foreground="{Binding $parent[ListBoxItem].Foreground}"/>
                            <TextBlock Text="{Binding Language[Nav.Extensions]}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <!-- 4: Script Manager -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                             <PathIcon Data="{StaticResource IconScript}" Width="13" Height="13" Foreground="{Binding $parent[ListBoxItem].Foreground}"/>
                             <TextBlock Text="Script Manager" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <!-- 5: Paths — also bound directly to IsPathsSelected -->
                    <ListBoxItem IsSelected="{Binding IsPathsSelected}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                             <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" Foreground="{Binding $parent[ListBoxItem].Foreground}"/>
                             <TextBlock Text="Paths" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <!-- 6: Log Panel -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                             <PathIcon Data="{StaticResource IconFileText}" Width="13" Height="13" Foreground="{Binding $parent[ListBoxItem].Foreground}"/>
                             <TextBlock Text="Log Panel" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <!-- 7: About -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                             <PathIcon Data="{StaticResource IconInfoCircle}" Width="13" Height="13" Foreground="{Binding $parent[ListBoxItem].Foreground}"/>
                             <TextBlock Text="About" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- CONTENT WRAPPER (Appearance) -->
        <Grid x:Name="Part_ContentWrapper" Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsContentVisible}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsAppearanceSelected}">
                <StackPanel Spacing="0" Margin="0,0,14,20">
                    <TextBlock Classes="SL" Text="THEME"/>
                    <Border Classes="SR">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Language[Appearance.Mode]}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Language[Appearance.ModeDesc]}" FontSize="11" Foreground="#555"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="0" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Padding="2" Width="165" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,*">
                                    <RadioButton Grid.Column="0" GroupName="ThemeGroup"
                                                 IsChecked="{Binding SelectedThemeIndex, Converter={x:Static converters:IndexToBoolConverter.Instance}, ConverterParameter=0}"
                                                 Classes="Segmented">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconSun}" Width="12" Height="12" Foreground="{Binding $parent[RadioButton].Foreground}"/>
                                            <TextBlock Text="Light" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Grid.Column="1" GroupName="ThemeGroup"
                                                 IsChecked="{Binding SelectedThemeIndex, Converter={x:Static converters:IndexToBoolConverter.Instance}, ConverterParameter=1}"
                                                 Classes="Segmented">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconMoon}" Width="12" Height="12" Foreground="{Binding $parent[RadioButton].Foreground}"/>
                                            <TextBlock Text="Dark" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Classes="SL" Text="BACKGROUNDS" Margin="0,24,0,6"/>
                    <Border Classes="SR">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Custom App Background" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Warna latar belakang utama aplikasi (Dark / Light)" FontSize="11" Foreground="#555"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*, *">
                                <Grid Grid.Column="0" ColumnDefinitions="Auto, *" Margin="0,0,5,0">
                                    <TextBlock Text="Dark" VerticalAlignment="Center" Width="44" FontSize="11" Foreground="#555"/>
                                    <ColorPicker Grid.Column="1" Color="{Binding CustomDarkBackgroundColor}" Margin="4,0,0,0" HorizontalAlignment="Stretch"/>
                                </Grid>
                                <Grid Grid.Column="1" ColumnDefinitions="Auto, *" Margin="5,0,0,0">
                                    <TextBlock Text="Light" VerticalAlignment="Center" Width="44" FontSize="11" Foreground="#555"/>
                                    <ColorPicker Grid.Column="1" Color="{Binding CustomLightBackgroundColor}" Margin="4,0,0,0" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="SL" Text="ACCENT" Margin="0,24,0,6"/>
                    <Border Classes="SR">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <StackPanel Spacing="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="Global Accent Color" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Warna utama (Tombol, Link, Indikator)" FontSize="11" Foreground="#555"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedItem="{Binding AccentColor}" ItemsSource="{Binding WidgetColorOptions}" Width="150" Cursor="Hand" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="10" Height="10" CornerRadius="0" Background="{Binding Brush}"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ColorPicker Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsAccentCustom}" Color="{Binding CustomAccentColor}" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                    <TextBlock Classes="SL" Text="NAVIGATION BUTTONS" Margin="0,24,0,6"/>
                    <Border Classes="SR">
                        <Grid ColumnDefinitions="*, 120">
                            <TextBlock Text="Button Width" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Value="{Binding NavButtonWidth}" Minimum="80" Maximum="250" Increment="1" FormatString="0"/>
                        </Grid>
                    </Border>
                    <Border Classes="SR">
                        <Grid ColumnDefinitions="*, 120">
                            <TextBlock Text="Button Height" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Value="{Binding NavButtonHeight}" Minimum="20" Maximum="80" Increment="1" FormatString="0"/>
                        </Grid>
                    </Border>
                    <Border Classes="SR">
                        <Grid ColumnDefinitions="*, 120">
                            <TextBlock Text="Corner Radius" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Value="{Binding NavCornerRadius}" Minimum="0" Maximum="40" Increment="1" FormatString="0"/>
                        </Grid>
                    </Border>
                    <Border Classes="SR">
                        <Grid ColumnDefinitions="*, 180">
                            <TextBlock Text="Button Type" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Padding="2">
                                <Grid ColumnDefinitions="*,*">
                                    <RadioButton Grid.Column="0" Content="Icon" GroupName="NavStyleGroup"
                                                IsChecked="{Binding NavStyleIndex, Converter={x:Static converters:IndexToBoolConverter.Instance}, ConverterParameter=0}"
                                                Classes="Segmented"/>
                                    <RadioButton Grid.Column="1" Content="Text" GroupName="NavStyleGroup"
                                                IsChecked="{Binding NavStyleIndex, Converter={x:Static converters:IndexToBoolConverter.Instance}, ConverterParameter=1}"
                                                Classes="Segmented"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Classes="SR" IsVisible="{Binding NavStyleIndex, Converter={x:Static converters:IndexToBoolConverter.Instance}, ConverterParameter=1}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Button Texts" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBox Text="{Binding NavCustomText}" Watermark="Dashboard"/>
                                <TextBox Text="{Binding NavBatchText}" Watermark="Batch"/>
                                <TextBox Text="{Binding NavLockerText}" Watermark="Locker"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="SR">
                        <Grid ColumnDefinitions="*, 120">
                            <TextBlock Text="Font Size" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Value="{Binding NavFontSize}" Minimum="10" Maximum="24" Increment="0.5" FormatString="0.0"/>
                        </Grid>
                    </Border>
                    <TextBlock Classes="SL" Text="ANIMATIONS" Margin="0,24,0,6"/>
                    <Border Classes="SR">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="Widget Animation Speed" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Durasi animasi lingkaran pada widget statistik" FontSize="11" Foreground="#555"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedStatSpeedIndex}" Width="140" VerticalAlignment="Center">
                                <ComboBoxItem Content="Off"/>
                                <ComboBoxItem Content="Slow (3s)"/>
                                <ComboBoxItem Content="Normal (1.5s)"/>
                                <ComboBoxItem Content="Fast (0.5s)"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <TextBlock Classes="SL" Text="WIDGET COLORS" Margin="0,24,0,6"/>
                    <Border Classes="SR">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <TextBlock Grid.Row="0" Text="{Binding Language[Stats.Editing]}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding EditingColor}" ItemsSource="{Binding WidgetColorOptions}" Width="150">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="10" Height="10" CornerRadius="0" Background="{Binding Brush}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsEditingCustom}" ColumnDefinitions="Auto, *" Margin="0,6,0,0">
                                <TextBlock Text="Pick:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11" Foreground="#555"/>
                                <ColorPicker Grid.Column="1" Color="{Binding CustomEditingColor}" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Classes="SR">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <TextBlock Grid.Row="0" Text="{Binding Language[Stats.Revision]}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding RevisionColor}" ItemsSource="{Binding WidgetColorOptions}" Width="150">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="10" Height="10" CornerRadius="0" Background="{Binding Brush}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsRevisionCustom}" ColumnDefinitions="Auto, *" Margin="0,6,0,0">
                                <TextBlock Text="Pick:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11" Foreground="#555"/>
                                <ColorPicker Grid.Column="1" Color="{Binding CustomRevisionColor}" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Classes="SR">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <TextBlock Grid.Row="0" Text="{Binding Language[Stats.Late]}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding LateColor}" ItemsSource="{Binding WidgetColorOptions}" Width="150">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="10" Height="10" CornerRadius="0" Background="{Binding Brush}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsLateCustom}" ColumnDefinitions="Auto, *" Margin="0,6,0,0">
                                <TextBlock Text="Pick:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11" Foreground="#555"/>
                                <ColorPicker Grid.Column="1" Color="{Binding CustomLateColor}" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Classes="SR">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <TextBlock Grid.Row="0" Text="{Binding Language[Stats.Points]}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding PointsColor}" ItemsSource="{Binding WidgetColorOptions}" Width="150">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="10" Height="10" CornerRadius="0" Background="{Binding Brush}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsPointsCustom}" ColumnDefinitions="Auto, *" Margin="0,6,0,0">
                                <TextBlock Text="Pick:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11" Foreground="#555"/>
                                <ColorPicker Grid.Column="1" Color="{Binding CustomPointsColor}" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Button HorizontalAlignment="Right" Content="{Binding Language[General.Save]}" Command="{Binding SaveProfileCommand}" Classes="Primary" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- GENERAL -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsGeneralSelected}">
            <StackPanel Spacing="0" Margin="0,0,14,20">
                <TextBlock Classes="SL" Text="LANGUAGE"/>
                <Border Classes="SR">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Spacing="2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Language[General.Language]}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Language[General.LanguageDesc]}" FontSize="11" Foreground="#555" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedLanguageIndex}" Width="140" VerticalAlignment="Center">
                            <ComboBoxItem>English</ComboBoxItem>
                            <ComboBoxItem>Indonesia</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </Border>
                <TextBlock Classes="SL" Text="FILTERS" Margin="0,24,0,6"/>
                <Border Classes="SR">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Spacing="2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="File Extensions Filter" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Ekstensi yang ditampilkan (contoh: .jpg, .png). Kosongkan untuk semua." FontSize="11" Foreground="#555" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding BatchFileFilter}" Watermark="All (*)" Width="140" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Classes="SL" Text="DATA" Margin="0,24,0,6"/>
                <Border Classes="SR">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Spacing="2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Language[General.Storage]}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Language[General.StorageDesc]}" FontSize="11" Foreground="#555" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="Clear" Content="›" Foreground="#555" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Classes="SR">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Spacing="2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="Database Backup" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Export untuk simpan pengaturan, Import untuk memulihkan." FontSize="11" Foreground="#555" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Command="{Binding ExportDatabaseCommand}" Content="Export" Classes="Accent"/>
                            <Button Command="{Binding ImportDatabaseCommand}" Content="Import" Classes="Primary"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Classes="SL" Text="DASHBOARD VISIBILITY" Margin="0,24,0,6"/>

                <Border Classes="SR">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Show Batch" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsBatchVisible}"/>
                    </Grid>
                </Border>
                <Border Classes="SR">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Show Folder Locker" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsFolderLockVisible}"/>
                    </Grid>
                </Border>
                <Border Classes="SR">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Show Output Explorer" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsOutputExplorerVisible}"/>
                    </Grid>
                </Border>
                <TextBlock Classes="SL" Text="SHORTCUT" Margin="0,24,0,6"/>
                <Border Classes="SR">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Spacing="2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="Menu Shortcut" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding CurrentShortcut}" FontSize="12" Foreground="{DynamicResource AccentColorBrush}" FontWeight="Bold"/>
                            <TextBlock Text="Press Record, then input new key/mouse combo." FontSize="11" Foreground="#555" IsVisible="{Binding !IsRecordingShortcut}"/>
                            <TextBlock Text="LISTENING... Press any key or mouse button!" FontSize="11" Foreground="#ef4444" FontWeight="Bold" IsVisible="{Binding IsRecordingShortcut}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Spacing="5">
                            <Button Content="Record New" Command="{Binding StartRecordingShortcutCommand}" IsVisible="{Binding !IsRecordingShortcut}" Classes="Primary" HorizontalAlignment="Right"/>
                            <Button Content="Cancel (Esc)" Command="{Binding CancelRecordingShortcutCommand}" IsVisible="{Binding IsRecordingShortcut}" Classes="Accent" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="SR">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Spacing="2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="Date &amp; Time" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Buka pengaturan jam Windows untuk sinkronisasi waktu." FontSize="11" Foreground="#555" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding SyncSystemTimeCommand}" Content="Sync Time" Classes="Primary" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Classes="SL" Text="PROFILE" Margin="0,24,0,6"/>
                <Border Classes="SR">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Spacing="2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Language[General.Profile]}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Language[General.ProfileDesc]}" FontSize="11" Foreground="#555" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Column="1" ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            <TextBox Grid.Column="0" Width="130" Text="{Binding UserName}" Watermark="Nama Anda" HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding OpenAvatarSelectionCommand}"
                                    Width="36" Height="36" CornerRadius="0" Padding="0" Margin="8,0,0,0"
                                    Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" Cursor="Hand" ToolTip.Tip="Change Avatar">
                                <Border CornerRadius="0" ClipToBounds="True">
                                     <Panel>
                                         <PathIcon Data="{StaticResource IconUser}" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          IsVisible="{Binding AvatarImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                                         <Image Source="{Binding AvatarImage}" Stretch="UniformToFill"
                                                IsVisible="{Binding AvatarImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                     </Panel>
                                </Border>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                <Button HorizontalAlignment="Right" Content="{Binding Language[General.Save]}" Command="{Binding SaveProfileCommand}" Classes="Primary" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ACCOUNT -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsAccountSelected}">
            <StackPanel Spacing="0" Margin="0,0,14,20">
                <TextBlock Classes="SL" Text="TRELLO INTEGRATION"/>
                <Border Classes="SR">
                    <Grid ColumnDefinitions="110, *" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                            <TextBox Grid.Column="0" Text="{Binding TrelloApiKey, UpdateSourceTrigger=PropertyChanged}" PasswordChar="*" Watermark="Trello API Key"/>
                            <Button Grid.Column="1" Command="{Binding OpenTrelloAdminCommand}" Content="Get Key" Classes="Clear" Margin="8,0,0,0" ToolTip.Tip="Open Trello Power-Up Admin to generate Key" IsVisible="{Binding IsTrelloKeyMissing}"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Token" FontSize="12" Foreground="#555" VerticalAlignment="Center" IsVisible="{Binding IsTrelloKeyProvided}"/>
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, Auto" IsVisible="{Binding IsTrelloKeyProvided}">
                            <TextBox Grid.Column="0" Text="{Binding TrelloToken, UpdateSourceTrigger=PropertyChanged}" PasswordChar="*" Watermark="Trello Token"/>
                            <Button Grid.Column="1" Command="{Binding SmartTrelloActionCommand}" Content="{Binding SmartTrelloButtonText}" Classes="Primary" Margin="8,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Classes="SL" Text="GOOGLE INTEGRATION" Margin="0,24,0,6"/>
                <Border Classes="SR">
                    <Grid ColumnDefinitions="130, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Credentials JSON" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                            <TextBox Grid.Column="0" Text="{Binding GoogleCredsPath}" Watermark="Path to json credentials"/>
                            <Button Grid.Column="1" Classes="Primary" Margin="8,0,0,0" Click="OnBrowseCredsClick" Padding="8,5">
                                 <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13"/>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sheet ID" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GoogleSheetId}" Watermark="Google Sheet ID" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Worksheet Name" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SheetName}" Watermark="e.g. Sheet1" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Column / Row" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*, *" Margin="0,0,0,8">
                            <AutoCompleteBox Grid.Column="0" ItemsSource="{Binding SheetColumns}" SelectedItem="{Binding SheetColumn}" Watermark="Col" HorizontalAlignment="Stretch" Margin="0,0,4,0" FilterMode="Contains" MinimumPrefixLength="0" GotFocus="AutoCompleteBox_GotFocus" MaxDropDownHeight="160"/>
                            <AutoCompleteBox Grid.Column="1" ItemsSource="{Binding SheetRows}" SelectedItem="{Binding SheetRow}" Watermark="Row" HorizontalAlignment="Stretch" Margin="4,0,0,0" FilterMode="Contains" MinimumPrefixLength="0" GotFocus="AutoCompleteBox_GotFocus" MaxDropDownHeight="160"/>
                        </Grid>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Spreadsheet Sheet" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SpreadsheetSheetName}" Watermark="e.g. ALL DATA REGULER" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Spreadsheet Range" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SpreadsheetRange}" Watermark="e.g. A1:Z" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="LB Harian Range" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding LeaderboardRange}" Watermark="e.g. A2:C10" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="LB Bulanan Range" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding LeaderboardMonthlyRange}" Watermark="e.g. A2:C10" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>
                <TextBlock Classes="SL" Text="BOARD SYNCHRONIZATION" Margin="0,24,0,6"/>
                <Border Classes="SR">
                    <StackPanel>
                        <StackPanel IsVisible="{Binding IsTrelloConnected}" Spacing="0">
                            <Grid ColumnDefinitions="140, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Editing Board/List" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, *" Margin="0,0,0,8">
                                    <AutoCompleteBox Grid.Column="0" ItemsSource="{Binding MockBoards}" SelectedItem="{Binding SelectedEditingBoard}" ValueMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" Watermark="Select Board" FilterMode="Contains" MinimumPrefixLength="0" GotFocus="AutoCompleteBox_GotFocus" MaxDropDownHeight="160"/>
                                    <AutoCompleteBox Grid.Column="1" ItemsSource="{Binding EditingLists}" SelectedItem="{Binding SelectedEditingList}" ValueMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" Watermark="Select List" Margin="8,0,0,0" FilterMode="Contains" MinimumPrefixLength="0" GotFocus="AutoCompleteBox_GotFocus" MaxDropDownHeight="160"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Revisi Board/List" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, *" Margin="0,0,0,8">
                                    <AutoCompleteBox Grid.Column="0" ItemsSource="{Binding MockBoards}" SelectedItem="{Binding SelectedRevisionBoard}" ValueMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" Watermark="Select Board" FilterMode="Contains" MinimumPrefixLength="0" GotFocus="AutoCompleteBox_GotFocus" MaxDropDownHeight="160"/>
                                    <AutoCompleteBox Grid.Column="1" ItemsSource="{Binding RevisionLists}" SelectedItem="{Binding SelectedRevisionList}" ValueMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" Watermark="Select List" Margin="8,0,0,0" FilterMode="Contains" MinimumPrefixLength="0" GotFocus="AutoCompleteBox_GotFocus" MaxDropDownHeight="160"/>
                                </Grid>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Susulan Board/List" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*, *" Margin="0,0,0,8">
                                    <AutoCompleteBox Grid.Column="0" ItemsSource="{Binding MockBoards}" SelectedItem="{Binding SelectedLateBoard}" ValueMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" Watermark="Select Board" FilterMode="Contains" MinimumPrefixLength="0" GotFocus="AutoCompleteBox_GotFocus" MaxDropDownHeight="160"/>
                                    <AutoCompleteBox Grid.Column="1" ItemsSource="{Binding LateLists}" SelectedItem="{Binding SelectedLateList}" ValueMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" Watermark="Select List" Margin="8,0,0,0" FilterMode="Contains" MinimumPrefixLength="0" GotFocus="AutoCompleteBox_GotFocus" MaxDropDownHeight="160"/>
                                </Grid>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Target Move Board" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                    <AutoCompleteBox ItemsSource="{Binding MockBoards}" SelectedItem="{Binding SelectedQcBoard}" ValueMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" Watermark="Select Auto-Move Board" FilterMode="Contains" MinimumPrefixLength="0" GotFocus="AutoCompleteBox_GotFocus" MaxDropDownHeight="160"/>
                                </Grid>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Marketing ACC Board/List" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*, *">
                                    <AutoCompleteBox Grid.Column="0" ItemsSource="{Binding MockBoards}" SelectedItem="{Binding SelectedAccBoard}" ValueMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" Watermark="Select Board" FilterMode="Contains" MinimumPrefixLength="0" GotFocus="AutoCompleteBox_GotFocus" MaxDropDownHeight="160"/>
                                    <AutoCompleteBox Grid.Column="1" ItemsSource="{Binding AccLists}" SelectedItem="{Binding SelectedAccList}" ValueMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" Watermark="Select List" Margin="8,0,0,0" FilterMode="Contains" MinimumPrefixLength="0" GotFocus="AutoCompleteBox_GotFocus" MaxDropDownHeight="160"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                        <Border IsVisible="{Binding !IsTrelloConnected}" Background="#08FFFFFF" CornerRadius="0" Padding="14" Margin="0,4,0,0" BorderBrush="#12FFFFFF" BorderThickness="1">
                             <StackPanel Spacing="6" HorizontalAlignment="Center">
                                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                     <PathIcon Data="{StaticResource IconAlertTriangle}" Width="16" Height="16" Foreground="#555"/>
                                     <TextBlock Text="Not Connected" FontSize="13" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center"/>
                                 </StackPanel>
                                 <TextBlock Text="Connect your Trello Account above to configure Boards &amp; Lists." Foreground="#444" FontSize="11" HorizontalAlignment="Center"/>
                             </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock Classes="SL" Text="REFRESH INTERVALS (s)" Margin="0,24,0,6"/>
                <Border Classes="SR">
                    <UniformGrid Columns="2" Rows="2">
                        <StackPanel Spacing="5" Margin="0,0,10,10">
                            <TextBlock Text="Editing Board" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <NumericUpDown Value="{Binding EditingRefreshSeconds}" Minimum="5" Maximum="3600" Increment="5" FormatString="0"/>
                        </StackPanel>
                        <StackPanel Spacing="5" Margin="0,0,0,10">
                            <TextBlock Text="Revision Board" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <NumericUpDown Value="{Binding RevisionRefreshSeconds}" Minimum="5" Maximum="3600" Increment="5" FormatString="0"/>
                        </StackPanel>
                        <StackPanel Spacing="5" Margin="0,0,10,0">
                            <TextBlock Text="Late Board" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <NumericUpDown Value="{Binding LateRefreshSeconds}" Minimum="5" Maximum="3600" Increment="5" FormatString="0"/>
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="Points (Sheet)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <NumericUpDown Value="{Binding PointsRefreshSeconds}" Minimum="5" Maximum="3600" Increment="5" FormatString="0"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>
                <Button HorizontalAlignment="Right" Content="{Binding Language[General.Save]}" Command="{Binding SaveProfileCommand}" Classes="Primary" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- EXTENSIONS -->
        <Grid Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsNotificationsSelected}" Margin="0,0,14,20">
             <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0" ClipToBounds="True">
                 <Grid Margin="16">
                 <TextBlock Text="{Binding Language[Extensions.NoExtensions]}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                     <TextBlock.IsVisible>
                         <Binding Path="Extensions.Count" Converter="{x:Static ObjectConverters.IsNull}"/>
                     </TextBlock.IsVisible>
                 </TextBlock>
                 <ScrollViewer VerticalScrollBarVisibility="Auto">
                     <ItemsControl ItemsSource="{Binding Extensions}" Margin="0,0,0,60">
                         <ItemsControl.ItemTemplate>
                             <DataTemplate>
                                 <Border BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1" Padding="0,12">
                                     <Grid ColumnDefinitions="Auto, *, Auto, Auto" RowDefinitions="Auto, Auto">
                                         <Border Grid.RowSpan="2" Width="36" Height="36" CornerRadius="0" Background="{DynamicResource AccentColorBrush}" Margin="0,0,12,0">
                                             <PathIcon Data="{StaticResource IconExtension}" Foreground="White" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                         </Border>
                                         <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                             <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                             <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                         </StackPanel>
                                         <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                             <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="11" Foreground="#555"/>
                                             <TextBlock Text="|" FontSize="11" Foreground="#333"/>
                                             <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#555"/>
                                         </StackPanel>
                                         <ToggleButton Grid.Column="2" Classes="Switch" IsChecked="{Binding IsEnabled}" Command="{Binding ToggleCommand}" VerticalAlignment="Center" Margin="10,0"/>
                                         <Button Grid.Column="3" Classes="Clear" Command="{Binding DeleteCommand}" Foreground="#EF4444" VerticalAlignment="Center">
                                             <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" Foreground="#EF4444"/>
                                         </Button>
                                     </Grid>
                                 </Border>
                             </DataTemplate>
                         </ItemsControl.ItemTemplate>
                     </ItemsControl>
                 </ScrollViewer>
                 <Button Command="{Binding AddExtensionCommand}" Classes="Primary" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                     <StackPanel Orientation="Horizontal" Spacing="8">
                         <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                         <TextBlock Text="{Binding Language[Extensions.Add]}" VerticalAlignment="Center"/>
                     </StackPanel>
                 </Button>
             </Grid>
             </Border>
        </Grid>

        <!-- SCRIPT MANAGER -->
        <Grid Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsScriptsManagerSelected}" Margin="0,0,14,20">
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0" ClipToBounds="True">
                <Grid RowDefinitions="Auto, *">
                    <Border Grid.Row="0" HorizontalAlignment="Center" 
                            Background="{DynamicResource MenuHoverBrush}" 
                            CornerRadius="6" 
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" 
                            Padding="4" Margin="16,14,16,8">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <StackPanel.Styles>
                                <Style Selector="RadioButton.TabButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Padding" Value="24,10"/>
                                    <Setter Property="CornerRadius" Value="4"/>
                                    <Setter Property="Margin" Value="2,0"/>
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                            <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                                            <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                                        </Transitions>
                                    </Setter>
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="11" 
                                                           Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                                <Style Selector="RadioButton.TabButton:pointerover">
                                    <Setter Property="Background" Value="#10FFFFFF"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Style>
                                <Style Selector="RadioButton.TabButton:checked">
                                     <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                     <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                     <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                </Style>
                            </StackPanel.Styles>
                            
                            <RadioButton Classes="TabButton" Content="MASTER SCRIPTS (PYTHON)" IsChecked="{Binding IsScriptMasterSelected}" Command="{Binding SwitchToScriptMasterCommand}"/>
                            <RadioButton Classes="TabButton" Content="ACTION SCRIPTS (RADIAL MENU)" IsChecked="{Binding IsScriptActionSelected}" Command="{Binding SwitchToScriptActionCommand}"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="16,0,16,16">
                            <!-- MASTER SCRIPTS -->
                            <Grid IsVisible="{Binding IsScriptMasterSelected}" RowDefinitions="Auto, *" Margin="0,0,0,20">
                                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                     <ItemsControl ItemsSource="{Binding MasterScripts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12" Margin="0,0,0,1" Background="Transparent" BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1"
                                                        DragDrop.AllowDrop="True" DragDrop.DragOver="OnItemDragOver" DragDrop.Drop="OnItemDrop" Tag="Master">
                                                    <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                                                        <PathIcon Grid.Column="0" Data="{StaticResource IconMenu}" Width="14" Height="14" Foreground="#555" VerticalAlignment="Top" Margin="0,4,12,0"
                                                                  ToolTip.Tip="Drag to Reorder" Cursor="Hand" PointerPressed="OnHamburgerPointerPressed"/>
                                                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="0" Margin="0,0,12,0"
                                                                Background="#0FFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Top">
                                                             <Panel>
                                                                 <Viewbox Width="16" Height="16" IsVisible="{Binding !IsEditing}">
                                                                      <Path Data="{Binding IconGeometry}" Fill="White" Stretch="Uniform" IsVisible="{Binding IconGeometry, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                                 </Viewbox>
                                                                 <PathIcon Data="{StaticResource IconScript}" Width="14" Height="14" Foreground="#444" IsVisible="{Binding IconGeometry, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                                 <Button IsVisible="{Binding IsEditing}" Command="{Binding PickIconCommand}"
                                                                         Background="Transparent" BorderThickness="0" Padding="0"
                                                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand" ToolTip.Tip="Select Icon">
                                                                     <Panel>
                                                                         <Viewbox Width="16" Height="16">
                                                                              <Path Data="{Binding EditIconGeometry}" Fill="{DynamicResource AccentBlueBrush}" Stretch="Uniform" IsVisible="{Binding EditIconGeometry, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                                         </Viewbox>
                                                                         <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" Foreground="#555" IsVisible="{Binding EditIconGeometry, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                                     </Panel>
                                                                 </Button>
                                                             </Panel>
                                                        </Border>
                                                        <!-- View mode -->
                                                        <Grid Grid.Column="2" IsVisible="{Binding !IsEditing}" RowDefinitions="Auto, Auto">
                                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <Border Background="#14FFFFFF" CornerRadius="0" Padding="5,2" VerticalAlignment="Center" IsVisible="{Binding ShortCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <TextBlock Text="{Binding ShortCode}" FontSize="11" Foreground="#AAA" FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Row="1" Text="{Binding OriginalName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                                        </Grid>
                                                        <!-- Edit mode -->
                                                        <Grid Grid.Column="2" IsVisible="{Binding IsEditing}" ColumnDefinitions="*, 80" RowDefinitions="Auto, Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Display Name" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Short Code" FontSize="11" Foreground="#666" Margin="5,0,0,2"/>
                                                            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding EditName}" Watermark="Main Text" Margin="0,0,8,0" FontSize="13" Padding="7">
                                                                <TextBox.KeyBindings>
                                                                    <KeyBinding Gesture="Enter" Command="{Binding SaveRenameCommand}"/>
                                                                </TextBox.KeyBindings>
                                                            </TextBox>
                                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditShortCode}" Watermark="CODE" MaxLength="4" FontSize="13" HorizontalContentAlignment="Center" Padding="7">
                                                                <TextBox.KeyBindings>
                                                                    <KeyBinding Gesture="Enter" Command="{Binding SaveRenameCommand}"/>
                                                                </TextBox.KeyBindings>
                                                            </TextBox>
                                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                                                                <Button Content="Cancel" Command="{Binding ToggleEditCommand}" Classes="Clear" Foreground="{DynamicResource AccentColorBrush}" FontSize="12" Padding="10,5"/>
                                                                <Button Content="Save Changes" Command="{Binding SaveRenameCommand}" Classes="Primary" FontSize="12" Padding="12,5"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Button Grid.Column="3" Command="{Binding ToggleEditCommand}" Classes="Clear" IsVisible="{Binding !IsEditing}" Margin="8,0,0,0" ToolTip.Tip="Edit Script">
                                                            <PathIcon Data="{StaticResource IconEdit}" Width="14" Height="14" Foreground="#555"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                            <!-- ACTION SCRIPTS (RADIAL) -->
                            <Grid IsVisible="{Binding IsScriptActionSelected}" RowDefinitions="Auto, *">
                                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16">
                                    <Grid RowDefinitions="Auto, *">
                                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,16">
                                                <Button Grid.Column="0" Command="{Binding SwitchToRadialPage1Command}" Classes="Clear" VerticalAlignment="Center" Margin="0,0,24,0" Width="36" Height="36" CornerRadius="18" ToolTip.Tip="Ke Halaman 1" Cursor="Hand" Background="#08FFFFFF">
                                                    <Path Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                                <Border Grid.Column="1" Width="200" Height="200" CornerRadius="100" Background="{DynamicResource AppBackgroundBrush}" ClipToBounds="True">
                                                <Grid>
                                                    <Canvas Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.35">
                                                        <Line StartPoint="116.84,59.35" EndPoint="138.27,7.61" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                                        <Line StartPoint="140.65,83.16" EndPoint="192.39,61.73" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                                        <Line StartPoint="140.65,116.84" EndPoint="192.39,138.27" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                                        <Line StartPoint="116.84,140.65" EndPoint="138.27,192.39" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                                        <Line StartPoint="83.16,140.65" EndPoint="61.73,192.39" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                                        <Line StartPoint="59.35,116.84" EndPoint="7.61,138.27" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                                        <Line StartPoint="59.35,83.16" EndPoint="7.61,61.73" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                                        <Line StartPoint="83.16,59.35" EndPoint="61.73,7.61" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                                    </Canvas>
                                                    <Border Width="88" Height="88" CornerRadius="44" Background="{DynamicResource CardBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Ellipse Width="200" Height="200" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Opacity="0.35" IsHitTestVisible="False"/>
                                                    <Ellipse Width="88" Height="88" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Opacity="0.35" IsHitTestVisible="False"/>
                                                    <ItemsControl x:Name="RadialSlotsControl" ItemsSource="{Binding RadialSlots}" ClipToBounds="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                        <Canvas Width="200" Height="200" ClipToBounds="False"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.Styles>
                                                            <Style Selector="ItemsControl > ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                            </Style>
                                                        </ItemsControl.Styles>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Width="36" Height="36">
                                                                    <Border IsVisible="{Binding IsNavigationReserved}" Background="#1A1A1A" CornerRadius="18" BorderBrush="#333" BorderThickness="1">
                                                                        <TextBlock Text="{Binding NavigationLabel}" FontSize="7" FontWeight="Bold" Foreground="#777" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Button Classes="Clear" IsVisible="{Binding IsEmpty}" Command="{Binding DataContext.AddScriptToRadialSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Width="36" Height="36" CornerRadius="18" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Background="Transparent" ToolTip.Tip="Add Script to Slot" Padding="0">
                                                                        <PathIcon Data="{StaticResource IconPlus}" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Button>
                                                                    <Button Classes="Clear" IsVisible="{Binding !IsEmpty}"
                                                                            Command="{Binding DataContext.SelectRadialSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="36" Height="36" CornerRadius="18"
                                                                            Background="{DynamicResource AccentBlueBrush}"
                                                                            BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1"
                                                                            ToolTip.Tip="{Binding Script.Name}" Padding="0"
                                                                            Tag="{Binding}"
                                                                            PointerPressed="OnRadialSlotPointerPressed"
                                                                            PointerMoved="OnRadialSlotPointerMoved"
                                                                            PointerReleased="OnRadialSlotPointerReleased"
                                                                            Cursor="SizeAll">
                                                                        <Grid>
                                                                            <Border IsVisible="{Binding IsSelected}" Width="44" Height="44" CornerRadius="22" BorderBrush="White" BorderThickness="2" Margin="-4"/>
                                                                            <Viewbox Width="18" Height="18" IsVisible="{Binding Script.IconGeometry, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                 <Path Data="{Binding Script.IconGeometry}" Fill="White" Stretch="Uniform"/>
                                                                            </Viewbox>
                                                                            <TextBlock Text="{Binding Script.ShortCode}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="White" IsVisible="{Binding Script.IconGeometry, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                                        </Grid>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                                </Border>
                                                <Button Grid.Column="2" Command="{Binding SwitchToRadialPage2Command}" Classes="Clear" VerticalAlignment="Center" Margin="24,0,0,0" Width="36" Height="36" CornerRadius="18" ToolTip.Tip="Ke Halaman 2" Cursor="Hand" Background="#08FFFFFF">
                                                    <Path Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                        <!-- Selected Slot Detail -->
                                        <Border Grid.Row="1" Background="#04FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="0" Padding="20" Margin="0,8,0,0">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding SelectedRadialSlot, Converter={x:Static ObjectConverters.IsNull}}" Spacing="8">
                                                    <PathIcon Data="{StaticResource IconScript}" Width="36" Height="36" Foreground="#252525"/>
                                                    <TextBlock Text="Pilih shortcut di sebelah kiri untuk mengedit," Foreground="#444" TextAlignment="Center" FontSize="12"/>
                                                    <TextBlock Text="atau klik tombol (+) untuk menambah baru." Foreground="#444" TextAlignment="Center" FontSize="12"/>
                                                </StackPanel>
                                                <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" IsVisible="{Binding SelectedRadialSlot, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <TextBlock Grid.Row="0" Text="SLOT DETAILS" FontSize="10" FontWeight="Medium" Foreground="#444" LetterSpacing="2" Margin="0,0,0,20"/>
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
                                                        <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="#14FFFFFF" BorderThickness="1">
                                                            <Button Classes="Clear" Command="{Binding SelectedRadialSlot.Script.PickIconCommand}" ToolTip.Tip="Change Icon" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="28" Padding="0">
                                                                <Panel>
                                                                     <Viewbox Width="28" Height="28" IsVisible="{Binding SelectedRadialSlot.Script.EditIconGeometry, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                          <Path Data="{Binding SelectedRadialSlot.Script.EditIconGeometry}" Fill="{DynamicResource AccentBlueBrush}" Stretch="Uniform"/>
                                                                     </Viewbox>
                                                                     <PathIcon Data="{StaticResource IconPlus}" Width="18" Height="18" Foreground="#555" IsVisible="{Binding SelectedRadialSlot.Script.EditIconGeometry, Converter={x:Static ObjectConverters.IsNull}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Panel>
                                                            </Button>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SelectedRadialSlot.Script.OriginalName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                                                            <TextBlock Text="{Binding SelectedRadialSlot.Script.FullPath}" FontSize="11" Foreground="#555" TextWrapping="Wrap" MaxWidth="280"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Grid Grid.Row="2" ColumnDefinitions="*, 90" RowDefinitions="Auto, Auto" Margin="0,0,0,16">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Display Name" FontSize="11" FontWeight="Medium" Foreground="#555" Margin="0,0,0,6"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Short Code" FontSize="11" FontWeight="Medium" Foreground="#555" Margin="12,0,0,6"/>
                                                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SelectedRadialSlot.Script.EditName}" Watermark="Name" Margin="0,0,12,0" FontSize="13" Padding="10"/>
                                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRadialSlot.Script.EditShortCode}" Watermark="CODE" MaxLength="4" FontSize="13" HorizontalContentAlignment="Center" Padding="10"/>
                                                    </Grid>
                                                    <WrapPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Classes="Clear" Content="⬅ Mundur" Command="{Binding DataContext.MoveRadialSlotUpCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding SelectedRadialSlot}" Padding="10,7" ToolTip.Tip="Geser posisi berlawanan jarum jam" Margin="0,4,4,0"/>
                                                        <Button Classes="Clear" Content="Maju ➡" Command="{Binding DataContext.MoveRadialSlotDownCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding SelectedRadialSlot}" Padding="10,7" ToolTip.Tip="Geser posisi searah jarum jam" Margin="0,4,4,0"/>
                                                        <Button Classes="Clear" Content="Hapus" Foreground="#ef4444" Command="{Binding DataContext.RemoveFromRadialSlotCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding SelectedRadialSlot}" Padding="10,7" FontWeight="SemiBold" Margin="0,4,4,0"/>
                                                        <Button Classes="Primary" Content="Simpan" Command="{Binding SelectedRadialSlot.Script.SaveRenameCommand}" Padding="14,7" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                    </WrapPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- PATHS -->
        <Grid Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsPathsSelected}" Margin="0,0,14,20">
             <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0" ClipToBounds="True">
                 <views:PathSettingsView DataContext="{Binding PathSettingsVM}"/>
             </Border>
        </Grid>

        <!-- STATUS TOAST -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsLogPanelSelected}">
            <StackPanel Spacing="0" Margin="0,0,14,20">
                <TextBlock Classes="SL" Text="LOG PANEL NAVIGATION"/>
                <Border Classes="SR">
                    <Grid ColumnDefinitions="*, 120">
                        <TextBlock Text="Tab Button Height" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding LogNavButtonHeight}" Minimum="10" Maximum="80" Increment="1" FormatString="0"/>
                    </Grid>
                </Border>
                <Border Classes="SR">
                    <Grid ColumnDefinitions="*, 120">
                        <TextBlock Text="Tab Icon Size" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding LogNavFontSize}" Minimum="10" Maximum="30" Increment="1" FormatString="0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ABOUT -->
        <Grid Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsAboutSelected}" Margin="0,0,14,20">
             <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0" ClipToBounds="True">
                 <ScrollViewer>
                     <StackPanel Spacing="24" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                     <Image Source="/Assets/splash_logo.png" Width="80" Height="80" HorizontalAlignment="Center"/>
                     <StackPanel Spacing="6" HorizontalAlignment="Center">
                         <TextBlock Text="BMachine" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                         <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                              <Border Background="{DynamicResource AccentColorBrush}" CornerRadius="0" Padding="6,2">
                                  <TextBlock Text="{Binding CurrentVersion, StringFormat='v{0}'}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                              </Border>
                              <TextBlock Text="Photo Editing Workflow" Foreground="#555" VerticalAlignment="Center" FontSize="12"/>
                         </StackPanel>
                     </StackPanel>
                     <StackPanel Spacing="12" HorizontalAlignment="Center" Width="280">
                         <Button Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding !IsCheckingUpdate}" Classes="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38">
                             <StackPanel Orientation="Horizontal" Spacing="8">
                                 <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" IsVisible="{Binding !IsCheckingUpdate}"/>
                                 <TextBlock Text="Check for Updates" IsVisible="{Binding !IsCheckingUpdate}" FontSize="13"/>
                                 <TextBlock Text="Checking..." IsVisible="{Binding IsCheckingUpdate}" FontSize="13"/>
                             </StackPanel>
                         </Button>
                         <StackPanel Spacing="8" IsVisible="{Binding UpdateStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                             <TextBlock Text="{Binding UpdateStatusText}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                             <Button Command="{Binding OpenDownloadPageCommand}" IsVisible="{Binding IsUpdateAvailable}" Classes="Accent" HorizontalAlignment="Stretch" Content="Download Update"/>
                             <TextBlock Text="{Binding UpdateReleaseNotes}" IsVisible="{Binding IsUpdateAvailable}" Foreground="#555" FontSize="11" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
                         </StackPanel>
                     </StackPanel>
                     <Border Height="1" Background="#14FFFFFF" Width="300"/>
                     <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                         <Button Classes="Clear" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/zhensmarks/BMachine.v2">
                             <StackPanel Orientation="Horizontal" Spacing="5">
                                 <PathIcon Data="{StaticResource IconBrandGithub}" Width="14" Height="14"/>
                                 <TextBlock Text="GitHub" FontSize="12"/>
                             </StackPanel>
                         </Button>
                         <Button Classes="Clear" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/zhensmarks/BMachine.v2/issues">
                             <StackPanel Orientation="Horizontal" Spacing="5">
                                 <PathIcon Data="{StaticResource IconBug}" Width="14" Height="14"/>
                                 <TextBlock Text="Report Issue" FontSize="12"/>
                             </StackPanel>
                         </Button>
                     </StackPanel>
                     <TextBlock Text="Copyright © 2024-2026 Antigravity. All rights reserved." Foreground="#383838" FontSize="10" HorizontalAlignment="Center" LetterSpacing="0.5"/>
                 </StackPanel>
             </ScrollViewer>
             </Border>
        </Grid>

        <!-- STATUS TOAST -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
                Background="#1C1C1C" CornerRadius="0" Padding="14,9"
                BorderBrush="#20FFFFFF" BorderThickness="1"
                IsVisible="{Binding IsStatusVisible}"
                ZIndex="99">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="Medium" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
