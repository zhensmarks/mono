<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BMachine.UI.Views.Dialogs.MantraData.CleanerWindow"
        Title="Pembersihan Cepat"
        Width="680" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#09090B"
        Foreground="#E8E8E6">

    <Window.Styles>
        <Style Selector="Button.Preview">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Preview /template/ ContentPresenter">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="TextElement.Foreground" Value="#E4E4E7"/>
        </Style>
        <Style Selector="Button.Preview:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="TextElement.Foreground" Value="#F4F4F5"/>
        </Style>

        <Style Selector="Button.Apply">
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Apply /template/ ContentPresenter">
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="TextElement.Foreground" Value="#111111"/>
        </Style>
        <Style Selector="Button.Apply:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.Cancel">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Cancel /template/ ContentPresenter">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="TextElement.Foreground" Value="#E4E4E7"/>
        </Style>
        <Style Selector="Button.Cancel:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#27272A"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Pembersihan Cepat Data" FontSize="18" FontWeight="SemiBold" Foreground="#F4F4F5"/>
            <TextBlock Text="Pilih tindakan pembersihan yang ingin diterapkan. Preview perubahan akan ditampilkan di tabel utama."
                       Foreground="#71717A" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Suggestions List -->
        <Border Grid.Row="1" Background="#0C0C0E" BorderBrush="#232326" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <ListBox x:Name="SuggestionsListBox" ItemsSource="{Binding Suggestions}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1"
                                    CornerRadius="6" Padding="14" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <CheckBox Content="{Binding Title}"
                                              IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding Applicable}"
                                              Foreground="#E4E4E7"
                                              FontWeight="Medium"
                                              FontSize="13"/>
                                    <TextBlock Text="{Binding Detail}"
                                               Foreground="#71717A"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Margin="24,4,0,0"/>
                                    <TextBlock Text="{Binding Count, StringFormat='Terpengaruh: {0} item'}"
                                               Foreground="#52525B"
                                               FontSize="11"
                                               FontFamily="'Cascadia Code', Consolas, monospace"
                                               Margin="24,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel" IsVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="Tidak ada rekomendasi pembersihan." FontSize="14" FontWeight="SemiBold"
                               Foreground="#E4E4E7" HorizontalAlignment="Center"/>
                    <TextBlock Text="Data sudah bersih, spasi rapi, dan tidak ada header berulang."
                               FontSize="12" Foreground="#71717A" Margin="0,6,0,0" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Preview" Classes="Preview" Margin="0,0,8,0"
                    Cursor="Hand" Click="OnPreviewClicked"/>
            <Button Content="Terapkan" Classes="Apply" Margin="0,0,8,0"
                    Cursor="Hand" Click="OnApplyClicked"/>
            <Button Content="Batal" Classes="Cancel"
                    Cursor="Hand" Click="OnCancelClicked"/>
        </StackPanel>
    </Grid>
</Window>