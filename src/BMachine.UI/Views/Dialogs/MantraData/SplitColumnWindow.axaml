<local:MantraDialogBase xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BMachine.UI.Views.Dialogs.MantraData"
        x:Class="BMachine.UI.Views.Dialogs.MantraData.SplitColumnWindow"
        Title="Pisah Kolom"
        Width="480" Height="460"
        MinWidth="480" MinHeight="460"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="#09090B"
        Foreground="#E8E8E6"
        FontFamily="'Segoe UI Variable', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="'Segoe UI Variable', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif"/>
        </Style>
        <Style Selector="TemplatedControl">
            <Setter Property="FontFamily" Value="'Segoe UI Variable', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="'Segoe UI Variable', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="'Segoe UI Variable', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontFamily" Value="'Segoe UI Variable', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontFamily" Value="'Segoe UI Variable', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif"/>
        </Style>

        <Style Selector="Button.ChromeClose">
            <Setter Property="FontFamily" Value="'Segoe UI Variable', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ChromeClose:pointerover">
            <Setter Property="Background" Value="#1A1A1D"/>
        </Style>

        <Style Selector="Button.Action">
            <Setter Property="FontFamily" Value="'Segoe UI Variable', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif"/>
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Action /template/ ContentPresenter">
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="#111111"/>
        </Style>
        <Style Selector="Button.Action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="TextElement.Foreground" Value="#111111"/>
        </Style>
        <Style Selector="Button.Action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#D4D4D4"/>
            <Setter Property="TextElement.Foreground" Value="#111111"/>
        </Style>

        <Style Selector="Button.Muted">
            <Setter Property="FontFamily" Value="'Segoe UI Variable', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif"/>
            <Setter Property="Background" Value="#1C1C1F"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Muted /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="#E4E4E7"/>
        </Style>
        <Style Selector="Button.Muted:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#27272B"/>
            <Setter Property="BorderBrush" Value="#52525B"/>
            <Setter Property="TextElement.Foreground" Value="#F4F4F5"/>
        </Style>
        <Style Selector="Button.Muted:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#222226"/>
        </Style>
    </Window.Styles>

    <Border Background="#09090B" BorderBrush="#232326" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">

        <!-- ═══ WINDOW TITLE BAR ═══ -->
        <Grid Grid.Row="0" Height="40" Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding $parent[Window].Title, FallbackValue=Pisah Kolom}"
                       VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"
                       FontSize="13" Foreground="#A1A1AA" IsHitTestVisible="False"/>

            <Button Grid.Column="1" Classes="ChromeClose" Content="X" Width="45" Height="40"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                    Click="OnCloseButtonClick"/>

            <Rectangle Grid.ColumnSpan="2" Height="1" Fill="#232326" VerticalAlignment="Bottom"/>
        </Grid>

    <Border Grid.Row="1" Margin="16" Padding="20" Background="#111113" BorderBrush="#232326" BorderThickness="1" CornerRadius="10">
        <Grid RowDefinitions="Auto, *, Auto">
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Pisah Kolom" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5"/>
                <TextBlock Text="Pecah isi satu kolom menjadi dua kolom dengan pemisah tertentu." FontSize="12" Foreground="#71717A" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock Text="Kolom yang akan dipisah" FontSize="12" FontWeight="Medium" Foreground="#A1A1AA"/>
                <ComboBox x:Name="CmbSource" HorizontalAlignment="Stretch" Height="34" FontSize="12"
                          VerticalContentAlignment="Center" Padding="10,0,8,0"
                          Background="#0C0C0E" Foreground="#E8E8E6" BorderBrush="#232326" BorderThickness="1" CornerRadius="6"/>

                <TextBlock Text="Karakter pemisah (koma, titik dua, strip, dll)" FontSize="12" FontWeight="Medium" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                <TextBox x:Name="TxtSeparator" Text="," Height="34" FontSize="12.5" VerticalContentAlignment="Center"
                         Background="#0C0C0E" Foreground="#E8E8E6" BorderBrush="#232326" BorderThickness="1" CornerRadius="6" Padding="10,0"/>

                <TextBlock Text="Nama kolom hasil 1" FontSize="12" FontWeight="Medium" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                <TextBox x:Name="TxtColA" Height="34" FontSize="12.5" VerticalContentAlignment="Center"
                         Background="#0C0C0E" Foreground="#E8E8E6" BorderBrush="#232326" BorderThickness="1" CornerRadius="6" Padding="10,0"/>

                <TextBlock Text="Nama kolom hasil 2" FontSize="12" FontWeight="Medium" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                <TextBox x:Name="TxtColB" Height="34" FontSize="12.5" VerticalContentAlignment="Center"
                         Background="#0C0C0E" Foreground="#E8E8E6" BorderBrush="#232326" BorderThickness="1" CornerRadius="6" Padding="10,0"/>

                <CheckBox x:Name="ChkDeleteSource" Content="Hapus kolom sumber setelah dipisah" FontSize="12" Foreground="#71717A" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
                <Button Classes="Muted" Content="Batal" MinWidth="90" Click="OnCancelClick"/>
                <Button Classes="Action" Content="Pisah Kolom" MinWidth="130" Background="#EDEDED" Foreground="#111111" Click="OnOkClick"/>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
    </Border>
</local:MantraDialogBase>
