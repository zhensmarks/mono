<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BMachine.UI.Views.Dialogs.MantraData.CustomMergeWindow"
        Title="Gabung Kolom"
        Width="520" Height="520"
        MinWidth="480" MinHeight="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#09090B"
        Foreground="#E8E8E6"
        FontFamily="'Segoe UI Variable', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif">

    <Window.Styles>
        <Style Selector="Button.Action">
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#EDEDED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Action /template/ ContentPresenter">
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="TextElement.Foreground" Value="#111111"/>
        </Style>
        <Style Selector="Button.Action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="TextElement.Foreground" Value="#111111"/>
        </Style>

        <Style Selector="Button.Muted">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Muted /template/ ContentPresenter">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="TextElement.Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.Muted:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#27272B"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Styles>

    <Border Margin="16" Padding="20" Background="#111113" BorderBrush="#232326" BorderThickness="1" CornerRadius="10">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Gabung Kolom" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5"/>
                <TextBlock Text="Pilih kolom dan format gabungan data secara instan." FontSize="12" Foreground="#71717A" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <!-- 1. Kolom Terpilih -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Kolom yang digabung:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                        <Border Background="#0C0C0E" BorderBrush="#232326" BorderThickness="1" CornerRadius="6" Padding="8,6">
                            <WrapPanel x:Name="PanelSelectedColumns" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- 2. Pilihan Format -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Pilihan Format:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="RbSpace" Content="Spasi (A B)" Margin="0,0,6,8"
                                         IsCheckedChanged="OnPresetChanged" IsChecked="True" Foreground="#EDEDED" FontSize="12"/>
                            <RadioButton x:Name="RbBracket" Content="Kurung A (B)" Margin="0,0,6,8"
                                         IsCheckedChanged="OnPresetChanged" Foreground="#EDEDED" FontSize="12"/>
                            <RadioButton x:Name="RbComma" Content="Koma (A, B)" Margin="0,0,0,8"
                                         IsCheckedChanged="OnPresetChanged" Foreground="#EDEDED" FontSize="12"/>
                            <RadioButton x:Name="RbPipe" Content="Pipa (A | B)" Margin="0,0,6,0"
                                         IsCheckedChanged="OnPresetChanged" Foreground="#EDEDED" FontSize="12"/>
                            <RadioButton x:Name="RbNewline" Content="Baris Baru" Margin="0,0,6,0"
                                         IsCheckedChanged="OnPresetChanged" Foreground="#EDEDED" FontSize="12"/>
                            <RadioButton x:Name="RbCustom" Content="Custom..." Margin="0,0,0,0"
                                         IsCheckedChanged="OnPresetChanged" Foreground="#EDEDED" FontSize="12"/>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Custom Separator box -->
                    <Grid x:Name="PanelCustomSep" ColumnDefinitions="Auto, *" IsVisible="False" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0" Text="Karakter Pemisah:" FontSize="12" VerticalAlignment="Center" Foreground="#71717A" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtCustomSep" Grid.Column="1" Height="32" FontSize="12" VerticalContentAlignment="Center"
                                 TextChanged="OnCustomSepChanged" Background="#0C0C0E" Foreground="#EDEDED" BorderBrush="#232326"
                                 CornerRadius="6" Padding="10,0"/>
                    </Grid>

                    <!-- 3. Nama Kolom Hasil -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Nama Kolom Hasil:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                        <TextBox x:Name="TxtNewColName" Height="34" FontSize="12.5" VerticalContentAlignment="Center"
                                 Background="#0C0C0E" Foreground="#EDEDED" BorderBrush="#232326" CornerRadius="6" Padding="10,0"/>
                    </StackPanel>

                    <!-- 4. Pratinjau Baris 1 -->
                    <Border Background="#0C0C0E" BorderBrush="#232326" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Hasil Baris 1:" FontSize="12" Foreground="#71717A"/>
                            <TextBlock x:Name="TxtPreview" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- 5. Opsi Hapus Kolom Asal -->
                    <CheckBox x:Name="ChkDeleteSource" Content="Hapus kolom asal setelah digabung"
                              IsChecked="True" FontSize="12" Foreground="#A1A1AA"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
                <Button Classes="Muted" Content="Batal" MinWidth="90" Click="OnCancelClick"/>
                <Button Classes="Action" Content="Gabung Sekarang" MinWidth="150" Click="OnMergeClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
