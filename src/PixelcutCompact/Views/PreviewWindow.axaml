<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:PixelcutCompact.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="PixelcutCompact.Views.PreviewWindow"
        Title="Preview"
        WindowStartupLocation="CenterOwner"
        Width="1020" Height="680"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        Focusable="True"
        KeyDown="OnPreviewKeyDown">
        
    <Window.Styles>
        <Style Selector="Border.shimmer">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="Opacity" Value="0.1"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:0.75">
                        <Setter Property="Opacity" Value="0.5"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:1.5">
                        <Setter Property="Opacity" Value="0.1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Header (Draggable) -->
            <Grid Grid.Row="0" Background="Transparent" ColumnDefinitions="*, Auto" MinHeight="45" PointerPressed="OnHeaderPointerPressed">
                  <!-- Left: Title & Icon -->
                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="15,0,0,0">
                      <Grid Width="14" Height="14" VerticalAlignment="Center">
                          <PathIcon x:Name="ImgHeaderIcon" Data="M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5M3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3H5A2,2 0 0,0 3,5M5,5H19V19H5V5Z" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                          <!-- Premium Spinner: Circular track and dynamic spinning arc with rounded caps -->
                          <Grid x:Name="ImgLoadingIcon" Classes="spinning" Width="14" Height="14" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                              <!-- Background track -->
                              <Ellipse Width="12" Height="12" Stroke="#20FFFFFF" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                              <!-- Glowing spinning indicator -->
                              <Path Data="M 11,6 A 5,5 0 1,1 6,1" 
                                    Stroke="{DynamicResource AccentBlueBrush}" 
                                    StrokeThickness="1.5" 
                                    StrokeLineCap="Round" 
                                    Width="12" Height="12"
                                    Stretch="Fill"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                          </Grid>
                      </Grid>
                      <TextBlock x:Name="TxtTitle" Text="Preview Sebelum/Sesudah" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>

                  <!-- Right: Buttons -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <!-- Settings Button with Flyout -->
                      <Button VerticalAlignment="Center" Width="45" Height="45" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="Settings Shortcuts">
                          <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.47,2.42C14.43,2.18 14.23,2 14,2H10C9.77,2 9.57,2.18 9.53,2.42L9.13,5.07C8.52,5.32 7.96,5.65 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.53,21.58C9.57,21.82 9.77,22 10,22H14C14.23,22 14.43,21.82 14.47,21.58L14.87,18.93C15.48,18.68 16.04,18.35 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z" Width="16" Height="16"/>
                          <Button.Flyout>
                              <Flyout Placement="BottomEdgeAlignedRight" Opened="OnSettingsFlyoutOpened">
                                  <Border Background="#1C1C1F" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="12" Padding="15" Width="280">
                                      <StackPanel Spacing="12">
                                          <!-- Title -->
                                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,5">
                                              <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.47,2.42C14.43,2.18 14.23,2 14,2H10C9.77,2 9.57,2.18 9.53,2.42L9.13,5.07C8.52,5.32 7.96,5.65 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.53,21.58C9.57,21.82 9.77,22 10,22H14C14.23,22 14.43,21.82 14.47,21.58L14.87,18.93C15.48,18.68 16.04,18.35 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z" Width="14" Height="14" Foreground="{DynamicResource AccentBlueBrush}"/>
                                              <TextBlock Text="Shortcuts Settings" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                          </StackPanel>
                                          
                                          <!-- Separator -->
                                          <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,5"/>
                                          
                                          <!-- Next Image -->
                                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                              <TextBlock Text="Next Image" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                              <TextBox x:Name="TxtNextShortcut" Grid.Column="1" Width="110" TextAlignment="Center" 
                                                       IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" 
                                                       Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="6" 
                                                       Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                                       Cursor="Hand" ToolTip.Tip="Klik lalu tekan tombol" Watermark="Press key..."/>
                                          </Grid>
                                          
                                          <!-- Prev Image -->
                                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                              <TextBlock Text="Prev Image" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                              <TextBox x:Name="TxtPrevShortcut" Grid.Column="1" Width="110" TextAlignment="Center" 
                                                       IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" 
                                                       Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="6" 
                                                       Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                                       Cursor="Hand" ToolTip.Tip="Klik lalu tekan tombol" Watermark="Press key..."/>
                                          </Grid>
                                          
                                          <!-- Photoshop -->
                                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                              <TextBlock Text="Open Photoshop" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                              <TextBox x:Name="TxtPhotoshopShortcut" Grid.Column="1" Width="110" TextAlignment="Center" 
                                                       IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" 
                                                       Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="6" 
                                                       Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                                       Cursor="Hand" ToolTip.Tip="Klik lalu tekan tombol" Watermark="Press key..."/>
                                          </Grid>

                                          <!-- Rotate Image -->
                                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                              <TextBlock Text="Rotate Image" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                              <TextBox x:Name="TxtRotateShortcut" Grid.Column="1" Width="110" TextAlignment="Center" 
                                                       IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" 
                                                       Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="6" 
                                                       Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                                       Cursor="Hand" ToolTip.Tip="Klik lalu tekan tombol" Watermark="Press key..."/>
                                          </Grid>

                                          <!-- Fit Screen -->
                                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                              <TextBlock Text="Fit Screen" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                              <TextBox x:Name="TxtFitScreenShortcut" Grid.Column="1" Width="110" TextAlignment="Center" 
                                                       IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" 
                                                       Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="6" 
                                                       Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                                       Cursor="Hand" ToolTip.Tip="Klik lalu tekan tombol" Watermark="Press key..."/>
                                          </Grid>
                                          
                                          <!-- Separator -->
                                          <Border Height="1" Background="#22FFFFFF" Margin="0,5"/>
                                          
                                          <!-- Background Type -->
                                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                              <TextBlock Text="Background" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                              <ComboBox x:Name="CboBgType" Grid.Column="1" Width="110" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="6" SelectionChanged="OnBgTypeChanged" Foreground="White">
                                                  <ComboBoxItem Content="Default"/>
                                                  <ComboBoxItem Content="Checkerboard"/>
                                                  <ComboBoxItem Content="Solid Color"/>
                                              </ComboBox>
                                          </Grid>
                                          
                                          <!-- Solid Color Picker: Preset Swatches -->
                                          <StackPanel x:Name="PanelSolidColor" Margin="0,4" IsVisible="False" Spacing="6">
                                              <TextBlock Text="Warna Latar" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                              <!-- Row 1 -->
                                              <WrapPanel Orientation="Horizontal" ItemWidth="24" ItemHeight="24">
                                                  <!-- White -->
                                                  <Button x:Name="SwColor_FFFFFF" Width="22" Height="22" Margin="1" Padding="0" Background="#FFFFFF" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Putih (#FFFFFF)"/>
                                                  <!-- Light Gray -->
                                                  <Button x:Name="SwColor_D1D5DB" Width="22" Height="22" Margin="1" Padding="0" Background="#D1D5DB" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Abu Muda (#D1D5DB)"/>
                                                  <!-- Gray -->
                                                  <Button x:Name="SwColor_6B7280" Width="22" Height="22" Margin="1" Padding="0" Background="#6B7280" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Abu (#6B7280)"/>
                                                  <!-- Dark Gray -->
                                                  <Button x:Name="SwColor_1F2937" Width="22" Height="22" Margin="1" Padding="0" Background="#1F2937" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Abu Gelap (#1F2937)"/>
                                                  <!-- Black -->
                                                  <Button x:Name="SwColor_000000" Width="22" Height="22" Margin="1" Padding="0" Background="#000000" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Hitam (#000000)"/>
                                                  <!-- Red -->
                                                  <Button x:Name="SwColor_EF4444" Width="22" Height="22" Margin="1" Padding="0" Background="#EF4444" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Merah (#EF4444)"/>
                                                  <!-- Orange -->
                                                  <Button x:Name="SwColor_F97316" Width="22" Height="22" Margin="1" Padding="0" Background="#F97316" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Oranye (#F97316)"/>
                                                  <!-- Yellow -->
                                                  <Button x:Name="SwColor_EAB308" Width="22" Height="22" Margin="1" Padding="0" Background="#EAB308" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Kuning (#EAB308)"/>
                                                  <!-- Green -->
                                                  <Button x:Name="SwColor_22C55E" Width="22" Height="22" Margin="1" Padding="0" Background="#22C55E" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Hijau (#22C55E)"/>
                                                  <!-- Green Screen -->
                                                  <Button x:Name="SwColor_00FF00" Width="22" Height="22" Margin="1" Padding="0" Background="#00FF00" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Green Screen (#00FF00)"/>
                                                  <!-- Blue -->
                                                  <Button x:Name="SwColor_3B82F6" Width="22" Height="22" Margin="1" Padding="0" Background="#3B82F6" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Biru (#3B82F6)"/>
                                                  <!-- Purple -->
                                                  <Button x:Name="SwColor_8B5CF6" Width="22" Height="22" Margin="1" Padding="0" Background="#8B5CF6" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Ungu (#8B5CF6)"/>
                                              </WrapPanel>
                                              <!-- Active color preview + hex display -->
                                              <Grid ColumnDefinitions="Auto, *">
                                                  <Border x:Name="BrdCurrentColor" Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                  <TextBlock x:Name="TxtCurrentColorHex" Grid.Column="1" Text="#FFFFFF" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center" FontFamily="Consolas, Monospace"/>
                                              </Grid>
                                          </StackPanel>
                                          
                                          <!-- Checkerboard Color Swatches -->
                                          <StackPanel x:Name="PanelCheckerColor" Margin="0,4" IsVisible="False" Spacing="6">
                                              <TextBlock Text="Warna Kotak 1 (Terang)" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                              <WrapPanel Orientation="Horizontal" ItemWidth="24" ItemHeight="24">
                                                  <Button x:Name="CkColor1_FFFFFF" Width="22" Height="22" Margin="1" Padding="0" Background="#FFFFFF" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="Putih"/>
                                                  <Button x:Name="CkColor1_CCCCCC" Width="22" Height="22" Margin="1" Padding="0" Background="#CCCCCC" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="Abu Sangat Muda"/>
                                                  <Button x:Name="CkColor1_999999" Width="22" Height="22" Margin="1" Padding="0" Background="#999999" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="Abu Muda"/>
                                                  <Button x:Name="CkColor1_666666" Width="22" Height="22" Margin="1" Padding="0" Background="#666666" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="Abu"/>
                                                  <Button x:Name="CkColor1_4D4D4D" Width="22" Height="22" Margin="1" Padding="0" Background="#4D4D4D" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="Abu Tua"/>
                                              </WrapPanel>
                                              <TextBlock Text="Warna Kotak 2 (Gelap)" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                              <WrapPanel Orientation="Horizontal" ItemWidth="24" ItemHeight="24">
                                                  <Button x:Name="CkColor2_AAAAAA" Width="22" Height="22" Margin="1" Padding="0" Background="#AAAAAA" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="Abu Sedang"/>
                                                  <Button x:Name="CkColor2_555555" Width="22" Height="22" Margin="1" Padding="0" Background="#555555" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="Abu Gelap"/>
                                                  <Button x:Name="CkColor2_333333" Width="22" Height="22" Margin="1" Padding="0" Background="#333333" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="Hampir Hitam"/>
                                                  <Button x:Name="CkColor2_1A1A1A" Width="22" Height="22" Margin="1" Padding="0" Background="#1A1A1A" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="Sangat Gelap"/>
                                                  <Button x:Name="CkColor2_000000" Width="22" Height="22" Margin="1" Padding="0" Background="#000000" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="Hitam"/>
                                              </WrapPanel>
                                              <!-- Preview kedua kotak -->
                                              <Grid ColumnDefinitions="Auto,Auto,*">
                                                  <Border x:Name="BrdChecker1Preview" Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#333333" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                  <Border x:Name="BrdChecker2Preview" Grid.Column="1" Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#4D4D4D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                  <TextBlock x:Name="TxtCheckerHex" Grid.Column="2" Text="#333333 / #4D4D4D" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center" FontFamily="Consolas, Monospace"/>
                                              </Grid>
                                          </StackPanel>
                                          
                                          <!-- Save Button -->
                                          <Button Content="Save Configuration" Click="OnSaveSettingsClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0" Padding="15,8" Background="{DynamicResource AccentBlueBrush}" Foreground="White" FontWeight="SemiBold" CornerRadius="8" Cursor="Hand"/>
                                      </StackPanel>
                                  </Border>
                              </Flyout>
                          </Button.Flyout>
                      </Button>
                      
                      <!-- Close Button -->
                      <Button Click="OnCloseClick" VerticalAlignment="Center" Content="✕" Width="45" Height="45" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                  </StackPanel>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1">
                <!-- STATE 1: Normal Preview (Side-by-Side) -->
                <Grid x:Name="PanelNormalPreview" ColumnDefinitions="*, 2, *" Margin="10,0,10,10">
                    <!-- Original -->
                    <Grid Grid.Column="0" RowDefinitions="*, Auto">
                        <Border x:Name="BrdOriginal" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Background="#0DFFFFFF" CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <Image Name="ImgOriginal" Stretch="Uniform" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       PointerPressed="OnImagePointerPressed" PointerMoved="OnImagePointerMoved" 
                                       PointerReleased="OnImagePointerReleased" PointerWheelChanged="OnImagePointerWheelChanged">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                            <TranslateTransform X="0" Y="0" />
                                            <RotateTransform Angle="{Binding $parent[views:PreviewWindow].RotationOriginal}" />
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                                <!-- Rotate Button Overlay -->
                                <Button Click="OnRotateOriginalClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" 
                                        Background="#80000000" CornerRadius="6" Padding="6" BorderThickness="0" ToolTip.Tip="Rotate Original" IsVisible="False">
                                    <PathIcon Data="M12,4C14.2,4 16.2,4.8 17.6,6.3C20.7,9.4 20.7,14.5 17.6,17.6C15.8,19.5 13.3,20.2 11,19.9V21.9C13.9,22.2 16.9,21.2 19.1,19C23,15.1 23,8.9 19,5C17.1,3.1 14.5,2.1 12,2V0L7,4L12,8V4Z" 
                                              Width="14" Height="14" Foreground="White">
                                          <PathIcon.RenderTransform>
                                              <RotateTransform Angle="90"/>
                                          </PathIcon.RenderTransform>
                                    </PathIcon>
                                </Button>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1" Text="Original" HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>

                    <!-- Separator -->
                    <GridSplitter Grid.Column="1" Width="2" Background="#40808080" ResizeBehavior="PreviousAndNext"/>

                    <!-- Result -->
                    <Grid Grid.Column="2" RowDefinitions="*, Auto">
                        <Border x:Name="BrdResult" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Background="#0DFFFFFF" CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <Image Name="ImgResult" Stretch="Uniform" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       PointerPressed="OnImagePointerPressed" PointerMoved="OnImagePointerMoved" 
                                       PointerReleased="OnImagePointerReleased" PointerWheelChanged="OnImagePointerWheelChanged">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                            <TranslateTransform X="0" Y="0" />
                                            <RotateTransform Angle="{Binding $parent[views:PreviewWindow].RotationResult}" />
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                                <!-- Rotate Button Overlay -->
                                <Button Click="OnRotateResultClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" 
                                        Background="#80000000" CornerRadius="6" Padding="6" BorderThickness="0" ToolTip.Tip="Rotate Result" IsVisible="False">
                                    <PathIcon Data="M12,4C14.2,4 16.2,4.8 17.6,6.3C20.7,9.4 20.7,14.5 17.6,17.6C15.8,19.5 13.3,20.2 11,19.9V21.9C13.9,22.2 16.9,21.2 19.1,19C23,15.1 23,8.9 19,5C17.1,3.1 14.5,2.1 12,2V0L7,4L12,8V4Z" 
                                              Width="14" Height="14" Foreground="White">
                                          <PathIcon.RenderTransform>
                                              <RotateTransform Angle="90"/>
                                          </PathIcon.RenderTransform>
                                    </PathIcon>
                                </Button>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1" Text="Result" HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                </Grid>

                <!-- Ghost Loading Overlay -->
                <Grid x:Name="OverlayLoading" ColumnDefinitions="*, 2, *" Margin="10,0,10,10" IsVisible="False">
                    <!-- Left Skeleton -->
                    <Border Grid.Column="0" Classes="shimmer" Background="#15FFFFFF" CornerRadius="8" ClipToBounds="True">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                            <PathIcon Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M5,19V5H19V19H5M6,17H18L14.25,12L11.25,16L9,13L6,17Z" Width="48" Height="48" Foreground="#20FFFFFF"/>
                        </StackPanel>
                    </Border>
                    <!-- Right Skeleton -->
                    <Border Grid.Column="2" Classes="shimmer" Background="#15FFFFFF" CornerRadius="8" ClipToBounds="True">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                            <PathIcon Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M5,19V5H19V19H5M6,17H18L14.25,12L11.25,16L9,13L6,17Z" Width="48" Height="48" Foreground="#20FFFFFF"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer (Action Buttons) -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Background="#0AFFFFFF" Padding="15,10" MinHeight="55">
                 <Grid>
                     <!-- Center: Navigation Buttons & Photoshop & Toast -->
                     <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                          <!-- Navigation and Actions -->
                          <StackPanel x:Name="PanelNavigation" Orientation="Horizontal" Spacing="20" IsVisible="True">
                              <Button Click="OnPreviousClick" Width="36" Height="36" CornerRadius="8" Background="#15FFFFFF" BorderThickness="1" BorderBrush="#30FFFFFF" ToolTip.Tip="Sebelumnya">
                                  <PathIcon Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                              </Button>
                              
                              <Button IsVisible="True" Click="OnPhotoshopClick" Padding="20,8" Background="#206366F1" BorderBrush="#806366F1" BorderThickness="1" CornerRadius="8" ToolTip.Tip="Buka di Photoshop untuk mengedit">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                      <PathIcon Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V5H19V19M11,14.5V11.5H13C14.1,11.5 15,12.4 15,13.5C15,14.6 14.1,15.5 13,15.5H11M11,10H13C14.93,10 16.5,11.57 16.5,13.5C16.5,15.43 14.93,17 13,17H9.5V7H11V10Z" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                                      <TextBlock Text="PHOTOSHOP" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                  </StackPanel>
                              </Button>
                              
                              <Button Click="OnNextClick" Width="36" Height="36" CornerRadius="8" Background="#15FFFFFF" BorderThickness="1" BorderBrush="#30FFFFFF" ToolTip.Tip="Berikutnya">
                                  <PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                              </Button>
                          </StackPanel>
                          
                          <!-- Save Toast Notification -->
                          <Border x:Name="ToastNotification" Background="#18A05A" CornerRadius="8" Padding="15,8" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#40FFFFFF" BorderThickness="1">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                  <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.58L21,7Z" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                                  <TextBlock Text="Perubahan berhasil disimpan" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                              </StackPanel>
                          </Border>
                     </Grid>
                 </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
