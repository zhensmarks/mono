<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PixelcutCompact.ViewModels"
        xmlns:models="using:PixelcutCompact.Models"
        xmlns:cv="clr-namespace:PixelcutCompact.Converters"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
        x:Class="PixelcutCompact.Views.GalleryWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Gallery — Pixa Compact"
        Width="960" Height="680"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        CanResize="True">

    <Window.Styles>
        <!-- Shimmer: ringan, hanya opacity pulse -->
        <Style Selector="Border.shimmer">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="Opacity" Value="0.15"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:0.8">
                        <Setter Property="Opacity" Value="0.45"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:1.6">
                        <Setter Property="Opacity" Value="0.15"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ListBoxItem Tile: NO scale transform, hanya brush transition -->
        <Style Selector="ListBoxItem" x:DataType="vm:GalleryItemViewModel">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="IsHitTestVisible" Value="{Binding IsSource}"/>
            <Setter Property="Focusable" Value="{Binding IsSource}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A5B8EF8"/>
            <Setter Property="BorderBrush" Value="#5B8EF8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#255B8EF8"/>
            <Setter Property="BorderBrush" Value="#809AB5F8"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" Margin="12,10"/>
                </ItemsPanelTemplate>
            </Setter>
        </Style>

        <!-- Footer buttons -->
        <Style Selector="Button.footer-btn">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.footer-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="Button.footer-btn-accent">
            <Setter Property="Background" Value="#1A5B8EF8"/>
            <Setter Property="BorderBrush" Value="#605B8EF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.footer-btn-accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#255B8EF8"/>
            <Setter Property="BorderBrush" Value="#905B8EF8"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="0"
            BorderBrush="#22000000" BorderThickness="1"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto, *, Auto">

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Padding="16,0,6,0"
                    Background="#08FFFFFF"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    PointerPressed="OnHeaderPointerPressed"
                    MinHeight="48">
                <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <PathIcon Data="M2,2H11V11H2V2M2,13H11V22H2V13M13,2H22V11H13V2M13,13H22V22H13V13Z"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Gallery"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <Border Width="1" Height="14" Background="#25FFFFFF" VerticalAlignment="Center"/>

                        <!-- Total count chip -->
                        <Border Background="#12FFFFFF" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GalleryItems.Count, StringFormat='{}{0} item'}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>

                        <!-- IN badge -->
                        <Border Background="#18F97316" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="IN" FontSize="10" FontWeight="Bold" Foreground="#F97316" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Files.Count}" FontSize="11" FontWeight="SemiBold" Foreground="#F97316" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- OUT badge -->
                        <Border Background="#185B8EF8" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="OUT" FontSize="10" FontWeight="Bold" Foreground="#5B8EF8" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Files.Count}" FontSize="11" FontWeight="SemiBold" Foreground="#5B8EF8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Column="2"
                            Click="OnCloseClick"
                            Width="40" Height="40"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Tutup Gallery">
                        <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#E81123"/>
                            </Style>
                            <Style Selector="Button:pointerover PathIcon">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>

            <!-- GALLERY GRID -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ListBox ItemsSource="{Binding GalleryItems}"
                         Background="Transparent"
                         SelectionMode="Multiple"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GalleryItemViewModel">
                            <!-- Tile Card -->
                            <Grid Width="154" Height="205"
                                  Background="Transparent"
                                  PointerPressed="OnPointerPressed"
                                  DoubleTapped="OnDoubleTapped"
                                  PointerEntered="OnTilePointerEntered"
                                  PointerExited="OnTilePointerExited">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Preview" Click="OnPreviewClick"/>
                                        <MenuItem Header="Buka Folder" Click="OnOpenFolderClick"/>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <Grid RowDefinitions="*, Auto">
                                    <!-- Image area -->
                                    <Border Grid.Row="0"
                                            CornerRadius="8"
                                            ClipToBounds="True"
                                            Background="#0DFFFFFF"
                                            BorderBrush="#12FFFFFF"
                                            BorderThickness="1">
                                        <Panel>
                                            <!-- Shimmer loading placeholder -->
                                            <Border Classes="shimmer"
                                                    Background="#1EFFFFFF"
                                                    CornerRadius="8"
                                                    IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                                <PathIcon Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M5,19V5H19V19H5M6,17H18L14.25,12L11.25,16L9,13L6,17Z"
                                                          Width="32" Height="32"
                                                          Foreground="#18FFFFFF"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>

                                            <!-- Thumbnail -->
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                            <!-- Hover overlay (opacity controlled from code-behind) -->
                                            <Border x:Name="TileHoverOverlay"
                                                    Background="#78000000"
                                                    CornerRadius="8"
                                                    Opacity="0"
                                                    IsHitTestVisible="False">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                                    </Transitions>
                                                </Border.Transitions>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                                    <PathIcon Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                                                              Width="22" Height="22" Foreground="#DDFFFFFF"
                                                              HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Preview" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="#DDFFFFFF" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Badge IN (IsSource=true, orange) -->
                                            <Border Margin="6,6,0,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    CornerRadius="4" Padding="5,2"
                                                    Background="#CDF97316"
                                                    IsVisible="{Binding IsSource}"
                                                    IsHitTestVisible="False">
                                                <TextBlock Text="IN" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>

                                            <!-- Badge OUT (IsSource=false, blue) -->
                                            <Border Margin="6,6,0,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    CornerRadius="4" Padding="5,2"
                                                    Background="#CD5B8EF8"
                                                    IsVisible="{Binding !IsSource}"
                                                    IsHitTestVisible="False">
                                                <TextBlock Text="OUT" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Panel>
                                    </Border>

                                    <!-- Filename -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding FileName}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="4,5,4,3"
                                               ToolTip.Tip="{Binding FilePath}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <!-- FOOTER -->
            <Border Grid.Row="2"
                    Padding="16,10"
                    Background="#06FFFFFF"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*, Auto">
                    <!-- Left: tip -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                                  Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Double-klik untuk preview · Klik kanan untuk opsi"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="footer-btn-accent"
                                Command="{Binding OpenSelectedInPhotoshopCommand}"
                                ToolTip.Tip="Buka file terpilih di Adobe Photoshop">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V5H19V19M11,14.5V11.5H13C14.1,11.5 15,12.4 15,13.5C15,14.6 14.1,15.5 13,15.5H11M11,10H13C14.93,10 16.5,11.57 16.5,13.5C16.5,15.43 14.93,17 13,17H9.5V7H11V10Z"
                                          Width="13" Height="13" Foreground="#90B4F9" VerticalAlignment="Center"/>
                                <TextBlock Text="PHOTOSHOP" Foreground="#90B4F9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
