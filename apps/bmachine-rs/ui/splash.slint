// Splash screen (Fase 5) — tiruan SplashWindow C# (Bootstrapper.cs & SplashViewModel.cs):
// Logo "B" (aksen, Black) + "MACHINE" (Light, letter-spacing 4) di bawah
// ikon layers 56px; VersionText = "VERSION 15.15.3" (SplashViewModel.cs:
// "VERSION " + Assembly Version ToString(3)); status default "Memuat...";
// progress bar 0-100 tinggi 3; terminal logs scrolling (maksimal 3 baris
// terakhir dengan prefix "> ").
// Tidak ada tombol navigasi / kembali (bukan layar navigasi).

import { Design, SvgIcon } from "design.slint";

export component SplashView inherits Rectangle {
    in property <int> progress: 0;
    in property <string> status: "Memuat...";
    in property <string> version-text: "VERSION 15.15.3";
    in property <string> log1: "";
    in property <string> log2: "";
    in property <string> log3: "";

    background: Design.app-bg;

    VerticalLayout {
        x: (parent.width - 420px) / 2;
        y: (parent.height - 300px) / 2;
        width: 420px;
        spacing: 0;

        // Ikon layers C# (SplashWindow.axaml: Viewbox 56x56, path
        // "M12 2L2 7l10 5 10-5-10-5z" + dua chevron) — SvgIcon "layers"
        // di design.slint memakai path yang sama.
        SvgIcon {
            name: "layers";
            size: 56px;
            icon-color: Design.accent;
            x: (parent.width - self.width) / 2;
        }

        Rectangle { height: 10px; }

        // Logo tipografi C#: "B" 22px Black aksen + "MACHINE" 22px Light.
        HorizontalLayout {
            alignment: center;
            spacing: 0;
            Text {
                text: "B";
                font-size: 22px;
                font-weight: 900;
                letter-spacing: 1px;
                color: Design.accent;
                height: 30px;
                vertical-alignment: center;
            }
            Text {
                text: "MACHINE";
                font-size: 22px;
                font-weight: 300;
                letter-spacing: 4px;
                color: Design.text-primary;
                height: 30px;
                vertical-alignment: center;
            }
        }

        Rectangle { height: 8px; }

        Text {
            text: root.version-text;
            font-size: 10px;
            font-weight: 600;
            font-family: "JetBrains Mono";
            letter-spacing: 2px;
            color: #52525B;
            height: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle { height: 6px; }

        Text {
            text: root.status;
            font-size: Design.font-body;
            color: Design.text-secondary;
            height: 20px;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            height: 30px;
            Rectangle {
                x: 0;
                y: 13px;
                width: 100%;
                height: 3px;
                background: Design.separator;
                border-radius: 2px;
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width * root.progress / 100;
                    height: 100%;
                    background: Design.accent;
                    border-radius: 2px;
                }
            }
        }

        Rectangle { height: 10px; }

        if root.log1 != "" : Text {
            text: root.log1;
            font-size: 11px;
            font-family: "JetBrains Mono";
            color: Design.text-muted;
            height: 18px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.log2 != "" : Text {
            text: root.log2;
            font-size: 11px;
            font-family: "JetBrains Mono";
            color: Design.text-muted;
            height: 18px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.log3 != "" : Text {
            text: root.log3;
            font-size: 11px;
            font-family: "JetBrains Mono";
            color: Design.text-muted;
            height: 18px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
