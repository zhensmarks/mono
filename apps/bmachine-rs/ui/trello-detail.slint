// ============================================================
// TrelloDetailPanel — panel detail kartu Trello, sama persis C#
// CardDetailPanelHost (BMachine.UI/Views/CardDetailPanelHost.xaml).
//
// Komponen mandiri: tampilan + logika + fungsi sendiri.
// - Kolom kanan 400px (clamp 320 saat sempit), ukuran C# tetap
//   (tanpa ui-scale): judul 24px Bold, chip 11px SemiBold,
//   badge meta 30px, tombol aksi 32px, deskripsi penuh
//   (C# max 240px + scroll — scroll ditambah di Fase 6).
// - Sub-panel menggantikan detail di kolom yang sama (bukan
//   overlay): Comments / Checklists / Move Card / Attachments.
// - Klik kanan detail = tutup; klik kanan sub-panel = kembali
//   ke detail; × detail = tutup; × sub-panel = kembali ke detail.
// - Fungsi (mockup, Fase 6 = API Trello asli): tambah komentar
//   (maks 3 per kartu), checklist dicentang, Move Card
//   (validasi board & list), Unlink kartu manual (nyata —
//   hapus dari daftar), ID badge → spreadsheet, copy-link &
//   open-in-browser.
// - Kategori POINTS menampilkan breakdown (Minggu/Bulan/Total),
//   bukan detail kartu Trello.
// - Catatan penyimpangan mockup: badge "Attachments: 0" selalu
//   tampil agar panel Attachments bisa dibuka (C# menyembunyikan
//   badge bila 0 — Fase 6: sembunyikan bila API mengembalikan 0).
// ============================================================

import { Design, Btn, IconBtn, TextField, HSeparator } from "design.slint";

// ============================================================
// Markdown — deskripsi & komentar ala Trello
// ============================================================
// Slint tidak punya rich text: Rust (src/markdown.rs) mem-parse
// Markdown jadi baris-baris `MdLine` (sudah di-wrap per lebar
// tampilan), .slint hanya merender segmen per baris. Parsing
// lewat `pure callback parse-md` supaya bisa dipanggil dari
// binding (callback biasa dianggap impure dan tidak boleh
// dipanggil di binding/`for`).
export struct MdLine {
    kind: string,      // para | h1 | h2 | h3 | li | quote | code | blank
    indent: int,       // tingkat list (0/1)
    marker: string,    // "•" | "1." | "" (baris lanjutan)
    text: string,      // blok kode: teks penuh multi-baris
    seg1-text: string, seg1-kind: string, seg1-url: string,
    seg2-text: string, seg2-kind: string, seg2-url: string,
    seg3-text: string, seg3-kind: string, seg3-url: string,
    seg4-text: string, seg4-kind: string, seg4-url: string,
    seg5-text: string, seg5-kind: string, seg5-url: string,
    seg6-text: string, seg6-kind: string, seg6-url: string,
    gap: length,       // ruang setelah baris ini
}

// Satu segmen inline dalam satu baris Markdown. Tinggi baris
// (lh) sama untuk semua segmen supaya baseline rata — code /
// mention dibungkus chip, link digarisbawahi + bisa diklik.
export component MdSeg inherits Rectangle {
    in property <string> text;
    in property <string> kind; // plain | bold | italic | bold-italic | code | link | mention
    in property <string> url;
    in property <length> font-size: 12px;
    in property <length> lh: 18px;
    in property <bool> heading: false;
    in property <color> text-color: Design.text-secondary;
    callback open-url(string);
    callback show-toast(string);

    height: root.lh;
    // Chip code/mention: teks + padding 5px kiri-kanan.
    width: (root.kind == "code" || root.kind == "mention") ? seg-text.preferred-width + 10px : seg-text.preferred-width;

    // Latar chip (code = permukaan + border, mention = tint aksen).
    if root.kind == "code" || root.kind == "mention" : Rectangle {
        width: 100%; height: root.lh - 4px; y: 2px;
        background: root.kind == "code" ? Design.surface-elevated : Design.accent.transparentize(0.85);
        border-width: root.kind == "code" ? 1px : 0px;
        border-color: Design.separator;
        border-radius: 4px;
    }
    seg-text := Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: root.kind == "bold" || root.kind == "bold-italic" || root.kind == "mention" || root.heading ? 700 : 400;
        font-italic: root.kind == "italic" || root.kind == "bold-italic";
        font-family: root.kind == "code" ? "JetBrains Mono" : Design.font-family;
        color: root.kind == "link" ? Design.accent : root.kind == "mention" ? Design.accent : root.kind == "code" ? Design.text-primary : root.text-color;
        width: 100%;
        height: 100%;
        horizontal-alignment: root.kind == "code" || root.kind == "mention" ? center : left;
        vertical-alignment: center;
    }
    // Garis bawah link.
    if root.kind == "link" : Rectangle {
        y: root.lh - 4px; width: 100%; height: 1px;
        background: Design.accent;
    }
    // Klik link (buka browser) / mention (toast — profil Trello
    // belum ada sampai Fase 6).
    if root.kind == "link" || root.kind == "mention" : TouchArea {
        width: 100%; height: 100%;
        mouse-cursor: pointer;
        clicked => {
            if (root.kind == "link") { root.open-url(root.url); }
            else { root.show-toast("Profil " + root.text + " belum tersedia (mockup — Fase 6)"); }
        }
    }
}

// Renderer Markdown: VerticalLayout berisi baris-baris MdLine.
// `width` HARUS definit dari pemakai (100% dari Flickable /
// kolom yang lebarnya sudah pasti) — baris di-wrap Rust per
// lebar ini, jadi lebar dari konten akan melingkar.
export component MarkdownView inherits VerticalLayout {
    in property <string> source;
    in property <length> font-size: 12px;
    pure callback parse-md(string, length) -> [MdLine];
    callback open-url(string);
    callback show-toast(string);

    spacing: 0;
    property <[MdLine]> lines: root.parse-md(root.source, root.width);
    for line in root.lines : Rectangle {
        width: 100%;
        // Tinggi: blank = spasi kecil; code = isi + padding;
        // lain = tinggi baris + gap.
        height: line.kind == "blank" ? 6px : line.kind == "code" ? code-text.preferred-height + 16px : line-lh + line.gap;
        property <length> line-lh: line.kind == "h1" ? root.font-size * 2.0 : line.kind == "h2" ? root.font-size * 1.75 : line.kind == "h3" ? root.font-size * 1.6 : root.font-size * 1.5;
        property <length> seg-font-size: line.kind == "h1" ? root.font-size * 1.33 : line.kind == "h2" ? root.font-size * 1.17 : line.kind == "h3" ? root.font-size * 1.08 : root.font-size;
        property <bool> is-heading: line.kind == "h1" || line.kind == "h2" || line.kind == "h3";
        property <color> seg-color: is-heading ? Design.text-primary : Design.text-secondary;

        // Elemen ukur blok kode — selalu ada (preferred-height
        // tetap terhitung), hanya terlihat untuk kind code.
        code-text := Text {
            text: line.text;
            font-family: "JetBrains Mono";
            font-size: root.font-size;
            color: Design.text-secondary;
            wrap: word-wrap;
            width: parent.width - 16px;
            visible: line.kind == "code";
        }
        // Blok kode: tint + border + radius, teks di dalam.
        if line.kind == "code" : Rectangle {
            width: 100%; height: 100%;
            background: Design.surface-elevated;
            border-width: 1px;
            border-color: Design.separator;
            border-radius: 6px;
            Text {
                x: 8px; y: 8px; width: parent.width - 16px;
                text: line.text;
                font-family: "JetBrains Mono";
                font-size: root.font-size;
                color: Design.text-secondary;
                wrap: word-wrap;
            }
        }
        // Bar quote di tepi kiri baris.
        if line.kind == "quote" : Rectangle {
            x: 0; y: 0; width: 3px; height: line-lh;
            background: Design.accent;
            border-radius: 2px;
        }
        // Baris isi: marker list + segmen-segmen.
        if line.kind != "code" && line.kind != "blank" : HorizontalLayout {
            // Quote: menjorok 11px (3px bar + 8px celah). List
            // lanjutan: +20px supaya teks rata di bawah teks
            // baris pertama (bukan di bawah marker).
            x: line.kind == "quote" ? 11px : line.indent * 18px + (line.kind == "li" && line.marker == "" ? 20px : 0px);
            y: 0;
            width: parent.width - self.x;
            height: line-lh;
            spacing: 0;
            if line.marker != "" : Text {
                text: line.marker;
                font-size: seg-font-size;
                font-weight: 700;
                color: Design.text-muted;
                width: 20px;
                height: 100%;
                vertical-alignment: center;
            }
            if line.seg1-text != "" : MdSeg { text: line.seg1-text; kind: line.seg1-kind; url: line.seg1-url; font-size: seg-font-size; lh: line-lh; heading: is-heading; text-color: seg-color; open-url(u) => { root.open-url(u); } show-toast(t) => { root.show-toast(t); } }
            if line.seg2-text != "" : MdSeg { text: line.seg2-text; kind: line.seg2-kind; url: line.seg2-url; font-size: seg-font-size; lh: line-lh; heading: is-heading; text-color: seg-color; open-url(u) => { root.open-url(u); } show-toast(t) => { root.show-toast(t); } }
            if line.seg3-text != "" : MdSeg { text: line.seg3-text; kind: line.seg3-kind; url: line.seg3-url; font-size: seg-font-size; lh: line-lh; heading: is-heading; text-color: seg-color; open-url(u) => { root.open-url(u); } show-toast(t) => { root.show-toast(t); } }
            if line.seg4-text != "" : MdSeg { text: line.seg4-text; kind: line.seg4-kind; url: line.seg4-url; font-size: seg-font-size; lh: line-lh; heading: is-heading; text-color: seg-color; open-url(u) => { root.open-url(u); } show-toast(t) => { root.show-toast(t); } }
            if line.seg5-text != "" : MdSeg { text: line.seg5-text; kind: line.seg5-kind; url: line.seg5-url; font-size: seg-font-size; lh: line-lh; heading: is-heading; text-color: seg-color; open-url(u) => { root.open-url(u); } show-toast(t) => { root.show-toast(t); } }
            if line.seg6-text != "" : MdSeg { text: line.seg6-text; kind: line.seg6-kind; url: line.seg6-url; font-size: seg-font-size; lh: line-lh; heading: is-heading; text-color: seg-color; open-url(u) => { root.open-url(u); } show-toast(t) => { root.show-toast(t); } }
        }
    }
}

// Toolbar editor Markdown — dipakai deskripsi + komentar.
// `insert` membawa kind ("bold" | "italic" | "bullet" |
// "numbered" | "link" | "code" | "mention"); Rust (md-insert)
// membungkus seleksi bila ada, else menyisipkan snippet.
export component MdToolbar inherits HorizontalLayout {
    callback insert(string);
    spacing: 4px;
    height: 24px;
    Btn { label: "B"; variant: "ghost"; small: true; height-override: 24px; clicked => { root.insert("bold"); } }
    Btn { label: "I"; variant: "ghost"; small: true; height-override: 24px; clicked => { root.insert("italic"); } }
    Btn { label: "•"; variant: "ghost"; small: true; height-override: 24px; clicked => { root.insert("bullet"); } }
    Btn { label: "1."; variant: "ghost"; small: true; height-override: 24px; clicked => { root.insert("numbered"); } }
    Btn { label: "Link"; variant: "ghost"; small: true; height-override: 24px; clicked => { root.insert("link"); } }
    Btn { label: "</>"; variant: "ghost"; small: true; height-override: 24px; clicked => { root.insert("code"); } }
    Btn { label: "@"; variant: "ghost"; small: true; height-override: 24px; clicked => { root.insert("mention"); } }
}

// Satu baris komentar: avatar bulat + nama + waktu + isi.
// Di-export supaya CommentWindow (ui/windows.slint) memakai
// komponen yang sama persis dengan panel Comments inline.
export component CommentRow inherits HorizontalLayout {
    in property <string> author;
    in property <string> time;
    in property <string> body;
    in property <string> initial;
    in property <color> avatar-bg: Design.accent;
    pure callback parse-md(string, length) -> [MdLine];
    callback open-url(string);
    callback show-toast(string);

    spacing: 8px;

    Rectangle {
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: root.avatar-bg;
        Text {
            text: root.initial;
            font-size: 12px;
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }
    VerticalLayout {
        // Lebar definit supaya MarkdownView bisa wrap per lebar
        // ini (avatar 28px + spacing 8px).
        width: root.width - 36px;
        spacing: 4px;
        HorizontalLayout {
            height: 16px;
            spacing: 8px;
            Text {
                text: root.author;
                font-size: 12px;
                font-weight: 700;
                color: Design.text-primary;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.time;
                font-size: 11px;
                color: Design.text-muted;
                vertical-alignment: center;
            }
        }
        // Isi komentar dirender sebagai Markdown.
        MarkdownView {
            width: 100%;
            source: root.body;
            font-size: 12px;
            parse-md(s, w) => { root.parse-md(s, w) }
            open-url(u) => { root.open-url(u); }
            show-toast(t) => { root.show-toast(t); }
        }
    }
}

export component TrelloDetailPanel inherits Rectangle {
    // --- Input dari AppWindow ---
    in property <string> card-title;
    in property <string> event-date;
    in property <string> display-id;
    // ID API Trello asli (`c.id` — dipakai PUT deskripsi + komentar
    // ke API; "" bila kartu manual / tanpa id). Diisi pemakai panel
    // dari list-card-ids / card-api-ids (trello2, item 3/4).
    in property <string> card-id: "";
    in property <string> due-text;
    in property <bool> is-manual;
    in property <string> manual-url;
    // Link web kartu dari API (`shortUrl`, via AppWindow.list-urls) —
    // dipakai sebagai `card-url` untuk kartu API; kosong bila server
    // tidak mengembalikannya (tombol buka-link disembunyikan).
    in property <string> card-url-override: "";
    in property <string> category-label;
    // Label Trello kartu (nama label dari API, maks 2) — chip atas
    // detail mengikuti ref trello-sidepanel-ref.jpg: chip-1 = label
    // pertama, chip-2 = label kedua (biasanya tanggal "**...**").
    // Kosong bila kartu tanpa label → fallback ke category-label /
    // event-date (perilaku lama).
    in property <string> label-1: "";
    in property <string> label-2: "";
    // Jumlah lampiran dari badges.attachments API (bukan hardcode 0).
    in property <int> attachments-count: 0;
    in property <color> accent;
    in property <bool> done;
    in property <string> description;
    in property <length> panel-margin: 20px;
    in property <length> title-size: 24px;
    in property <color> panel-bg: Design.app-bg;
    // Nama user aktif (untuk author komentar baru + label checklist)
    // — diisi AppWindow.app-user-name; default "USER" bila belum ada.
    in property <string> user-name: "USER";
    // Inisial avatar author (1 huruf kapital, dari AppWindow).
    in property <string> user-initial: "U";
    // Sub-panel aktif: "" (detail) / comments / checklist / move / attachments.
    in-out property <string> sub-panel: "";
    // Jumlah komentar tambahan (dari AppWindow, direset saat ganti kartu).
    in-out property <int> added-count: 0;

    callback close();
    callback unlink();
    callback show-toast(string);
    callback send-comment();
    callback open-url(string);
    // Buka komentar kartu di CommentWindow (window OS terpisah) —
    // segmen panah split button; di-host oleh AppWindow /
    // CardListWindow (lihat ui/main.slint + ui/windows.slint).
    callback open-comment-window();
    // Markdown (deskripsi & komentar): parsing di Rust via
    // `pure callback parse-md`; toolbar editor via `md-insert`
    // (Rust membungkus seleksi / menyisipkan snippet); simpan
    // deskripsi ke Rust via `save-description` (Rust menulis ke
    // `edited_descs` + update model supaya langsung ter-render).
    pure callback parse-md(string, length) -> [MdLine];
    callback md-insert(string, string, int, int) -> string;
    callback save-description(string);

    property <string> comment-draft: "";
    // Mode edit deskripsi (tombol "Edit" di samping label
    // Description) + draft-nya. Sembunyi bila kartu manual
    // (deskripsi kartu manual = URL, tidak bisa diedit).
    property <bool> desc-editing: false;
    property <string> desc-draft: "";
    // Draft komentar tambahan (in-out supaya Rust bisa membaca /
    // menulisnya saat CommentWindow dibuka/ditutup — sinkronisasi
    // bolak-balik dengan window komentar; rendering + penulisan
    // slot digate `added-count`, jadi draft basi dari kartu
    // sebelumnya tidak pernah bocor ke kartu lain).
    in-out property <string> draft-1: "";
    in-out property <string> draft-2: "";
    in-out property <string> draft-3: "";
    property <bool> show-activity: true;
    property <string> move-board: "";
    property <string> move-list: "";
    property <bool> is-narrow: root.width < 360px;
    property <bool> is-points: root.category-label == "POINTS";
    property <string> progress-text: root.done ? "3/3" : "1/3";
    property <string> card-url: root.is-manual ? root.manual-url : root.card-url-override;
    // Teks chip atas: label kartu bila ada, fallback kategori/tanggal.
    property <string> chip-1: root.label-1 != "" ? root.label-1 : root.category-label;
    property <string> chip-2: root.label-2 != "" ? root.label-2 : root.event-date;

    send-comment => {
        if (root.comment-draft == "") {
            root.show-toast("Tulis komentar dulu");
        } else if (root.added-count == 0) {
            root.draft-1 = root.comment-draft;
            root.added-count = 1;
            root.comment-draft = "";
        } else if (root.added-count == 1) {
            root.draft-2 = root.comment-draft;
            root.added-count = 2;
            root.comment-draft = "";
        } else if (root.added-count == 2) {
            root.draft-3 = root.comment-draft;
            root.added-count = 3;
            root.comment-draft = "";
        } else {
            root.show-toast("Maks 3 komentar tambahan (mockup)");
        }
    }

    background: root.panel-bg;
    clip: true;

    // Klik kanan latar detail = tutup (hanya saat di tampilan detail).
    detail-back-touch := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right && root.sub-panel == "") {
                root.close();
            }
        }
    }

    // ================= TAMPILAN DETAIL (kartu Trello) =================
    // Detail SELURUHNYA bisa di-scroll (Flickable luar) bila isinya
    // lebih tinggi dari panel — judul 2–3 baris + deskripsi panjang
    // dari API Trello (polish abeng 28 Nov 10:16: sebelumnya isi
    // terpotong di tepi bawah panel tanpa bisa dibaca sisanya).
    // Deskripsi sendiri tetap punya scroll-nya (maks 240px, ala C#),
    // jadi roda mouse di area deskripsi menggulung deskripsi dulu.
    // Catatan hit-test: layout setinggi panel (height: 100%) sempat
    // dilepas lalu dipasang lagi saat memburu tombol yang "tidak bisa
    // diklik" — keduanya ternyata BUKAN karena height ini (tombol =
    // salah koordinat klik y). Jangan jadikan height kambing hitam
    // bila ada masalah hit-test lagi — ukur dulu posisi render
    // tombolnya sebelum menyalahkan layout.
    card-view := Flickable {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.sub-panel == "" && !root.is-points;
        viewport-height: card-content.preferred-height;
        card-content := VerticalLayout {
            x: 0; y: 0; width: 100%;
            padding: root.panel-margin;
            spacing: 12px;

        // Baris chip: label-1 + label-2 (11px SemiBold) + tombol X
        // tutup di kanan atas (ref trello-sidepanel-ref.jpg: X
        // sejajar baris chip, judul di bawahnya).
        HorizontalLayout {
            height: 26px;
            spacing: 8px;
            Rectangle {
                width: cover-text.preferred-width + 20px;
                background: Design.card-bg;
                border-color: Design.separator;
                border-width: 1px;
                border-radius: 6px;
                cover-text := Text {
                    text: root.chip-1;
                    font-size: 11px;
                    font-weight: 600;
                    color: Design.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
            Rectangle {
                width: date-text.preferred-width + 20px;
                background: Design.card-bg;
                border-color: Design.separator;
                border-width: 1px;
                border-radius: 6px;
                date-text := Text {
                    text: root.chip-2;
                    font-size: 11px;
                    font-weight: 600;
                    color: Design.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            IconBtn {
                glyph: "×";
                variant: "ghost";
                size: 26px;
                clicked => { root.close(); }
            }
        }

        // Judul (× sudah pindah ke baris chip, sejajar ref).
        Text {
            text: root.card-title;
            font-size: root.title-size;
            font-weight: 700;
            color: Design.text-primary;
            wrap: word-wrap;
            // Lebar EKSPLISIT (bukan horizontal-stretch): Slint
            // menghitung preferred-height Text pembungkus SEBELUM
            // lebar dari layout ditetapkan, sehingga untuk judul
            // PENDEK tingginya mengembang (seolah membungkus pada
            // lebar ~0) dan mengacaukan hit-test tombol di bawahnya
            // (baris aksi tidak bisa diklik — hanya kartu berjudul
            // pendek: TK ASSALAM, kartu manual, REVISI). Judul
            // panjang "kebetulan" jalan karena membungkus ke 2
            // baris. Lebar eksplisit = lebar isi; sama persis dengan
            // yang diberikan stretch, tapi diketahui SEBELUM layout.
            width: root.width - 2 * root.panel-margin;
            vertical-alignment: top;
        }

        // Meta baris 1: ID + Attachments (jumlah nyata dari API) +
        // tombol salin-link + buka-di-browser (ref: sebaris dengan ID).
        // Chip Due tidak ada lagi — tanggal sudah jadi chip atas.
        HorizontalLayout {
            height: 30px;
            spacing: 8px;
            if root.display-id != "" : Rectangle {
                width: id-text.preferred-width + 20px;
                background: Design.card-bg;
                border-color: Design.separator;
                border-width: 1px;
                border-radius: 6px;
                id-text := Text {
                    text: "ID: " + root.display-id;
                    font-size: 11px;
                    font-weight: 600;
                    color: Design.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
                id-touch := TouchArea {
                    width: 100%; height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.show-toast("Buka spreadsheet untuk ID " + root.display-id + " (mockup — Fase 6)"); }
                }
            }
            Rectangle {
                width: att-text.preferred-width + 20px;
                background: Design.card-bg;
                border-color: Design.separator;
                border-width: 1px;
                border-radius: 6px;
                att-text := Text {
                    text: "Attachments: " + root.attachments-count;
                    font-size: 11px;
                    font-weight: 600;
                    color: Design.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
                att-touch := TouchArea {
                    width: 100%; height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.sub-panel = "attachments"; }
                }
            }
            if root.card-url != "" : HorizontalLayout {
                spacing: 8px;
                IconBtn {
                    glyph: "⎘";
                    variant: "ghost";
                    size: 30px;
                    clicked => { root.show-toast("Link kartu: " + root.card-url); }
                }
                IconBtn {
                    glyph: "↗";
                    variant: "ghost";
                    size: 30px;
                    clicked => { root.open-url(root.card-url); }
                }
            }
        }

        // Chip label lagi di bawah meta (ref: "JAKSEL 2 (ASRIL)"
        // muncul kedua kalinya di bawah baris ID). Hanya bila kartu
        // punya label nyata (bukan fallback kategori).
        if root.label-1 != "" : Rectangle {
            height: 26px;
            width: label2-text.preferred-width + 20px;
            background: Design.card-bg;
            border-color: Design.separator;
            border-width: 1px;
            border-radius: 6px;
            label2-text := Text {
                text: root.label-1;
                font-size: 11px;
                font-weight: 600;
                color: Design.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        HSeparator { }

        // Baris aksi 32px: Comment (split button C#) + Checklist +
        // Move/Unlink. Split button = SATU border luar (bg + border
        // secondary, radius-sm): segmen kiri "Comment" → buka panel
        // Comments INLINE di panel samping; segmen kanan segitiga
        // solid 9×10 (lebar 16px, dipisah garis 1px) → buka
        // CommentWindow (window OS terpisah). Sempat digabung jadi
        // satu tombol "Comment ▸" (4e23d96) — dipisah lagi persis C#
        // CardDetailPanelHost + koreksi abeng 28 Nov 09:42.
        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            Rectangle {
                height: 32px;
                background: Design.btn-secondary-bg;
                border-width: 1px;
                border-color: Design.btn-secondary-border;
                border-radius: Design.radius-sm;
                clip: true;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 0;
                    comment-seg := Rectangle {
                        width: comment-label.preferred-width + 24px;
                        height: 100%;
                        background: comment-seg-touch.has-hover ? Design.btn-secondary-bg-hover : transparent;
                        comment-seg-touch := TouchArea {
                            width: 100%; height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.sub-panel = "comments"; }
                        }
                        comment-label := Text {
                            text: "Comment";
                            font-size: 12px;
                            font-weight: 600;
                            color: Design.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                    Rectangle {
                        width: 1px;
                        height: 100%;
                        background: Design.btn-secondary-border;
                    }
                    arrow-seg := Rectangle {
                        width: 16px;
                        height: 100%;
                        background: arrow-seg-touch.has-hover ? Design.btn-secondary-bg-hover : transparent;
                        arrow-seg-touch := TouchArea {
                            width: 100%; height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.open-comment-window(); }
                        }
                        Text {
                            text: "▸";
                            font-size: 10px;
                            font-weight: 600;
                            color: Design.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }
            Btn {
                label: "Checklist";
                variant: "secondary";
                scale: 0.89;
                small: root.is-narrow;
                clicked => { root.sub-panel = "checklist"; }
            }
            if !root.is-manual : Btn {
                label: "Move";
                variant: "secondary";
                scale: 0.89;
                small: root.is-narrow;
                clicked => { root.sub-panel = "move"; }
            }
            if root.is-manual : Btn {
                label: "Unlink";
                variant: "secondary";
                scale: 0.89;
                small: root.is-narrow;
                clicked => { root.unlink(); }
            }
        }


        HSeparator { }

        // Description (13px SemiBold + isi 12px).
        HorizontalLayout {
            height: 18px;
            Text {
                text: "Description";
                font-size: 13px;
                font-weight: 600;
                color: Design.text-primary;
                // Tinggi eksplisit 18px: Text anak langsung VerticalLayout
                // bisa mengembang preferred-height-nya (dihitung seolah
                // lebar ~0) dan mendorong isi di bawahnya — label 1 baris
                // 13px selalu 18px, jadi aman dipatok.
                height: 18px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            // Edit deskripsi (Markdown) — tidak untuk kartu manual
            // (deskripsinya = URL, bukan teks).
            if !root.is-manual && !root.desc-editing : Btn {
                label: "Edit"; variant: "ghost"; small: true; height-override: 24px;
                clicked => {
                    root.desc-draft = root.description;
                    root.desc-editing = true;
                }
            }
        }
        // Isi deskripsi bisa panjang (deskripsi asli dari API Trello) —
        // C# membatasi tinggi isi 240px + scroll; port ikut (polish
        // abeng 28 Nov 10:16: deskripsi panjang sebelumnya terpotong di
        // tepi bawah panel tanpa bisa dibaca sisanya). Flickable
        // setinggi isi, maks 240px — deskripsi pendek tidak menyisakan
        // ruang kosong. Isi dirender sebagai Markdown.
        if !root.desc-editing : Rectangle {
            height: min(240px, desc-md.preferred-height);
            clip: true;
            desc-flick := Flickable {
                x: 0; y: 0; width: 100%; height: 100%;
                viewport-height: desc-md.preferred-height;
                desc-md := MarkdownView {
                    width: 100%;
                    source: root.description;
                    font-size: 12px;
                    parse-md(s, w) => { root.parse-md(s, w) }
                    open-url(u) => { root.open-url(u); }
                    show-toast(t) => { root.show-toast(t); }
                }
            }
        }
        // Editor deskripsi: toolbar Markdown + TextInput multi-baris
        // + pratinjau live + Simpan/Batal.
        if root.desc-editing : VerticalLayout {
            spacing: 8px;
            MdToolbar {
                insert(kind) => {
                    root.desc-draft = root.md-insert(kind, root.desc-draft, desc-edit.cursor-position-byte-offset, desc-edit.anchor-position-byte-offset);
                }
            }
            Rectangle {
                height: 120px;
                background: Design.bg-input;
                border-color: desc-edit.has-focus ? Design.border-focus : Design.border-default;
                border-width: 1px;
                border-radius: Design.radius-sm;
                clip: true;
                desc-edit := TextInput {
                    x: 10px; y: 6px;
                    width: parent.width - 20px;
                    height: parent.height - 12px;
                    text <=> root.desc-draft;
                    font-size: 12px;
                    color: Design.text-primary;
                    selection-foreground-color: white;
                    selection-background-color: Design.accent;
                    wrap: word-wrap;
                    single-line: false;
                }
            }
            Text {
                text: "Pratinjau";
                font-size: 11px;
                font-weight: 600;
                color: Design.text-muted;
                height: 16px;
            }
            Rectangle {
                height: min(140px, desc-preview-md.preferred-height);
                clip: true;
                Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    viewport-height: desc-preview-md.preferred-height;
                    desc-preview-md := MarkdownView {
                        width: 100%;
                        source: root.desc-draft;
                        font-size: 12px;
                        parse-md(s, w) => { root.parse-md(s, w) }
                        open-url(u) => { root.open-url(u); }
                        show-toast(t) => { root.show-toast(t); }
                    }
                }
            }
            HorizontalLayout {
                height: 32px;
                spacing: 8px;
                Btn {
                    label: "Simpan"; variant: "primary"; height-override: 32px;
                    clicked => {
                        root.save-description(root.desc-draft);
                        root.desc-editing = false;
                    }
                }
                Btn {
                    label: "Batal"; variant: "ghost"; height-override: 32px;
                    clicked => { root.desc-editing = false; }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "Markdown: **tebal** *miring* `kode` [link](url)";
                    font-size: 11px;
                    color: Design.text-muted;
                    vertical-alignment: center;
                }
            }
            // Fokus ke editor begitu mode edit muncul.
            desc-focus-timer := Timer {
                interval: 60ms;
                running: true;
                triggered => {
                    self.running = false;
                    desc-edit.focus();
                }
            }
        }
        }
    }

    // ================= TAMPILAN POINTS (breakdown) =================
    // height: 100% — alasan sama seperti card-view (area hit-test).
    points-view := VerticalLayout {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.sub-panel == "" && root.is-points;
        padding: root.panel-margin;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.card-title;
                font-size: root.title-size;
                font-weight: 700;
                color: Design.text-primary;
                wrap: word-wrap;
                // Lebar eksplisit — alasan sama seperti judul detail
                // (preferred-height Text pembungkus bisa mengembang
                // bila lebarnya dari stretch).
                width: root.width - 2 * root.panel-margin - 44px;
                vertical-alignment: top;
            }
            IconBtn {
                glyph: "×";
                variant: "ghost";
                size: 32px;
                clicked => { root.close(); }
            }
        }
        HSeparator { }
        HorizontalLayout {
            height: 28px;
            Text { text: "Minggu ini"; font-size: 13px; color: Design.text-secondary; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "+120"; font-size: 13px; font-weight: 700; color: Design.cat-points; vertical-alignment: center; }
        }
        HSeparator { }
        HorizontalLayout {
            height: 28px;
            Text { text: "Bulan ini"; font-size: 13px; color: Design.text-secondary; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "+480"; font-size: 13px; font-weight: 700; color: Design.cat-points; vertical-alignment: center; }
        }
        HSeparator { }
        HorizontalLayout {
            height: 28px;
            Text { text: "Total"; font-size: 13px; color: Design.text-secondary; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "1.280"; font-size: 18px; font-weight: 800; color: Design.cat-points; vertical-alignment: center; }
        }
    }

    // ================= SUB-PANEL: COMMENTS =================
    comments-panel := Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.sub-panel == "comments";
        comments-back-touch := TouchArea {
            width: 100%; height: 100%;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    root.sub-panel = "";
                }
            }
        }
        VerticalLayout {
            x: 0; y: 0; width: 100%; height: 100%;
            padding: root.panel-margin;
            spacing: 12px;
            HorizontalLayout {
                height: 28px;
                spacing: 8px;
                Text {
                    text: "Comments";
                    font-size: 18px;
                    font-weight: 600;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }
                Text {
                    text: root.card-title;
                    font-size: 12px;
                    color: Design.text-secondary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                IconBtn {
                    glyph: root.show-activity ? "◉" : "○";
                    variant: "ghost";
                    size: 28px;
                    clicked => {
                        root.show-activity = !root.show-activity;
                        root.show-toast(root.show-activity ? "Aktivitas ditampilkan" : "Aktivitas disembunyikan");
                    }
                }
                IconBtn {
                    glyph: "×";
                    variant: "ghost";
                    size: 28px;
                    clicked => { root.sub-panel = ""; }
                }
            }
            HSeparator { }
            Rectangle {
                vertical-stretch: 1;
                clip: true;
                comments-flick := Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    VerticalLayout {
                        x: 0; width: parent.width;
                        spacing: 12px;
                        // Komentar contoh DIHAPUS 27 Nov 2026 (keputusan
                        // abeng: default publish harus bersih) — komentar
                        // diisi dari API Trello / yang user tambah.
                        if root.added-count >= 1 : CommentRow {
                            author: root.user-name;
                            time: "baru saja";
                            body: root.draft-1;
                            initial: root.user-initial;
                            avatar-bg: Design.accent;
                            parse-md(s, w) => { root.parse-md(s, w) }
                            open-url(u) => { root.open-url(u); }
                            show-toast(t) => { root.show-toast(t); }
                        }
                        if root.added-count >= 2 : CommentRow {
                            author: root.user-name;
                            time: "baru saja";
                            body: root.draft-2;
                            initial: root.user-initial;
                            avatar-bg: Design.accent;
                            parse-md(s, w) => { root.parse-md(s, w) }
                            open-url(u) => { root.open-url(u); }
                            show-toast(t) => { root.show-toast(t); }
                        }
                        if root.added-count >= 3 : CommentRow {
                            author: root.user-name;
                            time: "baru saja";
                            body: root.draft-3;
                            initial: root.user-initial;
                            avatar-bg: Design.accent;
                            parse-md(s, w) => { root.parse-md(s, w) }
                            open-url(u) => { root.open-url(u); }
                            show-toast(t) => { root.show-toast(t); }
                        }
                    }
                }
            }
            // Balasan cepat (C#: Quick Replies).
            HorizontalLayout {
                height: 28px;
                spacing: 8px;
                Btn {
                    label: "Siap, diperbaiki.";
                    variant: "ghost";
                    small: true;
                    clicked => { root.comment-draft = "Siap, diperbaiki."; }
                }
                Btn {
                    label: "Sudah dicek.";
                    variant: "ghost";
                    small: true;
                    clicked => { root.comment-draft = "Sudah dicek."; }
                }
            }
            // Editor komentar (Markdown): toolbar + input multi-baris
            // + pratinjau live. Enter menyisipkan baris baru (bukan
            // kirim); kirim hanya via tombol →.
            MdToolbar {
                insert(kind) => {
                    root.comment-draft = root.md-insert(kind, root.comment-draft, comment-input.cursor-position-byte-offset, comment-input.anchor-position-byte-offset);
                }
            }
            HorizontalLayout {
                spacing: 8px;
                // TextField bawaan single-line 36px — editor komentar
                // multi-baris memakai TextInput mentah di dalam
                // Rectangle ala TextField (latar + border + radius).
                Rectangle {
                    horizontal-stretch: 1;
                    height: 56px;
                    background: Design.bg-input;
                    border-color: comment-input.has-focus ? Design.border-focus : Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-sm;
                    clip: true;
                    comment-input := TextInput {
                        x: 10px; y: 6px;
                        width: parent.width - 20px;
                        height: parent.height - 12px;
                        text <=> root.comment-draft;
                        font-size: 12px;
                        color: Design.text-primary;
                        selection-foreground-color: white;
                        selection-background-color: Design.accent;
                        wrap: word-wrap;
                        single-line: false;
                    }
                    Text {
                        text: "Write a comment... (@mention)";
                        font-size: 12px;
                        color: Design.text-muted;
                        x: 10px; y: 6px;
                        visible: root.comment-draft == "" && !comment-input.has-focus;
                    }
                }
                // Tombol rata bawah (input multi-baris).
                VerticalLayout {
                    alignment: end;
                    IconBtn {
                        glyph: "+";
                        variant: "ghost";
                        size: 36px;
                        clicked => { root.show-toast("Lampirkan file ke komentar (mockup — Fase 6)"); }
                    }
                }
                VerticalLayout {
                    alignment: end;
                    IconBtn {
                        glyph: "→";
                        variant: "accent";
                        size: 36px;
                        clicked => { root.send-comment(); }
                    }
                }
            }
            // Pratinjau komentar saat mengetik (maks ~100px).
            if root.comment-draft != "" : Rectangle {
                height: min(100px, comment-preview-md.preferred-height);
                clip: true;
                Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    viewport-height: comment-preview-md.preferred-height;
                    comment-preview-md := MarkdownView {
                        width: 100%;
                        source: root.comment-draft;
                        font-size: 12px;
                        parse-md(s, w) => { root.parse-md(s, w) }
                        open-url(u) => { root.open-url(u); }
                        show-toast(t) => { root.show-toast(t); }
                    }
                }
            }
        }
    }

    // ================= SUB-PANEL: CHECKLISTS =================
    checklist-panel := Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.sub-panel == "checklist";
        checklist-back-touch := TouchArea {
            width: 100%; height: 100%;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    root.sub-panel = "";
                }
            }
        }
        VerticalLayout {
            x: 0; y: 0; width: 100%; height: 100%;
            padding: root.panel-margin;
            spacing: 12px;
            HorizontalLayout {
                height: 28px;
                spacing: 8px;
                Text {
                    text: "Checklists";
                    font-size: 18px;
                    font-weight: 600;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconBtn {
                    glyph: "↻";
                    variant: "ghost";
                    size: 28px;
                    clicked => { root.show-toast("Checklist disegarkan (mockup)"); }
                }
                IconBtn {
                    glyph: "×";
                    variant: "ghost";
                    size: 28px;
                    clicked => { root.sub-panel = ""; }
                }
            }
            HSeparator { }
            HorizontalLayout {
                height: 20px;
                spacing: 8px;
                Text {
                    text: root.category-label + " " + root.user-name;
                    font-size: 15px;
                    font-weight: 600;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.progress-text;
                    font-size: 11px;
                    color: Design.text-secondary;
                    vertical-alignment: center;
                }
            }
            for label[idx] in ["Crop foto", "Centering kepala di guide", "Logo terlihat"] : Rectangle {
                height: 28px;
                property <bool> checked: root.done ? true : idx == 0;
                item-touch := TouchArea {
                    width: 100%; height: 100%;
                    mouse-cursor: pointer;
                    clicked => {
                        checked = !checked;
                        root.show-toast(checked ? "Item checklist dicentang (mockup)" : "Centang item dibatalkan (mockup)");
                    }
                }
                HorizontalLayout {
                    x: 0; y: 0; width: 100%; height: 100%;
                    spacing: 10px;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        background: checked ? Design.accent : transparent;
                        border-width: 1px;
                        border-color: checked ? Design.accent : Design.border-default;
                        Text {
                            text: "✓";
                            font-size: 12px;
                            font-weight: 700;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                            visible: checked;
                        }
                    }
                    Text {
                        text: label;
                        font-size: 12px;
                        color: Design.text-primary;
                        vertical-alignment: center;
                    }
                }
            }
            Btn {
                label: "Duplicate Checklist";
                variant: "primary";
                width: 100%;
                clicked => { root.show-toast("Checklist diduplikasi (mockup — Fase 6)"); }
            }
        }
    }

    // ================= SUB-PANEL: MOVE CARD =================
    move-panel := Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.sub-panel == "move";
        move-back-touch := TouchArea {
            width: 100%; height: 100%;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    root.sub-panel = "";
                }
            }
        }
        VerticalLayout {
            x: 0; y: 0; width: 100%; height: 100%;
            padding: root.panel-margin;
            spacing: 12px;
            HorizontalLayout {
                height: 28px;
                spacing: 8px;
                Text {
                    text: "Move Card";
                    font-size: 18px;
                    font-weight: 600;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconBtn {
                    glyph: "×";
                    variant: "ghost";
                    size: 28px;
                    clicked => { root.sub-panel = ""; }
                }
            }
            HSeparator { }
            Text {
                text: "Destination Board";
                font-size: 12px;
                font-weight: 600;
                color: Design.text-primary;
                height: 16px;
            }
            TextField {
                placeholder: "Cari board...";
                text <=> root.move-board;
            }
            Text {
                text: "Destination List";
                font-size: 12px;
                font-weight: 600;
                color: Design.text-primary;
                height: 16px;
            }
            TextField {
                placeholder: "Cari list...";
                text <=> root.move-list;
            }
            Btn {
                label: "Confirm Move";
                variant: "primary";
                scale: 1.06;
                width: 100%;
                clicked => {
                    if (root.move-board == "" || root.move-list == "") {
                        root.show-toast("Pilih board & list tujuan dulu");
                    } else {
                        root.show-toast("Kartu dipindah ke " + root.move-board + " / " + root.move-list + " (mockup)");
                        root.move-board = "";
                        root.move-list = "";
                        root.sub-panel = "";
                    }
                }
            }
        }
    }

    // ================= SUB-PANEL: ATTACHMENTS =================
    attachments-panel := Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.sub-panel == "attachments";
        attachments-back-touch := TouchArea {
            width: 100%; height: 100%;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    root.sub-panel = "";
                }
            }
        }
        VerticalLayout {
            x: 0; y: 0; width: 100%; height: 100%;
            padding: root.panel-margin;
            spacing: 12px;
            HorizontalLayout {
                height: 28px;
                spacing: 8px;
                Text {
                    text: "Attachments";
                    font-size: 18px;
                    font-weight: 600;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconBtn {
                    glyph: "×";
                    variant: "ghost";
                    size: 28px;
                    clicked => { root.sub-panel = ""; }
                }
            }
            HSeparator { }
            Rectangle {
                vertical-stretch: 1;
                Text {
                    text: "No attachments.";
                    font-size: 12px;
                    color: Design.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }
}
