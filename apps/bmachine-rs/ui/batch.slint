// BATCH — tampilan tab BATCH (dipakai DUA host: AppWindow embedded
// dan BatchWindow terlepas, ui/windows.slint). Dipindah dari
// ui/main.slint 28 Nov 2026 (tear-off BATCH): SATU komponen, dua
// host — jangan duplikasi tampilan ini. Semua state BATCH hidup di
// Rust (src/batch.rs); host hanya mengikat prop dua arah + meneruskan
// callback ke Rust. Jendela terlepas disinkronkan Rust dari AppWindow
// (sync_batch_window di src/main.rs) tiap kali state berubah.

import { Design, Card, HSeparator, Btn, IconBtn, TextField, ComboBox } from "design.slint";

// ===== BATCH — baris tree + menu konteks (model beneran, Rust) =====
// Satu baris tree BATCH (flat row dari src/batch.rs): indentasi dari
// depth, chevron ▸/▾ untuk folder, ikon ▤ untuk file, nama tebal
// untuk folder. Klik kiri = pilih + salin path (Rust); klik kanan =
// expand/collapse + buka menu konteks (Rust, LANJUTKAN §10).
export struct BatchRow {
    id: string,
    name: string,
    path: string,
    depth: int,
    is-dir: bool,
    expanded: bool,
    has-kids: bool,
    selected: bool,
    is-root: bool,
    // Jumlah file rekursif di folder ini untuk ekstensi yang dipilih
    // user; -1 = baris file / jangan tampilkan (28 Nov 2026).
    file-count: int,
}

// Satu direktori Folder Reguler tersimpan (popup Kelola, tahap 4).
// status: "ready" | "empty" | "missing" | "locked" | "inuse".
export struct RegulerDirRow {
    path: string,
    name: string,
    status: string,
    status-label: string,
    locked: bool,
    last-output: string,
}

// Satu baris sekolah hasil scan Folder Reguler (tahap 4).
export struct RegulerSchoolRow {
    bulan: string,
    marketing: string,
    sekolah: string,
    path: string,
    // Jumlah file rekursif di folder sekolah untuk ekstensi yang
    // dipilih; -1 = belum dihitung (cache lama) / jangan tampilkan.
    file-count: int,
}

component BatchTreeRow inherits Rectangle {
    in property <string> row-id: "";
    in property <string> row-name: "";
    in property <int> row-depth: 0;
    in property <bool> row-is-dir: true;
    in property <bool> row-expanded: false;
    in property <bool> row-has-kids: false;
    in property <bool> row-selected: false;
    in property <string> panel: "SOURCE";
    // Jumlah file rekursif di folder ini (ekstensi pilihan user);
    // -1 = baris file / belum dihitung → angka disembunyikan.
    in property <int> row-file-count: -1;
    callback row-clicked(string, string);
    callback row-right-down(string, string);
    callback row-right-up(string, string);
    callback row-toggle-expand(string, string);
    callback row-more(string, string);

    // Baris folder 36px, baris anak (file) 26px — tree padat C#,
    // tidak ikut ui-scale.
    height: row-is-dir ? 36px : 26px;
    background: row-selected ? Design.accent-subtle : (row-touch.has-hover ? Design.bg-hover : transparent);
    border-radius: Design.radius-sm;

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.row-clicked(panel, row-id); }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.row-right-down(panel, row-id);
            } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right) {
                root.row-right-up(panel, row-id);
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px + row-depth * 16px;
        padding-right: 10px;
        spacing: 8px;

        // Chevron (folder beranak) / ikon file ▤ / spasi kosong.
        Rectangle {
            width: 20px;
            height: 100%;
            chev-touch := TouchArea {
                mouse-cursor: pointer;
                enabled: row-is-dir && row-has-kids;
                clicked => { root.row-toggle-expand(panel, row-id); }
            }
            Text {
                text: row-is-dir ? (row-has-kids ? (row-expanded ? "▾" : "▸") : "") : "▤";
                font-size: 12px;
                font-weight: 700;
                color: row-is-dir ? Design.text-secondary : Design.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Text {
            text: row-name;
            font-size: 12px;
            font-weight: row-is-dir ? 700 : 400;
            color: row-selected ? Design.accent : (row-is-dir ? Design.text-primary : Design.text-secondary);
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Angka isi file (28 Nov 2026): jumlah file rekursif di
        // folder ini untuk ekstensi yang dipilih user. Hanya baris
        // folder yang hitungannya diketahui. Lebar 0 bila tidak
        // tampil — `visible: false` saja tidak cukup, elemen tak
        // terlihat tetap makan tempat di layout.
        Text {
            text: root.row-file-count + "";
            font-size: 11px;
            color: Design.text-muted;
            horizontal-alignment: right;
            vertical-alignment: center;
            width: root.row-is-dir && root.row-file-count >= 0 ? 44px : 0px;
        }

        IconBtn {
            glyph: "⋯";
            variant: "ghost";
            scale: 1;
            size: 24px;
            clicked => { root.row-more(panel, row-id); }
        }
    }
}

// Menu konteks BATCH — satu komponen dipakai panel SOURCE + OUTPUT.
// Isi menyesuaikan panel + jenis node (C# DashboardView.axaml):
// root + item = New Subfolder… / Replace (Auto) / Copy Path / Delete;
// child direktori = Replace (Auto) / Copy Path; OUTPUT tanpa Replace.
// Replace (Manual) hanya SOURCE + direktori.
component BatchCtxMenu inherits Card {
    in property <string> menu-title: "";
    in property <bool> show-replace: false;
    in property <bool> show-copy-output: false;
    callback new-subfolder();
    callback replace-auto();
    callback replace-manual();
    callback copy-path();
    callback copy-output-path();
    callback delete();
    callback close-menu();

    background: Design.surface-elevated;
    border-color: Design.border-hover;
    border-width: 1px;
    border-radius: Design.radius-md;

    ctx-layout := VerticalLayout {
        padding: Design.space-sm;
        spacing: 2px;

        Text {
            text: "⋯ " + root.menu-title;
            font-size: 12px;
            font-weight: 700;
            color: Design.text-primary;
            horizontal-stretch: 1;
            overflow: elide;
        }
        HSeparator { }

        Rectangle {
            height: 32px;
            background: ctx-new.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-new := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.new-subfolder(); }
            }
            Text {
                text: "New Subfolder…";
                font-size: 12px;
                color: Design.text-primary;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }

        Rectangle {
            height: root.show-replace ? 32px : 0px;
            visible: root.show-replace;
            background: ctx-rep.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-rep := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.replace-auto(); }
            }
            Text {
                text: "Replace (Auto)";
                font-size: 12px;
                color: Design.text-primary;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }

        Rectangle {
            height: root.show-replace ? 32px : 0px;
            visible: root.show-replace;
            background: ctx-repm.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-repm := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.replace-manual(); }
            }
            Text {
                text: "Replace (Manual)";
                font-size: 12px;
                color: Design.text-primary;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }

        Rectangle {
            height: 32px;
            background: ctx-copy.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-copy := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.copy-path(); }
            }
            Text {
                text: "Copy Path";
                font-size: 12px;
                color: Design.text-primary;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }

        Rectangle {
            height: root.show-copy-output ? 32px : 0px;
            visible: root.show-copy-output;
            background: ctx-copyout.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-copyout := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.copy-output-path(); }
            }
            Text {
                text: "Copy Output Path";
                font-size: 12px;
                color: Design.text-primary;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }

        Rectangle {
            height: 32px;
            background: ctx-del.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-del := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.delete(); }
            }
            Text {
                text: "Delete";
                font-size: 12px;
                font-weight: 700;
                color: Design.status-danger;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }

        HSeparator { }

        Rectangle {
            height: 28px;
            background: ctx-close.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-close := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close-menu(); }
            }
            Text {
                text: "✕ Tutup";
                font-size: 11px;
                color: Design.text-muted;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }
    }
}

// Grip tear-off (dipakai header daftar + header treeview): seret
// melewati 48px ke arah mana pun -> BATCH lepas jadi window OS;
// tutup window itu -> kembali ke dashboard (§16.10).
component BatchTearGrip inherits TouchArea {
    in property <float> scale: 1;
    in property <bool> show: true;
    callback tear-off(length, length);
    width: 22px;
    // Tinggi 36px TETAP — sama seperti semua kontrol header BATCH
    // (aturan presisi 27 Nov 2026; dulu 32px*scale sehingga grip
    // menggantung di baris header yang di-scale ui-scale).
    height: 36px;
    visible: root.show;
    mouse-cursor: grab;
    property <length> grip-start-x: 0px;
    property <length> grip-start-y: 0px;
    property <bool> grip-dragging: false;
    pointer-event(ev) => {
        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
            self.grip-start-x = self.mouse-x;
            self.grip-start-y = self.mouse-y;
            self.grip-dragging = true;
        } else if (ev.kind == PointerEventKind.up) {
            self.grip-dragging = false;
        } else if (ev.kind == PointerEventKind.move && self.grip-dragging) {
            if (self.mouse-x - self.grip-start-x > 48px || self.grip-start-x - self.mouse-x > 48px || self.mouse-y - self.grip-start-y > 48px || self.grip-start-y - self.mouse-y > 48px) {
                self.grip-dragging = false;
                root.tear-off(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    Text {
        text: "⋮⋮";
        font-size: 14px * root.scale;
        font-weight: 800;
        color: Design.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// Aksi header tampilan DAFTAR Folder Reguler — dipakai dua kali
// (baris 1 saat lebar, baris 2 saat sempit); satu definisi supaya
// label + callback tidak dobel dan tidak drift (28 Nov 2026).
component BatchListActions inherits HorizontalLayout {
    in property <float> scale: 1;
    in property <bool> show-tear-off: true;
    callback pick-folder();
    callback reguler-manage();
    callback open-task-manager();
    callback tear-off-center();
    spacing: 8px * root.scale;
    Btn {
        label: "Pilih Folder";
        variant: "ghost";
        scale: root.scale;
        clicked => { root.pick-folder(); }
    }
    Btn {
        label: "Kelola…";
        variant: "ghost";
        scale: root.scale;
        clicked => { root.reguler-manage(); }
    }
    Btn {
        label: "☰ Tugas";
        variant: "ghost";
        scale: root.scale;
        clicked => { root.open-task-manager(); }
    }
    Btn {
        label: "⧉ Lepas";
        variant: "ghost";
        scale: root.scale;
        visible: root.show-tear-off;
        clicked => { root.tear-off-center(); }
    }
}

// Aksi header TREEVIEW — dipakai dua kali (baris 1 saat lebar,
// baris 2 saat sempit). "‹ Daftar" = kembali ke daftar Folder
// Reguler (tanpa tombol "← Kembali" — ini aksi navigasi daftar,
// bukan tombol kembali umum).
component BatchTreeActions inherits HorizontalLayout {
    in property <float> scale: 1;
    callback back-to-list();
    callback open-task-manager();
    spacing: 8px * root.scale;
    Btn {
        label: "‹ Daftar";
        variant: "ghost";
        scale: root.scale;
        clicked => { root.back-to-list(); }
    }
    Btn {
        label: "☰ Tugas";
        variant: "ghost";
        scale: root.scale;
        clicked => { root.open-task-manager(); }
    }
}

export component BatchView inherits Rectangle {
    // Host: skala UI + lebar konten (dihitung host). Tinggi panel
    // TIDAK lagi dihitung host (rumus lama lupa titlebar AppWindow
    // → footer jatuh di bawah lipatan): panel pakai
    // vertical-stretch dan mengambil sisa tinggi BatchView sendiri.
    in property <float> ui-scale: 1;
    in property <length> content-width: 960px;
    // Sempit = header dua baris + drop-zone menumpuk. Satu baris
    // header butuh ~950px; di bawah itu tombol terpotong (1280px
    // panel-terbuka, 960px, 520px — 28 Nov 2026).
    property <bool> narrow: root.content-width < 1000px;

    // Data BATCH beneran (Rust, src/batch.rs) — model flat rows.
    // SOURCE/OUTPUT dirender sebagai DAFTAR DATAR (parallel arrays):
    // Rust meratakan tree terlihat (hormat expand) ke FlatRow; Slint
    // hanya menampilkan baris + indentasi dari depth.
    in-out property <[BatchRow]> src-rows: [];
    in-out property <[BatchRow]> out-rows: [];
    in-out property <string> src-name: "";
    in-out property <string> selected-output: "";
    // Folder output belum ada di disk -> chip "(pending)" oranye.
    in-out property <bool> batch-out-pending: true;
    // Dua fase master: Fase 1 = script "buat_master" di footer
    // (buat_master.py membuat manifest — persis C#: tombol ikon
    // buat_master di footer DashboardView, BUKAN tombol "Fase 1"
    // sendiri); Fase 2 (BUAT MASTER = buat_master_duplikat.py)
    // BUTUH manifest dan tetap manual (tombol Lanjutkan).
    in-out property <bool> has-manifest: false;
    // Jumlah node terpilih (tampil di header SOURCE: "N dipilih").
    in-out property <int> batch-sel-count: 0;
    // Context menu BATCH (dibuka dari ⋯ / klik kanan; ditutup setelah
    // satu aksi dipilih atau klik di luar menu).
    in-out property <string> ctx-node: "";
    in-out property <string> ctx-node-id: "";
    in-out property <string> ctx-panel: "SOURCE";
    in-out property <bool> ctx-is-dir: false;
    in-out property <bool> ctx-is-root: false;
    // Input inline subfolder baru (C# CancelNewFolderInput di
    // BatchFolderRoot): newfolder-open false = tidak ada input.
    in-out property <bool> newfolder-open: false;
    in-out property <string> newfolder-panel: "";
    in-out property <string> newfolder-parent: "";
    in-out property <string> newfolder-name: "";
    // Folder Reguler (ala master_creator): daftar sekolah di
    // tampilan awal + popup Kelola (manajemen direktori) + dropdown
    // working set di atas treeview. Hasil scan di-cache di DB
    // (Batch.FolderReguler.Cache) + refresh inkremental per bulan.
    in-out property <[string]> batch-working-set-names: [];
    in-out property <int> batch-working-set-idx: -1;
    // Hitungan file (28 Nov 2026): ekstensi yang dihitung untuk angka
    // di kanan nama folder (treeview + daftar Folder Reguler).
    // Model ComboBox "Hitung" di header treeview; label dipakai
    // subtext daftar ("128 jpg" / "128 file").
    property <[string]> file-count-exts: ["jpg", "png", "psd", "semua"];
    in-out property <int> batch-file-count-ext-idx: 0;
    in-out property <string> batch-file-count-ext-label: "jpg";
    // Popup Kelola Folder Reguler (tahap 4) — overlay di tab BATCH.
    in-out property <bool> reguler-manage-open: false;
    in-out property <[RegulerDirRow]> reguler-dirs: [];
    // Direktori yang sedang di-scan tabel sekolahnya (-1 = belum ada).
    in-out property <int> reguler-scan-dir-idx: -1;
    in-out property <[RegulerSchoolRow]> reguler-scan-rows: [];
    in-out property <string> reguler-scan-status: "";
    in-out property <string> reguler-filter: "";
    in-out property <[string]> reguler-months: ["Semua bulan"];
    in-out property <int> reguler-month-idx: 0;
    // Footer: tombol script dari scripts.json (atau default 5).
    in-out property <[string]> batch-scripts: ["buat_master", "manasik", "wisuda", "pasfoto", "profesi"];
    in-out property <bool> batch-running: false;
    // SOURCE kosong = belum ada folder (daftar Folder Reguler tampil);
    // OUTPUT kosong = tree output belum ada (teks "Output akan
    // muncul di sini." tampil).
    property <bool> src-empty: root.src-rows.length == 0;
    property <bool> out-empty: root.out-rows.length == 0;

    // Callbacks BATCH -> host (AppWindow / BatchWindow teruskan ke
    // Rust, src/batch.rs + src/batch_exec.rs). confirm-new-folder
    // menerima (nama, panel) sebagai argumen — handler Rust TIDAK
    // boleh membaca newfolder-name dari AppWindow, karena saat
    // terlepas nilainya hidup di BatchWindow (bukan AppWindow).
    callback batch-pick-folder();
    callback batch-add-folder(string);
    callback batch-row-clicked(string, string);
    callback batch-row-right-down(string, string);
    callback batch-row-right-up(string, string);
    callback batch-toggle-expand(string, string);
    callback batch-open-ctx(string, string);
    callback batch-close-ctx();
    callback batch-ctx-new-subfolder();
    callback batch-ctx-replace-auto();
    callback batch-ctx-replace-manual();
    callback batch-ctx-copy-path();
    callback batch-ctx-copy-output-path();
    callback batch-ctx-delete();
    callback batch-confirm-new-folder(string, string);
    callback batch-cancel-new-folder();
    callback batch-run-script(string);
    callback batch-copy-master();
    callback batch-stop();
    callback batch-replace-auto();
    callback batch-refresh();
    callback batch-clear();
    callback batch-list-open-school(int);
    callback batch-working-set-picked(int);
    callback batch-file-count-ext-picked(int);
    callback batch-back-to-list();
    callback batch-reguler-refresh();
    callback batch-reguler-manage();
    callback batch-reguler-close();
    callback batch-reguler-add();
    callback batch-reguler-remove(int);
    callback batch-reguler-toggle-lock(int);
    callback batch-reguler-select-dir(int);
    callback batch-reguler-filter-changed(string);
    callback batch-reguler-month-picked(int);
    callback batch-open-task-manager();
    // Tear-off: seret grip melewati 48px -> lepas jadi window OS
    // (argumen = posisi pointer relatif window utama, logis);
    // tear-off-center = lepas via tombol (window di tengah main).
    // show-tear-off false = sudah terlepas (grip + tombol Lepas
    // disembunyikan — tidak bisa lepas dua kali).
    in property <bool> show-tear-off: true;
    callback batch-tear-off(length, length);
    callback batch-tear-off-center();
    // Toast: host yang menampilkan (AppWindow = toast dashboard;
    // BatchWindow teruskan ke AppWindow).
    callback show-toast(string);

            // ----- BATCH: tree filesystem beneran (Rust, src/batch.rs)
            // + dua fase master + Replace. SOURCE = ISI folder sekolah
            // (tree, expand lazy, scan disk); BUAT MASTER = fase 2
            // (butuh manifest fase 1); Replace single + multiple;
            // toolbar = launcher skrip. Tampilan awal = DAFTAR Folder
            // Reguler (28 Nov 2026, menggantikan drop zone — abeng
            // 14:44); tree muncul setelah sekolah dipilih dari daftar.
            // Task Manager (tahap 5) dock di kanan tab — panel progres
            // terpisah ala master_creator, bukan log panel.
            HorizontalLayout {
                x: 0; y: 0;
                width: 100%; height: 100%;
                visible: !root.src-empty;
                VerticalLayout {
                    horizontal-stretch: 1;
                    height: 100%;
                    padding-left: Design.space-xl;
                    padding-right: Design.space-xl;
                padding-top: Design.space-md;
                padding-bottom: Design.space-xl;
                spacing: Design.space-md;

                // Header responsif (pola SettingRow: menumpuk saat
                // sempit). Lebar: satu baris (judul + deskripsi +
                // Folder Reguler + aksi). Sempit: dua baris (baris 1 =
                // judul + deskripsi + dropdown; baris 2 = aksi rata
                // kanan). Deskripsi elide + stretch supaya tidak
                // mendorong tombol keluar (defect 28 Nov 2026).
                // TANPA height tetap: ComboBox di baris ini harus bisa
                // tumbuh saat terbuka (preferred-height) dan mendorong
                // tree ke bawah — height tetap 36px membuat daftarnya
                // meluber menumpuk tree di bawah dan klik item ditelan
                // kartu SOURCE/OUTPUT (defect 28 Nov 2026).
                VerticalLayout {
                    spacing: 8px * root.ui-scale;
                    // Header treeview — SEMUA kontrol 36px, skala 1
                    // (28 Nov 2026, aturan presisi abeng 27 Nov 16:30):
                    // header = baris kontrol padat seperti tree (tidak
                    // ikut ui-scale). Dulu Btn/IconBtn/grip/title
                    // memakai ui-scale (36px*1.755≈63px di 1280×800)
                    // sementara TextField/ComboBox tetap 36px — teks
                    // tombol menggantung ~14px di bawah garis tengah
                    // field. Kini tiap anak 36px + konten dipusatkan
                    // vertikal, jadi garis tengahnya sejajar.
                    HorizontalLayout {
                        spacing: 8px;
                        BatchTearGrip {
                            scale: 1;
                            show: root.show-tear-off;
                            tear-off(x, y) => { root.batch-tear-off(x, y); }
                        }
                        Text {
                            text: "BATCH";
                            font-size: 14px;
                            font-weight: 800;
                            color: Design.text-primary;
                            letter-spacing: 1px;
                            height: 36px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Pilih sekolah, lalu jalankan master.";
                            font-size: 12px;
                            color: Design.text-muted;
                            height: 36px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        // Working set (ala "Direktori :" master_creator):
                        // sekolah yang sudah dibuka dari Folder Reguler —
                        // ganti dropdown = ganti sekolah di treeview.
                        if !root.narrow : ComboBox {
                            width: 240px;
                            model: root.batch-working-set-names;
                            current-index <=> root.batch-working-set-idx;
                            selected(index) => { root.batch-working-set-picked(index); }
                        }
                        // Hitung (28 Nov 2026): ekstensi yang dihitung
                        // untuk angka file di kanan nama folder.
                        if !root.narrow : Text {
                            text: "Hitung:";
                            font-size: 12px;
                            color: Design.text-muted;
                            height: 36px;
                            vertical-alignment: center;
                        }
                        if !root.narrow : ComboBox {
                            width: 110px;
                            model: root.file-count-exts;
                            current-index <=> root.batch-file-count-ext-idx;
                            selected(index) => { root.batch-file-count-ext-picked(index); }
                        }
                        if !root.narrow : BatchTreeActions {
                            scale: 1;
                            back-to-list() => { root.batch-back-to-list(); }
                            open-task-manager() => { root.batch-open-task-manager(); }
                        }
                    }
                    if root.narrow : HorizontalLayout {
                        spacing: 8px;
                        ComboBox {
                            model: root.batch-working-set-names;
                            current-index <=> root.batch-working-set-idx;
                            selected(index) => { root.batch-working-set-picked(index); }
                            horizontal-stretch: 1;
                        }
                        ComboBox {
                            width: 110px;
                            model: root.file-count-exts;
                            current-index <=> root.batch-file-count-ext-idx;
                            selected(index) => { root.batch-file-count-ext-picked(index); }
                        }
                        BatchTreeActions {
                            scale: 1;
                            back-to-list() => { root.batch-back-to-list(); }
                            open-task-manager() => { root.batch-open-task-manager(); }
                        }
                    }
                }

                // Dua panel explorer (SOURCE kiri, OUTPUT kanan).
                // Tinggi = sisa ruang BatchView (vertical-stretch):
                // header + baris A + footer mengambil jatahnya dulu,
                // panel mengisi sisanya — jadi footer tidak pernah
                // jatuh di bawah lipatan (rumus host lama lupa
                // titlebar AppWindow, 28 Nov 2026).
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: Design.space-md;

                    // Panel SOURCE — TREE isi folder sekolah (flat rows
                    // dari Rust; klik nama = pilih + salin path).
                    src-card := Card {
                        width: (root.content-width - 52px) / 2;
                        VerticalLayout {
                            padding: Design.space-md;
                            spacing: Design.space-sm;

                            HorizontalLayout {
                                height: 24px * root.ui-scale;
                                spacing: 8px * root.ui-scale;
                                Text {
                                    text: "SOURCE";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 800;
                                    color: Design.text-muted;
                                    letter-spacing: 1px * root.ui-scale;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.src-name;
                                    font-size: 12px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.text-primary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.batch-out-pending ? "(pending)" : "";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.cat-revision;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.batch-sel-count > 0 ? root.batch-sel-count + " dipilih" : "";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.accent;
                                    vertical-alignment: center;
                                }
                            }
                            HSeparator { }

                            // Input inline subfolder baru (C#
                            // CancelNewFolderInput di BatchFolderRoot).
                            Rectangle {
                                height: (root.newfolder-open && root.newfolder-panel == "SOURCE") ? 36px : 0px;
                                visible: root.newfolder-open && root.newfolder-panel == "SOURCE";
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.newfolder-parent;
                                        font-size: 11px;
                                        color: Design.text-muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    TextField {
                                        placeholder: "Nama subfolder baru…";
                                        text: root.newfolder-name;
                                        edited(name) => { root.newfolder-name = name; }
                                        accepted(name) => { root.newfolder-name = name; root.batch-confirm-new-folder(root.newfolder-name, root.newfolder-panel); }
                                        min-width: 180px;
                                        horizontal-stretch: 1;
                                    }
                                    IconBtn {
                                        glyph: "✓";
                                        variant: "secondary";
                                        scale: 1;
                                        size: 36px;
                                        clicked => { root.batch-confirm-new-folder(root.newfolder-name, root.newfolder-panel); }
                                    }
                                    IconBtn {
                                        glyph: "×";
                                        variant: "ghost";
                                        scale: 1;
                                        size: 36px;
                                        clicked => { root.batch-cancel-new-folder(); }
                                    }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                Flickable {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    VerticalLayout {
                                        x: 0;
                                        width: src-card.width - 2 * Design.space-md;
                                        spacing: 2px;
                                        for row in root.src-rows:
                                            BatchTreeRow {
                                                row-id: row.id;
                                                row-name: row.name;
                                                row-depth: row.depth;
                                                row-is-dir: row.is-dir;
                                                row-expanded: row.expanded;
                                                row-has-kids: row.has-kids;
                                                row-selected: row.selected;
                                                row-file-count: row.file-count;
                                                panel: "SOURCE";
                                                row-clicked(panel, id) => { root.batch-row-clicked(panel, id); }
                                                row-right-down(panel, id) => { root.batch-row-right-down(panel, id); }
                                                row-right-up(panel, id) => { root.batch-row-right-up(panel, id); }
                                                row-toggle-expand(panel, id) => { root.batch-toggle-expand(panel, id); }
                                                row-more(panel, id) => { root.batch-open-ctx(panel, id); }
                                            }
                                    }
                                }

                                // Lapisan penutup menu: klik di luar menu
                                // = tutup menu (C# menutup otomatis).
                                ctx-dismiss-src := TouchArea {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    visible: root.ctx-node != "" && root.ctx-panel == "SOURCE";
                                    clicked => { root.batch-close-ctx(); }
                                }

                                // Context menu SOURCE (popup di bawah panel).
                                BatchCtxMenu {
                                    x: 8px;
                                    y: parent.height - self.height - 8px;
                                    width: 230px;
                                    visible: root.ctx-node != "" && root.ctx-panel == "SOURCE";
                                    menu-title: root.ctx-node;
                                    show-replace: root.ctx-is-dir;
                                    show-copy-output: false;
                                    new-subfolder => { root.batch-ctx-new-subfolder(); }
                                    replace-auto => { root.batch-ctx-replace-auto(); }
                                    replace-manual => { root.batch-ctx-replace-manual(); }
                                    copy-path => { root.batch-ctx-copy-path(); }
                                    copy-output-path => { root.batch-ctx-copy-output-path(); }
                                    delete => { root.batch-ctx-delete(); }
                                    close-menu => { root.batch-close-ctx(); }
                                }
                            }
                        }
                    }

                    // Panel OUTPUT: tree SENDIRI dari folder output di
                    // disk (bukan cermin live SOURCE). "(pending)" bila
                    // folder belum ada; terisi setelah script jalan.
                    out-card := Card {
                        width: (root.content-width - 52px) / 2;
                        VerticalLayout {
                            padding: Design.space-md;
                            spacing: Design.space-sm;

                            HorizontalLayout {
                                height: 24px * root.ui-scale;
                                spacing: 8px * root.ui-scale;
                                Text {
                                    text: "OUTPUT";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 800;
                                    color: Design.text-muted;
                                    letter-spacing: 1px * root.ui-scale;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.selected-output;
                                    font-size: 12px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.text-primary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.batch-out-pending ? "(pending)" : "";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.cat-revision;
                                    vertical-alignment: center;
                                }
                            }
                            HSeparator { }

                            // Input inline subfolder baru (OUTPUT).
                            Rectangle {
                                height: (root.newfolder-open && root.newfolder-panel == "OUTPUT") ? 36px : 0px;
                                visible: root.newfolder-open && root.newfolder-panel == "OUTPUT";
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.newfolder-parent;
                                        font-size: 11px;
                                        color: Design.text-muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    TextField {
                                        placeholder: "Nama subfolder baru…";
                                        text: root.newfolder-name;
                                        edited(name) => { root.newfolder-name = name; }
                                        accepted(name) => { root.newfolder-name = name; root.batch-confirm-new-folder(root.newfolder-name, root.newfolder-panel); }
                                        min-width: 180px;
                                        horizontal-stretch: 1;
                                    }
                                    IconBtn {
                                        glyph: "✓";
                                        variant: "secondary";
                                        scale: 1;
                                        size: 36px;
                                        clicked => { root.batch-confirm-new-folder(root.newfolder-name, root.newfolder-panel); }
                                    }
                                    IconBtn {
                                        glyph: "×";
                                        variant: "ghost";
                                        scale: 1;
                                        size: 36px;
                                        clicked => { root.batch-cancel-new-folder(); }
                                    }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                // Teks kosong (tengah).
                                Text {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    visible: root.out-empty;
                                    text: "Output akan muncul di sini.";
                                    font-size: 12px * root.ui-scale;
                                    color: Design.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Flickable {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    visible: !root.out-empty;
                                    VerticalLayout {
                                        x: 0;
                                        width: out-card.width - 2 * Design.space-md;
                                        spacing: 2px;
                                        for row in root.out-rows:
                                            BatchTreeRow {
                                                row-id: row.id;
                                                row-name: row.name;
                                                row-depth: row.depth;
                                                row-is-dir: row.is-dir;
                                                row-expanded: row.expanded;
                                                row-has-kids: row.has-kids;
                                                row-selected: row.selected;
                                                row-file-count: row.file-count;
                                                panel: "OUTPUT";
                                                row-clicked(panel, id) => { root.batch-row-clicked(panel, id); }
                                                row-right-down(panel, id) => { root.batch-row-right-down(panel, id); }
                                                row-right-up(panel, id) => { root.batch-row-right-up(panel, id); }
                                                row-toggle-expand(panel, id) => { root.batch-toggle-expand(panel, id); }
                                                row-more(panel, id) => { root.batch-open-ctx(panel, id); }
                                            }
                                    }
                                }

                                ctx-dismiss-out := TouchArea {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    visible: root.ctx-node != "" && root.ctx-panel == "OUTPUT";
                                    clicked => { root.batch-close-ctx(); }
                                }

                                // Context menu OUTPUT (tanpa Replace).
                                BatchCtxMenu {
                                    x: 8px;
                                    y: parent.height - self.height - 8px;
                                    width: 230px;
                                    visible: root.ctx-node != "" && root.ctx-panel == "OUTPUT";
                                    menu-title: root.ctx-node;
                                    show-replace: false;
                                    show-copy-output: true;
                                    new-subfolder => { root.batch-ctx-new-subfolder(); }
                                    replace-auto => { root.batch-ctx-replace-auto(); }
                                    replace-manual => { root.batch-ctx-replace-manual(); }
                                    copy-path => { root.batch-ctx-copy-path(); }
                                    copy-output-path => { root.batch-ctx-copy-output-path(); }
                                    delete => { root.batch-ctx-delete(); }
                                    close-menu => { root.batch-close-ctx(); }
                                }
                            }
                            // Baris aksi OUTPUT: BUAT MASTER (fase 2) +
                            // tombol dokumen (▤, placeholder — Master
                            // File Browser DITUNDA, bertahap, lokasinya
                            // di side panel / log panel navigasi button).
                            // Di DALAM panel OUTPUT (dokumen §3.5/§9).
                            HorizontalLayout {
                                height: 36px * root.ui-scale;
                                spacing: 8px * root.ui-scale;
                                Rectangle { horizontal-stretch: 1; }
                                Btn {
                                    label: "⧉ BUAT MASTER";
                                    variant: "secondary";
                                    scale: root.ui-scale;
                                    enabled: !root.batch-running;
                                    clicked => { root.batch-copy-master(); }
                                }
                                IconBtn {
                                    glyph: "▤";
                                    variant: "secondary";
                                    scale: root.ui-scale;
                                    size: 36px;
                                    clicked => { root.show-toast("Master File Browser akan hadir di side panel (bertahap)."); }
                                }
                            }
                        }
                    }
                }

                // Baris A: indikator manifest + Replace. Tombol
                // "▶ Fase 1" DIHAPUS 28 Nov 2026 (persis C#: tidak ada
                // tombol Fase 1 — chip "buat_master" di footer yang
                // menjalankan Fase 1). Manifest: dot hijau = ada
                // (buat_master sudah jalan), merah = belum ada
                // (BUAT MASTER akan error).
                HorizontalLayout {
                    height: 36px * root.ui-scale;
                    spacing: 8px * root.ui-scale;
                    HorizontalLayout {
                        spacing: 6px * root.ui-scale;
                        // Ambil sisa lebar (pola SettingRow) supaya
                        // Replace selalu di ujung kanan — spacer
                        // Rectangle kosong di sini yang membuat tombol
                        // kanan hilang (28 Nov 2026).
                        horizontal-stretch: 1;
                        Text {
                            text: "●";
                            font-size: 10px * root.ui-scale;
                            color: root.has-manifest ? Design.status-success : Design.status-danger;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.has-manifest ? "Manifest: ada" : "Manifest: belum ada";
                            font-size: 12px * root.ui-scale;
                            color: Design.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                    Btn {
                        label: "Replace";
                        variant: "secondary";
                        scale: root.ui-scale;
                        clicked => { root.batch-replace-auto(); }
                    }
                }

                // Footer (dokumen §3.5): TOMBOL SCRIPT MASTER BERNAMA
                // — satu tombol per file .py di Scripts/Master/
                // (nama/urutan dari scripts.json; file "_" dan
                // enabled:false tidak tampil). Klik = ExecuteMaster:
                // proses SEMUA folder SOURCE, OUTPUT terisi, log
                // "[SUCCESS] Batch Selesai.". Kanan: refresh (re-scan
                // SOURCE & OUTPUT) + clear merah (kosongkan daftar).
                // Chip di Flickable horizontal (scroll bila sempit);
                // ↻ + × SELALU di ujung kanan — JANGAN pakai spacer
                // Rectangle kosong sebelum keduanya (spacer itu yang
                // membuat keduanya hilang di 1280/960/520px,
                // 28 Nov 2026); Flickable-lah yang stretch.
                Card {
                    height: 56px * root.ui-scale;
                    HorizontalLayout {
                        x: 0;
                        y: 10px * root.ui-scale;
                        width: 100%;
                        height: 36px * root.ui-scale;
                        padding-left: Design.space-sm * root.ui-scale;
                        padding-right: Design.space-sm * root.ui-scale;
                        spacing: 6px * root.ui-scale;
                        chips-flick := Flickable {
                            horizontal-stretch: 1;
                            // Lebar konten = lebar baris chip (bukan
                            // lebar Flickable): chip di luar lebar
                            // tampil jadi scroll, bukan terpotong.
                            // width eksplisit di chips-row memutus
                            // binding loop (content-width <- row.width
                            // <- content-width).
                            content-width: chips-row.preferred-width;
                            chips-row := HorizontalLayout {
                                width: self.preferred-width;
                                spacing: 6px * root.ui-scale;
                                for s in root.batch-scripts:
                                    Btn {
                                        label: s;
                                        variant: "secondary";
                                        scale: root.ui-scale;
                                        small: true;
                                        enabled: !root.batch-running;
                                        clicked => { root.batch-run-script(s); }
                                    }
                            }
                        }
                        if root.batch-running : Btn {
                            label: "■ Stop";
                            variant: "danger";
                            scale: root.ui-scale;
                            small: true;
                            clicked => { root.batch-stop(); }
                        }
                        IconBtn {
                            glyph: "↻";
                            variant: "ghost";
                            scale: root.ui-scale;
                            size: 36px;
                            clicked => { root.batch-refresh(); }
                        }
                        IconBtn {
                            glyph: "×";
                            variant: "danger";
                            scale: root.ui-scale;
                            size: 36px;
                            clicked => { root.batch-clear(); }
                        }
                    }
                }
            }

            }

            // ----- BATCH: tampilan AWAL = daftar Folder Reguler
            // (28 Nov 2026, menggantikan drop zone — abeng 14:44).
            // Sekolah-diutamakan, satu kolom: nama sekolah besar
            // baris 1, bulan + marketing kecil redup baris 2; tanpa
            // nomor urut; klik satu kali = pilih sekolah, pindah ke
            // treeview. Daftar tampil instan dari cache scan terakhir
            // (DB) + refresh inkremental per bulan di latar; tombol ↻
            // memaksa scan penuh. Folder dadakan di luar Folder
            // Reguler: tombol kecil "Pilih Folder" di header.
            Rectangle {
                x: 0; y: 0;
                width: 100%; height: 100%;
                visible: root.src-empty;
                VerticalLayout {
                    x: 0; y: 0; width: 100%; height: 100%;
                    padding-left: Design.space-xl;
                    padding-right: Design.space-xl;
                    padding-top: Design.space-md;
                    padding-bottom: Design.space-xl;
                    spacing: 8px * root.ui-scale;

                    // Header daftar: grip + BATCH + cari (paling
                    // menonjol, filter-as-you-type) + bulan + ↻.
                    // Sempit: baris 2 = aksi (Pilih Folder, Kelola,
                    // ☰ Tugas, Lepas) rata kanan.
                    // SEMUA kontrol 36px, skala 1 (28 Nov 2026 —
                    // sama seperti header treeview: dulu tombol di
                    // sini 36px*ui-scale ≈63px sementara kotak cari
                    // + dropdown bulan tetap 36px, teks tombol
                    // menggantung ~14px di bawah garis tengah field).
                    VerticalLayout {
                        spacing: 8px * root.ui-scale;
                        HorizontalLayout {
                            spacing: 8px;
                            BatchTearGrip {
                                scale: 1;
                                show: root.show-tear-off;
                                tear-off(x, y) => { root.batch-tear-off(x, y); }
                            }
                            Text {
                                text: "BATCH";
                                font-size: 14px;
                                font-weight: 800;
                                color: Design.text-primary;
                                letter-spacing: 1px;
                                height: 36px;
                                vertical-alignment: center;
                            }
                            TextField {
                                placeholder: "Cari nama sekolah…";
                                text: root.reguler-filter;
                                edited(text) => { root.reguler-filter = text; root.batch-reguler-filter-changed(text); }
                                horizontal-stretch: 1;
                            }
                            ComboBox {
                                width: root.narrow ? 140px : 160px;
                                model: root.reguler-months;
                                current-index <=> root.reguler-month-idx;
                                selected(index) => { root.batch-reguler-month-picked(index); }
                            }
                            IconBtn {
                                glyph: "↻";
                                variant: "ghost";
                                scale: 1;
                                size: 36px;
                                clicked => { root.batch-reguler-refresh(); }
                            }
                            if !root.narrow : BatchListActions {
                                scale: 1;
                                show-tear-off: root.show-tear-off;
                                pick-folder() => { root.batch-pick-folder(); }
                                reguler-manage() => { root.batch-reguler-manage(); }
                                open-task-manager() => { root.batch-open-task-manager(); }
                                tear-off-center() => { root.batch-tear-off-center(); }
                            }
                        }
                        if root.narrow : HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            BatchListActions {
                                scale: 1;
                                show-tear-off: root.show-tear-off;
                                pick-folder() => { root.batch-pick-folder(); }
                                reguler-manage() => { root.batch-reguler-manage(); }
                                open-task-manager() => { root.batch-open-task-manager(); }
                                tear-off-center() => { root.batch-tear-off-center(); }
                            }
                        }
                    }

                    // Status scan ("N sekolah" / "Memindai…" /
                    // "Tidak ada sekolah" / "Pilih direktori dulu") —
                    // hanya bila ada baris; saat kosong, status tampil
                    // di tengah (blok kosong di bawah).
                    if root.reguler-scan-rows.length > 0 : Text {
                        text: root.reguler-scan-status;
                        font-size: 11px * root.ui-scale;
                        color: Design.text-muted;
                        vertical-alignment: center;
                    }

                    // Daftar sekolah (satu kolom). Baris: nama besar
                    // (satu baris elide) + bulan · marketing kecil
                    // redup. Klik satu kali = buka treeview.
                    // TINGGI BARIS: eksplisit = preferred-height VL
                    // dalam. Tanpa ini, Flickable meregangkan VL
                    // konten ke tinggi viewport dan Slint 1.19 membagi
                    // ruang ekstra ke semua baris (tanpa stretch pun)
                    // sehingga tiap baris jadi ~163px, bukan ~77px
                    // (defect 28 Nov 2026; pola sama seperti baris
                    // tree yang pakai height eksplisit 36px/26px).
                    // BUNGKUS: pola sama seperti panel tree — Flickable
                    // di dalam Rectangle stretch+clip dengan width/
                    // height 100%; Flickable sebagai anak langsung
                    // layout membuat konten tidak rata atas (daftar
                    // terdorong ke bawah, defect 28 Nov 2026).
                    if root.reguler-scan-rows.length > 0 : Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        list-scroll := Flickable {
                            x: 0; y: 0; width: 100%; height: 100%;
                            VerticalLayout {
                                width: list-scroll.width;
                                spacing: 2px;
                            for r[idx] in root.reguler-scan-rows : Rectangle {
                                height: list-row-inner.preferred-height;
                                background: list-row-touch.has-hover ? Design.bg-hover : transparent;
                                border-radius: Design.radius-sm;
                                list-row-touch := TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    mouse-cursor: pointer;
                                    clicked => { root.batch-list-open-school(idx); }
                                }
                                // Lebar eksplisit = lebar baris: VL anak
                                // Rectangle (bukan dalam layout) hanya
                                // selebar kontennya bila tanpa width.
                                list-row-inner := VerticalLayout {
                                    width: parent.width;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 6px * root.ui-scale;
                                    padding-bottom: 6px * root.ui-scale;
                                    spacing: 2px;
                                    Text {
                                        text: r.sekolah;
                                        font-size: 14px * root.ui-scale;
                                        font-weight: 700;
                                        color: Design.text-primary;
                                        // Satu baris elide (BUKAN wrap):
                                        // nama realistis (≤60 karakter)
                                        // tetap kebaca penuh di 520px.
                                        overflow: elide;
                                    }
                                    Text {
                                        // Baris 2: bulan · marketing · N <ekstensi>
                                        // (angka dari cache scan; -1 = belum
                                        // dihitung → tidak tampil, layout satu
                                        // kolom tetap utuh).
                                        text: r.bulan + (r.marketing != "" ? " · " + r.marketing : "") + (r.file-count >= 0 ? " · " + r.file-count + " " + root.batch-file-count-ext-label : "");
                                        font-size: 11px * root.ui-scale;
                                        color: Design.text-muted;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                    }
                    // Kosong: status scan menjelaskan kenapa (belum ada
                    // direktori / sedang memindai / tidak ada yang cocok).
                    if root.reguler-scan-rows.length == 0 : Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            width: parent.width;
                            alignment: center;
                            spacing: 8px * root.ui-scale;
                            Text {
                                text: root.reguler-scan-status;
                                font-size: 13px * root.ui-scale;
                                color: Design.text-muted;
                                horizontal-alignment: center;
                            }
                            if root.reguler-scan-status == "Pilih direktori dulu" : Text {
                                text: "Tambah direktori lewat Kelola, atau pilih folder langsung.";
                                font-size: 12px * root.ui-scale;
                                color: Design.text-muted;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

    // Popup Kelola Folder Reguler — MANAJEMEN DIREKTORI saja
    // (28 Nov 2026): tabel sekolah pindah ke tampilan daftar utama;
    // di sini hanya direktori tersimpan (status, kunci, konteks
    // output) + tambah/hapus. Tinggi mengikuti konten.
    if root.reguler-manage-open : Rectangle {
        x: 0; y: 0;
        width: 100%; height: 100%;
        background: #80000000;
        reguler-dim-touch := TouchArea {
            clicked => { root.batch-reguler-close(); }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right) {
                    root.batch-reguler-close();
                }
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(760px * root.ui-scale, parent.width - 32px);
            background: Design.surface-elevated;
            border-color: Design.border-hover;
            border-width: 1px;
            border-radius: Design.radius-md;
            VerticalLayout {
                padding: Design.space-md;
                spacing: Design.space-sm;
                HorizontalLayout {
                    height: 28px * root.ui-scale;
                    spacing: 8px * root.ui-scale;
                    Text {
                        text: "Folder Reguler";
                        font-size: 14px * root.ui-scale;
                        font-weight: 800;
                        color: Design.text-primary;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconBtn {
                        glyph: "×";
                        variant: "ghost";
                        scale: root.ui-scale;
                        size: 28px;
                        clicked => { root.batch-reguler-close(); }
                    }
                }
                HSeparator { }
                Text {
                    text: "Direktori tersimpan";
                    font-size: 11px * root.ui-scale;
                    font-weight: 800;
                    color: Design.text-muted;
                    letter-spacing: 1px * root.ui-scale;
                }
                reguler-dirs-scroll := Flickable {
                    height: 132px;
                    reguler-dirs-layout := VerticalLayout {
                        spacing: 2px;
                        for d[idx] in root.reguler-dirs : Rectangle {
                            height: 32px;
                            background: root.reguler-scan-dir-idx == idx ? Design.accent-subtle : (dir-touch.has-hover ? Design.bg-hover : transparent);
                            border-radius: Design.radius-sm;
                            dir-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.batch-reguler-select-dir(idx); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text {
                                    text: "●";
                                    font-size: 10px;
                                    color: d.status == "ready" ? Design.status-success : d.status == "empty" ? Design.status-warning : d.status == "missing" ? Design.status-danger : d.status == "inuse" ? Design.accent : Design.text-muted;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    spacing: 0px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: d.name + "  ·  " + d.status-label;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Design.text-primary;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: d.last-output != "" ? d.path + "  →  " + d.last-output : d.path;
                                        font-size: 11px;
                                        color: Design.text-muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                IconBtn {
                                    glyph: d.locked ? "🔒" : "🔓";
                                    variant: "ghost";
                                    scale: 1;
                                    size: 28px;
                                    clicked => { root.batch-reguler-toggle-lock(idx); }
                                }
                                IconBtn {
                                    glyph: "×";
                                    variant: "ghost";
                                    scale: 1;
                                    size: 28px;
                                    opacity: d.locked ? 0.35 : 1;
                                    clicked => { root.batch-reguler-remove(idx); }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 32px * root.ui-scale;
                    spacing: 8px * root.ui-scale;
                    Btn {
                        label: "+ Tambah…";
                        variant: "secondary";
                        scale: root.ui-scale;
                        small: true;
                        clicked => { root.batch-reguler-add(); }
                    }
                    Text {
                        text: "Klik direktori untuk memindai sekolah di dalamnya (tampil di daftar). Kunci = tidak bisa dihapus.";
                        font-size: 11px * root.ui-scale;
                        color: Design.text-muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                }
                HSeparator { }
                HorizontalLayout {
                    height: 36px * root.ui-scale;
                    spacing: 8px * root.ui-scale;
                    alignment: end;
                    Btn {
                        label: "Tutup";
                        variant: "ghost";
                        scale: root.ui-scale;
                        clicked => { root.batch-reguler-close(); }
                    }
                }
            }
        }
    }
}
