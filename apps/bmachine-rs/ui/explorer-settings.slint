// EXPLORER SETTINGS — tampilan pengaturan Explorer tersendiri
// (C#: ExplorerSettingsView terpisah, BUKAN grup Settings —
// Settings C# hanya 7 grup: General, Appearance, Account, Extensions,
// Script Manager, Paths, About; SettingsView.axaml:307-345).
// Dipindah dari grup "Explorer" di ui/settings.slint (P1, 27 Nov 2026).
// Dibuka dari tombol "⚙ Explorer" di sidebar Explorer (overlay
// "EXPLORER-SETTINGS" di ui/main.slint). Klik kanan = kembali
// (pola yang sama dengan SettingsView — tanpa tombol "← Kembali").

import { Design, HSeparator, Btn, TextField, Toggle, ComboBox } from "design.slint";

// Chip pilihan (salinan dari ui/settings.slint — tiap file mendefinisikan
// sendiri; komponen lokal tidak bisa diimpor antar file di Slint 1.19).
component OptionChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    // Tinggi 36px — SAMA dengan TextField / ThemeRow / Btn (satu tinggi kontrol di semua section).
    height: 36px;
    background: selected ? Design.accent-subtle : (ochip-touch.has-hover ? Design.bg-hover : transparent);
    border-color: selected ? Design.accent : Design.separator;
    border-width: 1px;
    border-radius: Design.radius-sm;
    ochip-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: label;
            font-size: Design.font-button;
            font-weight: 600;
            color: selected ? Design.accent : Design.text-primary;
            vertical-alignment: center;
        }
    }
}

// Label + deskripsi satu opsi (judul 13/700, deskripsi 11 sekunder).
component FieldLabel inherits VerticalLayout {
    in property <string> title;
    in property <string> desc;
    spacing: 2px;
    Text {
        text: title;
        font-size: Design.font-body;
        font-weight: 700;
        color: Design.text-primary;
        vertical-alignment: top;
        vertical-stretch: 0;
        // Judul ikut wrap supaya tidak terpotong di kolom sempit
        // (lih. FieldLabel di ui/settings.slint).
        wrap: word-wrap;
    }
    Text {
        text: desc;
        font-size: Design.font-caption;
        color: Design.text-secondary;
        wrap: word-wrap;
        visible: desc != "";
        // WAJIB top: Text ber-wrap diregangkan vertikal oleh layout
        // bila baris lebih tinggi dari label — tanpa ini teks deskripsi
        // melayang ke tengah baris (28 Nov 2026, lih. SettingRow).
        vertical-alignment: top;
        vertical-stretch: 0;
    }
    // Penyerap ruang ekstra (tak terlihat, tinggi natural 0) — lih.
    // FieldLabel di ui/settings.slint: tanpa ini layout Slint membagi
    // rata ruang ekstra ke judul + deskripsi bila baris lebih tinggi.
    Rectangle { vertical-stretch: 1; }
}

// Baris setting horizontal (pola SettingRow di ui/settings.slint):
// label + subtext di KIRI, kontrol di KANAN secukupnya lebarnya;
// saat `stacked` kontrol pindah ke BAWAH label. Kontrol ditulis
// SEKALI sebagai @children; lebarnya diatur di tiap pemakaian.
component ExpSettingRow inherits VerticalLayout {
    in property <string> title;
    in property <string> desc;
    in property <bool> stacked;
    spacing: 6px;
    if stacked : FieldLabel { title: title; desc: desc; }
    HorizontalLayout {
        spacing: 16px;
        if !stacked : FieldLabel { title: title; desc: desc; horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            spacing: 8px;
            horizontal-stretch: stacked ? 1 : 0;
            @children
        }
    }
}

export component ExplorerSettingsView inherits Rectangle {
    callback toast(string);
    callback browse-path(string);
    callback save-explorer-settings();
    callback back();

    // --- Explorer (dari ExplorerSettings C#; dulu grup Settings) ---
    in-out property <string> exp-path: "";
    in-out property <string> exp-view: "Details";
    in-out property <string> exp-sort: "Name";
    in-out property <string> exp-group: "None";
    in-out property <bool> exp-hidden: false;
    in-out property <bool> exp-ext: true;
    in-out property <int> exp-zoom: 100;
    in-out property <bool> exp-showbar: true;
    in-out property <string> exp-font: "Inter";
    // Gaya toggle on/off ("classic" | "pill" | "outline") — diikat
    // dari AppWindow (app-toggle-style), lihat DESIGN_SYSTEM.md §5.2.
    in-out property <string> toggle-style: "classic";

    // Menumpuk saat lebar view < 560px (window 520) — kontrol pindah
    // ke bawah label (pola SettingRow di ui/settings.slint §17.4).
    property <bool> stacked: self.width < 560px;

    // Klik kanan = kembali ke Explorer (C# OnEmbeddedViewPointerPressed:
    // klik kanan = NavigateBack). TouchArea latar di belakang isi.
    ex-settings-back-touch := TouchArea {
        width: 100%; height: 100%;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.back();
            }
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: Design.space-xl;
        padding-right: Design.space-xl;
        padding-bottom: 30px;
        spacing: Design.space-md;

        Text {
            text: "Explorer Settings";
            font-size: Design.font-h2;
            font-weight: 800;
            color: Design.text-primary;
            vertical-alignment: center;
            height: 30px;
        }

        Flickable {
            width: 100%;
            height: 100%;
            VerticalLayout {
                width: 100%;
                spacing: Design.space-lg;
                padding-bottom: Design.space-lg;
                // Isi rapat di atas (alignment start): tanpa ini,
                // konten yang lebih pendek dari viewport direnggangkan
                // ke tinggi penuh — lih. DESIGN_SYSTEM.md §17.4.
                alignment: start;

                ExpSettingRow {
                    title: "Default Explorer Path";
                    desc: "Folder yang dibuka pertama kali oleh Explorer";
                    stacked: root.stacked;
                    HorizontalLayout {
                        spacing: 8px;
                        width: root.stacked ? parent.width : 420px;
                        TextField {
                            horizontal-stretch: 1;
                            text: root.exp-path;
                            placeholder: "Pilih folder…";
                            edited(text) => { root.exp-path = text; }
                            accepted(text) => { root.save-explorer-settings(); }
                        }
                        Btn {
                            label: "Browse";
                            variant: "secondary";
                            clicked => { root.browse-path("explorer"); }
                        }
                    }
                }
                ExpSettingRow {
                    title: "View Mode";
                    desc: "Tampilan daftar file Explorer";
                    stacked: root.stacked;
                    // 5 pilihan jadi dropdown (dulu 5 chip dalam 3
                    // baris — boros 120px vertikal); nilai & simpan
                    // tetap sama.
                    ComboBox {
                        width: root.stacked ? parent.width : 200px;
                        model: ["Details", "List", "Thumbnails", "Tiles", "Split"];
                        current-index: root.exp-view == "Details" ? 0 : root.exp-view == "List" ? 1 : root.exp-view == "Thumbnails" ? 2 : root.exp-view == "Tiles" ? 3 : 4;
                        selected(index) => {
                            if (index == 0) { root.exp-view = "Details"; }
                            else if (index == 1) { root.exp-view = "List"; }
                            else if (index == 2) { root.exp-view = "Thumbnails"; }
                            else if (index == 3) { root.exp-view = "Tiles"; }
                            else { root.exp-view = "Split"; }
                            root.save-explorer-settings();
                        }
                    }
                }
                ExpSettingRow {
                    title: "Sort";
                    desc: "Urutan file di Explorer";
                    stacked: root.stacked;
                    HorizontalLayout {
                        spacing: 6px;
                        OptionChip {
                            label: "Name";
                            horizontal-stretch: 1;
                            selected: root.exp-sort == "Name";
                            clicked => { root.exp-sort = "Name"; root.save-explorer-settings(); }
                        }
                        OptionChip {
                            label: "Date";
                            horizontal-stretch: 1;
                            selected: root.exp-sort == "Date";
                            clicked => { root.exp-sort = "Date"; root.save-explorer-settings(); }
                        }
                        OptionChip {
                            label: "Type";
                            horizontal-stretch: 1;
                            selected: root.exp-sort == "Type";
                            clicked => { root.exp-sort = "Type"; root.save-explorer-settings(); }
                        }
                    }
                }
                ExpSettingRow {
                    title: "Group";
                    desc: "Pengelompokan file di Explorer";
                    stacked: root.stacked;
                    HorizontalLayout {
                        spacing: 6px;
                        OptionChip {
                            label: "None";
                            horizontal-stretch: 1;
                            selected: root.exp-group == "None";
                            clicked => { root.exp-group = "None"; root.save-explorer-settings(); }
                        }
                        OptionChip {
                            label: "Date";
                            horizontal-stretch: 1;
                            selected: root.exp-group == "Date";
                            clicked => { root.exp-group = "Date"; root.save-explorer-settings(); }
                        }
                        OptionChip {
                            label: "Type";
                            horizontal-stretch: 1;
                            selected: root.exp-group == "Type";
                            clicked => { root.exp-group = "Type"; root.save-explorer-settings(); }
                        }
                    }
                }
                ExpSettingRow {
                    title: "Show hidden files";
                    desc: "Tampilkan file & folder tersembunyi";
                    stacked: root.stacked;
                    Toggle {
                        toggle-style: root.toggle-style;
                        checked: root.exp-hidden;
                        toggled(checked) => { root.exp-hidden = checked; root.save-explorer-settings(); }
                    }
                }
                ExpSettingRow {
                    title: "Show file extensions";
                    desc: "Tampilkan ekstensi file (.psd, .jpg, …)";
                    stacked: root.stacked;
                    Toggle {
                        toggle-style: root.toggle-style;
                        checked: root.exp-ext;
                        toggled(checked) => { root.exp-ext = checked; root.save-explorer-settings(); }
                    }
                }
                ExpSettingRow {
                    title: "Show path bar";
                    desc: "Tampilkan baris navigasi (Back/Forward/Up + address bar)";
                    stacked: root.stacked;
                    Toggle {
                        toggle-style: root.toggle-style;
                        checked: root.exp-showbar;
                        toggled(checked) => { root.exp-showbar = checked; root.save-explorer-settings(); }
                    }
                }
                ExpSettingRow {
                    title: "Explorer Font";
                    desc: "Font teks Explorer (default Inter)";
                    stacked: root.stacked;
                    TextField {
                        width: root.stacked ? parent.width : 200px;
                        text: root.exp-font;
                        placeholder: "Inter";
                        edited(text) => { root.exp-font = text; }
                        accepted(text) => { root.save-explorer-settings(); }
                    }
                }
                ExpSettingRow {
                    title: "Content zoom";
                    desc: "Zoom konten Explorer (75–200%)";
                    stacked: root.stacked;
                    HorizontalLayout {
                        spacing: 8px;
                        Btn {
                            label: "−";
                            variant: "secondary";
                            clicked => { root.exp-zoom = max(75, root.exp-zoom - 25); root.save-explorer-settings(); }
                        }
                        Text {
                            width: 56px;
                            text: root.exp-zoom + "%";
                            font-size: Design.font-body;
                            font-weight: 700;
                            color: Design.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Btn {
                            label: "+";
                            variant: "secondary";
                            clicked => { root.exp-zoom = min(200, root.exp-zoom + 25); root.save-explorer-settings(); }
                        }
                    }
                }
            }
        }
    }
}
