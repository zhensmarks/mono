// Floating Widget / Smart Orb — tiruan FloatingWidgetView C#
// (FloatingWidgetView.axaml.cs + FloatingWidgetViewModel.cs):
// Window orb borderless transparan 100x100 di desktop (Topmost,
// tidak di taskbar), orb 60px + glow bernapas (durasi ikut
// Settings.Orb.Speed: Slow 4s / Normal 2.5s / Fast 1s; mati bila
// Settings.Orb.Breathing false). Klik kiri orb = expand ke menu
// 440x210 (default; ukuran tersimpan Settings.Orb.ExpandedWidth/
// Height); klik kanan = collapse ke orb (C# GoHome). Drag klik-kiri
// orb (ambang 5px) = pindah window, posisi tersimpan
// Configs.Widget.Position.X/Y. Menu: nav Master (.py di Scripts/
// Master) / Action (.jsx di Scripts/Action + .pyw di Scripts) +
// daftar tombol script; klik item = jalankan (jalur execute-script
// yang sama dengan radial — saat ini toast, eksekusi nyata ikut
// Fase 6 seperti radial/toolbox). Resize handle kanan-bawah di mode
// expand (min 300x150, C#). Warna aksen dari Settings.Color.Orb.
//
// Penyimpangan dari C# (dicatat): daftar item vertikal + Flickable
// (C# WrapPanel horizontal); drag & drop antar-item belum ada
// (C# ReorderItem); menu "Others" tidak ditampilkan (C# sudah
// menghapus tombol nav ke-3-nya juga).

import { Design, SvgIcon } from "design.slint";

// Satu tombol item script di menu (160x36 C#, di sini lebar penuh
// area konten; klik = jalankan).
component FloatingItemButton inherits Rectangle {
    in property <string> item-name;
    in property <color> accent;
    callback execute(string);

    height: 36px;
    background: root.accent;
    border-radius: 8px;
    item-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.execute(root.item-name); }
    }
    Text {
        text: root.item-name;
        font-size: 12px;
        font-weight: 700;
        color: #ffffff;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component FloatingWidgetWindow inherits Window {
    title: "Floating Widget";
    // Ukuran window mengikuti mode: 100x100 saat orb, ukuran
    // tersimpan saat menu. Binding (bukan set_size dari Rust):
    // set_size() dari Rust me-resize jendela X11 tapi properti
    // width Slint tidak ikut berubah (hasil tes: menu hanya
    // ter-render 100px lebar, sisanya transparan) — dengan binding,
    // Slint sendiri yang me-resize window OS saat expanded berubah.
    width: root.expanded ? root.expanded-width * 1px : 100px;
    height: root.expanded ? root.expanded-height * 1px : 100px;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    default-font-family: Design.font-family;

    in-out property <bool> expanded: false;
    in-out property <color> accent-color: #3b82f6;
    in-out property <bool> breathing: true;
    in-out property <int> speed-index: 1; // 0 Slow, 1 Normal, 2 Fast
    in-out property <[string]> master-items: [];
    in-out property <[string]> action-items: [];
    in-out property <string> active-menu: "Master";
    in-out property <int> expanded-width: 440;
    in-out property <int> expanded-height: 210;

    callback toggle-expand();
    callback collapse();
    callback move-window(length, length);
    callback resize-window(length, length);
    callback save-position();
    callback save-expanded-size();
    callback execute-item(string);
    callback toast(string);

    property <duration> breath-duration: root.speed-index == 0 ? 4s : root.speed-index == 2 ? 1s : 2.5s;
    property <bool> glow-high: true;
    property <float> glow-opacity: 0.28;
    animate glow-opacity { duration: root.breath-duration; }

    breath-timer := Timer {
        interval: root.breath-duration;
        running: root.breathing && !root.expanded;
        triggered() => {
            root.glow-high = !root.glow-high;
            root.glow-opacity = root.glow-high ? 0.28 : 0.10;
        }
    }

    // ===== Mode orb (collapsed, 100x100) =====
    if !root.expanded : Rectangle {
        width: 100%; height: 100%;
        background: transparent;

        // Glow bernapas di belakang orb.
        Rectangle {
            x: 14px; y: 14px; width: 72px; height: 72px;
            border-radius: 36px;
            background: root.accent-color;
            opacity: root.breathing ? root.glow-opacity : 0.12;
        }

        // Orb 60px (C#: margin 20, border 2px aksen, radius 30).
        Rectangle {
            x: 20px; y: 20px; width: 60px; height: 60px;
            border-radius: 30px;
            background: Design.card-bg;
            border-color: root.accent-color;
            border-width: 2px;

            SvgIcon {
                name: "layers";
                size: 26px;
                icon-color: root.accent-color;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        orb-touch := TouchArea {
            x: 20px; y: 20px; width: 60px; height: 60px;
            mouse-cursor: pointer;
            property <length> press-x: 0px;
            property <length> press-y: 0px;
            property <bool> dragging: false;
            property <bool> possible-click: false;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    self.press-x = self.mouse-x;
                    self.press-y = self.mouse-y;
                    self.dragging = false;
                    self.possible-click = true;
                } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    root.collapse();
                } else if (ev.kind == PointerEventKind.up) {
                    if (self.dragging) {
                        self.dragging = false;
                        root.save-position();
                    } else if (self.possible-click) {
                        self.possible-click = false;
                        root.toggle-expand();
                    }
                } else if (ev.kind == PointerEventKind.move && self.possible-click) {
                    if (abs(self.mouse-x - self.press-x) > 5px || abs(self.mouse-y - self.press-y) > 5px) {
                        self.dragging = true;
                        self.possible-click = false;
                    }
                } else if (ev.kind == PointerEventKind.move && self.dragging) {
                    root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
                }
            }
        }
    }

    // ===== Mode menu (expanded, 440x210 default) =====
    if root.expanded : Rectangle {
        width: 100%; height: 100%;
        background: Design.card-bg;
        border-color: Design.separator;
        border-width: 1px;
        border-radius: 12px;
        clip: true;

        menu-touch := TouchArea {
            width: 100%; height: 100%;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    root.collapse();
                }
            }
        }

        // Kolom nav 64px (C#: Grid 64 / 1 / *), vertikal tengah.
        VerticalLayout {
            x: 10px; y: 10px; width: 64px; height: parent.height - 20px;
            alignment: center;
            spacing: 8px;

                // Master (.py) — ikon terminal (C#: IconPython).
                Rectangle {
                    width: 42px; height: 42px;
                    border-radius: 21px;
                    background: root.active-menu == "Master" ? root.accent-color : transparent;
                    nav-master-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-menu = "Master"; }
                    }
                    SvgIcon {
                        name: "terminal";
                        size: 20px;
                        icon-color: root.active-menu == "Master" ? #ffffff : Design.text-primary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                // Action (.jsx/.pyw) — ikon zap (C#: IconBolt).
                Rectangle {
                    width: 42px; height: 42px;
                    border-radius: 21px;
                    background: root.active-menu == "Action" ? root.accent-color : transparent;
                    nav-action-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-menu = "Action"; }
                    }
                    SvgIcon {
                        name: "zap";
                        size: 20px;
                        icon-color: root.active-menu == "Action" ? #ffffff : Design.text-primary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Separator 1px.
            Rectangle {
                x: 74px; y: 10px; width: 1px; height: parent.height - 20px;
                background: #30ffffff;
            }

            // Area konten: daftar tombol script (scroll bila panjang).
            // Flickable di dalam Rectangle berukuran eksplisit (pola
            // explorer.slint); lebar child mengikat Rectangle, bukan
            // Flickable — mengikat Flickable sendiri membuat rantai
            // lebar melingkar dan konten menciut ke ~23px.
            content-area := Rectangle {
                x: 85px; y: 10px; width: root.width - 95px; height: root.height - 20px;
                Flickable {
                    width: 100%; height: 100%;
                    VerticalLayout {
                        width: content-area.width;
                        spacing: 4px;

                    if root.active-menu == "" : Text {
                        text: "Select Category";
                        font-size: 12px;
                        color: Design.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if root.active-menu == "Master" && root.master-items.length == 0 : Text {
                        text: "Tidak ada script Master (.py di Scripts/Master)";
                        font-size: 12px;
                        color: Design.text-muted;
                        vertical-alignment: center;
                    }
                    if root.active-menu == "Action" && root.action-items.length == 0 : Text {
                        text: "Tidak ada script Action (.jsx di Scripts/Action, .pyw di Scripts)";
                        font-size: 12px;
                        color: Design.text-muted;
                        vertical-alignment: center;
                    }

                    if root.active-menu == "Master" : VerticalLayout {
                        spacing: 4px;
                        for item in root.master-items : FloatingItemButton {
                            item-name: item;
                            accent: root.accent-color;
                            execute(name) => { root.execute-item(name); }
                        }
                    }
                    if root.active-menu == "Action" : VerticalLayout {
                        spacing: 4px;
                        for item in root.action-items : FloatingItemButton {
                            item-name: item;
                            accent: root.accent-color;
                            execute(name) => { root.execute-item(name); }
                        }
                    }
                }
            }
        }

        // Resize handle kanan-bawah (C#: segitiga 16x16, min 300x150).
        Rectangle {
            x: parent.width - 16px; y: parent.height - 16px;
            width: 16px; height: 16px;
            background: transparent;
            Path {
                x: 0px; y: 0px; width: 16px; height: 16px;
                fill: #40ffffff;
                commands: "M16,16 L16,6 L6,16 Z";
            }
            resize-touch := TouchArea {
                mouse-cursor: pointer;
                property <length> press-x: 0px;
                property <length> press-y: 0px;
                property <bool> resizing: false;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        self.press-x = self.mouse-x;
                        self.press-y = self.mouse-y;
                        self.resizing = true;
                    } else if (ev.kind == PointerEventKind.up) {
                        if (self.resizing) {
                            self.resizing = false;
                            root.save-expanded-size();
                        }
                    } else if (ev.kind == PointerEventKind.move && self.resizing) {
                        root.resize-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
                    }
                }
            }
        }
    }
}
