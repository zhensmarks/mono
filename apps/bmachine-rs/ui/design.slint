// ============================================================
// BMachine Design System — Rust/Slint
// Token & komponen bersama. SATU-SATUNYA sumber kebenaran visual.
// Jangan hardcode warna/radius/font di view — pakai token di sini.
// Lihat DESIGN_SYSTEM.md untuk aturan lengkapnya.
// ============================================================

export global Design {
    // ---------- Warna: tema gelap (sama seperti C# DarkTheme) ----------
    in-out property <color> app-bg: #121212;
    in-out property <color> card-bg: #1A1C20;
    // Default navigation tokens; account and Home/Batch remain independently configurable.
    in-out property <color> nav-pill-bg: #1A1C20;
    in-out property <color> nav-pill-border: #26282C;
    in-out property <length> nav-pill-radius: 999px;
    in-out property <length> nav-gap: 12px;
    in-out property <color> nav-selected-bg: #F4F4F5;
    in-out property <color> nav-selected-fg: #18181B;
    in-out property <color> nav-unselected-fg: #A1A1AA;
    in-out property <color> surface-elevated: #202226;
    in-out property <color> separator: #26282C;
    in-out property <color> text-primary: #FFFFFF;
    in-out property <color> text-secondary: #999999;
    in-out property <color> text-muted: #71717A;
    in-out property <color> accent: #3b82f6;
    in-out property <color> accent-subtle: #1F2B40;
    in-out property <color> bg-hover: #22272B;
    in-out property <color> bg-input: #0C0C0E;
    in-out property <color> border-default: #232326;
    in-out property <color> border-hover: #3F3F46;
    in-out property <color> border-focus: #4B4B52;
    in-out property <color> ghost-hover: #28282D;
    in-out property <color> ghost-pressed: #313136;
    in-out property <color> toggle-off-bg: #2A2A2A;

    // ---------- Status ----------
    in-out property <color> status-danger: #ef4444;
    in-out property <color> status-success: #4ade80;
    in-out property <color> status-warning: #f59e0b;

    // ---------- Kategori kartu Trello ----------
    in-out property <color> cat-editing: #3b82f6;
    in-out property <color> cat-revision: #f97316;
    in-out property <color> cat-late: #ef4444;
    in-out property <color> cat-points: #2dd4bf;

    // ---------- Baris tugas selesai (checklist dashboard) ----------
    in-out property <color> done-row-bg: #173F2D;
    in-out property <color> done-row-border: #3FAF78;
    in-out property <color> done-text: #45C98A;
    in-out property <color> done-text-alt: #9DE8C1;
    in-out property <color> row-border-idle: #46505C;
    in-out property <color> row-text-dim: #7B8794;
    in-out property <color> row-text-alt: #AAB4BF;

    // ---------- Overlay & medali ----------
    in-out property <color> overlay-dim: #00000080;
    in-out property <color> overlay-solid: #000000;
    in-out property <color> medal-bronze: #cd7f32;


    // ---------- Tombol ----------
    in-out property <color> btn-primary-bg: #EDEDED;
    in-out property <color> btn-primary-bg-hover: #FFFFFF;
    in-out property <color> btn-primary-bg-pressed: #D4D4D4;
    in-out property <color> btn-primary-fg: #111111;
    in-out property <color> btn-secondary-bg: #1C1C1F;
    in-out property <color> btn-secondary-bg-hover: #27272B;
    in-out property <color> btn-secondary-bg-pressed: #222226;
    in-out property <color> btn-secondary-fg: #E4E4E7;
    in-out property <color> btn-secondary-border: #3F3F46;
    in-out property <color> btn-danger-bg: #1C0F0F;
    in-out property <color> btn-danger-bg-hover: #2A1010;
    in-out property <color> btn-danger-fg: #A05252;
    in-out property <color> btn-danger-border: #5A2020;

    // ---------- Radius ----------
    in-out property <length> radius-xxs: 2px;
    in-out property <length> radius-xs: 4px;
    in-out property <length> radius-sm: 6px;
    in-out property <length> radius-md: 8px;
    in-out property <length> radius-lg: 10px;
    in-out property <length> radius-xl: 12px;
    in-out property <length> radius-pill: 999px;

    // ---------- Spacing ----------
    in-out property <length> space-xs: 4px;
    in-out property <length> space-sm: 8px;
    in-out property <length> space-md: 12px;
    in-out property <length> space-lg: 16px;
    in-out property <length> space-xl: 20px;

    // ---------- Font ----------
    in-out property <string> font-family: "Inter";
    in-out property <float> density-scale: 1.0;
    in-out property <length> font-caption: 11px;
    in-out property <length> font-button: 12px;
    in-out property <length> font-body: 13px;
    in-out property <length> font-h3: 14px;
    in-out property <length> font-h2: 18px;
    in-out property <length> font-h1: 24px;

    // ---------- Window ----------
    in-out property <length> window-min-width: 520px;
    // window-width/window-height DIHAPUS 27 Nov 2026: ukuran awal window
    // utama di-set dari Rust (main.rs) — Slint melarang width + min-width
    // pada satu Window. Nilai awal tetap 960x640 (lihat main.rs).

    // ---------- Durasi transisi ----------
    in-out property <duration> anim-fast: 120ms;
    in-out property <duration> anim-normal: 150ms;
    in-out property <duration> anim-slow: 250ms;
}

// ============================================================
// SvgIcon — Open-source Lucide vector icons (24x24 viewbox).
// ============================================================
export component SvgIcon inherits Rectangle {
    in property <string> name;
    in property <color> icon-color: Design.text-primary;
    in property <length> size: 16px;
    in property <float> stroke-width: 1.8;

    width: size;
    height: size;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.icon-color;
        stroke-width: root.stroke-width * 1px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: root.name == "home" ? "M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10"
            : root.name == "layers" ? "M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5 M2 12l10 5 10-5"
            : root.name == "settings" ? "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
            : root.name == "sun" ? "M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10z M12 1v2 M12 21v2 M4.22 4.22l1.42 1.42 M18.36 18.36l1.42 1.42 M1 12h2 M21 12h2 M4.22 19.78l1.42-1.42 M18.36 5.64l1.42-1.42"
            : root.name == "user" ? "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"
            : root.name == "puzzle" ? "M19.4 7.85c-.05.32.06.65.29.88l1.57 1.57c.47.47.7.99.7 1.7s-.23 1.23-.7 1.7l-1.61 1.61a.98.98 0 0 1-.84.28c-.47-.07-.8-.48-.97-.93a2.5 2.5 0 1 0-3.21 3.21c.45.17.86.5.93.97a.98.98 0 0 1-.28.84l-1.61 1.61a2.4 2.4 0 0 1-3.41 0l-1.57-1.57a1.03 1.03 0 0 0-.88-.29c-.49.07-.84.5-1.02.97a2.5 2.5 0 1 1-3.24-3.24c.46-.18.89-.53.97-1.02a1.03 1.03 0 0 0-.29-.88L2.7 13.7A2.4 2.4 0 0 1 2 12c0-.62.24-1.23.7-1.7L4.23 8.77c.24-.24.58-.35.92-.3.51.08.88.53 1.07 1.01a2.5 2.5 0 1 0 3.26-3.26c-.48-.2-.93-.56-1.01-1.07-.05-.34.06-.68.3-.92L10.3 2.7A2.4 2.4 0 0 1 12 2c.62 0 1.23.24 1.7.7l1.57 1.57c.23.23.56.34.88.29.49-.07.84-.5 1.02-.97a2.5 2.5 0 1 1 3.24 3.24c-.46.18-.89.53-.97 1.02z"
            : root.name == "zap" ? "M13 2L3 14h9l-1 8 10-12h-9l1-8z"
            : root.name == "folder" ? "M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
            : root.name == "folder-open" ? "M6 14l1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"
            : root.name == "info" ? "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 16v-4 M12 8h.01"
            : root.name == "search" ? "M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35"
            : root.name == "refresh" ? "M23 4v6h-6 M1 20v-6h6 M3.51 9a9 9 0 0 1 14.85-3.36L23 10 M1 14l4.64 4.36A9 9 0 0 0 20.49 15"
            : root.name == "plus" ? "M12 5v14 M5 12h14"
            : root.name == "x" ? "M18 6L6 18 M6 6l12 12"
            : root.name == "lock" ? "M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2z M7 11V7a5 5 0 0 1 10 0v4"
            : root.name == "calendar" ? "M8 2v4 M16 2v4 M3 10h18 M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"
            : root.name == "arrow-right" ? "M5 12h14 M12 5l7 7-7 7"
            : root.name == "chevron-down" ? "M6 9l6 6 6-6"
            : root.name == "hexagon" ? "M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
            : root.name == "save" ? "M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z M17 21v-8H7v8 M7 3v5h8"
            : root.name == "grid" ? "M3 3h7v7H3z M14 3h7v7h-7z M14 14h7v7h-7z M3 14h7v7H3z"
            : root.name == "image" ? "M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z M8.5 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z M21 15l-5-5L5 21"
            : root.name == "file-text" ? "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8"
            : root.name == "terminal" ? "M4 17l6-6-6-6 M12 19h8"
            : root.name == "bell" ? "M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9 M10.3 21a1.94 1.94 0 0 0 3.4 0"
            : root.name == "copy" ? "M9 9h13v13H9z M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
            : root.name == "external-link" ? "M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6 M15 3h6v6 M10 14L21 3"
            : root.name == "trash" ? "M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
            : root.name == "volume" ? "M11 5L6 9H2v6h4l5 4V5z M15.54 8.46a5 5 0 0 1 0 7.07 M19.07 4.93a10 10 0 0 1 0 14.14"
            : root.name == "volume-x" ? "M11 5L6 9H2v6h4l5 4V5z M23 9l-6 6 M17 9l6 6"
            : "";
    }
}

// ============================================================
// Tombol — 5 varian. Tinggi 36, radius 6, font 12 SemiBold.
// variant: "primary" | "secondary" | "ghost" | "danger" | "accent"
// WAJIB punya hover + pressed + focus. Tidak ada tombol mati.
// ============================================================
export component Btn inherits Rectangle {
    in property <string> label;
    in property <string> variant: "secondary";
    in property <bool> enabled: true;
    // Varian kecil: font 11px + padding 10px (untuk tombol script
    // bernama di footer BATCH — 5 tombol harus muat di 520px).
    in property <bool> small: false;
    // Skala fluid (1 = ukuran desain). Diberi pemakai via ui-scale.
    in property <float> scale: 1;
    // Override tinggi eksplisit (mis. 34px untuk tombol Save C# H34).
    // 0px = pakai tinggi standar 36px * scale.
    in property <length> height-override: 0px;
    callback clicked();

    touch := TouchArea {
        width: 100%; height: 100%;
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    property <bool> is-primary: variant == "primary";
    property <bool> is-ghost: variant == "ghost";
    property <bool> is-danger: variant == "danger";
    property <bool> is-accent: variant == "accent";

    height: root.height-override > 0px ? root.height-override : 36px * scale;
    border-radius: Design.radius-sm * scale;
    opacity: enabled ? 1 : 0.4;

    background: is-primary ? (touch.pressed ? Design.btn-primary-bg-pressed : touch.has-hover ? Design.btn-primary-bg-hover : Design.btn-primary-bg)
        : is-danger ? (touch.has-hover ? Design.btn-danger-bg-hover : Design.btn-danger-bg)
        : is-accent ? Design.card-bg
        : is-ghost ? (touch.pressed ? Design.ghost-pressed : touch.has-hover ? Design.ghost-hover : transparent)
        : (touch.pressed ? Design.btn-secondary-bg-pressed : touch.has-hover ? Design.btn-secondary-bg-hover : Design.btn-secondary-bg);

    border-width: is-primary ? 0px : 1px;
    border-color: is-danger ? Design.btn-danger-border
        : is-accent ? Design.accent
        : is-ghost ? transparent
        : Design.btn-secondary-border;

    animate background { duration: Design.anim-normal; easing: ease-out; }
    animate border-color { duration: Design.anim-normal; easing: ease-out; }

    // Label dibungkus layout ber-padding supaya teks tidak menempel
    // ke tepi tombol (lebar tombol = teks + padding).
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: root.small ? 10px * scale : 16px * scale;
        padding-right: root.small ? 10px * scale : 16px * scale;
        alignment: center;

        Text {
            text: label;
            font-size: root.small ? 11px * scale : Design.font-button * scale;
            font-weight: 600;
            color: is-primary ? Design.btn-primary-fg
                : is-danger ? Design.btn-danger-fg
                : is-accent ? Design.accent
                : Design.btn-secondary-fg;
            vertical-alignment: center;
        }
    }
}

// ============================================================
// IconBtn — tombol ikon persegi untuk toolbar & baris aksi BATCH.
// Varian: "secondary" (latar gelap + border), "ghost" (transparan,
// hover saja), "danger" (latar merah gelap + teks merah, untuk
// hapus). Glyph = satu karakter teks (bukan emoji) — mis. "＋",
// "↻", "×". Ukuran sisi lewat `size` (default 32px); samakan
// dengan tinggi baris (36px) bila bersebelahan dengan Btn.
// ============================================================
export component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> variant: "secondary";
    in property <float> scale: 1;
    in property <length> size: 32px;
    callback clicked();

    touch := TouchArea {
        width: 100%; height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    property <bool> is-ghost: variant == "ghost";
    property <bool> is-danger: variant == "danger";

    width: size * scale;
    height: size * scale;
    border-radius: Design.radius-sm * scale;

    background: is-danger ? (touch.has-hover ? Design.btn-danger-bg-hover : Design.btn-danger-bg)
        : is-ghost ? (touch.pressed ? Design.ghost-pressed : touch.has-hover ? Design.ghost-hover : transparent)
        : (touch.pressed ? Design.btn-secondary-bg-pressed : touch.has-hover ? Design.btn-secondary-bg-hover : Design.btn-secondary-bg);

    border-width: is-ghost ? 0px : 1px;
    border-color: is-danger ? Design.btn-danger-border : Design.btn-secondary-border;

    animate background { duration: Design.anim-normal; easing: ease-out; }
    animate border-color { duration: Design.anim-normal; easing: ease-out; }

    Text {
        text: glyph;
        font-size: 16px * scale;
        font-weight: 700;
        color: is-danger ? Design.btn-danger-fg : Design.btn-secondary-fg;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// ============================================================
// WindowControls — tombol kontrol window (min/max/close).
// Dua gaya (pilih di Settings → Appearance → Window chrome):
// "icons" = glyph ─ □ × (32×24 tiap tombol, seperti titlebar
// BMachine sekarang); "dots" = traffic-light pastel ala macOS
// (ref chrome-buttons-ref.jpg): tiga dot 12px dalam pill putih —
// merah × (tutup), kuning − (minimize), hijau panah maximize
// (dua segitiga). Warna dot TETAP (bukan token tema), seperti
// traffic light macOS asli. Dipakai titlebar window utama +
// titlebar window sekunder (Spreadsheet, Toolbox, CardList).
// ============================================================
export component WindowControls inherits Rectangle {
    in property <string> button-style: "icons"; // "icons" | "dots"
    in property <bool> show-min: true;
    in property <bool> show-max: true;
    callback minimize();
    callback maximize();
    callback close();

    // Warna traffic light pastel (ref) — tetap di semua tema.
    property <color> dot-red-bg: #F6C6C6;
    property <color> dot-red-bg-hover: #EFA9A9;
    property <color> dot-red-fg: #A61B1B;
    property <color> dot-yellow-bg: #F5DFA8;
    property <color> dot-yellow-bg-hover: #EED28A;
    property <color> dot-yellow-fg: #8A5A00;
    property <color> dot-green-bg: #BFE8C0;
    property <color> dot-green-bg-hover: #A5DCA5;
    property <color> dot-green-fg: #166534;

    property <int> btn-count: 1 + (root.show-min ? 1 : 0) + (root.show-max ? 1 : 0);
    height: 24px;
    // Ikon: 3 tombol 32px + jarak 8px; dot: pill (padding 10px tiap
    // sisi) + dot 12px + jarak 8px.
    width: root.button-style == "dots"
        ? (20px + 12px * root.btn-count + 8px * (root.btn-count - 1))
        : (32px * root.btn-count + 8px * (root.btn-count - 1));

    // Gaya "icons": ─ □ ×.
    if root.button-style == "icons" : HorizontalLayout {
        spacing: 8px;
        if root.show-min : Rectangle {
            width: 32px; height: 24px;
            border-radius: Design.radius-xs;
            background: min-touch.has-hover ? Design.ghost-hover : transparent;
            min-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.minimize(); }
            }
            Text {
                text: "─";
                font-size: 11px;
                color: Design.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%; height: 100%;
            }
        }
        if root.show-max : Rectangle {
            width: 32px; height: 24px;
            border-radius: Design.radius-xs;
            background: max-touch.has-hover ? Design.ghost-hover : transparent;
            max-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.maximize(); }
            }
            Text {
                text: "□";
                font-size: 11px;
                color: Design.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%; height: 100%;
            }
        }
        Rectangle {
            width: 32px; height: 24px;
            border-radius: Design.radius-xs;
            background: close-touch.has-hover ? Design.status-danger : transparent;
            close-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close(); }
            }
            Text {
                text: "×";
                font-size: 14px;
                font-weight: 700;
                color: close-touch.has-hover ? white : Design.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%; height: 100%;
            }
        }
    }

    // Gaya "dots": traffic light pastel dalam pill putih (macOS).
    if root.button-style == "dots" : Rectangle {
        y: 2px;
        height: 20px;
        background: white;
        border-radius: 999px;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            // Merah = tutup (paling kiri, seperti macOS).
            Rectangle {
                width: 12px; height: 12px;
                y: (parent.height - self.height) / 2;
                background: dot-close-touch.has-hover ? root.dot-red-bg-hover : root.dot-red-bg;
                border-radius: 999px;
                dot-close-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close(); }
                }
                Text {
                    text: "×";
                    font-size: 9px;
                    font-weight: 700;
                    color: root.dot-red-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%; height: 100%;
                }
            }
            if root.show-min : Rectangle {
                width: 12px; height: 12px;
                y: (parent.height - self.height) / 2;
                background: dot-min-touch.has-hover ? root.dot-yellow-bg-hover : root.dot-yellow-bg;
                border-radius: 999px;
                dot-min-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.minimize(); }
                }
                Text {
                    text: "−";
                    font-size: 9px;
                    font-weight: 700;
                    color: root.dot-yellow-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%; height: 100%;
                }
            }
            if root.show-max : Rectangle {
                width: 12px; height: 12px;
                y: (parent.height - self.height) / 2;
                background: dot-max-touch.has-hover ? root.dot-green-bg-hover : root.dot-green-bg;
                border-radius: 999px;
                dot-max-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.maximize(); }
                }
                // Panah maximize: dua segitiga (pojok kanan-atas +
                // pojok kiri-bawah), seperti di referensi.
                Path {
                    width: 8px; height: 8px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    commands: "M 8 0 L 8 4 L 4 0 Z M 0 8 L 0 4 L 4 8 Z";
                    fill: root.dot-green-fg;
                }
            }
        }
    }
}

// ============================================================
// Card / Bento — bg card, border separator 1px, radius 10.
// Isi diberi padding oleh pemakai (VerticalLayout padding 16).
// Tanpa shadow/glow.
// ============================================================
export component Card inherits Rectangle {
    background: Design.card-bg;
    border-color: Design.separator;
    border-width: 1px;
    border-radius: Design.radius-lg;
    clip: true;
}

// ============================================================
// Separator horizontal 1px.
// ============================================================
export component HSeparator inherits Rectangle {
    height: 1px;
    background: Design.separator;
}

// ============================================================
// Chip label kecil — bg hover, border warna label, radius 4.
// Lebar diatur pemakai (label-width), tinggi 18.
// ============================================================
export component Chip inherits Rectangle {
    in property <string> label;
    in property <color> accent;

    height: 18px;
    background: Design.bg-hover;
    border-color: accent;
    border-width: 1px;
    border-radius: Design.radius-xs;

    Text {
        text: label;
        font-size: 10px;
        font-weight: 600;
        color: accent;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// ============================================================
// TextField — bg input, border default, radius 6, tinggi 36.
// Border berubah saat focus. Font 13.
// ============================================================
export component TextField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    callback accepted(string);
    callback edited(string);

    height: 36px;
    background: Design.bg-input;
    border-color: input.has-focus ? Design.border-focus : Design.border-default;
    border-width: 1px;
    border-radius: Design.radius-sm;
    clip: true;

    animate border-color { duration: Design.anim-normal; easing: ease-out; }

    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: 100%;
        // Dua arah (<=>), BUKAN satu arah: binding satu arah
        // `text: root.text` PUTUS saat user mengetik (assignment ke
        // properti yang ter-binding memutuskan binding-nya), sehingga
        // perubahan programatik sesudahnya (mis. pengosongan draft
        // setelah komentar terkirim) tidak lagi tampil di field.
        // Dengan <=> ketikan naik dan pengosongan turun sama-sama jalan.
        text <=> root.text;
        font-size: Design.font-body;
        color: Design.text-primary;
        selection-foreground-color: white;
        selection-background-color: Design.accent;
        vertical-alignment: center;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }

    Text {
        text: placeholder;
        font-size: Design.font-body;
        color: Design.text-muted;
        vertical-alignment: center;
        x: 10px;
        visible: root.text == "" && !input.has-focus;
    }
}

// ============================================================
// ComboBox — dropdown pilihan (C# ComboBox: LANGUAGE, dsb).
// Field 36px (sama seperti TextField/Btn — rata atas-bawah),
// daftar opsi 36px/item muncul di bawah field saat dibuka.
// In-flow (bukan popup overlay — Slint tidak punya popup global);
// daftar memakai `if` supaya tidak makan ruang saat tertutup.
// Tutup: pilih opsi, atau klik field lagi.
// ============================================================
export component ComboBox inherits Rectangle {
    in-out property <[string]> model: [];
    in-out property <int> current-index: 0;
    in-out property <bool> open: false;
    callback selected(int);

    // Tinggi = field 36px + (daftar bila terbuka).
    height: root.open ? 36px + 4px + root.model.length * 36px : 36px;

    VerticalLayout {
        spacing: 4px;

        // Field: nilai saat ini + panah.
        Rectangle {
            height: 36px;
            background: Design.bg-input;
            border-color: root.open ? Design.border-focus : Design.border-default;
            border-width: 1px;
            border-radius: Design.radius-sm;

            field-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open = !root.open; }
            }

            Text {
                x: 10px;
                width: parent.width - 34px;
                height: 100%;
                text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
                font-size: Design.font-body;
                color: Design.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            SvgIcon {
                x: parent.width - 26px;
                y: (parent.height - self.height) / 2;
                name: "chevron-down";
                size: 14px;
                icon-color: Design.text-muted;
            }
        }

        // Daftar opsi (hanya saat terbuka).
        if root.open : Rectangle {
            background: Design.surface-elevated;
            border-color: Design.border-default;
            border-width: 1px;
            border-radius: Design.radius-sm;
            clip: true;
            height: root.model.length * 36px;

            VerticalLayout {
                for item[i] in root.model : Rectangle {
                    height: 36px;
                    background: item-touch.has-hover ? Design.bg-hover : transparent;
                    item-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.open = false;
                            root.selected(i);
                        }
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: item;
                        font-size: Design.font-body;
                        font-weight: root.current-index == i ? 700 : 400;
                        color: root.current-index == i ? Design.accent : Design.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

// ============================================================
// Toggle switch — track 44x24, thumb 18, radius 12.
// ============================================================
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);

    width: 44px;
    height: 24px;
    background: checked ? Design.accent : Design.toggle-off-bg;
    border-radius: Design.radius-xl;

    animate background { duration: Design.anim-slow; easing: ease-in-out; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    Rectangle {
        width: 18px;
        height: 18px;
        x: checked ? parent.width - 21px : 3px;
        y: 3px;
        background: white;
        border-radius: 9px;

        animate x { duration: Design.anim-slow; easing: ease-in-out; }
    }
}

// ============================================================
// FlyoutItem — satu baris item flyout profil: ikon + label +
// ekor (teks shortcut / Toggle / kosong). Hover jelas
// (bg-hover + radius-sm). Aturan §7: SvgIcon di baris icon+teks
// dibungkus VerticalLayout center.
// Baris dengan Toggle: klik baris tidak mengubah apa pun (klik
// Toggle sendiri yang mengubah); `clicked` boleh kosong.
// ============================================================
export component FlyoutItem inherits Rectangle {
    in property <string> icon-name;
    in property <string> label;
    in property <string> hint: "";
    in property <color> label-color: Design.text-primary;
    in property <bool> show-toggle: false;
    in-out property <bool> toggle-checked: false;
    callback clicked();
    callback toggled(bool);

    height: 36px;
    background: item-touch.has-hover ? Design.bg-hover : transparent;
    border-radius: Design.radius-sm;

    item-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            SvgIcon {
                name: root.icon-name;
                size: 16px;
                icon-color: root.label-color;
            }
        }
        Text {
            text: root.label;
            font-size: Design.font-body;
            font-weight: 600;
            color: root.label-color;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.hint != "" : Text {
            text: root.hint;
            font-size: Design.font-caption;
            color: Design.text-muted;
            vertical-alignment: center;
        }
        if root.show-toggle : VerticalLayout {
            alignment: center;
            Toggle {
                checked: root.toggle-checked;
                toggled(checked) => { root.toggled(checked); }
            }
        }
    }
}

// ============================================================
// NavTab — pill navigasi (HOME / BATCH / LOCKER).
// Aktif: bg accent-subtle + teks accent. Nonaktif: teks biasa.
// ============================================================
export component NavTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <string> icon: "";
    // Skala fluid: mengikuti ukuran window (1 = ukuran desain).
    in property <float> scale: 1;
    callback clicked();

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    height: 40px * scale;
    // Rounded active highlight is a capsule nested inside the capsule nav host.
    background: selected ? Design.nav-selected-bg : (touch.has-hover ? Design.bg-hover : transparent);
    border-radius: Design.radius-pill;

    animate background { duration: Design.anim-normal; easing: ease-out; }

    // ATURAN IKON+TEKS (27 Nov 2026): SvgIcon punya height eksplisit,
    // jadi di dalam HorizontalLayout ia nempel ke ATAS baris (bukan
    // tengah) — `alignment: center` hanya menengahkan sumbu horizontal.
    // Text tanpa height eksplisit di-stretch setinggi baris dan
    // `vertical-alignment: center` menengahkan glyph-nya. Akibatnya
    // ikon selalu ~8px di atas teks. Perbaikan: bungkus SvgIcon dengan
    // VerticalLayout{alignment:center} (di-stretch setinggi baris,
    // lalu menengahkan ikon) — pola yang sama dipakai GroupRow dan
    // search field di settings.slint. Berlaku di SEMUA baris ikon+teks.
    // Label dinamis (abeng 27 Nov 18:46): hanya tampil saat selected;
    // saat tidak terpilih pill mengecil jadi ikon saja — lebar
    // label-box dianimasikan (dynamic move), gap 7px ikut di dalam
    // lebar itu supaya pill yang mengecil tetap simetris.
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 14px * scale;
        padding-right: 14px * scale;
        alignment: center;

        VerticalLayout {
            alignment: center;
            if icon == "layers" : SvgIcon {
                name: "layers";
                size: 16px * scale;
                icon-color: selected ? Design.nav-selected-fg : Design.nav-unselected-fg;
            }
            if icon == "home" : SvgIcon {
                name: "home";
                size: 16px * scale;
                icon-color: selected ? Design.nav-selected-fg : Design.nav-unselected-fg;
            }
        }
        label-box := Rectangle {
            width: selected ? label-text.preferred-width + 7px * scale : 0px;
            clip: true;
            animate width { duration: 200ms; easing: ease-out; }
            label-text := Text {
                x: 7px * scale;
                height: 100%;
                text: label;
                font-size: 12px * scale;
                font-weight: 800;
                letter-spacing: 0.6px * scale;
                color: selected ? Design.nav-selected-fg : Design.nav-unselected-fg;
                vertical-alignment: center;
            }
        }
    }


}

// ============================================================
// StatWidget — kartu statistik dashboard.
// Dot warna + label (13px, weight 800 — sama seperti label nav,
// letter-spacing 1)
// + tombol buka di window baru, nilai besar + suffix.
// Hover: border jadi warna aksen. Klik: callback clicked.
// ============================================================
export component StatWidget inherits Rectangle {
    in property <string> label;
    in property <string> value;
    // Satuan di samping nilai (CARD / POIN), warna aksen.
    in property <string> suffix;
    in property <color> accent;
    // Pola dekorasi latar widget — BISA DIPILIH USER di Settings →
    // Appearance ("Pola latar widget"). Nilai: "doodle" | "dots" |
    // "impulse" | "none". Diatur AppWindow via properti `widget-bg`
    // (setting global). Tambah varian baru = tambah satu wadah di
    // bawah + satu nilai.
    in property <string> bg: "doodle";
    // Gaya permukaan kartu — BISA DIPILIH USER di Settings →
    // Appearance ("Gaya latar widget") DAN didefinisikan tiap preset
    // tema (sistem tema §22). Nilai: "solid" (datar, bawaan) |
    // "gradient" (tinta aksen memudar dari atas) | "glass"
    // (permukaan terangkat + border tinta aksen) | "outline"
    // (transparan, border aksen penuh, tanpa garis atas). C# TIDAK
    // punya padanan (kartu C# selalu solid CardBackgroundBrush +
    // bar aksen) — ini tambahan port yang konsisten dengan design
    // system. Diatur AppWindow via properti `widget-style`.
    in property <string> bg-style: "solid";
    // Tinggi gelombang "impulse" (0..1) — 14 titik.
    property <[float]> wave: [0.0, 0.3, 0.6, 0.9, 0.5, 0.1, 0.4, 0.8, 1.0, 0.6, 0.2, 0.5, 0.85, 0.35];
    // Ukuran font nilai — PROPORSIONAL terhadap lebar kartu
    // (root.width), BUKAN per kartu. Jadi SEMUA angka ukurannya
    // SAMA (tidak ada yang beda), dan otomatis mengecil saat
    // window kecil supaya "1.280 POIN" tetap muat. 0.18 dipilih
    // supaya "1.280 POIN" muat di kartu 234 px (520×600) dan
    // tetap besar di kartu 614 px (1280×800).
    // Suffix = 25% dari font nilai. Rata bawah dihitung dari
    // kedua ukuran ini.
    property <length> val-size: root.width * 0.18;
    property <length> suffix-size: root.val-size * 0.25;
    // Skala fluid: mengikuti ukuran window (1 = ukuran desain,
    // >1 saat window besar). Diberi AppWindow via card-scale.
    in property <float> scale: 1;
    callback clicked();
    // Panah "→" di kanan atas = buka WINDOW kategori itu (C#:
    // tombol panah di StatWidget membuka CardListWindow). TouchArea
    // sendiri di area panah — klik panah TIDAK memicu klik badan.
    callback arrow-clicked();

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // Turunan gaya permukaan (dihitung sekali, dipakai wadah dalam).
    property <color> surface-bg: root.bg-style == "glass" ? Design.surface-elevated : root.bg-style == "outline" ? transparent : Design.card-bg;
    property <color> surface-border: root.bg-style == "outline" ? accent : root.bg-style == "glass" ? (touch.has-hover ? accent : accent.with-alpha(0.45)) : (touch.has-hover ? accent : Design.separator);
    property <length> surface-border-width: root.bg-style == "outline" ? 1.5px * scale : 1px;
    property <bool> show-top-bar: root.bg-style != "outline";

    // Lapisan luar = warna aksen. Bentuknya (radius 12) adalah bentuk
    // kartu, jadi garis aksen di tepi atas otomatis mengikuti lengkung
    // sudut kartu — semua sudut tetap rounded, bukan cuma bawah.
    // Gaya "outline" tanpa garis atas (border aksen penuh sudah
    // cukup) → lapisan luar transparan.
    background: root.show-top-bar ? accent : transparent;
    border-radius: Design.radius-xl;

    // Lapisan dalam = permukaan kartu. Digeser ke bawah setebal garis
    // aksen, sehingga aksen hanya terlihat sebagai garis di tepi atas
    // (kecuali "outline": isi penuh, tanpa geseran).
    Rectangle {
        x: 0;
        y: root.show-top-bar ? 2px * scale : 0;
        width: 100%;
        height: root.show-top-bar ? parent.height - 2px * scale : parent.height;
        background: root.surface-bg;
        border-color: root.surface-border;
        border-width: root.surface-border-width;
        border-radius: Design.radius-xl;

        animate border-color { duration: Design.anim-normal; easing: ease-out; }

        // Gaya C# asli (pilihan abeng, 26 Nov 14:24 — opsi C: tanpa
        // sub text). Atas: dot + label + panah buka. Bawah: nilai
        // BESAR + suffix satuan warna aksen. Teks dibuat besar lagi
        // supaya mengisi kartu. Latar doodle tetap ada (plus,
        // lingkaran outline, titik) supaya kartu tidak kosong.

        // --- Latar widget (PILIHAN — bisa diganti user di Settings) ---
        // Tiap varian = satu wadah transparan seukuran kartu, hanya
        // tampil saat `bg` cocok. "none" = tidak ada wadah (polos).
        // Varian "doodle": plus + lingkaran outline + titik.
        Rectangle {
            x: 0; y: 0; width: 100%; height: 100%;
            visible: root.bg == "doodle";
            // Plus kiri atas.
            Rectangle { x: 22px * scale; y: 22px * scale; width: 14px * scale; height: 2px * scale; background: accent; opacity: 0.18; }
            Rectangle { x: 28px * scale; y: 16px * scale; width: 2px * scale; height: 14px * scale; background: accent; opacity: 0.18; }
            // Lingkaran outline kanan atas.
            Rectangle { x: parent.width - 84px * scale; y: 18px * scale; width: 56px * scale; height: 56px * scale; background: transparent; border-color: accent; border-width: 1.5px * scale; opacity: 0.20; border-radius: 999px * scale; }
            // Plus kiri bawah.
            Rectangle { x: 30px * scale; y: parent.height - 34px * scale; width: 12px * scale; height: 2px * scale; background: accent; opacity: 0.15; }
            Rectangle { x: 35px * scale; y: parent.height - 39px * scale; width: 2px * scale; height: 12px * scale; background: accent; opacity: 0.15; }
            // Lingkaran outline kecil kanan bawah.
            Rectangle { x: parent.width - 52px * scale; y: parent.height - 52px * scale; width: 28px * scale; height: 28px * scale; background: transparent; border-color: accent; border-width: 1.5px * scale; opacity: 0.18; border-radius: 999px * scale; }
            // Titik-titik kecil.
            Rectangle { x: parent.width - 120px * scale; y: 30px * scale; width: 4px * scale; height: 4px * scale; background: accent; opacity: 0.22; border-radius: 999px * scale; }
            Rectangle { x: 48px * scale; y: parent.height - 58px * scale; width: 4px * scale; height: 4px * scale; background: accent; opacity: 0.20; border-radius: 999px * scale; }
            Rectangle { x: parent.width - 140px * scale; y: parent.height - 30px * scale; width: 3px * scale; height: 3px * scale; background: accent; opacity: 0.20; border-radius: 999px * scale; }
        }
        // Varian "dots": titik-titik halus di tepi atas & bawah kartu.
        Rectangle {
            x: 0; y: 0; width: 100%; height: 100%;
            visible: root.bg == "dots";
            for i in 12:
                Rectangle {
                    x: (i + 0.5) * parent.width / 12 - 1.5px * scale;
                    y: 14px * scale;
                    width: 3px * scale;
                    height: 3px * scale;
                    background: accent;
                    opacity: 0.14;
                    border-radius: 999px * scale;
                }
            for i in 12:
                Rectangle {
                    x: (i + 0.5) * parent.width / 12 - 1.5px * scale;
                    y: parent.height - 17px * scale;
                    width: 3px * scale;
                    height: 3px * scale;
                    background: accent;
                    opacity: 0.14;
                    border-radius: 999px * scale;
                }
        }
        // Varian "impulse": gelombang pulsa — titik-titik yang naik
        // turun membentuk gelombang di paruh bawah kartu. Dekorasi,
        // bukan grafik data (tidak ada angka/sumbu/keterangan).
        Rectangle {
            x: 0; y: 0; width: 100%; height: 100%;
            visible: root.bg == "impulse";
            for i in 14:
                Rectangle {
                    x: (i + 0.5) * parent.width / 14 - 2px * scale;
                    y: parent.height * 0.72 - root.wave[i] * 52px * scale;
                    width: 4px * scale;
                    height: 4px * scale;
                    background: accent;
                    opacity: 0.25;
                    border-radius: 999px * scale;
                }
        }

        // Varian "gradient" (gaya permukaan, bukan pola): tinta aksen
        // memudar dari tepi atas ke transparan — di atas permukaan
        // kartu (bukan ganti warna dasar), jadi tetap terbaca di mode
        // terang/gelap. Hanya tampil saat bg-style == "gradient".
        Rectangle {
            x: 0; y: 0; width: 100%; height: 100%;
            visible: root.bg-style == "gradient";
            background: @linear-gradient(180deg, accent.with-alpha(0.22) 0%, accent.with-alpha(0.0) 65%);
            border-radius: Design.radius-xl;
        }

        // --- Isi (di atas doodle) ---
        VerticalLayout {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            padding: 20px * scale;
            spacing: 8px * scale;

            // Atas: dot + label + panah buka (kanan).
            HorizontalLayout {
                height: 20px * scale;
                spacing: 8px * scale;
                Text {
                    text: "●";
                    font-size: 8px * scale;
                    color: accent;
                    vertical-alignment: center;
                }
                Text {
                    text: label;
                    font-size: 13px * scale;
                    font-weight: 800;
                    color: Design.text-secondary;
                    letter-spacing: 1px * scale;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                // Panah buka-window — TouchArea sendiri di atas TouchArea
                // badan (paling atas di area ini, jadi klik panah hanya
                // memicu arrow-clicked, bukan clicked). Ukuran eksplisit
                // supaya area sentuhnya tepat di glyph panah.
                arrow-touch := TouchArea {
                    width: 28px * scale;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.arrow-clicked(); }
                    SvgIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        name: "arrow-right";
                        size: 15px * scale;
                        icon-color: arrow-touch.has-hover ? accent : Design.text-muted;
                    }
                }
            }

            // Dorong nilai ke bawah kartu.
            Rectangle { vertical-stretch: 1; }

            // Bawah: nilai BESAR + suffix satuan (warna aksen).
            // Rata bawah = BAWAH suffix sejajar dengan BAWAH angka
            // (bukan rata tengah). Keduanya diposisikan absolut.
            // Suffix y = val-size − suffix-size, supaya bawah
            // keduanya di garis yang sama — seperti garis merah di
            // contoh C# abeng (26 Nov 14:46). Ukuran font nilai
            // SAMA untuk semua kartu (proporsional lebar kartu),
            // jadi tidak ada angka yang ukurannya beda.
            Rectangle {
                height: root.val-size * 1.25;
                val := Text {
                    x: 0;
                    y: 0;
                    text: value;
                    font-size: root.val-size;
                    font-weight: 800;
                    color: Design.text-primary;
                }
                Text {
                    x: val.width + 8px * scale;
                    y: root.val-size - root.suffix-size;
                    text: suffix;
                    font-size: root.suffix-size;
                    font-weight: 800;
                    color: accent;
                    letter-spacing: 1px * scale;
                }
            }
        }
    }
}
