// Layar Toolbox / Spreadsheet / Leaderboard — BUKAN launcher Modul.
// TIDAK ADA layar "Modul" di C# (26 Nov 18:47): tiap layar dibuka dari
// jalurnya sendiri — Toolbox dari flyout profil, Spreadsheet dari panah
// widget POINTS, Leaderboard dari badan widget POINTS. (Dulu ada launcher
// MODUL di port ini; dihapus 26 Nov karena tidak ada di aplikasi asli.)

import { Design, Card, HSeparator, Btn, TextField, NavTab, Chip, Toggle, SvgIcon } from "design.slint";
import { SpreadsheetComponent } from "spreadsheet.slint";

// Chip pilihan kecil (Harian/Bulanan, tab Toolbox, dsb.) — font Btn (12/600).
component OptionChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 32px;
    background: selected ? Design.accent-subtle : (chip-touch.has-hover ? Design.bg-hover : transparent);
    border-color: selected ? Design.accent : Design.separator;
    border-width: 1px;
    border-radius: Design.radius-sm;
    chip-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: label;
            font-size: Design.font-button;
            font-weight: 600;
            color: selected ? Design.accent : Design.text-primary;
            vertical-alignment: center;
        }
    }
}

// Drop zone Toolbox: klik = pilih file/folder (mockup — isi path contoh).
component DropZone inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    callback clicked();
    callback right-clicked(); // klik kanan = kembali (§10.11): TouchArea
    // di atas menelan event tombol kanan, jadi harus diteruskan eksplisit.
    height: 96px;
    background: Design.bg-input;
    border-color: Design.border-hover;
    border-width: 1px;
    border-radius: Design.radius-md;
    drop-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.right-clicked();
            }
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        padding-left: Design.space-md;
        padding-right: Design.space-md;
        Text {
            text: "+";
            font-size: 24px;
            font-weight: 300;
            color: Design.text-muted;
            horizontal-alignment: center;
        }
        Text {
            text: title;
            font-size: Design.font-body;
            font-weight: 700;
            color: Design.text-primary;
            horizontal-alignment: center;
        }
        Text {
            text: hint;
            font-size: Design.font-button;
            color: Design.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// Label seksi eyebrow (gaya "Section" C#: mono, kecil, tracking lebar).
component SectionLabel inherits Text {
    font-family: "JetBrains Mono";
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.2px;
    color: Design.text-muted;
    vertical-alignment: center;
}

// Satu baris preview pasangan nama: referensi → target (MantraNama).
// Di-export (bukan dipakai) sementara: pasangan contoh dihapus 27 Nov
// 2026 (default publish bersih) — dipakai lagi saat pasangan nyata
// dihitung dari folder referensi & target (Fase 6).
export component PairRow inherits Rectangle {
    in property <string> from-name;
    in property <string> to-name;
    in property <bool> done;
    height: 28px;
    HorizontalLayout {
        spacing: Design.space-sm;
        Text {
            horizontal-stretch: 1;
            text: from-name;
            font-family: "JetBrains Mono";
            font-size: Design.font-button;
            color: Design.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: "→";
            font-size: Design.font-body;
            color: Design.text-muted;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: to-name;
            font-family: "JetBrains Mono";
            font-size: Design.font-button;
            font-weight: 700;
            color: Design.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 20px;
            text: done ? "✓" : "•";
            font-size: Design.font-body;
            color: done ? Design.status-success : Design.text-muted;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// Bar progress tipis (gaya "Bar" C#: tinggi kecil, tanpa angka besar).
component MiniProgress inherits Rectangle {
    in property <float> frac;
    height: 6px;
    background: Design.separator;
    border-radius: 3px;
    Rectangle {
        x: 0; y: 0;
        width: parent.width * frac;
        height: 100%;
        background: Design.status-success;
        border-radius: 3px;
    }
}

// ================= TOOLBOX =================
// Tab MantraNama / MantraGanda / PsdBucin (BMACHINE_ALUR_APLIKASI.md §4.5).
export component ToolboxView inherits Rectangle {
    callback back();
    callback toast(string);
    in-out property <string> tool-tab: "MantraNama";
    // Gaya toggle on/off ("classic" | "pill" | "outline") — diikat
    // dari ToolboxWindow (didorong Rust), lihat DESIGN_SYSTEM.md §5.2.
    in-out property <string> toggle-style: "classic";

    // --- State mockup per tab (eksekusi nyata = Fase 6) ---
    in-out property <string> nama-example: "";
    in-out property <bool> nama-processed: false;
    in-out property <bool> nama-autopair: true;
    in-out property <string> nama-status: "Siap — 0 pasangan terdeteksi.";
    in-out property <string> ganda-master: "";
    in-out property <string> ganda-data: "";
    in-out property <string> ganda-count: "2";
    in-out property <string> ganda-start: "1";
    in-out property <string> ganda-sep: " ";
    in-out property <string> ganda-base: "";
    in-out property <bool> ganda-running: false;
    in-out property <int> ganda-step: 0;
    in-out property <float> ganda-progress: 0.0;
    in-out property <string> ganda-status: "Siap untuk menggandakan.";
    in-out property <string> bucin-master: "";
    in-out property <string> bucin-photo: "";
    in-out property <bool> bucin-running: false;
    in-out property <int> bucin-step: 0;
    in-out property <float> bucin-progress: 0.0;
    in-out property <string> bucin-status: "Menunggu Folder...";

    // Timer mockup: 20 langkah × 150ms ≈ 3 detik sampai selesai.
    ganda-timer := Timer {
        interval: 150ms;
        running: root.ganda-running;
        triggered => {
            root.ganda-step += 1;
            root.ganda-progress = root.ganda-step * 0.05;
            if (root.ganda-step >= 20) {
                root.ganda-running = false;
                root.ganda-status = "Selesai — file digandakan ×" + root.ganda-count + " (mockup).";
                root.toast("MantraGanda: selesai — ×" + root.ganda-count + " (mockup).");
            } else {
                root.ganda-status = "Menggandakan… " + root.ganda-step + "/20 (mockup)";
            }
        }
    }
    bucin-timer := Timer {
        interval: 150ms;
        running: root.bucin-running;
        triggered => {
            root.bucin-step += 1;
            root.bucin-progress = root.bucin-step * 0.05;
            if (root.bucin-step >= 20) {
                root.bucin-running = false;
                root.bucin-status = "Selesai — PSD dibuat dari folder foto (mockup).";
                root.toast("PsdBucin: selesai — PSD dibuat (mockup).");
            } else {
                root.bucin-status = "Memproses… " + root.bucin-step + "/20 (mockup)";
            }
        }
    }

    // Klik kanan = kembali ke dashboard (C# OnEmbeddedViewPointerPressed).
    toolbox-back-touch := TouchArea {
        width: 100%; height: 100%;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.back();
            }
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: Design.space-xl;
        padding-right: Design.space-xl;
        padding-bottom: 30px;
        spacing: Design.space-md;

        HorizontalLayout {
            height: 36px;
            spacing: Design.space-sm;
            Text {
                text: "Toolbox";
                font-size: Design.font-h2;
                font-weight: 800;
                color: Design.text-primary;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            height: 32px;
            spacing: 2px;
            NavTab {
                label: "MantraNama";
                selected: root.tool-tab == "MantraNama";
                clicked => { root.tool-tab = "MantraNama"; }
            }
            NavTab {
                label: "MantraGanda";
                selected: root.tool-tab == "MantraGanda";
                clicked => { root.tool-tab = "MantraGanda"; }
            }
            NavTab {
                label: "PsdBucin";
                selected: root.tool-tab == "PsdBucin";
                clicked => { root.tool-tab = "PsdBucin"; }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            // --- MantraNama: rapikan nama file (pair referensi → target) ---
            // Flickable: isi tab bisa lebih tinggi dari area (520x600) —
            // scroll supaya tombol bawah tetap terjangkau. height =
            // max(viewport, isi): di layar tinggi kartu stretch mengisi
            // area seperti sebelumnya; di layar pendek isi melebihi
            // viewport dan bisa di-scroll.
            Flickable {
                x: 0; y: 0; width: 100%; height: 100%;
                visible: root.tool-tab == "MantraNama";
                VerticalLayout {
                    x: 0; width: 100%;
                    height: max(parent.height, self.preferred-height);
                    spacing: Design.space-md;
                Card {
                    height: nama-card-layout.preferred-height;
                    nama-card-layout := VerticalLayout {
                        padding: Design.space-md;
                        spacing: Design.space-md;
                        SectionLabel { text: "SUMBER — RAPIKAN NAMA FILE"; }
                        DropZone {
                            title: "Drop file/folder di sini";
                            hint: "Nama file akan dirapikan mengikuti referensi (MantraNama).";
                            clicked => { root.toast("Pilih file… (dialog file di aplikasi asli)"); }
                            right-clicked => { root.back(); }
                        }
                        TextField {
                            text: root.nama-example;
                            placeholder: "";
                            edited(text) => { root.nama-example = text; }
                        }
                        HorizontalLayout {
                            height: 36px;
                            spacing: Design.space-sm;
                            Btn {
                                label: "Proses Nama";
                                variant: "primary";
                                clicked => {
                                    root.nama-processed = true;
                                    root.nama-status = "Selesai — 3 nama dirapikan (mockup).";
                                    root.toast("MantraNama: 3 nama dirapikan (mockup).");
                                }
                            }
                            Btn {
                                label: "Bersihkan";
                                variant: "ghost";
                                clicked => {
                                    root.nama-example = "";
                                    root.nama-processed = false;
                                    root.nama-status = "Siap — 3 pasangan terdeteksi (contoh).";
                                    root.toast("MantraNama: dibersihkan.");
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: "Auto-pair";
                                font-size: Design.font-button;
                                font-weight: 600;
                                color: Design.text-secondary;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 64px;
                                height: 36px;
                                Toggle {
                                    x: 0; y: 6px;
                                    toggle-style: root.toggle-style;
                                    checked: root.nama-autopair;
                                    toggled(on) => {
                                        root.nama-autopair = on;
                                        root.toast(on ? "Auto-pair aktif — pasangan diurutkan otomatis." : "Auto-pair mati — pasangan diatur manual.");
                                    }
                                }
                            }
                        }
                    }
                }
                Card {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: Design.space-md;
                        spacing: Design.space-xs;
                        HorizontalLayout {
                            height: 20px;
                            SectionLabel { text: "PREVIEW PASANGAN — REFERENSI → TARGET"; }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: "0 pasangan";
                                font-size: Design.font-caption;
                                font-weight: 600;
                                color: Design.text-muted;
                                vertical-alignment: center;
                            }
                        }
                        HSeparator { }
                        Rectangle { vertical-stretch: 1; }
                        Text {
                            text: "Pasangan dihitung dari folder referensi & target (Fase 6).";
                            font-size: Design.font-caption;
                            color: Design.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            }

            // --- MantraGanda: gandakan file (master + data opsional + konfigurasi) ---
            Flickable {
                x: 0; y: 0; width: 100%; height: 100%;
                visible: root.tool-tab == "MantraGanda";
                VerticalLayout {
                    x: 0; width: 100%;
                    height: max(parent.height, self.preferred-height);
                    spacing: Design.space-md;
                Card {
                    height: ganda-card-layout.preferred-height;
                    ganda-card-layout := VerticalLayout {
                        padding: Design.space-md;
                        spacing: Design.space-md;
                        SectionLabel { text: "FILE / FOLDER MASTER"; }
                        DropZone {
                            title: "Drop file master template di sini";
                            hint: "File master PSD / folder yang akan digandakan.";
                            clicked => {
                                root.toast("Pilih folder belum tersedia — ketik path manual di kolom.");
                            }
                            right-clicked => { root.back(); }
                        }
                        HorizontalLayout {
                            height: 36px;
                            spacing: Design.space-sm;
                            TextField {
                                horizontal-stretch: 1;
                                text: root.ganda-master;
                                placeholder: "Path file atau folder master...";
                                edited(text) => { root.ganda-master = text; }
                            }
                            Btn {
                                label: "Pilih";
                                variant: "secondary";
                                clicked => {
                                    root.toast("Pilih folder belum tersedia — ketik path manual di kolom.");
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 36px;
                            spacing: Design.space-sm;
                            TextField {
                                horizontal-stretch: 1;
                                text: root.ganda-data;
                                placeholder: "Path folder data tambahan (opsional)...";
                                edited(text) => { root.ganda-data = text; }
                            }
                            Btn {
                                label: "Pilih";
                                variant: "secondary";
                                clicked => {
                                    root.toast("Pilih folder belum tersedia — ketik path manual di kolom.");
                                }
                            }
                        }
                    }
                }
                Card {
                    height: ganda-cfg-layout.preferred-height;
                    ganda-cfg-layout := VerticalLayout {
                        padding: Design.space-md;
                        spacing: Design.space-md;
                        SectionLabel { text: "KONFIGURASI"; }
                        HorizontalLayout {
                            height: 36px;
                            spacing: Design.space-sm;
                            Text {
                                text: "Jumlah ganda";
                                font-size: Design.font-body;
                                font-weight: 700;
                                color: Design.text-primary;
                                vertical-alignment: center;
                            }
                            TextField {
                                width: 80px;
                                text: root.ganda-count;
                                placeholder: "2";
                                edited(text) => { root.ganda-count = text; }
                            }
                            Text {
                                text: "Mulai dari";
                                font-size: Design.font-body;
                                font-weight: 700;
                                color: Design.text-primary;
                                vertical-alignment: center;
                            }
                            TextField {
                                width: 64px;
                                text: root.ganda-start;
                                placeholder: "1";
                                edited(text) => { root.ganda-start = text; }
                            }
                            Text {
                                text: "Pisah";
                                font-size: Design.font-body;
                                font-weight: 700;
                                color: Design.text-primary;
                                vertical-alignment: center;
                            }
                            TextField {
                                width: 48px;
                                text: root.ganda-sep;
                                placeholder: " ";
                                edited(text) => { root.ganda-sep = text; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        TextField {
                            text: root.ganda-base;
                            placeholder: "Nama dasar (kosong = nama asli)";
                            edited(text) => { root.ganda-base = text; }
                        }
                    }
                }
                Card {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: Design.space-md;
                        spacing: Design.space-md;
                        SectionLabel { text: "PROGRESS"; }
                        Text {
                            text: root.ganda-status;
                            font-size: Design.font-body;
                            color: Design.text-secondary;
                        }
                        MiniProgress { frac: root.ganda-progress; }
                        HorizontalLayout {
                            height: 36px;
                            spacing: Design.space-sm;
                            Btn {
                                label: "Gandakan Sekarang";
                                variant: "primary";
                                clicked => {
                                    if (root.ganda-master == "") {
                                        root.toast("Pilih file/folder master dulu.");
                                    } else if (root.ganda-running) {
                                        root.toast("Duplikasi sedang berjalan…");
                                    } else {
                                        root.ganda-running = true;
                                        root.ganda-step = 0;
                                        root.ganda-progress = 0.0;
                                        root.ganda-status = "Menggandakan… 0/20 (mockup)";
                                        root.toast("MantraGanda: menggandakan ×" + root.ganda-count + " (mockup).");
                                    }
                                }
                            }
                            Btn {
                                label: "Berhenti";
                                variant: "danger";
                                clicked => {
                                    if (root.ganda-running) {
                                        root.ganda-running = false;
                                        root.ganda-status = "Dihentikan di langkah " + root.ganda-step + "/20 (mockup).";
                                        root.toast("MantraGanda: duplikasi dihentikan (mockup).");
                                    } else {
                                        root.toast("Tidak ada proses duplikasi yang berjalan.");
                                    }
                                }
                            }
                            Btn {
                                label: "Bersihkan";
                                variant: "ghost";
                                clicked => {
                                    root.ganda-master = "";
                                    root.ganda-data = "";
                                    root.ganda-base = "";
                                    root.ganda-running = false;
                                    root.ganda-progress = 0.0;
                                    root.ganda-step = 0;
                                    root.ganda-status = "Siap untuk menggandakan.";
                                    root.toast("MantraGanda: dibersihkan.");
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
            }

            // --- PsdBucin: duplicator PSD (master + foto + validasi) ---
            Flickable {
                x: 0; y: 0; width: 100%; height: 100%;
                visible: root.tool-tab == "PsdBucin";
                VerticalLayout {
                    x: 0; width: 100%;
                    height: max(parent.height, self.preferred-height);
                    spacing: Design.space-md;
                Card {
                    height: bucin-master-layout.preferred-height;
                    bucin-master-layout := VerticalLayout {
                        padding: Design.space-md;
                        spacing: Design.space-md;
                        SectionLabel { text: "MASTER & OUTPUT"; }
                        DropZone {
                            title: "Drop folder template master PSD di sini";
                            hint: "Seret folder template master PSD ke sini.";
                            clicked => {
                                root.toast("Pilih folder belum tersedia — ketik path manual di kolom.");
                            }
                            right-clicked => { root.back(); }
                        }
                        HorizontalLayout {
                            height: 36px;
                            spacing: Design.space-sm;
                            TextField {
                                horizontal-stretch: 1;
                                text: root.bucin-master;
                                placeholder: "Path folder master PSD...";
                                edited(text) => { root.bucin-master = text; }
                            }
                            Btn {
                                label: "Pilih";
                                variant: "secondary";
                                clicked => {
                                    root.toast("Pilih folder belum tersedia — ketik path manual di kolom.");
                                }
                            }
                        }
                    }
                }
                Card {
                    height: bucin-photo-layout.preferred-height;
                    bucin-photo-layout := VerticalLayout {
                        padding: Design.space-md;
                        spacing: Design.space-md;
                        SectionLabel { text: "INPUT FOTO"; }
                        DropZone {
                            title: "Drop folder foto JPG di sini";
                            hint: "Seret folder foto JPG sumber ke sini.";
                            clicked => {
                                root.toast("Pilih folder belum tersedia — ketik path manual di kolom.");
                            }
                            right-clicked => { root.back(); }
                        }
                        HorizontalLayout {
                            height: 36px;
                            spacing: Design.space-sm;
                            TextField {
                                horizontal-stretch: 1;
                                text: root.bucin-photo;
                                placeholder: "Path folder foto JPG...";
                                edited(text) => { root.bucin-photo = text; }
                            }
                            Btn {
                                label: "Pilih";
                                variant: "secondary";
                                clicked => {
                                    root.toast("Pilih folder belum tersedia — ketik path manual di kolom.");
                                }
                            }
                        }
                    }
                }
                Card {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: Design.space-md;
                        spacing: Design.space-md;
                        SectionLabel { text: "STATUS"; }
                        Text {
                            text: root.bucin-status;
                            font-size: Design.font-body;
                            color: Design.text-secondary;
                        }
                        MiniProgress { frac: root.bucin-progress; }
                        HorizontalLayout {
                            height: 36px;
                            spacing: Design.space-sm;
                            Btn {
                                label: "MULAI";
                                variant: "primary";
                                clicked => {
                                    if (root.bucin-master == "") {
                                        root.toast("Pilih folder master PSD dulu.");
                                    } else if (root.bucin-photo == "") {
                                        root.toast("Pilih folder foto JPG dulu.");
                                    } else if (root.bucin-running) {
                                        root.toast("PsdBucin sedang memproses…");
                                    } else {
                                        root.bucin-running = true;
                                        root.bucin-step = 0;
                                        root.bucin-progress = 0.0;
                                        root.bucin-status = "Memproses… 0/20 (mockup)";
                                        root.toast("PsdBucin: mulai — psdbucin_v3.pyw (mockup).");
                                    }
                                }
                            }
                            Btn {
                                label: "Clear";
                                variant: "ghost";
                                clicked => {
                                    root.bucin-master = "";
                                    root.bucin-photo = "";
                                    root.bucin-running = false;
                                    root.bucin-progress = 0.0;
                                    root.bucin-step = 0;
                                    root.bucin-status = "Menunggu Folder...";
                                    root.toast("PsdBucin: dibersihkan.");
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
            }
        }

        HSeparator { }

        // Strip status bawah — status tab aktif + pengingat MantraData locked.
        HorizontalLayout {
            height: 36px;
            spacing: Design.space-sm;
            Rectangle {
                width: 20px;
                height: 36px;
                Rectangle {
                    x: 6px; y: 14px;
                    width: 8px; height: 8px;
                    background: (root.tool-tab == "MantraGanda" && root.ganda-running) || (root.tool-tab == "PsdBucin" && root.bucin-running) ? Design.status-success : Design.accent;
                    border-radius: 4px;
                }
            }
            Text {
                text: root.tool-tab == "MantraNama" ? root.nama-status : root.tool-tab == "MantraGanda" ? root.ganda-status : root.bucin-status;
                font-size: Design.font-body;
                color: Design.text-secondary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Rectangle {
                width: 150px;
                height: 36px;
                Chip {
                    x: 0; y: 9px;
                    width: 150px;
                    label: "MANTRA DATA · LOCKED";
                    accent: Design.status-warning;
                }
            }
        }
    }
}

// ================= SPREADSHEET =================
// Editor grid Google Sheets fungsional penuh bergaya Excel
export component SheetsView inherits Rectangle {
    callback back();
    callback toast(string);
    callback popout-window();
    // Guard + draft (Rust): teruskan ke SpreadsheetComponent.
    callback sheet-cell-edited(int, int, string, string);
    callback sheet-save();
    callback sheet-refresh();
    // Operasi spreadsheet beneran (Rust): teruskan ke SpreadsheetComponent.
    callback sheet-fill-down();
    callback sheet-clear-cells();
    callback sheet-auto-sum();
    callback sheet-cal-open(string);
    callback sheet-cal-nav(int);
    callback sheet-add-row();
    callback sheet-prev-page();
    callback sheet-next-page();
    callback sheet-hit-col(length) -> int;
    callback sheet-select-rows(int, int, int, int) -> [bool];
    callback sheet-is-typeahead-char(string) -> bool;

    // Baris sheet dari akun (kompatibilitas binding main.slint)
    in-out property <string> sheet-s1: "";
    in-out property <string> sheet-p1: "";
    in-out property <[string]> sheet-rows: [];
    in-out property <int> sheet-row-count: 0;
    in-out property <[string]> sheet-col0: [];
    in-out property <[string]> sheet-col1: [];
    in-out property <[string]> sheet-col2: [];

    // Data grid DINAMIS (28 Nov 2026 — nested model, kolom dari
    // header sheet) + nilai asli + status guard/draft (binding main.slint).
    in-out property <[[string]]> grid: [];
    in-out property <[[string]]> grid-orig: [];
    in-out property <[string]> col-headers: ["KODE", "SEKOLAH", "JENJANG", "STATUS", "POIN", "CATATAN", "TANGGAL"];
    in-out property <[string]> col-letters: ["A", "B", "C", "D", "E", "F", "G"];
    in-out property <[string]> col-kinds: ["text", "text", "dropdown", "dropdown", "number", "text", "date"];
    in-out property <[bool]> col-locked: [true, false, false, false, false, false, false];
    in-out property <[float]> col-widths: [110, 200, 80, 100, 90, 200, 100];
    in-out property <[float]> col-x-offsets: [0, 110, 310, 390, 490, 580, 780];
    in-out property <[[string]]> col-items: [[], [], ["TK", "PAUD", "SD", "SMP", "SMA", "SMK"], ["SELESAI", "PROSES", "REVISI", "ANTRIAN"], [], [], []];
    in-out property <int> key-col: 0;
    in-out property <int> page-start: 0;
    in-out property <int> page-size: 100;
    in-out property <int> total-rows: 0;
    in-out property <int> row-num-base: 1;
    in-out property <string> page-label: "";
    in-out property <bool> sheet-has-draft: false;
    in-out property <int> sheet-draft-count: 0;
    in-out property <string> sheet-status-text: "0 baris · Belum terhubung ke Google Sheets";
    in-out property <string> sheet-guard-result: "";
    // Seleksi multi-baris + kolom fokus (dibaca Rust saat fill-down /
    // clear-cells — diteruskan dari SpreadsheetComponent).
    in-out property <[bool]> sel-rows: [];
    in-out property <int> focus-col: 1;
    in-out property <int> cal-year: 2026;
    in-out property <int> cal-month: 1;
    in-out property <string> cal-label: "";
    in-out property <[int]> cal-cells: [];
    in-out property <int> cal-today: 0;
    in-out property <int> cal-days-in-month: 31;
    in-out property <string> cal-today-iso: "";
    in-out property <int> cal-selected-day: 0;

    // Klik kanan = kembali ke dashboard
    sheets-back-touch := TouchArea {
        width: 100%; height: 100%;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.back();
            }
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: Design.space-xl;
        padding-right: Design.space-xl;
        padding-bottom: 24px;
        spacing: Design.space-sm;

        HorizontalLayout {
            height: 36px;
            spacing: Design.space-sm;
            Text {
                text: "Spreadsheet";
                font-size: Design.font-h2;
                font-weight: 800;
                color: Design.text-primary;
                vertical-alignment: center;
            }
            Text {
                text: "1 Google Sheet (service account)";
                font-size: Design.font-body;
                font-weight: 700;
                color: Design.cat-points;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Btn {
                label: "Buka Window Baru";
                variant: "secondary";
                small: true;
                clicked => { root.popout-window(); }
            }
        }

        // Full Interactive Spreadsheet Component
        SpreadsheetComponent {
            is-standalone: false;
            grid <=> root.grid;
            grid-orig <=> root.grid-orig;
            col-headers <=> root.col-headers;
            col-letters <=> root.col-letters;
            col-kinds <=> root.col-kinds;
            col-locked <=> root.col-locked;
            col-widths <=> root.col-widths;
            col-x-offsets <=> root.col-x-offsets;
            col-items <=> root.col-items;
            key-col <=> root.key-col;
            page-start <=> root.page-start;
            page-size <=> root.page-size;
            total-rows <=> root.total-rows;
            row-num-base <=> root.row-num-base;
            page-label <=> root.page-label;
            cal-year <=> root.cal-year;
            cal-month <=> root.cal-month;
            cal-label <=> root.cal-label;
            cal-cells <=> root.cal-cells;
            cal-today <=> root.cal-today;
            cal-days-in-month <=> root.cal-days-in-month;
            cal-today-iso <=> root.cal-today-iso;
            cal-selected-day <=> root.cal-selected-day;
            sel-rows <=> root.sel-rows;
            focus-col <=> root.focus-col;
            has-draft <=> root.sheet-has-draft;
            draft-count <=> root.sheet-draft-count;
            status-text <=> root.sheet-status-text;
            guard-result <=> root.sheet-guard-result;
            cell-edited(r, c, orig, val) => { root.sheet-cell-edited(r, c, orig, val); }
            save-changes() => { root.sheet-save(); }
            refresh-data() => { root.sheet-refresh(); }
            fill-down() => { root.sheet-fill-down(); }
            clear-cells() => { root.sheet-clear-cells(); }
            auto-sum() => { root.sheet-auto-sum(); }
            cal-open(val) => { root.sheet-cal-open(val); }
            cal-nav(d) => { root.sheet-cal-nav(d); }
            add-row() => { root.sheet-add-row(); }
            prev-page() => { root.sheet-prev-page(); }
            next-page() => { root.sheet-next-page(); }
            hit-col(x) => { return root.sheet-hit-col(x); }
            select-rows(r, c, m, a) => { return root.sheet-select-rows(r, c, m, a); }
            is-typeahead-char(t) => { return root.sheet-is-typeahead-char(t); }
            toast(msg) => { root.toast(msg); }
            popout-window() => { root.popout-window(); }
            close-view() => { root.back(); }
        }
    }
}

// ================= LEADERBOARD =================
// Poin harian/bulanan. Peringkat 1–3 pakai warna teks (emas/perak/perunggu),
// tanpa emoji. Bar poin proporsional terhadap yang teratas.
component LeaderRow inherits Rectangle {
    in property <int> rank;
    in property <string> name;
    in property <string> points;
    in property <color> rank-color;
    callback clicked();
    callback right-clicked(); // klik kanan = kembali (§10.11): TouchArea
    // di atas menelan event tombol kanan, jadi harus diteruskan eksplisit.
    // C# LeaderboardView.axaml: baris = Rank 18 Bold (lebar 40) / Nama
    // 16 Bold / Poin 20 Bold AccentPoints — TANPA bar poin.
    height: 56px;
    background: lrow-touch.has-hover ? Design.bg-hover : transparent;
    border-radius: Design.radius-sm;
    lrow-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.right-clicked();
            }
        }
    }
    HorizontalLayout {
        padding-left: Design.space-md;
        padding-right: Design.space-md;
        spacing: Design.space-md;
        Text {
            width: 40px;
            text: rank;
            font-size: Design.font-h2;
            font-weight: 800;
            color: rank-color;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: name;
            font-size: 16px;
            font-weight: 800;
            color: Design.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: points;
            font-size: 20px;
            font-weight: 800;
            color: Design.cat-points;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

export component LeaderboardView inherits Rectangle {
    callback back();
    callback toast(string);
    callback refresh();
    in-out property <string> period: "Harian";
    // Papan skor dari akun (Rust mengisi; kosong = belum ada data).
    in-out property <[string]> lb-rows: [];
    in-out property <int> lb-row-count: 0;
    in-out property <[string]> lb-col0: [];
    in-out property <[string]> lb-col1: [];
    // Total poin dihitung Rust dari lb-rows (C# FormattedTotalPoints),
    // bukan hardcode. lb-loading = status "Loading..." (C# IsLoading).
    in-out property <string> lb-total: "0";
    in-out property <bool> lb-loading: false;

    // Timer refresh: 600ms "Loading..." lalu muat ulang dari DB
    // (pola yang sama dengan refresh-timer Trello di main.slint).
    lb-refresh-timer := Timer {
        interval: 600ms;
        running: root.lb-loading;
        triggered => {
            root.lb-loading = false;
            root.refresh();
        }
    }

    // Klik kanan = kembali ke dashboard (C# OnEmbeddedViewPointerPressed).
    leaderboard-back-touch := TouchArea {
        width: 100%; height: 100%;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.back();
            }
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: Design.space-xl;
        padding-right: Design.space-xl;
        padding-bottom: 30px;
        spacing: Design.space-md;

        HorizontalLayout {
            height: 36px;
            spacing: Design.space-sm;
            Text {
                text: "Leaderboard";
                font-size: Design.font-h2;
                font-weight: 800;
                color: Design.text-primary;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            height: 32px;
            spacing: 6px;
            alignment: center;
            OptionChip {
                label: "HARIAN";
                selected: root.period == "Harian";
                clicked => { root.period = "Harian"; root.toast("Leaderboard harian"); }
            }
            OptionChip {
                label: "BULANAN";
                selected: root.period == "Bulanan";
                clicked => { root.period = "Bulanan"; root.toast("Leaderboard bulanan"); }
            }
        }

        // Tinggi EKSPLISIT (bukan vertical-stretch): rantai persentase
        // di Slint jatuh ke preferred-height (pelajaran yang sama di
        // main.slint ~536) — vertical-stretch di Card maupun Rectangle
        // pembungkus tidak mengembang (terverifikasi live 2x di Sheets
        // dan Leaderboard). 195px = judul 36 + toggle 32 + separator 1
        // + footer 36 + 4 gap 48 + padding-bawah 30 + cadangan 12.
        // max() menjaga isi (317px) tidak terpotong bila root.height
        // ternyata setinggi isi. (Brief Fase 4: isi area kosong di bawah
        // — mengalahkan catatan lama "kartu besar kosong".)
        // C# LeaderboardView: "Loading..." di tengah saat IsLoading;
        // baris disembunyikan selama loading.
        if root.lb-loading : Text {
            text: "Loading...";
            height: max(330px, root.height - 195px);
            font-size: Design.font-body;
            color: Design.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if !root.lb-loading : Card {
            height: max(330px, root.height - 195px);
            VerticalLayout {
                padding: Design.space-md;
                spacing: 10px;
                if root.lb-row-count == 0 : Text {
                    text: "Belum ada data leaderboard";
                    font-size: Design.font-body;
                    color: Design.text-muted;
                }
                for i in 10 : LeaderRow {
                    visible: i < root.lb-row-count;
                    rank: i + 1;
                    name: root.lb-col0[i];
                    points: root.lb-col1[i];
                    rank-color: i == 0 ? Design.status-warning : i == 1 ? Design.text-secondary : i == 2 ? Design.medal-bronze : Design.text-muted;
                    clicked => { root.toast(root.lb-col0[i] + " — " + root.lb-col1[i] + " poin"); }
                    right-clicked => { root.back(); }
                }
            }
        }

        // Strip footer (C# LeaderboardView: "Total:" 12 + total 13 Bold
        // + "Pts" 11 di kiri + tombol refresh FAB 30x30 AccentBlue di
        // kanan; total dihitung dari data, bukan hardcode).
        HSeparator { }

        HorizontalLayout {
            height: 36px;
            spacing: Design.space-sm;
            Text {
                text: "Total:";
                font-size: Design.font-button;
                color: Design.text-secondary;
                vertical-alignment: center;
            }
            Text {
                text: root.lb-total;
                font-size: Design.font-body;
                font-weight: 700;
                color: Design.cat-points;
                vertical-alignment: center;
            }
            Text {
                text: "Pts";
                font-size: Design.font-caption;
                color: Design.text-secondary;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            // FAB refresh 30x30 (C#: Button 30x30 AccentBlue, ToolTip
            // "Refresh" — Slint tidak punya tooltip). Klik = status
            // "Loading..." 600ms lalu muat ulang dari DB.
            Rectangle {
                width: 30px; height: 30px;
                background: lb-fab-touch.has-hover ? #60a5fa : Design.accent;
                border-radius: Design.radius-sm;
                lb-fab-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.lb-loading = true; }
                }
                Text {
                    text: "↻";
                    font-size: 14px;
                    font-weight: 700;
                    color: #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%; height: 100%;
                }
            }
        }
    }
}
