// Log Panel — Sidebar kanan (kartu full-height, ref sidepanel-ref.jpg).
// Dibuka via saklar "Terminal" di flyout profil (EXPLORER_SPEC.md §3.1).
// Tab: EXPLORER / MASTER / DOC (tab LOG dihapus 28 Nov 2026, keputusan
// abeng 07:05). Tab EXPLORER = Mini Explorer Compact (daftar folder
// nyata dari Rust — rumah utama Explorer, 08:11).
// Menggunakan token Design dan ikon vektor Lucide.

import { Design, Card, HSeparator, Btn, TextField, SvgIcon } from "design.slint";
import { DocView } from "doc.slint";

// Tombol tab kecil di header panel dengan garis aksen aktif di bawah
component PanelTab inherits Rectangle {
    in property <string> label;
    in property <string> icon-name;
    in property <bool> selected;
    callback clicked();

    height: 32px;
    background: selected ? Design.accent-subtle : (tab-touch.has-hover ? Design.bg-hover : transparent);
    border-radius: Design.radius-sm;

    tab-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 4px;

        if root.icon-name != "" : VerticalLayout {
            alignment: center;
            SvgIcon {
                name: root.icon-name;
                size: 12px;
                icon-color: root.selected ? Design.accent : Design.text-muted;
            }
        }

        Text {
            text: label;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: selected ? Design.accent : Design.btn-secondary-fg;
            vertical-alignment: center;
        }
    }

    // Garis indikator aktif di bawah
    Rectangle {
        x: (parent.width - 24px) / 2;
        y: parent.height - 3px;
        width: 24px;
        height: 3px;
        background: Design.accent;
        border-radius: 1.5px;
        visible: selected;
    }
}


// Satu baris file ringkas di tab EXPLORER (mode compact).
// Baris mengikuti ref sidepanel-ref.jpg: separator tipis antar baris,
// ikon status di kiri, chevron ">" di kanan, padding lega.
export component ExplorerRow inherits Rectangle {
    in property <string> name;
    in property <bool> is-folder;
    in property <bool> selected;
    in property <string> detail;
    callback clicked();
    callback double-clicked();

    height: 44px;
    background: root.selected ? Design.accent-subtle : (row-touch.has-hover ? Design.bg-hover : transparent);
    border-radius: Design.radius-sm;

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }

    HorizontalLayout {
        padding-left: Design.space-sm;
        padding-right: Design.space-sm;
        spacing: Design.space-sm;

        VerticalLayout {
            alignment: center;
            SvgIcon {
                name: root.is-folder ? "folder" : "file";
                size: 14px;
                icon-color: root.is-folder ? Design.accent : Design.text-muted;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.name;
                font-size: Design.font-body;
                font-weight: root.is-folder ? 700 : 400;
                color: Design.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.detail != "" : Text {
                text: root.detail;
                font-size: Design.font-caption;
                color: Design.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            SvgIcon {
                name: "chevron-right";
                size: 14px;
                icon-color: Design.text-muted;
            }
        }
    }

    // Separator tipis antar baris (ref sidepanel-ref.jpg).
    Rectangle {
        x: 0; y: parent.height - 1px; width: 100%; height: 1px;
        background: Design.separator;
    }
}


// Tombol kecil 24px di header grup panel (ala chip Tab 1/2 di tab DOC).
component MiniBtn inherits Rectangle {
    in property <string> label;
    in property <string> icon-name: "";
    callback clicked();

    height: 24px;
    background: btn-touch.has-hover ? Design.bg-hover : Design.surface-elevated;
    border-color: Design.separator;
    border-width: 1px;
    border-radius: Design.radius-sm;

    btn-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        spacing: 4px;
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;

        if root.icon-name != "" : VerticalLayout {
            alignment: center;
            SvgIcon {
                name: root.icon-name;
                size: 11px;
                icon-color: Design.text-secondary;
            }
        }

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 700;
            color: Design.text-secondary;
            vertical-alignment: center;
        }
    }
}


// Tombol ikon 22px di baris panel (aksi baris: edit, naik/turun, hapus).
component RowBtn inherits Rectangle {
    in property <string> icon-name: "";
    in property <string> glyph: "";
    in property <bool> enabled: true;
    callback clicked();

    width: 22px;
    height: 22px;
    background: btn-touch.has-hover ? Design.bg-hover : transparent;
    border-radius: 4px;
    opacity: root.enabled ? 1 : 0.35;

    btn-touch := TouchArea {
        mouse-cursor: pointer;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    if root.icon-name != "" : SvgIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon-name;
        size: 13px;
        icon-color: Design.text-secondary;
    }
    if root.icon-name == "" : Text {
        text: root.glyph;
        font-size: 12px;
        font-weight: 700;
        color: Design.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}


// Satu baris TAMBAHAN MASTER (C# EditablePathItem).
// Baris 1: dot warna (klik = gilir palet) + ikon (klik = gilir ikon) +
// nama (pensil = edit inline) + aksi (↑/↓/×). Baris 2: path (klik teks
// = edit inline, tombol folder = browse). Edit inline meniru pola
// rename Explorer (TextInput <=> edit-text, Enter = commit).
component MasterExtraRow inherits Rectangle {
    in property <string> name;
    in property <string> path;
    in property <color> dot-color;
    in property <string> icon-name;
    in property <bool> can-up;
    in property <bool> can-down;
    // Mode edit inline (diatur parent): "" | "name" | "path".
    in property <string> edit-kind;
    in-out property <string> edit-text;
    callback edit-start(string);
    callback edit-commit(string, string);
    callback edit-cancel();
    callback cycle-color();
    callback cycle-icon();
    callback pick-path();
    callback move-up();
    callback move-down();
    callback delete();

    height: 56px;
    background: row-touch.has-hover ? Design.bg-hover : transparent;
    border-radius: Design.radius-sm;

    row-touch := TouchArea { mouse-cursor: pointer; }

    // Fokus input saat masuk mode edit (pola rename Explorer: focus
    // langsung + timer 50ms karena input baru muncul sering gagal fokus).
    property <bool> focus-pending: false;
    focus-timer := Timer {
        interval: 50ms;
        running: root.focus-pending;
        triggered => {
            root.focus-pending = false;
            if (root.edit-kind == "name") {
                name-input.focus();
            } else if (root.edit-kind == "path") {
                path-input.focus();
            }
        }
    }
    changed edit-kind => {
        if (self.edit-kind == "name") {
            name-input.focus();
        } else if (self.edit-kind == "path") {
            path-input.focus();
        }
        if (self.edit-kind != "") {
            root.focus-pending = true;
        }
    }

    VerticalLayout {
        spacing: 2px;
        padding-top: 4px;
        padding-bottom: 4px;

        // Baris 1: dot + ikon + nama/editor + aksi.
        HorizontalLayout {
            spacing: 6px;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 12px;
                    height: 12px;
                    background: root.dot-color;
                    border-radius: 6px;
                    dot-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cycle-color(); }
                    }
                }
            }

            Rectangle {
                width: 22px;
                height: 22px;
                background: icon-touch.has-hover ? Design.bg-hover : transparent;
                border-radius: 4px;
                icon-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.cycle-icon(); }
                }
                SvgIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: root.icon-name;
                    size: 14px;
                    icon-color: root.dot-color;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 24px;
                Text {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.edit-kind != "name";
                    text: root.name;
                    font-size: 13px;
                    font-weight: 700;
                    color: Design.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    x: 0; y: 1px; width: 100%; height: 22px;
                    visible: root.edit-kind == "name";
                    background: Design.bg-input;
                    border-color: Design.border-focus;
                    border-width: 1px;
                    border-radius: Design.radius-sm;
                    clip: true;
                    name-input := TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: 100%;
                        text <=> root.edit-text;
                        font-size: 13px;
                        color: Design.text-primary;
                        selection-foreground-color: white;
                        selection-background-color: Design.accent;
                        vertical-alignment: center;
                        accepted => { root.edit-commit("name", self.text); }
                    }
                }
            }

            if root.edit-kind == "name" : RowBtn {
                icon-name: "check";
                clicked => { root.edit-commit("name", root.edit-text); }
            }
            if root.edit-kind == "name" : RowBtn {
                icon-name: "x";
                clicked => { root.edit-cancel(); }
            }
            if root.edit-kind == "" : RowBtn {
                icon-name: "edit-3";
                clicked => { root.edit-start("name"); }
            }
            if root.edit-kind == "" : RowBtn {
                glyph: "↑";
                enabled: root.can-up;
                clicked => { root.move-up(); }
            }
            if root.edit-kind == "" : RowBtn {
                glyph: "↓";
                enabled: root.can-down;
                clicked => { root.move-down(); }
            }
            if root.edit-kind == "" : RowBtn {
                icon-name: "x";
                clicked => { root.delete(); }
            }
        }

        // Baris 2: path/editor + browse. Indent 46px = dot 12 + ikon 22
        // + 2× spacing 6, supaya path sejajar dengan nama.
        HorizontalLayout {
            spacing: 6px;
            Rectangle { width: 46px; height: 1px; }

            Rectangle {
                horizontal-stretch: 1;
                height: 20px;
                Text {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.edit-kind != "path";
                    text: root.path;
                    font-size: 11px;
                    font-family: "JetBrains Mono";
                    color: Design.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    x: 0; y: 0; width: 100%; height: 20px;
                    visible: root.edit-kind == "path";
                    background: Design.bg-input;
                    border-color: Design.border-focus;
                    border-width: 1px;
                    border-radius: Design.radius-sm;
                    clip: true;
                    path-input := TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: 100%;
                        text <=> root.edit-text;
                        font-size: 11px;
                        font-family: "JetBrains Mono";
                        color: Design.text-primary;
                        selection-foreground-color: white;
                        selection-background-color: Design.accent;
                        vertical-alignment: center;
                        accepted => { root.edit-commit("path", self.text); }
                    }
                }
                if root.edit-kind != "path" : TouchArea {
                    x: 0; y: 0; width: 100%; height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.edit-start("path"); }
                }
            }

            if root.edit-kind == "path" : RowBtn {
                icon-name: "check";
                clicked => { root.edit-commit("path", root.edit-text); }
            }
            if root.edit-kind == "path" : RowBtn {
                icon-name: "x";
                clicked => { root.edit-cancel(); }
            }
            if root.edit-kind != "path" : RowBtn {
                icon-name: "folder-open";
                clicked => { root.pick-path(); }
            }
        }
    }

    // Separator tipis antar baris (ala ExplorerRow).
    Rectangle {
        x: 0; y: parent.height - 1px; width: 100%; height: 1px;
        background: Design.separator;
    }
}


// Panel Samping — kartu kanan dashboard (lihat DESIGN_SYSTEM.md §18).
export component LogPanelView inherits Rectangle {
    callback toast(string);
    callback close();
    callback open-explorer(string);
    // DOC — Instan Redaksi (DocView bersama, ui/doc.slint): diikat
    // AppWindow ke callback Rust. doc-detached = DOC sedang tampil di
    // DocWindow terpisah (tab menampilkan placeholder + tombol kembali).
    callback doc-open-settings();
    callback doc-pop-out();
    callback doc-tear-off(length, length);
    callback doc-dock();
    callback doc-toggle-second-logo();
    callback doc-reset();
    callback doc-sync();
    callback doc-tab-add();
    callback doc-tab-select(int);
    callback doc-tab-close(int);
    callback doc-school-edited(string);
    callback doc-address-edited(string);
    callback doc-from-ps(string);
    callback doc-copy-field(string);
    callback doc-pick-logo(int);
    callback doc-clear-logo(int);
    callback doc-send-logo(int);
    callback doc-paste-logo(int);
    // Navigasi Explorer compact: muat folder / naik / buka file /
    // kirim folder ke BATCH — diikat AppWindow ke callback Rust.
    callback ex-nav(string);
    callback ex-nav-up();
    callback ex-open-file(string);
    callback ex-send-batch(string);

    // Tab aktif panel: "EXPLORER" | "MASTER" | "DOC"
    // (tab LOG dihapus 28 Nov 2026, keputusan abeng 07:05).
    in-out property <string> panel-tab: "EXPLORER";
    // Folder terpilih di daftar compact (untuk Kirim ke BATCH).
    in-out property <string> ex-sel-path: "";
    // Isi Explorer compact dari Rust (array sejajar ex-it-* AppWindow).
    in property <string> ex-cur-path: "";
    in property <[string]> ex-it-names: [];
    in property <[string]> ex-it-kinds: [];
    in property <[string]> ex-it-sizes: [];
    in property <[string]> ex-it-dates: [];
    in property <[string]> ex-it-paths: [];
    in property <[bool]> ex-it-isdir: [];
    in property <string> ex-root-error: "";
    // Mode datar: panel di dalam kartu wrapped luar — tanpa kartu
    // sendiri ("bungkus di dalam bungkus" dilarang abeng 27 Nov 22:03).
    in property <bool> flat: false;

    // State tab MASTER & DOC (diikat dua arah ke AppWindow).
    in-out property <string> master-search: "";
    in-out property <string> doc-school: "";
    in-out property <string> doc-address: "";
    in-out property <[string]> doc-tab-titles: ["Redaksi 1"];
    in-out property <int> doc-tab-idx: 0;
    in-out property <bool> doc-show-second-logo: false;
    in-out property <string> doc-logo-path: "";
    in-out property <string> doc-logo2-path: "";
    in property <bool> doc-logo-exists: false;
    in property <bool> doc-logo2-exists: false;
    in property <bool> doc-detached: false;

    // Grup TAMBAHAN MASTER + DOKUMEN (28 Nov 2026) — array sejajar dari
    // AppWindow (didorong Rust); am-* sudah terfilter `master-search`.
    in property <[string]> am-names: [];
    in property <[string]> am-paths: [];
    in property <[color]> am-colors: [];
    in property <[string]> am-icons: [];
    in property <[string]> doc-names: [];
    in property <[string]> doc-paths: [];
    in property <[bool]> doc-exists: [];
    callback am-add();
    callback am-delete(int);
    callback am-move(int, int);
    callback am-set-name(int, string);
    callback am-set-path(int, string);
    callback am-cycle-color(int);
    callback am-cycle-icon(int);
    callback am-pick-path(int);
    callback doc-add();
    callback doc-open(int);
    callback doc-remove(int);
    // State edit inline baris master (satu baris dalam satu waktu).
    in-out property <int> am-edit-idx: -1;
    in-out property <string> am-edit-kind: "";
    in-out property <string> am-edit-text: "";
    // Baris dokumen terpilih.
    in-out property <int> doc-sel-idx: -1;

    // (Tab LOG dihapus 28 Nov 2026 — props log-* + callback
    // clear/copy/stop-log ikut dihapus; data log subprocess tetap
    // mengalir ke prop root AppWindow untuk pemakaian mendatang.)

    background: root.flat ? transparent : Design.card-bg;
    border-color: Design.separator;
    border-width: root.flat ? 0px : 1px;
    border-radius: root.flat ? 0px : Design.radius-lg;
    clip: true;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: Design.space-md;
        spacing: Design.space-sm;

        // ----- Header: 4 Tab Navigasi + Tombol Tutup -----
        HorizontalLayout {
            height: 32px;
            spacing: 2px;

            PanelTab {
                label: "FILES";
                icon-name: "folder";
                horizontal-stretch: 1;
                selected: root.panel-tab == "EXPLORER";
                clicked => { root.panel-tab = "EXPLORER"; }
            }
            PanelTab {
                label: "MASTER";
                icon-name: "layers";
                horizontal-stretch: 1;
                selected: root.panel-tab == "MASTER";
                clicked => { root.panel-tab = "MASTER"; }
            }
            PanelTab {
                label: "DOC";
                icon-name: "file-text";
                horizontal-stretch: 1;
                selected: root.panel-tab == "DOC";
                clicked => { root.panel-tab = "DOC"; }
            }

            // Tombol Tutup Panel (×)
            Rectangle {
                width: 28px;
                height: 32px;
                background: x-touch.has-hover ? Design.bg-hover : transparent;
                border-radius: Design.radius-sm;

                x-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close(); }
                }

                SvgIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: "x";
                    size: 14px;
                    icon-color: Design.text-secondary;
                }
            }
        }

        HSeparator { }

        // ----- Isi Konten Panel -----
        Rectangle {
            vertical-stretch: 1;

            // ===== 2. Tab EXPLORER: Mini Explorer Compact =====
            // Rumah utama Explorer (keputusan abeng 28 Nov 08:11):
            // daftar folder nyata dari Rust — alur utama tidak lewat
            // new window lagi (window penuh tetap ada via tombol).
            // Stack Back/Forward tidak ada di mode compact (state-nya
            // hanya hidup di Explorer overlay) — batasan yang dicatat.
            VerticalLayout {
                x: 0; y: 0; width: 100%; height: 100%;
                visible: root.panel-tab == "EXPLORER";
                spacing: Design.space-sm;

                // Path Bar Ringkas: naik + path + muat ulang.
                Rectangle {
                    height: 32px;
                    background: Design.bg-input;
                    border-color: Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-sm;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;

                        // Tombol naik (Up) — tidak di atas root.
                        Rectangle {
                            width: 22px; height: 22px;
                            background: up-touch.has-hover ? Design.bg-hover : transparent;
                            border-radius: 4px;
                            up-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.ex-nav-up(); }
                            }
                            SvgIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                name: "arrow-up";
                                size: 12px;
                                icon-color: Design.text-secondary;
                            }
                        }

                        Text {
                            text: root.ex-cur-path == "" ? "—" : root.ex-cur-path;
                            font-size: 11px;
                            font-family: "JetBrains Mono";
                            color: Design.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        Rectangle {
                            width: 22px; height: 22px;
                            background: ref-touch.has-hover ? Design.bg-hover : transparent;
                            border-radius: 4px;
                            ref-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.ex-nav(root.ex-cur-path); }
                            }
                            SvgIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                name: "rotate-cw";
                                size: 12px;
                                icon-color: Design.text-secondary;
                            }
                        }
                    }
                }

                // Daftar folder nyata (scroll) — dari Rust.
                if root.ex-root-error != "" : Text {
                    text: root.ex-root-error;
                    font-size: Design.font-body;
                    color: Design.text-muted;
                    wrap: word-wrap;
                }
                if root.ex-root-error == "" && root.ex-it-names.length == 0 : Text {
                    text: "Folder ini kosong";
                    font-size: Design.font-body;
                    color: Design.text-muted;
                    horizontal-alignment: center;
                }
                if root.ex-root-error == "" : Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;
                        for item[i] in root.ex-it-names : ExplorerRow {
                            name: item;
                            is-folder: root.ex-it-isdir[i];
                            detail: root.ex-it-sizes[i] == "" ? root.ex-it-dates[i] : root.ex-it-sizes[i] + " · " + root.ex-it-dates[i];
                            selected: root.ex-sel-path == root.ex-it-paths[i];
                            clicked => { root.ex-sel-path = root.ex-it-paths[i]; }
                            double-clicked => {
                                if (root.ex-it-isdir[i]) {
                                    root.ex-nav(root.ex-it-paths[i]);
                                } else {
                                    root.ex-open-file(root.ex-it-paths[i]);
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Btn {
                        label: "Kirim ke BATCH";
                        variant: "secondary";
                        small: true;
                        clicked => {
                            if (root.ex-sel-path != "") {
                                root.ex-send-batch(root.ex-sel-path);
                            } else {
                                root.ex-send-batch(root.ex-cur-path);
                            }
                        }
                    }
                    Btn {
                        label: "Buka Window Baru";
                        variant: "secondary";
                        small: true;
                        clicked => { root.open-explorer(root.ex-cur-path); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // ===== 3. Tab MASTER: Daftar Template PSD =====
            VerticalLayout {
                x: 0; y: 0; width: 100%; height: 100%;
                visible: root.panel-tab == "MASTER";
                spacing: Design.space-sm;

                Rectangle {
                    height: 32px;
                    background: Design.bg-input;
                    border-color: Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-sm;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            SvgIcon {
                                name: "search";
                                size: 13px;
                                icon-color: Design.text-muted;
                            }
                        }
                        TextInput {
                            font-size: Design.font-body;
                            color: Design.text-primary;
                            vertical-alignment: center;
                            edited => { root.master-search = self.text; }
                        }
                    }
                }

                // ----- Grup TAMBAHAN MASTER (C# AdditionalMasterPaths) -----
                // Folder root master tambahan: sumber file .psd/.psb yang
                // nanti dibaca Master Browser (EXPLORER_SPEC §6, masih
                // deferred). Search di atas memfilter grup ini juga.
                HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    Text {
                        text: "TAMBAHAN MASTER";
                        font-size: 11px;
                        font-weight: 800;
                        letter-spacing: 0.5px;
                        color: Design.text-muted;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    MiniBtn {
                        label: "+ Tambah";
                        clicked => { root.am-add(); }
                    }
                }

                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;

                        if root.am-names.length == 0 : Text {
                            text: "Belum ada folder master tambahan.\nTambah folder berisi file .psd/.psb.";
                            font-size: Design.font-body;
                            color: Design.text-muted;
                            wrap: word-wrap;
                        }

                        for item[i] in root.am-names : MasterExtraRow {
                            name: item;
                            path: root.am-paths[i];
                            dot-color: root.am-colors[i];
                            icon-name: root.am-icons[i];
                            can-up: i > 0;
                            can-down: i < root.am-names.length - 1;
                            edit-kind: root.am-edit-idx == i ? root.am-edit-kind : "";
                            edit-text <=> root.am-edit-text;
                            edit-start(kind) => {
                                root.am-edit-idx = i;
                                root.am-edit-kind = kind;
                                root.am-edit-text = kind == "name" ? item : root.am-paths[i];
                            }
                            edit-commit(kind, text) => {
                                if (kind == "name") {
                                    root.am-set-name(i, text);
                                } else {
                                    root.am-set-path(i, text);
                                }
                                root.am-edit-idx = -1;
                                root.am-edit-kind = "";
                            }
                            edit-cancel() => {
                                root.am-edit-idx = -1;
                                root.am-edit-kind = "";
                            }
                            cycle-color() => { root.am-cycle-color(i); }
                            cycle-icon() => { root.am-cycle-icon(i); }
                            pick-path() => { root.am-pick-path(i); }
                            move-up() => { root.am-move(i, -1); }
                            move-down() => { root.am-move(i, 1); }
                            delete() => { root.am-delete(i); }
                        }
                    }
                }

                HSeparator { }

                // Master Browser (C# BatchVM.MasterNodes) — belum
                // dibangun: lokasi Master File Browser masih pertanyaan
                // terbuka (EXPLORER_SPEC §6). Tidak ada template contoh
                // (default publish bersih).
                Text {
                    text: "Belum ada template master";
                    font-size: Design.font-body;
                    color: Design.text-muted;
                    horizontal-alignment: center;
                }
            }

            // ===== 4. Tab DOC: Instan Redaksi (DocView bersama) =====
            // Saat terlepas, tab menampilkan placeholder + tombol kembali
            // (pola BATCH §16.10); tutup DocWindow -> dock ke sini.
            if root.panel-tab == "DOC" && root.doc-detached : VerticalLayout {
                x: 0; y: 0; width: 100%; height: 100%;
                spacing: Design.space-md;
                alignment: center;

                Text {
                    text: "DOC sedang terbuka di window terpisah.";
                    font-size: Design.font-body;
                    color: Design.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Btn {
                    label: "Kembalikan ke Panel";
                    variant: "primary";
                    small: true;
                    clicked => { root.doc-dock(); }
                }
            }

            if root.panel-tab == "DOC" && !root.doc-detached : DocView {
                x: 0; y: 0; width: 100%; height: 100%;
                show-tear-off: true;
                two-col: false;
                doc-school <=> root.doc-school;
                doc-address <=> root.doc-address;
                doc-tab-titles <=> root.doc-tab-titles;
                doc-tab-idx <=> root.doc-tab-idx;
                doc-show-second-logo <=> root.doc-show-second-logo;
                doc-logo-path <=> root.doc-logo-path;
                doc-logo2-path <=> root.doc-logo2-path;
                doc-logo-exists: root.doc-logo-exists;
                doc-logo2-exists: root.doc-logo2-exists;
                doc-names: root.doc-names;
                doc-paths: root.doc-paths;
                doc-exists: root.doc-exists;
                doc-sel-idx <=> root.doc-sel-idx;
                doc-open-settings() => { root.doc-open-settings(); }
                doc-pop-out() => { root.doc-pop-out(); }
                doc-tear-off(x, y) => { root.doc-tear-off(x, y); }
                doc-toggle-second-logo() => { root.doc-toggle-second-logo(); }
                doc-reset() => { root.doc-reset(); }
                doc-sync() => { root.doc-sync(); }
                doc-tab-add() => { root.doc-tab-add(); }
                doc-tab-select(idx) => { root.doc-tab-select(idx); }
                doc-tab-close(idx) => { root.doc-tab-close(idx); }
                doc-school-edited(text) => { root.doc-school-edited(text); }
                doc-address-edited(text) => { root.doc-address-edited(text); }
                doc-from-ps(field) => { root.doc-from-ps(field); }
                doc-copy-field(field) => { root.doc-copy-field(field); }
                doc-pick-logo(n) => { root.doc-pick-logo(n); }
                doc-clear-logo(n) => { root.doc-clear-logo(n); }
                doc-send-logo(n) => { root.doc-send-logo(n); }
                doc-paste-logo(n) => { root.doc-paste-logo(n); }
                doc-add() => { root.doc-add(); }
                doc-open(idx) => { root.doc-open(idx); }
                doc-remove(idx) => { root.doc-remove(idx); }
            }
        }
    }
}
