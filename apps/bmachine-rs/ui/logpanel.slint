// Log Panel — Sidebar kanan (overlay, lebar 320px).
// Dibuka via saklar "Terminal" di flyout profil (EXPLORER_SPEC.md §3.1).
// Tab: LOG / EXPLORER / MASTER / DOC.
// Menggunakan token Design dan ikon vektor Lucide.

import { Design, Card, HSeparator, Btn, TextField, SvgIcon } from "design.slint";

// Tombol tab kecil di header panel dengan garis aksen aktif di bawah
component PanelTab inherits Rectangle {
    in property <string> label;
    in property <string> icon-name;
    in property <bool> selected;
    callback clicked();

    height: 32px;
    background: selected ? Design.accent-subtle : (tab-touch.has-hover ? Design.bg-hover : transparent);
    border-radius: Design.radius-sm;

    tab-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 4px;

        if root.icon-name != "" : VerticalLayout {
            alignment: center;
            SvgIcon {
                name: root.icon-name;
                size: 12px;
                icon-color: root.selected ? Design.accent : Design.text-muted;
            }
        }

        Text {
            text: label;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: selected ? Design.accent : Design.btn-secondary-fg;
            vertical-alignment: center;
        }
    }

    // Garis indikator aktif di bawah
    Rectangle {
        x: (parent.width - 24px) / 2;
        y: parent.height - 3px;
        width: 24px;
        height: 3px;
        background: Design.accent;
        border-radius: 1.5px;
        visible: selected;
    }
}

// Satu baris log: strip warna level di kiri + teks mono 12px
component LogRow inherits Rectangle {
    in property <string> text;
    in property <color> level-color: Design.text-secondary;
    height: 24px;

    Rectangle {
        x: 0; y: 4px; width: 3px; height: 16px;
        background: level-color;
        border-radius: 1.5px;
    }

    Text {
        x: 10px; y: 0; width: parent.width - 10px; height: 100%;
        text: text;
        font-size: 11px;
        font-family: "JetBrains Mono";
        color: Design.text-secondary;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Satu baris file ringkas di tab EXPLORER
component ExplorerRow inherits Rectangle {
    in property <string> name;
    in property <bool> is-folder;
    callback clicked();

    height: 32px;
    background: row-touch.has-hover ? Design.bg-hover : transparent;
    border-radius: Design.radius-sm;

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Design.space-sm;
        padding-right: Design.space-sm;
        spacing: Design.space-sm;

        VerticalLayout {
            alignment: center;
            SvgIcon {
                name: root.is-folder ? "folder" : "file";
                size: 14px;
                icon-color: root.is-folder ? Design.accent : Design.text-muted;
            }
        }

        Text {
            text: name;
            font-size: Design.font-body;
            font-weight: is-folder ? 700 : 400;
            color: Design.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// Satu baris template master (.psd)
component MasterRow inherits Rectangle {
    in property <string> name;
    callback clicked();

    height: 36px;
    background: mrow-touch.has-hover ? Design.bg-hover : transparent;
    border-radius: Design.radius-sm;

    mrow-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Design.space-sm;
        padding-right: Design.space-sm;
        spacing: Design.space-sm;

        VerticalLayout {
            alignment: center;
            SvgIcon {
                name: "image";
                size: 14px;
                icon-color: Design.accent;
            }
        }

        Text {
            text: name;
            font-size: Design.font-body;
            font-weight: 700;
            font-family: "JetBrains Mono";
            color: Design.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: ".psd";
            font-size: Design.font-caption;
            color: Design.text-muted;
            vertical-alignment: center;
        }
    }
}

export component LogPanelView inherits Rectangle {
    callback toast(string);
    callback close();
    callback open-explorer(string);
    callback doc-tab-add();
    callback doc-tab-close();

    // Tab aktif panel: "LOG" | "EXPLORER" | "MASTER" | "DOC"
    in-out property <string> panel-tab: "LOG";

    // State tab MASTER & DOC
    in-out property <string> master-search: "";
    in-out property <string> doc-school: "SDN RANCAIYUH I";
    in-out property <string> doc-address: "Jl. Raya Rancaiyuh No. 12, Kec. Parongpong, Kab. Bandung Barat 40559";
    in-out property <string> doc-tab: "1";

    // Tab LOG live
    in property <[string]> log-lines: [
        "[08:30:12] [SYSTEM] BMachine service started",
        "[08:30:13] [SQLITE] Database connected: BMachine.db",
        "[08:30:14] [TRELLO] Sync active: 6 cards loaded",
        "[08:30:15] [READY] Ready for user actions"
    ];
    in property <string> log-status: "IDLE";
    in property <int> log-progress: 0;
    in property <string> log-progress-label: "Siap";

    callback clear-log();
    callback copy-log();
    callback stop-log();

    background: Design.card-bg;
    border-color: Design.separator;
    border-width: 1px;
    clip: true;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: Design.space-md;
        spacing: Design.space-sm;

        // ----- Header: 4 Tab Navigasi + Tombol Tutup -----
        HorizontalLayout {
            height: 32px;
            spacing: 2px;

            PanelTab {
                label: "LOG";
                icon-name: "terminal";
                horizontal-stretch: 1;
                selected: root.panel-tab == "LOG";
                clicked => { root.panel-tab = "LOG"; }
            }
            PanelTab {
                label: "FILES";
                icon-name: "folder";
                horizontal-stretch: 1;
                selected: root.panel-tab == "EXPLORER";
                clicked => { root.panel-tab = "EXPLORER"; }
            }
            PanelTab {
                label: "MASTER";
                icon-name: "layers";
                horizontal-stretch: 1;
                selected: root.panel-tab == "MASTER";
                clicked => { root.panel-tab = "MASTER"; }
            }
            PanelTab {
                label: "DOC";
                icon-name: "file-text";
                horizontal-stretch: 1;
                selected: root.panel-tab == "DOC";
                clicked => { root.panel-tab = "DOC"; }
            }

            // Tombol Tutup Panel (×)
            Rectangle {
                width: 28px;
                height: 32px;
                background: x-touch.has-hover ? Design.bg-hover : transparent;
                border-radius: Design.radius-sm;

                x-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close(); }
                }

                SvgIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: "x";
                    size: 14px;
                    icon-color: Design.text-secondary;
                }
            }
        }

        HSeparator { }

        // ----- Isi Konten Panel -----
        Rectangle {
            vertical-stretch: 1;

            // ===== 1. Tab LOG: Output Konsol Subproses =====
            VerticalLayout {
                x: 0; y: 0; width: 100%; height: 100%;
                visible: root.panel-tab == "LOG";
                spacing: Design.space-sm;

                // Progress Bar Live
                VerticalLayout {
                    spacing: 4px;
                    Rectangle {
                        height: 4px;
                        background: Design.surface-elevated;
                        border-radius: 2px;
                        Rectangle {
                            x: 0; y: 0;
                            width: parent.width * root.log-progress / 100;
                            height: 100%;
                            background: root.log-status == "DONE" ? Design.status-success
                                   : (root.log-status == "ERROR" ? Design.status-danger : Design.accent);
                            border-radius: 2px;
                            visible: root.log-progress > 0 || root.log-status == "DONE";
                        }
                    }
                    Text {
                        text: root.log-progress-label;
                        font-size: Design.font-caption;
                        color: Design.text-muted;
                    }
                }

                // Konsol Log
                Rectangle {
                    vertical-stretch: 1;
                    background: Design.bg-input;
                    border-color: Design.separator;
                    border-width: 1px;
                    border-radius: Design.radius-sm;
                    clip: true;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        for line in root.log-lines : LogRow {
                            text: line;
                            level-color: Design.accent;
                        }
                    }
                }

                HSeparator { }

                // Footer Tab Log: Status + Aksi (Stop/Copy/Clear)
                HorizontalLayout {
                    height: 32px;
                    spacing: 6px;

                    Rectangle {
                        width: 8px; height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: root.log-status == "RUNNING" ? Design.status-warning
                               : (root.log-status == "ERROR" ? Design.status-danger
                               : root.log-status == "DONE" ? Design.status-success
                               : Design.text-muted);
                    }

                    Text {
                        text: root.log-status;
                        font-size: Design.font-caption;
                        font-weight: 700;
                        color: Design.text-primary;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Btn {
                        label: "Stop";
                        variant: "secondary";
                        small: true;
                        clicked => {
                            root.stop-log();
                            root.toast("Proses dihentikan");
                        }
                    }
                    Btn {
                        label: "Salin";
                        variant: "ghost";
                        small: true;
                        clicked => {
                            root.copy-log();
                            root.toast("Log disalin ke clipboard");
                        }
                    }
                    Btn {
                        label: "Bersihkan";
                        variant: "danger";
                        small: true;
                        clicked => {
                            root.clear-log();
                            root.toast("Log dibersihkan");
                        }
                    }
                }
            }

            // ===== 2. Tab EXPLORER: Mini Explorer Compact =====
            VerticalLayout {
                x: 0; y: 0; width: 100%; height: 100%;
                visible: root.panel-tab == "EXPLORER";
                spacing: Design.space-sm;

                // Path Bar Ringkas
                Rectangle {
                    height: 32px;
                    background: Design.bg-input;
                    border-color: Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-sm;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            SvgIcon {
                                name: "folder";
                                size: 13px;
                                icon-color: Design.text-muted;
                            }
                        }

                        Text {
                            text: "D:\\#GAWENA";
                            font-size: 11px;
                            font-family: "JetBrains Mono";
                            color: Design.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        Rectangle {
                            width: 22px; height: 22px;
                            background: ref-touch.has-hover ? Design.bg-hover : transparent;
                            border-radius: 4px;
                            ref-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toast("Memuat ulang folder…"); }
                            }
                            SvgIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                name: "rotate-cw";
                                size: 12px;
                                icon-color: Design.text-secondary;
                            }
                        }
                    }
                }

                // Daftar Ringkas Folder
                VerticalLayout {
                    spacing: 2px;
                    ExplorerRow {
                        name: "27_SDN RANCAIYUH I";
                        is-folder: true;
                        clicked => { root.open-explorer("D:\\#GAWENA\\27_SDN RANCAIYUH I"); }
                    }
                    ExplorerRow {
                        name: "28_SDN BANTAR KAMBING 03";
                        is-folder: true;
                        clicked => { root.open-explorer("D:\\#GAWENA\\28_SDN BANTAR KAMBING 03"); }
                    }
                    ExplorerRow {
                        name: "PAS FOTO.psd";
                        is-folder: false;
                        clicked => { root.open-explorer("D:\\#GAWENA"); }
                    }
                    ExplorerRow {
                        name: "template.psd";
                        is-folder: false;
                        clicked => { root.open-explorer("D:\\#GAWENA"); }
                    }
                }

                HorizontalLayout {
                    Btn {
                        label: "Buka Window Baru";
                        variant: "secondary";
                        small: true;
                        clicked => { root.open-explorer("D:\\#GAWENA"); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Rectangle { vertical-stretch: 1; }
            }

            // ===== 3. Tab MASTER: Daftar Template PSD =====
            VerticalLayout {
                x: 0; y: 0; width: 100%; height: 100%;
                visible: root.panel-tab == "MASTER";
                spacing: Design.space-sm;

                Rectangle {
                    height: 32px;
                    background: Design.bg-input;
                    border-color: Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-sm;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            SvgIcon {
                                name: "search";
                                size: 13px;
                                icon-color: Design.text-muted;
                            }
                        }
                        TextInput {
                            font-size: Design.font-body;
                            color: Design.text-primary;
                            vertical-alignment: center;
                            edited => { root.master-search = self.text; }
                        }
                    }
                }

                Text {
                    text: "5 template master tersedia";
                    font-size: Design.font-caption;
                    color: Design.text-muted;
                }

                VerticalLayout {
                    spacing: 2px;
                    MasterRow {
                        name: "PFM-005.psd";
                        clicked => { root.toast("Template PFM-005 dipilih"); }
                    }
                    MasterRow {
                        name: "MSK-001.psd";
                        clicked => { root.toast("Template MSK-001 dipilih"); }
                    }
                    MasterRow {
                        name: "WSD-003.psd";
                        clicked => { root.toast("Template WSD-003 dipilih"); }
                    }
                    MasterRow {
                        name: "ASTRONOT.psd";
                        clicked => { root.toast("Template ASTRONOT dipilih"); }
                    }
                    MasterRow {
                        name: "TENTARA.psd";
                        clicked => { root.toast("Template TENTARA dipilih"); }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            // ===== 4. Tab DOC: Instan Redaksi =====
            VerticalLayout {
                x: 0; y: 0; width: 100%; height: 100%;
                visible: root.panel-tab == "DOC";
                spacing: Design.space-sm;

                Text {
                    text: "INSTAN REDAKSI";
                    font-size: Design.font-h3;
                    font-weight: 800;
                    color: Design.text-primary;
                    letter-spacing: 1px;
                }

                Text {
                    text: "Nama Sekolah";
                    font-size: Design.font-caption;
                    font-weight: 700;
                    color: Design.text-muted;
                }
                Rectangle {
                    height: 32px;
                    background: Design.bg-input;
                    border-color: Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-sm;
                    TextInput {
                        x: 8px; y: 0; width: parent.width - 16px; height: 100%;
                        text: root.doc-school;
                        font-size: Design.font-body;
                        color: Design.text-primary;
                        vertical-alignment: center;
                        edited => { root.doc-school = self.text; }
                    }
                }

                Text {
                    text: "Alamat";
                    font-size: Design.font-caption;
                    font-weight: 700;
                    color: Design.text-muted;
                }
                Rectangle {
                    height: 60px;
                    background: Design.bg-input;
                    border-color: Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-sm;
                    TextInput {
                        x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
                        text: root.doc-address;
                        font-size: Design.font-body;
                        color: Design.text-primary;
                        wrap: word-wrap;
                        edited => { root.doc-address = self.text; }
                    }
                }

                // Tab Selector Redaksi (1, 2)
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        width: 44px; height: 28px;
                        background: root.doc-tab == "1" ? Design.accent-subtle : Design.surface-elevated;
                        border-color: root.doc-tab == "1" ? Design.accent : Design.separator;
                        border-width: 1px;
                        border-radius: Design.radius-sm;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.doc-tab = "1"; root.toast("Tab Redaksi 1 aktif"); }
                        }
                        Text {
                            text: "Tab 1";
                            font-size: 10px; font-weight: 700;
                            color: root.doc-tab == "1" ? Design.accent : Design.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 44px; height: 28px;
                        background: root.doc-tab == "2" ? Design.accent-subtle : Design.surface-elevated;
                        border-color: root.doc-tab == "2" ? Design.accent : Design.separator;
                        border-width: 1px;
                        border-radius: Design.radius-sm;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.doc-tab = "2"; root.toast("Tab Redaksi 2 aktif"); }
                        }
                        Text {
                            text: "Tab 2";
                            font-size: 10px; font-weight: 700;
                            color: root.doc-tab == "2" ? Design.accent : Design.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }

                Btn {
                    label: "Sinkronisasi Redaksi";
                    variant: "primary";
                    small: true;
                    clicked => { root.toast("Redaksi tersinkronisasi ke Photoshop (doc_info.json)"); }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
