        cal-year <=> root.sheet-cal-year;
        cal-month <=> root.sheet-cal-month;
        cal-label <=> root.sheet-cal-label;
        cal-cells <=> root.sheet-cal-cells;
        cal-today <=> root.sheet-cal-today;
        cal-days-in-month <=> root.sheet-cal-days-in-month;
        cal-today-iso <=> root.sheet-cal-today-iso;
        cal-selected-day <=> root.sheet-cal-selected-day;
