// BMachine Dashboard — Rust/Slint.
// Menggunakan Design System di design.slint (token + komponen bersama).
// HOME = grid 2x2 StatWidget yang MENGISI window. Font mengikuti ukuran
// window lewat ui-scale. Tab HOME/BATCH benar-benar berpindah.
// Klik StatWidget menampilkan toast. Tombol profil membuka flyout.

import { Design, Card, HSeparator, NavTab, StatWidget, Btn, IconBtn, Toggle, TextField } from "design.slint";
import { SettingsView } from "settings.slint";
import { ToolboxView, SheetsView, LeaderboardView } from "modul.slint";
import { LogPanelView } from "logpanel.slint";
import { ExplorerView } from "explorer.slint";
import { TrelloDetailPanel } from "trello-detail.slint";
import { RadialMenuView } from "radial.slint";
import { SplashView } from "splash.slint";
import { ExitConfirmDialog, UpdateDialog } from "dialog.slint";

export component AppWindow inherits Window {
    width: Design.window-width;
    height: Design.window-height;
    title: "BMachine";
    background: Design.app-bg;

    in-out property <string> current-tab: "HOME";
    in-out property <bool> show-flyout: false;
    in-out property <string> toast: "";

    // State Fase 5: Splash & Dialog Modal
    in-out property <string> app-stage: "splash";
    in-out property <int> splash-progress: 0;
    in-out property <string> splash-status: "Menghubungkan Database SQLite...";
    in-out property <string> splash-log1: "";
    in-out property <string> splash-log2: "";
    in-out property <string> splash-log3: "";

    in-out property <string> dialog-open: ""; // "" | "EXIT" | "UPDATE"
    in-out property <string> update-latest-version: "v8.4.0";
    in-out property <string> update-size-text: "147 MB";
    in-out property <string> update-notes: "• Checklist Trello auto-refresh\n• Pembaruan skrip master & action";

    callback check-update();
    callback apply-update();
    callback dismiss-update();
    callback confirm-exit();

    // Log Panel (sidebar kanan): lebar 300px saat terbuka; konten
    // utama menyusut (content-width) supaya tidak tertutup panel.
    // Dibuka via saklar "Terminal" di flyout profil; ditutup via ×
    // di header panel. BUKAN Ctrl+L.
    in-out property <bool> show-logpanel: false;
    property <length> content-width: root.width - (root.show-logpanel ? 300px : 0px);

    // Overlay layar penuh (Settings/Toolbox/Sheets/Leaderboard/
    // Explorer/Trello-Window): "" = dashboard tampil (pill nav
    // terlihat); selain itu overlay tampil + pill nav disembunyikan
    // (seperti C#: MainWindow ContentControl beralih dari DashboardView).
    // Nilai: "" | "SETTINGS" | "TOOLBOX" | "SHEETS" | "LEADERBOARD" | "EXPLORER" | "TRELLO-WINDOW" | "RADIAL"
    in-out property <string> overlay-view: "";
    // Esc / shortcut global (KeyBinding di keys-scope) hanya aktif bila
    // FocusScope itu memegang fokus — klik mouse tidak memberi fokus ke
    // elemen apa pun yang bisa difokus (Btn = TouchArea), jadi begitu
    // dashboard tersembunyi (overlay dibuka) atau flyout dibuka, fokus
    // hilang dan Esc / Ctrl+, mati (terverifikasi live 26 Nov: Esc tidak
    // menutup radial maupun flyout; tapi Esc menutup Sheets saat TextInput
    // sedang fokus). Perbaiki: tiap kali overlay / flyout berubah,
    // kembalikan fokus ke keys-scope supaya KeyBinding selalu hidup.
    // (Explorer aman: open-explorer memanggil focus-list() SETELAH
    // overlay-view diset, jadi fokus Explorer tetap menang.)
    changed overlay-view => { keys-scope.focus(); }
    changed show-flyout => { if (root.show-flyout) { keys-scope.focus(); } }
    // Tab Toolbox yang dibuka dari Radial Menu (submenu TOOLBOX) —
    // two-way dengan ToolboxView.tool-tab supaya radial bisa membuka
    // TOOLBOX langsung pada tab MantraNama / MantraGanda / PsdBucin.
    // Default "MantraNama" = tab pertama Toolbox.
    in-out property <string> toolbox-tab: "MantraNama";
    // Tab aktif Log Panel — Ctrl+L membukanya dengan tab EXPLORER.
    in-out property <string> logpanel-tab: "LOG";

    // Explorer (overlay "EXPLORER"): path awal + hasil search /
    // type-ahead dari Rust (lihat src/main.rs). start-path berubah ->
    // ExplorerView menavigasi (changed start-path di explorer.slint).
    in-out property <string> ex-start-path: "D:\\#GAWENA";
    in-out property <[string]> ex-sr-names: [];
    in-out property <[string]> ex-sr-kinds: [];
    in-out property <[string]> ex-sr-exts: [];
    in-out property <[string]> ex-sr-bases: [];
    in-out property <[string]> ex-sr-sizes: [];
    in-out property <[string]> ex-sr-dates: [];
    in-out property <[string]> ex-sr-previews: [];
    in-out property <[string]> ex-sr-locs: [];
    in-out property <[string]> ex-sr-paths: [];
    in-out property <int> ex-sr-half: 0;
    in-out property <bool> ex-sr-truncated: false;
    in-out property <int> ex-ta-index: -1;
    // Grup Settings yang dibuka dari Explorer (gear Quick Access).
    // Two-way supaya klik grup di dalam Settings tetap tersinkron.
    in-out property <string> settings-group: "Appearance";
    // Callback Rust — diimplementasi di src/main.rs.
    callback ex-search(string, string);
    callback ex-typeahead(string, string);
    callback ex-add-txt-ext(string) -> string;
    callback ex-initials(string) -> string;
    callback ex-split-ext(string) -> string;
    callback ex-name-base(string) -> string;
    callback ex-is-typeahead-char(string) -> bool;

    // SETTING: gaya latar widget dashboard — nanti dipilih user di
    // Settings (fitur penuh: user bisa ganti background widgetnya
    // sendiri). Nilai: "doodle" | "dots" | "impulse" | "none".
    // Semua StatWidget membaca setting ini (bg: root.widget-bg),
    // jadi ganti satu tempat = ganti semua kartu. Default: "doodle".
    in-out property <string> widget-bg: "doodle";

    // FASE 3 — Daftar kartu + detail (Trello).
    // list-category: "" = grid dashboard; "EDITING"/"REVISION"/
    // "LATE"/"POINTS" = daftar kategori itu.
    // selected-card: "" = tidak ada detail; berisi judul kartu.
    // list-titles/subs/due: tiga array sejajar (Slint tidak bisa
    // append — ganti seluruh array sekaligus saat kategori dipilih).
    // selected-index: index kartu yang dipilih (untuk ambil sub/due
    // di detail).
    in-out property <string> list-category: "";
    in-out property <string> selected-card: "";
    in-out property <int> selected-index: 0;
    // detail-panel: sub-panel detail Trello yang aktif — "" (detail),
    // "comments" / "checklist" / "move" / "attachments" (C#
    // CardDetailPanelHost: sub-panel menggantikan detail di kolom
    // yang sama). Direset ke "" tiap kali kartu dibuka/ditutup.
    in-out property <string> detail-panel: "";
    // detail-added-count: jumlah komentar tambahan (mockup, maks 3)
    // yang ditambahkan di panel Comments kartu yang sedang dibuka.
    // Direset ke 0 tiap kali kartu dibuka/ditutup.
    in-out property <int> detail-added-count: 0;
    // Lebar kolom detail Trello (C# UnifiedTrelloView: 400,
    // MinWidth 320, MaxWidth 650 — port: 400, clamp 320 saat sempit).
    property <length> trello-detail-w: root.content-width >= 726px ? 400px : 320px;
    // Kolom detail/add-manual sedang terbuka (daftar menyusut).
    property <bool> trello-panel-open: root.selected-card != "" || root.add-manual-open;
    // Lebar detail window Trello (panel 760×600, padding 16 → isi
    // 728 ≥ 726 = 400; saat window utama sempit, isi < 726 = 320).
    property <length> tw-detail-w: min(760px, root.width - 40px) - 32px >= 726px ? 400px : 320px;
    in-out property <[string]> list-titles: [];
    in-out property <[string]> list-subs: [];
    in-out property <[string]> list-due: [];

    // Window Trello (CardListWindow C#) — dibuka dari TANDA PANAH
    // widget EDITING/REVISION/LATE: "" = tidak ada window;
    // "EDITING"/"REVISION"/"LATE" = window kategori itu terbuka
    // (overlay-view "TRELLO-WINDOW"). Window TIDAK memakai
    // list-category (supaya menutup window kembali ke grid, bukan
    // ke daftar embedded) — judul/aksen dari properti ini.
    in-out property <string> trello-window-cat: "";

    // Data daftar Trello — SATU sumber (jangan duplikasi literal di
    // tiap handler). Dipakai handler klik badan widget, tab embedded,
    // dan panah window. Pola sama seperti kids-b-* (BATCH).
    property <[string]> editing-titles: ["47276395_SDN RANCAIYUH 1_GUSFIARI", "48328499_SDN BANTAR KAMBING 03_YOGA", "30816883_TK ISLAM ARAFAH 1024_NISSA", "29332964_PAUD CAHAYA UMMAT 0724_NISSA", "49109072_TK ISLAM AL GHIFARI_NISSA", "TK ASSALAM_FENTI"];
    property <[string]> editing-subs: ["KELAS 2 · Pas Foto", "9 anak · 1 belum dikirim", "QC · Revisi", "Revisi Alfan", "Revisi Alfan", "QC Alif"];
    property <[string]> editing-due: ["28 Nov 2026", "30 Nov 2026", "1 Des 2026", "2 Des 2026", "3 Des 2026", "4 Des 2026"];
    property <[string]> revision-titles: ["TK ASSALAM_FENTI", "PAUD HAUR WANGUN_FENTI", "PAUD AL FURQON_SURYA", "PAUD TUNAS BANGSA_SURYA", "RA ATS-TSABIT_SURYA"];
    property <[string]> revision-subs: ["Revisi Alif", "Revisi Alif", "Revisi Surya", "Revisi Riyan", "Revisi Rahmah"];
    property <[string]> revision-due: ["28 Nov 2026", "29 Nov 2026", "30 Nov 2026", "1 Des 2026", "2 Des 2026"];
    property <[string]> late-titles: ["PAUD TUNAS BANGSA GUNUNG PUTRI_SURYA", "RA ATS-TSABIT_SURYA", "SDN BANTAR KAMBING 03_YOGA"];
    property <[string]> late-subs: ["Telat 2 hari", "Telat 3 hari", "Telat 1 hari"];
    property <[string]> late-due: ["24 Nov 2026", "23 Nov 2026", "25 Nov 2026"];
    // ID numerik tiap kartu (prefix nama — C# CardDetailPanelHost
    // DisplayId; "" bila nama tanpa prefix numerik).
    property <[string]> editing-ids: ["47276395", "48328499", "30816883", "29332964", "49109072", ""];
    property <[string]> revision-ids: ["", "", "", "", ""];
    property <[string]> late-ids: ["", "", ""];

    // Status checklist per kartu (C# TrelloCard.ChecklistStatusLabel:
    // DONE = checklist format nama user sudah diceklis, TODO = belum).
    // Badge ini penanda user apakah kartu sudah dikerjakan atau belum —
    // JANGAN dihilangkan. list-done dihitung dari kategori/window
    // aktif (satu sumber, tidak di-assign di handler).
    property <[bool]> editing-done: [true, false, false, true, false, false];
    property <[bool]> revision-done: [false, true, false, false, false];
    property <[bool]> late-done: [false, false, true];
    property <[bool]> list-done: root.trello-window-cat == "EDITING" ? root.editing-done : root.trello-window-cat == "REVISION" ? root.revision-done : root.trello-window-cat == "LATE" ? root.late-done : root.list-category == "EDITING" ? root.editing-done : root.list-category == "REVISION" ? root.revision-done : root.list-category == "LATE" ? root.late-done : [];
    // ID badge detail (sejajar list-done: window pakai trello-window-cat,
    // embedded pakai list-category).
    property <[string]> list-ids: root.trello-window-cat == "EDITING" ? root.editing-ids : root.trello-window-cat == "REVISION" ? root.revision-ids : root.trello-window-cat == "LATE" ? root.late-ids : root.list-category == "EDITING" ? root.editing-ids : root.list-category == "REVISION" ? root.revision-ids : root.list-category == "LATE" ? root.late-ids : [];

    // Bar status Trello (C# UnifiedTrelloView Row 0 / Row 3):
    // dot status + "Dimuat N card" + tombol + (EDITING saja)
    // + refresh. Jumlah = kartu daftar aktif + kartu manual
    // (manual hanya ada di EDITING).
    in-out property <bool> add-manual-open: false;
    in-out property <string> manual-input: "";
    in-out property <bool> trello-refreshing: false;
    // Kartu manual EDITING (C# ManualCards.Editing): maks 5 slot
    // di mockup — nama diambil dari slug/ID link (nama asli dari
    // API Trello di Fase 6). Url tampil di bawah nama (C#
    // EditingCardListView: Url IsVisible=IsManual) — itu penanda
    // "status berbeda" kartu manual.
    in-out property <[string]> manual-titles: ["", "", "", "", ""];
    in-out property <[string]> manual-urls: ["", "", "", "", ""];
    in-out property <[bool]> manual-done: [false, false, false, false, false];
    in-out property <int> manual-count: 0;
    property <int> trello-count: root.list-titles.length + (root.list-category == "EDITING" ? root.manual-count : 0);
    // Kartu yang dipilih adalah kartu manual? Dihitung dari judul
    // (tidak perlu reset di tiap handler).
    property <int> selected-manual-index: root.selected-card != "" && root.selected-card == root.manual-titles[0] ? 0 : root.selected-card != "" && root.selected-card == root.manual-titles[1] ? 1 : root.selected-card != "" && root.selected-card == root.manual-titles[2] ? 2 : root.selected-card != "" && root.selected-card == root.manual-titles[3] ? 3 : root.selected-card != "" && root.selected-card == root.manual-titles[4] ? 4 : -1;
    property <bool> selected-is-manual: root.selected-manual-index >= 0;
    callback import-manual(string);
    callback remove-manual(int);

    // Warna aksen kategori yang sedang dibuka (due date & label).
    property <color> list-accent: root.list-category == "EDITING" ? Design.cat-editing : root.list-category == "REVISION" ? Design.cat-revision : root.list-category == "LATE" ? Design.cat-late : Design.cat-points;

    // Warna aksen window Trello (dari trello-window-cat, bukan
    // list-category — lihat komentar di properti itu).
    property <color> tw-accent: root.trello-window-cat == "EDITING" ? Design.cat-editing : root.trello-window-cat == "REVISION" ? Design.cat-revision : Design.cat-late;

    // Skala teks kartu: yang terbesar dari ui-scale (lebar window) dan
    // rasio tinggi baris grid terhadap baris desain (200px). Supaya di
    // window kecil yang tinggi (mis. 520x600) teks tidak ketinggalan
    // kecil sementara kartunya tinggi — teks harus mengisi kartu.
    property <float> card-scale: max(root.ui-scale, ((root.height - 68px * root.ui-scale - 42px) / 1px) / 400);

    // Data BATCH v2 (proper, sesuai ANALISIS_BMACHINE.md §3).
    // SOURCE = ISI filesystem folder sekolah yang dipilih.
    // Level-1 = subfolder di dalam folder sekolah; tiap subfolder
    // punya 3 file contoh (children). Dua dataset contoh — tombol
    // "+ Tambah Folder" MENGGANTI seluruh koleksi (AddFolders),
    // bukan append. children 3 slot ("" = kosong/dihapus) + slot
    // ke-4 (index 3) yang hanya terisi bila subfolder baru dibuat
    // via input inline (K1 REA, 26 Nov) — dibaca dengan guard
    // .length supaya array 3 elemen tetap aman.
    in-out property <string> src-name: "27_SDN RANCAIYUH I";
    in-out property <bool> use-folder-b: false;
    in-out property <[string]> src-folders: [
        "PAS FOTO", "FOTO10RP_FREE SEKOLAH_GRAIS",
        "SOUVENIR_FREE ID CARD", "SOUVENIR_FREE KARTU PELAJA",
    ];
    property <[string]> src-folders-b: ["PAS FOTO", "WISUDA", "ID CARD", "KARTU PELAJAR"];
    in-out property <[string]> kids-0: ["Ahmad.jpg", "Budi.jpg", "template.psd"];
    in-out property <[string]> kids-1: ["foto_01.jpg", "foto_02.jpg", "foto_03.jpg"];
    in-out property <[string]> kids-2: ["id_01.jpg", "id_02.jpg", "template.psd"];
    in-out property <[string]> kids-3: ["kartu_01.jpg", "kartu_02.jpg", "kartu_03.jpg"];
    property <[string]> kids-b-0: ["Dewi.jpg", "Eko.jpg", "template.psd"];
    property <[string]> kids-b-1: ["wisuda_01.jpg", "wisuda_02.jpg", "template.psd"];
    property <[string]> kids-b-2: ["id_01.jpg", "id_02.jpg", "id_03.jpg"];
    property <[string]> kids-b-3: ["kartu_01.jpg", "kartu_02.jpg", "template.psd"];

    // State tree: folder yang di-expand ("" = tidak ada),
    // node terpilih (multi-select, maks 3), node yang menu
    // konteksnya terbuka + posisi node itu (untuk Delete).
    in-out property <string> expanded-node: "";
    in-out property <[string]> selected-nodes: [];
    in-out property <string> ctx-node: "";
    in-out property <int> ctx-folder-idx: -1;
    in-out property <int> ctx-child-idx: -1;
    in-out property <bool> ctx-is-child: false;
    // Panel asal context menu (K1 REA): "SOURCE" | "OUTPUT".
    // Menu OUTPUT = New Subfolder… / Delete / Copy Path /
    // Copy Output Path (tanpa Replace); menu SOURCE = New
    // Subfolder… / Replace (Auto) / Copy Path / Delete.
    in-out property <string> ctx-panel: "SOURCE";
    // Input inline nama subfolder baru (K1 REA — CancelNewFolderInput
    // / CancelOutputNewFolderInput di BatchFolderRoot): panel + nama
    // induk + indeks folder + nama yang diketik. newfolder-panel ""
    // = tidak ada input terbuka. Slot anak ke-4 (index 3) hanya
    // terisi bila subfolder baru dibuat (kids 3 slot + slot 4
    // dibaca dengan guard .length — array 3 elemen aman).
    in-out property <string> newfolder-panel: "";
    in-out property <string> newfolder-parent: "";
    in-out property <int> newfolder-idx: -1;
    in-out property <string> newfolder-name: "";
    property <bool> newfolder-done: false;
    // Konfirmasi input inline subfolder baru — dipanggil dari
    // TextField (Enter) dan tombol ✓ di baris input, di kedua panel.
    // Sisip ke slot kosong pertama kids/out-kids target.
    callback confirm-new-folder();
    confirm-new-folder => {
        root.newfolder-done = false;
        if (root.newfolder-name == "") {
            root.toast = "Nama folder tidak boleh kosong.";
        } else if (root.newfolder-panel == "SOURCE") {
            if (root.newfolder-idx == 0) {
                if (root.kids-0[0] == "") { root.kids-0 = [root.newfolder-name, root.kids-0[1], root.kids-0[2], root.kids-0.length > 3 ? root.kids-0[3] : ""]; root.newfolder-done = true; }
                else if (root.kids-0[1] == "") { root.kids-0 = [root.kids-0[0], root.newfolder-name, root.kids-0[2], root.kids-0.length > 3 ? root.kids-0[3] : ""]; root.newfolder-done = true; }
                else if (root.kids-0[2] == "") { root.kids-0 = [root.kids-0[0], root.kids-0[1], root.newfolder-name, root.kids-0.length > 3 ? root.kids-0[3] : ""]; root.newfolder-done = true; }
                else if (root.kids-0.length <= 3 || root.kids-0[3] == "") { root.kids-0 = [root.kids-0[0], root.kids-0[1], root.kids-0[2], root.newfolder-name]; root.newfolder-done = true; }
                else { root.toast = "Sudah 4 item di " + root.newfolder-parent + " — hapus dulu satu file (contoh)."; }
            } else if (root.newfolder-idx == 1) {
                if (root.kids-1[0] == "") { root.kids-1 = [root.newfolder-name, root.kids-1[1], root.kids-1[2], root.kids-1.length > 3 ? root.kids-1[3] : ""]; root.newfolder-done = true; }
                else if (root.kids-1[1] == "") { root.kids-1 = [root.kids-1[0], root.newfolder-name, root.kids-1[2], root.kids-1.length > 3 ? root.kids-1[3] : ""]; root.newfolder-done = true; }
                else if (root.kids-1[2] == "") { root.kids-1 = [root.kids-1[0], root.kids-1[1], root.newfolder-name, root.kids-1.length > 3 ? root.kids-1[3] : ""]; root.newfolder-done = true; }
                else if (root.kids-1.length <= 3 || root.kids-1[3] == "") { root.kids-1 = [root.kids-1[0], root.kids-1[1], root.kids-1[2], root.newfolder-name]; root.newfolder-done = true; }
                else { root.toast = "Sudah 4 item di " + root.newfolder-parent + " — hapus dulu satu file (contoh)."; }
            } else if (root.newfolder-idx == 2) {
                if (root.kids-2[0] == "") { root.kids-2 = [root.newfolder-name, root.kids-2[1], root.kids-2[2], root.kids-2.length > 3 ? root.kids-2[3] : ""]; root.newfolder-done = true; }
                else if (root.kids-2[1] == "") { root.kids-2 = [root.kids-2[0], root.newfolder-name, root.kids-2[2], root.kids-2.length > 3 ? root.kids-2[3] : ""]; root.newfolder-done = true; }
                else if (root.kids-2[2] == "") { root.kids-2 = [root.kids-2[0], root.kids-2[1], root.newfolder-name, root.kids-2.length > 3 ? root.kids-2[3] : ""]; root.newfolder-done = true; }
                else if (root.kids-2.length <= 3 || root.kids-2[3] == "") { root.kids-2 = [root.kids-2[0], root.kids-2[1], root.kids-2[2], root.newfolder-name]; root.newfolder-done = true; }
                else { root.toast = "Sudah 4 item di " + root.newfolder-parent + " — hapus dulu satu file (contoh)."; }
            } else {
                if (root.kids-3[0] == "") { root.kids-3 = [root.newfolder-name, root.kids-3[1], root.kids-3[2], root.kids-3.length > 3 ? root.kids-3[3] : ""]; root.newfolder-done = true; }
                else if (root.kids-3[1] == "") { root.kids-3 = [root.kids-3[0], root.newfolder-name, root.kids-3[2], root.kids-3.length > 3 ? root.kids-3[3] : ""]; root.newfolder-done = true; }
                else if (root.kids-3[2] == "") { root.kids-3 = [root.kids-3[0], root.kids-3[1], root.newfolder-name, root.kids-3.length > 3 ? root.kids-3[3] : ""]; root.newfolder-done = true; }
                else if (root.kids-3.length <= 3 || root.kids-3[3] == "") { root.kids-3 = [root.kids-3[0], root.kids-3[1], root.kids-3[2], root.newfolder-name]; root.newfolder-done = true; }
                else { root.toast = "Sudah 4 item di " + root.newfolder-parent + " — hapus dulu satu file (contoh)."; }
            }
        } else if (root.newfolder-panel == "OUTPUT") {
            if (root.newfolder-idx == 0) {
                if (root.out-kids-0[0] == "") { root.out-kids-0 = [root.newfolder-name, root.out-kids-0[1], root.out-kids-0[2], root.out-kids-0.length > 3 ? root.out-kids-0[3] : ""]; root.newfolder-done = true; }
                else if (root.out-kids-0[1] == "") { root.out-kids-0 = [root.out-kids-0[0], root.newfolder-name, root.out-kids-0[2], root.out-kids-0.length > 3 ? root.out-kids-0[3] : ""]; root.newfolder-done = true; }
                else if (root.out-kids-0[2] == "") { root.out-kids-0 = [root.out-kids-0[0], root.out-kids-0[1], root.newfolder-name, root.out-kids-0.length > 3 ? root.out-kids-0[3] : ""]; root.newfolder-done = true; }
                else if (root.out-kids-0.length <= 3 || root.out-kids-0[3] == "") { root.out-kids-0 = [root.out-kids-0[0], root.out-kids-0[1], root.out-kids-0[2], root.newfolder-name]; root.newfolder-done = true; }
                else { root.toast = "Sudah 4 item di " + root.newfolder-parent + " — hapus dulu satu file (contoh)."; }
            } else if (root.newfolder-idx == 1) {
                if (root.out-kids-1[0] == "") { root.out-kids-1 = [root.newfolder-name, root.out-kids-1[1], root.out-kids-1[2], root.out-kids-1.length > 3 ? root.out-kids-1[3] : ""]; root.newfolder-done = true; }
                else if (root.out-kids-1[1] == "") { root.out-kids-1 = [root.out-kids-1[0], root.newfolder-name, root.out-kids-1[2], root.out-kids-1.length > 3 ? root.out-kids-1[3] : ""]; root.newfolder-done = true; }
                else if (root.out-kids-1[2] == "") { root.out-kids-1 = [root.out-kids-1[0], root.out-kids-1[1], root.newfolder-name, root.out-kids-1.length > 3 ? root.out-kids-1[3] : ""]; root.newfolder-done = true; }
                else if (root.out-kids-1.length <= 3 || root.out-kids-1[3] == "") { root.out-kids-1 = [root.out-kids-1[0], root.out-kids-1[1], root.out-kids-1[2], root.newfolder-name]; root.newfolder-done = true; }
                else { root.toast = "Sudah 4 item di " + root.newfolder-parent + " — hapus dulu satu file (contoh)."; }
            } else if (root.newfolder-idx == 2) {
                if (root.out-kids-2[0] == "") { root.out-kids-2 = [root.newfolder-name, root.out-kids-2[1], root.out-kids-2[2], root.out-kids-2.length > 3 ? root.out-kids-2[3] : ""]; root.newfolder-done = true; }
                else if (root.out-kids-2[1] == "") { root.out-kids-2 = [root.out-kids-2[0], root.newfolder-name, root.out-kids-2[2], root.out-kids-2.length > 3 ? root.out-kids-2[3] : ""]; root.newfolder-done = true; }
                else if (root.out-kids-2[2] == "") { root.out-kids-2 = [root.out-kids-2[0], root.out-kids-2[1], root.newfolder-name, root.out-kids-2.length > 3 ? root.out-kids-2[3] : ""]; root.newfolder-done = true; }
                else if (root.out-kids-2.length <= 3 || root.out-kids-2[3] == "") { root.out-kids-2 = [root.out-kids-2[0], root.out-kids-2[1], root.out-kids-2[2], root.newfolder-name]; root.newfolder-done = true; }
                else { root.toast = "Sudah 4 item di " + root.newfolder-parent + " — hapus dulu satu file (contoh)."; }
            } else {
                if (root.out-kids-3[0] == "") { root.out-kids-3 = [root.newfolder-name, root.out-kids-3[1], root.out-kids-3[2], root.out-kids-3.length > 3 ? root.out-kids-3[3] : ""]; root.newfolder-done = true; }
                else if (root.out-kids-3[1] == "") { root.out-kids-3 = [root.out-kids-3[0], root.newfolder-name, root.out-kids-3[2], root.out-kids-3.length > 3 ? root.out-kids-3[3] : ""]; root.newfolder-done = true; }
                else if (root.out-kids-3[2] == "") { root.out-kids-3 = [root.out-kids-3[0], root.out-kids-3[1], root.newfolder-name, root.out-kids-3.length > 3 ? root.out-kids-3[3] : ""]; root.newfolder-done = true; }
                else if (root.out-kids-3.length <= 3 || root.out-kids-3[3] == "") { root.out-kids-3 = [root.out-kids-3[0], root.out-kids-3[1], root.out-kids-3[2], root.newfolder-name]; root.newfolder-done = true; }
                else { root.toast = "Sudah 4 item di " + root.newfolder-parent + " — hapus dulu satu file (contoh)."; }
            }
        }
        if (root.newfolder-done) {
            root.toast = "Subfolder '" + root.newfolder-name + "' dibuat di " + root.newfolder-parent;
            root.newfolder-panel = "";
            root.newfolder-name = "";
        }
    }

    // Dua fase master: Fase 1 (buat_master.py) membuat manifest;
    // Fase 2 (tombol BUAT MASTER = buat_master_duplikat.py)
    // BUTUH manifest — tanpa manifest, error.
    in-out property <bool> has-manifest: false;
    // OUTPUT = tree SENDIRI dari folder output di disk (terpisah
    // dari SOURCE — BUKAN cermin live). Diisi saat BUAT MASTER /
    // script footer berhasil (salin struktur SOURCE saat itu);
    // dikosongkan saat Clear / ganti SOURCE. Expand OUTPUT pakai
    // state sendiri (expanded-out). Sesuai BATCH_DASHBOARD.md §3.3.
    in-out property <[string]> out-folders: ["", "", "", ""];
    in-out property <[string]> out-kids-0: ["", "", ""];
    in-out property <[string]> out-kids-1: ["", "", ""];
    in-out property <[string]> out-kids-2: ["", "", ""];
    in-out property <[string]> out-kids-3: ["", "", ""];
    in-out property <string> expanded-out: "";

    in-out property <string> selected-source: "27_SDN RANCAIYUH I";
    in-out property <string> selected-output: "27_SDN RANCAIYUH I";
    in-out property <string> selected-master: "PAS FOTO";

    // SOURCE kosong = keempat slot "" (Bersihkan / hapus semua).
    // src-folders selalu 4 entri (tidak pernah []) supaya indeks
    // [0..3] aman dibaca binding.
    property <bool> src-empty: root.src-folders[0] == "" && root.src-folders[1] == "" && root.src-folders[2] == "" && root.src-folders[3] == "";
    // OUTPUT kosong = keempat slot "" (folder output belum ada di
    // disk → chip "(pending)" tampil). Sama seperti src-empty.
    property <bool> out-empty: root.out-folders[0] == "" && root.out-folders[1] == "" && root.out-folders[2] == "" && root.out-folders[3] == "";

    // Skala fluid: font & padding widget mengikuti ukuran window.
    // 1 = ukuran desain (grid 600x400); naik saat window membesar
    // (maks 2.5), tidak pernah turun di bawah 1 supaya tetap terbaca.
    property <float> scale-w: ((self.width - 40px) / 1px) / 600;
    property <float> scale-h: ((self.height - 98px) / 1px) / 400;
    property <float> ui-scale: max(1, min(min(scale-w, scale-h), 2.5));

    toast-timer := Timer {
        interval: 2500ms;
        running: root.toast != "";
        triggered => { root.toast = ""; }
    }

    // Refresh Trello (C# RefreshActiveListCommand): tombol ↻ di bar
    // status. Mockup: jeda 600ms lalu toast + hitung ulang.
    refresh-timer := Timer {
        interval: 600ms;
        running: root.trello-refreshing;
        triggered => {
            root.trello-refreshing = false;
            root.toast = "Trello di-refresh — " + root.trello-count + " card dimuat";
        }
    }

    // Shortcut global — KeyBinding di FocusScope pembungkus (keys-scope).
    // KeyBinding aktif bahkan saat fokus ada di TextField (key event
    // membubbling ke scope ini); forward-focus memberi fokus awal ke scope.
    // focus-on-click: false supaya klik tidak dimakan scope ini (klik
    // pertama ke tombol harus tetap sampai ke tombol).
    // Ctrl+L = buka Log Panel tab EXPLORER (arahan abeng 26 Nov 16:22 —
    // MENGALAHKAN bacaan kode lama yang bilang Ctrl+L = Focus Address Bar;
    // selisih ini dicatat di DESIGN_SYSTEM.md §10.7).
    // Ctrl+, = Settings. Esc = tutup overlay / flyout.
    forward-focus: keys-scope;
    keys-scope := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        KeyBinding {
            keys: @keys(Control + L);
            activated => {
                root.overlay-view = "";
                root.show-logpanel = true;
                root.logpanel-tab = "EXPLORER";
                root.show-flyout = false;
            }
        }
        KeyBinding {
            keys: @keys(Control + Comma);
            activated => {
                root.overlay-view = "SETTINGS";
                root.show-flyout = false;
            }
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if (root.dialog-open != "") {
                    root.dialog-open = "";
                } else if (root.overlay-view == "EXPLORER") {
                    // Prioritas Esc Explorer: dialog → tab-ctx → ctx →
                    // rename → addr-edit → search → buffer type-ahead →
                    // tutup overlay (esc-pressed di explorer.slint).
                    explorer-view.esc-pressed();
                } else if (root.overlay-view != "") {
                    if (root.overlay-view == "TRELLO-WINDOW") {
                        if (root.detail-panel != "") {
                            // Esc di sub-panel detail window = kembali ke detail.
                            root.detail-panel = "";
                        } else {
                            root.trello-window-cat = "";
                            root.selected-card = "";
                            root.detail-added-count = 0;
                            root.overlay-view = "";
                        }
                    } else {
                        root.overlay-view = "";
                    }
                } else if (root.selected-card != "") {
                    // Esc di detail Trello: sub-panel → detail, detail → daftar.
                    if (root.detail-panel != "") {
                        root.detail-panel = "";
                    } else {
                        root.selected-card = "";
                        root.detail-added-count = 0;
                    }
                } else if (root.show-flyout) {
                    root.show-flyout = false;
                }
            }
        }

    // Dashboard (pill nav + konten) — disembunyikan saat overlay
    // layar penuh terbuka (overlay-view != "").
    VerticalLayout {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        visible: root.overlay-view == "";
        spacing: 0;

        // ===== Pill nav (terpusat, margin 12).
        // Ikut mengikuti ukuran window lewat ui-scale — di layar besar
        // nav ikut membesar, tidak tertinggal kecil. =====
        HorizontalLayout {
            height: 68px * root.ui-scale;
            padding-top: Design.space-md * root.ui-scale;
            padding-bottom: Design.space-md * root.ui-scale;

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: pill-content.preferred-width;
                height: 44px * root.ui-scale;
                background: Design.card-bg;
                border-color: Design.separator;
                border-width: 1px;
                border-radius: Design.radius-md;

                pill-content := HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 6px * root.ui-scale;
                    spacing: 2px * root.ui-scale;
                    alignment: center;

                    // Tombol profil (ikon user-circle).
                    Rectangle {
                        width: 32px * root.ui-scale;
                        height: 32px * root.ui-scale;
                        background: root.show-flyout ? Design.bg-hover : transparent;
                        border-radius: Design.radius-sm;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show-flyout = !root.show-flyout; }
                        }

                        Rectangle {
                            width: 24px * root.ui-scale;
                            height: 24px * root.ui-scale;
                            x: 4px * root.ui-scale;
                            y: 4px * root.ui-scale;
                            background: transparent;
                            border-color: Design.text-primary;
                            border-width: 1.5px * root.ui-scale;
                            border-radius: 12px * root.ui-scale;
                        }
                        Rectangle {
                            width: 8px * root.ui-scale;
                            height: 8px * root.ui-scale;
                            x: 12px * root.ui-scale;
                            y: 9px * root.ui-scale;
                            background: Design.text-primary;
                            border-radius: 4px * root.ui-scale;
                        }
                        Rectangle {
                            width: 14px * root.ui-scale;
                            height: 7px * root.ui-scale;
                            x: 9px * root.ui-scale;
                            y: 19px * root.ui-scale;
                            background: Design.text-primary;
                            border-radius: 4px * root.ui-scale;
                        }
                    }

                    // Separator.
                    Rectangle {
                        width: 1px;
                        height: 24px * root.ui-scale;
                        background: Design.separator;
                    }

                    NavTab {
                        label: "HOME";
                        selected: root.current-tab == "HOME";
                        scale: root.ui-scale;
                        clicked => { root.current-tab = "HOME"; root.show-flyout = false; root.list-category = ""; root.selected-card = ""; root.add-manual-open = false; root.detail-panel = ""; root.detail-added-count = 0; }
                    }
                    NavTab {
                        label: "BATCH";
                        selected: root.current-tab == "BATCH";
                        scale: root.ui-scale;
                        clicked => { root.current-tab = "BATCH"; root.show-flyout = false; root.list-category = ""; root.selected-card = ""; root.add-manual-open = false; root.detail-panel = ""; root.detail-added-count = 0; }
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Orb Radial Menu (Fase 4) — ujung kanan bar nav, di LUAR
            // pill (nav §15 tidak diubah: pill tetap profil + HOME +
            // BATCH saja). Entry point utama radial: selalu terlihat
            // di dashboard, tidak menabrak grid / BATCH / daftar.
            // Bentuk: cincin aksen + titik aksen (bukan emoji).
            Rectangle {
                width: 48px * root.ui-scale;
                Rectangle {
                    width: 36px * root.ui-scale;
                    height: 36px * root.ui-scale;
                    x: (parent.width - 36px * root.ui-scale) / 2;
                    y: (parent.height - 36px * root.ui-scale) / 2;
                    background: orb-touch.has-hover ? Design.accent-subtle : transparent;
                    border-color: Design.accent;
                    border-width: 1px;
                    border-radius: 18px * root.ui-scale;
                    animate background { duration: Design.anim-normal; }
                    Rectangle {
                        width: 10px * root.ui-scale;
                        height: 10px * root.ui-scale;
                        x: (parent.width - 10px * root.ui-scale) / 2;
                        y: (parent.height - 10px * root.ui-scale) / 2;
                        background: Design.accent;
                        border-radius: 5px * root.ui-scale;
                    }
                    orb-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            radial-view.reset();
                            root.overlay-view = "RADIAL";
                            root.show-flyout = false;
                        }
                    }
                }
            }
        }

        // ===== Area konten + Log Panel: HorizontalLayout — konten
        // (lebar content-width, menyusut saat Log Panel terbuka) +
        // Log Panel (300px saat terbuka, 0px saat tertutup).
        // Konten-konten menumpuk di dalam Rectangle (posisi absolut,
        // masing-masing 100% x 100%, hanya yang aktif yang visible —
        // jadi tidak saling makan ruang). =====
        HorizontalLayout {
            vertical-stretch: 1;

            Rectangle {
                width: root.content-width;
                // Tinggi eksplisit (window − nav), BUKAN height: 100%:
                // rantai persentase di sini pernah membuat tinggi konten
                // jatuh ke preferred-height (~1080px) dan mendorong isi
                // Settings ke bawah (layout gap, 26 Nov).
                height: root.height - 68px * root.ui-scale;

            // ----- Radial Menu (Fase 4): Shift + Klik Tengah di latar
            // dashboard = buka Radial Menu (trigger default C# K20:
            // MouseButton=2 / Middle, Modifiers=4 / Shift). TouchArea
            // ini anak PERTAMA (di belakang semua isi) — klik kiri
            // tidak ditangani di sini, hanya pointer tengah + Shift.
            // Keterbatasan: klik tengah DI ATAS widget/baris tidak
            // sampai ke sini (TouchArea widget di atasnya menangkap
            // event duluan) — hanya celah latar (padding/gutter) yang
            // merespons; tombol orb di bar nav adalah entry utama.
            radial-trigger-touch := TouchArea {
                x: 0; y: 0; width: 100%; height: 100%;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.middle && ev.modifiers.shift) {
                        radial-view.reset();
                        root.overlay-view = "RADIAL";
                        root.show-flyout = false;
                    }
                }
            }

            // ----- HOME: grid 2x2 StatWidget mengisi window -----
            // Hanya tampil saat tidak ada daftar kategori yang dibuka.
            VerticalLayout {
                x: 0; y: 0;
                width: 100%; height: 100%;
                visible: root.current-tab == "HOME" && root.list-category == "";
                padding-left: Design.space-xl;
                padding-right: Design.space-xl;
                padding-bottom: 30px;
                spacing: Design.space-md;

                HorizontalLayout {
                    spacing: Design.space-md;
                    height: (root.height - 68px * root.ui-scale - 42px) / 2;
                    StatWidget {
                        width: (root.content-width - 52px) / 2;
                        label: "EDITING"; value: "24"; suffix: "CARD";
                        accent: Design.cat-editing;
                        bg: root.widget-bg;
                        scale: root.card-scale;
                        clicked => {
                            root.list-titles = root.editing-titles;
                            root.list-subs = root.editing-subs;
                            root.list-due = root.editing-due;
                            root.selected-card = "";
                            root.list-category = "EDITING";
                            root.toast = "Daftar EDITING — 6 kartu";
                        }
                        arrow-clicked => {
                            root.list-titles = root.editing-titles;
                            root.list-subs = root.editing-subs;
                            root.list-due = root.editing-due;
                            root.selected-card = "";
                            root.trello-window-cat = "EDITING";
                            root.overlay-view = "TRELLO-WINDOW";
                            root.toast = "Window Trello EDITING";
                        }
                    }
                    StatWidget {
                        width: (root.content-width - 52px) / 2;
                        label: "REVISION"; value: "7"; suffix: "CARD";
                        accent: Design.cat-revision;
                        bg: root.widget-bg;
                        scale: root.card-scale;
                        clicked => {
                            root.list-titles = root.revision-titles;
                            root.list-subs = root.revision-subs;
                            root.list-due = root.revision-due;
                            root.selected-card = "";
                            root.list-category = "REVISION";
                            root.toast = "Daftar REVISION — 5 kartu";
                        }
                        arrow-clicked => {
                            root.list-titles = root.revision-titles;
                            root.list-subs = root.revision-subs;
                            root.list-due = root.revision-due;
                            root.selected-card = "";
                            root.trello-window-cat = "REVISION";
                            root.overlay-view = "TRELLO-WINDOW";
                            root.toast = "Window Trello REVISI";
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Design.space-md;
                    height: (root.height - 68px * root.ui-scale - 42px) / 2;
                    StatWidget {
                        width: (root.content-width - 52px) / 2;
                        label: "LATE"; value: "3"; suffix: "CARD";
                        accent: Design.cat-late;
                        bg: root.widget-bg;
                        scale: root.card-scale;
                        clicked => {
                            root.list-titles = root.late-titles;
                            root.list-subs = root.late-subs;
                            root.list-due = root.late-due;
                            root.selected-card = "";
                            root.list-category = "LATE";
                            root.toast = "Daftar LATE — 3 kartu";
                        }
                        arrow-clicked => {
                            root.list-titles = root.late-titles;
                            root.list-subs = root.late-subs;
                            root.list-due = root.late-due;
                            root.selected-card = "";
                            root.trello-window-cat = "LATE";
                            root.overlay-view = "TRELLO-WINDOW";
                            root.toast = "Window Trello SUSULAN";
                        }
                    }
                    StatWidget {
                        width: (root.content-width - 52px) / 2;
                        label: "POINTS"; value: "1.280"; suffix: "POIN";
                        accent: Design.cat-points;
                        bg: root.widget-bg;
                        scale: root.card-scale;
                        clicked => {
                            root.list-category = "";
                            root.selected-card = "";
                            root.overlay-view = "LEADERBOARD";
                            root.toast = "Leaderboard — poin editor";
                        }
                        arrow-clicked => {
                            root.list-category = "";
                            root.selected-card = "";
                            root.overlay-view = "SHEETS";
                            root.toast = "Spreadsheet BMachine";
                        }
                    }
                }
            }

            // ----- Daftar kartu (FASE 3): tampil saat kategori dipilih -----
            // Menggantikan grid HOME. Header: kembali + judul + jumlah.
            // Baris 48 px (C# EditingCardListView): checkbox + nama
            // kartu + badge checklist TODO/DONE di kanan. Klik baris ->
            // buka detail kartu; klik checkbox = seleksi kartu.
            // Klik kanan = kembali ke dashboard (C# DashboardView:
            // OnEmbeddedViewPointerPressed → NavigateBack). TouchArea
            // latar (di belakang isi) menangkap klik kanan di area kosong;
            // klik kanan di baris ditangani list-touch di bawah.
            Rectangle {
                x: 0; y: 0;
                width: root.trello-panel-open ? parent.width - root.trello-detail-w - 6px : parent.width; height: 100%;
                // Daftar TETAP tampil (menyempit) saat detail maupun
                // Add Manual terbuka di kolom kanan — sama seperti C#.
                visible: root.current-tab == "HOME" && root.list-category != "";
                list-back-touch := TouchArea {
                    width: 100%; height: 100%;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                            root.list-category = "";
                            root.selected-card = "";
                            root.toast = "Kembali ke dashboard (klik kanan)";
                        }
                    }
                }
            VerticalLayout {
                x: 0; y: 0;
                width: 100%; height: 100%;
                padding-left: Design.space-xl;
                padding-right: Design.space-xl;
                padding-bottom: 30px;
                spacing: Design.space-md;

                // Header.
                HorizontalLayout {
                    height: 36px * root.ui-scale;
                    spacing: 8px * root.ui-scale;
                    Text {
                        text: root.list-category == "REVISION" ? "REVISI" : root.list-category == "LATE" ? "SUSULAN" : root.list-category;
                        font-size: Design.font-h2 * root.ui-scale;
                        font-weight: 800;
                        color: Design.text-primary;
                        letter-spacing: 1px * root.ui-scale;
                        vertical-alignment: center;
                    }
                }

                // Bar status Trello (C# UnifiedTrelloView: dot status
                // + StatusMessage "Dimuat N card" + toolbar +/refresh).
                // Tombol + HANYA di EDITING (Add Manual Cards).
                // Di screenshot abeng 26 Nov 19:25 bar ini ada di ATAS
                // tab (di C# embedded aslinya bar ini ada di bawah —
                // Row 3 — tapi yang ditandai abeng adalah yang di atas).
                Rectangle {
                    background: Design.card-bg;
                    border-color: Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-md;
                    HorizontalLayout {
                        height: 36px * root.ui-scale;
                        padding-left: 12px * root.ui-scale;
                        padding-right: 12px * root.ui-scale;
                        spacing: 8px * root.ui-scale;
                        Text {
                            text: "●";
                            font-size: 10px * root.ui-scale;
                            color: #45C98A;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.trello-refreshing ? "Memuat ulang…" : "Dimuat " + root.trello-count + " card";
                            font-size: 12px * root.ui-scale;
                            font-weight: 500;
                            color: Design.text-secondary;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        // Wadah tombol + (EDITING saja): lebar 0 saat
                        // tersembunyi supaya tidak makan ruang (Slint:
                        // visible:false saja tetap makan ruang layout).
                        Rectangle {
                            width: root.list-category == "EDITING" ? 28px * root.ui-scale : 0px;
                            height: 36px * root.ui-scale;
                            clip: true;
                            IconBtn {
                                x: 0px;
                                y: (parent.height - 28px * root.ui-scale) / 2;
                                glyph: "+";
                                variant: "ghost";
                                size: 28px;
                                scale: root.ui-scale;
                                visible: root.list-category == "EDITING";
                                clicked => { root.add-manual-open = true; root.manual-input = ""; root.selected-card = ""; root.detail-panel = ""; root.detail-added-count = 0; }
                            }
                        }
                        // Wadah tombol refresh (tengah vertikal — anak
                        // layout berukuran eksplisit menempel ke atas).
                        Rectangle {
                            width: 28px * root.ui-scale;
                            height: 36px * root.ui-scale;
                            IconBtn {
                                x: 0px;
                                y: (parent.height - 28px * root.ui-scale) / 2;
                                glyph: "↻";
                                variant: "ghost";
                                size: 28px;
                                scale: root.ui-scale;
                                opacity: root.trello-refreshing ? 0.4 : 1.0;
                                clicked => {
                                    if (!root.trello-refreshing) {
                                        root.trello-refreshing = true;
                                    }
                                }
                            }
                        }
                    }
                }

                // Tab Trello (UnifiedTrelloView C#: EDITING / REVISI /
                // SUSULAN). Klik tab = ganti daftar (isi ulang array
                // dari data tunggal); tab aktif = kategori kini.
                HorizontalLayout {
                    height: 32px * root.ui-scale;
                    spacing: 2px * root.ui-scale;
                    NavTab {
                        label: "EDITING";
                        scale: root.ui-scale;
                        selected: root.list-category == "EDITING";
                        clicked => {
                            root.list-titles = root.editing-titles;
                            root.list-subs = root.editing-subs;
                            root.list-due = root.editing-due;
                            root.selected-card = "";
                            root.list-category = "EDITING";
                            root.toast = "Daftar EDITING — 6 kartu";
                        }
                    }
                    NavTab {
                        label: "REVISI";
                        scale: root.ui-scale;
                        selected: root.list-category == "REVISION";
                        clicked => {
                            root.list-titles = root.revision-titles;
                            root.list-subs = root.revision-subs;
                            root.list-due = root.revision-due;
                            root.selected-card = "";
                            root.list-category = "REVISION";
                            root.toast = "Daftar REVISI — 5 kartu";
                        }
                    }
                    NavTab {
                        label: "SUSULAN";
                        scale: root.ui-scale;
                        selected: root.list-category == "LATE";
                        clicked => {
                            root.list-titles = root.late-titles;
                            root.list-subs = root.late-subs;
                            root.list-due = root.late-due;
                            root.selected-card = "";
                            root.list-category = "LATE";
                            root.toast = "Daftar SUSULAN — 3 kartu";
                        }
                    }
                }

                // Daftar baris kartu (di-scroll via Flickable — C#:
                // daftar Trello ada di ScrollViewer; isi bisa lebih
                // panjang dari Card saat kartu manual ditambahkan).
                list-card := Card {
                    vertical-stretch: 1;
                    Flickable {
                        x: 0; y: 0; width: 100%; height: 100%;
                        VerticalLayout {
                            x: 0; width: list-card.width;
                            padding: Design.space-md;
                            spacing: 4px * root.ui-scale;

                        for t[index] in root.list-titles:
                            Rectangle {
                                height: 48px * root.ui-scale;
                                background: list-touch.has-hover ? Design.bg-hover : transparent;
                                border-radius: Design.radius-sm;
                                list-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.selected-card = t;
                                        root.selected-index = index;
                                        root.detail-panel = "";
                                        root.detail-added-count = 0;
                                        root.toast = "Membuka: " + t;
                                    }
                                    // Klik kanan di baris = kembali ke dashboard
                                    // (C# CardListWindow: double klik kanan = Close;
                                    // di port ini satu klik kanan sudah kembali —
                                    // klik kedua dalam 500ms mendarat di dashboard).
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                            root.list-category = "";
                                            root.selected-card = "";
                                            root.toast = "Kembali ke dashboard (klik kanan)";
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 10px * root.ui-scale;
                                    padding-right: 10px * root.ui-scale;
                                    spacing: 10px * root.ui-scale;

                                    // Checkbox seleksi (C# CheckBox kiri kartu).
                                    // Wadah setinggi baris; kotak 16px di tengah.
                                    check-wrap := Rectangle {
                                        property <bool> checked: false;
                                        width: 16px * root.ui-scale;
                                        height: 48px * root.ui-scale;
                                        check-box := Rectangle {
                                            width: 16px * root.ui-scale;
                                            height: 16px * root.ui-scale;
                                            x: 0px;
                                            y: (parent.height - 16px * root.ui-scale) / 2;
                                            background: check-wrap.checked ? root.list-accent : transparent;
                                            border-color: check-wrap.checked ? root.list-accent : Design.border-hover;
                                            border-width: 1px;
                                            border-radius: 4px * root.ui-scale;
                                            Text {
                                                width: 100%;
                                                height: 100%;
                                                text: "✓";
                                                font-size: 11px * root.ui-scale;
                                                font-weight: 700;
                                                color: white;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                visible: check-wrap.checked;
                                            }
                                        }
                                        check-touch := TouchArea {
                                            x: 0px;
                                            y: (parent.height - 16px * root.ui-scale) / 2;
                                            width: 16px * root.ui-scale;
                                            height: 16px * root.ui-scale;
                                            mouse-cursor: pointer;
                                            clicked => { check-wrap.checked = !check-wrap.checked; }
                                        }
                                    }

                                    // Nama kartu — prioritas utama (C#: Name 13 SemiBold).
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text {
                                            text: t;
                                            font-size: 13px * root.ui-scale;
                                            font-weight: 700;
                                            color: Design.text-primary;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                    }

                                    // Badge checklist TODO/DONE (C# ChecklistStatusLabel).
                                    // Warna persis BoolToColorConverter C#.
                                    badge-wrap := Rectangle {
                                        width: 62px * root.ui-scale;
                                        height: 48px * root.ui-scale;
                                        badge := Rectangle {
                                            width: 62px * root.ui-scale;
                                            height: 22px * root.ui-scale;
                                            x: 0px;
                                            y: (parent.height - 22px * root.ui-scale) / 2;
                                            background: root.list-done[index] ? #173F2D : transparent;
                                            border-color: root.list-done[index] ? #3FAF78 : #46505C;
                                            border-width: 1px;
                                            border-radius: 999px;
                                            HorizontalLayout {
                                                x: 0px;
                                                y: (parent.height - 9px * root.ui-scale) / 2;
                                                width: 100%;
                                                height: 9px * root.ui-scale;
                                                spacing: 4px * root.ui-scale;
                                                alignment: center;
                                                Text {
                                                    text: "●";
                                                    font-size: 9px * root.ui-scale;
                                                    color: root.list-done[index] ? #45C98A : #7B8794;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: root.list-done[index] ? "DONE" : "TODO";
                                                    font-size: 9px * root.ui-scale;
                                                    font-weight: 700;
                                                    letter-spacing: 1px * root.ui-scale;
                                                    color: root.list-done[index] ? #9DE8C1 : #AAB4BF;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        // Baris kartu manual (EDITING saja) — nama +
                        // Url di bawah nama (C# EditingCardListView:
                        // Url IsVisible=IsManual). Maks 5 slot; tinggi
                        // 0 + clip saat slot kosong (pola tree BATCH).
                        for mi in 5:
                            Rectangle {
                                height: root.list-category == "EDITING" && mi < root.manual-count ? 64px * root.ui-scale : 0px;
                                visible: root.list-category == "EDITING" && mi < root.manual-count;
                                clip: true;
                                background: m-list-touch.has-hover ? Design.bg-hover : transparent;
                                border-radius: Design.radius-sm;
                                m-list-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.selected-card = root.manual-titles[mi];
                                        root.selected-index = 0;
                                        root.detail-panel = "";
                                        root.detail-added-count = 0;
                                        root.toast = "Membuka: " + root.manual-titles[mi];
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                            root.list-category = "";
                                            root.selected-card = "";
                                            root.toast = "Kembali ke dashboard (klik kanan)";
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 10px * root.ui-scale;
                                    padding-right: 10px * root.ui-scale;
                                    spacing: 10px * root.ui-scale;

                                    // Checkbox seleksi (kotak 16px di tengah baris 64px).
                                    m-check-wrap := Rectangle {
                                        property <bool> checked: false;
                                        width: 16px * root.ui-scale;
                                        height: 64px * root.ui-scale;
                                        m-check-box := Rectangle {
                                            width: 16px * root.ui-scale;
                                            height: 16px * root.ui-scale;
                                            x: 0px;
                                            y: (parent.height - 16px * root.ui-scale) / 2;
                                            background: m-check-wrap.checked ? root.list-accent : transparent;
                                            border-color: m-check-wrap.checked ? root.list-accent : Design.border-hover;
                                            border-width: 1px;
                                            border-radius: 4px * root.ui-scale;
                                            Text {
                                                width: 100%;
                                                height: 100%;
                                                text: "✓";
                                                font-size: 11px * root.ui-scale;
                                                font-weight: 700;
                                                color: white;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                visible: m-check-wrap.checked;
                                            }
                                        }
                                        m-check-touch := TouchArea {
                                            x: 0px;
                                            y: (parent.height - 16px * root.ui-scale) / 2;
                                            width: 16px * root.ui-scale;
                                            height: 16px * root.ui-scale;
                                            mouse-cursor: pointer;
                                            clicked => { m-check-wrap.checked = !m-check-wrap.checked; }
                                        }
                                    }

                                    // Nama + Url (penanda kartu manual).
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text {
                                            text: root.manual-titles[mi];
                                            font-size: 13px * root.ui-scale;
                                            font-weight: 700;
                                            color: Design.text-primary;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.manual-urls[mi];
                                            font-size: 11px * root.ui-scale;
                                            color: Design.text-muted;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                    }

                                    // Badge checklist TODO/DONE.
                                    m-badge-wrap := Rectangle {
                                        width: 62px * root.ui-scale;
                                        height: 64px * root.ui-scale;
                                        m-badge := Rectangle {
                                            width: 62px * root.ui-scale;
                                            height: 22px * root.ui-scale;
                                            x: 0px;
                                            y: (parent.height - 22px * root.ui-scale) / 2;
                                            background: root.manual-done[mi] ? #173F2D : transparent;
                                            border-color: root.manual-done[mi] ? #3FAF78 : #46505C;
                                            border-width: 1px;
                                            border-radius: 999px;
                                            HorizontalLayout {
                                                x: 0px;
                                                y: (parent.height - 9px * root.ui-scale) / 2;
                                                width: 100%;
                                                height: 9px * root.ui-scale;
                                                spacing: 4px * root.ui-scale;
                                                alignment: center;
                                                Text {
                                                    text: "●";
                                                    font-size: 9px * root.ui-scale;
                                                    color: root.manual-done[mi] ? #45C98A : #7B8794;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: root.manual-done[mi] ? "DONE" : "TODO";
                                                    font-size: 9px * root.ui-scale;
                                                    font-weight: 700;
                                                    letter-spacing: 1px * root.ui-scale;
                                                    color: root.manual-done[mi] ? #9DE8C1 : #AAB4BF;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                    }
                    }
                }
            }
            }

            // ----- Detail kartu (FASE 3): panel di kolom kanan -----
            // C# UnifiedTrelloView: GridSplitter 6px + kolom kanan 400
            // (MinWidth 320, MaxWidth 650); daftar menyusut, detail
            // tampil berdampingan — bukan menggantikan daftar.
            // CardDetailPanelHost: klik kanan detail = tutup,
            // klik kanan sub-panel = kembali ke detail, × = tutup.
            // Double klik kanan = kembali ke dashboard: klik pertama
            // detail→daftar, klik kedua (di daftar) daftar→dashboard.
            Rectangle {
                x: parent.width - root.trello-detail-w; y: 0;
                width: root.trello-detail-w; height: 100%;
                visible: root.current-tab == "HOME" && root.selected-card != "";
                TrelloDetailPanel {
                    x: 0; y: 0; width: 100%; height: 100%;
                    card-title: root.selected-card;
                    event-date: root.selected-is-manual ? "—" : root.list-due[root.selected-index];
                    display-id: root.selected-is-manual ? "" : root.list-ids[root.selected-index];
                    due-text: root.selected-is-manual ? "" : "Due: " + root.list-due[root.selected-index];
                    is-manual: root.selected-is-manual;
                    manual-url: root.selected-is-manual ? root.manual-urls[root.selected-manual-index] : "";
                    category-label: root.list-category == "REVISION" ? "REVISI" : root.list-category == "LATE" ? "SUSULAN" : root.list-category;
                    accent: root.list-accent;
                    done: root.selected-is-manual ? root.manual-done[root.selected-manual-index] : root.list-done[root.selected-index];
                    description: "Edit pas foto sekolah — crop, centering kepala di guide, logo terlihat.";
                    sub-panel: root.detail-panel;
                    added-count: root.detail-added-count;
                    close => { root.selected-card = ""; root.detail-panel = ""; root.detail-added-count = 0; }
                    unlink => { root.remove-manual(root.selected-manual-index); root.selected-card = ""; root.detail-panel = ""; root.detail-added-count = 0; }
                    show-toast(text) => { root.toast = text; }
                }
            }

            // ----- Panel Add Manual Cards (FASE 3): tampil saat
            // tombol + di bar status ditekan (EDITING saja).
            // C# UnifiedTrelloView: panel di kolom kanan, header
            // "Add Manual Cards" + TextBox link + "Import Cards".
            // Klik kanan / × = tutup panel (tanpa menyimpan).
            // Ukuran C# tetap (tanpa ui-scale): header 16px,
            // input 200px, tombol Import 38px.
            Rectangle {
                x: parent.width - root.trello-detail-w; y: 0;
                width: root.trello-detail-w; height: 100%;
                visible: root.current-tab == "HOME" && root.add-manual-open;
                add-manual-back-touch := TouchArea {
                    width: 100%; height: 100%;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                            root.add-manual-open = false;
                            root.manual-input = "";
                            root.toast = "Panel Add Manual ditutup (klik kanan)";
                        }
                    }
                }
            VerticalLayout {
                x: 0; y: 0;
                width: 100%; height: 100%;
                padding: 20px;
                spacing: Design.space-md;

                // Header: judul + subjudul + tombol tutup.
                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Add Manual Cards";
                            font-size: 16px;
                            font-weight: 600;
                            color: Design.text-primary;
                        }
                        Text {
                            text: "Paste Trello links below to manually track them.";
                            font-size: 12px;
                            color: Design.text-secondary;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 32px;
                        height: 36px;
                        IconBtn {
                            x: 0px;
                            y: (parent.height - 32px) / 2;
                            glyph: "×";
                            variant: "ghost";
                            size: 32px;
                            clicked => { root.add-manual-open = false; root.manual-input = ""; }
                        }
                    }
                }

                // Input link (multi-baris, 200px — C# TextBox Height 200).
                Rectangle {
                    height: 200px;
                    background: Design.bg-input;
                    border-color: Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-md;
                    clip: true;
                    Text {
                        x: 15px;
                        y: 15px;
                        text: "https://trello.com/c/...";
                        font-size: 13px;
                        color: Design.text-muted;
                        visible: root.manual-input == "";
                    }
                    manual-input-field := TextInput {
                        x: 15px;
                        y: 15px;
                        width: parent.width - 30px;
                        height: parent.height - 30px;
                        text: root.manual-input;
                        single-line: false;
                        wrap: word-wrap;
                        font-size: 13px;
                        color: Design.text-primary;
                        edited => { root.manual-input = self.text; }
                    }
                }

                // Tombol Import (C#: Action, Height 38, full width).
                Btn {
                    label: "Import Cards";
                    variant: "primary";
                    scale: 1.06;
                    horizontal-stretch: 1;
                    clicked => { root.import-manual(root.manual-input); }
                }

                Text {
                    text: "Satu link per baris. Nama kartu diambil dari slug di link (nama asli dari API Trello di Fase 6).";
                    font-size: 11px;
                    color: Design.text-muted;
                    wrap: word-wrap;
                }
            }
            }

            // ----- BATCH v2: tree filesystem + dua fase master +
            // Replace (proper, sesuai ANALISIS_BMACHINE.md §3).
            // SOURCE = ISI folder sekolah (tree, expand lazy);
            // BUAT MASTER = fase 2 (butuh manifest fase 1);
            // Replace single + multiple; toolbar = launcher skrip.
            VerticalLayout {
                x: 0; y: 0;
                width: 100%; height: 100%;
                visible: root.current-tab == "BATCH";
                padding-left: Design.space-xl;
                padding-right: Design.space-xl;
                padding-top: Design.space-md;
                padding-bottom: Design.space-xl;
                spacing: Design.space-md;

                // Header: judul + deskripsi + tambah folder.
                HorizontalLayout {
                    height: 36px * root.ui-scale;
                    spacing: 8px * root.ui-scale;
                    Text {
                        text: "BATCH";
                        font-size: 14px * root.ui-scale;
                        font-weight: 800;
                        color: Design.text-primary;
                        letter-spacing: 1px * root.ui-scale;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Pilih folder sumber, lalu jalankan master.";
                        font-size: 12px * root.ui-scale;
                        color: Design.text-muted;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        label: "+ Tambah Folder";
                        variant: "secondary";
                        scale: root.ui-scale;
                        clicked => {
                            // AddFolders() MENGGANTI seluruh koleksi
                            // (bukan append). Mockup: toggle dua dataset
                            // contoh; kalau SOURCE kosong, pulihkan A.
                            if (root.src-empty) {
                                root.use-folder-b = false;
                                root.src-name = "27_SDN RANCAIYUH I";
                                root.selected-source = "27_SDN RANCAIYUH I";
                                root.selected-output = "27_SDN RANCAIYUH I";
                                root.src-folders = ["PAS FOTO", "FOTO10RP_FREE SEKOLAH_GRAIS", "SOUVENIR_FREE ID CARD", "SOUVENIR_FREE KARTU PELAJA"];
                                root.kids-0 = ["Ahmad.jpg", "Budi.jpg", "template.psd"];
                                root.kids-1 = ["foto_01.jpg", "foto_02.jpg", "foto_03.jpg"];
                                root.kids-2 = ["id_01.jpg", "id_02.jpg", "template.psd"];
                                root.kids-3 = ["kartu_01.jpg", "kartu_02.jpg", "kartu_03.jpg"];
                                root.expanded-node = "";
                                root.selected-nodes = [];
                                root.ctx-node = "";
                                root.has-manifest = false;
                                root.out-folders = ["", "", "", ""];
                                root.out-kids-0 = ["", "", ""];
                                root.out-kids-1 = ["", "", ""];
                                root.out-kids-2 = ["", "", ""];
                                root.out-kids-3 = ["", "", ""];
                                root.expanded-out = "";
                                root.toast = "Folder SOURCE dipulihkan: 27_SDN RANCAIYUH I";
                            } else if (!root.use-folder-b) {
                                root.use-folder-b = true;
                                root.src-name = "28_SDN BANTAR KAMBING 03";
                                root.selected-source = "28_SDN BANTAR KAMBING 03";
                                root.selected-output = "28_SDN BANTAR KAMBING 03";
                                root.src-folders = ["PAS FOTO", "WISUDA", "ID CARD", "KARTU PELAJAR"];
                                root.kids-0 = ["Dewi.jpg", "Eko.jpg", "template.psd"];
                                root.kids-1 = ["wisuda_01.jpg", "wisuda_02.jpg", "template.psd"];
                                root.kids-2 = ["id_01.jpg", "id_02.jpg", "id_03.jpg"];
                                root.kids-3 = ["kartu_01.jpg", "kartu_02.jpg", "template.psd"];
                                root.expanded-node = "";
                                root.selected-nodes = [];
                                root.ctx-node = "";
                                root.has-manifest = false;
                                root.out-folders = ["", "", "", ""];
                                root.out-kids-0 = ["", "", ""];
                                root.out-kids-1 = ["", "", ""];
                                root.out-kids-2 = ["", "", ""];
                                root.out-kids-3 = ["", "", ""];
                                root.expanded-out = "";
                                root.toast = "SOURCE diganti: 28_SDN BANTAR KAMBING 03";
                            } else {
                                root.use-folder-b = false;
                                root.src-name = "27_SDN RANCAIYUH I";
                                root.selected-source = "27_SDN RANCAIYUH I";
                                root.selected-output = "27_SDN RANCAIYUH I";
                                root.src-folders = ["PAS FOTO", "FOTO10RP_FREE SEKOLAH_GRAIS", "SOUVENIR_FREE ID CARD", "SOUVENIR_FREE KARTU PELAJA"];
                                root.kids-0 = ["Ahmad.jpg", "Budi.jpg", "template.psd"];
                                root.kids-1 = ["foto_01.jpg", "foto_02.jpg", "foto_03.jpg"];
                                root.kids-2 = ["id_01.jpg", "id_02.jpg", "template.psd"];
                                root.kids-3 = ["kartu_01.jpg", "kartu_02.jpg", "kartu_03.jpg"];
                                root.expanded-node = "";
                                root.selected-nodes = [];
                                root.ctx-node = "";
                                root.has-manifest = false;
                                root.out-folders = ["", "", "", ""];
                                root.out-kids-0 = ["", "", ""];
                                root.out-kids-1 = ["", "", ""];
                                root.out-kids-2 = ["", "", ""];
                                root.out-kids-3 = ["", "", ""];
                                root.expanded-out = "";
                                root.toast = "SOURCE diganti: 27_SDN RANCAIYUH I";
                            }
                        }
                    }
                }

                // Dua panel explorer (SOURCE kiri, OUTPUT kanan).
                // Tinggi eksplisit: window − nav (68*scale) − header
                // (36) − baris aksi A (36) − toolbar (56) −
                // 3 celah (36px) − padding (32px). Baris B sudah
                // dihapus (BUAT MASTER pindah ke dalam panel OUTPUT).
                HorizontalLayout {
                    height: root.height - 68px * root.ui-scale - 128px * root.ui-scale - 68px;
                    spacing: Design.space-md;

                    // Panel SOURCE — TREE isi folder sekolah.
                    // Level-1 = subfolder (bernomo, expand via chevron
                    // ▸/▾); anak = file di dalamnya (indent, ikon ▤).
                    // Klik nama = pilih (multi-select) + copy path.
                    // Klik chevron = expand/collapse. ⋯ = context menu.
                    Card {
                        width: (root.content-width - 52px) / 2;
                        VerticalLayout {
                            padding: Design.space-md;
                            spacing: Design.space-sm;

                            HorizontalLayout {
                                height: 24px * root.ui-scale;
                                spacing: 8px * root.ui-scale;
                                Text {
                                    text: "SOURCE";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 800;
                                    color: Design.text-muted;
                                    letter-spacing: 1px * root.ui-scale;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.selected-source;
                                    font-size: 12px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.text-primary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                // Chip "(pending)" — tampil kalau belum
                                // ada output yang cocok (dokumen §3.2).
                                // Hilang setelah BUAT MASTER berhasil.
                                Text {
                                    text: !root.src-empty && root.out-empty ? "(pending)" : "";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.cat-revision;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.selected-nodes.length > 0 ? root.selected-nodes.length + " dipilih" : "";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.accent;
                                    vertical-alignment: center;
                                }
                            }
                            HSeparator { }

                            // Isi panel: tree (bila ada isi) atau drop
                            // zone (bila SOURCE kosong). Dua wadah
                            // menumpuk posisi absolut + visible.
                            Rectangle {
                                vertical-stretch: 1;

                                // --- Tree ---
                                VerticalLayout {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    visible: !root.src-empty;
                                    spacing: 2px;

                                    for f[index] in root.src-folders:
                                        VerticalLayout {
                                            spacing: 0;

                                            // Baris folder (36px tetap — seperti
                                            // tree C# yang padat; tidak ikut
                                            // ui-scale supaya tree muat di panel).
                                            Rectangle {
                                                height: f == "" ? 0px : 36px;
                                                visible: f != "";
                                                background: (root.selected-nodes.length > 0 && root.selected-nodes[0] == f) || (root.selected-nodes.length > 1 && root.selected-nodes[1] == f) || (root.selected-nodes.length > 2 && root.selected-nodes[2] == f) ? Design.accent-subtle : (row-touch.has-hover || chev-touch.has-hover ? Design.bg-hover : transparent);
                                                border-radius: Design.radius-sm;
                                                row-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        // Toggle f di selected-nodes
                                                        // (multi-select, maks 3) + copy path.
                                                        if (root.selected-nodes.length > 0 && root.selected-nodes[0] == f) {
                                                            if (root.selected-nodes.length == 1) { root.selected-nodes = []; }
                                                            else if (root.selected-nodes.length == 2) { root.selected-nodes = [root.selected-nodes[1]]; }
                                                            else { root.selected-nodes = [root.selected-nodes[1], root.selected-nodes[2]]; }
                                                        } else if (root.selected-nodes.length > 1 && root.selected-nodes[1] == f) {
                                                            if (root.selected-nodes.length == 2) { root.selected-nodes = [root.selected-nodes[0]]; }
                                                            else { root.selected-nodes = [root.selected-nodes[0], root.selected-nodes[2]]; }
                                                        } else if (root.selected-nodes.length > 2 && root.selected-nodes[2] == f) {
                                                            root.selected-nodes = [root.selected-nodes[0], root.selected-nodes[1]];
                                                        } else if (root.selected-nodes.length == 0) {
                                                            root.selected-nodes = [f];
                                                        } else if (root.selected-nodes.length == 1) {
                                                            root.selected-nodes = [root.selected-nodes[0], f];
                                                        } else if (root.selected-nodes.length == 2) {
                                                            root.selected-nodes = [root.selected-nodes[0], root.selected-nodes[1], f];
                                                        } else {
                                                            root.toast = "Maksimal 3 folder dipilih.";
                                                        }
                                                        root.selected-master = f;
                                                        root.toast = "Path disalin: " + f;
                                                    }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    spacing: 8px;

                                                    // Chevron expand/collapse.
                                                    Rectangle {
                                                        width: 20px;
                                                        height: 100%;
                                                        chev-touch := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                if (root.expanded-node == f) { root.expanded-node = ""; }
                                                                else { root.expanded-node = f; }
                                                            }
                                                        }
                                                        Text {
                                                            text: root.expanded-node == f ? "▾" : "▸";
                                                            font-size: 12px;
                                                            font-weight: 700;
                                                            color: Design.text-secondary;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                            width: 100%;
                                                            height: 100%;
                                                        }
                                                    }

                                                    // Nama folder bernomor.
                                                    Text {
                                                        text: (index + 1) + ". " + f;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        color: (root.selected-nodes.length > 0 && root.selected-nodes[0] == f) || (root.selected-nodes.length > 1 && root.selected-nodes[1] == f) || (root.selected-nodes.length > 2 && root.selected-nodes[2] == f) ? Design.accent : Design.text-primary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }

                                                    // Tombol ⋯ (context menu).
                                                    IconBtn {
                                                        glyph: "⋯";
                                                        variant: "ghost";
                                                        scale: 1;
                                                        size: 28px;
                                                        clicked => {
                                                            root.ctx-node = f;
                                                            root.ctx-folder-idx = index;
                                                            root.ctx-child-idx = -1;
                                                            root.ctx-is-child = false;
                                                            root.ctx-panel = "SOURCE";
                                                        }
                                                    }
                                                }
                                            }

                                            // Anak 0 (file di dalam folder).
                                            Rectangle {
                                                property <string> cname: index == 0 ? root.kids-0[0] : index == 1 ? root.kids-1[0] : index == 2 ? root.kids-2[0] : root.kids-3[0];
                                                height: (root.expanded-node == f && f != "" && cname != "") ? 26px : 0px;
                                                visible: root.expanded-node == f && f != "" && cname != "";
                                                background: kid0-touch.has-hover ? Design.bg-hover : transparent;
                                                border-radius: Design.radius-sm;
                                                kid0-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.toast = "Path disalin: " + cname; }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 34px;
                                                    padding-right: 10px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: "▤";
                                                        font-size: 12px;
                                                        color: Design.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: cname;
                                                        font-size: 12px;
                                                        color: Design.text-secondary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    IconBtn {
                                                        glyph: "⋯";
                                                        variant: "ghost";
                                                        scale: 1;
                                                        size: 24px;
                                                        clicked => {
                                                            root.ctx-node = cname;
                                                            root.ctx-folder-idx = index;
                                                            root.ctx-child-idx = 0;
                                                            root.ctx-is-child = true;
                                                            root.ctx-panel = "SOURCE";
                                                        }
                                                    }
                                                }
                                            }

                                            // Anak 1.
                                            Rectangle {
                                                property <string> cname: index == 0 ? root.kids-0[1] : index == 1 ? root.kids-1[1] : index == 2 ? root.kids-2[1] : root.kids-3[1];
                                                height: (root.expanded-node == f && f != "" && cname != "") ? 26px : 0px;
                                                visible: root.expanded-node == f && f != "" && cname != "";
                                                background: kid1-touch.has-hover ? Design.bg-hover : transparent;
                                                border-radius: Design.radius-sm;
                                                kid1-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.toast = "Path disalin: " + cname; }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 34px;
                                                    padding-right: 10px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: "▤";
                                                        font-size: 12px;
                                                        color: Design.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: cname;
                                                        font-size: 12px;
                                                        color: Design.text-secondary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    IconBtn {
                                                        glyph: "⋯";
                                                        variant: "ghost";
                                                        scale: 1;
                                                        size: 24px;
                                                        clicked => {
                                                            root.ctx-node = cname;
                                                            root.ctx-folder-idx = index;
                                                            root.ctx-child-idx = 1;
                                                            root.ctx-is-child = true;
                                                            root.ctx-panel = "SOURCE";
                                                        }
                                                    }
                                                }
                                            }

                                            // Anak 2.
                                            Rectangle {
                                                property <string> cname: index == 0 ? root.kids-0[2] : index == 1 ? root.kids-1[2] : index == 2 ? root.kids-2[2] : root.kids-3[2];
                                                height: (root.expanded-node == f && f != "" && cname != "") ? 26px : 0px;
                                                visible: root.expanded-node == f && f != "" && cname != "";
                                                background: kid2-touch.has-hover ? Design.bg-hover : transparent;
                                                border-radius: Design.radius-sm;
                                                kid2-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.toast = "Path disalin: " + cname; }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 34px;
                                                    padding-right: 10px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: "▤";
                                                        font-size: 12px;
                                                        color: Design.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: cname;
                                                        font-size: 12px;
                                                        color: Design.text-secondary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    IconBtn {
                                                        glyph: "⋯";
                                                        variant: "ghost";
                                                        scale: 1;
                                                        size: 24px;
                                                        clicked => {
                                                            root.ctx-node = cname;
                                                            root.ctx-folder-idx = index;
                                                            root.ctx-child-idx = 2;
                                                            root.ctx-is-child = true;
                                                            root.ctx-panel = "SOURCE";
                                                        }
                                                    }
                                                }
                                            }
                                            // Anak 3 (slot ke-4 — hanya terisi
                                            // bila subfolder baru dibuat via
                                            // input inline, K1 REA).
                                            Rectangle {
                                                property <string> cname: (index == 0 ? root.kids-0.length : index == 1 ? root.kids-1.length : index == 2 ? root.kids-2.length : root.kids-3.length) > 3 ? (index == 0 ? root.kids-0[3] : index == 1 ? root.kids-1[3] : index == 2 ? root.kids-2[3] : root.kids-3[3]) : "";
                                                height: (root.expanded-node == f && f != "" && cname != "") ? 26px : 0px;
                                                visible: root.expanded-node == f && f != "" && cname != "";
                                                background: kid3-touch.has-hover ? Design.bg-hover : transparent;
                                                border-radius: Design.radius-sm;
                                                kid3-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.toast = "Path disalin: " + cname; }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 34px;
                                                    padding-right: 10px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: "▤";
                                                        font-size: 12px;
                                                        color: Design.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: cname;
                                                        font-size: 12px;
                                                        color: Design.text-secondary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    IconBtn {
                                                        glyph: "⋯";
                                                        variant: "ghost";
                                                        scale: 1;
                                                        size: 24px;
                                                        clicked => {
                                                            root.ctx-node = cname;
                                                            root.ctx-folder-idx = index;
                                                            root.ctx-child-idx = 3;
                                                            root.ctx-is-child = true;
                                                            root.ctx-panel = "SOURCE";
                                                        }
                                                    }
                                                }
                                            }

                                            // Input inline subfolder baru (K1 REA —
                                            // CancelNewFolderInput di BatchFolderRoot).
                                            // Enter/✓ = buat, × = batal.
                                            Rectangle {
                                                height: (root.newfolder-panel == "SOURCE" && root.newfolder-idx == index) ? 36px : 0px;
                                                visible: root.newfolder-panel == "SOURCE" && root.newfolder-idx == index;
                                                HorizontalLayout {
                                                    padding-left: 34px;
                                                    padding-right: 10px;
                                                    spacing: 6px;
                                                    TextField {
                                                        placeholder: "Nama subfolder baru…";
                                                        text: root.newfolder-name;
                                                        edited(name) => { root.newfolder-name = name; }
                                                        accepted(name) => { root.newfolder-name = name; root.confirm-new-folder(); }
                                                        horizontal-stretch: 1;
                                                    }
                                                    IconBtn {
                                                        glyph: "✓";
                                                        variant: "secondary";
                                                        scale: 1;
                                                        size: 36px;
                                                        clicked => { root.confirm-new-folder(); }
                                                    }
                                                    IconBtn {
                                                        glyph: "×";
                                                        variant: "ghost";
                                                        scale: 1;
                                                        size: 36px;
                                                        clicked => { root.newfolder-panel = ""; root.newfolder-name = ""; root.toast = "Dibatalkan."; }
                                                    }
                                                }
                                            }
                                        }
                                }

                                // Drop zone (tampil kalau SOURCE kosong).
                                Rectangle {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    visible: root.src-empty;
                                    border-color: Design.border-hover;
                                    border-width: 1px;
                                    border-radius: Design.radius-md;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 8px * root.ui-scale;
                                        Text {
                                            text: "+";
                                            font-size: 32px * root.ui-scale;
                                            font-weight: 300;
                                            color: Design.text-muted;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "DRAG FOLDERS HERE";
                                            font-size: 14px * root.ui-scale;
                                            font-weight: 700;
                                            color: Design.text-primary;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "Drop source folders to begin batch processing";
                                            font-size: 12px * root.ui-scale;
                                            color: Design.text-secondary;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }

                                // Context menu (popup di bawah panel).
                                Card {
                                    x: 8px;
                                    y: parent.height - ctx-menu-layout.preferred-height - 8px;
                                    width: 230px;
                                    height: ctx-menu-layout.preferred-height;
                                    visible: root.ctx-node != "" && root.ctx-panel == "SOURCE";
                                    background: Design.surface-elevated;
                                    border-color: Design.border-hover;
                                    border-width: 1px;
                                    border-radius: Design.radius-md;
                                    ctx-menu-layout := VerticalLayout {
                                        padding: Design.space-sm;
                                        spacing: 2px;

                                        Text {
                                            text: "⋯ " + root.ctx-node;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: Design.text-primary;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        HSeparator { }

                                        // New Subfolder… (K1 REA) — buka input
                                        // inline nama folder di bawah induknya
                                        // (bukan dialog); × = batal. Untuk node
                                        // anak, induknya = folder pemiliknya.
                                        Rectangle {
                                            height: 32px;
                                            background: ctx-new.has-hover ? Design.bg-hover : transparent;
                                            border-radius: Design.radius-sm;
                                            ctx-new := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.newfolder-panel = root.ctx-panel;
                                                    root.newfolder-idx = root.ctx-folder-idx;
                                                    root.newfolder-name = "";
                                                    if (root.ctx-is-child) {
                                                        if (root.ctx-panel == "OUTPUT") { root.newfolder-parent = root.out-folders[root.ctx-folder-idx]; root.expanded-out = root.out-folders[root.ctx-folder-idx]; }
                                                        else { root.newfolder-parent = root.src-folders[root.ctx-folder-idx]; root.expanded-node = root.src-folders[root.ctx-folder-idx]; }
                                                    } else {
                                                        root.newfolder-parent = root.ctx-node;
                                                        if (root.ctx-panel == "OUTPUT") { root.expanded-out = root.ctx-node; }
                                                        else { root.expanded-node = root.ctx-node; }
                                                    }
                                                    root.ctx-node = "";
                                                }
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                height: 100%;
                                                padding-left: 10px;
                                                Text {
                                                    text: "New Subfolder…";
                                                    font-size: 12px;
                                                    color: Design.text-primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Replace (Auto) — hanya SOURCE (K1 REA:
                                        // menu OUTPUT tidak punya Replace).
                                        Rectangle {
                                            height: root.ctx-panel == "SOURCE" ? 32px : 0px;
                                            visible: root.ctx-panel == "SOURCE";
                                            background: ctx-rep.has-hover ? Design.bg-hover : transparent;
                                            border-radius: Design.radius-sm;
                                            ctx-rep := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.toast = "Replace (replace.jsx): " + root.ctx-node + " → Photoshop (Smart Object diganti, PSD tetap terbuka)";
                                                    root.ctx-node = "";
                                                }
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                height: 100%;
                                                padding-left: 10px;
                                                Text {
                                                    text: "Replace (Auto)";
                                                    font-size: 12px;
                                                    color: Design.text-primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Copy Path
                                        Rectangle {
                                            height: 32px;
                                            background: ctx-copy.has-hover ? Design.bg-hover : transparent;
                                            border-radius: Design.radius-sm;
                                            ctx-copy := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.toast = "Path disalin: " + root.ctx-node;
                                                    root.ctx-node = "";
                                                }
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                height: 100%;
                                                padding-left: 10px;
                                                Text {
                                                    text: "Copy Path";
                                                    font-size: 12px;
                                                    color: Design.text-primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Copy Output Path (K1 REA — hanya OUTPUT).
                                        Rectangle {
                                            height: root.ctx-panel == "OUTPUT" ? 32px : 0px;
                                            visible: root.ctx-panel == "OUTPUT";
                                            background: ctx-copyout.has-hover ? Design.bg-hover : transparent;
                                            border-radius: Design.radius-sm;
                                            ctx-copyout := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.toast = "Output path disalin: D:\\#GAWENA\\" + root.selected-output + "\\" + (root.ctx-is-child ? (root.ctx-folder-idx == 0 ? root.out-folders[0] : root.ctx-folder-idx == 1 ? root.out-folders[1] : root.ctx-folder-idx == 2 ? root.out-folders[2] : root.out-folders[3]) + "\\" + root.ctx-node : root.ctx-node);
                                                    root.ctx-node = "";
                                                }
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                height: 100%;
                                                padding-left: 10px;
                                                Text {
                                                    text: "Copy Output Path";
                                                    font-size: 12px;
                                                    color: Design.text-primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Delete (hapus dari DISK — dokumen
                                        // §3.6; beda dengan Clear yang hanya
                                        // mengosongkan daftar).
                                        Rectangle {
                                            height: 32px;
                                            background: ctx-del.has-hover ? Design.bg-hover : transparent;
                                            border-radius: Design.radius-sm;
                                            ctx-del := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if (root.ctx-panel == "OUTPUT") {
                                                        // K1 REA — Delete dari OUTPUT.
                                                        if (root.ctx-is-child) {
                                                            // Hapus file dari out-kids[folder] (slot jadi "").
                                                            if (root.ctx-folder-idx == 0) { root.out-kids-0 = [root.ctx-child-idx == 0 ? "" : root.out-kids-0[0], root.ctx-child-idx == 1 ? "" : root.out-kids-0[1], root.ctx-child-idx == 2 ? "" : root.out-kids-0[2], root.ctx-child-idx == 3 ? "" : (root.out-kids-0.length > 3 ? root.out-kids-0[3] : "")]; }
                                                            else if (root.ctx-folder-idx == 1) { root.out-kids-1 = [root.ctx-child-idx == 0 ? "" : root.out-kids-1[0], root.ctx-child-idx == 1 ? "" : root.out-kids-1[1], root.ctx-child-idx == 2 ? "" : root.out-kids-1[2], root.ctx-child-idx == 3 ? "" : (root.out-kids-1.length > 3 ? root.out-kids-1[3] : "")]; }
                                                            else if (root.ctx-folder-idx == 2) { root.out-kids-2 = [root.ctx-child-idx == 0 ? "" : root.out-kids-2[0], root.ctx-child-idx == 1 ? "" : root.out-kids-2[1], root.ctx-child-idx == 2 ? "" : root.out-kids-2[2], root.ctx-child-idx == 3 ? "" : (root.out-kids-2.length > 3 ? root.out-kids-2[3] : "")]; }
                                                            else { root.out-kids-3 = [root.ctx-child-idx == 0 ? "" : root.out-kids-3[0], root.ctx-child-idx == 1 ? "" : root.out-kids-3[1], root.ctx-child-idx == 2 ? "" : root.out-kids-3[2], root.ctx-child-idx == 3 ? "" : (root.out-kids-3.length > 3 ? root.out-kids-3[3] : "")]; }
                                                        } else {
                                                            // Hapus folder OUTPUT: geser out-folders
                                                            // + out-kids ke kiri (seperti SOURCE).
                                                            if (root.ctx-folder-idx == 0) {
                                                                root.out-folders = [root.out-folders[1], root.out-folders[2], root.out-folders[3], ""];
                                                                root.out-kids-0 = root.out-kids-1;
                                                                root.out-kids-1 = root.out-kids-2;
                                                                root.out-kids-2 = root.out-kids-3;
                                                                root.out-kids-3 = ["", "", ""];
                                                            } else if (root.ctx-folder-idx == 1) {
                                                                root.out-folders = [root.out-folders[0], root.out-folders[2], root.out-folders[3], ""];
                                                                root.out-kids-1 = root.out-kids-2;
                                                                root.out-kids-2 = root.out-kids-3;
                                                                root.out-kids-3 = ["", "", ""];
                                                            } else if (root.ctx-folder-idx == 2) {
                                                                root.out-folders = [root.out-folders[0], root.out-folders[1], root.out-folders[3], ""];
                                                                root.out-kids-2 = root.out-kids-3;
                                                                root.out-kids-3 = ["", "", ""];
                                                            } else {
                                                                root.out-folders = [root.out-folders[0], root.out-folders[1], root.out-folders[2], ""];
                                                                root.out-kids-3 = ["", "", ""];
                                                            }
                                                            if (root.expanded-out == root.ctx-node) { root.expanded-out = ""; }
                                                        }
                                                    } else if (root.ctx-is-child) {
                                                        // Hapus file dari kids[folder] (slot jadi "").
                                                        if (root.ctx-folder-idx == 0) { root.kids-0 = [root.ctx-child-idx == 0 ? "" : root.kids-0[0], root.ctx-child-idx == 1 ? "" : root.kids-0[1], root.ctx-child-idx == 2 ? "" : root.kids-0[2], root.ctx-child-idx == 3 ? "" : (root.kids-0.length > 3 ? root.kids-0[3] : "")]; }
                                                        else if (root.ctx-folder-idx == 1) { root.kids-1 = [root.ctx-child-idx == 0 ? "" : root.kids-1[0], root.ctx-child-idx == 1 ? "" : root.kids-1[1], root.ctx-child-idx == 2 ? "" : root.kids-1[2], root.ctx-child-idx == 3 ? "" : (root.kids-1.length > 3 ? root.kids-1[3] : "")]; }
                                                        else if (root.ctx-folder-idx == 2) { root.kids-2 = [root.ctx-child-idx == 0 ? "" : root.kids-2[0], root.ctx-child-idx == 1 ? "" : root.kids-2[1], root.ctx-child-idx == 2 ? "" : root.kids-2[2], root.ctx-child-idx == 3 ? "" : (root.kids-2.length > 3 ? root.kids-2[3] : "")]; }
                                                        else { root.kids-3 = [root.ctx-child-idx == 0 ? "" : root.kids-3[0], root.ctx-child-idx == 1 ? "" : root.kids-3[1], root.ctx-child-idx == 2 ? "" : root.kids-3[2], root.ctx-child-idx == 3 ? "" : (root.kids-3.length > 3 ? root.kids-3[3] : "")]; }
                                                    } else {
                                                        // Hapus folder: geser src-folders + kids
                                                        // ke kiri supaya penomoran tetap benar.
                                                        if (root.ctx-folder-idx == 0) {
                                                            root.src-folders = [root.src-folders[1], root.src-folders[2], root.src-folders[3], ""];
                                                            root.kids-0 = root.kids-1;
                                                            root.kids-1 = root.kids-2;
                                                            root.kids-2 = root.kids-3;
                                                            root.kids-3 = ["", "", ""];
                                                        } else if (root.ctx-folder-idx == 1) {
                                                            root.src-folders = [root.src-folders[0], root.src-folders[2], root.src-folders[3], ""];
                                                            root.kids-1 = root.kids-2;
                                                            root.kids-2 = root.kids-3;
                                                            root.kids-3 = ["", "", ""];
                                                        } else if (root.ctx-folder-idx == 2) {
                                                            root.src-folders = [root.src-folders[0], root.src-folders[1], root.src-folders[3], ""];
                                                            root.kids-2 = root.kids-3;
                                                            root.kids-3 = ["", "", ""];
                                                        } else {
                                                            root.src-folders = [root.src-folders[0], root.src-folders[1], root.src-folders[2], ""];
                                                            root.kids-3 = ["", "", ""];
                                                        }
                                                        if (root.expanded-node == root.ctx-node) { root.expanded-node = ""; }
                                                        // Hapus dari selected-nodes bila ada.
                                                        if (root.selected-nodes.length == 1 && root.selected-nodes[0] == root.ctx-node) {
                                                            root.selected-nodes = [];
                                                        } else if (root.selected-nodes.length == 2) {
                                                            if (root.selected-nodes[0] == root.ctx-node) { root.selected-nodes = [root.selected-nodes[1]]; }
                                                            else if (root.selected-nodes[1] == root.ctx-node) { root.selected-nodes = [root.selected-nodes[0]]; }
                                                        } else if (root.selected-nodes.length == 3) {
                                                            if (root.selected-nodes[0] == root.ctx-node) { root.selected-nodes = [root.selected-nodes[1], root.selected-nodes[2]]; }
                                                            else if (root.selected-nodes[1] == root.ctx-node) { root.selected-nodes = [root.selected-nodes[0], root.selected-nodes[2]]; }
                                                            else if (root.selected-nodes[2] == root.ctx-node) { root.selected-nodes = [root.selected-nodes[0], root.selected-nodes[1]]; }
                                                        }
                                                    }
                                                    root.toast = "Dihapus dari disk: " + root.ctx-node;
                                                    root.ctx-node = "";
                                                }
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                height: 100%;
                                                padding-left: 10px;
                                                Text {
                                                    text: "Delete";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: Design.status-danger;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Panel OUTPUT: kosong ("Output akan muncul di
                    // sini.") sampai BUAT MASTER berhasil — lalu tampil
                    // baris hasil. Klik area = pilih folder output.
                    Card {
                        width: (root.content-width - 52px) / 2;
                        VerticalLayout {
                            padding: Design.space-md;
                            spacing: Design.space-sm;

                            HorizontalLayout {
                                height: 24px * root.ui-scale;
                                spacing: 8px * root.ui-scale;
                                Text {
                                    text: "OUTPUT";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 800;
                                    color: Design.text-muted;
                                    letter-spacing: 1px * root.ui-scale;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.selected-output;
                                    font-size: 12px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.text-primary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                // Chip "(pending)" — tampil kalau folder
                                // output belum ada di disk (dokumen §3.3).
                                // Hilang setelah BUAT MASTER berhasil.
                                Text {
                                    text: root.out-empty ? "(pending)" : "";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.cat-revision;
                                    vertical-alignment: center;
                                }
                            }
                            HSeparator { }

                            Rectangle {
                                vertical-stretch: 1;
                                out-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.selected-output = root.src-name;
                                        root.toast = "Folder output dipilih: " + root.src-name;
                                    }
                                }
                                // Teks kosong (tengah).
                                Text {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    visible: root.out-empty;
                                    text: "Output akan muncul di sini.";
                                    font-size: 12px * root.ui-scale;
                                    color: Design.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                // Tree OUTPUT — tree SENDIRI dari folder
                                // output di disk (dokumen §3.3), BUKAN
                                // cermin live SOURCE. Datanya terpisah
                                // (out-folders / out-kids), diisi saat
                                // BUAT MASTER berhasil, dan ter-refresh
                                // otomatis. Expand pakai state sendiri
                                // (expanded-out) supaya tidak terikat
                                // ke SOURCE. Tampil setelah output ada.
                                VerticalLayout {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    visible: !root.out-empty;
                                    spacing: 2px;
                                    for f[index] in root.out-folders:
                                        VerticalLayout {
                                            spacing: 0;

                                            // Baris folder (cermin SOURCE).
                                            Rectangle {
                                                height: f == "" ? 0px : 36px;
                                                visible: f != "";
                                                background: out-chev-touch.has-hover ? Design.bg-hover : transparent;
                                                border-radius: Design.radius-sm;
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    spacing: 8px;

                                                    // Chevron expand/collapse (state sendiri).
                                                    Rectangle {
                                                        width: 20px;
                                                        height: 100%;
                                                        out-chev-touch := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                if (root.expanded-out == f) { root.expanded-out = ""; }
                                                                else { root.expanded-out = f; }
                                                            }
                                                        }
                                                        Text {
                                                            text: root.expanded-out == f ? "▾" : "▸";
                                                            font-size: 12px;
                                                            font-weight: 700;
                                                            color: Design.text-secondary;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                            width: 100%;
                                                            height: 100%;
                                                        }
                                                    }

                                                    // Nama folder bernomor (sama seperti SOURCE).
                                                    Text {
                                                        text: (index + 1) + ". " + f;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        color: Design.text-primary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    // Tombol ⋯ (context menu OUTPUT, K1 REA).
                                                    IconBtn {
                                                        glyph: "⋯";
                                                        variant: "ghost";
                                                        scale: 1;
                                                        size: 28px;
                                                        clicked => {
                                                            root.ctx-node = f;
                                                            root.ctx-folder-idx = index;
                                                            root.ctx-child-idx = -1;
                                                            root.ctx-is-child = false;
                                                            root.ctx-panel = "OUTPUT";
                                                        }
                                                    }
                                                }
                                            }

                                            // Anak 0 (file di dalam folder).
                                            Rectangle {
                                                property <string> cname: index == 0 ? root.out-kids-0[0] : index == 1 ? root.out-kids-1[0] : index == 2 ? root.out-kids-2[0] : root.out-kids-3[0];
                                                height: (root.expanded-out == f && f != "" && cname != "") ? 26px : 0px;
                                                visible: root.expanded-out == f && f != "" && cname != "";
                                                background: out-kid0-touch.has-hover ? Design.bg-hover : transparent;
                                                border-radius: Design.radius-sm;
                                                out-kid0-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.toast = "Path disalin: " + cname; }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 34px;
                                                    padding-right: 10px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: "▤";
                                                        font-size: 12px;
                                                        color: Design.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: cname;
                                                        font-size: 12px;
                                                        color: Design.text-secondary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    IconBtn {
                                                        glyph: "⋯";
                                                        variant: "ghost";
                                                        scale: 1;
                                                        size: 24px;
                                                        clicked => {
                                                            root.ctx-node = cname;
                                                            root.ctx-folder-idx = index;
                                                            root.ctx-child-idx = 0;
                                                            root.ctx-is-child = true;
                                                            root.ctx-panel = "OUTPUT";
                                                        }
                                                    }
                                                }
                                            }

                                            // Anak 1.
                                            Rectangle {
                                                property <string> cname: index == 0 ? root.out-kids-0[1] : index == 1 ? root.out-kids-1[1] : index == 2 ? root.out-kids-2[1] : root.out-kids-3[1];
                                                height: (root.expanded-out == f && f != "" && cname != "") ? 26px : 0px;
                                                visible: root.expanded-out == f && f != "" && cname != "";
                                                background: out-kid1-touch.has-hover ? Design.bg-hover : transparent;
                                                border-radius: Design.radius-sm;
                                                out-kid1-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.toast = "Path disalin: " + cname; }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 34px;
                                                    padding-right: 10px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: "▤";
                                                        font-size: 12px;
                                                        color: Design.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: cname;
                                                        font-size: 12px;
                                                        color: Design.text-secondary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    IconBtn {
                                                        glyph: "⋯";
                                                        variant: "ghost";
                                                        scale: 1;
                                                        size: 24px;
                                                        clicked => {
                                                            root.ctx-node = cname;
                                                            root.ctx-folder-idx = index;
                                                            root.ctx-child-idx = 1;
                                                            root.ctx-is-child = true;
                                                            root.ctx-panel = "OUTPUT";
                                                        }
                                                    }
                                                }
                                            }

                                            // Anak 2.
                                            Rectangle {
                                                property <string> cname: index == 0 ? root.out-kids-0[2] : index == 1 ? root.out-kids-1[2] : index == 2 ? root.out-kids-2[2] : root.out-kids-3[2];
                                                height: (root.expanded-out == f && f != "" && cname != "") ? 26px : 0px;
                                                visible: root.expanded-out == f && f != "" && cname != "";
                                                background: out-kid2-touch.has-hover ? Design.bg-hover : transparent;
                                                border-radius: Design.radius-sm;
                                                out-kid2-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.toast = "Path disalin: " + cname; }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 34px;
                                                    padding-right: 10px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: "▤";
                                                        font-size: 12px;
                                                        color: Design.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: cname;
                                                        font-size: 12px;
                                                        color: Design.text-secondary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    IconBtn {
                                                        glyph: "⋯";
                                                        variant: "ghost";
                                                        scale: 1;
                                                        size: 24px;
                                                        clicked => {
                                                            root.ctx-node = cname;
                                                            root.ctx-folder-idx = index;
                                                            root.ctx-child-idx = 2;
                                                            root.ctx-is-child = true;
                                                            root.ctx-panel = "OUTPUT";
                                                        }
                                                    }
                                                }
                                            }
                                            // Anak 3 (slot ke-4 — hanya terisi
                                            // bila subfolder baru dibuat via
                                            // input inline, K1 REA).
                                            Rectangle {
                                                property <string> cname: (index == 0 ? root.out-kids-0.length : index == 1 ? root.out-kids-1.length : index == 2 ? root.out-kids-2.length : root.out-kids-3.length) > 3 ? (index == 0 ? root.out-kids-0[3] : index == 1 ? root.out-kids-1[3] : index == 2 ? root.out-kids-2[3] : root.out-kids-3[3]) : "";
                                                height: (root.expanded-out == f && f != "" && cname != "") ? 26px : 0px;
                                                visible: root.expanded-out == f && f != "" && cname != "";
                                                background: out-kid3-touch.has-hover ? Design.bg-hover : transparent;
                                                border-radius: Design.radius-sm;
                                                out-kid3-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.toast = "Path disalin: " + cname; }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 34px;
                                                    padding-right: 10px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: "▤";
                                                        font-size: 12px;
                                                        color: Design.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: cname;
                                                        font-size: 12px;
                                                        color: Design.text-secondary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    IconBtn {
                                                        glyph: "⋯";
                                                        variant: "ghost";
                                                        scale: 1;
                                                        size: 24px;
                                                        clicked => {
                                                            root.ctx-node = cname;
                                                            root.ctx-folder-idx = index;
                                                            root.ctx-child-idx = 3;
                                                            root.ctx-is-child = true;
                                                            root.ctx-panel = "OUTPUT";
                                                        }
                                                    }
                                                }
                                            }

                                            // Input inline subfolder baru (K1 REA —
                                            // CancelOutputNewFolderInput).
                                            // Enter/✓ = buat, × = batal.
                                            Rectangle {
                                                height: (root.newfolder-panel == "OUTPUT" && root.newfolder-idx == index) ? 36px : 0px;
                                                visible: root.newfolder-panel == "OUTPUT" && root.newfolder-idx == index;
                                                HorizontalLayout {
                                                    padding-left: 34px;
                                                    padding-right: 10px;
                                                    spacing: 6px;
                                                    TextField {
                                                        placeholder: "Nama subfolder baru…";
                                                        text: root.newfolder-name;
                                                        edited(name) => { root.newfolder-name = name; }
                                                        accepted(name) => { root.newfolder-name = name; root.confirm-new-folder(); }
                                                        horizontal-stretch: 1;
                                                    }
                                                    IconBtn {
                                                        glyph: "✓";
                                                        variant: "secondary";
                                                        scale: 1;
                                                        size: 36px;
                                                        clicked => { root.confirm-new-folder(); }
                                                    }
                                                    IconBtn {
                                                        glyph: "×";
                                                        variant: "ghost";
                                                        scale: 1;
                                                        size: 36px;
                                                        clicked => { root.newfolder-panel = ""; root.newfolder-name = ""; root.toast = "Dibatalkan."; }
                                                    }
                                                }
                                            }
                                        }
                                }
// Context menu OUTPUT (popup di bawah panel — K1 REA, salinan menu SOURCE).
                                Card {
                                    x: 8px;
                                    y: parent.height - ctx-menu-layout-o.preferred-height - 8px;
                                    width: 230px;
                                    height: ctx-menu-layout-o.preferred-height;
                                    visible: root.ctx-node != "" && root.ctx-panel == "OUTPUT";
                                    background: Design.surface-elevated;
                                    border-color: Design.border-hover;
                                    border-width: 1px;
                                    border-radius: Design.radius-md;
                                    ctx-menu-layout-o := VerticalLayout {
                                        padding: Design.space-sm;
                                        spacing: 2px;

                                        Text {
                                            text: "⋯ " + root.ctx-node;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: Design.text-primary;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        HSeparator { }

                                        // New Subfolder… (K1 REA) — buka input
                                        // inline nama folder di bawah induknya
                                        // (bukan dialog); × = batal. Untuk node
                                        // anak, induknya = folder pemiliknya.
                                        Rectangle {
                                            height: 32px;
                                            background: ctx-new-o.has-hover ? Design.bg-hover : transparent;
                                            border-radius: Design.radius-sm;
                                            ctx-new-o := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.newfolder-panel = root.ctx-panel;
                                                    root.newfolder-idx = root.ctx-folder-idx;
                                                    root.newfolder-name = "";
                                                    if (root.ctx-is-child) {
                                                        if (root.ctx-panel == "OUTPUT") { root.newfolder-parent = root.out-folders[root.ctx-folder-idx]; root.expanded-out = root.out-folders[root.ctx-folder-idx]; }
                                                        else { root.newfolder-parent = root.src-folders[root.ctx-folder-idx]; root.expanded-node = root.src-folders[root.ctx-folder-idx]; }
                                                    } else {
                                                        root.newfolder-parent = root.ctx-node;
                                                        if (root.ctx-panel == "OUTPUT") { root.expanded-out = root.ctx-node; }
                                                        else { root.expanded-node = root.ctx-node; }
                                                    }
                                                    root.ctx-node = "";
                                                }
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                height: 100%;
                                                padding-left: 10px;
                                                Text {
                                                    text: "New Subfolder…";
                                                    font-size: 12px;
                                                    color: Design.text-primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Replace (Auto) — hanya SOURCE (K1 REA:
                                        // menu OUTPUT tidak punya Replace).
                                        Rectangle {
                                            height: root.ctx-panel == "SOURCE" ? 32px : 0px;
                                            visible: root.ctx-panel == "SOURCE";
                                            background: ctx-rep-o.has-hover ? Design.bg-hover : transparent;
                                            border-radius: Design.radius-sm;
                                            ctx-rep-o := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.toast = "Replace (replace.jsx): " + root.ctx-node + " → Photoshop (Smart Object diganti, PSD tetap terbuka)";
                                                    root.ctx-node = "";
                                                }
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                height: 100%;
                                                padding-left: 10px;
                                                Text {
                                                    text: "Replace (Auto)";
                                                    font-size: 12px;
                                                    color: Design.text-primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Copy Path
                                        Rectangle {
                                            height: 32px;
                                            background: ctx-copy-o.has-hover ? Design.bg-hover : transparent;
                                            border-radius: Design.radius-sm;
                                            ctx-copy-o := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.toast = "Path disalin: " + root.ctx-node;
                                                    root.ctx-node = "";
                                                }
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                height: 100%;
                                                padding-left: 10px;
                                                Text {
                                                    text: "Copy Path";
                                                    font-size: 12px;
                                                    color: Design.text-primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Copy Output Path (K1 REA — hanya OUTPUT).
                                        Rectangle {
                                            height: root.ctx-panel == "OUTPUT" ? 32px : 0px;
                                            visible: root.ctx-panel == "OUTPUT";
                                            background: ctx-copyout-o.has-hover ? Design.bg-hover : transparent;
                                            border-radius: Design.radius-sm;
                                            ctx-copyout-o := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.toast = "Output path disalin: D:\\#GAWENA\\" + root.selected-output + "\\" + (root.ctx-is-child ? (root.ctx-folder-idx == 0 ? root.out-folders[0] : root.ctx-folder-idx == 1 ? root.out-folders[1] : root.ctx-folder-idx == 2 ? root.out-folders[2] : root.out-folders[3]) + "\\" + root.ctx-node : root.ctx-node);
                                                    root.ctx-node = "";
                                                }
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                height: 100%;
                                                padding-left: 10px;
                                                Text {
                                                    text: "Copy Output Path";
                                                    font-size: 12px;
                                                    color: Design.text-primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Delete (hapus dari DISK — dokumen
                                        // §3.6; beda dengan Clear yang hanya
                                        // mengosongkan daftar).
                                        Rectangle {
                                            height: 32px;
                                            background: ctx-del-o.has-hover ? Design.bg-hover : transparent;
                                            border-radius: Design.radius-sm;
                                            ctx-del-o := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if (root.ctx-panel == "OUTPUT") {
                                                        // K1 REA — Delete dari OUTPUT.
                                                        if (root.ctx-is-child) {
                                                            // Hapus file dari out-kids[folder] (slot jadi "").
                                                            if (root.ctx-folder-idx == 0) { root.out-kids-0 = [root.ctx-child-idx == 0 ? "" : root.out-kids-0[0], root.ctx-child-idx == 1 ? "" : root.out-kids-0[1], root.ctx-child-idx == 2 ? "" : root.out-kids-0[2], root.ctx-child-idx == 3 ? "" : (root.out-kids-0.length > 3 ? root.out-kids-0[3] : "")]; }
                                                            else if (root.ctx-folder-idx == 1) { root.out-kids-1 = [root.ctx-child-idx == 0 ? "" : root.out-kids-1[0], root.ctx-child-idx == 1 ? "" : root.out-kids-1[1], root.ctx-child-idx == 2 ? "" : root.out-kids-1[2], root.ctx-child-idx == 3 ? "" : (root.out-kids-1.length > 3 ? root.out-kids-1[3] : "")]; }
                                                            else if (root.ctx-folder-idx == 2) { root.out-kids-2 = [root.ctx-child-idx == 0 ? "" : root.out-kids-2[0], root.ctx-child-idx == 1 ? "" : root.out-kids-2[1], root.ctx-child-idx == 2 ? "" : root.out-kids-2[2], root.ctx-child-idx == 3 ? "" : (root.out-kids-2.length > 3 ? root.out-kids-2[3] : "")]; }
                                                            else { root.out-kids-3 = [root.ctx-child-idx == 0 ? "" : root.out-kids-3[0], root.ctx-child-idx == 1 ? "" : root.out-kids-3[1], root.ctx-child-idx == 2 ? "" : root.out-kids-3[2], root.ctx-child-idx == 3 ? "" : (root.out-kids-3.length > 3 ? root.out-kids-3[3] : "")]; }
                                                        } else {
                                                            // Hapus folder OUTPUT: geser out-folders
                                                            // + out-kids ke kiri (seperti SOURCE).
                                                            if (root.ctx-folder-idx == 0) {
                                                                root.out-folders = [root.out-folders[1], root.out-folders[2], root.out-folders[3], ""];
                                                                root.out-kids-0 = root.out-kids-1;
                                                                root.out-kids-1 = root.out-kids-2;
                                                                root.out-kids-2 = root.out-kids-3;
                                                                root.out-kids-3 = ["", "", ""];
                                                            } else if (root.ctx-folder-idx == 1) {
                                                                root.out-folders = [root.out-folders[0], root.out-folders[2], root.out-folders[3], ""];
                                                                root.out-kids-1 = root.out-kids-2;
                                                                root.out-kids-2 = root.out-kids-3;
                                                                root.out-kids-3 = ["", "", ""];
                                                            } else if (root.ctx-folder-idx == 2) {
                                                                root.out-folders = [root.out-folders[0], root.out-folders[1], root.out-folders[3], ""];
                                                                root.out-kids-2 = root.out-kids-3;
                                                                root.out-kids-3 = ["", "", ""];
                                                            } else {
                                                                root.out-folders = [root.out-folders[0], root.out-folders[1], root.out-folders[2], ""];
                                                                root.out-kids-3 = ["", "", ""];
                                                            }
                                                            if (root.expanded-out == root.ctx-node) { root.expanded-out = ""; }
                                                        }
                                                    } else if (root.ctx-is-child) {
                                                        // Hapus file dari kids[folder] (slot jadi "").
                                                        if (root.ctx-folder-idx == 0) { root.kids-0 = [root.ctx-child-idx == 0 ? "" : root.kids-0[0], root.ctx-child-idx == 1 ? "" : root.kids-0[1], root.ctx-child-idx == 2 ? "" : root.kids-0[2], root.ctx-child-idx == 3 ? "" : (root.kids-0.length > 3 ? root.kids-0[3] : "")]; }
                                                        else if (root.ctx-folder-idx == 1) { root.kids-1 = [root.ctx-child-idx == 0 ? "" : root.kids-1[0], root.ctx-child-idx == 1 ? "" : root.kids-1[1], root.ctx-child-idx == 2 ? "" : root.kids-1[2], root.ctx-child-idx == 3 ? "" : (root.kids-1.length > 3 ? root.kids-1[3] : "")]; }
                                                        else if (root.ctx-folder-idx == 2) { root.kids-2 = [root.ctx-child-idx == 0 ? "" : root.kids-2[0], root.ctx-child-idx == 1 ? "" : root.kids-2[1], root.ctx-child-idx == 2 ? "" : root.kids-2[2], root.ctx-child-idx == 3 ? "" : (root.kids-2.length > 3 ? root.kids-2[3] : "")]; }
                                                        else { root.kids-3 = [root.ctx-child-idx == 0 ? "" : root.kids-3[0], root.ctx-child-idx == 1 ? "" : root.kids-3[1], root.ctx-child-idx == 2 ? "" : root.kids-3[2], root.ctx-child-idx == 3 ? "" : (root.kids-3.length > 3 ? root.kids-3[3] : "")]; }
                                                    } else {
                                                        // Hapus folder: geser src-folders + kids
                                                        // ke kiri supaya penomoran tetap benar.
                                                        if (root.ctx-folder-idx == 0) {
                                                            root.src-folders = [root.src-folders[1], root.src-folders[2], root.src-folders[3], ""];
                                                            root.kids-0 = root.kids-1;
                                                            root.kids-1 = root.kids-2;
                                                            root.kids-2 = root.kids-3;
                                                            root.kids-3 = ["", "", ""];
                                                        } else if (root.ctx-folder-idx == 1) {
                                                            root.src-folders = [root.src-folders[0], root.src-folders[2], root.src-folders[3], ""];
                                                            root.kids-1 = root.kids-2;
                                                            root.kids-2 = root.kids-3;
                                                            root.kids-3 = ["", "", ""];
                                                        } else if (root.ctx-folder-idx == 2) {
                                                            root.src-folders = [root.src-folders[0], root.src-folders[1], root.src-folders[3], ""];
                                                            root.kids-2 = root.kids-3;
                                                            root.kids-3 = ["", "", ""];
                                                        } else {
                                                            root.src-folders = [root.src-folders[0], root.src-folders[1], root.src-folders[2], ""];
                                                            root.kids-3 = ["", "", ""];
                                                        }
                                                        if (root.expanded-node == root.ctx-node) { root.expanded-node = ""; }
                                                        // Hapus dari selected-nodes bila ada.
                                                        if (root.selected-nodes.length == 1 && root.selected-nodes[0] == root.ctx-node) {
                                                            root.selected-nodes = [];
                                                        } else if (root.selected-nodes.length == 2) {
                                                            if (root.selected-nodes[0] == root.ctx-node) { root.selected-nodes = [root.selected-nodes[1]]; }
                                                            else if (root.selected-nodes[1] == root.ctx-node) { root.selected-nodes = [root.selected-nodes[0]]; }
                                                        } else if (root.selected-nodes.length == 3) {
                                                            if (root.selected-nodes[0] == root.ctx-node) { root.selected-nodes = [root.selected-nodes[1], root.selected-nodes[2]]; }
                                                            else if (root.selected-nodes[1] == root.ctx-node) { root.selected-nodes = [root.selected-nodes[0], root.selected-nodes[2]]; }
                                                            else if (root.selected-nodes[2] == root.ctx-node) { root.selected-nodes = [root.selected-nodes[0], root.selected-nodes[1]]; }
                                                        }
                                                    }
                                                    root.toast = "Dihapus dari disk: " + root.ctx-node;
                                                    root.ctx-node = "";
                                                }
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                height: 100%;
                                                padding-left: 10px;
                                                Text {
                                                    text: "Delete";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: Design.status-danger;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            // Baris aksi OUTPUT: BUAT MASTER (fase 2) +
                            // tombol dokumen (▤, placeholder — Master
                            // File Browser DITUNDA, bertahap, lokasinya
                            // di side panel / log panel navigasi button).
                            // Di DALAM panel OUTPUT (dokumen §3.5/§9) —
                            // bukan di bawah panel seperti v2.
                            HorizontalLayout {
                                height: 36px * root.ui-scale;
                                spacing: 8px * root.ui-scale;
                                Rectangle { horizontal-stretch: 1; }
                                Btn {
                                    label: "⧉ BUAT MASTER";
                                    variant: "secondary";
                                    scale: root.ui-scale;
                                    clicked => {
                                        if (!root.has-manifest) {
                                            root.toast = "Manifest belum ada — jalankan Fase 1 (buat_master.py) dulu.";
                                        } else {
                                            root.out-folders = root.src-folders;
                                            root.out-kids-0 = root.kids-0;
                                            root.out-kids-1 = root.kids-1;
                                            root.out-kids-2 = root.kids-2;
                                            root.out-kids-3 = root.kids-3;
                                            root.expanded-out = root.out-folders[0];
                                            root.toast = "Menjalankan buat_master_duplikat.py… (menggandakan template ke semua tujuan)";
                                        }
                                    }
                                }
                                IconBtn {
                                    glyph: "▤";
                                    variant: "secondary";
                                    scale: root.ui-scale;
                                    size: 36px;
                                    clicked => { root.toast = "Master File Browser akan hadir di side panel (bertahap)."; }
                                }
                            }
                        }
                    }
                }

                // Baris A: indikator manifest + Fase 1 + Replace.
                // Manifest: dot hijau = ada (Fase 1 sudah jalan),
                // merah = belum ada (BUAT MASTER akan error).
                HorizontalLayout {
                    height: 36px * root.ui-scale;
                    spacing: 8px * root.ui-scale;
                    IconBtn {
                        glyph: "⧉";
                        variant: "secondary";
                        scale: root.ui-scale;
                        size: 36px;
                        clicked => { root.toast = "Menyalin master: " + root.selected-master; }
                    }
                    HorizontalLayout {
                        spacing: 6px * root.ui-scale;
                        Text {
                            text: "●";
                            font-size: 10px * root.ui-scale;
                            color: root.has-manifest ? Design.status-success : Design.status-danger;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.has-manifest ? "Manifest: ada" : "Manifest: belum ada";
                            font-size: 12px * root.ui-scale;
                            color: Design.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        label: "▶ Fase 1";
                        variant: "ghost";
                        scale: root.ui-scale;
                        clicked => {
                            root.has-manifest = true;
                            root.toast = "Fase 1 selesai — manifest dibuat, template dibuka di Photoshop (edit + SAVE)";
                        }
                    }
                    Btn {
                        label: "Replace";
                        variant: "secondary";
                        scale: root.ui-scale;
                        clicked => {
                            if (root.selected-nodes.length == 0) {
                                root.toast = "Pilih folder dulu (klik nama folder).";
                            } else if (root.selected-nodes.length == 1) {
                                root.toast = "Replace (replace.jsx): " + root.selected-nodes[0] + " → Photoshop (Smart Object diganti, PSD tetap terbuka)";
                            } else {
                                root.toast = "Multiple Replace: " + root.selected-nodes.length + " folder dipasangkan & dikirim sekaligus ke Photoshop";
                            }
                        }
                    }
                }

                // (Baris B lama — BUAT MASTER di bawah panel — SUDAH
                // DIPINDAH ke dalam panel OUTPUT, sesuai dokumen §3.5/§9.)

                // Footer (dokumen §3.5): TOMBOL SCRIPT MASTER BERNAMA
                // — satu tombol per file .py di Scripts/Master/
                // (nama/urutan dari scripts.json; file "_" dan
                // enabled:false tidak tampil). Klik = ExecuteMaster:
                // proses SEMUA folder SOURCE, OUTPUT terisi, log
                // "[SUCCESS] Batch Selesai.". Kanan: refresh (re-scan
                // SOURCE & OUTPUT) + clear merah (kosongkan daftar).
                // Tombol kecil (small) supaya 5 tombol muat di 520px.
                Card {
                    height: 56px * root.ui-scale;
                    HorizontalLayout {
                        x: 0;
                        y: 10px * root.ui-scale;
                        width: 100%;
                        height: 36px * root.ui-scale;
                        padding-left: Design.space-sm * root.ui-scale;
                        padding-right: Design.space-sm * root.ui-scale;
                        spacing: 6px * root.ui-scale;
                        Btn {
                            label: "buat_master";
                            variant: "secondary";
                            scale: root.ui-scale;
                            small: true;
                            clicked => {
                                root.out-folders = root.src-folders;
                                root.out-kids-0 = root.kids-0;
                                root.out-kids-1 = root.kids-1;
                                root.out-kids-2 = root.kids-2;
                                root.out-kids-3 = root.kids-3;
                                root.expanded-out = root.out-folders[0];
                                root.toast = "buat_master.py — SEMUA folder SOURCE… [SUCCESS] Batch Selesai.";
                            }
                        }
                        Btn {
                            label: "manasik";
                            variant: "secondary";
                            scale: root.ui-scale;
                            small: true;
                            clicked => {
                                root.out-folders = root.src-folders;
                                root.out-kids-0 = root.kids-0;
                                root.out-kids-1 = root.kids-1;
                                root.out-kids-2 = root.kids-2;
                                root.out-kids-3 = root.kids-3;
                                root.expanded-out = root.out-folders[0];
                                root.toast = "manasik.py — SEMUA folder SOURCE… [SUCCESS] Batch Selesai.";
                            }
                        }
                        Btn {
                            label: "wisuda";
                            variant: "secondary";
                            scale: root.ui-scale;
                            small: true;
                            clicked => {
                                root.out-folders = root.src-folders;
                                root.out-kids-0 = root.kids-0;
                                root.out-kids-1 = root.kids-1;
                                root.out-kids-2 = root.kids-2;
                                root.out-kids-3 = root.kids-3;
                                root.expanded-out = root.out-folders[0];
                                root.toast = "wisuda.py — SEMUA folder SOURCE… [SUCCESS] Batch Selesai.";
                            }
                        }
                        Btn {
                            label: "pasfoto";
                            variant: "secondary";
                            scale: root.ui-scale;
                            small: true;
                            clicked => {
                                root.out-folders = root.src-folders;
                                root.out-kids-0 = root.kids-0;
                                root.out-kids-1 = root.kids-1;
                                root.out-kids-2 = root.kids-2;
                                root.out-kids-3 = root.kids-3;
                                root.expanded-out = root.out-folders[0];
                                root.toast = "pasfoto.py — SEMUA folder SOURCE… [SUCCESS] Batch Selesai.";
                            }
                        }
                        Btn {
                            label: "profesi";
                            variant: "secondary";
                            scale: root.ui-scale;
                            small: true;
                            clicked => {
                                root.out-folders = root.src-folders;
                                root.out-kids-0 = root.kids-0;
                                root.out-kids-1 = root.kids-1;
                                root.out-kids-2 = root.kids-2;
                                root.out-kids-3 = root.kids-3;
                                root.expanded-out = root.out-folders[0];
                                root.toast = "profesi.py — SEMUA folder SOURCE… [SUCCESS] Batch Selesai.";
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        IconBtn {
                            glyph: "↻";
                            variant: "ghost";
                            scale: root.ui-scale;
                            size: 36px;
                            clicked => { root.toast = "Memuat ulang SOURCE & OUTPUT…"; }
                        }
                        IconBtn {
                            glyph: "×";
                            variant: "danger";
                            scale: root.ui-scale;
                            size: 36px;
                            clicked => {
                                // Bersihkan: kosongkan SEMUA folder →
                                // kembali ke drop zone. File tetap ada
                                // di disk (beda dengan Delete).
                                root.src-folders = ["", "", "", ""];
                                root.kids-0 = ["", "", ""];
                                root.kids-1 = ["", "", ""];
                                root.kids-2 = ["", "", ""];
                                root.kids-3 = ["", "", ""];
                                root.out-folders = ["", "", "", ""];
                                root.out-kids-0 = ["", "", ""];
                                root.out-kids-1 = ["", "", ""];
                                root.out-kids-2 = ["", "", ""];
                                root.out-kids-3 = ["", "", ""];
                                root.expanded-node = "";
                                root.expanded-out = "";
                                root.selected-nodes = [];
                                root.ctx-node = "";
                                root.has-manifest = false;
                                root.toast = "SOURCE dibersihkan (file tetap ada di disk).";
                            }
                        }
                    }
                }
            }

            }

            // ----- LOG PANEL (sidebar kanan; lebar 0 saat tertutup,
            // visible:false tetap makan ruang jadi lebar yang mengatur) -----
            log-panel := LogPanelView {
                width: root.show-logpanel ? 300px : 0px;
                height: root.height - 68px * root.ui-scale;
                visible: root.show-logpanel;
                panel-tab: root.logpanel-tab;
                toast(text) => { root.toast = text; }
                close() => { root.show-logpanel = false; }
                open-explorer(path) => {
                    root.ex-start-path = path;
                    root.overlay-view = "EXPLORER";
                    root.show-logpanel = false;
                    explorer-view.focus-list();
                }
                doc-tab-add() => { }
                doc-tab-close() => { }
            }
        }
    }

    // ===== Overlay layar penuh — pill nav disembunyikan saat salah
    // satu overlay terbuka (overlay-view != ""). Settings dibuka dari
    // flyout profil / Ctrl+,. Toolbox dibuka LANGSUNG dari flyout
    // "Toolbox" (tanpa launcher Modul — tidak ada layar Modul di C#).
    // Explorer overlay ("EXPLORER") = Build B. =====
    SettingsView {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.overlay-view == "SETTINGS";
        widget-bg: root.widget-bg;
        group <=> root.settings-group;
        back() => { root.overlay-view = ""; }
        toast(text) => { root.toast = text; }
        check-update() => { root.check-update(); }
    }
    ToolboxView {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.overlay-view == "TOOLBOX";
        tool-tab <=> root.toolbox-tab;
        back() => { root.overlay-view = ""; }
        toast(text) => { root.toast = text; }
    }
    SheetsView {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.overlay-view == "SHEETS";
        back() => { root.overlay-view = ""; }
        toast(text) => { root.toast = text; }
    }
    LeaderboardView {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.overlay-view == "LEADERBOARD";
        back() => { root.overlay-view = ""; }
        toast(text) => { root.toast = text; }
    }

    // ===== Radial Menu (Fase 4) — overlay "RADIAL": wheel + submenu
    // + dwell (lihat ui/radial.slint). Dibuka dari orb di bar nav /
    // Shift + Klik Tengah di latar dashboard. Esc = tutup (cabang Esc
    // generik di atas sudah menutup overlay apa pun, termasuk RADIAL);
    // klik kanan / klik backdrop = tutup (di radial.slint).
    // open-toolbox: radial membuka TOOLBOX langsung pada tab Mantra
    // yang dipilih (tool-tab <=> toolbox-tab).
    radial-view := RadialMenuView {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.overlay-view == "RADIAL";
        doc-tab-count: log-panel.doc-tab == "2" ? 2 : 1;
        back() => { root.overlay-view = ""; }
        toast(text) => { root.toast = text; }
        execute-script(name) => {
            root.toast = "[Photoshop] Menjalankan: " + name;
        }
        open-toolbox(tab) => {
            root.toolbox-tab = tab;
            root.overlay-view = "TOOLBOX";
            root.toast = "Toolbox — " + tab;
        }
    }

    // ===== Window Trello (CardListWindow C#) — dibuka dari TANDA
    // PANAH widget EDITING/REVISION/LATE. Panel mengambang di tengah
    // (bukan layar penuh): dim + panel 760x600 + title bar + tombol
    // tutup. Isi = daftar kategori itu; klik baris → detail seperti
    // Fase 3 (judul + info + deskripsi + komentar + Tutup).
    // Klik kanan di window / Esc = tutup. Klik kiri di dim TIDAK
    // menutup (seperti window asli). Panel responsif: di window kecil
    // menyusut sampai 40px dari tepi. =====
    Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.overlay-view == "TRELLO-WINDOW";
        // Dim latar.
        Rectangle {
            x: 0; y: 0; width: 100%; height: 100%;
            background: #000000;
            opacity: 0.6;
        }
        // Klik kanan di dim (luar panel) = tutup window.
        tw-dim-touch := TouchArea {
            x: 0; y: 0; width: 100%; height: 100%;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    root.overlay-view = "";
                    root.trello-window-cat = "";
                    root.selected-card = "";
                    root.toast = "Window Trello ditutup (klik kanan)";
                }
            }
        }
        // Panel window.
        Rectangle {
            x: max(20px, (root.width - 760px) / 2);
            y: max(20px, (root.height - 600px) / 2);
            width: min(760px, root.width - 40px);
            height: min(600px, root.height - 40px);
            background: Design.card-bg;
            border-color: Design.separator;
            border-width: 1px;
            border-radius: Design.radius-lg;
            clip: true;

            VerticalLayout {
                x: 0; y: 0; width: 100%; height: 100%;
                padding: Design.space-lg;
                spacing: Design.space-md;

                // Title bar: judul + jumlah + tombol tutup.
                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    Text {
                        text: root.trello-window-cat == "REVISION" ? "Trello — REVISI" : root.trello-window-cat == "LATE" ? "Trello — SUSULAN" : "Trello — EDITING";
                        font-size: Design.font-h2;
                        font-weight: 800;
                        color: Design.text-primary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.list-titles.length + " kartu";
                        font-size: 12px;
                        color: Design.text-muted;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconBtn {
                        glyph: "×";
                        variant: "ghost";
                        clicked => {
                            root.overlay-view = "";
                            root.trello-window-cat = "";
                            root.selected-card = "";
                        }
                    }
                }

                // Area isi: daftar & detail menumpuk absolut (seperti
                // detail Fase 3 — visible:false tetap makan ruang di
                // layout, jadi tidak boleh dua-duanya di VerticalLayout).
                Rectangle {
                    vertical-stretch: 1;

                    // --- Daftar (menyusut saat detail dibuka). ---
                    Rectangle {
                        x: 0; y: 0; width: root.selected-card != "" ? parent.width - root.tw-detail-w - 6px : parent.width; height: 100%;
                        tw-list-back-touch := TouchArea {
                            width: 100%; height: 100%;
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                    root.overlay-view = "";
                                    root.trello-window-cat = "";
                                    root.selected-card = "";
                                    root.toast = "Window Trello ditutup (klik kanan)";
                                }
                            }
                        }
                        Card {
                            x: 0; y: 0; width: 100%; height: 100%;
                            VerticalLayout {
                                padding: Design.space-md;
                                spacing: 4px;

                                for t[index] in root.list-titles:
                                    Rectangle {
                                        height: 48px;
                                        background: tw-row-touch.has-hover ? Design.bg-hover : transparent;
                                        border-radius: Design.radius-sm;
                                        tw-row-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.selected-card = t;
                                                root.selected-index = index;
                                                root.detail-panel = "";
                                                root.detail-added-count = 0;
                                                root.toast = "Membuka: " + t;
                                            }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                    root.overlay-view = "";
                                                    root.trello-window-cat = "";
                                                    root.selected-card = "";
                                                    root.toast = "Window Trello ditutup (klik kanan)";
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 10px;

                                            // Checkbox seleksi (C# CheckBox kiri kartu).
                                            tw-check-wrap := Rectangle {
                                                property <bool> checked: false;
                                                width: 16px;
                                                height: 48px;
                                                tw-check-box := Rectangle {
                                                    width: 16px;
                                                    height: 16px;
                                                    x: 0px;
                                                    y: (parent.height - 16px) / 2;
                                                    background: tw-check-wrap.checked ? root.tw-accent : transparent;
                                                    border-color: tw-check-wrap.checked ? root.tw-accent : Design.border-hover;
                                                    border-width: 1px;
                                                    border-radius: 4px;
                                                    Text {
                                                        width: 100%;
                                                        height: 100%;
                                                        text: "✓";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: white;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        visible: tw-check-wrap.checked;
                                                    }
                                                }
                                                tw-check-touch := TouchArea {
                                                    x: 0px;
                                                    y: (parent.height - 16px) / 2;
                                                    width: 16px;
                                                    height: 16px;
                                                    mouse-cursor: pointer;
                                                    clicked => { tw-check-wrap.checked = !tw-check-wrap.checked; }
                                                }
                                            }

                                            // Nama kartu — prioritas utama (C#: Name 13 SemiBold).
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text {
                                                    text: t;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    color: Design.text-primary;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                }
                                            }

                                            // Badge checklist TODO/DONE (C# ChecklistStatusLabel).
                                            tw-badge-wrap := Rectangle {
                                                width: 62px;
                                                height: 48px;
                                                tw-badge := Rectangle {
                                                    width: 62px;
                                                    height: 22px;
                                                    x: 0px;
                                                    y: (parent.height - 22px) / 2;
                                                    background: root.list-done[index] ? #173F2D : transparent;
                                                    border-color: root.list-done[index] ? #3FAF78 : #46505C;
                                                    border-width: 1px;
                                                    border-radius: 999px;
                                                    HorizontalLayout {
                                                        x: 0px;
                                                        y: (parent.height - 9px) / 2;
                                                        width: 100%;
                                                        height: 9px;
                                                        spacing: 4px;
                                                        alignment: center;
                                                        Text {
                                                            text: "●";
                                                            font-size: 9px;
                                                            color: root.list-done[index] ? #45C98A : #7B8794;
                                                            vertical-alignment: center;
                                                        }
                                                        Text {
                                                            text: root.list-done[index] ? "DONE" : "TODO";
                                                            font-size: 9px;
                                                            font-weight: 700;
                                                            letter-spacing: 1px;
                                                            color: root.list-done[index] ? #9DE8C1 : #AAB4BF;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                            }
                        }
                    }

                    // --- Detail (tampil berdampingan dengan daftar). ---
                    // C# CardListWindow: detail 400px di kolom kanan
                    // (C# MinWidth 400 / MaxWidth 500 — port: 400,
                    // clamp 320 saat panel sempit), daftar menyusut.
                    // Isi = TrelloDetailPanel varian window (judul 20px,
                    // margin 24, latar SurfaceElevated).
                    Rectangle {
                        x: parent.width - root.tw-detail-w; y: 0; width: root.tw-detail-w; height: 100%;
                        visible: root.selected-card != "";
                        TrelloDetailPanel {
                            x: 0; y: 0; width: 100%; height: 100%;
                            card-title: root.selected-card;
                            event-date: root.selected-is-manual ? "—" : root.list-due[root.selected-index];
                            display-id: root.selected-is-manual ? "" : root.list-ids[root.selected-index];
                            due-text: root.selected-is-manual ? "" : "Due: " + root.list-due[root.selected-index];
                            is-manual: root.selected-is-manual;
                            manual-url: root.selected-is-manual ? root.manual-urls[root.selected-manual-index] : "";
                            category-label: root.trello-window-cat == "REVISION" ? "REVISI" : root.trello-window-cat == "LATE" ? "SUSULAN" : root.trello-window-cat;
                            accent: root.tw-accent;
                            done: root.selected-is-manual ? root.manual-done[root.selected-manual-index] : root.list-done[root.selected-index];
                            description: "Edit pas foto sekolah — crop, centering kepala di guide, logo terlihat.";
                            panel-margin: 24px;
                            title-size: 20px;
                            panel-bg: Design.surface-elevated;
                            sub-panel: root.detail-panel;
                            added-count: root.detail-added-count;
                            close => { root.selected-card = ""; root.detail-panel = ""; root.detail-added-count = 0; }
                            unlink => { root.remove-manual(root.selected-manual-index); root.selected-card = ""; root.detail-panel = ""; root.detail-added-count = 0; }
                            show-toast(text) => { root.toast = text; }
                        }
                    }
                }
            }
        }
    }

    // ===== Explorer (overlay "EXPLORER", Build B / LANGKAH 3) =====
    // Dibuka dari Log Panel tab EXPLORER ("Buka Window Baru" / baris
    // folder). Log Panel disembunyikan saat overlay terbuka (overlay
    // layar penuh seperti Settings). Esc / klik kanan latar / tombol
    // × menutup kembali ke dashboard.
    explorer-view := ExplorerView {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.overlay-view == "EXPLORER";
        start-path: root.ex-start-path;
        sr-names: root.ex-sr-names;
        sr-kinds: root.ex-sr-kinds;
        sr-exts: root.ex-sr-exts;
        sr-bases: root.ex-sr-bases;
        sr-sizes: root.ex-sr-sizes;
        sr-dates: root.ex-sr-dates;
        sr-previews: root.ex-sr-previews;
        sr-locs: root.ex-sr-locs;
        sr-paths: root.ex-sr-paths;
        sr-half: root.ex-sr-half;
        sr-truncated: root.ex-sr-truncated;
        ta-index: root.ex-ta-index;
        toast(text) => { root.toast = text; }
        close() => { root.overlay-view = ""; }
        // Kirim folder ke BATCH (toolbar "Kirim ke BATCH"): SOURCE
        // diganti (seperti AddFolders), manifest fase 1 dianggap ada,
        // OUTPUT lama dikosongkan (stale), pindah ke tab BATCH.
        send-to-batch(folder, k0, k1, k2, k3) => {
            root.src-name = folder;
            root.selected-source = folder;
            root.selected-output = folder;
            root.src-folders = [k0, k1, k2, k3];
            root.use-folder-b = folder == "28_SDN BANTAR KAMBING 03";
            if (folder == "27_SDN RANCAIYUH I") {
                root.kids-0 = ["Ahmad.jpg", "Budi.jpg", "template.psd"];
                root.kids-1 = ["foto_01.jpg", "foto_02.jpg", "foto_03.jpg"];
                root.kids-2 = ["id_01.jpg", "id_02.jpg", "template.psd"];
                root.kids-3 = ["kartu_01.jpg", "kartu_02.jpg", "kartu_03.jpg"];
            } else if (folder == "28_SDN BANTAR KAMBING 03") {
                root.kids-0 = root.kids-b-0;
                root.kids-1 = root.kids-b-1;
                root.kids-2 = root.kids-b-2;
                root.kids-3 = root.kids-b-3;
            } else {
                root.kids-0 = ["", "", ""];
                root.kids-1 = ["", "", ""];
                root.kids-2 = ["", "", ""];
                root.kids-3 = ["", "", ""];
            }
            root.expanded-node = "";
            root.selected-nodes = [];
            root.ctx-node = "";
            root.has-manifest = true;
            root.out-folders = ["", "", "", ""];
            root.out-kids-0 = ["", "", ""];
            root.out-kids-1 = ["", "", ""];
            root.out-kids-2 = ["", "", ""];
            root.out-kids-3 = ["", "", ""];
            root.expanded-out = "";
            root.current-tab = "BATCH";
            root.overlay-view = "";
            root.toast = "Dikirim ke BATCH: " + folder;
        }
        // "BUAT MASTER" dari menu konteks item: sama seperti di atas,
        // toast fase 1 (manifest dibuat, template dibuka di Photoshop).
        buat-master(folder, k0, k1, k2, k3) => {
            root.src-name = folder;
            root.selected-source = folder;
            root.selected-output = folder;
            root.src-folders = [k0, k1, k2, k3];
            root.use-folder-b = folder == "28_SDN BANTAR KAMBING 03";
            if (folder == "27_SDN RANCAIYUH I") {
                root.kids-0 = ["Ahmad.jpg", "Budi.jpg", "template.psd"];
                root.kids-1 = ["foto_01.jpg", "foto_02.jpg", "foto_03.jpg"];
                root.kids-2 = ["id_01.jpg", "id_02.jpg", "template.psd"];
                root.kids-3 = ["kartu_01.jpg", "kartu_02.jpg", "kartu_03.jpg"];
            } else if (folder == "28_SDN BANTAR KAMBING 03") {
                root.kids-0 = root.kids-b-0;
                root.kids-1 = root.kids-b-1;
                root.kids-2 = root.kids-b-2;
                root.kids-3 = root.kids-b-3;
            } else {
                root.kids-0 = ["", "", ""];
                root.kids-1 = ["", "", ""];
                root.kids-2 = ["", "", ""];
                root.kids-3 = ["", "", ""];
            }
            root.expanded-node = "";
            root.selected-nodes = [];
            root.ctx-node = "";
            root.has-manifest = true;
            root.out-folders = ["", "", "", ""];
            root.out-kids-0 = ["", "", ""];
            root.out-kids-1 = ["", "", ""];
            root.out-kids-2 = ["", "", ""];
            root.out-kids-3 = ["", "", ""];
            root.expanded-out = "";
            root.current-tab = "BATCH";
            root.overlay-view = "";
            root.toast = "BUAT MASTER: " + folder + " → Batch (fase 1: manifest dibuat, template dibuka di Photoshop)";
        }
        open-settings-explorer() => {
            root.settings-group = "Explorer";
            root.overlay-view = "SETTINGS";
        }
        search-request(query, key) => { root.ex-search(query, key); }
        typeahead-request(key, buffer) => { root.ex-typeahead(key, buffer); }
        add-txt-ext(name) => { root.ex-add-txt-ext(name) }
        initials(name) => { root.ex-initials(name) }
        split-ext(name) => { root.ex-split-ext(name) }
        name-base(name) => { root.ex-name-base(name) }
        is-typeahead-char(ch) => { root.ex-is-typeahead-char(ch) }
    }

    // ===== Flyout profil (overlay, di bawah tombol profil) =====
    Rectangle {
        visible: root.show-flyout && root.overlay-view == "";
        x: (root.width - 256px) / 2;
        y: 60px * root.ui-scale;
        width: 256px;
        height: flyout-layout.preferred-height;
        background: Design.surface-elevated;
        border-color: Design.separator;
        border-width: 1px;
        border-radius: Design.radius-md;

        flyout-layout := VerticalLayout {
            padding: Design.space-md;
            spacing: 0;

            Text {
                text: "abeng";
                font-size: Design.font-h3;
                font-weight: 700;
                color: Design.text-primary;
            }
            HorizontalLayout {
                height: 22px;
                spacing: 6px;
                Text {
                    text: "●";
                    font-size: 8px;
                    color: Design.status-success;
                    vertical-alignment: center;
                }
                Text {
                    text: "Selamat datang kembali";
                    font-size: Design.font-caption;
                    color: Design.text-secondary;
                    vertical-alignment: center;
                }
            }

            HSeparator { }

            Rectangle {
                height: 36px;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show-flyout = false; root.overlay-view = "SETTINGS"; root.list-category = ""; root.selected-card = ""; }
                }
                Text {
                    text: "Settings";
                    font-size: Design.font-body;
                    font-weight: 700;
                    color: Design.text-primary;
                    width: 100%;
                    height: 100%;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: 36px;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show-flyout = false; root.overlay-view = "TOOLBOX"; }
                }
                Text {
                    text: "Toolbox";
                    font-size: Design.font-body;
                    font-weight: 700;
                    color: Design.text-primary;
                    width: 100%;
                    height: 100%;
                    vertical-alignment: center;
                }
            }
            // Saklar Terminal = buka/tutup Log Panel (EXPLORER_SPEC.md
            // §3.1; Ctrl+L BUKAN toggle panel ini).
            HorizontalLayout {
                height: 36px;
                spacing: 8px;
                Text {
                    text: "Terminal (Log Panel)";
                    font-size: Design.font-body;
                    font-weight: 700;
                    color: Design.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Toggle {
                        checked: root.show-logpanel;
                        toggled(checked) => { root.show-logpanel = checked; }
                    }
                }
            }
            Rectangle {
                height: 36px;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.show-flyout = false;
                        root.dialog-open = "EXIT";
                    }
                }
                Text {
                    text: "Log Out";
                    font-size: Design.font-body;
                    font-weight: 700;
                    color: Design.status-danger;
                    width: 100%;
                    height: 100%;
                    vertical-alignment: center;
                }
            }

            HSeparator { }

            Text {
                text: "BMACHINE · v6.5.0";
                font-size: 9px;
                color: Design.text-muted;
                vertical-alignment: center;
                height: 28px;
            }
        }
    }

    // ===== Toast (umpan balik aksi, hilang sendiri 2,5 detik) =====
    // Lebar 480px supaya pesan panjang (mis. "[SUCCESS] Batch
    // Selesai.") tidak terpotong.
    Rectangle {
        visible: root.toast != "";
        x: (root.width - 480px) / 2;
        y: root.height - 60px;
        width: 480px;
        height: 36px;
        background: Design.surface-elevated;
        border-color: Design.border-hover;
        border-width: 1px;
        border-radius: Design.radius-sm;

        Text {
            text: root.toast;
            font-size: Design.font-body;
            color: Design.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }

    // ===== FASE 5: DIALOG MODAL & SPLASH SCREEN =====
    if root.dialog-open == "EXIT" : ExitConfirmDialog {
        x: 0; y: 0; width: 100%; height: 100%;
        confirmed => {
            root.confirm-exit();
            root.dialog-open = "";
        }
        cancelled => {
            root.dialog-open = "";
        }
    }

    if root.dialog-open == "UPDATE" : UpdateDialog {
        x: 0; y: 0; width: 100%; height: 100%;
        latest-version: root.update-latest-version;
        size-text: root.update-size-text;
        notes: root.update-notes;
        applied => {
            root.apply-update();
            root.dialog-open = "";
        }
        dismissed => {
            root.dismiss-update();
            root.dialog-open = "";
        }
    }

    if root.app-stage == "splash" : SplashView {
        x: 0; y: 0; width: 100%; height: 100%;
        progress: root.splash-progress;
        status: root.splash-status;
        log1: root.splash-log1;
        log2: root.splash-log2;
        log3: root.splash-log3;
    }
    } // tutup keys-scope FocusScope
}
