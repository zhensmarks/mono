        delete-user-theme(id) => { root.delete-user-theme(id); }
        save-general-settings() => { root.save-general-settings(); }
        export-database() => { root.export-database(); }
        import-database() => { root.import-database(); }
        save-paths-settings() => { root.save-paths-settings(); }
        browse-path(k) => { root.browse-path(k); }
        test-trello() => { root.test-trello(); }
