        late-list-id <=> root.late-list-id;
        qc-board-id <=> root.qc-board-id;
        acc-board-id <=> root.acc-board-id;
        acc-list-id <=> root.acc-list-id;
        google-creds-path <=> root.google-creds-path;
        google-sheet-name <=> root.google-sheet-name;
        google-sheet-col <=> root.google-sheet-col;
        google-sheet-row <=> root.google-sheet-row;
        spreadsheet-sheet-name <=> root.spreadsheet-sheet-name;
        spreadsheet-range <=> root.spreadsheet-range;
        lb-harian-range <=> root.lb-harian-range;
        lb-bulanan-range <=> root.lb-bulanan-range;
        stat-editing <=> root.stat-editing;
        stat-revision <=> root.stat-revision;
        stat-late <=> root.stat-late;
        stat-points <=> root.stat-points;
        recording-shortcut <=> root.recording-shortcut;
        current-shortcut-label <=> root.current-shortcut-label;
        start-recording-shortcut() => { root.start-recording-shortcut(); }
        cancel-recording-shortcut() => { root.cancel-recording-shortcut(); }
        save-account-settings() => { root.save-account-settings(); }
        appearance-changed() => { root.apply-appearance(); }
        reset-appearance() => { root.reset-appearance(); }
