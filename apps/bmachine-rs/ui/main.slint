        pet-installed-slugs <=> root.app-pet-installed-slugs;
        pet-active-index <=> root.app-pet-active-index;
        pet-install-input <=> root.app-pet-install-input;
        pet-install-busy <=> root.app-pet-install-busy;
        pet-active-changed(index) => { root.pet-active-changed(index); }
        pet-install-requested(text) => { root.pet-install-requested(text); }
        pet-remove-requested(index) => { root.pet-remove-requested(index); }
        pet-open-page(index) => { root.pet-open-page(index); }
        path-local <=> root.app-path-local;
