    // Radial Menu kini window OS (C# RadialMenuWindow 320x320 di
    // cursor) — lihat RadialMenuWindow di ui/windows.slint + wiring
    // Rust di src/main.rs. Geometri roda tetap 1:1 C#.

    // ===== Window Trello (CardListWindow C#) — dibuka dari TANDA
    // PANAH widget EDITING/REVISION/LATE. Panel mengambang di tengah
    // (bukan layar penuh): dim + panel 760x600 + title bar + tombol
    // tutup. Isi = daftar kategori itu; klik baris → detail seperti
    // Fase 3 (judul + info + deskripsi + komentar + Tutup).
    // Klik kanan di window / Esc = tutup. Klik kiri di dim TIDAK
    // menutup (seperti window asli). Panel responsif: di window kecil
    // menyusut sampai 40px dari tepi. =====
    Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.overlay-view == "TRELLO-WINDOW";
        // Dim latar.
        Rectangle {
            x: 0; y: 0; width: 100%; height: 100%;
            background: Design.overlay-solid;
            opacity: 0.6;
        }
        // Klik kanan di dim (luar panel) = tutup window.
        tw-dim-touch := TouchArea {
            x: 0; y: 0; width: 100%; height: 100%;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    root.overlay-view = "";
                    root.trello-window-cat = "";
                    root.selected-card = "";
                    root.toast = "Window Trello ditutup (klik kanan)";
                }
            }
        }
        // Panel window.
        Rectangle {
            x: max(20px, (root.width - 760px) / 2);
            y: max(20px, (root.height - 600px) / 2);
            width: min(760px, root.width - 40px);
            height: min(600px, root.height - 40px);
            background: Design.card-bg;
            border-color: Design.separator;
            border-width: 1px;
            border-radius: Design.radius-lg;
            clip: true;

            VerticalLayout {
                x: 0; y: 0; width: 100%; height: 100%;
                padding: Design.space-lg;
                spacing: Design.space-md;

                // Title bar: judul + jumlah + tombol tutup.
                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    Text {
                        text: root.trello-window-cat == "REVISION" ? "Trello — REVISI" : root.trello-window-cat == "LATE" ? "Trello — SUSULAN" : "Trello — EDITING";
                        font-size: Design.font-h2;
                        font-weight: 800;
                        color: Design.text-primary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.list-titles.length + " kartu";
                        font-size: 12px;
                        color: Design.text-muted;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconBtn {
                        glyph: "×";
                        variant: "ghost";
                        clicked => {
                            root.overlay-view = "";
                            root.trello-window-cat = "";
                            root.selected-card = "";
                        }
                    }
                }

                // Area isi: daftar & detail menumpuk absolut (seperti
                // detail Fase 3 — visible:false tetap makan ruang di
                // layout, jadi tidak boleh dua-duanya di VerticalLayout).
                Rectangle {
                    vertical-stretch: 1;

                    // --- Daftar (menyusut saat detail dibuka). ---
                    Rectangle {
                        x: 0; y: 0; width: root.selected-card != "" ? parent.width - root.tw-detail-w - 6px : parent.width; height: 100%;
                        tw-list-back-touch := TouchArea {
                            width: 100%; height: 100%;
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                    root.overlay-view = "";
                                    root.trello-window-cat = "";
                                    root.selected-card = "";
                                    root.toast = "Window Trello ditutup (klik kanan)";
                                }
                            }
                        }
                        Card {
                            x: 0; y: 0; width: 100%; height: 100%;
                            VerticalLayout {
                                padding: Design.space-md;
                                spacing: 4px;

                                for t[index] in root.list-titles:
                                    Rectangle {
                                        height: 48px;
                                        background: tw-row-touch.has-hover ? Design.bg-hover : transparent;
                                        border-radius: Design.radius-sm;
                                        tw-row-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.selected-card = t;
                                                root.selected-index = index;
                                                root.detail-panel = "";
                                                root.detail-added-count = 0;
                                                root.toast = "Membuka: " + t;
                                            }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                    root.overlay-view = "";
                                                    root.trello-window-cat = "";
                                                    root.selected-card = "";
                                                    root.toast = "Window Trello ditutup (klik kanan)";
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 10px;

                                            // Checkbox seleksi (C# CheckBox kiri kartu).
                                            tw-check-wrap := Rectangle {
                                                property <bool> checked: false;
                                                width: 16px;
                                                height: 48px;
                                                tw-check-box := Rectangle {
                                                    width: 16px;
                                                    height: 16px;
                                                    x: 0px;
                                                    y: (parent.height - 16px) / 2;
                                                    background: tw-check-wrap.checked ? root.tw-accent : transparent;
                                                    border-color: tw-check-wrap.checked ? root.tw-accent : Design.border-hover;
                                                    border-width: 1px;
                                                    border-radius: 4px;
                                                    Text {
                                                        width: 100%;
                                                        height: 100%;
                                                        text: "✓";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: white;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        visible: tw-check-wrap.checked;
                                                    }
                                                }
                                                tw-check-touch := TouchArea {
                                                    x: 0px;
                                                    y: (parent.height - 16px) / 2;
                                                    width: 16px;
                                                    height: 16px;
                                                    mouse-cursor: pointer;
                                                    clicked => { tw-check-wrap.checked = !tw-check-wrap.checked; }
                                                }
                                            }

                                            // Nama kartu — prioritas utama (C#: Name 13 SemiBold).
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text {
                                                    text: t;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    color: Design.text-primary;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                }
                                            }

                                            // Badge checklist TODO/DONE (C# ChecklistStatusLabel).
                                            tw-badge-wrap := Rectangle {
                                                width: 62px;
                                                height: 48px;
                                                tw-badge := Rectangle {
                                                    width: 62px;
                                                    height: 22px;
                                                    x: 0px;
                                                    y: (parent.height - 22px) / 2;
                                                    background: root.list-done[index] ? Design.done-row-bg : transparent;
                                                    border-color: root.list-done[index] ? Design.done-row-border : Design.row-border-idle;
                                                    border-width: 1px;
                                                    border-radius: 999px;
                                                    HorizontalLayout {
                                                        x: 0px;
                                                        y: (parent.height - 9px) / 2;
                                                        width: 100%;
                                                        height: 9px;
                                                        spacing: 4px;
                                                        alignment: center;
                                                        Text {
                                                            text: "●";
                                                            font-size: 9px;
                                                            color: root.list-done[index] ? Design.done-text : Design.row-text-dim;
                                                            vertical-alignment: center;
                                                        }
                                                        Text {
                                                            text: root.list-done[index] ? "DONE" : "TODO";
                                                            font-size: 9px;
                                                            font-weight: 700;
                                                            letter-spacing: 1px;
                                                            color: root.list-done[index] ? Design.done-text-alt : Design.row-text-alt;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                            }
                        }
                    }

                    // --- Detail (tampil berdampingan dengan daftar). ---
                    // C# CardListWindow: detail 400px di kolom kanan
                    // (C# MinWidth 400 / MaxWidth 500 — port: 400,
                    // clamp 320 saat panel sempit), daftar menyusut.
                    // Isi = TrelloDetailPanel varian window (judul 20px,
                    // margin 24, latar SurfaceElevated).
                    Rectangle {
                        x: parent.width - root.tw-detail-w; y: 0; width: root.tw-detail-w; height: 100%;
                        visible: root.selected-card != "";
                        TrelloDetailPanel {
                            x: 0; y: 0; width: 100%; height: 100%;
                            card-title: root.selected-card;
                            event-date: root.selected-is-manual ? "—" : root.list-due[root.selected-index];
                            display-id: root.selected-is-manual ? "" : root.list-ids[root.selected-index];
                            due-text: root.selected-is-manual ? "" : "Due: " + root.list-due[root.selected-index];
                            is-manual: root.selected-is-manual;
                            manual-url: root.selected-is-manual ? root.manual-urls[root.selected-manual-index] : "";
                            card-url-override: root.selected-is-manual ? "" : root.list-urls[root.selected-index];
                            category-label: root.trello-window-cat == "REVISION" ? "REVISI" : root.trello-window-cat == "LATE" ? "SUSULAN" : root.trello-window-cat;
                            accent: root.tw-accent;
                            done: root.selected-is-manual ? root.manual-done[root.selected-manual-index] : root.list-done[root.selected-index];
                            description: "Edit pas foto sekolah — crop, centering kepala di guide, logo terlihat.";
                            panel-margin: 24px;
                            title-size: 20px;
                            panel-bg: Design.surface-elevated;
                            sub-panel: root.detail-panel;
                            added-count: root.detail-added-count;
                            user-name: root.app-user-name;
                            user-initial: root.app-user-initial;
                            close => { root.selected-card = ""; root.detail-panel = ""; root.detail-added-count = 0; }
                            unlink => { root.remove-manual(root.selected-manual-index); root.selected-card = ""; root.detail-panel = ""; root.detail-added-count = 0; }
                            show-toast(text) => { root.toast = text; }
                    open-url(u) => { root.open-url(u); }
                        }
                    }
                }
            }
        }
    }

    // ===== Explorer (overlay "EXPLORER", Build B / LANGKAH 3) =====
    // Dibuka dari Log Panel tab EXPLORER ("Buka Window Baru" / baris
    // folder). Log Panel disembunyikan saat overlay terbuka (overlay
    // layar penuh seperti Settings). Esc / klik kanan latar / tombol
    // × menutup kembali ke dashboard.
    explorer-view := ExplorerView {
        x: root.chrome-wrapped ? 8px : 0px; y: root.chrome-overlay-y;
        width: root.width - (root.chrome-wrapped ? 16px : 0px); height: root.height - root.chrome-overlay-y - root.chrome-content-bottom;
        visible: root.overlay-view == "EXPLORER";
        start-path: root.ex-start-path;
        sr-names: root.ex-sr-names;
        sr-kinds: root.ex-sr-kinds;
        sr-exts: root.ex-sr-exts;
        sr-bases: root.ex-sr-bases;
        sr-sizes: root.ex-sr-sizes;
        sr-dates: root.ex-sr-dates;
        sr-previews: root.ex-sr-previews;
        sr-locs: root.ex-sr-locs;
        sr-paths: root.ex-sr-paths;
        sr-half: root.ex-sr-half;
        sr-truncated: root.ex-sr-truncated;
        ta-index: root.ex-ta-index;
        toast(text) => { root.toast = text; }
        close() => { root.overlay-view = ""; }
        // Kirim folder ke BATCH (toolbar "Kirim ke BATCH"): SOURCE
        // diganti (seperti AddFolders), manifest fase 1 dianggap ada,
        // OUTPUT lama dikosongkan (stale), pindah ke tab BATCH.
        send-to-batch(folder) => {
            // Folder NYATA (full path) — Rust scan disk + prediksi
            // output (BATCH_DASHBOARD §4.3), ganti seluruh SOURCE.
            root.batch-add-folder(folder);
            root.current-tab = "BATCH";
            root.overlay-view = "";
        }
        // "BUAT MASTER" dari menu konteks item: sama seperti di atas,
        // toast fase 1 (manifest dibuat, template dibuka di Photoshop).
        buat-master(folder) => {
            // Seperti send-to-batch, lalu langsung Fase 1 (manifest).
            root.batch-add-folder(folder);
            root.current-tab = "BATCH";
            root.overlay-view = "";
            root.batch-phase1();
        }
        open-settings-explorer() => {
            // Pengaturan Explorer kini tampilan tersendiri (C#
            // ExplorerSettingsView), bukan lagi grup Settings.
            root.overlay-view = "EXPLORER-SETTINGS";
        }
        search-request(query, key) => { root.ex-search(query, key); }
        typeahead-request(key, buffer) => { root.ex-typeahead(key, buffer); }
        add-txt-ext(name) => { root.ex-add-txt-ext(name) }
        initials(name) => { root.ex-initials(name) }
        split-ext(name) => { root.ex-split-ext(name) }
        name-base(name) => { root.ex-name-base(name) }
        is-typeahead-char(ch) => { root.ex-is-typeahead-char(ch) }
    }

    // ===== Flyout profil (overlay, di bawah tombol profil) =====
    // Posisi menempel tombol pemanggil (C#: Button.Flyout di tombol
    // akun — bawah tombol, rata kiri): x = tepi kiri tombol avatar
    // dan y = bawah tombol avatar + jarak 8px*scale — keduanya dari
    // absolute-position avatar (avatar kini di tengah bar atas sejak
    // 27 Nov 20:04 dan tingginya 44px*scale, jadi x DAN y tidak boleh
    // hardcode lagi). DULU: x di tengah layar + y 60px — SALAH (abeng,
    // 27 Nov 18:48: flyout muncul di tengah, harusnya di posisi
    // tombol yang memanggilnya).
    Rectangle {
        visible: root.show-flyout && root.overlay-view == "";
        x: avatar-btn.absolute-position.x;
        y: avatar-btn.absolute-position.y + avatar-btn.height + 8px * root.ui-scale;
        width: 256px;
        height: flyout-layout.preferred-height;
        background: Design.surface-elevated;
        border-color: Design.separator;
        border-width: 1px;
        border-radius: Design.radius-md;

        // Redesain 27 Nov 19:04 (abeng: "1000x lebih bagus") — posisi
        // TETAP menempel avatar (di bawah bar atas, x mengikuti avatar,
        // jangan hardcode): header profil (nama + sapaan, TANPA avatar
        // — 27 Nov 19:37), item dikelompokkan (APLIKASI / LAINNYA)
        // dengan ikon + label + shortcut yang konsisten + hover jelas,
        // footer rapi (versi + status update). Semua warna dari token
        // Design → ikut tema aktif.
        flyout-layout := VerticalLayout {
            padding: Design.space-md;
            spacing: 4px;

            // Header profil: nama + status/sapaan saja, TANPA avatar
            // (abeng 27 Nov 19:37 — avatar redundan: pemanggil flyout
            // ini sendiri sudah ikon user). Dot status berupa Rectangle
            // 8px, bukan Text "●" — Text "●" lebarnya ~31px padahal
            // glyph cuma 7px, sehingga jarak dot-teks jadi 30px padahal
            // spacing yang ditulis 6px.
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.app-user-name;
                    font-size: Design.font-h3;
                    font-weight: 700;
                    color: Design.text-primary;
                }
                HorizontalLayout {
                    height: 18px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            background: Design.status-success;
                            border-radius: 4px;
                        }
                    }
                    Text {
                        text: root.greeting-text;
                        font-size: Design.font-caption;
                        color: Design.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }

            HSeparator { }

            // [C#] Item pembaruan — hanya bila ada update tersedia.
            if root.has-pending-update : FlyoutItem {
                icon-name: "refresh";
                label: "Ada pembaruan " + root.update-latest-version;
                label-color: Design.accent;
                clicked => {
                    root.show-flyout = false;
                    root.dialog-open = "UPDATE";
                }
            }

            Text {
                text: "APLIKASI";
                font-size: 10px;
                font-weight: 700;
                color: Design.text-muted;
                height: 22px;
                vertical-alignment: center;
            }

            // Saklar Terminal = buka/tutup Log Panel (EXPLORER_SPEC.md
            // §3.1; Ctrl+L BUKAN toggle panel ini). Klik baris tidak
            // mengubah apa pun — Toggle sendiri yang mengubah.
            FlyoutItem {
                icon-name: "terminal";
                label: "Terminal";
                show-toggle: true;
                toggle-style: root.app-toggle-style;
                toggle-checked: root.show-logpanel;
                toggled(checked) => { root.show-logpanel = checked; }
                clicked => { }
            }
            // Saklar Dynamic Bar = tampil/sembunyi floating mini-bar
            // (angka widget + notifikasi tanpa buka window utama).
            // Klik kanan di bar juga menutupnya; toggle ini yang
            // membukanya lagi.
            FlyoutItem {
                icon-name: "layers";
                label: "Dynamic Bar";
                show-toggle: true;
                toggle-style: root.app-toggle-style;
                toggle-checked: root.app-dynamic-bar-visible;
                toggled(checked) => {
                    if (checked) {
                        root.open-dynamic-bar();
                    } else {
                        root.hide-dynamic-bar();
                    }
                }
                clicked => { }
            }
            FlyoutItem {
                icon-name: "settings";
                label: "Settings";
                hint: "Ctrl+,";
                clicked => { root.show-flyout = false; root.overlay-view = "SETTINGS"; root.list-category = ""; root.selected-card = ""; }
            }

            Text {
                text: "LAINNYA";
                font-size: 10px;
                font-weight: 700;
                color: Design.text-muted;
                height: 22px;
                vertical-alignment: center;
            }

            FlyoutItem {
                icon-name: "info";
                label: "Laporkan Bug";
                clicked => {
                    root.show-flyout = false;
                    root.open-report-bug();
                }
            }
            FlyoutItem {
                icon-name: "arrow-right";
                label: "Log Out";
                label-color: Design.status-danger;
                clicked => {
                    root.show-flyout = false;
                    root.dialog-open = "EXIT";
                }
            }

            HSeparator { }

            // Footer: versi + status update.
            HorizontalLayout {
                height: 24px;
                Text {
                    text: "BMACHINE · " + root.app-version;
                    font-size: 9px;
                    color: Design.text-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.has-pending-update ? "Pembaruan tersedia" : "Terbaru";
                    font-size: 9px;
                    font-weight: 700;
                    color: root.has-pending-update ? Design.accent : Design.status-success;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ===== Toast (umpan balik aksi, hilang sendiri 2,5 detik) =====
    Rectangle {
        visible: root.toast != "";
        x: (root.width - min(480px, root.width - 32px)) / 2;
        y: root.height - 56px;
        width: min(480px, root.width - 32px);
        height: 36px;
        background: Design.surface-elevated;
        border-color: Design.accent;
        border-width: 1px;
        border-radius: Design.radius-md;
        clip: true;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 8px;
            Text {
                text: "●";
                font-size: 8px;
                color: Design.accent;
                vertical-alignment: center;
            }
            Text {
                text: root.toast;
                font-size: Design.font-body;
                font-weight: 500;
                color: Design.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }

    // ===== Custom Titlebar (frameless drag + min/max/close) =====
    // Tampil saat gaya chrome "custom" / "wrapped" dan stage main.
    // Tombol kontrol = komponen WindowControls (gaya icons/dots,
    // posisi kanan/kiri — lihat §23). Area drag menghindar dari
    // tombol (kanan 108px, atau kiri 130px bila tombol di kiri).
    if root.chrome-has-titlebar && root.app-stage == "main" : Rectangle {
        x: 0; y: 0;
        width: 100%;
        height: 28px;
        background: Design.app-bg;

        title-drag := TouchArea {
            x: root.app-chrome-button-position == "left" ? 130px : 0px;
            y: 0;
            width: parent.width - (root.app-chrome-button-position == "left" ? 130px : 108px);
            height: 100%;
            property <length> press-x: 0px;
            property <length> press-y: 0px;
            property <bool> dragging: false;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    self.press-x = self.mouse-x;
                    self.press-y = self.mouse-y;
                    self.dragging = true;
                } else if (ev.kind == PointerEventKind.up) {
                    self.dragging = false;
                } else if (ev.kind == PointerEventKind.move && self.dragging) {
                    root.win-move(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
                }
            }
            double-clicked => { root.win-maximize(); }
        }

        HorizontalLayout {
            x: 0; y: 0; width: 100%; height: 100%;
            padding-left: 14px;
            padding-right: 6px;
            spacing: 8px;

            // Tombol kontrol di kiri (gaya macOS).
            if root.app-chrome-button-position == "left" : WindowControls {
                y: 2px;
                button-style: root.app-chrome-button-style;
                minimize() => { root.win-minimize(); }
                maximize() => { root.win-maximize(); }
                close() => { root.confirm-exit(); }
            }
            Text {
                text: "●";
                font-size: 7px;
                color: root.app-trello-connected ? Design.status-success : Design.accent;
                vertical-alignment: center;
            }
            Text {
                text: "BMACHINE";
                font-size: 10px;
                font-weight: 800;
                letter-spacing: 1.4px;
                color: Design.text-muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            // Tombol kontrol di kanan (gaya Windows, bawaan).
            if root.app-chrome-button-position == "right" : WindowControls {
                y: 2px;
                button-style: root.app-chrome-button-style;
                minimize() => { root.win-minimize(); }
                maximize() => { root.win-maximize(); }
                close() => { root.confirm-exit(); }
            }
        }
    }

    // Drag strip mode headless: tanpa titlebar, window dipindah
    // dengan menyeret 28px teratas. Dideklarasikan PALING ATAS
    // (setelah titlebar, sebelum dialog) supaya drag tetap jalan
    // walau overlay layar penuh (Settings/dll) terbuka — strip yang
    // ditaruh di bawah overlay tertutup TouchArea latar overlay
    // (settings-back-touch, dim Trello, Flickable isi) sehingga
    // window tidak bisa dipindah saat Settings dibuka. Konsekuensi:
    // 28px teratas jadi gagang drag — klik di pita itu tidak sampai
    // ke konten (ujung atas avatar/kapsul nav ±8px). Klik tengah
    // avatar/kapsul tetap jalan; tombol header overlay duduk di
    // bawah pita ini.
    if root.app-chrome == "headless" && root.app-stage == "main" : TouchArea {
        x: 0; y: 0;
        width: 100%;
        height: 28px;
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <bool> dragging: false;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
                self.dragging = true;
            } else if (ev.kind == PointerEventKind.up) {
                self.dragging = false;
            } else if (ev.kind == PointerEventKind.move && self.dragging) {
                root.win-move(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
            }
        }
        double-clicked => { root.win-maximize(); }
    }

    // ===== FASE 5: DIALOG MODAL & SPLASH SCREEN =====
    if root.dialog-open == "EXIT" : ExitConfirmDialog {
        x: 0; y: 0; width: 100%; height: 100%;
        confirmed => {
            root.confirm-exit();
            root.dialog-open = "";
        }
        cancelled => {
            root.dialog-open = "";
        }
    }

    if root.dialog-open == "UPDATE" : UpdateDialog {
        x: 0; y: 0; width: 100%; height: 100%;
        latest-version: root.update-latest-version;
        size-text: root.update-size-text;
        notes: root.update-notes;
        applied => {
            root.apply-update();
            root.dialog-open = "";
        }
        dismissed => {
            root.dismiss-update();
            root.dialog-open = "";
        }
    }

    if root.app-stage == "splash" : SplashView {
        x: 0; y: 0; width: 100%; height: 100%;
        progress: root.splash-progress;
        status: root.splash-status;
        version-text: root.splash-version;
        log1: root.splash-log1;
        log2: root.splash-log2;
        log3: root.splash-log3;
    }
    } // tutup keys-scope FocusScope
}
