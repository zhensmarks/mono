        sheet-next-page() => { root.sheet-next-page(); }
        sheet-hit-col(x) => { return root.sheet-hit-col(x); }
        sheet-select-rows(r, c, m, a) => { return root.sheet-select-rows(r, c, m, a); }
        sheet-is-typeahead-char(t) => { return root.sheet-is-typeahead-char(t); }
        back() => { root.overlay-view = ""; }
