// BMachine Dashboard — Rust/Slint.
// Menggunakan Design System di design.slint (token + komponen bersama).
// HOME = grid 2x2 StatWidget yang MENGISI window. Font mengikuti ukuran
// window lewat ui-scale. Tab HOME/BATCH benar-benar berpindah.
// Klik StatWidget menampilkan toast. Tombol profil membuka flyout.

import { Design, Card, HSeparator, NavTab, StatWidget, Btn, IconBtn, Toggle, TextField, SvgIcon, FlyoutItem, WindowControls, ComboBox } from "design.slint";
export { Design }
import { SettingsView } from "settings.slint";
import { ExplorerSettingsView } from "explorer-settings.slint";
import { ToolboxView, SheetsView, LeaderboardView } from "modul.slint";
import { LogPanelView } from "logpanel.slint";
import { ExplorerView } from "explorer.slint";
import { TrelloDetailPanel } from "trello-detail.slint";
import { RadialMenuView } from "radial.slint";
import { SplashView } from "splash.slint";
import { ExitConfirmDialog, UpdateDialog } from "dialog.slint";
export { SpreadsheetWindow, CardListWindow, RadialMenuWindow, ToolboxWindow, ReportBugDialog, DynamicBarWindow } from "windows.slint";

// ===== BATCH — baris tree + menu konteks (model beneran, Rust) =====
// Satu baris tree BATCH (flat row dari src/batch.rs): indentasi dari
// depth, chevron ▸/▾ untuk folder, ikon ▤ untuk file, nama tebal
// untuk folder. Klik kiri = pilih + salin path (Rust); klik kanan =
// expand/collapse + buka menu konteks (Rust, LANJUTKAN §10).
struct BatchRow {
    id: string,
    name: string,
    path: string,
    depth: int,
    is-dir: bool,
    expanded: bool,
    has-kids: bool,
    selected: bool,
    is-root: bool,
}

component BatchTreeRow inherits Rectangle {
    in property <string> row-id: "";
    in property <string> row-name: "";
    in property <int> row-depth: 0;
    in property <bool> row-is-dir: true;
    in property <bool> row-expanded: false;
    in property <bool> row-has-kids: false;
    in property <bool> row-selected: false;
    in property <string> panel: "SOURCE";
    callback row-clicked(string, string);
    callback row-right-down(string, string);
    callback row-right-up(string, string);
    callback row-toggle-expand(string, string);
    callback row-more(string, string);

    // Baris folder 36px, baris anak (file) 26px — tree padat C#,
    // tidak ikut ui-scale.
    height: row-is-dir ? 36px : 26px;
    background: row-selected ? Design.accent-subtle : (row-touch.has-hover ? Design.bg-hover : transparent);
    border-radius: Design.radius-sm;

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.row-clicked(panel, row-id); }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.row-right-down(panel, row-id);
            } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right) {
                root.row-right-up(panel, row-id);
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px + row-depth * 16px;
        padding-right: 10px;
        spacing: 8px;

        // Chevron (folder beranak) / ikon file ▤ / spasi kosong.
        Rectangle {
            width: 20px;
            height: 100%;
            chev-touch := TouchArea {
                mouse-cursor: pointer;
                enabled: row-is-dir && row-has-kids;
                clicked => { root.row-toggle-expand(panel, row-id); }
            }
            Text {
                text: row-is-dir ? (row-has-kids ? (row-expanded ? "▾" : "▸") : "") : "▤";
                font-size: 12px;
                font-weight: 700;
                color: row-is-dir ? Design.text-secondary : Design.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Text {
            text: row-name;
            font-size: 12px;
            font-weight: row-is-dir ? 700 : 400;
            color: row-selected ? Design.accent : (row-is-dir ? Design.text-primary : Design.text-secondary);
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        IconBtn {
            glyph: "⋯";
            variant: "ghost";
            scale: 1;
            size: 24px;
            clicked => { root.row-more(panel, row-id); }
        }
    }
}

// Menu konteks BATCH — satu komponen dipakai panel SOURCE + OUTPUT.
// Isi menyesuaikan panel + jenis node (C# DashboardView.axaml):
// root + item = New Subfolder… / Replace (Auto) / Copy Path / Delete;
// child direktori = Replace (Auto) / Copy Path; OUTPUT tanpa Replace.
// Replace (Manual) hanya SOURCE + direktori.
component BatchCtxMenu inherits Card {
    in property <string> menu-title: "";
    in property <bool> show-replace: false;
    in property <bool> show-copy-output: false;
    callback new-subfolder();
    callback replace-auto();
    callback replace-manual();
    callback copy-path();
    callback copy-output-path();
    callback delete();
    callback close-menu();

    background: Design.surface-elevated;
    border-color: Design.border-hover;
    border-width: 1px;
    border-radius: Design.radius-md;

    ctx-layout := VerticalLayout {
        padding: Design.space-sm;
        spacing: 2px;

        Text {
            text: "⋯ " + root.menu-title;
            font-size: 12px;
            font-weight: 700;
            color: Design.text-primary;
            horizontal-stretch: 1;
            overflow: elide;
        }
        HSeparator { }

        Rectangle {
            height: 32px;
            background: ctx-new.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-new := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.new-subfolder(); }
            }
            Text {
                text: "New Subfolder…";
                font-size: 12px;
                color: Design.text-primary;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }

        Rectangle {
            height: root.show-replace ? 32px : 0px;
            visible: root.show-replace;
            background: ctx-rep.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-rep := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.replace-auto(); }
            }
            Text {
                text: "Replace (Auto)";
                font-size: 12px;
                color: Design.text-primary;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }

        Rectangle {
            height: root.show-replace ? 32px : 0px;
            visible: root.show-replace;
            background: ctx-repm.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-repm := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.replace-manual(); }
            }
            Text {
                text: "Replace (Manual)";
                font-size: 12px;
                color: Design.text-primary;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }

        Rectangle {
            height: 32px;
            background: ctx-copy.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-copy := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.copy-path(); }
            }
            Text {
                text: "Copy Path";
                font-size: 12px;
                color: Design.text-primary;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }

        Rectangle {
            height: root.show-copy-output ? 32px : 0px;
            visible: root.show-copy-output;
            background: ctx-copyout.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-copyout := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.copy-output-path(); }
            }
            Text {
                text: "Copy Output Path";
                font-size: 12px;
                color: Design.text-primary;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }

        Rectangle {
            height: 32px;
            background: ctx-del.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-del := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.delete(); }
            }
            Text {
                text: "Delete";
                font-size: 12px;
                font-weight: 700;
                color: Design.status-danger;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }

        HSeparator { }

        Rectangle {
            height: 28px;
            background: ctx-close.has-hover ? Design.bg-hover : transparent;
            border-radius: Design.radius-sm;
            ctx-close := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close-menu(); }
            }
            Text {
                text: "✕ Tutup";
                font-size: 11px;
                color: Design.text-muted;
                vertical-alignment: center;
                x: 10px;
                height: 100%;
            }
        }
    }
}

export component AppWindow inherits Window {
    // Chrome window mengikuti Settings (app-chrome): "native" =
    // chrome bawaan OS (decorations winit), lainnya frameless
    // (no-frame). Backend winit menerapkan perubahan no-frame saat
    // runtime (set_decorations di update_window_properties) — ganti
    // gaya chrome berlaku live tanpa restart (lihat §23).
    no-frame: root.app-chrome != "native";
    // Resizable (keputusan abeng 27 Nov 2026 16:54): window utama BOLEH
    // di-resize sampai compact/kecil — min-width 520 seperti C#
    // MainWindow.axaml (MinWidth="520", tanpa MinHeight). Ukuran awal
    // 960x640 di-set dari Rust (main.rs, setelah AppWindow::new) karena
    // Slint melarang width + min-width pada satu Window. Titlebar tetap
    // custom 28px (app-chrome). Tampilan yang hilang/terpotong di ukuran
    // sangat kecil itu wajar — user menyesuaikan sendiri.
    min-width: Design.window-min-width;
    title: "BMachine";
    background: Design.app-bg;
    default-font-family: Design.font-family;

    in-out property <string> current-tab: "HOME";
    in-out property <bool> show-flyout: false;
    in-out property <string> toast: "";

    // State Fase 5: Splash & Dialog Modal
    in-out property <string> app-stage: "splash";
    in-out property <int> splash-progress: 0;
    in-out property <string> splash-status: "Memuat...";
    in-out property <string> splash-version: "VERSION 15.15.3";
    in-out property <string> splash-log1: "";
    in-out property <string> splash-log2: "";
    in-out property <string> splash-log3: "";

    in-out property <string> dialog-open: ""; // "" | "EXIT" | "UPDATE"
    in-out property <string> update-latest-version: "v8.4.0";
    in-out property <string> update-size-text: "147 MB";
    in-out property <string> update-notes: "• Checklist Trello auto-refresh\n• Pembaruan skrip master & action";

    callback check-update();
    in-out property <string> trello-api-key: "";
    in-out property <string> trello-token: "";
    // Base URL server board (default API Trello asli — Trello kantor
    // diganti di Settings > Account; berlaku langsung tanpa restart).
    in-out property <string> trello-base-url: "https://api.trello.com/1";
    in-out property <string> google-sheet-id: "";

    in-out property <string> stat-editing: "0";
    in-out property <string> stat-revision: "0";
    in-out property <string> stat-late: "0";
    in-out property <string> stat-points: "0";

    // Baris sheet & leaderboard dari akun (Rust mengisi dari DB/Sheet).
    in-out property <[string]> sheet-rows: [];
    in-out property <int> sheet-row-count: 0;
    in-out property <[string]> sheet-col0: [];
    in-out property <[string]> sheet-col1: [];
    in-out property <[string]> sheet-col2: [];
    in-out property <[string]> lb-rows: [];
    in-out property <int> lb-row-count: 0;
    in-out property <[string]> lb-col0: [];
    in-out property <[string]> lb-col1: [];
    // Total poin leaderboard, dihitung Rust dari lb-rows (C#
    // FormattedTotalPoints) — bukan hardcode.
    in-out property <string> lb-total: "0";

    in-out property <string> editing-board-id: "";
    in-out property <string> editing-list-id: "";
    in-out property <string> revision-board-id: "";
    in-out property <string> revision-list-id: "";
    in-out property <string> late-board-id: "";
    in-out property <string> late-list-id: "";
    in-out property <string> qc-board-id: "";
    in-out property <string> acc-board-id: "";
    in-out property <string> acc-list-id: "";
    in-out property <string> google-creds-path: "credentials.json";
    in-out property <string> google-sheet-name: "Sheet1";
    in-out property <string> google-sheet-col: "B";
    in-out property <string> google-sheet-row: "12";
    in-out property <string> spreadsheet-sheet-name: "ALL DATA REGULER";
    in-out property <string> spreadsheet-range: "A1:Z";
    // Data grid spreadsheet DINAMIS (28 Nov 2026 — nested model,
    // kolom dari header sheet) + nilai asli + status guard/draft (Rust).
    // Default KOSONG (27 Nov 2026, keputusan abeng: default publish
    // harus bersih, tidak ada data contoh).
    in-out property <[[string]]> sheet-grid: [];
    in-out property <[[string]]> sheet-grid-orig: [];
    in-out property <[string]> sheet-col-headers: ["KODE", "SEKOLAH", "JENJANG", "STATUS", "POIN", "CATATAN", "TANGGAL"];
    in-out property <[string]> sheet-col-letters: ["A", "B", "C", "D", "E", "F", "G"];
    in-out property <[string]> sheet-col-kinds: ["text", "text", "dropdown", "dropdown", "number", "text", "date"];
    in-out property <[bool]> sheet-col-locked: [true, false, false, false, false, false, false];
    in-out property <[float]> sheet-col-widths: [110, 200, 80, 100, 90, 200, 100];
    in-out property <[float]> sheet-col-x-offsets: [0, 110, 310, 390, 490, 580, 780];
    in-out property <[[string]]> sheet-col-items: [[], [], ["TK", "PAUD", "SD", "SMP", "SMA", "SMK"], ["SELESAI", "PROSES", "REVISI", "ANTRIAN"], [], [], []];
    in-out property <int> sheet-key-col: 0;
    in-out property <int> sheet-page-start: 0;
    in-out property <int> sheet-page-size: 100;
    in-out property <int> sheet-total-rows: 0;
    in-out property <int> sheet-row-num-base: 1;
    in-out property <string> sheet-page-label: "";
    in-out property <bool> sheet-has-draft: false;
    in-out property <int> sheet-draft-count: 0;
    in-out property <string> sheet-status-text: "0 baris · Belum terhubung ke Google Sheets";
    in-out property <string> sheet-guard-result: "";
    // Seleksi multi-baris + kolom fokus (dibaca Rust saat fill-down /
    // clear-cells — diteruskan dari SheetsView).
    in-out property <[bool]> sheet-sel-rows: [];
    in-out property <int> sheet-focus-col: 1;
    in-out property <int> sheet-cal-year: 2026;
    in-out property <int> sheet-cal-month: 1;
    in-out property <string> sheet-cal-label: "";
    in-out property <[int]> sheet-cal-cells: [];
    in-out property <int> sheet-cal-today: 0;
    in-out property <int> sheet-cal-days-in-month: 31;
    in-out property <string> sheet-cal-today-iso: "";
    in-out property <int> sheet-cal-selected-day: 0;
    in-out property <string> lb-harian-range: "A2:C10";
    in-out property <string> lb-bulanan-range: "A2:C10";

    callback sheet-cell-edited(int, int, string, string);
    callback sheet-save();
    callback sheet-refresh();
    callback sheet-fill-down();
    callback sheet-clear-cells();
    callback sheet-auto-sum();
    callback sheet-cal-open(string);
    callback sheet-cal-nav(int);
    callback sheet-add-row();
    callback sheet-prev-page();
    callback sheet-next-page();
    callback sheet-hit-col(length) -> int;
    callback sheet-select-rows(int, int, int, int) -> [bool];
    callback sheet-is-typeahead-char(string) -> bool;

    callback save-account-settings();
    callback apply-appearance();
    callback reset-appearance();
    callback apply-theme-preset(string);
    callback save-user-theme(string);
    callback apply-user-theme(string);
    callback delete-user-theme(string);
    callback save-general-settings();
    callback save-paths-settings();
    callback save-explorer-settings();
    callback browse-path(string);
    callback test-trello();
    callback open-url(string);
    callback refresh-trello();
    callback apply-update();
    callback dismiss-update();
    callback confirm-exit();
    callback win-minimize();
    callback win-maximize();
    callback win-move(length, length);
    callback open-new-sheet-window();
    callback open-new-card-window(string);
    callback refresh-leaderboard();
    // Dynamic Bar (floating mini-bar): buka/tutup dari flyout profil.
    callback open-dynamic-bar();
    callback hide-dynamic-bar();
    // Notch hidup: pengaturan mode + voice (Settings > Notch).
    callback notch-settings-changed();
    callback test-notch-voice();
    // Radial: gaya ring + jumlah segmen (Settings > Script Manager).
    callback radial-settings-changed();
    // Toggle on/off: gaya toggle (Settings > Appearance).
    callback toggle-settings-changed();
    callback pet-active-changed(int);
    callback pet-install-requested(string);
    callback pet-remove-requested(int);
    callback pet-open-page(int);

    // ---- Appearance & Customization (persisted in SQLite) ----
    in-out property <string> app-color-mode: "dark";
    in-out property <string> app-theme-preset: "bmachine-dark";
    in-out property <color> app-accent-color: #3b82f6;
    in-out property <string> app-accent-hex: "#3b82f6";
    in-out property <string> app-accent-hex-good: "#3b82f6";
    in-out property <color> app-bg-color: #121212;
    in-out property <string> app-bg-hex: "#121212";
    in-out property <string> app-bg-hex-good: "#121212";
    in-out property <color> app-fg-color: #FFFFFF;
    in-out property <string> app-fg-hex: "#FFFFFF";
    in-out property <string> app-fg-hex-good: "#FFFFFF";
    // Warna 4 widget (C# `Settings.Color.*`) — satu palet dibaca
    // semua permukaan; diubah preset / bagian "Warna widget".
    in-out property <string> app-widget-editing-hex: "#3b82f6";
    in-out property <string> app-widget-editing-hex-good: "#3b82f6";
    in-out property <string> app-widget-revision-hex: "#f97316";
    in-out property <string> app-widget-revision-hex-good: "#f97316";
    in-out property <string> app-widget-late-hex: "#ef4444";
    in-out property <string> app-widget-late-hex-good: "#ef4444";
    in-out property <string> app-widget-points-hex: "#2dd4bf";
    in-out property <string> app-widget-points-hex-good: "#2dd4bf";
    // Tema user (picker "Tema saya") — array paralel, wholesale
    // replace (Slint tidak bisa append array).
    in-out property <[string]> user-theme-ids: [];
    in-out property <[string]> user-theme-names: [];
    in-out property <[color]> user-theme-accents: [];
    in-out property <[color]> user-theme-revisions: [];
    in-out property <[color]> user-theme-bgs: [];
    in-out property <[color]> user-theme-fgs: [];
    in-out property <string> new-user-theme-name: "";
    in-out property <string> app-font-choice: "Inter";
    in-out property <string> app-corner-style: "default";
    in-out property <string> app-nav-style: "capsule";
    in-out property <string> app-ui-density: "normal";
    in-out property <string> app-chrome: "custom";
    // Gaya tombol kontrol window ("icons" | "dots") + posisinya
    // ("right" | "left") — DB Settings.Chrome.ButtonStyle /
    // Settings.Chrome.ButtonPosition, berlaku live tanpa restart.
    in-out property <string> app-chrome-button-style: "icons";
    in-out property <string> app-chrome-button-position: "right";
    // Gaya toggle on/off ("classic" | "pill" | "outline") — DB
    // Settings.ToggleStyle, berlaku ke semua Toggle app-wide,
    // live tanpa restart (lihat DESIGN_SYSTEM.md §5.2).
    in-out property <string> app-toggle-style: "classic";
    // Turunan geometri chrome (dipakai titlebar, dashboard, overlay,
    // panel wrapped — supaya satu sumber kebenaran, bukan ternary
    // berulang di tiap elemen):
    // - has-titlebar: "custom" + "wrapped" punya titlebar kustom 28px.
    // - wrapped: konten duduk dalam panel rounded inset 8px.
    // - content-y: atas area konten (titlebar + margin panel).
    // - overlay-y: atas overlay layar penuh (Settings dkk. + 8px
    // supaya isinya tidak menempel tepi atas panel saat wrapped).
    // - content-bottom / overlay-bottom: margin bawah panel.
    property <bool> chrome-has-titlebar: app-chrome == "custom" || app-chrome == "wrapped";
    property <bool> chrome-wrapped: app-chrome == "wrapped";
    property <length> chrome-titlebar-h: chrome-has-titlebar ? 28px : 0px;
    property <length> chrome-content-y: chrome-titlebar-h + (chrome-wrapped ? 8px : 0px);
    property <length> chrome-content-bottom: chrome-wrapped ? 8px : 0px;
    property <length> chrome-overlay-y: chrome-wrapped ? 44px : (chrome-has-titlebar ? 32px : 8px);

    // ---- General & Paths (persisted in SQLite) ----
    // Dynamic Bar tampil atau tidak (key Settings.DynamicBar.Visible).
    in-out property <bool> app-dynamic-bar-visible: true;
    // Notch hidup (rework 27 Nov 2026): mode notch / avatar pet +
    // voice SAPI (Windows). Default notch, voice nyala, volume 80,
    // suara otomatis (Indonesia bila ada di sistem).
    in-out property <string> app-notch-mode: "notch";
    // Gaya mata maskot ("nusa" | "baymax" | "bulat") — DB
    // Settings.Notch.EyeStyle, berlaku live tanpa restart.
    in-out property <string> app-notch-eye-style: "nusa";
    // Radial: gaya ring ("glass" | "hud" | "flat", DB
    // Settings.Radial.Style) + jumlah segmen ring (2–8, DB
    // Settings.Radial.Segments) — berlaku live tanpa restart.
    in-out property <string> app-radial-style: "glass";
    in-out property <int> app-radial-segments: 8;
    in-out property <bool> app-notch-voice-enabled: true;
    in-out property <string> app-notch-voice-name: "";
    in-out property <string> app-notch-voice-volume: "80";
    in-out property <[string]> app-notch-voices: [];
    in-out property <[string]> app-notch-voice-names: [];
    in-out property <int> app-notch-voice-index: 0;
    // Pet PetDex (install/hapus dari galeri petdex.dev).
    in-out property <[string]> app-pet-names: [];
    in-out property <[string]> app-pet-authors: [];
    in-out property <[string]> app-pet-slugs: [];
    in-out property <[string]> app-pet-installed-names: [];
    in-out property <[string]> app-pet-installed-authors: [];
    in-out property <[string]> app-pet-installed-slugs: [];
    in-out property <int> app-pet-active-index: 0;
    in-out property <string> app-pet-install-input: "";
    in-out property <bool> app-pet-install-busy: false;
    in-out property <string> app-user-name: "USER";
    in-out property <string> app-user-initial: "U";
    in-out property <string> app-lang: "Indonesia";
    in-out property <bool> app-anim-startup: true;
    in-out property <string> app-anim-speed: "Normal";
    in-out property <string> app-trello-interval: "30";
    in-out property <bool> app-trello-connected: false;
    in-out property <string> app-trello-status: "Belum tersambung ke Trello.";

    in-out property <string> app-path-local: "";
    in-out property <string> app-path-okebase: "";
    in-out property <string> app-path-photoshop: "";
    in-out property <string> app-path-pasfoto: "";
    in-out property <string> app-path-manasik: "";
    in-out property <string> app-path-wisuda: "";
    in-out property <string> app-path-profesi: "";

    // Log Panel (sidebar kanan): lebar log-panel-width saat terbuka
    // (default 288px ≈ nilai nyata abeng 287.6 di DB; MinWidth 180
    // ala C#, di-clamp ke lebar window saat dibuka); konten utama
    // menyusut (content-width) supaya tidak tertutup panel. Dibuka
    // via saklar "Terminal" di flyout profil; ditutup via × di header
    // panel. BUKAN Ctrl+L. Lebar + state buka/tutup tersimpan ke DB
    // (Dashboard.LogPanelWidth / Dashboard.IsLogPanelOpen, C#).
    in-out property <bool> show-logpanel: false;
    in-out property <length> log-panel-width: 288px;
    // Simpan state buka/tutup ke DB (C# Dashboard.IsLogPanelOpen) —
    // watcher ini menangkap semua jalur toggle (flyout, × panel, Ctrl+L).
    changed show-logpanel => { root.save-logpanel-open(root.show-logpanel); }
    property <length> content-width: root.width - (root.show-logpanel ? root.log-panel-width + 6px : 0px);
    callback save-logpanel-width(length);
    callback save-logpanel-open(bool);

    // Fase 5: log panel live — baris konsol + status + progress,
    // diisi Rust dari ProcessLogService + watcher file progress/result.
    in-out property <[string]> log-lines: [];
    in-out property <string> log-status: "IDLE"; // "IDLE" | "RUNNING" | "DONE" | "ERROR"
    in-out property <int> log-progress: 0; // 0-100
    in-out property <string> log-progress-label: "Siap";
    callback clear-log();
    callback copy-log();
    callback stop-log();

    // Global radial shortcut watcher toggles this property; Rust membuka/
    // menutup window OS radial di cursor (bukan overlay). Satu-satunya
    // pemicu: hotkey global rdev (keputusan abeng 27 Nov 2026 16:54 —
    // orb nav + Shift+klik tengah dihapus).
    in-out property <bool> radial-open: false;
    // Jumlah tab dokumen untuk roda radial (diteruskan ke RadialMenuWindow
    // saat dibuka; dihitung dari log-panel.doc-tab).
    in-out property <int> radial-doc-tab-count: 1;
    // Sapaan flyout profil dari jam lokal (C# DashboardViewModel:
    // <12 GoodMorning, <15 GoodAfternoon, else GoodEvening) —
    // dihitung Rust (chrono::Local) saat startup.
    in-out property <string> greeting-text: "Selamat datang kembali";
    // Versi aplikasi untuk footer flyout (C# AppVersion =
    // assembly ToString(2) = "15.15").
    in-out property <string> app-version: "15.15";
    // Ada pembaruan tersedia (diisi Rust saat check-update) — item
    // "Ada pembaruan vX" muncul di flyout bila true.
    in-out property <bool> has-pending-update: false;
    // DASHBOARD VISIBILITY (C# Settings.Dash.*): tab BATCH
    // disembunyikan bila false; Folder Locker / Output Explorer
    // tidak punya padanan di port — hanya disimpan/dimuat.
    in-out property <bool> is-batch-visible: true;
    in-out property <bool> is-folder-locker-visible: true;
    in-out property <bool> is-output-explorer-visible: true;
    // FILTERS (C# Settings.Batch.Filter): filter ekstensi file
    // batch, "" = semua.
    in-out property <string> batch-file-filter: "";
    in-out property <bool> recording-shortcut: false;
    in-out property <string> current-shortcut-label: "Shift + Mouse Middle"; // default C# TriggerConfig (Mouse/Middle/Shift) — di-overwrite Rust saat startup
    callback start-recording-shortcut();
    callback cancel-recording-shortcut();
    // Radial / Toolbox / Laporkan Bug kini window OS (C#) — callback
    // Rust: buka/tutup window di cursor / tengah window utama.
    callback open-radial-at-cursor();
    callback close-radial-window();
    callback open-toolbox-window(string);
    callback open-report-bug();
    // Backup / restore database (Settings → General → DATA).
    callback export-database();
    callback import-database();
    // Pindah dari BATCH ke HOME bila tab BATCH disembunyikan.
    changed is-batch-visible => {
        if (!root.is-batch-visible && root.current-tab == "BATCH") { root.current-tab = "HOME"; }
    }

    // (restore-batch-source DIHAPUS 28 Nov 2026 — dataset contoh
    // sudah dikosongkan; pilih folder kini lewat batch-pick-folder()
    // → dialog folder beneran + scan disk di Rust.)

    // Overlay layar penuh (Settings/Toolbox/Sheets/Leaderboard/
    // Explorer/Trello-Window): "" = dashboard tampil (pill nav
    // terlihat); selain itu overlay tampil + pill nav disembunyikan
    // (seperti C#: MainWindow ContentControl beralih dari DashboardView).
    // Nilai: "" | "SETTINGS" | "SHEETS" | "LEADERBOARD" | "EXPLORER" | "TRELLO-WINDOW"
    // (TOOLBOX + RADIAL kini window OS, bukan overlay; SHEETS hanya
    // dipakai SheetsView — panah POINTS kini membuka window OS.)
    in-out property <string> overlay-view: "";
    // Esc / shortcut global (KeyBinding di keys-scope) hanya aktif bila
    // FocusScope itu memegang fokus — klik mouse tidak memberi fokus ke
    // elemen apa pun yang bisa difokus (Btn = TouchArea), jadi begitu
    // dashboard tersembunyi (overlay dibuka) atau flyout dibuka, fokus
    // hilang dan Esc / Ctrl+, mati (terverifikasi live 26 Nov: Esc tidak
    // menutup radial maupun flyout; tapi Esc menutup Sheets saat TextInput
    // sedang fokus). Perbaiki: tiap kali overlay / flyout berubah,
    // kembalikan fokus ke keys-scope supaya KeyBinding selalu hidup.
    // (Explorer aman: open-explorer memanggil focus-list() SETELAH
    // overlay-view diset, jadi fokus Explorer tetap menang.)
    changed overlay-view => {
        keys-scope.focus();
        // Window radial ikut tertutup bila overlay lain dibuka.
        root.radial-open = false;
    }
    changed show-flyout => { if (root.show-flyout) { keys-scope.focus(); } }
    // Tab Toolbox yang dibuka dari Radial Menu (submenu TOOLBOX) —
    // two-way dengan ToolboxView.tool-tab supaya radial bisa membuka
    // TOOLBOX langsung pada tab MantraNama / MantraGanda / PsdBucin.
    // Default "MantraNama" = tab pertama Toolbox.
    in-out property <string> toolbox-tab: "MantraNama";
    // Tab aktif Log Panel — Ctrl+L membukanya dengan tab EXPLORER.
    in-out property <string> logpanel-tab: "LOG";

    // Explorer (overlay "EXPLORER"): path awal + hasil search /
    // type-ahead dari Rust (lihat src/main.rs). start-path berubah ->
    // ExplorerView menavigasi (changed start-path di explorer.slint).
    in-out property <string> ex-start-path: "";
    in-out property <[string]> ex-sr-names: [];
    in-out property <[string]> ex-sr-kinds: [];
    in-out property <[string]> ex-sr-exts: [];
    in-out property <[string]> ex-sr-bases: [];
    in-out property <[string]> ex-sr-sizes: [];
    in-out property <[string]> ex-sr-dates: [];
    in-out property <[string]> ex-sr-previews: [];
    in-out property <[string]> ex-sr-locs: [];
    in-out property <[string]> ex-sr-paths: [];
    in-out property <int> ex-sr-half: 0;
    in-out property <bool> ex-sr-truncated: false;
    in-out property <int> ex-ta-index: -1;
    // Grup Settings yang dibuka dari Explorer (gear Quick Access).
    // Two-way supaya klik grup di dalam Settings tetap tersinkron.
    in-out property <string> settings-group: "General";
    // Callback Rust — diimplementasi di src/main.rs.
    callback ex-search(string, string);
    callback ex-typeahead(string, string);
    callback ex-add-txt-ext(string) -> string;
    callback ex-initials(string) -> string;
    callback ex-split-ext(string) -> string;
    callback ex-name-base(string) -> string;
    callback ex-is-typeahead-char(string) -> bool;

    // SETTING: gaya latar widget dashboard — nanti dipilih user di
    // Settings (fitur penuh: user bisa ganti background widgetnya
    // sendiri). Nilai: "doodle" | "dots" | "impulse" | "none".
    // Semua StatWidget membaca setting ini (bg: root.widget-bg),
    // jadi ganti satu tempat = ganti semua kartu. Default: "doodle".
    in-out property <string> widget-bg: "doodle";
    // SETTING: gaya permukaan kartu widget — dipilih user di Settings
    // → Appearance ("Gaya latar widget") dan didefinisikan tiap
    // preset tema (§22). Nilai: "solid" | "gradient" | "glass" |
    // "outline". Semua StatWidget membaca setting ini
    // (bg-style: root.widget-style). Default: "solid".
    in-out property <string> widget-style: "solid";

    // FASE 3 — Daftar kartu + detail (Trello).
    // list-category: "" = grid dashboard; "EDITING"/"REVISION"/
    // "LATE"/"POINTS" = daftar kategori itu.
    // selected-card: "" = tidak ada detail; berisi judul kartu.
    // list-titles/subs/due: tiga array sejajar (Slint tidak bisa
    // append — ganti seluruh array sekaligus saat kategori dipilih).
    // selected-index: index kartu yang dipilih (untuk ambil sub/due
    // di detail).
    in-out property <string> list-category: "";
    in-out property <string> selected-card: "";
    in-out property <int> selected-index: 0;
    // detail-panel: sub-panel detail Trello yang aktif — "" (detail),
    // "comments" / "checklist" / "move" / "attachments" (C#
    // CardDetailPanelHost: sub-panel menggantikan detail di kolom
    // yang sama). Direset ke "" tiap kali kartu dibuka/ditutup.
    in-out property <string> detail-panel: "";
    // detail-added-count: jumlah komentar tambahan (mockup, maks 3)
    // yang ditambahkan di panel Comments kartu yang sedang dibuka.
    // Direset ke 0 tiap kali kartu dibuka/ditutup.
    in-out property <int> detail-added-count: 0;
    // Lebar kolom detail Trello (C# UnifiedTrelloView: 400,
    // MinWidth 320, MaxWidth 650 — port: 400, clamp 320 saat sempit).
    property <length> trello-detail-w: root.content-width >= 726px ? 400px : 320px;
    // Kolom detail/add-manual sedang terbuka (daftar menyusut).
    property <bool> trello-panel-open: root.selected-card != "" || root.add-manual-open;
    // Lebar detail window Trello (panel 760×600, padding 16 → isi
    // 728 ≥ 726 = 400; saat window utama sempit, isi < 726 = 320).
    property <length> tw-detail-w: min(760px, root.width - 40px) - 32px >= 726px ? 400px : 320px;
    in-out property <[string]> list-titles: [];
    in-out property <[string]> list-subs: [];
    in-out property <[string]> list-due: [];

    // Window Trello (CardListWindow C#) — dibuka dari TANDA PANAH
    // widget EDITING/REVISION/LATE: "" = tidak ada window;
    // "EDITING"/"REVISION"/"LATE" = window kategori itu terbuka
    // (overlay-view "TRELLO-WINDOW"). Window TIDAK memakai
    // list-category (supaya menutup window kembali ke grid, bukan
    // ke daftar embedded) — judul/aksen dari properti ini.
    in-out property <string> trello-window-cat: "";

    // Data daftar Trello — SATU sumber (jangan duplikasi literal di
    // tiap handler). Dipakai handler klik badan widget, tab embedded,
    // dan panah window. Pola sama seperti kids-b-* (BATCH).
    // Default KOSONG (27 Nov 2026, keputusan abeng: default publish
    // harus bersih — kartu diisi Rust saat sync Trello pertama).
    in-out property <[string]> editing-titles: [];
    in-out property <[string]> editing-subs: [];
    in-out property <[string]> editing-due: [];
    in-out property <[string]> revision-titles: [];
    in-out property <[string]> revision-subs: [];
    in-out property <[string]> revision-due: [];
    in-out property <[string]> late-titles: [];
    in-out property <[string]> late-subs: [];
    in-out property <[string]> late-due: [];
    // ID numerik tiap kartu (prefix nama — C# CardDetailPanelHost
    // DisplayId; "" bila nama tanpa prefix numerik).
    in-out property <[string]> editing-ids: [];
    in-out property <[string]> revision-ids: [];
    in-out property <[string]> late-ids: [];
    // Link web tiap kartu dari API (`shortUrl`) — detail kartu
    // membukanya di browser; "" bila server tidak mengembalikannya.
    // Diisi Rust saat sync (sama seperti editing-ids); mockup di bawah
    // hanya untuk tampilan awal sebelum sync pertama.
    in-out property <[string]> editing-urls: [];
    in-out property <[string]> revision-urls: [];
    in-out property <[string]> late-urls: [];

    // Status checklist per kartu (C# TrelloCard.ChecklistStatusLabel:
    // DONE = checklist format nama user sudah diceklis, TODO = belum).
    // Badge ini penanda user apakah kartu sudah dikerjakan atau belum —
    // JANGAN dihilangkan. list-done dihitung dari kategori/window
    // aktif (satu sumber, tidak di-assign di handler).
    in-out property <[bool]> editing-done: [];
    in-out property <[bool]> revision-done: [];
    in-out property <[bool]> late-done: [];
    property <[bool]> list-done: root.trello-window-cat == "EDITING" ? root.editing-done : root.trello-window-cat == "REVISION" ? root.revision-done : root.trello-window-cat == "LATE" ? root.late-done : root.list-category == "EDITING" ? root.editing-done : root.list-category == "REVISION" ? root.revision-done : root.list-category == "LATE" ? root.late-done : [];
    // ID badge detail (sejajar list-done: window pakai trello-window-cat,
    // embedded pakai list-category).
    property <[string]> list-ids: root.trello-window-cat == "EDITING" ? root.editing-ids : root.trello-window-cat == "REVISION" ? root.revision-ids : root.trello-window-cat == "LATE" ? root.late-ids : root.list-category == "EDITING" ? root.editing-ids : root.list-category == "REVISION" ? root.revision-ids : root.list-category == "LATE" ? root.late-ids : [];
    // Link web kartu aktif (sejajar list-ids) — dipakai detail kartu
    // untuk tombol buka di browser (dari `shortUrl` API).
    property <[string]> list-urls: root.trello-window-cat == "EDITING" ? root.editing-urls : root.trello-window-cat == "REVISION" ? root.revision-urls : root.trello-window-cat == "LATE" ? root.late-urls : root.list-category == "EDITING" ? root.editing-urls : root.list-category == "REVISION" ? root.revision-urls : root.list-category == "LATE" ? root.late-urls : [];

    // Bar status Trello (C# UnifiedTrelloView Row 0 / Row 3):
    // dot status + "Dimuat N card" + tombol + (EDITING saja)
    // + refresh. Jumlah = kartu daftar aktif + kartu manual
    // (manual hanya ada di EDITING).
    in-out property <bool> add-manual-open: false;
    in-out property <string> manual-input: "";
    in-out property <bool> trello-refreshing: false;
    // Kartu manual EDITING (C# ManualCards.Editing): maks 5 slot
    // di mockup — nama diambil dari slug/ID link (nama asli dari
    // API Trello di Fase 6). Url tampil di bawah nama (C#
    // EditingCardListView: Url IsVisible=IsManual) — itu penanda
    // "status berbeda" kartu manual.
    in-out property <[string]> manual-titles: ["", "", "", "", ""];
    in-out property <[string]> manual-urls: ["", "", "", "", ""];
    in-out property <[bool]> manual-done: [false, false, false, false, false];
    in-out property <int> manual-count: 0;
    property <int> trello-count: root.list-titles.length + (root.list-category == "EDITING" ? root.manual-count : 0);
    // Kartu yang dipilih adalah kartu manual? Dihitung dari judul
    // (tidak perlu reset di tiap handler).
    property <int> selected-manual-index: root.selected-card != "" && root.selected-card == root.manual-titles[0] ? 0 : root.selected-card != "" && root.selected-card == root.manual-titles[1] ? 1 : root.selected-card != "" && root.selected-card == root.manual-titles[2] ? 2 : root.selected-card != "" && root.selected-card == root.manual-titles[3] ? 3 : root.selected-card != "" && root.selected-card == root.manual-titles[4] ? 4 : -1;
    property <bool> selected-is-manual: root.selected-manual-index >= 0;
    callback import-manual(string);
    callback remove-manual(int);

    // Warna aksen kategori yang sedang dibuka (due date & label).
    property <color> list-accent: root.list-category == "EDITING" ? Design.cat-editing : root.list-category == "REVISION" ? Design.cat-revision : root.list-category == "LATE" ? Design.cat-late : Design.cat-points;

    // Warna aksen window Trello (dari trello-window-cat, bukan
    // list-category — lihat komentar di properti itu).
    property <color> tw-accent: root.trello-window-cat == "EDITING" ? Design.cat-editing : root.trello-window-cat == "REVISION" ? Design.cat-revision : Design.cat-late;

    // Skala teks kartu: yang terbesar dari ui-scale (lebar window) dan
    // rasio tinggi baris grid terhadap baris desain (200px). Supaya di
    // window kecil yang tinggi (mis. 520x600) teks tidak ketinggalan
    // kecil sementara kartunya tinggi — teks harus mengisi kartu.
    property <float> card-scale: max(root.ui-scale, ((root.height - 68px * root.ui-scale - 42px) / 1px) / 400);

    // Data BATCH beneran (Rust, src/batch.rs) — model flat rows.
    // SOURCE/OUTPUT dirender sebagai DAFTAR DATAR (parallel arrays):
    // Rust meratakan tree terlihat (hormat expand) ke FlatRow; Slint
    // hanya menampilkan baris + indentasi dari depth. Menggantikan
    // array mock 4x4 (src-folders/kids-*) 28 Nov 2026.
    in-out property <[BatchRow]> src-rows: [];
    in-out property <[BatchRow]> out-rows: [];
    in-out property <string> src-name: "";
    in-out property <string> selected-output: "";
    in-out property <string> selected-master: "PAS FOTO";
    // Folder output belum ada di disk → chip "(pending)" oranye.
    in-out property <bool> batch-out-pending: true;
    // Dua fase master: Fase 1 (buat_master.py) membuat manifest;
    // Fase 2 (BUAT MASTER = buat_master_duplikat.py) BUTUH manifest.
    in-out property <bool> has-manifest: false;
    // Jumlah node terpilih (tampil di header SOURCE: "N dipilih").
    in-out property <int> batch-sel-count: 0;
    // Context menu BATCH (dibuka dari ⋯ / klik kanan; ditutup setelah
    // satu aksi dipilih atau klik di luar menu).
    in-out property <string> ctx-node: "";
    in-out property <string> ctx-node-id: "";
    in-out property <string> ctx-panel: "SOURCE";
    in-out property <bool> ctx-is-dir: false;
    in-out property <bool> ctx-is-root: false;
    // Input inline subfolder baru (C# CancelNewFolderInput di
    // BatchFolderRoot): newfolder-open false = tidak ada input.
    in-out property <bool> newfolder-open: false;
    in-out property <string> newfolder-panel: "";
    in-out property <string> newfolder-parent: "";
    in-out property <string> newfolder-name: "";
    // Folder Reguler (ala master_creator): dropdown direktori kerja
    // tersimpan + popup kelola (tabel bulan/marketing/sekolah).
    in-out property <[string]> batch-reguler-names: [];
    in-out property <int> batch-reguler-idx: -1;
    // Footer: tombol script dari scripts.json (atau default 5).
    in-out property <[string]> batch-scripts: ["buat_master", "manasik", "wisuda", "pasfoto", "profesi"];
    in-out property <bool> batch-running: false;
    // SOURCE kosong = belum ada folder (drop zone tampil);
    // OUTPUT kosong = tree output belum ada (teks "Output akan
    // muncul di sini." tampil).
    property <bool> src-empty: root.src-rows.length == 0;
    property <bool> out-empty: root.out-rows.length == 0;
    // Callbacks BATCH → Rust (src/batch.rs + src/batch_exec.rs).
    callback batch-pick-folder();
    callback batch-add-folder(string);
    callback batch-row-clicked(string, string);
    callback batch-row-right-down(string, string);
    callback batch-row-right-up(string, string);
    callback batch-toggle-expand(string, string);
    callback batch-open-ctx(string, string);
    callback batch-close-ctx();
    callback batch-ctx-new-subfolder();
    callback batch-ctx-replace-auto();
    callback batch-ctx-replace-manual();
    callback batch-ctx-copy-path();
    callback batch-ctx-copy-output-path();
    callback batch-ctx-delete();
    callback batch-confirm-new-folder();
    callback batch-cancel-new-folder();
    callback batch-run-script(string);
    callback batch-phase1();
    callback batch-copy-master();
    callback batch-replace-auto();
    callback batch-refresh();
    callback batch-clear();
    callback batch-reguler-picked(int);
    callback batch-reguler-manage();
    callback batch-open-task-manager();

    // Skala fluid: font & padding widget mengikuti ukuran window.
    // 1 = ukuran desain (grid 600x400); naik saat window membesar
    // (maks 1.8), tidak pernah turun di bawah 1 supaya tetap terbaca.
    property <float> scale-w: ((self.width - 40px) / 1px) / 600;
    property <float> scale-h: ((self.height - 98px) / 1px) / 400;
    property <float> ui-scale: max(1, min(min(scale-w, scale-h), 1.8));

    toast-timer := Timer {
        interval: 2500ms;
        running: root.toast != "";
        triggered => { root.toast = ""; }
    }

    // Refresh Trello (C# RefreshActiveListCommand): tombol ↻ di bar
    // status. Mockup: jeda 600ms lalu toast + hitung ulang.
    refresh-timer := Timer {
        interval: 600ms;
        running: root.trello-refreshing;
        triggered => {
            root.trello-refreshing = false;
            root.toast = "Trello di-refresh — " + root.trello-count + " card dimuat";
        }
    }

    // Shortcut global — KeyBinding di FocusScope pembungkus (keys-scope).
    // KeyBinding aktif bahkan saat fokus ada di TextField (key event
    // membubbling ke scope ini); forward-focus memberi fokus awal ke scope.
    // focus-on-click: false supaya klik tidak dimakan scope ini (klik
    // pertama ke tombol harus tetap sampai ke tombol).
    // Ctrl+L = buka Log Panel tab EXPLORER (arahan abeng 26 Nov 16:22 —
    // MENGALAHKAN bacaan kode lama yang bilang Ctrl+L = Focus Address Bar;
    // selisih ini dicatat di DESIGN_SYSTEM.md §10.7).
    // Ctrl+, = Settings. Esc = tutup overlay / flyout.
    forward-focus: keys-scope;
    keys-scope := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        KeyBinding {
            keys: @keys(Control + L);
            activated => {
                root.overlay-view = "";
                root.show-logpanel = true;
                root.logpanel-tab = "EXPLORER";
                root.show-flyout = false;
            }
        }
        KeyBinding {
            keys: @keys(Control + Comma);
            activated => {
                root.overlay-view = "SETTINGS";
                root.show-flyout = false;
            }
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if (root.dialog-open != "") {
                    root.dialog-open = "";
                } else if (root.overlay-view == "EXPLORER") {
                    // Prioritas Esc Explorer: dialog → tab-ctx → ctx →
                    // rename → addr-edit → search → buffer type-ahead →
                    // tutup overlay (esc-pressed di explorer.slint).
                    explorer-view.esc-pressed();
                } else if (root.overlay-view == "SETTINGS") {
                    // Esc TIDAK menutup Settings (C#: Esc tidak berbuat
                    // apa-apa di Settings; kembali hanya via klik kanan
                    // NavigateBack — settings-back-touch di settings.slint).
                    // Sengaja kosong.
                } else if (root.overlay-view != "") {
                    if (root.overlay-view == "TRELLO-WINDOW") {
                        if (root.detail-panel != "") {
                            // Esc di sub-panel detail window = kembali ke detail.
                            root.detail-panel = "";
                        } else {
                            root.trello-window-cat = "";
                            root.selected-card = "";
                            root.detail-added-count = 0;
                            root.overlay-view = "";
                        }
                    } else {
                        root.overlay-view = "";
                    }
                } else if (root.selected-card != "") {
                    // Esc di detail Trello: sub-panel → detail, detail → daftar.
                    if (root.detail-panel != "") {
                        root.detail-panel = "";
                    } else {
                        root.selected-card = "";
                        root.detail-added-count = 0;
                    }
                } else if (root.show-flyout) {
                    root.show-flyout = false;
                }
            }
        }

    // Global radial shortcut watcher toggles this property; Rust membuka/
    // menutup window OS radial di cursor (bukan overlay). Satu-satunya
    // pemicu: hotkey global rdev (keputusan abeng 27 Nov 2026 16:54 —
    // orb nav + Shift+klik tengah dihapus).
    Rectangle {
        x: 0; y: 0; width: 0; height: 0;
        property <bool> radial-open-watcher: root.radial-open;
        changed radial-open-watcher => {
            if (root.radial-open) {
                root.radial-doc-tab-count = log-panel.doc-tab == "2" ? 2 : 1;
                root.show-flyout = false;
                root.open-radial-at-cursor();
            } else {
                root.close-radial-window();
            }
        }
    }

    // Panel "wrapped" (gaya chrome wrapped, §23): isi window duduk
    // dalam panel rounded inset 8px di dalam frame. Digambar di
    // belakang konten (sibling sebelum dashboard/overlay) — konten
    // TIDAK jadi anak panel (supaya geometri overlay yang sudah ada
    // tidak berubah), panel hanya latar di belakangnya. Saat Settings
    // terbuka, panel mulai setelah sidebar (x=208: padding 20 +
    // sidebar 180 + gap 8) supaya sidebar duduk di area frame dan
    // konten Settings = panel itu sendiri — bukan panel kedua
    // ("bungkus di dalam bungkus" dilarang abeng 27 Nov 22:03).
    if root.chrome-wrapped && root.app-stage == "main" : Rectangle {
        x: root.overlay-view == "SETTINGS" ? 208px : 8px;
        y: root.chrome-content-y;
        width: root.width - self.x - 8px;
        height: root.height - root.chrome-content-y - root.chrome-content-bottom;
        background: Design.surface-elevated;
        border-color: Design.separator;
        border-width: 1px;
        border-radius: 12px;
    }

    // Dashboard (pill nav + konten) — disembunyikan saat overlay
    // layar penuh terbuka (overlay-view != "").
    VerticalLayout {
        x: root.chrome-wrapped ? 8px : 0px;
        y: root.chrome-content-y;
        width: root.width - (root.chrome-wrapped ? 16px : 0px);
        height: root.height - root.chrome-content-y - root.chrome-content-bottom;
        visible: root.overlay-view == "";
        spacing: 0;

        // Nav rata tengah (abeng 27 Nov 20:04 — koreksi: kelompok di
        // kiri itu "aneh"): avatar → gap 12px → kapsul HOME/BATCH
        // TETAP berdekatan, tapi KESELURUHAN kelompok dipusatkan di bar
        // atas — spacer stretch di depan DAN di belakang kelompok.
        // Sejajar vertikal (aturan abeng 20:19 — satu garis tengah):
        // avatar dibuat 44px*scale, SAMA dengan kapsul (dulu 40px —
        // top-aligned di slot 44*scale sehingga tengahnya naik ~3px,
        // terukur pixel). Keduanya kini mengisi slot persis → tengah
        // avatar = tengah kapsul.
        HorizontalLayout {
            height: 68px * root.ui-scale;
            padding-left: 20px * root.ui-scale;
            padding-right: 20px * root.ui-scale;
            padding-top: Design.space-md * root.ui-scale;
            padding-bottom: Design.space-md * root.ui-scale;

            // Spacer depan (20:04): bersama spacer belakang, kelompok
            // avatar+gap+kapsul terpusat di bar atas. Padding kiri/kanan
            // simetris (20px) sehingga tengah kelompok = tengah jendela.
            Rectangle { horizontal-stretch: 1; }

            avatar-btn := Rectangle {
                width: 44px * root.ui-scale;
                height: 44px * root.ui-scale;
                background: root.show-flyout ? Design.bg-hover : Design.card-bg;
                border-color: Design.separator;
                border-width: 1px;
                border-radius: 22px * root.ui-scale;
                account-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show-flyout = !root.show-flyout; }
                }
                SvgIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: "user";
                    size: 18px * root.ui-scale;
                    icon-color: root.show-flyout ? Design.accent : Design.text-secondary;
                }
            }

            Rectangle { width: Design.nav-gap * root.ui-scale; }

            // Kapsul langsung setelah avatar + gap (20:04: spacer
            // stretch kini ADA di depan avatar — kelompok avatar+gap+
            // kapsul terpusat di bar atas; spacer belakang menyeimbangi).
            Rectangle {
                width: pill-content.preferred-width;
                height: 44px * root.ui-scale;
                background: Design.nav-pill-bg;
                border-color: Design.nav-pill-border;
                border-width: 1px;
                border-radius: Design.nav-pill-radius;

                // Pill terpilih HARUS terpusat vertikal di kapsul (bug
                // 27 Nov 19:03, terukur: pill putih tengah y=79 vs
                // kapsul tengah y=75 — 4px di bawah, mentok bawah).
                // Akar: NavTab 40*scale, tapi padding vertikal 6px
                // menyisakan slot 32*scale — NavTab lebih tinggi dari
                // slot dan ditempel Slint ke ATAS slot. Padding
                // vertikal 2px → slot 40*scale = tinggi NavTab.
                // Padding horizontal tetap 6px (lebar pill tak berubah).
                pill-content := HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 6px * root.ui-scale;
                    padding-right: 6px * root.ui-scale;
                    padding-top: 2px * root.ui-scale;
                    padding-bottom: 2px * root.ui-scale;
                    spacing: 6px * root.ui-scale;
                    alignment: center;

                    NavTab {
                        label: "HOME";
                        icon: "home";
                        selected: root.current-tab == "HOME";
                        scale: root.ui-scale;
                        clicked => { root.current-tab = "HOME"; root.show-flyout = false; root.list-category = ""; root.selected-card = ""; root.add-manual-open = false; root.detail-panel = ""; root.detail-added-count = 0; }
                    }
                    if root.is-batch-visible : NavTab {
                        label: "BATCH";
                        selected: root.current-tab == "BATCH";
                        scale: root.ui-scale;
                        icon: "layers";
                        clicked => { root.current-tab = "BATCH"; root.show-flyout = false; root.list-category = ""; root.selected-card = ""; root.add-manual-open = false; root.detail-panel = ""; root.detail-added-count = 0; }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // Orb radial DIHAPUS (keputusan abeng 27 Nov 2026 16:54):
            // pemicu radial yang tersisa hanya hotkey global (rdev).
        }

        // ===== Area konten + Log Panel: HorizontalLayout — konten
        // (lebar content-width, menyusut saat Log Panel terbuka) +
        // handle resize 6px + Log Panel (log-panel-width saat terbuka,
        // 0px saat tertutup).
        // Konten-konten menumpuk di dalam Rectangle (posisi absolut,
        // masing-masing 100% x 100%, hanya yang aktif yang visible —
        // jadi tidak saling makan ruang). =====
        HorizontalLayout {
            vertical-stretch: 1;

            Rectangle {
                width: root.content-width;
                // Tinggi eksplisit (window − nav), BUKAN height: 100%:
                // rantai persentase di sini pernah membuat tinggi konten
                // jatuh ke preferred-height (~1080px) dan mendorong isi
                // Settings ke bawah (layout gap, 26 Nov).
                height: root.height - 68px * root.ui-scale;

            // Shift + middle click di latar dashboard DIHAPUS (keputusan
            // abeng 27 Nov 2026 16:54). Pemicu radial yang tersisa hanya
            // hotkey global (rdev) — default sama seperti C#
            // (TriggerConfig: Mouse / Middle / Shift).

            // ----- HOME: grid 2x2 StatWidget mengisi window -----
            // Hanya tampil saat tidak ada daftar kategori yang dibuka.
            VerticalLayout {
                x: 0; y: 0;
                width: 100%; height: 100%;
                visible: root.current-tab == "HOME" && root.list-category == "";
                padding-left: Design.space-xl;
                padding-right: Design.space-xl;
                padding-bottom: 24px;
                spacing: Design.space-md;

                HorizontalLayout {
                    spacing: Design.space-md;
                    height: min((root.height - 68px * root.ui-scale - 42px) / 2, 240px);
                    StatWidget {
                        width: (root.content-width - 52px) / 2;
                        label: "EDITING"; value: root.stat-editing; suffix: "CARD";
                        accent: Design.cat-editing;
                        bg: root.widget-bg;
                        bg-style: root.widget-style;
                        scale: root.card-scale;
                        clicked => {
                            root.list-titles = root.editing-titles;
                            root.list-subs = root.editing-subs;
                            root.list-due = root.editing-due;
                            root.selected-card = "";
                            root.list-category = "EDITING";
                            root.toast = "Daftar EDITING — " + root.stat-editing + " kartu";
                        }
                        arrow-clicked => {
                            root.list-titles = root.editing-titles;
                            root.list-subs = root.editing-subs;
                            root.list-due = root.editing-due;
                            root.selected-card = "";
                            root.trello-window-cat = "EDITING";
                            root.open-new-card-window("EDITING");
                            root.toast = "Membuka Window Trello EDITING";
                        }
                    }
                    StatWidget {
                        width: (root.content-width - 52px) / 2;
                        label: "REVISION"; value: root.stat-revision; suffix: "CARD";
                        accent: Design.cat-revision;
                        bg: root.widget-bg;
                        bg-style: root.widget-style;
                        scale: root.card-scale;
                        clicked => {
                            root.list-titles = root.revision-titles;
                            root.list-subs = root.revision-subs;
                            root.list-due = root.revision-due;
                            root.selected-card = "";
                            root.list-category = "REVISION";
                            root.toast = "Daftar REVISION — " + root.stat-revision + " kartu";
                        }
                        arrow-clicked => {
                            root.list-titles = root.revision-titles;
                            root.list-subs = root.revision-subs;
                            root.list-due = root.revision-due;
                            root.selected-card = "";
                            root.trello-window-cat = "REVISION";
                            root.open-new-card-window("REVISION");
                            root.toast = "Membuka Window Trello REVISI";
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Design.space-md;
                    height: min((root.height - 68px * root.ui-scale - 42px) / 2, 240px);
                    StatWidget {
                        width: (root.content-width - 52px) / 2;
                        label: "LATE"; value: root.stat-late; suffix: "CARD";
                        accent: Design.cat-late;
                        bg: root.widget-bg;
                        bg-style: root.widget-style;
                        scale: root.card-scale;
                        clicked => {
                            root.list-titles = root.late-titles;
                            root.list-subs = root.late-subs;
                            root.list-due = root.late-due;
                            root.selected-card = "";
                            root.list-category = "LATE";
                            root.toast = "Daftar LATE — " + root.stat-late + " kartu";
                        }
                        arrow-clicked => {
                            root.list-titles = root.late-titles;
                            root.list-subs = root.late-subs;
                            root.list-due = root.late-due;
                            root.selected-card = "";
                            root.trello-window-cat = "LATE";
                            root.open-new-card-window("LATE");
                            root.toast = "Membuka Window Trello SUSULAN";
                        }
                    }
                    StatWidget {
                        width: (root.content-width - 52px) / 2;
                        label: "POINTS"; value: root.stat-points; suffix: "POIN";
                        accent: Design.cat-points;
                        bg: root.widget-bg;
                        bg-style: root.widget-style;
                        scale: root.card-scale;
                        clicked => {
                            root.list-category = "";
                            root.selected-card = "";
                            root.overlay-view = "LEADERBOARD";
                            root.toast = "Leaderboard — poin editor";
                        }
                        arrow-clicked => {
                            root.list-category = "";
                            root.selected-card = "";
                            root.open-new-sheet-window();
                            root.toast = "Spreadsheet BMachine";
                        }
                    }
                }
            }

            // ----- Daftar kartu (FASE 3): tampil saat kategori dipilih -----
            // Menggantikan grid HOME. Header: kembali + judul + jumlah.
            // Baris 48 px (C# EditingCardListView): checkbox + nama
            // kartu + badge checklist TODO/DONE di kanan. Klik baris ->
            // buka detail kartu; klik checkbox = seleksi kartu.
            // Klik kanan = kembali ke dashboard (C# DashboardView:
            // OnEmbeddedViewPointerPressed → NavigateBack). TouchArea
            // latar (di belakang isi) menangkap klik kanan di area kosong;
            // klik kanan di baris ditangani list-touch di bawah.
            Rectangle {
                x: 0; y: 0;
                width: root.trello-panel-open ? parent.width - root.trello-detail-w - 6px : parent.width; height: 100%;
                // Daftar TETAP tampil (menyempit) saat detail maupun
                // Add Manual terbuka di kolom kanan — sama seperti C#.
                visible: root.current-tab == "HOME" && root.list-category != "";
                list-back-touch := TouchArea {
                    width: 100%; height: 100%;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                            root.list-category = "";
                            root.selected-card = "";
                            root.toast = "Kembali ke dashboard (klik kanan)";
                        }
                    }
                }
            VerticalLayout {
                x: 0; y: 0;
                width: 100%; height: 100%;
                padding-left: Design.space-xl;
                padding-right: Design.space-xl;
                padding-bottom: 30px;
                spacing: Design.space-md;

                // Header.
                HorizontalLayout {
                    height: 36px * root.ui-scale;
                    spacing: 8px * root.ui-scale;
                    Text {
                        text: root.list-category == "REVISION" ? "REVISI" : root.list-category == "LATE" ? "SUSULAN" : root.list-category;
                        font-size: Design.font-h2 * root.ui-scale;
                        font-weight: 800;
                        color: Design.text-primary;
                        letter-spacing: 1px * root.ui-scale;
                        vertical-alignment: center;
                    }
                }

                // Bar status Trello (C# UnifiedTrelloView: dot status
                // + StatusMessage "Dimuat N card" + toolbar +/refresh).
                // Tombol + HANYA di EDITING (Add Manual Cards).
                // Di screenshot abeng 26 Nov 19:25 bar ini ada di ATAS
                // tab (di C# embedded aslinya bar ini ada di bawah —
                // Row 3 — tapi yang ditandai abeng adalah yang di atas).
                Rectangle {
                    background: Design.card-bg;
                    border-color: Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-md;
                    HorizontalLayout {
                        height: 36px * root.ui-scale;
                        padding-left: 12px * root.ui-scale;
                        padding-right: 12px * root.ui-scale;
                        spacing: 8px * root.ui-scale;
                        Text {
                            text: "●";
                            font-size: 10px * root.ui-scale;
                            color: Design.done-text;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.trello-refreshing ? "Memuat ulang…" : "Dimuat " + root.trello-count + " card";
                            font-size: 12px * root.ui-scale;
                            font-weight: 500;
                            color: Design.text-secondary;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        // Wadah tombol + (EDITING saja): lebar 0 saat
                        // tersembunyi supaya tidak makan ruang (Slint:
                        // visible:false saja tetap makan ruang layout).
                        Rectangle {
                            width: root.list-category == "EDITING" ? 28px * root.ui-scale : 0px;
                            height: 36px * root.ui-scale;
                            clip: true;
                            IconBtn {
                                x: 0px;
                                y: (parent.height - 28px * root.ui-scale) / 2;
                                glyph: "+";
                                variant: "ghost";
                                size: 28px;
                                scale: root.ui-scale;
                                visible: root.list-category == "EDITING";
                                clicked => { root.add-manual-open = true; root.manual-input = ""; root.selected-card = ""; root.detail-panel = ""; root.detail-added-count = 0; }
                            }
                        }
                        // Wadah tombol refresh (tengah vertikal — anak
                        // layout berukuran eksplisit menempel ke atas).
                        Rectangle {
                            width: 28px * root.ui-scale;
                            height: 36px * root.ui-scale;
                            IconBtn {
                                x: 0px;
                                y: (parent.height - 28px * root.ui-scale) / 2;
                                glyph: "↻";
                                variant: "ghost";
                                size: 28px;
                                scale: root.ui-scale;
                                opacity: root.trello-refreshing ? 0.4 : 1.0;
                                clicked => {
                                    if (!root.trello-refreshing) {
                                        root.trello-refreshing = true;
                                        root.refresh-trello();
                                    }
                                }
                            }
                        }
                    }
                }

                // Tab Trello (UnifiedTrelloView C#: EDITING / REVISI /
                // SUSULAN). Klik tab = ganti daftar (isi ulang array
                // dari data tunggal); tab aktif = kategori kini.
                HorizontalLayout {
                    height: 32px * root.ui-scale;
                    spacing: 2px * root.ui-scale;
                    NavTab {
                        label: "EDITING";
                        scale: root.ui-scale;
                        selected: root.list-category == "EDITING";
                        clicked => {
                            root.list-titles = root.editing-titles;
                            root.list-subs = root.editing-subs;
                            root.list-due = root.editing-due;
                            root.selected-card = "";
                            root.list-category = "EDITING";
                            root.toast = "Daftar EDITING — 6 kartu";
                        }
                    }
                    NavTab {
                        label: "REVISI";
                        scale: root.ui-scale;
                        selected: root.list-category == "REVISION";
                        clicked => {
                            root.list-titles = root.revision-titles;
                            root.list-subs = root.revision-subs;
                            root.list-due = root.revision-due;
                            root.selected-card = "";
                            root.list-category = "REVISION";
                            root.toast = "Daftar REVISI — 5 kartu";
                        }
                    }
                    NavTab {
                        label: "SUSULAN";
                        scale: root.ui-scale;
                        selected: root.list-category == "LATE";
                        clicked => {
                            root.list-titles = root.late-titles;
                            root.list-subs = root.late-subs;
                            root.list-due = root.late-due;
                            root.selected-card = "";
                            root.list-category = "LATE";
                            root.toast = "Daftar SUSULAN — 3 kartu";
                        }
                    }
                }

                // Daftar baris kartu (di-scroll via Flickable — C#:
                // daftar Trello ada di ScrollViewer; isi bisa lebih
                // panjang dari Card saat kartu manual ditambahkan).
                list-card := Card {
                    vertical-stretch: 1;
                    Flickable {
                        x: 0; y: 0; width: 100%; height: 100%;
                        VerticalLayout {
                            x: 0; width: list-card.width;
                            padding: Design.space-md;
                            spacing: 4px * root.ui-scale;

                        for t[index] in root.list-titles:
                            Rectangle {
                                height: 48px * root.ui-scale;
                                background: list-touch.has-hover ? Design.bg-hover : transparent;
                                border-radius: Design.radius-sm;
                                list-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.selected-card = t;
                                        root.selected-index = index;
                                        root.detail-panel = "";
                                        root.detail-added-count = 0;
                                        root.toast = "Membuka: " + t;
                                    }
                                    // Klik kanan di baris = kembali ke dashboard
                                    // (C# CardListWindow: double klik kanan = Close;
                                    // di port ini satu klik kanan sudah kembali —
                                    // klik kedua dalam 500ms mendarat di dashboard).
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                            root.list-category = "";
                                            root.selected-card = "";
                                            root.toast = "Kembali ke dashboard (klik kanan)";
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 10px * root.ui-scale;
                                    padding-right: 10px * root.ui-scale;
                                    spacing: 10px * root.ui-scale;

                                    // Checkbox seleksi (C# CheckBox kiri kartu).
                                    // Wadah setinggi baris; kotak 16px di tengah.
                                    check-wrap := Rectangle {
                                        property <bool> checked: false;
                                        width: 16px * root.ui-scale;
                                        height: 48px * root.ui-scale;
                                        check-box := Rectangle {
                                            width: 16px * root.ui-scale;
                                            height: 16px * root.ui-scale;
                                            x: 0px;
                                            y: (parent.height - 16px * root.ui-scale) / 2;
                                            background: check-wrap.checked ? root.list-accent : transparent;
                                            border-color: check-wrap.checked ? root.list-accent : Design.border-hover;
                                            border-width: 1px;
                                            border-radius: 4px * root.ui-scale;
                                            Text {
                                                width: 100%;
                                                height: 100%;
                                                text: "✓";
                                                font-size: 11px * root.ui-scale;
                                                font-weight: 700;
                                                color: white;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                visible: check-wrap.checked;
                                            }
                                        }
                                        check-touch := TouchArea {
                                            x: 0px;
                                            y: (parent.height - 16px * root.ui-scale) / 2;
                                            width: 16px * root.ui-scale;
                                            height: 16px * root.ui-scale;
                                            mouse-cursor: pointer;
                                            clicked => { check-wrap.checked = !check-wrap.checked; }
                                        }
                                    }

                                    // Nama kartu — prioritas utama (C#: Name 13 SemiBold).
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text {
                                            text: t;
                                            font-size: 13px * root.ui-scale;
                                            font-weight: 700;
                                            color: Design.text-primary;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                    }

                                    // Badge checklist TODO/DONE (C# ChecklistStatusLabel).
                                    // Warna persis BoolToColorConverter C#.
                                    badge-wrap := Rectangle {
                                        width: 62px * root.ui-scale;
                                        height: 48px * root.ui-scale;
                                        badge := Rectangle {
                                            width: 62px * root.ui-scale;
                                            height: 22px * root.ui-scale;
                                            x: 0px;
                                            y: (parent.height - 22px * root.ui-scale) / 2;
                                            background: root.list-done[index] ? Design.done-row-bg : transparent;
                                            border-color: root.list-done[index] ? Design.done-row-border : Design.row-border-idle;
                                            border-width: 1px;
                                            border-radius: 999px;
                                            HorizontalLayout {
                                                x: 0px;
                                                y: (parent.height - 9px * root.ui-scale) / 2;
                                                width: 100%;
                                                height: 9px * root.ui-scale;
                                                spacing: 4px * root.ui-scale;
                                                alignment: center;
                                                Text {
                                                    text: "●";
                                                    font-size: 9px * root.ui-scale;
                                                    color: root.list-done[index] ? Design.done-text : Design.row-text-dim;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: root.list-done[index] ? "DONE" : "TODO";
                                                    font-size: 9px * root.ui-scale;
                                                    font-weight: 700;
                                                    letter-spacing: 1px * root.ui-scale;
                                                    color: root.list-done[index] ? Design.done-text-alt : Design.row-text-alt;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        // Baris kartu manual (EDITING saja) — nama +
                        // Url di bawah nama (C# EditingCardListView:
                        // Url IsVisible=IsManual). Maks 5 slot; tinggi
                        // 0 + clip saat slot kosong (pola tree BATCH).
                        for mi in 5:
                            Rectangle {
                                height: root.list-category == "EDITING" && mi < root.manual-count ? 64px * root.ui-scale : 0px;
                                visible: root.list-category == "EDITING" && mi < root.manual-count;
                                clip: true;
                                background: m-list-touch.has-hover ? Design.bg-hover : transparent;
                                border-radius: Design.radius-sm;
                                m-list-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.selected-card = root.manual-titles[mi];
                                        root.selected-index = 0;
                                        root.detail-panel = "";
                                        root.detail-added-count = 0;
                                        root.toast = "Membuka: " + root.manual-titles[mi];
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                            root.list-category = "";
                                            root.selected-card = "";
                                            root.toast = "Kembali ke dashboard (klik kanan)";
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 10px * root.ui-scale;
                                    padding-right: 10px * root.ui-scale;
                                    spacing: 10px * root.ui-scale;

                                    // Checkbox seleksi (kotak 16px di tengah baris 64px).
                                    m-check-wrap := Rectangle {
                                        property <bool> checked: false;
                                        width: 16px * root.ui-scale;
                                        height: 64px * root.ui-scale;
                                        m-check-box := Rectangle {
                                            width: 16px * root.ui-scale;
                                            height: 16px * root.ui-scale;
                                            x: 0px;
                                            y: (parent.height - 16px * root.ui-scale) / 2;
                                            background: m-check-wrap.checked ? root.list-accent : transparent;
                                            border-color: m-check-wrap.checked ? root.list-accent : Design.border-hover;
                                            border-width: 1px;
                                            border-radius: 4px * root.ui-scale;
                                            Text {
                                                width: 100%;
                                                height: 100%;
                                                text: "✓";
                                                font-size: 11px * root.ui-scale;
                                                font-weight: 700;
                                                color: white;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                visible: m-check-wrap.checked;
                                            }
                                        }
                                        m-check-touch := TouchArea {
                                            x: 0px;
                                            y: (parent.height - 16px * root.ui-scale) / 2;
                                            width: 16px * root.ui-scale;
                                            height: 16px * root.ui-scale;
                                            mouse-cursor: pointer;
                                            clicked => { m-check-wrap.checked = !m-check-wrap.checked; }
                                        }
                                    }

                                    // Nama + Url (penanda kartu manual).
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text {
                                            text: root.manual-titles[mi];
                                            font-size: 13px * root.ui-scale;
                                            font-weight: 700;
                                            color: Design.text-primary;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.manual-urls[mi];
                                            font-size: 11px * root.ui-scale;
                                            color: Design.text-muted;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                    }

                                    // Badge checklist TODO/DONE.
                                    m-badge-wrap := Rectangle {
                                        width: 62px * root.ui-scale;
                                        height: 64px * root.ui-scale;
                                        m-badge := Rectangle {
                                            width: 62px * root.ui-scale;
                                            height: 22px * root.ui-scale;
                                            x: 0px;
                                            y: (parent.height - 22px * root.ui-scale) / 2;
                                            background: root.manual-done[mi] ? Design.done-row-bg : transparent;
                                            border-color: root.manual-done[mi] ? Design.done-row-border : Design.row-border-idle;
                                            border-width: 1px;
                                            border-radius: 999px;
                                            HorizontalLayout {
                                                x: 0px;
                                                y: (parent.height - 9px * root.ui-scale) / 2;
                                                width: 100%;
                                                height: 9px * root.ui-scale;
                                                spacing: 4px * root.ui-scale;
                                                alignment: center;
                                                Text {
                                                    text: "●";
                                                    font-size: 9px * root.ui-scale;
                                                    color: root.manual-done[mi] ? Design.done-text : Design.row-text-dim;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: root.manual-done[mi] ? "DONE" : "TODO";
                                                    font-size: 9px * root.ui-scale;
                                                    font-weight: 700;
                                                    letter-spacing: 1px * root.ui-scale;
                                                    color: root.manual-done[mi] ? Design.done-text-alt : Design.row-text-alt;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                    }
                    }
                }
            }
            }

            // ----- Detail kartu (FASE 3): panel di kolom kanan -----
            // C# UnifiedTrelloView: GridSplitter 6px + kolom kanan 400
            // (MinWidth 320, MaxWidth 650); daftar menyusut, detail
            // tampil berdampingan — bukan menggantikan daftar.
            // CardDetailPanelHost: klik kanan detail = tutup,
            // klik kanan sub-panel = kembali ke detail, × = tutup.
            // Double klik kanan = kembali ke dashboard: klik pertama
            // detail→daftar, klik kedua (di daftar) daftar→dashboard.
            Rectangle {
                x: parent.width - root.trello-detail-w; y: 0;
                width: root.trello-detail-w; height: 100%;
                visible: root.current-tab == "HOME" && root.selected-card != "";
                TrelloDetailPanel {
                    x: 0; y: 0; width: 100%; height: 100%;
                    card-title: root.selected-card;
                    event-date: root.selected-is-manual ? "—" : root.list-due[root.selected-index];
                    display-id: root.selected-is-manual ? "" : root.list-ids[root.selected-index];
                    due-text: root.selected-is-manual ? "" : "Due: " + root.list-due[root.selected-index];
                    is-manual: root.selected-is-manual;
                    manual-url: root.selected-is-manual ? root.manual-urls[root.selected-manual-index] : "";
                    card-url-override: root.selected-is-manual ? "" : root.list-urls[root.selected-index];
                    category-label: root.list-category == "REVISION" ? "REVISI" : root.list-category == "LATE" ? "SUSULAN" : root.list-category;
                    accent: root.list-accent;
                    done: root.selected-is-manual ? root.manual-done[root.selected-manual-index] : root.list-done[root.selected-index];
                    description: "Edit pas foto sekolah — crop, centering kepala di guide, logo terlihat.";
                    sub-panel: root.detail-panel;
                    added-count: root.detail-added-count;
                    user-name: root.app-user-name;
                    user-initial: root.app-user-initial;
                    close => { root.selected-card = ""; root.detail-panel = ""; root.detail-added-count = 0; }
                    unlink => { root.remove-manual(root.selected-manual-index); root.selected-card = ""; root.detail-panel = ""; root.detail-added-count = 0; }
                    show-toast(text) => { root.toast = text; }
                    open-url(u) => { root.open-url(u); }
                }
            }

            // ----- Panel Add Manual Cards (FASE 3): tampil saat
            // tombol + di bar status ditekan (EDITING saja).
            // C# UnifiedTrelloView: panel di kolom kanan, header
            // "Add Manual Cards" + TextBox link + "Import Cards".
            // Klik kanan / × = tutup panel (tanpa menyimpan).
            // Ukuran C# tetap (tanpa ui-scale): header 16px,
            // input 200px, tombol Import 38px.
            Rectangle {
                x: parent.width - root.trello-detail-w; y: 0;
                width: root.trello-detail-w; height: 100%;
                visible: root.current-tab == "HOME" && root.add-manual-open;
                add-manual-back-touch := TouchArea {
                    width: 100%; height: 100%;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                            root.add-manual-open = false;
                            root.manual-input = "";
                            root.toast = "Panel Add Manual ditutup (klik kanan)";
                        }
                    }
                }
            VerticalLayout {
                x: 0; y: 0;
                width: 100%; height: 100%;
                padding: 20px;
                spacing: Design.space-md;

                // Header: judul + subjudul + tombol tutup.
                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Add Manual Cards";
                            font-size: 16px;
                            font-weight: 600;
                            color: Design.text-primary;
                        }
                        Text {
                            text: "Paste Trello links below to manually track them.";
                            font-size: 12px;
                            color: Design.text-secondary;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 32px;
                        height: 36px;
                        IconBtn {
                            x: 0px;
                            y: (parent.height - 32px) / 2;
                            glyph: "×";
                            variant: "ghost";
                            size: 32px;
                            clicked => { root.add-manual-open = false; root.manual-input = ""; }
                        }
                    }
                }

                // Input link (multi-baris, 200px — C# TextBox Height 200).
                Rectangle {
                    height: 200px;
                    background: Design.bg-input;
                    border-color: Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-md;
                    clip: true;
                    Text {
                        x: 15px;
                        y: 15px;
                        text: "https://.../c/...";
                        font-size: 13px;
                        color: Design.text-muted;
                        visible: root.manual-input == "";
                    }
                    manual-input-field := TextInput {
                        x: 15px;
                        y: 15px;
                        width: parent.width - 30px;
                        height: parent.height - 30px;
                        text: root.manual-input;
                        single-line: false;
                        wrap: word-wrap;
                        font-size: 13px;
                        color: Design.text-primary;
                        edited => { root.manual-input = self.text; }
                    }
                }

                // Tombol Import (C#: Action, Height 38, full width).
                Btn {
                    label: "Import Cards";
                    variant: "primary";
                    scale: 1.06;
                    horizontal-stretch: 1;
                    clicked => { root.import-manual(root.manual-input); }
                }

                Text {
                    text: "Satu link per baris. Nama kartu diambil dari slug di link (nama asli dari API Trello di Fase 6).";
                    font-size: 11px;
                    color: Design.text-muted;
                    wrap: word-wrap;
                }
            }
            }

            // ----- BATCH: tree filesystem beneran (Rust, src/batch.rs)
            // + dua fase master + Replace. SOURCE = ISI folder sekolah
            // (tree, expand lazy, scan disk); BUAT MASTER = fase 2
            // (butuh manifest fase 1); Replace single + multiple;
            // toolbar = launcher skrip. Tampilan awal HANYA drop zone;
            // tree muncul setelah folder dipilih (abeng 28 Nov 00:42).
            VerticalLayout {
                x: 0; y: 0;
                width: 100%; height: 100%;
                visible: root.current-tab == "BATCH" && !root.src-empty;
                padding-left: Design.space-xl;
                padding-right: Design.space-xl;
                padding-top: Design.space-md;
                padding-bottom: Design.space-xl;
                spacing: Design.space-md;

                // Header: judul + deskripsi + Folder Reguler + tambah.
                HorizontalLayout {
                    height: 36px * root.ui-scale;
                    spacing: 8px * root.ui-scale;
                    Text {
                        text: "BATCH";
                        font-size: 14px * root.ui-scale;
                        font-weight: 800;
                        color: Design.text-primary;
                        letter-spacing: 1px * root.ui-scale;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Pilih folder sumber, lalu jalankan master.";
                        font-size: 12px * root.ui-scale;
                        color: Design.text-muted;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // Folder Reguler (ala master_creator): dropdown
                    // direktori kerja tersimpan — pindah folder tanpa
                    // drag lagi. Kosong = belum ada yang disimpan.
                    ComboBox {
                        width: 200px;
                        model: root.batch-reguler-names;
                        current-index: root.batch-reguler-idx;
                        selected(index) => { root.batch-reguler-picked(index); }
                    }
                    Btn {
                        label: "Folder Reguler…";
                        variant: "ghost";
                        scale: root.ui-scale;
                        clicked => { root.batch-reguler-manage(); }
                    }
                    Btn {
                        label: "☰ Tugas";
                        variant: "ghost";
                        scale: root.ui-scale;
                        clicked => { root.batch-open-task-manager(); }
                    }
                    Btn {
                        label: "+ Tambah Folder";
                        variant: "secondary";
                        scale: root.ui-scale;
                        clicked => { root.batch-pick-folder(); }
                    }
                }

                // Dua panel explorer (SOURCE kiri, OUTPUT kanan).
                // Tinggi eksplisit: window − nav (68*scale) − header
                // (36) − baris aksi A (36) − toolbar (56) −
                // 3 celah (36px) − padding (32px).
                HorizontalLayout {
                    height: root.height - 68px * root.ui-scale - 128px * root.ui-scale - 68px;
                    spacing: Design.space-md;

                    // Panel SOURCE — TREE isi folder sekolah (flat rows
                    // dari Rust; klik nama = pilih + salin path).
                    src-card := Card {
                        width: (root.content-width - 52px) / 2;
                        VerticalLayout {
                            padding: Design.space-md;
                            spacing: Design.space-sm;

                            HorizontalLayout {
                                height: 24px * root.ui-scale;
                                spacing: 8px * root.ui-scale;
                                Text {
                                    text: "SOURCE";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 800;
                                    color: Design.text-muted;
                                    letter-spacing: 1px * root.ui-scale;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.src-name;
                                    font-size: 12px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.text-primary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.batch-out-pending ? "(pending)" : "";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.cat-revision;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.batch-sel-count > 0 ? root.batch-sel-count + " dipilih" : "";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.accent;
                                    vertical-alignment: center;
                                }
                            }
                            HSeparator { }

                            // Input inline subfolder baru (C#
                            // CancelNewFolderInput di BatchFolderRoot).
                            Rectangle {
                                height: (root.newfolder-open && root.newfolder-panel == "SOURCE") ? 36px : 0px;
                                visible: root.newfolder-open && root.newfolder-panel == "SOURCE";
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.newfolder-parent;
                                        font-size: 11px;
                                        color: Design.text-muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    TextField {
                                        placeholder: "Nama subfolder baru…";
                                        text: root.newfolder-name;
                                        edited(name) => { root.newfolder-name = name; }
                                        accepted(name) => { root.newfolder-name = name; root.batch-confirm-new-folder(); }
                                        min-width: 180px;
                                        horizontal-stretch: 1;
                                    }
                                    IconBtn {
                                        glyph: "✓";
                                        variant: "secondary";
                                        scale: 1;
                                        size: 36px;
                                        clicked => { root.batch-confirm-new-folder(); }
                                    }
                                    IconBtn {
                                        glyph: "×";
                                        variant: "ghost";
                                        scale: 1;
                                        size: 36px;
                                        clicked => { root.batch-cancel-new-folder(); }
                                    }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                Flickable {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    VerticalLayout {
                                        x: 0;
                                        width: src-card.width - 2 * Design.space-md;
                                        spacing: 2px;
                                        for row in root.src-rows:
                                            BatchTreeRow {
                                                row-id: row.id;
                                                row-name: row.name;
                                                row-depth: row.depth;
                                                row-is-dir: row.is-dir;
                                                row-expanded: row.expanded;
                                                row-has-kids: row.has-kids;
                                                row-selected: row.selected;
                                                panel: "SOURCE";
                                                row-clicked(panel, id) => { root.batch-row-clicked(panel, id); }
                                                row-right-down(panel, id) => { root.batch-row-right-down(panel, id); }
                                                row-right-up(panel, id) => { root.batch-row-right-up(panel, id); }
                                                row-toggle-expand(panel, id) => { root.batch-toggle-expand(panel, id); }
                                                row-more(panel, id) => { root.batch-open-ctx(panel, id); }
                                            }
                                    }
                                }

                                // Lapisan penutup menu: klik di luar menu
                                // = tutup menu (C# menutup otomatis).
                                ctx-dismiss-src := TouchArea {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    visible: root.ctx-node != "" && root.ctx-panel == "SOURCE";
                                    clicked => { root.batch-close-ctx(); }
                                }

                                // Context menu SOURCE (popup di bawah panel).
                                BatchCtxMenu {
                                    x: 8px;
                                    y: parent.height - self.height - 8px;
                                    width: 230px;
                                    visible: root.ctx-node != "" && root.ctx-panel == "SOURCE";
                                    menu-title: root.ctx-node;
                                    show-replace: root.ctx-is-dir;
                                    show-copy-output: false;
                                    new-subfolder => { root.batch-ctx-new-subfolder(); }
                                    replace-auto => { root.batch-ctx-replace-auto(); }
                                    replace-manual => { root.batch-ctx-replace-manual(); }
                                    copy-path => { root.batch-ctx-copy-path(); }
                                    copy-output-path => { root.batch-ctx-copy-output-path(); }
                                    delete => { root.batch-ctx-delete(); }
                                    close-menu => { root.batch-close-ctx(); }
                                }
                            }
                        }
                    }

                    // Panel OUTPUT: tree SENDIRI dari folder output di
                    // disk (bukan cermin live SOURCE). "(pending)" bila
                    // folder belum ada; terisi setelah script jalan.
                    out-card := Card {
                        width: (root.content-width - 52px) / 2;
                        VerticalLayout {
                            padding: Design.space-md;
                            spacing: Design.space-sm;

                            HorizontalLayout {
                                height: 24px * root.ui-scale;
                                spacing: 8px * root.ui-scale;
                                Text {
                                    text: "OUTPUT";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 800;
                                    color: Design.text-muted;
                                    letter-spacing: 1px * root.ui-scale;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.selected-output;
                                    font-size: 12px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.text-primary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.batch-out-pending ? "(pending)" : "";
                                    font-size: 11px * root.ui-scale;
                                    font-weight: 700;
                                    color: Design.cat-revision;
                                    vertical-alignment: center;
                                }
                            }
                            HSeparator { }

                            // Input inline subfolder baru (OUTPUT).
                            Rectangle {
                                height: (root.newfolder-open && root.newfolder-panel == "OUTPUT") ? 36px : 0px;
                                visible: root.newfolder-open && root.newfolder-panel == "OUTPUT";
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.newfolder-parent;
                                        font-size: 11px;
                                        color: Design.text-muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    TextField {
                                        placeholder: "Nama subfolder baru…";
                                        text: root.newfolder-name;
                                        edited(name) => { root.newfolder-name = name; }
                                        accepted(name) => { root.newfolder-name = name; root.batch-confirm-new-folder(); }
                                        min-width: 180px;
                                        horizontal-stretch: 1;
                                    }
                                    IconBtn {
                                        glyph: "✓";
                                        variant: "secondary";
                                        scale: 1;
                                        size: 36px;
                                        clicked => { root.batch-confirm-new-folder(); }
                                    }
                                    IconBtn {
                                        glyph: "×";
                                        variant: "ghost";
                                        scale: 1;
                                        size: 36px;
                                        clicked => { root.batch-cancel-new-folder(); }
                                    }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                // Teks kosong (tengah).
                                Text {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    visible: root.out-empty;
                                    text: "Output akan muncul di sini.";
                                    font-size: 12px * root.ui-scale;
                                    color: Design.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Flickable {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    visible: !root.out-empty;
                                    VerticalLayout {
                                        x: 0;
                                        width: out-card.width - 2 * Design.space-md;
                                        spacing: 2px;
                                        for row in root.out-rows:
                                            BatchTreeRow {
                                                row-id: row.id;
                                                row-name: row.name;
                                                row-depth: row.depth;
                                                row-is-dir: row.is-dir;
                                                row-expanded: row.expanded;
                                                row-has-kids: row.has-kids;
                                                row-selected: row.selected;
                                                panel: "OUTPUT";
                                                row-clicked(panel, id) => { root.batch-row-clicked(panel, id); }
                                                row-right-down(panel, id) => { root.batch-row-right-down(panel, id); }
                                                row-right-up(panel, id) => { root.batch-row-right-up(panel, id); }
                                                row-toggle-expand(panel, id) => { root.batch-toggle-expand(panel, id); }
                                                row-more(panel, id) => { root.batch-open-ctx(panel, id); }
                                            }
                                    }
                                }

                                ctx-dismiss-out := TouchArea {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    visible: root.ctx-node != "" && root.ctx-panel == "OUTPUT";
                                    clicked => { root.batch-close-ctx(); }
                                }

                                // Context menu OUTPUT (tanpa Replace).
                                BatchCtxMenu {
                                    x: 8px;
                                    y: parent.height - self.height - 8px;
                                    width: 230px;
                                    visible: root.ctx-node != "" && root.ctx-panel == "OUTPUT";
                                    menu-title: root.ctx-node;
                                    show-replace: false;
                                    show-copy-output: true;
                                    new-subfolder => { root.batch-ctx-new-subfolder(); }
                                    replace-auto => { root.batch-ctx-replace-auto(); }
                                    replace-manual => { root.batch-ctx-replace-manual(); }
                                    copy-path => { root.batch-ctx-copy-path(); }
                                    copy-output-path => { root.batch-ctx-copy-output-path(); }
                                    delete => { root.batch-ctx-delete(); }
                                    close-menu => { root.batch-close-ctx(); }
                                }
                            }
                            // Baris aksi OUTPUT: BUAT MASTER (fase 2) +
                            // tombol dokumen (▤, placeholder — Master
                            // File Browser DITUNDA, bertahap, lokasinya
                            // di side panel / log panel navigasi button).
                            // Di DALAM panel OUTPUT (dokumen §3.5/§9).
                            HorizontalLayout {
                                height: 36px * root.ui-scale;
                                spacing: 8px * root.ui-scale;
                                Rectangle { horizontal-stretch: 1; }
                                Btn {
                                    label: "⧉ BUAT MASTER";
                                    variant: "secondary";
                                    scale: root.ui-scale;
                                    clicked => { root.batch-run-script("buat_master_duplikat"); }
                                }
                                IconBtn {
                                    glyph: "▤";
                                    variant: "secondary";
                                    scale: root.ui-scale;
                                    size: 36px;
                                    clicked => { root.toast = "Master File Browser akan hadir di side panel (bertahap)."; }
                                }
                            }
                        }
                    }
                }

                // Baris A: indikator manifest + Fase 1 + Replace.
                // Manifest: dot hijau = ada (Fase 1 sudah jalan),
                // merah = belum ada (BUAT MASTER akan error).
                HorizontalLayout {
                    height: 36px * root.ui-scale;
                    spacing: 8px * root.ui-scale;
                    IconBtn {
                        glyph: "⧉";
                        variant: "secondary";
                        scale: root.ui-scale;
                        size: 36px;
                        clicked => { root.batch-copy-master(); }
                    }
                    HorizontalLayout {
                        spacing: 6px * root.ui-scale;
                        Text {
                            text: "●";
                            font-size: 10px * root.ui-scale;
                            color: root.has-manifest ? Design.status-success : Design.status-danger;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.has-manifest ? "Manifest: ada" : "Manifest: belum ada";
                            font-size: 12px * root.ui-scale;
                            color: Design.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        label: "▶ Fase 1";
                        variant: "ghost";
                        scale: root.ui-scale;
                        clicked => { root.batch-phase1(); }
                    }
                    Btn {
                        label: "Replace";
                        variant: "secondary";
                        scale: root.ui-scale;
                        clicked => { root.batch-replace-auto(); }
                    }
                }

                // Footer (dokumen §3.5): TOMBOL SCRIPT MASTER BERNAMA
                // — satu tombol per file .py di Scripts/Master/
                // (nama/urutan dari scripts.json; file "_" dan
                // enabled:false tidak tampil). Klik = ExecuteMaster:
                // proses SEMUA folder SOURCE, OUTPUT terisi, log
                // "[SUCCESS] Batch Selesai.". Kanan: refresh (re-scan
                // SOURCE & OUTPUT) + clear merah (kosongkan daftar).
                Card {
                    height: 56px * root.ui-scale;
                    HorizontalLayout {
                        x: 0;
                        y: 10px * root.ui-scale;
                        width: 100%;
                        height: 36px * root.ui-scale;
                        padding-left: Design.space-sm * root.ui-scale;
                        padding-right: Design.space-sm * root.ui-scale;
                        spacing: 6px * root.ui-scale;
                        for s in root.batch-scripts:
                            Btn {
                                label: s;
                                variant: "secondary";
                                scale: root.ui-scale;
                                small: true;
                                clicked => { root.batch-run-script(s); }
                            }
                        Rectangle { horizontal-stretch: 1; }
                        IconBtn {
                            glyph: "↻";
                            variant: "ghost";
                            scale: root.ui-scale;
                            size: 36px;
                            clicked => { root.batch-refresh(); }
                        }
                        IconBtn {
                            glyph: "×";
                            variant: "danger";
                            scale: root.ui-scale;
                            size: 36px;
                            clicked => { root.batch-clear(); }
                        }
                    }
                }
            }

            // ----- BATCH kosong: SELURUH tab = satu drop zone (C#
            // DashboardView.axaml:345-361, tampil bila ShowDropZone).
            // Slint belum mendukung drag-drop OS — klik "Pilih Folder"
            // = pilih folder lewat dialog (Windows) / zenity (Linux);
            // Folder Reguler di bawahnya = jalan pintas tanpa drag.
            Rectangle {
                x: 0; y: 0;
                width: 100%; height: 100%;
                visible: root.current-tab == "BATCH" && root.src-empty;
                border-color: Design.border-hover;
                border-width: 2px;
                border-radius: Design.radius-md;
                VerticalLayout {
                    x: 0; y: 0; width: 100%; height: 100%;
                    alignment: center;
                    spacing: 12px * root.ui-scale;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 64px * root.ui-scale;
                            height: 64px * root.ui-scale;
                            border-color: Design.text-muted;
                            border-width: 2px;
                            border-radius: 32px * root.ui-scale;
                            opacity: 0.5;
                            Text {
                                text: "+";
                                font-size: 36px * root.ui-scale;
                                font-weight: 300;
                                color: Design.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }
                    Text {
                        text: "DRAG FOLDERS HERE";
                        font-size: 16px * root.ui-scale;
                        font-weight: 800;
                        color: Design.text-primary;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Drop source folders to begin batch processing";
                        font-size: 12px * root.ui-scale;
                        color: Design.text-secondary;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        padding-top: 8px * root.ui-scale;
                        Btn {
                            label: "Pilih Folder";
                            variant: "secondary";
                            scale: root.ui-scale;
                            clicked => { root.batch-pick-folder(); }
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px * root.ui-scale;
                        padding-top: 8px * root.ui-scale;
                        Text {
                            text: "Folder Reguler:";
                            font-size: 12px * root.ui-scale;
                            color: Design.text-muted;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            width: 220px;
                            model: root.batch-reguler-names;
                            current-index: root.batch-reguler-idx;
                            selected(index) => { root.batch-reguler-picked(index); }
                        }
                        Btn {
                            label: "Kelola…";
                            variant: "ghost";
                            scale: root.ui-scale;
                            clicked => { root.batch-reguler-manage(); }
                        }
                    }
                }
            }
            }

            // ----- RESIZE HANDLE Log Panel (C# DashboardView.axaml:
            // Border 6px + garis 2px di tengah, drag SizeWestEast;
            // lebar disimpan ke DB Dashboard.LogPanelWidth saat drag
            // dilepas; MinWidth 180, maks = lebar window − 200px) -----
            log-resize-handle := Rectangle {
                width: root.show-logpanel ? 6px : 0px;
                height: root.height - 68px * root.ui-scale;
                visible: root.show-logpanel;
                background: handle-touch.has-hover || handle-touch.dragging ? #663b82f6 : transparent;
                Rectangle {
                    x: 2px; y: 0; width: 2px; height: 100%;
                    background: Design.separator;
                }
                handle-touch := TouchArea {
                    mouse-cursor: ew-resize;
                    property <length> press-x: 0px;
                    property <bool> dragging: false;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                            self.press-x = self.mouse-x;
                            self.dragging = true;
                        } else if (ev.kind == PointerEventKind.up) {
                            if (self.dragging) {
                                self.dragging = false;
                                root.save-logpanel-width(root.log-panel-width);
                            }
                        } else if (ev.kind == PointerEventKind.move && self.dragging) {
                            // Handle di tepi kiri panel: geser kiri =
                            // panel melebar (mouse-x − press-x negatif).
                            root.log-panel-width = max(180px, min(root.width - 200px, root.log-panel-width - (self.mouse-x - self.press-x)));
                        }
                    }
                }
            }

            // ----- LOG PANEL (sidebar kanan; lebar 0 saat tertutup,
            // visible:false tetap makan ruang jadi lebar yang mengatur) -----
            log-panel := LogPanelView {
                width: root.show-logpanel ? root.log-panel-width : 0px;
                height: root.height - 68px * root.ui-scale;
                visible: root.show-logpanel;
                panel-tab: root.logpanel-tab;
                log-lines: root.log-lines;
                log-status: root.log-status;
                log-progress: root.log-progress;
                log-progress-label: root.log-progress-label;
                toast(text) => { root.toast = text; }
                close() => { root.show-logpanel = false; }
                clear-log() => { root.clear-log(); }
                copy-log() => { root.copy-log(); }
                stop-log() => { root.stop-log(); }
                open-explorer(path) => {
                    root.ex-start-path = path;
                    root.overlay-view = "EXPLORER";
                    root.show-logpanel = false;
                    explorer-view.focus-list();
                }
                doc-tab-add() => { }
                doc-tab-close() => { }
            }
        }
    }

    // ===== Overlay layar penuh — pill nav disembunyikan saat salah
    // satu overlay terbuka (overlay-view != ""). Settings dibuka dari
    // flyout profil / Ctrl+,. Toolbox kini window OS (bukan overlay —
    // dibuka dari radial / C# ToolboxWindow). Explorer overlay
    // ("EXPLORER") = Build B. =====
    SettingsView {
        x: 0; y: root.chrome-overlay-y;
        width: 100%; height: root.height - root.chrome-overlay-y - root.chrome-content-bottom;
        visible: root.overlay-view == "SETTINGS";
        widget-bg <=> root.widget-bg;
        widget-style <=> root.widget-style;
