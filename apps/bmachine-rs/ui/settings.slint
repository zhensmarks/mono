// SETTINGS — side panel + konten (DESIGN_SYSTEM.md §17).
// Grup (10 grup — C# aslinya 7; Dynamic Island / Radial Menu / Profile
// grup khusus port, abeng 28 Nov 11:04/11:05/11:07): General (default),
// Appearance, Profile, Account, Extensions, Dynamic Island, Radial Menu,
// Script Manager, Paths, About. Grup "Explorer"
// BUKAN bagian Settings — dipindah ke ExplorerSettingsView tersendiri
// (ui/explorer-settings.slint, dibuka dari tombol "⚙ Explorer" di
// sidebar Explorer), sesuai C# ExplorerSettingsView terpisah.
// Side panel pola gambar referensi (26 Nov 16:54): judul "Settings" +
// search bar (filter substring) + item berikon, item terpilih
// highlight accent-subtle. 10 grup dikelompokkan ke 5 kategori
// berlabel kecil + separator tipis (abeng, 28 Nov 07:05: sidebar
// jangan dempet, kustomisasi akan makin banyak dan panel makin rame).
// Sidebar POLOS tanpa panel sendiri di semua mode chrome — HANYA
// konten yang dapat panel rounded (abeng, 28 Nov 07:09/07:11).
// Pola "Visual style" dari gambar referensi (kartu preview color mode,
// preset tema, swatch + hex, font, widget background, window chrome).
// State lokal mockup yang fungsional; perubahan tampil di area PREVIEW
// di layar settings. Koneksi nyata ke tema global = Fase 6.
// Semua opsi ditumpuk (label di atas, kontrol di bawah) supaya muat di 520px.

import { Design, Card, HSeparator, Btn, TextField, Toggle, StatWidget, SvgIcon, ComboBox } from "design.slint";

// Baris grup di side panel (ikon + label, gaya NavTab list).
// Pola gambar referensi (26 Nov 16:54): ikon + label, item terpilih
// highlight accent-subtle. `shown` = hasil filter search (tinggi 0 +
// visible false — visible:false saja tetap makan ruang di Slint).
component GroupRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> shown: true;
    // Mode ciut (rail ikon): label disembunyikan, ikon di tengah.
    in property <bool> collapsed: false;
    callback clicked();
    height: shown ? 36px : 0px;
    visible: shown;
    background: selected ? Design.accent-subtle : (grow-touch.has-hover ? Design.bg-hover : transparent);
    border-radius: Design.radius-sm;
    grow-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: collapsed ? 0px : 12px;
        padding-right: collapsed ? 0px : 12px;
        spacing: 10px;
        alignment: collapsed ? center : start;
        VerticalLayout {
            alignment: center;
            SvgIcon {
                name: icon;
                size: 15px;
                icon-color: selected ? Design.accent : Design.text-secondary;
            }
        }
        // `if` (bukan visible:false) — label hilang total dari
        // layout saat ciut, ikon jadi satu-satunya anak dan
        // terpusat (visible:false tetap makan ruang di Slint).
        if !collapsed : Text {
            text: label;
            font-size: Design.font-body;
            font-weight: selected ? 700 : 600;
            color: selected ? Design.accent : Design.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// Label kategori kecil di sidebar Settings (11px/700, text-muted,
// huruf kapital) — mengelompokkan 7 grup ke 4 kategori (abeng,
// 28 Nov 07:05) supaya tidak dempet dan tetap rapi saat kustomisasi
// makin banyak. Hilang total (tinggi 0) saat rail ciut atau saat
// tidak ada item kategori yang lolos filter search.
component SidebarCategoryLabel inherits Rectangle {
    in property <string> label;
    in property <bool> shown: true;
    in property <bool> collapsed: false;
    height: shown && !collapsed ? 16px : 0px;
    visible: shown && !collapsed;
    Text {
        text: label;
        font-size: Design.font-caption;
        font-weight: 700;
        color: Design.text-muted;
        vertical-alignment: center;
        x: 12px;
        height: 100%;
    }
}

// Garis pemisah tipis antar kategori di sidebar Settings — 1px
// di tengah ruang 17px (jarak 8px atas + bawah). Hilang total
// (tinggi 0) bila salah satu kategori di sisinya kosong (filter
// search); di rail ciut garis tetap tampil sebagai pemisah ikon.
component SidebarSeparator inherits Rectangle {
    in property <bool> shown: true;
    height: shown ? 17px : 0px;
    visible: shown;
    Rectangle {
        y: 8px;
        height: 1px;
        background: Design.separator;
    }
}

// Chip pilihan (kartu/chip, bukan dropdown generik).
component OptionChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    // Tinggi 36px — SAMA dengan TextField / ThemeRow / Btn (satu tinggi kontrol di semua section).
    height: 36px;
    background: selected ? Design.accent-subtle : (ochip-touch.has-hover ? Design.bg-hover : transparent);
    border-color: selected ? Design.accent : Design.separator;
    border-width: 1px;
    border-radius: Design.radius-sm;
    ochip-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: label;
            font-size: Design.font-button;
            font-weight: 600;
            color: selected ? Design.accent : Design.text-primary;
            vertical-alignment: center;
        }
    }
}

// Label + deskripsi satu opsi (judul 13/700, deskripsi 11 sekunder).
component FieldLabel inherits VerticalLayout {
    in property <string> title;
    in property <string> desc;
    spacing: 2px;
    Text {
        text: title;
        font-size: Design.font-body;
        font-weight: 700;
        color: Design.text-primary;
        vertical-alignment: top;
        vertical-stretch: 0;
        // Judul ikut wrap supaya tidak terpotong di kolom sempit
        // (baris 2-kolom Account di 520px — kolom cuma ~106px).
        wrap: word-wrap;
    }
    Text {
        text: desc;
        font-size: Design.font-caption;
        color: Design.text-secondary;
        wrap: word-wrap;
        visible: desc != "";
        // WAJIB top: Text ber-wrap diregangkan vertikal oleh layout
        // bila baris lebih tinggi dari label (mis. dropdown Theme
        // terbuka, Paket ikon 2 baris chip + preview) — tanpa ini
        // teks deskripsi melayang ke tengah baris (28 Nov 2026).
        vertical-alignment: top;
        vertical-stretch: 0;
    }
    // Penyerap ruang ekstra (tak terlihat, tinggi natural 0): bila
    // baris lebih tinggi dari label, layout Slint membagi rata ruang
    // ekstra ke SEMUA anak bila total stretch <= 0 (dianggap 1 tiap
    // anak — i-slint-core layout.rs) sehingga deskripsi melayang ke
    // tengah. Dengan penyerap stretch 1 ini, judul + deskripsi
    // (stretch 0) tetap pada tinggi naturalnya di atas.
    Rectangle { vertical-stretch: 1; }
}

// Satu baris setting (abeng, 28 Nov 09:59/10:01): label + subtext di
// KIRI, kontrol di KANAN secukupnya lebarnya — bukan label di atas +
// kontrol full-width di bawah (boros, "aneh"). Saat konten sempit
// (`stacked`, window compact 520) baris MENUMPUK: label di atas,
// kontrol di bawah — itu tidak apa-apa dan memang diharapkan.
// Kontrol (@children) ditulis SEKALI: lebarnya diatur di tiap
// pemakaian (fixed saat lebar, 100% saat menumpuk — TextField /
// ComboBox / baris field+tombol), atau natural (Toggle / Btn /
// baris chip / baris hex). Pembungkus menengahkan kontrol secara
// vertikal terhadap label yang mungkin membungkus 2 baris (§7).
component SettingRow inherits VerticalLayout {
    in property <string> title;
    in property <string> desc;
    in property <bool> stacked;
    spacing: 6px;
    if stacked : FieldLabel { title: title; desc: desc; }
    HorizontalLayout {
        spacing: 16px;
        if !stacked : FieldLabel { title: title; desc: desc; horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            // Jarak antar anak bila kontrol terdiri dari beberapa
            // baris (mis. chip + pratinjau di "Gaya toggle").
            spacing: 8px;
            horizontal-stretch: stacked ? 1 : 0;
            @children
        }
    }
}

// Chip statis rincian slot radial (28px, teks 10px di tengah).
// `accent-text`: teks warna aksen (slot skrip); `more`: chip navigasi
// More/Back (latar aksen-subtle + border aksen + teks tebal).
component SlotChip inherits Rectangle {
    in property <string> label;
    in property <bool> accent-text: false;
    in property <bool> more: false;
    height: 28px;
    background: more ? Design.accent-subtle : Design.bg-hover;
    border-color: more ? Design.accent : transparent;
    border-width: more ? 1px : 0px;
    border-radius: 4px;
    Text {
        text: root.label;
        font-size: 10px;
        font-weight: more ? 800 : accent-text ? 700 : 400;
        color: accent-text || more ? Design.accent : Design.text-primary;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// Pratinjau roda radial 200x200 (RadialSlotsControl C#) — komponen
// supaya bisa dipakai di layout lebar (roda + rincian di kanan) maupun
// menumpuk (roda di atas, rincian di bawah) tanpa menduplikasi ~90 baris.
component RadialWheelPreview inherits Rectangle {
    width: 200px;
    height: 200px;
    border-radius: 100px;
    background: Design.surface-elevated;
    border-color: Design.separator;
    border-width: 1px;
    clip: true;

    // 8 Pembatas sektor
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
        fill: transparent;
        stroke: Design.text-primary;
        stroke-width: 1px;
        opacity: 0.15;
        commands: "M 116.84 59.35 L 138.27 7.61 M 140.65 83.16 L 192.39 61.73 M 140.65 116.84 L 192.39 138.27 M 116.84 140.65 L 138.27 192.39 M 83.16 140.65 L 61.73 192.39 M 59.35 116.84 L 7.61 138.27 M 59.35 83.16 L 7.61 61.73 M 83.16 59.35 L 61.73 7.61";
    }

    // Hub tengah 88px
    Rectangle {
        x: 56px; y: 56px; width: 88px; height: 88px;
        border-radius: 44px;
        background: Design.card-bg;
        border-color: Design.separator;
        border-width: 1px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: "RADIAL"; font-size: 10px; font-weight: 800; letter-spacing: 1px; color: Design.text-primary; horizontal-alignment: center; }
            Text { text: "7 SLOTS"; font-size: 8px; font-weight: 600; color: Design.accent; horizontal-alignment: center; }
        }
    }

    // 8 Tombol slot pada R = 72px (cx=100, cy=100, btn 32x32 -> -16px)
    // 0° (Utara): (100 - 16, 100 - 72 - 16) = (84, 12)
    Rectangle {
        x: 84px; y: 12px; width: 32px; height: 32px; border-radius: 16px;
        background: Design.card-bg; border-color: Design.accent; border-width: 1.5px;
        SvgIcon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; name: "image"; size: 16px; icon-color: Design.accent; }
    }
    // 45° (NE): (100 + 51 - 16, 100 - 51 - 16) = (135, 33)
    Rectangle {
        x: 135px; y: 33px; width: 32px; height: 32px; border-radius: 16px;
        background: Design.card-bg; border-color: Design.accent; border-width: 1.5px;
        SvgIcon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; name: "file-text"; size: 16px; icon-color: Design.accent; }
    }
    // 90° (Timur): (100 + 72 - 16, 100 - 16) = (156, 84)
    Rectangle {
        x: 156px; y: 84px; width: 32px; height: 32px; border-radius: 16px;
        background: Design.card-bg; border-color: Design.accent; border-width: 1.5px;
        SvgIcon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; name: "wrench"; size: 16px; icon-color: Design.accent; }
    }
    // 135° (SE): (100 + 51 - 16, 100 + 51 - 16) = (135, 135)
    Rectangle {
        x: 135px; y: 135px; width: 32px; height: 32px; border-radius: 16px;
        background: Design.card-bg; border-color: Design.separator; border-width: 1px;
        SvgIcon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; name: "crop"; size: 16px; icon-color: Design.text-primary; }
    }
    // 180° (Selatan - More/Nav): (100 - 16, 100 + 72 - 16) = (84, 156)
    Rectangle {
        x: 84px; y: 156px; width: 32px; height: 32px; border-radius: 16px;
        background: Design.accent-subtle; border-color: Design.accent; border-width: 1px;
        SvgIcon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; name: "more-horizontal"; size: 16px; icon-color: Design.accent; }
    }
    // 225° (SW): (100 - 51 - 16, 100 + 51 - 16) = (33, 135)
    Rectangle {
        x: 33px; y: 135px; width: 32px; height: 32px; border-radius: 16px;
        background: Design.card-bg; border-color: Design.separator; border-width: 1px;
        SvgIcon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; name: "palette"; size: 16px; icon-color: Design.text-primary; }
    }
    // 270° (Barat): (100 - 72 - 16, 100 - 16) = (12, 84)
    Rectangle {
        x: 12px; y: 84px; width: 32px; height: 32px; border-radius: 16px;
        background: Design.card-bg; border-color: Design.separator; border-width: 1px;
        SvgIcon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; name: "save"; size: 16px; icon-color: Design.text-primary; }
    }
    // 315° (NW): (100 - 51 - 16, 100 - 51 - 16) = (33, 33)
    Rectangle {
        x: 33px; y: 33px; width: 32px; height: 32px; border-radius: 16px;
        background: Design.card-bg; border-color: Design.separator; border-width: 1px;
        SvgIcon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; name: "download"; size: 16px; icon-color: Design.text-primary; }
    }
}

// Titik swatch warna (klik = pilih warna itu).
// Wadah setinggi baris (36px): lingkaran 28px di tengah vertikal.
// Anak layout menempel ke ATAS, jadi lingkaran langsung di baris 36px
// kelihatan "ke atas" — dibungkus wadah setinggi baris + y eksplisit.
// `compact` (baris menumpuk di window 520): lingkaran 24px supaya
// baris hex (preview + field + 5 dot) tetap muat di konten 256px.
component SwatchDot inherits Rectangle {
    in property <color> swatch;
    in property <bool> selected;
    in property <bool> compact: false;
    callback clicked();
    width: root.compact ? 24px : 28px;
    height: 36px;
    circle := Rectangle {
        width: root.compact ? 24px : 28px;
        height: root.compact ? 24px : 28px;
        x: 0px;
        y: (root.height - (root.compact ? 24px : 28px)) / 2;
        background: swatch;
        border-color: selected ? Design.accent : Design.border-hover;
        border-width: 2px;
        border-radius: 999px;
    }
    dot-touch := TouchArea {
        width: root.compact ? 24px : 28px;
        height: 36px;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Kartu preview color mode (terang / gelap / ikut sistem).
component ColorModeCard inherits Rectangle {
    in property <string> mode;
    in property <bool> selected;
    callback clicked();
    background: Design.card-bg;
    border-color: selected ? Design.accent : Design.separator;
    border-width: selected ? 2px : 1px;
    border-radius: Design.radius-lg;
    clip: true;
    cm-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: Design.space-sm;
        spacing: 6px;
        // Miniatur jendela: warna sesuai mode (nilai preview, bukan token app).
        Rectangle {
            vertical-stretch: 1;
            background: mode == "dark" ? #191919 : #F5F5F5;
            border-radius: Design.radius-sm;
            clip: true;
            // Mode "system": separuh terang + separuh gelap.
            HorizontalLayout {
                x: 0; y: 0; width: 100%; height: 100%;
                Rectangle {
                    horizontal-stretch: 1;
                    background: mode == "dark" ? #191919 : #F5F5F5;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: #191919;
                    visible: mode == "system";
                }
            }
            // Bar preview dibungkus container yang di mode "system" hanya
            // selebar separuh terang — supaya bar tidak menyeberang garis
            // belah terang/gelap dan terlihat terpotong di tengah (26 Nov).
            Rectangle {
                x: 0; y: 0; width: mode == "system" ? 50% : 100%; height: 100%;
                clip: true;
                Rectangle { x: 10px; y: 10px; width: 40%; height: 4px; background: #3b82f6; border-radius: 2px; }
                Rectangle { x: 10px; y: 20px; width: 65%; height: 3px; background: mode == "light" ? #C9C9C9 : #3A3A3A; border-radius: 2px; }
                Rectangle { x: 10px; y: 28px; width: 50%; height: 3px; background: mode == "light" ? #C9C9C9 : #3A3A3A; border-radius: 2px; }
                Rectangle { x: 10px; y: 38px; width: 30%; height: 3px; background: #3b82f6; border-radius: 2px; }
            }
        }
        Text {
            text: mode == "light" ? "Terang" : mode == "dark" ? "Gelap" : "Ikut sistem";
            font-size: Design.font-button;
            font-weight: 700;
            color: selected ? Design.accent : Design.text-primary;
            horizontal-alignment: center;
        }
    }
}

// Kartu pilihan font — menampilkan contoh Regular + Bold + ExtraBold.
component FontCard inherits Rectangle {
    in property <string> font-name;
    in property <string> font-family;
    in property <bool> selected;
    callback clicked();
    // Tinggi responsif: di window sempit (520px) kartu lebih tinggi
    // supaya contoh font yang ter-wrap 2 baris tidak terpotong.
    height: root.width < 200px ? 140px : 108px;
    background: Design.card-bg;
    border-color: selected ? Design.accent : Design.separator;
    border-width: selected ? 2px : 1px;
    border-radius: Design.radius-lg;
    clip: true;
    fc-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: Design.space-md;
        spacing: 3px;
        Text {
            text: font-name;
            font-size: Design.font-body;
            font-weight: 700;
            font-family: font-family;
            color: Design.text-primary;
        }
        Text {
            text: "Aa Bb Cc 0123 — Regular";
            font-size: Design.font-button;
            font-weight: 400;
            font-family: font-family;
            color: Design.text-secondary;
            wrap: word-wrap;
        }
        Text {
            text: "Aa Bb Cc 0123 — Bold";
            font-size: Design.font-button;
            font-weight: 700;
            font-family: font-family;
            color: Design.text-secondary;
            wrap: word-wrap;
        }
        Text {
            text: "Aa Bb Cc 0123 — ExtraBold";
            font-size: Design.font-button;
            font-weight: 800;
            font-family: font-family;
            color: Design.text-secondary;
            wrap: word-wrap;
        }
    }
}

// Baris preset tema (daftar penuh, satu baris per preset).
// Preview palet: 4 titik warna (aksen, revisi/sekunder, background,
// foreground) supaya tema dikenali sekilas — ala picker tema Omarchy.
// `deletable` = tema user (× hapus, tidak memicu klik baris).
component ThemeRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <color> sw1: transparent;
    in property <color> sw2: transparent;
    in property <color> sw3: transparent;
    in property <color> sw4: transparent;
    in property <bool> deletable: false;
    callback clicked();
    callback delete();
    height: 36px;
    background: selected ? Design.accent-subtle : (trow-touch.has-hover ? Design.bg-hover : transparent);
    border-color: selected ? Design.accent : Design.separator;
    border-width: 1px;
    border-radius: Design.radius-sm;
    trow-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: label;
            font-size: Design.font-body;
            font-weight: 600;
            color: selected ? Design.accent : Design.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        // Titik preview palet (aturan §7: elemen ber-height
        // eksplisit di baris dibungkus VerticalLayout center).
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 4px;
                Rectangle { width: 12px; height: 12px; background: sw1; border-color: Design.border-hover; border-width: 1px; border-radius: 999px; }
                Rectangle { width: 12px; height: 12px; background: sw2; border-color: Design.border-hover; border-width: 1px; border-radius: 999px; }
                Rectangle { width: 12px; height: 12px; background: sw3; border-color: Design.border-hover; border-width: 1px; border-radius: 999px; }
                Rectangle { width: 12px; height: 12px; background: sw4; border-color: Design.border-hover; border-width: 1px; border-radius: 999px; }
            }
        }
        if deletable : VerticalLayout {
            alignment: center;
            del-touch := TouchArea {
                width: 24px;
                height: 24px;
                mouse-cursor: pointer;
                clicked => { root.delete(); }
                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "×";
                    font-size: 16px;
                    font-weight: 700;
                    color: Design.text-secondary;
                }
            }
        }
        Text {
            text: selected ? "✓" : "";
            font-size: Design.font-body;
            font-weight: 700;
            color: Design.accent;
            vertical-alignment: center;
        }
    }
}

// Satu baris pet ter-install (PetDex): nama + pembuat + tombol
// Buka (halaman PetDex) + Hapus. Klik baris = jadikan pet aktif.
component PetRow inherits Rectangle {
    in property <string> label;
    in property <string> author;
    in property <bool> selected;
    callback clicked();
    callback delete();
    callback open();
    height: 36px;
    background: selected ? Design.accent-subtle : (trow-touch.has-hover ? Design.bg-hover : transparent);
    border-color: selected ? Design.accent : Design.separator;
    border-width: 1px;
    border-radius: Design.radius-sm;
    trow-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: label;
            font-size: Design.font-body;
            font-weight: 600;
            color: selected ? Design.accent : Design.text-primary;
            vertical-alignment: center;
        }
        Text {
            text: author == "" ? "" : "oleh " + author;
            font-size: Design.font-caption;
            color: Design.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            open-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open(); }
                Text {
                    text: "Buka";
                    font-size: Design.font-caption;
                    font-weight: 600;
                    color: Design.accent;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            del-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.delete(); }
                Text {
                    text: "Hapus";
                    font-size: Design.font-caption;
                    font-weight: 600;
                    color: Design.status-danger;
                }
            }
        }
        Text {
            text: selected ? "✓" : "";
            font-size: Design.font-body;
            font-weight: 700;
            color: Design.accent;
            vertical-alignment: center;
        }
    }
}

// Satu baris warna widget: dot warna aktif + label + field hex +
// 4 swatch. Swatch mengirim hex (string) karena Slint tidak bisa
// memformat color → hex.
// `stacked` (window 520): baris membungkus jadi 2 baris —
// dot+label+field di atas, 4 swatch di bawah — supaya tetap muat
// di konten 256px (satu baris butuh ~376px).
component WidgetColorRow inherits Rectangle {
    in property <string> label;
    in property <color> dot-color;
    // `in-out` + `<=>` ke TextField: binding satu arah PUTUS saat user
    // mengetik, sehingga perubahan programatik (preset / normalisasi
    // Rust) tidak lagi tampil di field — lihat komentar TextField.
    in-out property <string> hex;
    in property <[color]> swatches;
    in property <[string]> swatch-hexes;
    in property <bool> stacked: false;
    callback hex-edited(string);
    callback hex-accepted(string);
    callback swatch-picked(string);
    height: root.stacked ? 76px : 36px;
    if !root.stacked : HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle { width: 20px; height: 20px; background: dot-color; border-color: Design.border-hover; border-width: 1px; border-radius: 999px; }
        }
        Text {
            text: label;
            font-size: Design.font-button;
            font-weight: 700;
            color: Design.text-secondary;
            vertical-alignment: center;
            width: 76px;
        }
        TextField {
            width: 120px;
            text <=> hex;
            placeholder: "#3b82f6";
            edited(text) => { root.hex-edited(text); }
            accepted(text) => { root.hex-accepted(text); }
        }
        for sw[i] in swatches : SwatchDot {
            swatch: sw;
            selected: dot-color == sw;
            clicked => { root.swatch-picked(swatch-hexes[i]); }
        }
    }
    if root.stacked : VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle { width: 20px; height: 20px; background: dot-color; border-color: Design.border-hover; border-width: 1px; border-radius: 999px; }
            }
            Text {
                text: label;
                font-size: Design.font-button;
                font-weight: 700;
                color: Design.text-secondary;
                vertical-alignment: center;
                width: 76px;
            }
            TextField {
                width: 120px;
                text <=> hex;
                placeholder: "#3b82f6";
                edited(text) => { root.hex-edited(text); }
                accepted(text) => { root.hex-accepted(text); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            for sw2[j] in swatches : SwatchDot {
                swatch: sw2;
                selected: dot-color == sw2;
                clicked => { root.swatch-picked(swatch-hexes[j]); }
            }
        }
    }
}

export component SettingsView inherits Rectangle {
    callback toast(string);
    callback back();
    callback check-update();
    callback appearance-changed();
    callback reset-appearance();
    // Tema preset (id, mis. "spider") diterapkan Rust — satu palet
    // penuh (mode + aksen + bg + fg + 4 warna widget).
    callback apply-theme-preset(string);
    // Tema user: simpan snapshot tampilan saat ini (nama) / pakai /
    // hapus. Disimpan di SQLite `Settings.Theme.UserThemes` (JSON).
    callback save-user-theme(string);
    callback apply-user-theme(string);
    callback delete-user-theme(string);
    callback save-general-settings();
    callback export-database();
    callback import-database();
    callback save-paths-settings();
    callback browse-path(string);
    callback test-trello();
    callback notch-settings-changed();
    callback test-notch-voice();
    // Visibilitas Dynamic Island (notch hidup) — terikat dua arah ke
    // AppWindow; on/off lewat callback open/hide-dynamic-bar (Rust
    // menyimpan `Settings.DynamicBar.Visible` + tampil/sembunyikan
    // window bar).
    in-out property <bool> dynamic-bar-visible: true;
    callback open-dynamic-bar();
    callback hide-dynamic-bar();
    callback radial-settings-changed();
    // Pet PetDex (install/hapus dari galeri petdex.dev — model
    // skill Hermes). pet-names[0] = "Blob bawaan"; pet-slugs[0]
    // kosong. Daftar ter-install (tanpa blob) di pet-installed-*,
    // sejajar: nama / pembuat / slug.
    callback pet-active-changed(int);
    callback pet-install-requested(string);
    callback pet-remove-requested(int);
    callback pet-open-page(int);
    callback open-url(string);
    // ShortcutConfig sama seperti C#: trigger direkam, disimpan ke SQLite, lalu hook aktif diperbarui.
    callback start-recording-shortcut();
    callback cancel-recording-shortcut();
    in-out property <bool> recording-shortcut: false;
    in-out property <string> current-shortcut-label: "Shift + Mouse Middle"; // default C# TriggerConfig (Mouse/Middle/Shift) — di-overwrite Rust saat startup
    // Widget background — terikat dua arah ke AppWindow (kartu dashboard ikut berubah).
    in-out property <string> widget-bg: "doodle";
    // Gaya latar widget — terikat dua arah ke AppWindow (permukaan kartu ikut berubah).
    in-out property <string> widget-style: "solid";
    // Notch hidup (rework 27 Nov 2026): mode notch / avatar pet +
    // voice SAPI (Windows). Terikat dua arah ke AppWindow.
    in-out property <string> notch-mode: "notch";
    // Gaya mata maskot ("nusa" | "baymax" | "bulat") — berlaku ke
    // mata notch + blob pet bawaan (bukan sprite PetDex).
    in-out property <string> notch-eye-style: "nusa";
    // Gaya ring radial ("glass" | "hud" | "flat") + jumlah segmen
    // ring (2–8) — terikat dua arah ke AppWindow.
    in-out property <string> radial-style: "glass";
    in-out property <int> radial-segments: 8;
    // Gaya toggle on/off ("classic" | "pill" | "outline") —
    // terikat dua arah ke AppWindow; berlaku ke semua Toggle.
    in-out property <string> toggle-style: "classic";
    callback toggle-settings-changed();
    // Paket ikon ("lucide" | "tabler" | "phosphor" | "heroicons" |
    // "feather" | "material") — terikat dua arah ke AppWindow;
    // berlaku ke semua SvgIcon app-wide, live tanpa restart.
    in-out property <string> icon-pack: "lucide";
    callback icon-pack-settings-changed();
    // Sidebar Settings ciut (rail ikon saja) — terikat dua arah ke
    // AppWindow; tersimpan di DB `Settings.SidebarCollapsed`
    // (Bool), default false (terbuka). Live tanpa restart.
    in-out property <bool> sidebar-collapsed: false;
    callback sidebar-collapsed-changed();
    in-out property <bool> notch-voice-enabled: true;
    in-out property <string> notch-voice-name: "";
    in-out property <string> notch-voice-volume: "80";
    in-out property <[string]> notch-voices: [];
    in-out property <[string]> notch-voice-names: [];
    in-out property <int> notch-voice-index: 0;
    // Pet PetDex — terikat dua arah ke AppWindow (diisi Rust saat
    // startup + tiap install/hapus).
    in-out property <[string]> pet-names: [];
    in-out property <[string]> pet-authors: [];
    in-out property <[string]> pet-slugs: [];
    in-out property <[string]> pet-installed-names: [];
    in-out property <[string]> pet-installed-authors: [];
    in-out property <[string]> pet-installed-slugs: [];
    in-out property <int> pet-active-index: 0;
    in-out property <string> pet-install-input: "";
    in-out property <bool> pet-install-busy: false;

    in-out property <string> group: "General";

    // --- Filter search side panel (internal, bukan interface publik) ---
    // Slint 1.19 tidak punya string.contains — substring dicek lewat
    // replace-all: kalau query ada di label, hasil replace != label.
    // Case-insensitive (query di-lowercase, label sudah lowercase).
    property <string> search-q: "";
    property <bool> show-general: root.search-q == "" || "general".replace-all(root.search-q.to-lowercase(), "") != "general";
    property <bool> show-appearance: root.search-q == "" || "appearance".replace-all(root.search-q.to-lowercase(), "") != "appearance";
    property <bool> show-account: root.search-q == "" || "account".replace-all(root.search-q.to-lowercase(), "") != "account" || "trello".replace-all(root.search-q.to-lowercase(), "") != "trello" || "google".replace-all(root.search-q.to-lowercase(), "") != "google";
    property <bool> show-extensions: root.search-q == "" || "extensions".replace-all(root.search-q.to-lowercase(), "") != "extensions" || "plugin".replace-all(root.search-q.to-lowercase(), "") != "plugin";
    property <bool> show-scripts: root.search-q == "" || "scripts".replace-all(root.search-q.to-lowercase(), "") != "scripts" || "master".replace-all(root.search-q.to-lowercase(), "") != "master";
    property <bool> show-paths: root.search-q == "" || "paths".replace-all(root.search-q.to-lowercase(), "") != "paths";
    property <bool> show-about: root.search-q == "" || "about".replace-all(root.search-q.to-lowercase(), "") != "about";
    property <bool> show-profile: root.search-q == "" || "profile".replace-all(root.search-q.to-lowercase(), "") != "profile" || "profil".replace-all(root.search-q.to-lowercase(), "") != "profil" || "nama".replace-all(root.search-q.to-lowercase(), "") != "nama" || "avatar".replace-all(root.search-q.to-lowercase(), "") != "avatar" || "user".replace-all(root.search-q.to-lowercase(), "") != "user";
    property <bool> show-dynamic-island: root.search-q == "" || "dynamic".replace-all(root.search-q.to-lowercase(), "") != "dynamic" || "island".replace-all(root.search-q.to-lowercase(), "") != "island" || "notch".replace-all(root.search-q.to-lowercase(), "") != "notch" || "pet".replace-all(root.search-q.to-lowercase(), "") != "pet" || "voice".replace-all(root.search-q.to-lowercase(), "") != "voice" || "suara".replace-all(root.search-q.to-lowercase(), "") != "suara" || "mata".replace-all(root.search-q.to-lowercase(), "") != "mata";
    property <bool> show-radial: root.search-q == "" || "radial".replace-all(root.search-q.to-lowercase(), "") != "radial" || "menu".replace-all(root.search-q.to-lowercase(), "") != "menu";

    // Kategori sidebar (abeng, 28 Nov 07:05) — kategori tampil bila
    // minimal satu itemnya lolos filter search; label + separator
    // kategori ikut sembunyi bila kosong.
    //   APLIKASI: General, Appearance
    //   AKUN: Profile, Account, Extensions
    //   FITUR: Dynamic Island, Radial Menu
    //   SKRIP & FILE: Script Manager, Paths
    //   INFO: About
    property <bool> cat-app-shown: root.show-general || root.show-appearance;
    property <bool> cat-akun-shown: root.show-profile || root.show-account || root.show-extensions;
    property <bool> cat-fitur-shown: root.show-dynamic-island || root.show-radial;
    property <bool> cat-skrip-shown: root.show-scripts || root.show-paths;
    property <bool> cat-info-shown: root.show-about;

    // --- Account Integration (Trello & Google Spreadsheet) ---
    in-out property <string> trello-api-key: "";
    in-out property <string> trello-token: "";
    // Base URL server board — default API Trello asli; isi alamat
    // Trello kantor bila sudah ada (berlaku langsung tanpa restart).
    in-out property <string> trello-base-url: "https://api.trello.com/1";
    in-out property <bool> trello-connected: false;
    in-out property <string> trello-status: "Belum tersambung ke Trello.";
    in-out property <string> editing-board-id: "";
    in-out property <string> editing-list-id: "";
    in-out property <string> revision-board-id: "";
    in-out property <string> revision-list-id: "";
    in-out property <string> late-board-id: "";
    in-out property <string> late-list-id: "";
    in-out property <string> qc-board-id: "";
    in-out property <string> acc-board-id: "";
    in-out property <string> acc-list-id: "";
    in-out property <string> refresh-editing: "15";
    in-out property <string> refresh-revision: "15";
    in-out property <string> refresh-late: "30";
    in-out property <string> refresh-points: "60";
    in-out property <string> google-creds-path: "credentials.json";
    in-out property <string> google-sheet-id: "";
    in-out property <string> google-sheet-name: "Sheet1";
    in-out property <string> google-sheet-col: "B";
    in-out property <string> google-sheet-row: "12";
    in-out property <string> stat-editing: "0";
    in-out property <string> stat-revision: "0";
    in-out property <string> stat-late: "0";
    in-out property <string> stat-points: "0";
    in-out property <string> spreadsheet-sheet-name: "ALL DATA REGULER";
    in-out property <string> spreadsheet-range: "A1:Z";
    in-out property <string> lb-harian-range: "A2:C10";
    in-out property <string> lb-bulanan-range: "A2:C10";
    callback save-account-settings();

    // --- Appearance (live global theme) ---
    in-out property <string> color-mode: "dark";
    in-out property <string> theme-preset: "bmachine-dark";
    in-out property <color> accent-color: #3b82f6;
    in-out property <string> accent-hex: "#3b82f6";
    in-out property <string> accent-hex-good: "#3b82f6";
    in-out property <color> bg-color: #121212;
    in-out property <string> bg-hex: "#121212";
    in-out property <string> bg-hex-good: "#121212";
    in-out property <color> fg-color: #FFFFFF;
    in-out property <string> fg-hex: "#FFFFFF";
    in-out property <string> fg-hex-good: "#FFFFFF";
    // Warna 4 widget (C# `Settings.Color.*`) — satu palet dibaca
    // semua permukaan (token `Design.cat-*`).
    in-out property <string> widget-editing-hex: "#3b82f6";
    in-out property <string> widget-editing-hex-good: "#3b82f6";
    in-out property <string> widget-revision-hex: "#f97316";
    in-out property <string> widget-revision-hex-good: "#f97316";
    in-out property <string> widget-late-hex: "#ef4444";
    in-out property <string> widget-late-hex-good: "#ef4444";
    in-out property <string> widget-points-hex: "#2dd4bf";
    in-out property <string> widget-points-hex-good: "#2dd4bf";
    // Tema user (array paralel, wholesale replace dari Rust).
    in-out property <[string]> user-theme-ids: [];
    in-out property <[string]> user-theme-names: [];
    in-out property <[color]> user-theme-accents: [];
    in-out property <[color]> user-theme-revisions: [];
    in-out property <[color]> user-theme-bgs: [];
    in-out property <[color]> user-theme-fgs: [];
    in-out property <string> new-user-theme-name: "";
    in-out property <string> font-choice: "Inter";
    in-out property <string> corner-style: "default"; // "sharp" | "default" | "rounded"
    in-out property <string> nav-style: "capsule";    // "capsule" | "rounded" | "flat"
    in-out property <string> ui-density: "normal";   // "compact" | "normal" | "comfortable"
    in-out property <string> chrome: "custom";
    // Gaya tombol kontrol window ("icons" | "dots") + posisinya
    // ("right" | "left") — DB Settings.Chrome.ButtonStyle /
    // Settings.Chrome.ButtonPosition; hanya berpengaruh saat
    // titlebar kustom tampil (chrome "custom" / "wrapped").
    in-out property <string> chrome-button-style: "icons";
    in-out property <string> chrome-button-position: "right";
    // Baris hex responsif (26 Nov): di window sempit (<580px) field
    // mengecil 120→96px dan jarak 8→2px supaya kelima dot tetap muat
    // di konten (lebar konten = root.width − 232px = 288px di 520px);
    // tinggi tetap 36px (swatch/field) + 28px (dot) di semua lebar —
    // garis atas/bawah baris tetap lurus.
    property <bool> hex-compact: root.width < 580px;

    // Baris setting menumpuk saat konten sempit (abeng, 28 Nov
    // 10:01): label kiri + kontrol kanan hanya bila konten cukup
    // lebar; di bawah 560px (window compact 520 — konten 288px
    // sidebar terbuka / 412px sidebar ciut) label di atas + kontrol
    // di bawah. Prinsip umum: semua view matang dari 520 ke besar.
    property <bool> stacked: content-rect.width < 560px;

    // Dropdown preset tema (abeng, 28 Nov 09:57): daftar 8+ baris
    // boros tempat → satu field dropdown; keadaan tertutup
    // menampilkan nama preset aktif + 4 dot paletnya.
    property <bool> theme-dropdown-open: false;
    // Nama preset aktif (bawaan + Custom); tema user ("") ditampilkan
    // lewat `for` di field dropdown (nama diambil dari array).
    property <string> theme-cur-name: root.theme-preset == "bmachine-dark" ? "BMachine Dark"
        : root.theme-preset == "bmachine-light" ? "BMachine Light"
        : root.theme-preset == "midnight-oled" ? "Midnight OLED"
        : root.theme-preset == "catppuccin-mocha" ? "Catppuccin Mocha"
        : root.theme-preset == "emerald-studio" ? "Emerald Studio"
        : root.theme-preset == "spider" ? "Spider Red"
        : root.theme-preset == "gwen" ? "Gwen Pink"
        : root.theme-preset == "armor" ? "Armor Red"
        : root.theme-preset == "custom" ? "Custom" : "";

    // --- General ---
    in-out property <string> user-name: "USER";
    // Huruf pertama nama user (avatar) — terikat dua arah ke AppWindow.
    in-out property <string> user-initial: "U";
    in-out property <string> lang: "Indonesia";
    in-out property <bool> anim-startup: true;
    in-out property <string> anim-speed: "Normal";
    in-out property <string> trello-interval: "60";
    // --- General (C# SettingsView.axaml:579-660) ---
    in-out property <string> batch-file-filter: "";

    // --- Paths ---
    in-out property <string> path-local: "";
    in-out property <string> path-okebase: "";
    in-out property <string> path-photoshop: "";
    in-out property <string> path-pasfoto: "";
    in-out property <string> path-manasik: "";
    in-out property <string> path-wisuda: "";
    in-out property <string> path-profesi: "";

    // Warna preview (dihitung dari pilihan di atas).
    property <color> pv-bg: root.color-mode == "light" ? #F2F2F2 : root.bg-color;
    property <color> pv-fg: root.color-mode == "light" ? #111111 : root.fg-color;
    property <color> pv-card: root.color-mode == "light" ? #FFFFFF : #232326;
    property <color> pv-accent: root.accent-color;
    property <color> pv-muted: root.color-mode == "light" ? #71717A : Design.text-muted;

    // Tinggi area isi (judul 18px + spacing + padding bawah) — eksplisit,
    // bukan stretch: rantai height: 100% + stretch pernah membuat tinggi
    // konten jatuh ke preferred-height dan isi terdorong ke bawah (26 Nov).
    // 30px = padding-bottom (header "SETTINGS" di atas konten
    // dihapus 26 Nov — duplikat judul panel).
    property <length> body-h: root.height - 30px;

    // Lebar sidebar: 180px terbuka, 56px saat ciut (rail ikon —
    // ref settings-collapse-ref.jpg). Dipakai sidebar + lebar
    // konten (root.width − sidebar-w − spacing 12 − padding 40).
    property <length> sidebar-w: root.sidebar-collapsed ? 56px : 180px;

    // Klik kanan = kembali ke dashboard (C# OnEmbeddedViewPointerPressed:
    // klik kanan = NavigateBack). TouchArea latar di belakang isi.
    settings-back-touch := TouchArea {
        width: 100%; height: 100%;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.back();
            }
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: Design.space-xl;
        padding-right: Design.space-xl;
        padding-bottom: 30px;
        spacing: Design.space-md;

        HorizontalLayout {
            height: root.body-h;
            spacing: Design.space-md;

            // ----- Side panel grup -----
            // Sidebar POLOS tanpa panel sendiri di semua mode chrome
            // (abeng, 28 Nov 07:09, dikonfirmasi 07:11 "yq mungkin
            // gitu"): HANYA konten yang dapat panel rounded, seperti
            // referensi (settings-rounded-content-ref.jpg). Saat
            // chrome "wrapped" sidebar duduk di area frame; saat
            // bukan wrapped sidebar duduk di atas background window
            // — keduanya transparan, tanpa kartu/border. (Build
            // 4f0696f salah memberi sidebar kartu rounded sendiri
            // sehingga tampil dua panel berdampingan.)
            Rectangle {
                width: root.sidebar-w;
                height: root.body-h;
                background: transparent;
                border-width: 0px;
                clip: true;
                VerticalLayout {
                    padding: Design.space-md;
                    spacing: 2px;
                    // Judul panel (18px/800, pola gambar referensi).
                    // Disembunyikan saat sidebar ciut (tinggi 0 +
                    // visible false — visible saja tetap makan ruang).
                    Text {
                        text: "Settings";
                        font-size: Design.font-h2;
                        font-weight: 800;
                        color: Design.text-primary;
                        vertical-alignment: center;
                        height: root.sidebar-collapsed ? 0px : 30px;
                        visible: !root.sidebar-collapsed;
                    }
                    // Search bar: glyph ⌕ + TextInput + placeholder.
                    // TextField tidak dipakai di sini — input-nya butuh
                    // glyph di dalam bar, dan TextInput-nya TextField
                    // mulai di x:10 (akan tertutup glyph).
                    // Disembunyikan saat sidebar ciut (filter tetap
                    // jalan kalau query sudah terisi).
                    search-box := Rectangle {
                        height: root.sidebar-collapsed ? 0px : 36px;
                        visible: !root.sidebar-collapsed;
                        background: Design.bg-input;
                        border-color: search-input.has-focus ? Design.border-focus : Design.border-default;
                        border-width: 1px;
                        border-radius: Design.radius-sm;
                        clip: true;
                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                SvgIcon {
                                    name: "search";
                                    size: 14px;
                                    icon-color: Design.text-muted;
                                }
                            }
                            search-input := TextInput {
                                horizontal-stretch: 1;
                                text: root.search-q;
                                font-size: Design.font-body;
                                color: Design.text-primary;
                                selection-foreground-color: white;
                                selection-background-color: Design.accent;
                                vertical-alignment: center;
                                edited => { root.search-q = self.text; }
                            }
                        }
                        Text {
                            text: "Search";
                            font-size: Design.font-body;
                            color: Design.text-muted;
                            vertical-alignment: center;
                            x: 32px;
                            height: 100%;
                            visible: root.search-q == "" && !search-input.has-focus;
                        }
                    }
                    Rectangle { height: root.sidebar-collapsed ? 0px : 8px; }
                    // Daftar grup di-scroll (Flickable) — 10 grup + 5
                    // kategori tidak muat di tinggi window default 640px
                    // (About + tombol Ciutkan terpotong); judul, search,
                    // dan tombol Ciutkan tetap di tempat.
                    sidebar-scroll := Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            width: sidebar-scroll.width;
                            spacing: 2px;
                            // Kategori APLIKASI.
                            SidebarCategoryLabel {
                                label: "APLIKASI";
                                shown: root.cat-app-shown;
                                collapsed: root.sidebar-collapsed;
                            }
                            GroupRow {
                                icon: "settings";
                                label: "General";
                                selected: root.group == "General";
                                shown: root.show-general;
                                collapsed: root.sidebar-collapsed;
                                clicked => { root.group = "General"; }
                            }
                            GroupRow {
                                icon: "sun";
                                label: "Appearance";
                                selected: root.group == "Appearance";
                                shown: root.show-appearance;
                                collapsed: root.sidebar-collapsed;
                                clicked => { root.group = "Appearance"; }
                            }
                            // Kategori AKUN.
                            SidebarSeparator { shown: root.cat-app-shown && root.cat-akun-shown; }
                            SidebarCategoryLabel {
                                label: "AKUN";
                                shown: root.cat-akun-shown;
                                collapsed: root.sidebar-collapsed;
                            }
                            GroupRow {
                                icon: "user";
                                label: "Profile";
                                selected: root.group == "Profile";
                                shown: root.show-profile;
                                collapsed: root.sidebar-collapsed;
                                clicked => { root.group = "Profile"; }
                            }
                            GroupRow {
                                icon: "grid";
                                label: "Account";
                                selected: root.group == "Account";
                                shown: root.show-account;
                                collapsed: root.sidebar-collapsed;
                                clicked => { root.group = "Account"; }
                            }
                            GroupRow {
                                icon: "puzzle";
                                label: "Extensions";
                                selected: root.group == "Extensions";
                                shown: root.show-extensions;
                                collapsed: root.sidebar-collapsed;
                                clicked => { root.group = "Extensions"; }
                            }
                            // Kategori FITUR (grup khusus per fitur — abeng 28 Nov 11:04).
                            SidebarSeparator { shown: root.cat-akun-shown && root.cat-fitur-shown; }
                            SidebarCategoryLabel {
                                label: "FITUR";
                                shown: root.cat-fitur-shown;
                                collapsed: root.sidebar-collapsed;
                            }
                            GroupRow {
                                icon: "layers";
                                label: "Dynamic Island";
                                selected: root.group == "Dynamic Island";
                                shown: root.show-dynamic-island;
                                collapsed: root.sidebar-collapsed;
                                clicked => { root.group = "Dynamic Island"; }
                            }
                            GroupRow {
                                icon: "rotate-cw";
                                label: "Radial Menu";
                                selected: root.group == "Radial Menu";
                                shown: root.show-radial;
                                collapsed: root.sidebar-collapsed;
                                clicked => { root.group = "Radial Menu"; }
                            }
                            // Kategori SKRIP & FILE.
                            SidebarSeparator { shown: root.cat-fitur-shown && root.cat-skrip-shown; }
                            SidebarCategoryLabel {
                                label: "SKRIP & FILE";
                                shown: root.cat-skrip-shown;
                                collapsed: root.sidebar-collapsed;
                            }
                            GroupRow {
                                icon: "zap";
                                label: "Script Manager";
                                selected: root.group == "Script Manager";
                                shown: root.show-scripts;
                                collapsed: root.sidebar-collapsed;
                                clicked => { root.group = "Script Manager"; }
                            }
                            GroupRow {
                                icon: "folder-open";
                                label: "Paths";
                                selected: root.group == "Paths";
                                shown: root.show-paths;
                                collapsed: root.sidebar-collapsed;
                                clicked => { root.group = "Paths"; }
                            }
                            // Kategori INFO.
                            SidebarSeparator { shown: root.cat-skrip-shown && root.cat-info-shown; }
                            SidebarCategoryLabel {
                                label: "INFO";
                                shown: root.cat-info-shown;
                                collapsed: root.sidebar-collapsed;
                            }
                            GroupRow {
                                icon: "info";
                                label: "About";
                                selected: root.group == "About";
                                shown: root.show-about;
                                collapsed: root.sidebar-collapsed;
                                clicked => { root.group = "About"; }
                            }
                        }
                    }
                    // (Spacer lama dihapus — Flickable di atas sudah
                    // vertical-stretch: 1 sehingga tombol Ciutkan
                    // tetap terdorong ke bawah sidebar.)
                    // Tombol ciutkan/lebarkan sidebar (rail ikon saja
                    // saat ciut — ref settings-collapse-ref.jpg).
                    // Selalu terlihat (ikon saja saat ciut).
                    collapse-btn := Rectangle {
                        height: 36px;
                        background: collapse-touch.has-hover ? Design.bg-hover : transparent;
                        border-radius: Design.radius-sm;
                        collapse-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.sidebar-collapsed = !root.sidebar-collapsed;
                                root.sidebar-collapsed-changed();
                            }
                        }
                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            padding-left: root.sidebar-collapsed ? 0px : 12px;
                            padding-right: root.sidebar-collapsed ? 0px : 12px;
                            spacing: 10px;
                            alignment: root.sidebar-collapsed ? center : start;
                            VerticalLayout {
                                alignment: center;
                                SvgIcon {
                                    name: root.sidebar-collapsed ? "arrow-right" : "arrow-left";
                                    size: 15px;
                                    icon-color: Design.text-secondary;
                                }
                            }
                            if !root.sidebar-collapsed : Text {
                                text: "Ciutkan";
                                font-size: Design.font-body;
                                font-weight: 600;
                                color: Design.text-secondary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }

            // ----- Konten grup (menumpuk; tiap grup Flickable sendiri
            // supaya konten panjang bisa di-scroll di window kecil) -----
            // Lebar EKSPLISIT (window − side panel − spacing 12 −
            // padding 40): horizontal-stretch di Rectangle berisi
            // Flickable tidak mengembang di Slint ini — sisa ruang malah
            // jadi gap di tengah (terlihat di 520px, 26 Nov).
            content-rect := Rectangle {
                // Panel konten rounded (ref
                // settings-rounded-content-ref.jpg) — dilewati saat
                // chrome "wrapped": konten = panel window itu sendiri
                // (anti double-wrap §23), sama seperti sidebar di atas.
                width: root.width - root.sidebar-w - 52px;
                height: root.body-h;
                background: root.chrome == "wrapped" ? transparent : Design.card-bg;
                border-color: Design.separator;
                border-width: root.chrome == "wrapped" ? 0px : 1px;
                border-radius: Design.radius-lg;
                clip: true;

                // ===== APPEARANCE =====
                sv-appearance := Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.group == "Appearance";
                    VerticalLayout {
                        x: 0; width: content-rect.width;
                        // Isi rapat di atas (alignment start): tanpa ini,
                        // konten yang lebih pendek dari viewport
                        // direnggangkan ke tinggi penuh (ruang ekstra
                        // dibagi ke anak-anak) — lih. DESIGN_SYSTEM §17.4.
                        alignment: start;
                        spacing: Design.space-lg;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 16px;
                        padding-bottom: Design.space-lg;

                        Text {
                            text: "Visual style";
                            font-size: Design.font-h3;
                            font-weight: 800;
                            color: Design.text-primary;
                        }

                        // Color mode.
                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel {
                                title: "Color mode";
                                desc: "Use light or dark colors, or follow your system setting";
                            }
                            HorizontalLayout {
                                height: 118px;
                                spacing: Design.space-sm;
                                ColorModeCard {
                                    mode: "light";
                                    horizontal-stretch: 1;
                                    selected: root.color-mode == "light";
                                    clicked => {
                                        root.color-mode = "light";
                                        if (root.bg-hex == "#121212" || root.bg-hex == "#191919" || root.bg-hex == "#000000" || root.bg-hex == "#1E1E2E") {
                                            root.bg-hex = "#F5F5F5"; root.bg-hex-good = "#F5F5F5"; root.bg-color = #F5F5F5;
                                            root.fg-hex = "#111111"; root.fg-hex-good = "#111111"; root.fg-color = #111111;
                                        }
                                        root.appearance-changed();
                                        root.toast("Tema Terang diterapkan");
                                    }
                                }
                                ColorModeCard {
                                    mode: "dark";
                                    horizontal-stretch: 1;
                                    selected: root.color-mode == "dark";
                                    clicked => {
                                        root.color-mode = "dark";
                                        if (root.bg-hex == "#F5F5F5" || root.bg-hex == "#FFFFFF") {
                                            root.bg-hex = "#121212"; root.bg-hex-good = "#121212"; root.bg-color = #121212;
                                            root.fg-hex = "#FFFFFF"; root.fg-hex-good = "#FFFFFF"; root.fg-color = #FFFFFF;
                                        }
                                        root.appearance-changed();
                                        root.toast("Tema Gelap diterapkan");
                                    }
                                }
                                ColorModeCard {
                                    mode: "system";
                                    horizontal-stretch: 1;
                                    selected: root.color-mode == "system";
                                    clicked => {
                                        root.color-mode = "system";
                                        root.appearance-changed();
                                        root.toast("Tema mengikuti sistem");
                                    }
                                }
                            }
                        }

                        // Theme preset — DROPDOWN (abeng, 28 Nov 09:57:
                        // daftar 8+ baris boros tempat). Palet penuh
                        // (mode + aksen + bg + fg + 4 warna widget)
                        // didefinisikan SATU tempat di Rust
                        // (`theme.rs::builtin_presets`) — klik di sini
                        // hanya memanggil id-nya, Rust yang menerapkan +
                        // menyimpan. Field tertutup menampilkan nama
                        // preset aktif + 4 dot paletnya (aksen,
                        // revisi/sekunder, background, foreground —
                        // sama seperti baris Custom). Daftar in-flow
                        // (bukan popup overlay — pola ComboBox):
                        // terbuka mendorong konten ke bawah.
                        SettingRow {
                            title: "Theme";
                            desc: "Start with a preset, then adjust its colors and fonts";
                            stacked: root.stacked;
                            VerticalLayout {
                                spacing: 4px;
                                // Lebar: 360px saat lebar, penuh saat
                                // menumpuk. Tinggi = field 36px +
                                // daftar bila terbuka (9 baris bawaan +
                                // tema user). `preferred-height` WAJIB
                                // sama dengan `height` (pola ComboBox —
                                // layout Slint tidak memakai binding
                                // `height` untuk mengukur baris induk).
                                width: root.stacked ? parent.width : 360px;
                                height: 36px + (root.theme-dropdown-open ? 4px + (9 + root.user-theme-ids.length) * 36px : 0px);
                                preferred-height: 36px + (root.theme-dropdown-open ? 4px + (9 + root.user-theme-ids.length) * 36px : 0px);
                                // Field tertutup.
                                Rectangle {
                                    height: 36px;
                                    background: Design.bg-input;
                                    border-color: root.theme-dropdown-open ? Design.border-focus : Design.border-default;
                                    border-width: 1px;
                                    border-radius: Design.radius-sm;
                                    dd-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.theme-dropdown-open = !root.theme-dropdown-open; }
                                    }
                                    Text {
                                        x: 12px;
                                        width: parent.width - 122px;
                                        height: 100%;
                                        text: root.theme-cur-name;
                                        font-size: Design.font-body;
                                        font-weight: 600;
                                        color: Design.text-primary;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    // Nama tema user (hanya yang aktif
                                    // yang tampil; Rectangle kosong lebar
                                    // 0 bila tidak cocok — `if` tidak bisa
                                    // langsung mengikuti `for` di Slint).
                                    for ut[i] in root.user-theme-ids : Rectangle {
                                        x: 12px;
                                        height: 100%;
                                        clip: true;
                                        if root.theme-preset == ut : Text {
                                            text: root.user-theme-names[i];
                                            font-size: Design.font-body;
                                            font-weight: 600;
                                            color: Design.text-primary;
                                            vertical-alignment: center;
                                            height: 100%;
                                        }
                                    }
                                    // 4 dot palet preset aktif.
                                    Rectangle { x: parent.width - 102px; y: 12px; width: 12px; height: 12px; background: root.accent-color; border-color: Design.border-hover; border-width: 1px; border-radius: 999px; }
                                    Rectangle { x: parent.width - 86px; y: 12px; width: 12px; height: 12px; background: Design.cat-revision; border-color: Design.border-hover; border-width: 1px; border-radius: 999px; }
                                    Rectangle { x: parent.width - 70px; y: 12px; width: 12px; height: 12px; background: root.bg-color; border-color: Design.border-hover; border-width: 1px; border-radius: 999px; }
                                    Rectangle { x: parent.width - 54px; y: 12px; width: 12px; height: 12px; background: root.fg-color; border-color: Design.border-hover; border-width: 1px; border-radius: 999px; }
                                    SvgIcon {
                                        x: parent.width - 26px;
                                        y: (parent.height - self.height) / 2;
                                        name: "chevron-down";
                                        size: 14px;
                                        icon-color: Design.text-muted;
                                    }
                                }
                                // Daftar opsi (hanya saat terbuka).
                                if root.theme-dropdown-open : Rectangle {
                                    background: Design.surface-elevated;
                                    border-color: Design.border-default;
                                    border-width: 1px;
                                    border-radius: Design.radius-sm;
                                    clip: true;
                                    height: (9 + root.user-theme-ids.length) * 36px;
                                    VerticalLayout {
                                        ThemeRow {
                                            label: "BMachine Dark";
                                            sw1: #3b82f6; sw2: #f97316; sw3: #121212; sw4: #FFFFFF;
                                            selected: root.theme-preset == "bmachine-dark";
                                            clicked => { root.theme-dropdown-open = false; root.apply-theme-preset("bmachine-dark"); }
                                        }
                                        ThemeRow {
                                            label: "BMachine Light";
                                            sw1: #3b82f6; sw2: #f97316; sw3: #F5F5F5; sw4: #111111;
                                            selected: root.theme-preset == "bmachine-light";
                                            clicked => { root.theme-dropdown-open = false; root.apply-theme-preset("bmachine-light"); }
                                        }
                                        ThemeRow {
                                            label: "Midnight OLED";
                                            sw1: #38BDF8; sw2: #f97316; sw3: #000000; sw4: #F8FAFC;
                                            selected: root.theme-preset == "midnight-oled";
                                            clicked => { root.theme-dropdown-open = false; root.apply-theme-preset("midnight-oled"); }
                                        }
                                        ThemeRow {
                                            label: "Catppuccin Mocha";
                                            sw1: #CBA6F7; sw2: #FAB387; sw3: #1E1E2E; sw4: #CDD6F4;
                                            selected: root.theme-preset == "catppuccin-mocha";
                                            clicked => { root.theme-dropdown-open = false; root.apply-theme-preset("catppuccin-mocha"); }
                                        }
                                        ThemeRow {
                                            label: "Emerald Studio";
                                            sw1: #10B981; sw2: #F59E0B; sw3: #0F1715; sw4: #ECFDF5;
                                            selected: root.theme-preset == "emerald-studio";
                                            clicked => { root.theme-dropdown-open = false; root.apply-theme-preset("emerald-studio"); }
                                        }
                                        ThemeRow {
                                            label: "Spider Red";
                                            sw1: #D9272E; sw2: #1557A5; sw3: #171717; sw4: #FFFFFF;
                                            selected: root.theme-preset == "spider";
                                            clicked => { root.theme-dropdown-open = false; root.apply-theme-preset("spider"); }
                                        }
                                        ThemeRow {
                                            label: "Gwen Pink";
                                            sw1: #F2A2C0; sw2: #65D6D6; sw3: #24242E; sw4: #FFFFFF;
                                            selected: root.theme-preset == "gwen";
                                            clicked => { root.theme-dropdown-open = false; root.apply-theme-preset("gwen"); }
                                        }
                                        ThemeRow {
                                            label: "Armor Red";
                                            sw1: #A71930; sw2: #D9A52E; sw3: #252525; sw4: #FFFFFF;
                                            selected: root.theme-preset == "armor";
                                            clicked => { root.theme-dropdown-open = false; root.apply-theme-preset("armor"); }
                                        }
                                        ThemeRow {
                                            label: "Custom";
                                            sw1: root.accent-color; sw2: Design.cat-revision; sw3: root.bg-color; sw4: root.fg-color;
                                            selected: root.theme-preset == "custom";
                                            clicked => {
                                                root.theme-dropdown-open = false;
                                                root.theme-preset = "custom";
                                                root.appearance-changed();
                                                root.toast("Mode Custom aktif — ubah warna atau font di bawah");
                                            }
                                        }
                                        for ut2[j] in root.user-theme-ids : ThemeRow {
                                            label: root.user-theme-names[j];
                                            sw1: root.user-theme-accents[j];
                                            sw2: root.user-theme-revisions[j];
                                            sw3: root.user-theme-bgs[j];
                                            sw4: root.user-theme-fgs[j];
                                            selected: root.theme-preset == ut2;
                                            deletable: true;
                                            clicked => { root.theme-dropdown-open = false; root.apply-user-theme(ut2); }
                                            delete => { root.delete-user-theme(ut2); }
                                        }
                                    }
                                }
                            }
                        }

                        // Tema saya — tema buatan user (SQLite
                        // `Settings.Theme.UserThemes`, JSON). Daftar tema
                        // tersimpan tampil di dalam dropdown Theme di
                        // atas (klik untuk memakai, × untuk menghapus).
                        // Di sini tinggal simpan tampilan saat ini
                        // sebagai tema baru. Override user melapisi
                        // preset bawaan; ubah warna manual saat tema
                        // user aktif → jadi Custom (tema yang tersimpan
                        // tidak berubah sampai disimpan ulang).
                        SettingRow {
                            title: "Tema saya";
                            desc: "Simpan tampilan saat ini sebagai tema buatan sendiri";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: Design.space-sm;
                                width: root.stacked ? parent.width : 360px;
                                height: 36px;
                                TextField {
                                    horizontal-stretch: 1;
                                    text <=> root.new-user-theme-name;
                                    placeholder: "Nama tema baru…";
                                    edited(text) => { root.new-user-theme-name = text; }
                                    accepted(text) => { root.save-user-theme(text); }
                                }
                                Btn {
                                    label: "Simpan tema";
                                    variant: "primary";
                                    clicked => { root.save-user-theme(root.new-user-theme-name); }
                                }
                            }
                        }

                        // Kepadatan (C# `Settings.UiDensity`:
                        // Compact / Normal / Comfortable — ukuran tombol
                        // & ikon). Diterapkan lewat token font + spacing
                        // — langsung berlaku tanpa restart.
                        SettingRow {
                            title: "Kepadatan";
                            desc: "Ukuran tombol, ikon, dan teks — Compact untuk layar kecil, Comfortable untuk sentuhan yang lebih longgar";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 6px;
                                OptionChip {
                                    label: "Compact";
                                    horizontal-stretch: 1;
                                    selected: root.ui-density == "compact";
                                    clicked => { root.ui-density = "compact"; root.appearance-changed(); root.toast("Kepadatan: Compact"); }
                                }
                                OptionChip {
                                    label: "Normal";
                                    horizontal-stretch: 1;
                                    selected: root.ui-density == "normal";
                                    clicked => { root.ui-density = "normal"; root.appearance-changed(); root.toast("Kepadatan: Normal"); }
                                }
                                OptionChip {
                                    label: "Comfortable";
                                    horizontal-stretch: 1;
                                    selected: root.ui-density == "comfortable";
                                    clicked => { root.ui-density = "comfortable"; root.appearance-changed(); root.toast("Kepadatan: Comfortable"); }
                                }
                            }
                        }

                        // Accent.
                        SettingRow {
                            title: "Accent";
                            desc: "Set the color for highlights and selected controls (ketik #RRGGBB + Enter)";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: root.stacked ? 2px : root.hex-compact ? 2px : 8px;
                                height: 36px;
                                Rectangle {
                                    width: 36px; height: 36px;
                                    background: root.accent-color;
                                    border-color: Design.border-hover;
                                    border-width: 1px;
                                    border-radius: Design.radius-sm;
                                }
                                TextField {
                                    width: root.stacked ? 80px : root.hex-compact ? 96px : 120px;
                                    text <=> root.accent-hex;
                                    placeholder: "#3b82f6";
                                    edited(text) => { root.accent-hex = text; }
                                    accepted(text) => {
                                        root.theme-preset = "custom";
                                        root.accent-hex = text;
                                        root.appearance-changed();
                                    }
                                }
                                SwatchDot {
                                    swatch: #3b82f6;
                                    compact: root.stacked;
                                    selected: root.accent-color == #3b82f6;
                                    clicked => { root.theme-preset = "custom"; root.accent-color = #3b82f6; root.accent-hex = "#3b82f6"; root.accent-hex-good = "#3b82f6"; root.appearance-changed(); root.toast("Accent #3b82f6 diterapkan"); }
                                }
                                SwatchDot {
                                    swatch: #339CFF;
                                    compact: root.stacked;
                                    selected: root.accent-color == #339CFF;
                                    clicked => { root.theme-preset = "custom"; root.accent-color = #339CFF; root.accent-hex = "#339CFF"; root.accent-hex-good = "#339CFF"; root.appearance-changed(); root.toast("Accent #339CFF diterapkan"); }
                                }
                                SwatchDot {
                                    swatch: #f97316;
                                    compact: root.stacked;
                                    selected: root.accent-color == #f97316;
                                    clicked => { root.theme-preset = "custom"; root.accent-color = #f97316; root.accent-hex = "#f97316"; root.accent-hex-good = "#f97316"; root.appearance-changed(); root.toast("Accent #f97316 diterapkan"); }
                                }
                                SwatchDot {
                                    swatch: #2dd4bf;
                                    compact: root.stacked;
                                    selected: root.accent-color == #2dd4bf;
                                    clicked => { root.theme-preset = "custom"; root.accent-color = #2dd4bf; root.accent-hex = "#2dd4bf"; root.accent-hex-good = "#2dd4bf"; root.appearance-changed(); root.toast("Accent #2dd4bf diterapkan"); }
                                }
                                SwatchDot {
                                    swatch: #8B5CF6;
                                    compact: root.stacked;
                                    selected: root.accent-color == #8B5CF6;
                                    clicked => { root.theme-preset = "custom"; root.accent-color = #8B5CF6; root.accent-hex = "#8B5CF6"; root.accent-hex-good = "#8B5CF6"; root.appearance-changed(); root.toast("Accent #8B5CF6 diterapkan"); }
                                }
                            }
                        }

                        // Background.
                        SettingRow {
                            title: "Background";
                            desc: "Set the color behind app content (ketik #RRGGBB + Enter)";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: root.stacked ? 2px : root.hex-compact ? 2px : 8px;
                                height: 36px;
                                Rectangle {
                                    width: 36px; height: 36px;
                                    background: root.bg-color;
                                    border-color: Design.border-hover;
                                    border-width: 1px;
                                    border-radius: Design.radius-sm;
                                }
                                TextField {
                                    width: root.stacked ? 80px : root.hex-compact ? 96px : 120px;
                                    text <=> root.bg-hex;
                                    placeholder: "#121212";
                                    edited(text) => { root.bg-hex = text; }
                                    accepted(text) => {
                                        root.theme-preset = "custom";
                                        root.bg-hex = text;
                                        root.appearance-changed();
                                    }
                                }
                                SwatchDot {
                                    swatch: #121212;
                                    compact: root.stacked;
                                    selected: root.bg-color == #121212;
                                    clicked => { root.theme-preset = "custom"; root.bg-color = #121212; root.bg-hex = "#121212"; root.bg-hex-good = "#121212"; root.appearance-changed(); root.toast("Background #121212 diterapkan"); }
                                }
                                SwatchDot {
                                    swatch: #000000;
                                    compact: root.stacked;
                                    selected: root.bg-color == #000000;
                                    clicked => { root.theme-preset = "custom"; root.bg-color = #000000; root.bg-hex = "#000000"; root.bg-hex-good = "#000000"; root.appearance-changed(); root.toast("Background #000000 diterapkan"); }
                                }
                                SwatchDot {
                                    swatch: #1A1C20;
                                    compact: root.stacked;
                                    selected: root.bg-color == #1A1C20;
                                    clicked => { root.theme-preset = "custom"; root.bg-color = #1A1C20; root.bg-hex = "#1A1C20"; root.bg-hex-good = "#1A1C20"; root.appearance-changed(); root.toast("Background #1A1C20 diterapkan"); }
                                }
                                SwatchDot {
                                    swatch: #F5F5F5;
                                    compact: root.stacked;
                                    selected: root.bg-color == #F5F5F5;
                                    clicked => { root.theme-preset = "custom"; root.bg-color = #F5F5F5; root.bg-hex = "#F5F5F5"; root.bg-hex-good = "#F5F5F5"; root.appearance-changed(); root.toast("Background #F5F5F5 diterapkan"); }
                                }
                                SwatchDot {
                                    swatch: #FFFFFF;
                                    compact: root.stacked;
                                    selected: root.bg-color == #FFFFFF;
                                    clicked => { root.theme-preset = "custom"; root.bg-color = #FFFFFF; root.bg-hex = "#FFFFFF"; root.bg-hex-good = "#FFFFFF"; root.appearance-changed(); root.toast("Background #FFFFFF diterapkan"); }
                                }
                            }
                        }

                        // Foreground.
                        SettingRow {
                            title: "Foreground";
                            desc: "Choose the main text color (ketik #RRGGBB + Enter)";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: root.stacked ? 2px : root.hex-compact ? 2px : 8px;
                                height: 36px;
                                Rectangle {
                                    width: 36px; height: 36px;
                                    background: root.fg-color;
                                    border-color: Design.border-hover;
                                    border-width: 1px;
                                    border-radius: Design.radius-sm;
                                }
                                TextField {
                                    width: root.stacked ? 80px : root.hex-compact ? 96px : 120px;
                                    text <=> root.fg-hex;
                                    placeholder: "#FFFFFF";
                                    edited(text) => { root.fg-hex = text; }
                                    accepted(text) => {
                                        root.theme-preset = "custom";
                                        root.fg-hex = text;
                                        root.appearance-changed();
                                    }
                                }
                                SwatchDot {
                                    swatch: #FFFFFF;
                                    compact: root.stacked;
                                    selected: root.fg-color == #FFFFFF;
                                    clicked => { root.theme-preset = "custom"; root.fg-color = #FFFFFF; root.fg-hex = "#FFFFFF"; root.fg-hex-good = "#FFFFFF"; root.appearance-changed(); root.toast("Foreground #FFFFFF diterapkan"); }
                                }
                                SwatchDot {
                                    swatch: #111111;
                                    compact: root.stacked;
                                    selected: root.fg-color == #111111;
                                    clicked => { root.theme-preset = "custom"; root.fg-color = #111111; root.fg-hex = "#111111"; root.fg-hex-good = "#111111"; root.appearance-changed(); root.toast("Foreground #111111 diterapkan"); }
                                }
                                SwatchDot {
                                    swatch: #E4E4E7;
                                    compact: root.stacked;
                                    selected: root.fg-color == #E4E4E7;
                                    clicked => { root.theme-preset = "custom"; root.fg-color = #E4E4E7; root.fg-hex = "#E4E4E7"; root.fg-hex-good = "#E4E4E7"; root.appearance-changed(); root.toast("Foreground #E4E4E7 diterapkan"); }
                                }
                                SwatchDot {
                                    swatch: #999999;
                                    compact: root.stacked;
                                    selected: root.fg-color == #999999;
                                    clicked => { root.theme-preset = "custom"; root.fg-color = #999999; root.fg-hex = "#999999"; root.fg-hex-good = "#999999"; root.appearance-changed(); root.toast("Foreground #999999 diterapkan"); }
                                }
                                SwatchDot {
                                    swatch: #3b82f6;
                                    compact: root.stacked;
                                    selected: root.fg-color == #3b82f6;
                                    clicked => { root.theme-preset = "custom"; root.fg-color = #3b82f6; root.fg-hex = "#3b82f6"; root.fg-hex-good = "#3b82f6"; root.appearance-changed(); root.toast("Foreground #3b82f6 diterapkan"); }
                                }
                            }
                        }

                        // Warna widget (C# `Settings.Color.*`) — warna
                        // 4 kartu statistik + aksen kategori di Trello /
                        // spreadsheet / explorer. Termasuk dalam palet
                        // tema: preset mengaturnya, ubah di sini → Custom.
                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel {
                                title: "Warna widget";
                                desc: "Warna kartu EDITING / REVISION / LATE / POINTS (ketik #RRGGBB + Enter)";
                            }
                            WidgetColorRow {
                                label: "EDITING";
                                stacked: root.stacked;
                                dot-color: Design.cat-editing;
                                hex <=> root.widget-editing-hex;
                                swatches: [#3b82f6, #D9272E, #10B981, #8B5CF6];
                                swatch-hexes: ["#3b82f6", "#D9272E", "#10B981", "#8B5CF6"];
                                hex-edited(text) => { root.widget-editing-hex = text; }
                                hex-accepted(text) => { root.theme-preset = "custom"; root.widget-editing-hex = text; root.appearance-changed(); }
                                swatch-picked(hex) => { root.theme-preset = "custom"; root.widget-editing-hex = hex; root.widget-editing-hex-good = hex; root.appearance-changed(); root.toast("Warna EDITING " + hex + " diterapkan"); }
                            }
                            WidgetColorRow {
                                label: "REVISION";
                                stacked: root.stacked;
                                dot-color: Design.cat-revision;
                                hex <=> root.widget-revision-hex;
                                swatches: [#f97316, #1557A5, #65D6D6, #D9A52E];
                                swatch-hexes: ["#f97316", "#1557A5", "#65D6D6", "#D9A52E"];
                                hex-edited(text) => { root.widget-revision-hex = text; }
                                hex-accepted(text) => { root.theme-preset = "custom"; root.widget-revision-hex = text; root.appearance-changed(); }
                                swatch-picked(hex) => { root.theme-preset = "custom"; root.widget-revision-hex = hex; root.widget-revision-hex-good = hex; root.appearance-changed(); root.toast("Warna REVISION " + hex + " diterapkan"); }
                            }
                            WidgetColorRow {
                                label: "LATE";
                                stacked: root.stacked;
                                dot-color: Design.cat-late;
                                hex <=> root.widget-late-hex;
                                swatches: [#ef4444, #D62828, #f97316, #8B5CF6];
                                swatch-hexes: ["#ef4444", "#D62828", "#f97316", "#8B5CF6"];
                                hex-edited(text) => { root.widget-late-hex = text; }
                                hex-accepted(text) => { root.theme-preset = "custom"; root.widget-late-hex = text; root.appearance-changed(); }
                                swatch-picked(hex) => { root.theme-preset = "custom"; root.widget-late-hex = hex; root.widget-late-hex-good = hex; root.appearance-changed(); root.toast("Warna LATE " + hex + " diterapkan"); }
                            }
                            WidgetColorRow {
                                label: "POINTS";
                                stacked: root.stacked;
                                dot-color: Design.cat-points;
                                hex <=> root.widget-points-hex;
                                swatches: [#2dd4bf, #10B981, #3b82f6, #D9A52E];
                                swatch-hexes: ["#2dd4bf", "#10B981", "#3b82f6", "#D9A52E"];
                                hex-edited(text) => { root.widget-points-hex = text; }
                                hex-accepted(text) => { root.theme-preset = "custom"; root.widget-points-hex = text; root.appearance-changed(); }
                                swatch-picked(hex) => { root.theme-preset = "custom"; root.widget-points-hex = hex; root.widget-points-hex-good = hex; root.appearance-changed(); root.toast("Warna POINTS " + hex + " diterapkan"); }
                            }
                        }

                        // Font — hanya font ber-weight lengkap (§17.3).
                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel {
                                title: "Font";
                                desc: "Set the font for menus and controls — hanya font dengan keluarga weight lengkap";
                            }
                            HorizontalLayout {
                                spacing: Design.space-sm;
                                FontCard {
                                    font-name: "Inter";
                                    font-family: "Inter";
                                    horizontal-stretch: 1;
                                    selected: root.font-choice == "Inter";
                                    clicked => { root.font-choice = "Inter"; root.appearance-changed(); root.toast("Font Inter diterapkan"); }
                                }
                                FontCard {
                                    font-name: "JetBrains Mono";
                                    font-family: "JetBrains Mono";
                                    horizontal-stretch: 1;
                                    selected: root.font-choice == "JetBrains Mono";
                                    clicked => { root.font-choice = "JetBrains Mono"; root.appearance-changed(); root.toast("Font JetBrains Mono diterapkan"); }
                                }
                            }
                        }

                        // Pola latar widget — mengubah widget-bg global.
                        SettingRow {
                            title: "Pola latar widget";
                            desc: "Motif dekorasi di atas kartu statistik — ganti satu tempat, semua kartu berubah";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 6px;
                                OptionChip {
                                    label: "doodle";
                                    horizontal-stretch: 1;
                                    selected: root.widget-bg == "doodle";
                                    clicked => { root.widget-bg = "doodle"; root.appearance-changed(); root.toast("Widget background: doodle"); }
                                }
                                OptionChip {
                                    label: "dots";
                                    horizontal-stretch: 1;
                                    selected: root.widget-bg == "dots";
                                    clicked => { root.widget-bg = "dots"; root.appearance-changed(); root.toast("Widget background: dots"); }
                                }
                                OptionChip {
                                    label: "impulse";
                                    horizontal-stretch: 1;
                                    selected: root.widget-bg == "impulse";
                                    clicked => { root.widget-bg = "impulse"; root.appearance-changed(); root.toast("Widget background: impulse"); }
                                }
                                OptionChip {
                                    label: "none";
                                    horizontal-stretch: 1;
                                    selected: root.widget-bg == "none";
                                    clicked => { root.widget-bg = "none"; root.appearance-changed(); root.toast("Widget background: none"); }
                                }
                            }
                        }

                        // Gaya latar widget — permukaan kartu statistik
                        // (bagian dari tema: tiap preset mendefinisikan
                        // gayanya; ubah manual → preset jadi "custom").
                        SettingRow {
                            title: "Gaya latar widget";
                            desc: "Permukaan kartu statistik di dashboard — Solid datar, Gradien tinta aksen, Kaca terangkat, Outline border aksen, atau Gauge arc bercahaya + angka besar + badge status";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 6px;
                                OptionChip {
                                    label: "Solid";
                                    horizontal-stretch: 1;
                                    selected: root.widget-style == "solid";
                                    clicked => { root.theme-preset = "custom"; root.widget-style = "solid"; root.appearance-changed(); root.toast("Gaya latar widget: Solid"); }
                                }
                                OptionChip {
                                    label: "Gradien";
                                    horizontal-stretch: 1;
                                    selected: root.widget-style == "gradient";
                                    clicked => { root.theme-preset = "custom"; root.widget-style = "gradient"; root.appearance-changed(); root.toast("Gaya latar widget: Gradien"); }
                                }
                                OptionChip {
                                    label: "Kaca";
                                    horizontal-stretch: 1;
                                    selected: root.widget-style == "glass";
                                    clicked => { root.theme-preset = "custom"; root.widget-style = "glass"; root.appearance-changed(); root.toast("Gaya latar widget: Kaca"); }
                                }
                                OptionChip {
                                    label: "Outline";
                                    horizontal-stretch: 1;
                                    selected: root.widget-style == "outline";
                                    clicked => { root.theme-preset = "custom"; root.widget-style = "outline"; root.appearance-changed(); root.toast("Gaya latar widget: Outline"); }
                                }
                                OptionChip {
                                    label: "Gauge";
                                    horizontal-stretch: 1;
                                    selected: root.widget-style == "gauge";
                                    clicked => { root.theme-preset = "custom"; root.widget-style = "gauge"; root.appearance-changed(); root.toast("Gaya latar widget: Gauge"); }
                                }
                            }
                        }

                        // Gaya toggle on/off — berlaku ke SEMUA toggle di
                        // aplikasi (Settings, flyout profil, Explorer,
                        // Toolbox), langsung tanpa restart. Pratinjau di
                        // bawah menampilkan gaya yang sedang dipilih
                        // (klik pratinjau hanya demo animasi geser —
                        // tidak mengubah pengaturan apa pun).
                        SettingRow {
                            title: "Gaya toggle";
                            desc: "Tampilan saklar on/off — Klasik aksen + thumb putih, Pill geser hitam lebar dengan teks ON/OFF (ref toggle-ref.gif), atau Outline border tipis + thumb lingkaran";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 6px;
                                OptionChip {
                                    label: "Klasik";
                                    horizontal-stretch: 1;
                                    selected: root.toggle-style == "classic";
                                    clicked => { root.toggle-style = "classic"; root.toggle-settings-changed(); root.toast("Gaya toggle: Klasik"); }
                                }
                                OptionChip {
                                    label: "Pill geser";
                                    horizontal-stretch: 1;
                                    selected: root.toggle-style == "pill";
                                    clicked => { root.toggle-style = "pill"; root.toggle-settings-changed(); root.toast("Gaya toggle: Pill geser"); }
                                }
                                OptionChip {
                                    label: "Outline";
                                    horizontal-stretch: 1;
                                    selected: root.toggle-style == "outline";
                                    clicked => { root.toggle-style = "outline"; root.toggle-settings-changed(); root.toast("Gaya toggle: Outline"); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 24px;
                                Text {
                                    text: "Nyala";
                                    font-size: Design.font-caption;
                                    color: Design.text-muted;
                                    vertical-alignment: center;
                                }
                                Toggle {
                                    toggle-style: root.toggle-style;
                                    checked: true;
                                }
                                Text {
                                    text: "Mati";
                                    font-size: Design.font-caption;
                                    color: Design.text-muted;
                                    vertical-alignment: center;
                                }
                                Toggle {
                                    toggle-style: root.toggle-style;
                                    checked: false;
                                }
                            }
                        }


                        // Paket ikon — berlaku ke SEMUA ikon di
                        // aplikasi (nav, widget, tombol, flyout),
                        // langsung tanpa restart. Pratinjau di bawah
                        // menampilkan 4 ikon dalam paket yang dipilih.
                        SettingRow {
                            title: "Paket ikon";
                            desc: "Gaya gambar ikon — Lucide (bawaan), Tabler, Phosphor, Heroicons, Feather, atau Material Symbols; semua open-source";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 6px;
                                OptionChip {
                                    label: "Lucide";
                                    horizontal-stretch: 1;
                                    selected: root.icon-pack == "lucide";
                                    clicked => { root.icon-pack = "lucide"; root.icon-pack-settings-changed(); root.toast("Paket ikon: Lucide"); }
                                }
                                OptionChip {
                                    label: "Tabler";
                                    horizontal-stretch: 1;
                                    selected: root.icon-pack == "tabler";
                                    clicked => { root.icon-pack = "tabler"; root.icon-pack-settings-changed(); root.toast("Paket ikon: Tabler"); }
                                }
                                OptionChip {
                                    label: "Phosphor";
                                    horizontal-stretch: 1;
                                    selected: root.icon-pack == "phosphor";
                                    clicked => { root.icon-pack = "phosphor"; root.icon-pack-settings-changed(); root.toast("Paket ikon: Phosphor"); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                OptionChip {
                                    label: "Heroicons";
                                    horizontal-stretch: 1;
                                    selected: root.icon-pack == "heroicons";
                                    clicked => { root.icon-pack = "heroicons"; root.icon-pack-settings-changed(); root.toast("Paket ikon: Heroicons"); }
                                }
                                OptionChip {
                                    label: "Feather";
                                    horizontal-stretch: 1;
                                    selected: root.icon-pack == "feather";
                                    clicked => { root.icon-pack = "feather"; root.icon-pack-settings-changed(); root.toast("Paket ikon: Feather"); }
                                }
                                OptionChip {
                                    label: "Material";
                                    horizontal-stretch: 1;
                                    selected: root.icon-pack == "material";
                                    clicked => { root.icon-pack = "material"; root.icon-pack-settings-changed(); root.toast("Paket ikon: Material Symbols"); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 24px;
                                SvgIcon { name: "home"; size: 18px; }
                                SvgIcon { name: "settings"; size: 18px; }
                                SvgIcon { name: "search"; size: 18px; }
                                SvgIcon { name: "bell"; size: 18px; }
                            }
                        }


                        // Corner Radius & Nav Pill Style
                        SettingRow {
                            title: "Corner radius";
                            desc: "Kelengkungan sudut kartu, tombol, dan panel";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 6px;
                                OptionChip {
                                    label: "Sharp";
                                    horizontal-stretch: 1;
                                    selected: root.corner-style == "sharp";
                                    clicked => { root.corner-style = "sharp"; root.appearance-changed(); root.toast("Corner radius: Sharp"); }
                                }
                                OptionChip {
                                    label: "Default";
                                    horizontal-stretch: 1;
                                    selected: root.corner-style == "default";
                                    clicked => { root.corner-style = "default"; root.appearance-changed(); root.toast("Corner radius: Default"); }
                                }
                                OptionChip {
                                    label: "Rounded";
                                    horizontal-stretch: 1;
                                    selected: root.corner-style == "rounded";
                                    clicked => { root.corner-style = "rounded"; root.appearance-changed(); root.toast("Corner radius: Rounded"); }
                                }
                            }
                        }

                        SettingRow {
                            title: "Navigation pill style";
                            desc: "Bentuk bar navigasi atas (HOME / BATCH)";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 6px;
                                OptionChip {
                                    label: "Capsule";
                                    horizontal-stretch: 1;
                                    selected: root.nav-style == "capsule";
                                    clicked => { root.nav-style = "capsule"; root.appearance-changed(); root.toast("Nav style: Capsule"); }
                                }
                                OptionChip {
                                    label: "Rounded";
                                    horizontal-stretch: 1;
                                    selected: root.nav-style == "rounded";
                                    clicked => { root.nav-style = "rounded"; root.appearance-changed(); root.toast("Nav style: Rounded"); }
                                }
                                OptionChip {
                                    label: "Flat";
                                    horizontal-stretch: 1;
                                    selected: root.nav-style == "flat";
                                    clicked => { root.nav-style = "flat"; root.appearance-changed(); root.toast("Nav style: Flat"); }
                                }
                            }
                        }

                        // Window chrome — gaya chrome window + tombol
                        // kontrolnya (lihat DESIGN_SYSTEM.md §23).
                        // "Custom" = titlebar kustom 28px; "Headless" =
                        // tanpa titlebar (drag dari strip atas konten);
                        // "Native OS" = chrome bawaan OS; "Wrapped" =
                        // titlebar kustom + konten dalam panel rounded
                        // inset (sidebar Settings pindah ke area frame
                        // saat wrapped aktif — bukan panel kedua).
                        SettingRow {
                            title: "Window chrome";
                            desc: "Gaya chrome window — berlaku ke semua window (utama, Spreadsheet, Toolbox, Trello)";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 6px;
                                OptionChip {
                                    label: "Custom";
                                    horizontal-stretch: 1;
                                    selected: root.chrome == "custom";
                                    clicked => { root.chrome = "custom"; root.appearance-changed(); root.toast("Window chrome: Custom BMachine"); }
                                }
                                OptionChip {
                                    label: "Headless";
                                    horizontal-stretch: 1;
                                    selected: root.chrome == "headless";
                                    clicked => { root.chrome = "headless"; root.appearance-changed(); root.toast("Window chrome: Headless (tanpa title bar)"); }
                                }
                                OptionChip {
                                    label: "Native";
                                    horizontal-stretch: 1;
                                    selected: root.chrome == "native";
                                    clicked => { root.chrome = "native"; root.appearance-changed(); root.toast("Window chrome: Native OS"); }
                                }
                                OptionChip {
                                    label: "Wrapped";
                                    horizontal-stretch: 1;
                                    selected: root.chrome == "wrapped";
                                    clicked => { root.chrome = "wrapped"; root.appearance-changed(); root.toast("Window chrome: Wrapped (konten dalam panel)"); }
                                }
                            }
                        }

                        // Gaya + posisi tombol kontrol (hanya saat
                        // titlebar kustom tampil: chrome custom/wrapped).
                        VerticalLayout {
                            spacing: Design.space-lg;
                            visible: root.chrome == "custom" || root.chrome == "wrapped";
                            SettingRow {
                                title: "Tombol kontrol";
                                desc: "Gaya tombol min / max / close di title bar";
                                stacked: root.stacked;
                                HorizontalLayout {
                                    spacing: 6px;
                                    OptionChip {
                                        label: "Ikon";
                                        horizontal-stretch: 1;
                                        selected: root.chrome-button-style == "icons";
                                        clicked => { root.chrome-button-style = "icons"; root.appearance-changed(); root.toast("Tombol kontrol: Ikon"); }
                                    }
                                    OptionChip {
                                        label: "Dots macOS";
                                        horizontal-stretch: 1;
                                        selected: root.chrome-button-style == "dots";
                                        clicked => { root.chrome-button-style = "dots"; root.appearance-changed(); root.toast("Tombol kontrol: Dots macOS"); }
                                    }
                                }
                            }
                            SettingRow {
                                title: "Posisi tombol";
                                desc: "Tombol kontrol di kiri (macOS) atau kanan (Windows)";
                                stacked: root.stacked;
                                HorizontalLayout {
                                    spacing: 6px;
                                    OptionChip {
                                        label: "Kanan";
                                        horizontal-stretch: 1;
                                        selected: root.chrome-button-position == "right";
                                        clicked => { root.chrome-button-position = "right"; root.appearance-changed(); root.toast("Tombol kontrol: Kanan"); }
                                    }
                                    OptionChip {
                                        label: "Kiri";
                                        horizontal-stretch: 1;
                                        selected: root.chrome-button-position == "left";
                                        clicked => { root.chrome-button-position = "left"; root.appearance-changed(); root.toast("Tombol kontrol: Kiri"); }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Btn {
                                label: "Reset ke Default";
                                variant: "danger";
                                clicked => { root.reset-appearance(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // PREVIEW — miniatur jendela yang mencerminkan pilihan.
                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "Preview";
                                font-size: Design.font-h3;
                                font-weight: 800;
                                color: Design.text-primary;
                            }
                            Rectangle {
                                height: 240px;
                                background: root.pv-bg;
                                border-color: Design.separator;
                                border-width: 1px;
                                border-radius: Design.radius-lg;
                                clip: true;
                                VerticalLayout {
                                    width: 100%;
                                    height: 100%;
                                    // Title bar mock: mencerminkan gaya chrome +
                                    // gaya/posisi tombol kontrol yang dipilih.
                                    Rectangle {
                                        height: 30px;
                                        background: root.pv-card;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 6px;
                                            // Tombol di kiri (macOS).
                                            if (root.chrome == "custom" || root.chrome == "wrapped") && root.chrome-button-position == "left" : HorizontalLayout {
                                                spacing: 6px;
                                                if root.chrome-button-style == "dots" : HorizontalLayout {
                                                    spacing: 6px;
                                                    Rectangle {
                                                        width: 10px; height: 10px;
                                                        background: Design.status-danger;
                                                        border-radius: 999px;
                                                    }
                                                    Rectangle {
                                                        width: 10px; height: 10px;
                                                        background: Design.status-warning;
                                                        border-radius: 999px;
                                                    }
                                                    Rectangle {
                                                        width: 10px; height: 10px;
                                                        background: Design.status-success;
                                                        border-radius: 999px;
                                                    }
                                                }
                                                if root.chrome-button-style == "icons" : Text {
                                                    text: "─ □ ×";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: root.pv-fg;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                text: root.chrome == "custom" ? "BMachine" : root.chrome == "wrapped" ? "BMachine · Wrapped" : root.chrome == "headless" ? "Tanpa title bar" : "Title bar OS — bawaan sistem";
                                                font-size: Design.font-button;
                                                font-weight: 700;
                                                font-family: root.font-choice == "JetBrains Mono" ? "JetBrains Mono" : "Inter";
                                                color: root.pv-fg;
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            // Tombol di kanan (Windows, bawaan).
                                            if (root.chrome == "custom" || root.chrome == "wrapped") && root.chrome-button-position == "right" : HorizontalLayout {
                                                spacing: 6px;
                                                if root.chrome-button-style == "dots" : HorizontalLayout {
                                                    spacing: 6px;
                                                    Rectangle {
                                                        width: 10px; height: 10px;
                                                        background: Design.status-danger;
                                                        border-radius: 999px;
                                                    }
                                                    Rectangle {
                                                        width: 10px; height: 10px;
                                                        background: Design.status-warning;
                                                        border-radius: 999px;
                                                    }
                                                    Rectangle {
                                                        width: 10px; height: 10px;
                                                        background: Design.status-success;
                                                        border-radius: 999px;
                                                    }
                                                }
                                                if root.chrome-button-style == "icons" : Text {
                                                    text: "─ □ ×";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: root.pv-fg;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                    // Isi preview: kartu mini (warna preview + font
                                    // pilihan) + StatWidget asli (widget-bg + accent).
                                    HorizontalLayout {
                                        vertical-stretch: 1;
                                        padding: Design.space-md;
                                        spacing: Design.space-md;
                                        Rectangle {
                                            // Lebar responsif: 220px di layar lebar, mengecil
                                            // proporsional di 520px supaya tidak terpotong.
                                            width: parent.width < 500px ? (parent.width - 36px) / 2 : 220px;
                                            background: root.pv-card;
                                            border-color: Design.separator;
                                            border-width: 1px;
                                            border-radius: Design.radius-lg;
                                            VerticalLayout {
                                                padding: Design.space-md;
                                                spacing: 4px;
                                                Text {
                                                    text: "●  EDITING";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    font-family: root.font-choice == "JetBrains Mono" ? "JetBrains Mono" : "Inter";
                                                    color: root.pv-accent;
                                                    letter-spacing: 1px;
                                                }
                                                Rectangle { vertical-stretch: 1; }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Text {
                                                        text: root.stat-editing;
                                                        font-size: 28px;
                                                        font-weight: 800;
                                                        font-family: root.font-choice == "JetBrains Mono" ? "JetBrains Mono" : "Inter";
                                                        color: root.pv-fg;
                                                    }
                                                    Text {
                                                        text: "CARD";
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        font-family: root.font-choice == "JetBrains Mono" ? "JetBrains Mono" : "Inter";
                                                        color: root.pv-accent;
                                                        letter-spacing: 1px;
                                                        vertical-alignment: bottom;
                                                    }
                                                }
                                            }
                                        }
                                        StatWidget {
                                            // Sama seperti kartu mini di sebelahnya (lihat atas).
                                            width: parent.width < 500px ? (parent.width - 36px) / 2 : 220px;
                                            label: "POINTS";
                                            value: root.stat-points;
                                            suffix: "POIN";
                                            accent: root.pv-accent;
                                            bg: root.widget-bg;
                                            bg-style: root.widget-style;
                                            // Nilai demo supaya arc gauge terisi di pratinjau.
                                            gauge-ratio: 0.72;
                                            scale: 1;
                                            clicked => { root.toast("Preview StatWidget — pola: " + root.widget-bg + ", gaya: " + root.widget-style); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    Text {
                                        text: "Tema aktif diterapkan langsung ke seluruh aplikasi & tersimpan otomatis.";
                                        font-size: 11px;
                                        color: root.pv-muted;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // ===== ACCOUNT (Trello & Google Spreadsheet — persis C#) =====
                sv-account := Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.group == "Account";
                    VerticalLayout {
                        x: 0; width: content-rect.width;
                        // Isi rapat di atas (alignment start): tanpa ini,
                        // konten yang lebih pendek dari viewport
                        // direnggangkan ke tinggi penuh (ruang ekstra
                        // dibagi ke anak-anak) — lih. DESIGN_SYSTEM §17.4.
                        alignment: start;
                        spacing: Design.space-lg;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 16px;
                        padding-bottom: Design.space-lg;

                        // 1. Trello Integration
                        Card {
                            VerticalLayout {
                                padding: Design.space-lg;
                                spacing: Design.space-md;
                                Text {
                                    text: "TRELLO INTEGRATION";
                                    font-size: Design.font-h3;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                    color: Design.text-primary;
                                    wrap: word-wrap;
                                }

                                SettingRow {
                                    title: "Base URL";
                                    desc: "Alamat server board — Trello asli atau Trello kantor (tanpa / di akhir)";
                                    stacked: root.stacked;
                                    TextField {
                                        width: root.stacked ? parent.width : 420px;
                                        text: root.trello-base-url;
                                        placeholder: "https://api.trello.com/1";
                                        edited(text) => { root.trello-base-url = text; }
                                    }
                                }

                                SettingRow {
                                    title: "API Key";
                                    desc: "Key pengembang Trello Power-Up";
                                    stacked: root.stacked;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        width: root.stacked ? parent.width : 420px;
                                        TextField {
                                            horizontal-stretch: 1;
                                            text: root.trello-api-key;
                                            placeholder: "Trello API Key";
                                            edited(text) => { root.trello-api-key = text; }
                                        }
                                        Btn {
                                            label: "Get Key";
                                            variant: "secondary";
                                            // Hanya untuk Trello asli — Trello kantor
                                            // key-nya dari server kantor sendiri.
                                            visible: root.trello-base-url == "" || root.trello-base-url == "https://api.trello.com/1";
                                            clicked => { root.open-url("https://trello.com/power-ups/admin"); }
                                        }
                                    }
                                }

                                SettingRow {
                                    title: "Token";
                                    desc: "Token akses baca & tulis akun Trello";
                                    stacked: root.stacked;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        width: root.stacked ? parent.width : 420px;
                                        TextField {
                                            horizontal-stretch: 1;
                                            text: root.trello-token;
                                            placeholder: "Trello Token (30 hari)";
                                            edited(text) => { root.trello-token = text; }
                                        }
                                        Btn {
                                            label: root.trello-connected ? "Disconnect" : "Connect";
                                            variant: root.trello-connected ? "danger" : "primary";
                                            clicked => {
                                                if (root.trello-connected) {
                                                    root.trello-connected = false;
                                                    root.trello-status = "Koneksi Trello terputus.";
                                                    root.toast("Trello disconnected.");
                                                } else {
                                                    root.test-trello();
                                                }
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: root.trello-status;
                                    font-size: Design.font-caption;
                                    color: root.trello-connected ? Design.status-success : Design.text-muted;
                                }
                            }
                        }

                        // 2. Google Integration (Spreadsheet)
                        Card {
                            VerticalLayout {
                                padding: Design.space-lg;
                                spacing: Design.space-md;
                                Text {
                                    text: "GOOGLE INTEGRATION (SPREADSHEET)";
                                    font-size: Design.font-h3;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                    color: Design.text-primary;
                                    wrap: word-wrap;
                                }

                                SettingRow {
                                    title: "Credentials JSON";
                                    desc: "Path file kredensial Google Service Account";
                                    stacked: root.stacked;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        width: root.stacked ? parent.width : 420px;
                                        TextField {
                                            horizontal-stretch: 1;
                                            text: root.google-creds-path;
                                            placeholder: "Path credentials.json";
                                            edited(text) => { root.google-creds-path = text; }
                                        }
                                        Btn {
                                            label: "Browse";
                                            variant: "secondary";
                                            clicked => { root.browse-path("creds"); }
                                        }
                                    }
                                }

                                SettingRow {
                                    title: "Sheet ID";
                                    desc: "ID unik dari link Google Sheet";
                                    stacked: root.stacked;
                                    TextField {
                                        width: root.stacked ? parent.width : 420px;
                                        text: root.google-sheet-id;
                                        placeholder: "Google Sheet ID";
                                        edited(text) => { root.google-sheet-id = text; }
                                    }
                                }

                                // Menumpuk saat sempit: 3 kolom butuh
                                // ~300px, konten kartu 520px cuma 224px.
                                if !root.stacked : HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Worksheet Poin"; desc: "Tab poin harian"; }
                                        TextField {
                                            text: root.google-sheet-name;
                                            placeholder: "misal Sheet1";
                                            edited(text) => { root.google-sheet-name = text; }
                                        }
                                    }
                                    VerticalLayout {
                                        width: 80px;
                                        spacing: 4px;
                                        FieldLabel { title: "Kolom"; desc: "Kolom sel"; }
                                        TextField {
                                            text: root.google-sheet-col;
                                            placeholder: "B";
                                            edited(text) => { root.google-sheet-col = text; }
                                        }
                                    }
                                    VerticalLayout {
                                        width: 80px;
                                        spacing: 4px;
                                        FieldLabel { title: "Baris"; desc: "Baris sel"; }
                                        TextField {
                                            text: root.google-sheet-row;
                                            placeholder: "12";
                                            edited(text) => { root.google-sheet-row = text; }
                                        }
                                    }
                                }
                                if root.stacked : VerticalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        spacing: 4px;
                                        FieldLabel { title: "Worksheet Poin"; desc: "Tab poin harian"; }
                                        TextField {
                                            text: root.google-sheet-name;
                                            placeholder: "misal Sheet1";
                                            edited(text) => { root.google-sheet-name = text; }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            FieldLabel { title: "Kolom"; desc: "Kolom sel"; }
                                            TextField {
                                                text: root.google-sheet-col;
                                                placeholder: "B";
                                                edited(text) => { root.google-sheet-col = text; }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            FieldLabel { title: "Baris"; desc: "Baris sel"; }
                                            TextField {
                                                text: root.google-sheet-row;
                                                placeholder: "12";
                                                edited(text) => { root.google-sheet-row = text; }
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Tab Tabel Utama"; desc: "Nama sheet reguler"; }
                                        TextField {
                                            text: root.spreadsheet-sheet-name;
                                            placeholder: "ALL DATA REGULER";
                                            edited(text) => { root.spreadsheet-sheet-name = text; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Rentang Range"; desc: "Range tabel"; }
                                        TextField {
                                            text: root.spreadsheet-range;
                                            placeholder: "A1:Z";
                                            edited(text) => { root.spreadsheet-range = text; }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Leaderboard Harian Range"; desc: "Rentang data"; }
                                        TextField {
                                            text: root.lb-harian-range;
                                            placeholder: "A2:C10";
                                            edited(text) => { root.lb-harian-range = text; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Leaderboard Bulanan Range"; desc: "Rentang data"; }
                                        TextField {
                                            text: root.lb-bulanan-range;
                                            placeholder: "A2:C10";
                                            edited(text) => { root.lb-bulanan-range = text; }
                                        }
                                    }
                                }
                            }
                        }

                        // 3. Board Synchronization (Trello)
                        Card {
                            VerticalLayout {
                                padding: Design.space-lg;
                                spacing: Design.space-md;
                                Text {
                                    text: "BOARD & LIST SYNCHRONIZATION";
                                    font-size: Design.font-h3;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                    color: Design.text-primary;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Editing Board ID / Name"; desc: "Board kartu baru"; }
                                        TextField {
                                            text: root.editing-board-id;
                                            placeholder: "Board ID";
                                            edited(text) => { root.editing-board-id = text; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Editing List ID"; desc: "List kartu editing aktif"; }
                                        TextField {
                                            text: root.editing-list-id;
                                            placeholder: "List ID (mis. 660f...)";
                                            edited(text) => { root.editing-list-id = text; }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Revisi Board ID"; desc: "Board revisi editor"; }
                                        TextField {
                                            text: root.revision-board-id;
                                            placeholder: "Board ID";
                                            edited(text) => { root.revision-board-id = text; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Revisi List ID"; desc: "List kartu revisi aktif"; }
                                        TextField {
                                            text: root.revision-list-id;
                                            placeholder: "List ID";
                                            edited(text) => { root.revision-list-id = text; }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Susulan Board ID"; desc: "Board susulan/terlambat"; }
                                        TextField {
                                            text: root.late-board-id;
                                            placeholder: "Board ID";
                                            edited(text) => { root.late-board-id = text; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Susulan List ID"; desc: "List kartu susulan"; }
                                        TextField {
                                            text: root.late-list-id;
                                            placeholder: "List ID";
                                            edited(text) => { root.late-list-id = text; }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Target Move Board (QC)"; desc: "Tujuan saat dipindah"; }
                                        TextField {
                                            text: root.qc-board-id;
                                            placeholder: "Board QC ID";
                                            edited(text) => { root.qc-board-id = text; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Marketing ACC List ID"; desc: "List kartu disetujui"; }
                                        TextField {
                                            text: root.acc-list-id;
                                            placeholder: "List ACC ID";
                                            edited(text) => { root.acc-list-id = text; }
                                        }
                                    }
                                }
                            }
                        }

                        // 4. Refresh Intervals (detik)
                        Card {
                            VerticalLayout {
                                padding: Design.space-lg;
                                spacing: Design.space-md;
                                Text {
                                    text: "REFRESH INTERVALS (DETIK)";
                                    font-size: Design.font-h3;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                    color: Design.text-primary;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Editing Board (s)"; desc: "Interval polling detik"; }
                                        TextField {
                                            text: root.refresh-editing;
                                            placeholder: "15";
                                            edited(text) => { root.refresh-editing = text; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Revision Board (s)"; desc: "Interval polling detik"; }
                                        TextField {
                                            text: root.refresh-revision;
                                            placeholder: "15";
                                            edited(text) => { root.refresh-revision = text; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Late Board (s)"; desc: "Interval polling detik"; }
                                        TextField {
                                            text: root.refresh-late;
                                            placeholder: "30";
                                            edited(text) => { root.refresh-late = text; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        FieldLabel { title: "Points (Sheet) (s)"; desc: "Interval polling detik"; }
                                        TextField {
                                            text: root.refresh-points;
                                            placeholder: "60";
                                            edited(text) => { root.refresh-points = text; }
                                        }
                                    }
                                }
                            }
                        }

                        // Simpan Profil Akun
                        HorizontalLayout {
                            Rectangle { horizontal-stretch: 1; }
                            Btn {
                                label: "Simpan Pengaturan Akun";
                                variant: "primary";
                                clicked => {
                                    root.save-account-settings();
                                    root.toast("Pengaturan Akun disimpan ke SQLite & sinkronisasi dimulai.");
                                }
                            }
                        }
                    }
                }

                // ===== EXTENSIONS (Plugins DLL) =====
                sv-extensions := Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.group == "Extensions";
                    VerticalLayout {
                        x: 0; width: content-rect.width;
                        // Isi rapat di atas (alignment start): tanpa ini,
                        // konten yang lebih pendek dari viewport
                        // direnggangkan ke tinggi penuh (ruang ekstra
                        // dibagi ke anak-anak) — lih. DESIGN_SYSTEM §17.4.
                        alignment: start;
                        spacing: Design.space-lg;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 16px;
                        padding-bottom: Design.space-lg;

                        Card {
                            VerticalLayout {
                                padding: Design.space-lg;
                                spacing: Design.space-md;
                                if !root.stacked : HorizontalLayout {
                                    Text {
                                        text: "INSTALLED EXTENSIONS / PLUGINS";
                                        font-size: Design.font-h3;
                                        font-weight: 700;
                                        letter-spacing: 1px;
                                        color: Design.text-primary;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Btn {
                                        label: "Add Plugin (.dll)";
                                        variant: "primary";
                                        clicked => { root.toast("Pilih file DLL ekstensi…"); }
                                    }
                                }
                                if root.stacked : VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "INSTALLED EXTENSIONS / PLUGINS";
                                        font-size: Design.font-h3;
                                        font-weight: 700;
                                        letter-spacing: 1px;
                                        color: Design.text-primary;
                                        wrap: word-wrap;
                                    }
                                    Btn {
                                        label: "Add Plugin (.dll)";
                                        variant: "primary";
                                        clicked => { root.toast("Pilih file DLL ekstensi…"); }
                                    }
                                }

                                Text {
                                    text: "Folder: BMachine/plugins/";
                                    font-size: Design.font-caption;
                                    color: Design.text-muted;
                                }

                                // Mock Item Plugin — menumpuk saat
                                // sempit (nama + tombol di bawah) karena
                                // baris horizontal butuh ~410px.
                                Rectangle {
                                    height: root.stacked ? 100px : 52px;
                                    background: Design.bg-hover;
                                    border-radius: Design.radius-sm;
                                    border-width: 1px;
                                    border-color: Design.border-default;
                                    if !root.stacked : HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 12px;
                                        Text {
                                            text: "🧩";
                                            font-size: 18px;
                                            vertical-alignment: center;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "SampleExtension.dll";
                                                font-size: Design.font-body;
                                                font-weight: 600;
                                                color: Design.text-primary;
                                            }
                                            Text {
                                                text: "v1.0.0 · Active · External Extension";
                                                font-size: Design.font-caption;
                                                color: Design.text-muted;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Btn {
                                            label: "Disable";
                                            variant: "secondary";
                                            clicked => { root.toast("Plugin dinonaktifkan (.disabled)"); }
                                        }
                                        Btn {
                                            label: "Hapus";
                                            variant: "danger";
                                            clicked => { root.toast("Plugin dihapus."); }
                                        }
                                    }
                                    if root.stacked : VerticalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        padding-top: 8px;
                                        padding-bottom: 8px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Text {
                                                text: "🧩";
                                                font-size: 18px;
                                                vertical-alignment: center;
                                            }
                                            VerticalLayout {
                                                spacing: 2px;
                                                Text {
                                                    text: "SampleExtension.dll";
                                                    font-size: Design.font-body;
                                                    font-weight: 600;
                                                    color: Design.text-primary;
                                                }
                                                Text {
                                                    text: "v1.0.0 · Active · External Extension";
                                                    font-size: Design.font-caption;
                                                    color: Design.text-muted;
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Btn {
                                                label: "Disable";
                                                variant: "secondary";
                                                clicked => { root.toast("Plugin dinonaktifkan (.disabled)"); }
                                            }
                                            Btn {
                                                label: "Hapus";
                                                variant: "danger";
                                                clicked => { root.toast("Plugin dihapus."); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ===== SCRIPT MANAGER (Master Scripts & Radial Actions) =====
                sv-scripts := Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.group == "Script Manager";
                    VerticalLayout {
                        x: 0; width: content-rect.width;
                        // Isi rapat di atas (alignment start): tanpa ini,
                        // konten yang lebih pendek dari viewport
                        // direnggangkan ke tinggi penuh (ruang ekstra
                        // dibagi ke anak-anak) — lih. DESIGN_SYSTEM §17.4.
                        alignment: start;
                        spacing: Design.space-lg;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 16px;
                        padding-bottom: Design.space-lg;

                        Card {
                            VerticalLayout {
                                padding: Design.space-lg;
                                spacing: Design.space-md;
                                Text {
                                    text: "SCRIPT MANAGER & RADIAL WHEEL CONFIGURATION";
                                    font-size: Design.font-h3;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                    color: Design.text-primary;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "Konfigurasi scripts.json, urutan script Master, dan penataan 8 slot Radial Menu.";
                                    font-size: Design.font-caption;
                                    color: Design.text-muted;
                                    wrap: word-wrap;
                                }

                                // Menumpuk saat sempit: 3 tombol
                                // berdampingan butuh ~600px, konten
                                // 520px cuma 256px.
                                if !root.stacked : HorizontalLayout {
                                    spacing: 12px;
                                    Btn {
                                        label: "Buka Folder Scripts/Master";
                                        variant: "secondary";
                                        clicked => { root.toast("Folder Scripts/Master belum dikonfigurasi."); }
                                    }
                                    Btn {
                                        label: "Buka Folder Scripts/Action";
                                        variant: "secondary";
                                        clicked => { root.toast("Folder Scripts/Action belum dikonfigurasi."); }
                                    }
                                    Btn {
                                        label: "Reload scripts.json";
                                        variant: "primary";
                                        clicked => { root.toast("Metadata skrip berhasil direload."); }
                                    }
                                }
                                if root.stacked : VerticalLayout {
                                    spacing: 8px;
                                    Btn {
                                        label: "Buka Folder Scripts/Master";
                                        variant: "secondary";
                                        clicked => { root.toast("Folder Scripts/Master belum dikonfigurasi."); }
                                    }
                                    Btn {
                                        label: "Buka Folder Scripts/Action";
                                        variant: "secondary";
                                        clicked => { root.toast("Folder Scripts/Action belum dikonfigurasi."); }
                                    }
                                    Btn {
                                        label: "Reload scripts.json";
                                        variant: "primary";
                                        clicked => { root.toast("Metadata skrip berhasil direload."); }
                                    }
                                }
                            }
                        }

                }
                }

                // ===== GENERAL =====
                sv-general := Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.group == "General";
                    VerticalLayout {
                        x: 0; width: content-rect.width;
                        // Isi rapat di atas (alignment start): tanpa ini,
                        // konten yang lebih pendek dari viewport
                        // direnggangkan ke tinggi penuh (ruang ekstra
                        // dibagi ke anak-anak) — lih. DESIGN_SYSTEM §17.4.
                        alignment: start;
                        spacing: Design.space-lg;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 16px;
                        padding-bottom: Design.space-lg;

                        // Judul grup (nama grup tetap terlihat saat
                        // sidebar ciut — rail ikon tidak menampilkan
                        // label; gaya judul sama seperti "Visual style"
                        // di Appearance).
                        Text {
                            text: "General";
                            font-size: Design.font-h3;
                            font-weight: 800;
                            color: Design.text-primary;
                        }

                        SettingRow {
                            title: "Bahasa";
                            desc: "Bahasa antarmuka aplikasi";
                            stacked: root.stacked;
                            ComboBox {
                                width: root.stacked ? parent.width : 140px;
                                model: ["English", "Indonesia"];
                                current-index: root.lang == "Indonesia" ? 1 : 0;
                                selected(index) => {
                                    root.lang = index == 1 ? "Indonesia" : "English";
                                    root.toast("Disimpan: Bahasa " + root.lang);
                                }
                            }
                        }
                        SettingRow {
                            title: "Filter ekstensi file";
                            desc: "Filter file saat batch (kosong = semua)";
                            stacked: root.stacked;
                            TextField {
                                width: root.stacked ? parent.width : 140px;
                                text: root.batch-file-filter;
                                placeholder: "All (*)";
                                edited(text) => { root.batch-file-filter = text; }
                                accepted(text) => {
                                    root.save-general-settings();
                                    root.toast("Disimpan: Filter " + (text == "" ? "All (*)" : text));
                                }
                            }
                        }
                        SettingRow {
                            title: "Animasi startup";
                            desc: "Tampilkan animasi saat aplikasi dibuka";
                            stacked: root.stacked;
                            Toggle {
                                toggle-style: root.toggle-style;
                                checked: root.anim-startup;
                                toggled(checked) => { root.anim-startup = checked; root.toast(checked ? "Disimpan: Animasi startup nyala" : "Disimpan: Animasi startup mati"); }
                            }
                        }
                        SettingRow {
                            title: "Kecepatan animasi statistik";
                            desc: "Kecepatan transisi angka di kartu dashboard";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 6px;
                                OptionChip {
                                    label: "Lambat";
                                    horizontal-stretch: 1;
                                    selected: root.anim-speed == "Lambat";
                                    clicked => { root.anim-speed = "Lambat"; root.toast("Disimpan: Animasi Lambat"); }
                                }
                                OptionChip {
                                    label: "Normal";
                                    horizontal-stretch: 1;
                                    selected: root.anim-speed == "Normal";
                                    clicked => { root.anim-speed = "Normal"; root.toast("Disimpan: Animasi Normal"); }
                                }
                                OptionChip {
                                    label: "Cepat";
                                    horizontal-stretch: 1;
                                    selected: root.anim-speed == "Cepat";
                                    clicked => { root.anim-speed = "Cepat"; root.toast("Disimpan: Animasi Cepat"); }
                                }
                            }
                        }
                        SettingRow {
                            title: "Interval refresh Trello";
                            desc: "Seberapa sering statistik Trello dimuat ulang";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 8px;
                                TextField {
                                    width: 80px;
                                    // Two-way: tampilkan nilai DB (60
                                    // bila belum ada) + ketikan langsung
                                    // mengubah properti (timer membaca
                                    // properti ini tiap detik); simpan
                                    // tetap lewat tombol Simpan General
                                    // (clamp min 30 di Rust).
                                    text <=> root.trello-interval;
                                    placeholder: "60";
                                    accepted(text) => { root.toast("Interval refresh " + text + " detik — klik Simpan"); }
                                }
                                Text {
                                    text: "detik";
                                    font-size: Design.font-body;
                                    font-weight: 700;
                                    color: Design.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        SettingRow {
                            title: "Data";
                            desc: "Penyimpanan & cadangan database";
                            stacked: root.stacked;
                            VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Penyimpanan";
                                        font-size: Design.font-body;
                                        color: Design.text-primary;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Btn {
                                        label: ">";
                                        variant: "secondary";
                                        clicked => { root.group = "Paths"; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Btn {
                                        label: "Export";
                                        variant: "secondary";
                                        clicked => { root.export-database(); }
                                    }
                                    Btn {
                                        label: "Import";
                                        variant: "secondary";
                                        clicked => { root.import-database(); }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            padding-top: Design.space-md;
                            Btn {
                                label: "Simpan";
                                variant: "primary";
                                height-override: 34px;
                                clicked => {
                                    root.save-general-settings();
                                    root.toast("Pengaturan General disimpan");
                                }
                            }
                        }
                    }
                }

                // ===== PATHS =====
                sv-paths := Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.group == "Paths";
                    VerticalLayout {
                        x: 0; width: content-rect.width;
                        // Isi rapat di atas (alignment start): tanpa ini,
                        // konten yang lebih pendek dari viewport
                        // direnggangkan ke tinggi penuh (ruang ekstra
                        // dibagi ke anak-anak) — lih. DESIGN_SYSTEM §17.4.
                        alignment: start;
                        spacing: Design.space-lg;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 16px;
                        padding-bottom: Design.space-lg;

                        // Judul grup (nama grup tetap terlihat saat
                        // sidebar ciut — lihat komentar di grup General).
                        Text {
                            text: "Paths";
                            font-size: Design.font-h3;
                            font-weight: 800;
                            color: Design.text-primary;
                        }

                        SettingRow {
                            title: "Local Output";
                            desc: "Base folder OUTPUT (mis. D:\\Output)";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 8px;
                                width: root.stacked ? parent.width : 420px;
                                TextField {
                                    horizontal-stretch: 1;
                                    text: root.path-local;
                                    edited(text) => { root.path-local = text; }
                                    accepted(text) => { root.save-paths-settings(); }
                                }
                                Btn {
                                    label: "Browse";
                                    variant: "secondary";
                                    clicked => { root.browse-path("local"); }
                                }
                            }
                        }
                        SettingRow {
                            title: "OKE BASE";
                            desc: "Share backup OKE BASE (jaringan)";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 8px;
                                width: root.stacked ? parent.width : 420px;
                                TextField {
                                    horizontal-stretch: 1;
                                    text: root.path-okebase;
                                    placeholder: "Share OKE BASE (jaringan)";
                                    edited(text) => { root.path-okebase = text; }
                                    accepted(text) => { root.save-paths-settings(); }
                                }
                                Btn {
                                    label: "Browse";
                                    variant: "secondary";
                                    clicked => { root.browse-path("okebase"); }
                                }
                            }
                        }
                        SettingRow {
                            title: "Photoshop Path";
                            desc: "Executable Photoshop (untuk JSX & COM)";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 8px;
                                width: root.stacked ? parent.width : 420px;
                                TextField {
                                    horizontal-stretch: 1;
                                    text: root.path-photoshop;
                                    placeholder: "Photoshop.exe";
                                    edited(text) => { root.path-photoshop = text; }
                                    accepted(text) => { root.save-paths-settings(); }
                                }
                                Btn {
                                    label: "Browse";
                                    variant: "secondary";
                                    clicked => { root.browse-path("photoshop"); }
                                }
                            }
                        }
                        SettingRow {
                            title: "Master Pas Foto";
                            desc: "Folder master pas foto";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 8px;
                                width: root.stacked ? parent.width : 420px;
                                TextField {
                                    horizontal-stretch: 1;
                                    text: root.path-pasfoto;
                                    edited(text) => { root.path-pasfoto = text; }
                                    accepted(text) => { root.save-paths-settings(); }
                                }
                                Btn {
                                    label: "Browse";
                                    variant: "secondary";
                                    clicked => { root.browse-path("pasfoto"); }
                                }
                            }
                        }
                        SettingRow {
                            title: "Master Manasik";
                            desc: "Folder master manasik";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 8px;
                                width: root.stacked ? parent.width : 420px;
                                TextField {
                                    horizontal-stretch: 1;
                                    text: root.path-manasik;
                                    edited(text) => { root.path-manasik = text; }
                                    accepted(text) => { root.save-paths-settings(); }
                                }
                                Btn {
                                    label: "Browse";
                                    variant: "secondary";
                                    clicked => { root.browse-path("manasik"); }
                                }
                            }
                        }
                        SettingRow {
                            title: "Master Wisuda";
                            desc: "Folder master wisuda";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 8px;
                                width: root.stacked ? parent.width : 420px;
                                TextField {
                                    horizontal-stretch: 1;
                                    text: root.path-wisuda;
                                    edited(text) => { root.path-wisuda = text; }
                                    accepted(text) => { root.save-paths-settings(); }
                                }
                                Btn {
                                    label: "Browse";
                                    variant: "secondary";
                                    clicked => { root.browse-path("wisuda"); }
                                }
                            }
                        }
                        SettingRow {
                            title: "Master Profesi";
                            desc: "Folder master profesi";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 8px;
                                width: root.stacked ? parent.width : 420px;
                                TextField {
                                    horizontal-stretch: 1;
                                    text: root.path-profesi;
                                    edited(text) => { root.path-profesi = text; }
                                    accepted(text) => { root.save-paths-settings(); }
                                }
                                Btn {
                                    label: "Browse";
                                    variant: "secondary";
                                    clicked => { root.browse-path("profesi"); }
                                }
                            }
                        }
                    }
                }

                // ===== DYNAMIC ISLAND =====
                sv-dynamic-island := Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.group == "Dynamic Island";
                    VerticalLayout {
                        x: 0; width: content-rect.width;
                        // Isi rapat di atas (alignment start): tanpa ini,
                        // konten yang lebih pendek dari viewport
                        // direnggangkan ke tinggi penuh — lih. DESIGN_SYSTEM §17.4.
                        alignment: start;
                        spacing: Design.space-lg;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 16px;
                        padding-bottom: Design.space-lg;

                        Text {
                            text: "Dynamic Island";
                            font-size: Design.font-h3;
                            font-weight: 800;
                            color: Design.text-primary;
                        }

                        Text {
                            text: "Behavior";
                            font-size: Design.font-h3;
                            font-weight: 700;
                            color: Design.text-primary;
                        }

                        SettingRow {
                            title: "Dynamic Island";
                            desc: "Tampilkan notch hidup di atas layar — matikan untuk menyembunyikan pill / maskot";
                            stacked: root.stacked;
                            Toggle {
                                toggle-style: root.toggle-style;
                                checked: root.dynamic-bar-visible;
                                toggled(checked) => {
                                    if (checked) { root.open-dynamic-bar(); root.toast("Dynamic Island nyala"); }
                                    else { root.hide-dynamic-bar(); root.toast("Dynamic Island mati"); }
                                }
                            }
                        }

                        // Notch hidup (rework 27 Nov 2026, referensi
                        // Nusa): mode Notch / Avatar Pet + voice SAPI
                        // (Windows). Semua perubahan disimpan +
                        // diterapkan langsung tanpa restart.
                        SettingRow {
                            title: "Mode";
                            desc: "Notch = pill hitam kecil berisi mata di atas layar; Avatar Pet = maskot bisa di-drag ke mana saja dan bergerak sendiri";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 6px;
                                OptionChip {
                                    label: "Notch";
                                    horizontal-stretch: 1;
                                    selected: root.notch-mode == "notch";
                                    clicked => { root.notch-mode = "notch"; root.notch-settings-changed(); root.toast("Mode notch: Notch"); }
                                }
                                OptionChip {
                                    label: "Avatar Pet";
                                    horizontal-stretch: 1;
                                    selected: root.notch-mode == "pet";
                                    clicked => { root.notch-mode = "pet"; root.notch-settings-changed(); root.toast("Mode notch: Avatar Pet"); }
                                }
                            }
                        }

                        

                        Text {
                            text: "Tampilan";
                            font-size: Design.font-h3;
                            font-weight: 700;
                            color: Design.text-primary;
                        }

                        // Gaya mata notch + blob pet bawaan (bukan
                        // sprite PetDex). Nusa = oval putih bercahaya
                        // (bawaan); Baymax = dua titik yang
                        // dihubungkan garis (ref eyes-ref.gif —
                        // warnanya dibalik jadi putih supaya terbaca
                        // di atas pill hitam); Bulat = lingkaran
                        // putih besar tanpa glow.
                        SettingRow {
                            title: "Gaya mata";
                            desc: "Bentuk mata maskot di notch dan blob pet bawaan — berlaku langsung tanpa restart";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 6px;
                                OptionChip {
                                    label: "Nusa";
                                    horizontal-stretch: 1;
                                    selected: root.notch-eye-style == "nusa";
                                    clicked => { root.notch-eye-style = "nusa"; root.notch-settings-changed(); root.toast("Gaya mata: Nusa"); }
                                }
                                OptionChip {
                                    label: "Baymax";
                                    horizontal-stretch: 1;
                                    selected: root.notch-eye-style == "baymax";
                                    clicked => { root.notch-eye-style = "baymax"; root.notch-settings-changed(); root.toast("Gaya mata: Baymax"); }
                                }
                                OptionChip {
                                    label: "Bulat";
                                    horizontal-stretch: 1;
                                    selected: root.notch-eye-style == "bulat";
                                    clicked => { root.notch-eye-style = "bulat"; root.notch-settings-changed(); root.toast("Gaya mata: Bulat"); }
                                }
                            }
                        }

                        

                        Text {
                            text: "Suara";
                            font-size: Design.font-h3;
                            font-weight: 700;
                            color: Design.text-primary;
                        }

                        SettingRow {
                            title: "Suara maskot";
                            desc: "Maskot bicara saat ada kartu baru masuk atau poin bertambah (Windows SAPI — offline, gratis; di Linux tidak ada suara)";
                            stacked: root.stacked;
                            Toggle {
                                toggle-style: root.toggle-style;
                                checked: root.notch-voice-enabled;
                                toggled(checked) => { root.notch-voice-enabled = checked; root.notch-settings-changed(); root.toast(checked ? "Suara maskot nyala" : "Suara maskot mati"); }
                            }
                        }

                        SettingRow {
                            title: "Pilih suara";
                            desc: "Suara Windows yang terpasang — Otomatis memakai Bahasa Indonesia bila ada";
                            stacked: root.stacked;
                            ComboBox {
                                width: root.stacked ? parent.width : 260px;
                                model: root.notch-voices;
                                current-index: root.notch-voice-index;
                                selected(index) => {
                                    root.notch-voice-index = index;
                                    root.notch-settings-changed();
                                    root.toast("Suara: " + (index == 0 ? "Otomatis" : root.notch-voices[index]));
                                }
                            }
                        }

                        SettingRow {
                            title: "Volume suara";
                            desc: "Keras suara maskot, 0–100";
                            stacked: root.stacked;
                            HorizontalLayout {
                                spacing: 8px;
                                TextField {
                                    width: 80px;
                                    text: root.notch-voice-volume;
                                    placeholder: "80";
                                    edited(text) => { root.notch-voice-volume = text; }
                                    accepted(text) => {
                                        root.notch-settings-changed();
                                        root.toast("Volume suara: " + text);
                                    }
                                }
                                Btn {
                                    label: "Tes suara";
                                    variant: "secondary";
                                    clicked => { root.test-notch-voice(); }
                                }
                            }
                        }

                        Text {
                            text: "Pet";
                            font-size: Design.font-h3;
                            font-weight: 700;
                            color: Design.text-primary;
                        }

                        // Pet PetDex (galeri petdex.dev — model
                        // skill Hermes): install dari galeri, pilih
                        // aktif, hapus. Pet aktif tampil di mode
                        // Avatar Pet (bukan di pill notch). Blob
                        // bawaan = default bila belum ada pet.
                        // ComboBox = baris SettingRow (label kiri);
                        // install + daftar pet ter-install tetap
                        // full-width di bawahnya (daftar butuh lebar).
                        VerticalLayout {
                            spacing: 6px;
                            SettingRow {
                                title: "Pet";
                                desc: "Maskot mode Avatar Pet — blob bawaan, atau pet animasi dari galeri PetDex (gratis, 5340+ pet). Ketik slug atau nama pet, lalu Install. Kredit pembuat tampil di bawah nama.";
                                stacked: root.stacked;
                                ComboBox {
                                    width: root.stacked ? parent.width : 260px;
                                    model: root.pet-names;
                                    current-index: root.pet-active-index;
                                    selected(index) => {
                                        root.pet-active-index = index;
                                        root.pet-active-changed(index);
                                        root.toast("Pet aktif: " + root.pet-names[index]);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                TextField {
                                    horizontal-stretch: 1;
                                    text <=> root.pet-install-input;
                                    placeholder: "slug atau nama pet, misal: boba";
                                    accepted(text) => {
                                        root.pet-install-requested(text);
                                    }
                                }
                                Btn {
                                    label: root.pet-install-busy ? "Mengunduh…" : "Install";
                                    variant: "secondary";
                                    enabled: !root.pet-install-busy;
                                    clicked => { root.pet-install-requested(root.pet-install-input); }
                                }
                            }
                            for pet[i] in root.pet-installed-slugs : PetRow {
                                label: root.pet-installed-names[i];
                                author: root.pet-installed-authors[i];
                                selected: root.pet-active-index == i + 1;
                                clicked => {
                                    root.pet-active-index = i + 1;
                                    root.pet-active-changed(i + 1);
                                    root.toast("Pet aktif: " + root.pet-installed-names[i]);
                                }
                                delete => { root.pet-remove-requested(i); }
                                open => { root.pet-open-page(i); }
                            }
                        }

                    }
                }

                // ===== RADIAL MENU =====
                sv-radial-menu := Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.group == "Radial Menu";
                    VerticalLayout {
                        x: 0; width: content-rect.width;
                        // Isi rapat di atas (alignment start): tanpa ini,
                        // konten yang lebih pendek dari viewport
                        // direnggangkan ke tinggi penuh — lih. DESIGN_SYSTEM §17.4.
                        alignment: start;
                        spacing: Design.space-lg;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 16px;
                        padding-bottom: Design.space-lg;

                        Text {
                            text: "Radial Menu";
                            font-size: Design.font-h3;
                            font-weight: 800;
                            color: Design.text-primary;
                        }

                        Card {
                            VerticalLayout {
                                padding: Design.space-lg;
                                spacing: Design.space-md;
                                Text {
                                    text: "RADIAL WHEEL SLOTS (8 ARAH TRIGONOMETRI)";
                                    font-size: Design.font-h3;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                    color: Design.text-primary;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "Pratinjau roda live 1:1 — 7 slot skrip + 1 navigasi More/Back di posisi 180° (Selatan)";
                                    font-size: Design.font-caption;
                                    color: Design.text-muted;
                                    wrap: word-wrap;
                                }

                                // Lebar: roda + rincian berdampingan.
                                // Menumpuk (520px): roda di atas (tengah),
                                // 8 chip rincian penuh lebar di bawah —
                                // berdampingan butuh ~500px, konten 520px
                                // cuma 256px.
                                if !root.stacked : HorizontalLayout {
                                    spacing: Design.space-lg;
                                    RadialWheelPreview { }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            SlotChip { label: "0° (Utara): SEND-LOGO [Sub]"; accent-text: true; width: 140px; }
                                            SlotChip { label: "45° (NE): SEND-TEXT [Sub]"; accent-text: true; width: 140px; }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            SlotChip { label: "90° (Timur): TOOLBOX [Grup]"; accent-text: true; width: 140px; }
                                            SlotChip { label: "135° (SE): CROP-CENTER"; width: 140px; }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            SlotChip { label: "180° (Selatan): MORE (Nav)"; more: true; width: 140px; }
                                            SlotChip { label: "225° (SW): COLOR-MATCH"; width: 140px; }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            SlotChip { label: "270° (Barat): AUTO-SAVE"; width: 140px; }
                                            SlotChip { label: "315° (NW): EXPORT-JPG"; width: 140px; }
                                        }
                                    }
                                }
                                if root.stacked : VerticalLayout {
                                    spacing: Design.space-md;
                                    HorizontalLayout {
                                        alignment: center;
                                        RadialWheelPreview { }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        SlotChip { label: "0° (Utara): SEND-LOGO [Sub]"; accent-text: true; }
                                        SlotChip { label: "45° (NE): SEND-TEXT [Sub]"; accent-text: true; }
                                        SlotChip { label: "90° (Timur): TOOLBOX [Grup]"; accent-text: true; }
                                        SlotChip { label: "135° (SE): CROP-CENTER"; }
                                        SlotChip { label: "180° (Selatan): MORE (Nav)"; more: true; }
                                        SlotChip { label: "225° (SW): COLOR-MATCH"; }
                                        SlotChip { label: "270° (Barat): AUTO-SAVE"; }
                                        SlotChip { label: "315° (NW): EXPORT-JPG"; }
                                    }
                                }
                            }
                        }

                        Card {
                            VerticalLayout {
                                padding: Design.space-lg;
                                spacing: Design.space-md;
                                Text {
                                    text: "GAYA & SEGMEN RADIAL";
                                    font-size: Design.font-h3;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                    color: Design.text-primary;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "Segmen radial mengikuti warna aksen tema aktif (Spider = merah, Gwen = pink) — berlaku langsung tanpa restart";
                                    font-size: Design.font-caption;
                                    color: Design.text-muted;
                                    wrap: word-wrap;
                                }

                                // Gaya ring radial: Kaca = ring kaca
                                // gelap transparan; HUD = outline tipis
                                // + glow aksen di segmen aktif; Flat =
                                // datar tanpa kaca/glow.
                                SettingRow {
                                    title: "Gaya radial";
                                    desc: "Kaca = ring kaca gelap; HUD = outline tipis + glow aksen; Flat = datar tanpa glow";
                                    stacked: root.stacked;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        OptionChip {
                                            label: "Kaca";
                                            horizontal-stretch: 1;
                                            selected: root.radial-style == "glass";
                                            clicked => { root.radial-style = "glass"; root.radial-settings-changed(); root.toast("Gaya radial: Kaca"); }
                                        }
                                        OptionChip {
                                            label: "HUD";
                                            horizontal-stretch: 1;
                                            selected: root.radial-style == "hud";
                                            clicked => { root.radial-style = "hud"; root.radial-settings-changed(); root.toast("Gaya radial: HUD"); }
                                        }
                                        OptionChip {
                                            label: "Flat";
                                            horizontal-stretch: 1;
                                            selected: root.radial-style == "flat";
                                            clicked => { root.radial-style = "flat"; root.radial-settings-changed(); root.toast("Gaya radial: Flat"); }
                                        }
                                    }
                                }

                                // Jumlah segmen ring (split rule): ring
                                // dibagi N segmen sama rata; segmen
                                // terakhir selalu navigasi (More/Back).
                                // 9–12 baru terbuka bila slot radial
                                // bisa diedit user.
                                SettingRow {
                                    title: "Jumlah segmen";
                                    desc: "Ring dibagi sama rata sesuai jumlah segmen — segmen terakhir selalu More/Back";
                                    stacked: root.stacked;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        OptionChip {
                                            label: "2";
                                            horizontal-stretch: 1;
                                            selected: root.radial-segments == 2;
                                            clicked => { root.radial-segments = 2; root.radial-settings-changed(); root.toast("Segmen radial: 2"); }
                                        }
                                        OptionChip {
                                            label: "3";
                                            horizontal-stretch: 1;
                                            selected: root.radial-segments == 3;
                                            clicked => { root.radial-segments = 3; root.radial-settings-changed(); root.toast("Segmen radial: 3"); }
                                        }
                                        OptionChip {
                                            label: "4";
                                            horizontal-stretch: 1;
                                            selected: root.radial-segments == 4;
                                            clicked => { root.radial-segments = 4; root.radial-settings-changed(); root.toast("Segmen radial: 4"); }
                                        }
                                        OptionChip {
                                            label: "5";
                                            horizontal-stretch: 1;
                                            selected: root.radial-segments == 5;
                                            clicked => { root.radial-segments = 5; root.radial-settings-changed(); root.toast("Segmen radial: 5"); }
                                        }
                                        OptionChip {
                                            label: "6";
                                            horizontal-stretch: 1;
                                            selected: root.radial-segments == 6;
                                            clicked => { root.radial-segments = 6; root.radial-settings-changed(); root.toast("Segmen radial: 6"); }
                                        }
                                        OptionChip {
                                            label: "8";
                                            horizontal-stretch: 1;
                                            selected: root.radial-segments == 8;
                                            clicked => { root.radial-segments = 8; root.radial-settings-changed(); root.toast("Segmen radial: 8"); }
                                        }
                                    }
                                }
                            }
                        }

                        SettingRow {
                            title: "Shortcut menu";
                            desc: "Shortcut global membuka radial tepat di posisi cursor";
                            stacked: root.stacked;
                            VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.recording-shortcut ? "MENUNGGU INPUT — tekan kombinasi keyboard / tombol mouse. Esc untuk batal." : "Shortcut saat ini:";
                                    font-size: Design.font-caption;
                                    color: root.recording-shortcut ? Design.accent : Design.text-muted;
                                    wrap: word-wrap;
                                }
                                // Lebar: kotak + tombol berdampingan
                                // saat lebar; menumpuk (kotak penuh +
                                // tombol penuh) saat sempit — berdampingan
                                // butuh ~390px, konten 520px cuma 256px.
                                if !root.stacked : HorizontalLayout {
                                    spacing: Design.space-sm;
                                    Rectangle {
                                        width: 260px;
                                        height: 36px;
                                        background: Design.bg-hover;
                                        border-color: root.recording-shortcut ? Design.accent : Design.separator;
                                        border-width: 1px;
                                        border-radius: Design.radius-sm;
                                        Text {
                                            text: root.recording-shortcut ? "MENUNGGU INPUT…" : root.current-shortcut-label;
                                            font-size: Design.font-button;
                                            font-weight: 700;
                                            color: root.recording-shortcut ? Design.accent : Design.text-primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Btn {
                                        label: root.recording-shortcut ? "Batal" : "Rekam Shortcut";
                                        variant: root.recording-shortcut ? "secondary" : "primary";
                                        clicked => {
                                            if (root.recording-shortcut) { root.cancel-recording-shortcut(); }
                                            else { root.start-recording-shortcut(); }
                                        }
                                    }
                                }
                                if root.stacked : VerticalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        height: 36px;
                                        background: Design.bg-hover;
                                        border-color: root.recording-shortcut ? Design.accent : Design.separator;
                                        border-width: 1px;
                                        border-radius: Design.radius-sm;
                                        Text {
                                            text: root.recording-shortcut ? "MENUNGGU INPUT…" : root.current-shortcut-label;
                                            font-size: Design.font-button;
                                            font-weight: 700;
                                            color: root.recording-shortcut ? Design.accent : Design.text-primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Btn {
                                        label: root.recording-shortcut ? "Batal" : "Rekam Shortcut";
                                        variant: root.recording-shortcut ? "secondary" : "primary";
                                        clicked => {
                                            if (root.recording-shortcut) { root.cancel-recording-shortcut(); }
                                            else { root.start-recording-shortcut(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ===== PROFILE =====
                sv-profile := Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.group == "Profile";
                    VerticalLayout {
                        x: 0; width: content-rect.width;
                        // Isi rapat di atas (alignment start): tanpa ini,
                        // konten yang lebih pendek dari viewport
                        // direnggangkan ke tinggi penuh — lih. DESIGN_SYSTEM §17.4.
                        alignment: start;
                        spacing: Design.space-lg;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 16px;
                        padding-bottom: Design.space-lg;

                        Text {
                            text: "Profile";
                            font-size: Design.font-h3;
                            font-weight: 800;
                            color: Design.text-primary;
                        }

                        Card {
                            VerticalLayout {
                                padding: Design.space-lg;
                                spacing: Design.space-md;
                                HorizontalLayout {
                                    spacing: 12px;
                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        background: Design.card-bg;
                                        border-color: Design.separator;
                                        border-width: 1px;
                                        border-radius: 22px;
                                        SvgIcon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            name: "user";
                                            size: 18px;
                                            icon-color: Design.text-secondary;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        alignment: center;
                                        Text {
                                            text: root.user-name;
                                            font-size: Design.font-h3;
                                            font-weight: 800;
                                            color: Design.text-primary;
                                        }
                                        Text {
                                            text: "Avatar memakai huruf pertama dari nama user";
                                            font-size: Design.font-caption;
                                            color: Design.text-muted;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        SettingRow {
                            title: "Nama user";
                            desc: "Nama yang tampil di profil & log";
                            stacked: root.stacked;
                            TextField {
                                // Secukupnya (260px) saat lebar, penuh saat menumpuk.
                                width: root.stacked ? parent.width : 260px;
                                text: root.user-name;
                                placeholder: "Nama user";
                                edited(text) => { root.user-name = text; }
                                accepted(text) => { root.save-general-settings(); root.toast("Disimpan: Nama user"); }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            padding-top: Design.space-md;
                            Btn {
                                label: "Simpan";
                                variant: "primary";
                                height-override: 34px;
                                clicked => {
                                    root.save-general-settings();
                                    root.toast("Pengaturan Profile disimpan");
                                }
                            }
                        }
                    }
                }

                // ===== ABOUT =====
                sv-about := Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: root.group == "About";
                    VerticalLayout {
                        x: 0; width: content-rect.width;
                        // Isi rapat di atas (alignment start): tanpa ini,
                        // konten yang lebih pendek dari viewport
                        // direnggangkan ke tinggi penuh (ruang ekstra
                        // dibagi ke anak-anak) — lih. DESIGN_SYSTEM §17.4.
                        alignment: start;
                        spacing: Design.space-lg;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 16px;
                        padding-bottom: Design.space-lg;
                        Card {
                            VerticalLayout {
                                padding: Design.space-xl;
                                spacing: Design.space-sm;
                                Text {
                                    text: "BMachine";
                                    font-size: Design.font-h2;
                                    font-weight: 800;
                                    color: Design.text-primary;
                                }
                                Text {
                                    text: "v6.5.0";
                                    font-size: Design.font-body;
                                    font-weight: 700;
                                    color: Design.text-primary;
                                }
                                Text {
                                    text: "Port Rust/Slint (mockup interaktif)";
                                    font-size: Design.font-body;
                                    color: Design.text-secondary;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "Dibangun dari BMachine C# (Avalonia/.NET 8).";
                                    font-size: Design.font-caption;
                                    color: Design.text-muted;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    Btn {
                                        label: "Periksa Update";
                                        variant: "secondary";
                                        clicked => { root.check-update(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
