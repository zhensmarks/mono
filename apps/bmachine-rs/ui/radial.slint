// Radial Menu — Port RadialMenuWindow.axaml & RadialMenuViewModel.cs C# dengan akurasi 1:1.
// Dimensi kanvas & tata letak:
// - Kanvas 320x320 terpusat (Pusat: x=160, y=160)
// - Pelat utama: lingkaran 200px (radius 100px) di pusat kanvas
// - Hub tengah padat: lingkaran 88px (radius 44px) dengan teks judul (uppercase, tracking +2) & subjudul
// - Garis pemisah 8 sektor (22.5°, 67.5°, 112.5°, 157.5°, 202.5°, 247.5°, 292.5°, 337.5°)
// - PieWedge hover glow: busur anular 45° (R_in=44px, R_out=100px) menyala saat sektor dipilih
// - 8 Tombol menu 36x36 pada radius 72px (tengah antara 44px dan 100px), hover scale 1.15
// - Ring luar submenu (R_in=104px, R_out=152px): busur petal tab DOC / TOOLBOX (_tb_*.jsx)
// - Pelacakan sudut polar pointer (atan2, 0° = Utara/Atas, searah jarum jam)
// - Dwell timer 300ms untuk membuka submenu & release-to-execute saat tombol hotkey dilepas.

import { Design, SvgIcon } from "design.slint";

// Tombol 36x36 bundar di cincin dalam (sesuai MenuButton di RadialMenuWindow.axaml)
component RadialMenuButton inherits Rectangle {
    in property <string> icon-name;
    in property <string> short-name;
    in property <bool> hovered;
    in property <bool> has-sub;
    in property <bool> is-nav;
    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: root.hovered ? Design.accent-subtle : Design.card-bg;
    border-color: root.hovered ? Design.accent : Design.separator;
    border-width: root.hovered ? 2px : 1px;
    clip: false;

    animate background { duration: Design.anim-fast; }
    animate border-color { duration: Design.anim-fast; }

    // Efek scale 1.15x saat hovered
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.hovered ? 36px : 32px;
        height: root.hovered ? 36px : 32px;

        if root.icon-name != "" : SvgIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.icon-name;
            size: root.hovered ? 20px : 18px;
            icon-color: root.hovered ? Design.accent : Design.text-primary;
        }

        if root.icon-name == "" : Text {
            text: root.short-name;
            font-size: 11px;
            font-weight: 800;
            color: root.hovered ? Design.accent : Design.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }

    // Dot indikator jika item memiliki submenu
    if root.has-sub : Rectangle {
        x: parent.width - 7px;
        y: 4px;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: root.hovered ? Design.accent : Design.text-muted;
    }
}

// Petal / Wedge busur luar untuk submenu (R=104..152px)
component SubmenuPetal inherits Rectangle {
    in property <string> label;
    in property <string> icon-name;
    in property <bool> hovered;
    callback clicked();

    height: 30px;
    border-radius: 6px;
    background: root.hovered ? Design.accent : Design.surface-elevated;
    border-color: root.hovered ? Design.accent : Design.separator;
    border-width: 1px;

    animate background { duration: Design.anim-fast; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;

        if root.icon-name != "" : SvgIcon {
            name: root.icon-name;
            size: 13px;
            icon-color: root.hovered ? Design.app-bg : Design.text-primary;
        }

        Text {
            text: root.label;
            font-size: 10px;
            font-weight: 700;
            color: root.hovered ? Design.app-bg : Design.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

export component RadialMenuView inherits Rectangle {
    callback back();
    callback toast(string);
    callback execute-script(string);
    callback open-toolbox(string);

    in-out property <int> doc-tab-count: 2;

    // Halaman menu: 0 = Page 1 (7 skrip + More), 1 = Page 2 (skrip berikutnya + Back)
    in-out property <int> current-page: 0;

    // Hovered slot index: -1 = tidak ada, 0..7 = sektor 0..7
    in-out property <int> hovered-sector: -1;
    in-out property <string> hovered-id: "";
    in-out property <string> hovered-name: "";
    in-out property <bool> hovered-has-sub: false;

    // Submenu aktif: "" | "TOOLBOX" | "SEND-LOGO" | "SEND-TEXT"
    in-out property <string> active-submenu: "";
    in-out property <int> hovered-outer-idx: -1;

    // Center Hub Texts (C# CenterTextTitle & CenterTextSubtitle)
    in-out property <string> center-title: "B-MACHINE";
    in-out property <string> center-subtitle: "HOLD TO SELECT";

    // Metadata 8 Sektor Roda Dalam Page 1
    // Urutan C#: 0=SEND-LOGO (Utara/0°), 1=SEND-TEXT (NE/45°), 2=TOOLBOX (East/90°), 3=CROP-CENTER (SE/135°),
    // 4=MORE (South/180°), 5=COLOR-MATCH (SW/225°), 6=AUTO-SAVE (West/270°), 7=EXPORT-JPG (NW/315°)
    property <[string]> p1-ids: ["SEND-LOGO", "SEND-TEXT", "TOOLBOX", "CROP-CENTER", "MORE", "COLOR-MATCH", "AUTO-SAVE", "EXPORT-JPG"];
    property <[string]> p1-names: ["Send Logo", "Send Text", "Toolbox", "Crop Center", "More...", "Color Match", "Auto Save", "Export JPG"];
    property <[string]> p1-icons: ["image", "file-text", "wrench", "crop", "more-horizontal", "palette", "save", "download"];
    property <[string]> p1-shorts: ["LG", "TX", "TB", "CR", "•••", "CM", "SV", "EX"];
    property <[bool]> p1-subs: [true, true, true, false, false, false, false, false];

    // Metadata 8 Sektor Roda Dalam Page 2
    property <[string]> p2-ids: ["BATCH-CONV", "WATERMARK", "METADATA", "RENAME-ALL", "BACK", "COMPRESS", "SMART-CROP", "BACKUP"];
    property <[string]> p2-names: ["Batch Conv", "Watermark", "Metadata", "Rename All", "Back", "Compress", "Smart Crop", "Backup"];
    property <[string]> p2-icons: ["layers", "droplet", "info", "edit-3", "arrow-left", "minimize", "maximize", "hard-drive"];
    property <[string]> p2-shorts: ["BC", "WM", "MD", "RN", "←", "CP", "SC", "BK"];
    property <[bool]> p2-subs: [false, false, false, false, false, false, false, false];

    // Items Submenu TOOLBOX: 5 file _tb_*.jsx C# asli (BMACHINE_RADIAL_MENU.md §11.3)
    property <[string]> tb-items: ["C-REDAKSI", "FOOTNOTE", "IMAGE_SIZE", "NOMORSATSET", "SELEKSI_ALAM"];
    property <[string]> tb-labels: ["C-Redaksi", "Footnote", "Image Size", "NomorSatset", "Seleksi Alam"];
    property <[string]> tb-icons: ["file-text", "book-open", "maximize", "hash", "crop"];

    // Posisi X/Y 8 Tombol Menu pada R = 72px (diukur relatif dari kanvas 320x320, cx=160, cy=160, btn 36x36 -> -18px)
    // 0 (0°/Utara):    (160 - 18, 160 - 72 - 18) = (142, 70)
    // 1 (45°/NE):      (160 + 51 - 18, 160 - 51 - 18) = (193, 91)
    // 2 (90°/Timur):   (160 + 72 - 18, 160 - 18) = (214, 142)
    // 3 (135°/SE):     (160 + 51 - 18, 160 + 51 - 18) = (193, 193)
    // 4 (180°/Selatan):(160 - 18, 160 + 72 - 18) = (142, 214)
    // 5 (225°/SW):     (160 - 51 - 18, 160 + 51 - 18) = (91, 193)
    // 6 (270°/Barat):  (160 - 72 - 18, 160 - 18) = (70, 142)
    // 7 (315°/NW):     (160 - 51 - 18, 160 - 51 - 18) = (91, 91)
    property <[length]> btn-x: [142px, 193px, 214px, 193px, 142px, 91px, 70px, 91px];
    property <[length]> btn-y: [70px, 91px, 142px, 193px, 214px, 193px, 142px, 91px];

    // Reset state menu
    public function reset() {
        root.hovered-sector = -1;
        root.hovered-id = "";
        root.hovered-name = "";
        root.hovered-has-sub = false;
        root.active-submenu = "";
        root.hovered-outer-idx = -1;
        root.current-page = 0;
        root.center-title = "B-MACHINE";
        root.center-subtitle = "HOLD TO SELECT";
    }

    // Eksekusi item yang saat ini disorot
    public function execute-current() {
        if (root.active-submenu != "" && root.hovered-outer-idx >= 0) {
            if (root.active-submenu == "TOOLBOX") {
                root.execute-script("_tb_" + root.tb-items[root.hovered-outer-idx] + ".jsx");
                root.toast("Toolbox: " + root.tb-items[root.hovered-outer-idx]);
            } else {
                root.execute-script(root.active-submenu + " - Tab " + (root.hovered-outer-idx + 1));
                root.toast(root.active-submenu + " (Tab " + (root.hovered-outer-idx + 1) + ")");
            }
            root.reset();
            root.back();
            return;
        }

        if (root.hovered-sector < 0) {
            root.reset();
            root.back();
            return;
        }

        // Handle navigation: MORE & BACK
        if (root.hovered-id == "MORE") {
            root.current-page = 1;
            root.hovered-sector = -1;
            root.hovered-id = "";
            root.center-title = "PAGE 2";
            root.center-subtitle = "SELECT";
            return;
        }
        if (root.hovered-id == "BACK") {
            root.current-page = 0;
            root.hovered-sector = -1;
            root.hovered-id = "";
            root.center-title = "PAGE 1";
            root.center-subtitle = "SELECT";
            return;
        }

        // Buka submenu jika memiliki sub
        if (root.hovered-has-sub) {
            // TOOLBOX: klik / release pada sektor membuka ToolboxWindow
            // langsung (port: main.slint "radial membuka TOOLBOX langsung
            // pada tab MantraNama"). C# membuka window lewat eksekusi
            // psdbucin_v3.pyw — roda port fixed 8 sektor tanpa item
            // psdbucin, jadi sektor TOOLBOX yang jadi pemicunya. Hover
            // tetap membuka submenu 5 skrip _tb_ (pointer-event di atas),
            // jadi skrip tetap bisa dieksekusi lewat petal.
            if (root.hovered-id == "TOOLBOX") {
                root.open-toolbox("MantraNama");
                root.reset();
                root.back();
                return;
            }
            root.active-submenu = root.hovered-id;
            root.center-subtitle = "PILIH SUB-MENU";
            return;
        }

        // Eksekusi skrip biasa
        root.execute-script(root.hovered-name);
        root.toast("Menjalankan: " + root.hovered-name);
        root.reset();
        root.back();
    }

    // Dipanggil saat tombol global dilepas (release-to-execute)
    public function release-execute() {
        if (root.hovered-sector >= 0 || (root.active-submenu != "" && root.hovered-outer-idx >= 0)) {
            root.execute-current();
        } else {
            root.reset();
            root.back();
        }
    }

    // Pelacak pointer polar: mouse-x, mouse-y relatif terhadap kanvas 320x320
    public function update-pointer(mx: length, my: length) {
        // Offset relatif terhadap pusat roda (160px, 160px)
        // Slint length ke nilai skalar (dibagi 1px)
        let dx: float = (mx - 160px) / 1px;
        let dy: float = (my - 160px) / 1px;
        let dist: float = sqrt(dx * dx + dy * dy);

        // Deadzone tengah (< 44px)
        if (dist < 44.0) {
            root.hovered-sector = -1;
            root.hovered-id = "";
            root.hovered-name = "";
            root.hovered-has-sub = false;
            root.hovered-outer-idx = -1;
            root.center-title = root.current-page == 0 ? "B-MACHINE" : "PAGE 2";
            root.center-subtitle = "SELECT";
            return;
        }

        // Deadzone luar (> 156px)
        if (dist > 156.0) {
            root.hovered-sector = -1;
            root.hovered-id = "";
            root.hovered-outer-idx = -1;
            return;
        }

        // Hitung sudut polar atan2 (0° = Utara/Atas, searah jarum jam)
        let deg-raw: float = atan2(dx, -dy) / 1deg;
        let deg: float = deg-raw < 0.0 ? deg-raw + 360.0 : deg-raw;

        // Cek jika berada di band luar submenu (102px .. 156px) saat submenu aktif
        if (root.active-submenu != "" && dist >= 102.0) {
            if (root.active-submenu == "TOOLBOX") {
                // 5 item TOOLBOX tersebar di busur timur-selatan (45° .. 225°)
                if (deg >= 35.0 && deg < 75.0) { root.hovered-outer-idx = 0; }
                else if (deg >= 75.0 && deg < 115.0) { root.hovered-outer-idx = 1; }
                else if (deg >= 115.0 && deg < 155.0) { root.hovered-outer-idx = 2; }
                else if (deg >= 155.0 && deg < 195.0) { root.hovered-outer-idx = 3; }
                else if (deg >= 195.0 && deg < 235.0) { root.hovered-outer-idx = 4; }
                else { root.hovered-outer-idx = -1; }

                if (root.hovered-outer-idx >= 0) {
                    root.center-title = root.tb-labels[root.hovered-outer-idx];
                    root.center-subtitle = "EXECUTE";
                }
            } else {
                // DOC tab 1 & 2 di busur utara-timur
                if (deg >= 0.0 && deg < 60.0) { root.hovered-outer-idx = 0; }
                else if (deg >= 60.0 && deg < 120.0 && root.doc-tab-count > 1) { root.hovered-outer-idx = 1; }
                else { root.hovered-outer-idx = -1; }

                if (root.hovered-outer-idx >= 0) {
                    root.center-title = "DOC TAB " + (root.hovered-outer-idx + 1);
                    root.center-subtitle = "EXECUTE";
                }
            }
            return;
        }

        // Band dalam roda utama (44px .. 102px): 8 sektor @ 45°
        let shifted-raw: float = deg + 22.5;
        let shifted: float = shifted-raw >= 360.0 ? shifted-raw - 360.0 : shifted-raw;
        let sec: int = min(7, max(0, floor(shifted / 45.0)));

        root.hovered-sector = sec;
        root.hovered-outer-idx = -1;

        if (root.current-page == 0) {
            root.hovered-id = root.p1-ids[sec];
            root.hovered-name = root.p1-names[sec];
            root.hovered-has-sub = root.p1-subs[sec];
        } else {
            root.hovered-id = root.p2-ids[sec];
            root.hovered-name = root.p2-names[sec];
            root.hovered-has-sub = root.p2-subs[sec];
        }

        root.center-title = root.hovered-name;
        root.center-subtitle = root.hovered-has-sub ? "HOLD FOR SUBMENU" : "SELECT";

        // Buka submenu otomatis jika dwell pada item ber-submenu
        if (root.hovered-has-sub) {
            root.active-submenu = root.hovered-id;
        } else if (root.active-submenu != "") {
            root.active-submenu = "";
        }
    }

    // Dim latar belakang semi-transparan
    Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: Design.overlay-solid;
        opacity: 0.65;
    }

    // Klik backdrop = tutup
    back-touch := TouchArea {
        x: 0; y: 0; width: 100%; height: 100%;
        clicked => { root.reset(); root.back(); }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.reset();
                root.back();
            }
        }
    }

    // ============================================================
    // KANVAS UTAMA 320x320 TERPUSAT
    // ============================================================
    Rectangle {
        x: (root.width - 320px) / 2;
        y: (root.height - 320px) / 2;
        width: 320px;
        height: 320px;

        // 1. Cincin Luar Submenu Petals (R_in=104px, R_out=152px)
        if root.active-submenu == "TOOLBOX" : Rectangle {
            width: 100%; height: 100%;
            // 5 Petal skrip toolbox di sisi kanan-bawah (_tb_*.jsx C#)
            SubmenuPetal {
                x: 185px; y: 22px; width: 110px;
                label: root.tb-labels[0]; icon-name: root.tb-icons[0];
                hovered: root.hovered-outer-idx == 0;
                clicked => { root.hovered-outer-idx = 0; root.execute-current(); }
            }
            SubmenuPetal {
                x: 212px; y: 64px; width: 105px;
                label: root.tb-labels[1]; icon-name: root.tb-icons[1];
                hovered: root.hovered-outer-idx == 1;
                clicked => { root.hovered-outer-idx = 1; root.execute-current(); }
            }
            SubmenuPetal {
                x: 218px; y: 145px; width: 100px;
                label: root.tb-labels[2]; icon-name: root.tb-icons[2];
                hovered: root.hovered-outer-idx == 2;
                clicked => { root.hovered-outer-idx = 2; root.execute-current(); }
            }
            SubmenuPetal {
                x: 205px; y: 225px; width: 105px;
                label: root.tb-labels[3]; icon-name: root.tb-icons[3];
                hovered: root.hovered-outer-idx == 3;
                clicked => { root.hovered-outer-idx = 3; root.execute-current(); }
            }
            SubmenuPetal {
                x: 170px; y: 268px; width: 110px;
                label: root.tb-labels[4]; icon-name: root.tb-icons[4];
                hovered: root.hovered-outer-idx == 4;
                clicked => { root.hovered-outer-idx = 4; root.execute-current(); }
            }
        }

        if root.active-submenu == "SEND-LOGO" || root.active-submenu == "SEND-TEXT" : Rectangle {
            width: 100%; height: 100%;
            SubmenuPetal {
                x: 175px; y: 20px; width: 95px;
                label: "DOC Tab 1"; icon-name: "file-text";
                hovered: root.hovered-outer-idx == 0;
                clicked => { root.hovered-outer-idx = 0; root.execute-current(); }
            }
            if root.doc-tab-count > 1 : SubmenuPetal {
                x: 215px; y: 70px; width: 95px;
                label: "DOC Tab 2"; icon-name: "file-text";
                hovered: root.hovered-outer-idx == 1;
                clicked => { root.hovered-outer-idx = 1; root.execute-current(); }
            }
        }

        // 2. Pelat Lingkaran Utama 200px (radius 100px)
        main-plate := Rectangle {
            x: 60px; y: 60px;
            width: 200px; height: 200px;
            border-radius: 100px;
            background: Design.surface-elevated;
            border-color: Design.separator;
            border-width: 1px;
            clip: true;

            // 3. Hover PieWedge Glow (8 Sektor Anular R44..R100)
            // Sektor 0 (Utara)
            if root.hovered-sector == 0 : Path {
                width: 100%; height: 100%;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
                fill: Design.accent; opacity: 0.35;
                commands: "M 61.73 7.61 A 100 100 0 0 1 138.27 7.61 L 116.84 59.35 A 44 44 0 0 0 83.16 59.35 Z";
            }
            // Sektor 1 (NE)
            if root.hovered-sector == 1 : Path {
                width: 100%; height: 100%;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
                fill: Design.accent; opacity: 0.35;
                commands: "M 138.27 7.61 A 100 100 0 0 1 192.39 61.73 L 140.65 83.16 A 44 44 0 0 0 116.84 59.35 Z";
            }
            // Sektor 2 (Timur)
            if root.hovered-sector == 2 : Path {
                width: 100%; height: 100%;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
                fill: Design.accent; opacity: 0.35;
                commands: "M 192.39 61.73 A 100 100 0 0 1 192.39 138.27 L 140.65 116.84 A 44 44 0 0 0 140.65 83.16 Z";
            }
            // Sektor 3 (SE)
            if root.hovered-sector == 3 : Path {
                width: 100%; height: 100%;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
                fill: Design.accent; opacity: 0.35;
                commands: "M 192.39 138.27 A 100 100 0 0 1 138.27 192.39 L 116.84 140.65 A 44 44 0 0 0 140.65 116.84 Z";
            }
            // Sektor 4 (Selatan)
            if root.hovered-sector == 4 : Path {
                width: 100%; height: 100%;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
                fill: Design.accent; opacity: 0.35;
                commands: "M 138.27 192.39 A 100 100 0 0 1 61.73 192.39 L 83.16 140.65 A 44 44 0 0 0 116.84 140.65 Z";
            }
            // Sektor 5 (SW)
            if root.hovered-sector == 5 : Path {
                width: 100%; height: 100%;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
                fill: Design.accent; opacity: 0.35;
                commands: "M 61.73 192.39 A 100 100 0 0 1 7.61 138.27 L 59.35 116.84 A 44 44 0 0 0 83.16 140.65 Z";
            }
            // Sektor 6 (Barat)
            if root.hovered-sector == 6 : Path {
                width: 100%; height: 100%;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
                fill: Design.accent; opacity: 0.35;
                commands: "M 7.61 138.27 A 100 100 0 0 1 7.61 61.73 L 59.35 83.16 A 44 44 0 0 0 59.35 116.84 Z";
            }
            // Sektor 7 (NW)
            if root.hovered-sector == 7 : Path {
                width: 100%; height: 100%;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
                fill: Design.accent; opacity: 0.35;
                commands: "M 7.61 61.73 A 100 100 0 0 1 61.73 7.61 L 83.16 59.35 A 44 44 0 0 0 59.35 83.16 Z";
            }

            // 4. Garis Pembatas 8 Sektor (Persis RadialMenuWindow.axaml C#)
            Path {
                width: 100%; height: 100%;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 200; viewbox-height: 200;
                fill: transparent;
                stroke: Design.text-primary;
                stroke-width: 1px;
                opacity: 0.18;
                commands: "M 116.84 59.35 L 138.27 7.61 M 140.65 83.16 L 192.39 61.73 M 140.65 116.84 L 192.39 138.27 M 116.84 140.65 L 138.27 192.39 M 83.16 140.65 L 61.73 192.39 M 59.35 116.84 L 7.61 138.27 M 59.35 83.16 L 7.61 61.73 M 83.16 59.35 L 61.73 7.61";
            }
        }

        // 5. Cincin Struktural Konsentris Luar (200px) & Dalam (88px)
        Rectangle {
            x: 60px; y: 60px; width: 200px; height: 200px;
            border-radius: 100px;
            border-color: Design.text-primary;
            border-width: 1px;
            opacity: 0.18;
        }
        Rectangle {
            x: 116px; y: 116px; width: 88px; height: 88px;
            border-radius: 44px;
            border-color: Design.text-primary;
            border-width: 1px;
            opacity: 0.18;
        }

        // 6. 8 Tombol Menu Bundar 36x36 pada R = 72px
        for i in 8 : RadialMenuButton {
            x: root.btn-x[i];
            y: root.btn-y[i];
            icon-name: root.current-page == 0 ? root.p1-icons[i] : root.p2-icons[i];
            short-name: root.current-page == 0 ? root.p1-shorts[i] : root.p2-shorts[i];
            hovered: root.hovered-sector == i;
            has-sub: root.current-page == 0 ? root.p1-subs[i] : root.p2-subs[i];
            is-nav: i == 4;
            clicked => {
                root.hovered-sector = i;
                root.execute-current();
            }
        }

        // 7. Hub Tengah Padat 88x88 (Circular Center Hub)
        center-hub := Rectangle {
            x: 116px; y: 116px;
            width: 88px; height: 88px;
            border-radius: 44px;
            background: Design.card-bg;
            border-color: Design.separator;
            border-width: 1.5px;
            clip: true;

            VerticalLayout {
                alignment: center;
                spacing: 3px;
                padding-left: 6px;
                padding-right: 6px;

                Text {
                    text: root.center-title;
                    font-size: 10px;
                    font-weight: 800;
                    letter-spacing: 1.5px;
                    color: Design.text-primary;
                    horizontal-alignment: center;
                    overflow: elide;
                    max-width: 76px;
                }
                Text {
                    text: root.center-subtitle;
                    font-size: 8px;
                    font-weight: 600;
                    color: root.hovered-has-sub ? Design.accent : Design.text-secondary;
                    horizontal-alignment: center;
                    overflow: elide;
                    max-width: 76px;
                }
            }
        }

        // 8. TouchArea Pelacak Sudut Pointer (Menyeluruh 320x320)
        wheel-touch := TouchArea {
            x: 0; y: 0; width: 100%; height: 100%;
            mouse-cursor: pointer;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.move) {
                    root.update-pointer(self.mouse-x, self.mouse-y);
                } else if (ev.kind == PointerEventKind.down) {
                    if (ev.button == PointerEventButton.right) {
                        root.reset();
                        root.back();
                    } else if (ev.button == PointerEventButton.left) {
                        root.update-pointer(self.mouse-x, self.mouse-y);
                        root.execute-current();
                    }
                }
            }
        }
    }
}
