// SpreadsheetComponent — Komponen Grid Spreadsheet bergaya Excel / Google Sheets
// (logika spreadsheet beneran — 27 Nov 2026, lihat DESIGN_SYSTEM.md §19.3a)
// Mendukung:
// - Header Kolom (A: Kode, B: Sekolah, C: Jenjang, D: Status, E: Poin, F: Catatan, G: Tanggal)
// - Nomor Baris (1, 2, 3...) = nomor baris sheet asli
// - Jenis sel per kolom (dari Rust, sheet_model.rs): teks / angka / dropdown / tanggal;
//   kolom KODE terkunci (ID baris, tidak bisa diedit)
// - Seleksi multi-baris ala C# (DataGrid Extended): klik = satu sel, Shift+klik /
//   seret = rentang baris, Ctrl+klik = tambah/hapus baris dari seleksi;
//   highlight hanya di kolom fokus (seperti C# UpdateCellSelectionVisuals)
// - Edit: klik ganda / F2 / Enter / ketik langsung; sel dropdown & tanggal
//   cukup klik tunggal; Enter = terapkan, Esc = batalkan, klik sel lain =
//   terapkan (teks) / batalkan (dropdown & tanggal)
// - Dropdown: daftar pilihan mengambang + panah ▾ di sel; Tanggal: kalender
//   mengambang + tombol TODAY (format simpan yyyy-MM-dd, seperti C#)
// - Ctrl+D fill down (baris teratas seleksi -> baris lain, kolom fokus),
//   Delete/Backspace hapus isi sel terpilih di kolom fokus
// - Navigasi keyboard: panah (Shift+panah = perluas seleksi)
// - Tombol Tambah Baris, Auto-Sum (∑, dihitung Rust), Zoom, Refresh, Simpan (Draft tracking)
// - Mode Standalone Window atau Embedded View di modul utama.

import { Design, Btn, SvgIcon, TextField } from "design.slint";

// Satu sel data grid: nilai tampil + penanda sel aktif (border aksen 2px +
// handle dot kecil di sudut kanan-bawah) + highlight seleksi multi-baris
// (latar accent-subtle di kolom fokus, seperti C#) + penanda jenis sel
// (▾ dropdown, ikon kalender tanggal, gembok saat terkunci).
component GridCell inherits Rectangle {
    in property <string> text;
    in property <bool> is-active;
    in property <bool> is-header;
    in property <bool> is-numeric;
    in property <bool> is-selected;
    in property <bool> is-locked;
    // Jenis sel: "text" | "number" | "dropdown" | "date".
    in property <string> kind: "text";
    in property <color> text-color: Design.text-primary;
    // Editor: teks awal saat edit dimulai + apakah seleksi awal dipilih semua.
    in property <string> edit-initial: "";
    in property <bool> edit-select-all: true;
    in property <bool> editing;
    callback clicked();
    callback double-clicked();
    // edited = terapkan isi editor (Enter / kehilangan fokus). edit-changed
    // = cermin tiap ketikan (dipakai commit saat klik sel lain / Simpan).
    callback edited(string);
    callback edit-changed(string);

    background: root.is-active || root.is-selected ? Design.accent-subtle : transparent;
    border-color: root.is-active ? Design.accent : Design.separator;
    border-width: root.is-active ? 2px : 0.5px;
    clip: true;

    cell-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }

    Text {
        // Nilai tampil saat TIDAK mengedit (termasuk saat sel aktif —
        // editor hanya muncul saat editing, seperti C#: klik = pilih saja).
        // Saat mengedit dropdown/tanggal, nilai tetap tampil (editornya
        // daftar/kalender, bukan TextInput — seperti ComboBox C#).
        // Rata tengah SEMUA sel (28 Nov 2026, abeng: ikuti sheet kantor
        // "ORDER PT DMA - NSJ 26-27" — semua sel center, "jangan egois").
        // Dulu: teks kiri / angka kanan / tanggal tengah. Ikon (▾ /
        // gembok / kalender) digambar DI ATAS teks, jadi teks dipusatkan
        // di lebar sel penuh, bukan di sisa lebar setelah ikon.
        visible: !root.editing || root.kind == "dropdown" || root.kind == "date";
        x: 0;
        y: 0;
        width: parent.width;
        height: 100%;
        text: root.text;
        font-size: root.is-header ? Design.font-caption : 12px;
        font-weight: root.is-header ? 800 : (root.is-active ? 700 : 400);
        font-family: root.is-numeric ? "JetBrains Mono" : Design.font-family;
        color: root.is-active ? Design.accent : root.text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    // Panah ▾ di sel dropdown (C# CreateCellDisplayTemplate) + gembok di
    // sel terkunci + ikon kalender kecil di sel tanggal.
    if !root.is-header && root.kind == "dropdown" : Text {
        text: "▾";
        font-size: 10px;
        color: Design.text-muted;
        x: parent.width - 16px;
        y: parent.height - 15px;
        width: 12px;
        height: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !root.is-header && root.is-locked : SvgIcon {
        name: "lock";
        size: 11px;
        icon-color: Design.text-muted;
        x: parent.width - 17px;
        y: (parent.height - self.height) / 2;
    }
    if !root.is-header && root.kind == "date" && root.text != "" : SvgIcon {
        name: "calendar";
        size: 11px;
        icon-color: Design.text-muted;
        x: parent.width - 17px;
        y: (parent.height - self.height) / 2;
    }

    // Dot handle seleksi ala Excel di pojok kanan bawah
    if root.is-active : Rectangle {
        x: parent.width - 5px;
        y: parent.height - 5px;
        width: 5px;
        height: 5px;
        background: Design.accent;
    }

    // Editor langsung di sel (C# tidak punya formula bar — edit langsung
    // di sel, Enter = terapkan, Esc = batalkan, klik sel lain = terapkan).
    // Hanya tampil saat sel ini sedang diedit (editing) — klik tunggal
    // HANYA memilih sel (C# BeginningEdit membatalkan edit klik tunggal).
    editor := TextInput {
        // Hanya untuk teks & angka. Dropdown memakai daftar opsi,
        // tanggal memakai kalender (overlay di luar grid) — keduanya
        // dibuka begin-edit(); TextInput di sini akan salah tempat.
        visible: root.editing && (root.kind == "text" || root.kind == "number");
        x: 6px;
        y: 0;
        width: parent.width - 12px;
        height: 100%;
        // Editor ikut rata tengah seperti selnya (28 Nov 2026 — ikuti
        // sheet kantor; dulu teks kiri / angka kanan). Editor hanya
        // untuk teks & angka, tanpa ikon, jadi x 6px + lebar -12px
        // sudah simetris (pusatnya = pusat sel).
        text: root.text;
        font-size: 12px;
        font-family: root.is-numeric ? "JetBrains Mono" : Design.font-family;
        color: Design.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        accepted => { root.edited(self.text); }
        edited => { root.edit-changed(self.text); }
        changed has-focus => {
            // Kehilangan fokus = terapkan (klik toolbar / Simpan / sel lain
            // saat editor tidak sempat commit lewat jalur lain).
            if (!self.has-focus && root.editing) { root.edited(self.text); }
        }
    }

    changed editing => {
        if (root.editing && (root.kind == "text" || root.kind == "number")) {
            editor.text = root.edit-initial;
            editor.focus();
            if (root.edit-select-all) { editor.select-all(); }
        }
    }

    // Sinkronkan editor saat teks sel berubah dari luar (Muat Ulang /
    // Simpan / Fill Down): setelah pengguna mengetik, binding `text: root.text`
    // editor putus (nilai ketikan menimpa binding), jadi push nilai baru
    // dari Rust tidak sampai ke editor — sel aktif menampilkan nilai
    // lama (27 Nov 2026: setelah Muat Ulang, B1 tetap menampilkan
    // nilai draft padahal grid sudah dimuat ulang dari sheet).
    changed text => {
        if (!root.editing) { editor.text = root.text; }
    }
}

export component SpreadsheetComponent inherits Rectangle {
    in-out property <bool> is-standalone: false;
    // Radius sudut luar saat dipakai sebagai window mandiri
    // (diisi window; 0px saat embedded di AppWindow).
    in-out property <length> outer-radius: 0px;
    in-out property <string> search-query: "";
    // Status jujur: default "Belum terhubung" (28 Nov 2026 — default
    // lama "Terhubung ke Google Sheets" tampil bersamaan dengan data
    // lokal adalah bug tampilan; Rust menimpa teks ini begitu status
    // koneksi diketahui).
    in-out property <string> status-text: "Belum terhubung ke Google Sheets";
    in-out property <bool> has-draft: false;
    in-out property <int> draft-count: 0;
    in-out property <float> zoom-level: 1.0;

    // Sel aktif saat ini: row 0-based DALAM JENDELA halaman, col 0-based.
    in-out property <int> active-row: 0;
    in-out property <int> active-col: 1; // Default di kolom 'Sekolah'

    // Hasil guard saat Simpan (ditulis Rust selama callback save-changes(),
    // dibaca commit-save() setelahnya): "" = lolos, berisi pesan = diblokir.
    in-out property <string> guard-result: "";

    // Callbacks
    callback toast(string);
    callback save-changes();
    callback refresh-data();
    callback popout-window();
    callback close-view();
    // Edit sel -> Rust mencatat draft (baris 0-based DALAM JENDELA,
    // kolom 0-based, nilai asli saat dimuat, nilai baru) + persist ke
    // SQLite. Rust menambahkan page-start sebelum mencatat.
    callback cell-edited(int, int, string, string);
    // Operasi massal + kalender (dikerjakan Rust dari state sheet bersama):
    // fill-down / clear-cells membaca seleksi + kolom fokus dari properti
    // window (sel-rows / focus-col); auto-sum menghitung kolom Poin;
    // cal-open/cal-nav mendorong state kalender (cal-*); add-row
    // menambah baris kosong (model Slint tidak bisa di-append dari
    // .slint — operator + bukan concat array di Slint 1.19).
    callback fill-down();
    callback clear-cells();
    callback auto-sum();
    callback cal-open(string);
    callback cal-nav(int);
    callback add-row();
    // Pindah halaman jendela grid (Rust menggeser page-start + mendorong
    // ulang jendela; no-op bila sudah di ujung).
    callback prev-page();
    callback next-page();
    // Type-to-edit: apakah satu karakter boleh memulai edit (diputuskan
    // Rust — karakter kontrol seperti Enter/Tab tidak).
    callback is-typeahead-char(string) -> bool;
    // Hit-test kolom dari posisi x (dihitung Rust dari lebar kolom —
    // Slint 1.19 TIDAK punya `for` di dalam fungsi, jadi hit-test
    // kolom yang butuh loop tinggal di Rust; row-from-y murni
    // matematika dan tetap di .slint).
    callback hit-col(length) -> int;
    // Hitung seleksi baris baru (Rust — alasan sama): (baris, kolom,
    // mode 0=satu baris / 1=tambah rentang / 2=balik, anchor).
    // Mengembalikan model sel-rows baru.
    callback select-rows(int, int, int, int) -> [bool];

    // ===== Data grid DINAMIS (28 Nov 2026 — kolom dari header sheet,
    // bukan fixed 7) =====
    // grid[r][c] = nilai tampil jendela halaman; grid-orig[r][c] =
    // nilai asli saat dimuat (jangkar guard + nilai asli draft).
    // Hanya satu jendela yang dirender (page-start..+page-size);
    // total-rows = seluruh baris data. Default KOSONG (27 Nov 2026,
    // keputusan abeng: default publish harus bersih).
    in-out property <[[string]]> grid: [];
    in-out property <[[string]]> grid-orig: [];
    // Definisi kolom (didorong Rust — lokal 7 kolom atau dinamis dari
    // header sheet live): header tampil, huruf, jenis, kunci, lebar
    // px, offset-x kumulatif px, opsi dropdown per kolom.
    in-out property <[string]> col-headers: ["KODE", "SEKOLAH", "JENJANG", "STATUS", "POIN", "CATATAN", "TANGGAL"];
    in-out property <[string]> col-letters: ["A", "B", "C", "D", "E", "F", "G"];
    in-out property <[string]> col-kinds: ["text", "text", "dropdown", "dropdown", "number", "text", "date"];
    in-out property <[bool]> col-locked: [true, false, false, false, false, false, false];
    in-out property <[float]> col-widths: [110, 200, 80, 100, 90, 200, 100];
    in-out property <[float]> col-x-offsets: [0, 110, 310, 390, 490, 580, 780];
    in-out property <[[string]]> col-items: [[], [], ["TK", "PAUD", "SD", "SMP", "SMA", "SMK"], ["SELESAI", "PROSES", "REVISI", "ANTRIAN"], [], [], []];
    // Indeks kolom kunci tetap (NO FAKTUR) — sel kunci HANYA bisa diedit
    // bila masih kosong (baris baru); -1 = tanpa kunci.
    in-out property <int> key-col: 0;
    // Paging jendela grid (Slint tidak memvirtualisasi seperti DataGrid
    // C# — 16.308 baris × 20 kolom tidak bisa jadi elemen).
    in-out property <int> page-start: 0;
    in-out property <int> page-size: 100;
    in-out property <int> total-rows: 0;
    // Nomor baris sheet (1-based) baris pertama jendela (gutter) —
    // live: header_row + view_start (didorong Rust).
    in-out property <int> row-num-base: 1;
    // Label halaman ("Hal 1 dari 164") — dihitung Rust (pembagian
    // bilangan bulat di .slint tidak stabil).
    in-out property <string> page-label: "";
    // Jumlah baris jendela = panjang model grid; jumlah kolom = panjang
    // definisi header (keduanya didorong Rust saat push grid).
    property <int> row-count: root.grid.length;
    property <int> col-count: root.col-headers.length;
    // Lebar isi grid (gutter 42px + seluruh kolom) + tinggi isi
    // (padding 2px + header 28px + baris 32px).
    property <float> content-width: 42 + (root.col-count > 0 ? root.col-x-offsets[root.col-count - 1] + root.col-widths[root.col-count - 1] : 0);
    property <length> content-height: 2px + 28px + root.row-count * 32px;

    // Geometri overlay dropdown & kalender (KOORDINAT ISI Flickable —
    // overlay kini anak content-rect, jadi ikut scroll + terpotong
    // viewport; dulu anak root dengan grid-rect.x/y + hdr-*.x).
    property <length> dd-list-height: root.dd-items.length * 32px + 2px;
    // Opsi dropdown kolom aktif (properti murni — `for` tidak boleh
    // memanggil fungsi impure seperti dropdown-items()).
    property <[string]> dd-items: root.active-col >= 0 && root.active-col < root.col-items.length ? root.col-items[root.active-col] : [];
    property <length> dd-cell-top: 1px + 28px + root.active-row * 32px;
    property <length> dd-col-x: 1px + 42px + (root.active-col >= 0 && root.active-col < root.col-count ? root.col-x-offsets[root.active-col] * 1px : 0px);
    property <length> dd-col-width: root.active-col >= 0 && root.active-col < root.col-count ? root.col-widths[root.active-col] * 1px : 120px;
    property <bool> dd-below: root.dd-cell-top + 32px + root.dd-list-height <= root.content-height - 8px;
    // Tinggi kalender: header 32 + nama hari 20 + 6 baris × 28 +
    // 7 celah × 2 + padding 4×2 = 242px (228px sebelumnya memotong
    // setengah baris minggu ke-6, mis. tgl 30 November 2026).
    property <length> cal-height: 242px;
    property <bool> cal-below: root.dd-cell-top + 32px + root.cal-height <= root.content-height - 8px;
    // Jepit horizontal supaya overlay tidak keluar isi (kolom paling
    // kanan: kalender 240px akan terpotong di tepi isi).
    property <length> dd-x: max(0px, min(root.dd-col-x, root.content-width * 1px - max(root.dd-col-width, 120px)));
    property <length> cal-x: max(0px, min(root.dd-col-x, root.content-width * 1px - 240px));

    // ===== State seleksi multi-baris (ala C# DataGrid Extended) =====
    // Baris terpilih (satu bool per baris jendela) + kolom fokus.
    // Highlight hanya di sel (baris terpilih, kolom fokus) — seperti C#
    // UpdateCellSelectionVisuals. Anchor = sel awal rentang Shift/drag.
    // Panjang model didorong Rust tiap push grid (selalu = row-count).
    in-out property <[bool]> sel-rows: [];
    in-out property <int> focus-col: 1;
    in-out property <int> anchor-row: 0;
    in-out property <int> anchor-col: 1;
    in-out property <bool> dragging: false;

    // ===== State edit =====
    in-out property <bool> editing: false;
    // Cermin isi editor teks (diperbarui tiap ketikan — dipakai commit
    // saat klik sel lain / Simpan / Muat Ulang selagi mengedit).
    in-out property <string> edit-text: "";
    in-out property <string> edit-initial: "";
    in-out property <bool> edit-select-all: true;
    // Sorotan keyboard di daftar dropdown (-1 = belum ada).
    in-out property <int> dd-highlight: 0;

    // ===== State kalender tanggal (didorong Rust) =====
    in-out property <int> cal-year: 2026;
    in-out property <int> cal-month: 1;
    in-out property <string> cal-label: "";
    in-out property <[int]> cal-cells: [];
    in-out property <int> cal-today: 0;
    in-out property <int> cal-days-in-month: 31;
    in-out property <string> cal-today-iso: "";
    in-out property <int> cal-selected-day: 0;

    public function col-kind(c: int) -> string {
        c >= 0 && c < root.col-kinds.length ? root.col-kinds[c] : "text"
    }
    // Sel aktif / fokus dijepit saat jendela berubah ukuran (ganti
    // halaman / ganti kolom): tanpa ini active-row halaman lama bisa
    // menunjuk baris yang tidak ada di halaman baru.
    changed row-count => {
        if (root.active-row >= root.row-count) {
            root.active-row = max(root.row-count - 1, 0);
        }
    }
    changed col-count => {
        if (root.active-col >= root.col-count) {
            root.active-col = max(root.col-count - 1, 0);
        }
        if (root.focus-col >= root.col-count) {
            root.focus-col = max(root.col-count - 1, 0);
        }
    }
    public function col-is-locked(c: int) -> bool {
        c >= 0 && c < root.col-locked.length ? root.col-locked[c] : false
    }
    public function col-letter(c: int) -> string {
        c >= 0 && c < root.col-letters.length ? root.col-letters[c] : ""
    }
    // Sel terkunci? Kolom kunci (NO FAKTUR) terkunci bila sel sudah
    // berisi nilai (order yang sudah ada); sel kosong (baris baru)
    // boleh diisi NO FAKTUR-nya — kalau tidak, order baru tidak bisa
    // dibuat dari aplikasi.
    public function cell-locked(r: int, c: int) -> bool {
        root.col-is-locked(c) && !(c == root.key-col && root.cell-text(r, c) == "")
    }
    public function edit-kind() -> string {
        root.col-kind(root.active-col)
    }
    public function cell-text(r: int, c: int) -> string {
        r >= 0 && r < root.row-count && c >= 0 && c < root.col-count ? root.grid[r][c] : ""
    }
    public function cell-orig(r: int, c: int) -> string {
        r >= 0 && r < root.row-count && c >= 0 && c < root.col-count ? root.grid-orig[r][c] : ""
    }
    public function dropdown-items(c: int) -> [string] {
        c >= 0 && c < root.col-items.length ? root.col-items[c] : []
    }
    // Warna teks sel: kolom STATUS diwarnai menurut nilainya (aturan
    // lama kolom D lokal, kini berdasarkan nama header supaya berlaku
    // juga di grid live); kolom POIN memakai warna kategori poin.
    public function cell-color(r: int, c: int) -> color {
        if (c >= 0 && c < root.col-count && root.col-headers[c] == "STATUS") {
            root.cell-text(r, c) == "SELESAI" ? Design.status-success : root.cell-text(r, c) == "REVISI" ? Design.status-danger : Design.status-warning
        } else if (c >= 0 && c < root.col-count && root.col-headers[c] == "POIN") {
            Design.cat-points
        } else {
            Design.text-primary
        }
    }
    // CATATAN Slint: fungsi yang membaca global Design tetap dianggap
    // impure — jadi logika warna/kunci sel di binding GridCell ditulis
    // inline (di atas), bukan lewat fungsi. Fungsi cell-color /
    // cell-locked di atas hanya dipakai dari callback (klik/edit).
    // Hit-test overlay (koordinat isi Flickable): kolom dari posisi x
    // via callback Rust hit-col (gutter 42px + padding 1px, jadi x<43
    // = gutter); baris dari posisi y (header 28px, baris 32px).
    public function row-from-y(y: length) -> int {
        if (y < 29px) {
            return -1;
        }
        let idx = floor((y - 29px) / 32px);
        idx >= root.row-count ? -1 : idx
    }

    // Pilih satu sel (klik biasa / panah): seleksi = baris itu saja,
    // kolom fokus = kolom klik (C# CurrentCell). Model sel-rows
    // dihitung Rust (callback select-rows) karena .slint tidak punya
    // `for` di dalam fungsi.
    public function select-cell(r: int, c: int) {
        if (r >= 0 && r < root.row-count) {
            // Klik gutter (c = -1): pilih baris, kolom fokus tetap.
            let cc = c < 0 ? root.focus-col : c;
            root.anchor-row = r;
            root.anchor-col = cc;
            root.active-row = r;
            root.active-col = cc;
            root.focus-col = cc;
            root.sel-rows = root.select-rows(r, cc, 0, 0);
        }
    }
    // Shift+klik / seret: rentang baris anchor..r ditambahkan ke seleksi;
    // kolom fokus TETAP (C# OnDataGridCurrentCellChanged).
    public function extend-selection(r: int, c: int) {
        if (r >= 0 && r < root.row-count) {
            root.sel-rows = root.select-rows(r, c, 1, root.anchor-row);
            root.active-row = r;
            if (c >= 0) { root.active-col = c; }
        }
    }
    // Ctrl+klik: tambah/hapus baris dari seleksi; sel aktif pindah ke sel klik.
    public function toggle-row(r: int, c: int) {
        if (r >= 0 && r < root.row-count) {
            let cc = c < 0 ? root.focus-col : c;
            root.sel-rows = root.select-rows(r, cc, 2, 0);
            root.active-row = r;
            root.active-col = cc;
            root.focus-col = cc;
        }
    }
    // Pindah sel aktif (panah): seleksi jadi satu sel.
    public function move-active(dr: int, dc: int) {
        root.select-cell(min(max(root.active-row + dr, 0), max(root.row-count - 1, 0)), min(max(root.active-col + dc, 0), max(root.col-count - 1, 0)));
    }
    // Shift+panah: vertikal = perluas rentang baris; horizontal = pindah
    // sel aktif + kolom fokus ikut (seleksi baris tetap).
    public function move-active-extend(dr: int, dc: int) {
        let nr = min(max(root.active-row + dr, 0), max(root.row-count - 1, 0));
        let nc = min(max(root.active-col + dc, 0), max(root.col-count - 1, 0));
        if (dc == 0) {
            root.extend-selection(nr, nc);
        } else {
            root.active-row = nr;
            root.active-col = nc;
            root.focus-col = nc;
        }
    }

    // Mulai edit sel aktif (klik ganda / F2 / Enter / klik tunggal
    // dropdown & tanggal). Sel terkunci: toast, tidak jadi edit.
    public function begin-edit() {
        root.dragging = false;
        if (root.cell-locked(root.active-row, root.active-col)) {
            root.toast("Sel terkunci — kolom " + root.col-letter(root.active-col) + " (" + root.cell-text(root.active-row, root.active-col) + ") tidak bisa diedit");
        } else {
            root.edit-initial = root.cell-text(root.active-row, root.active-col);
            // edit-text harus diinisialisasi dari nilai awal — kalau tidak,
            // commit tanpa mengetik (klik sel lain / Simpan) akan menulis
            // nilai basi dari edit sebelumnya.
            root.edit-text = root.edit-initial;
            root.edit-select-all = true;
            root.dd-highlight = 0;
            root.editing = true;
            if (root.col-kinds[root.active-col] == "date") {
                root.cal-open(root.edit-initial);
            }
        }
    }
    // Ketik langsung saat sel terpilih (type-to-edit): teks/dropdown/
    // tanggal beda perlakuannya — teks & angka langsung terisi hurufnya.
    public function begin-edit-with-text(t: string) {
        root.dragging = false;
        if (!root.cell-locked(root.active-row, root.active-col)) {
            if (root.col-kinds[root.active-col] == "dropdown" || root.col-kinds[root.active-col] == "date") {
                root.begin-edit();
            } else {
                root.edit-initial = t;
                root.edit-text = t;
                root.edit-select-all = false;
                root.editing = true;
            }
        }
    }
    // Terapkan edit yang sedang berjalan (Enter / klik sel lain / Simpan).
    // Dropdown & tanggal sudah diterapkan saat dipilih — di sini hanya tutup.
    public function commit-edit() {
        if (root.editing) {
            if (root.edit-kind() == "text" || root.edit-kind() == "number") {
                root.apply-cell-edit(root.edit-text);
            }
            root.dragging = false;
            root.editing = false;
            // Editor TextInput menyedot fokus saat edit; kalau tidak
            // dikembalikan ke scope, panah/Ctrl+D tidak jalan setelah
            // Enter (fokus hilang bersama editor yang tersembunyi).
            grid-scope.focus();
        }
    }
    // Batalkan edit (Esc / klik sel lain pada dropdown & tanggal).
    public function cancel-edit() {
        root.dragging = false;
        root.editing = false;
        grid-scope.focus();
    }
    // Klik sel lain selagi mengedit: teks = terapkan, dropdown/tanggal =
    // batalkan (C# — nilai dropdown/tanggal hanya berubah saat dipilih).
    public function cell-clicked(r: int, c: int) {
        if (root.editing) {
            if (root.edit-kind() == "text" || root.edit-kind() == "number") {
                root.commit-edit();
            } else {
                root.cancel-edit();
            }
            root.select-cell(r, c);
            if (root.col-kinds[root.active-col] == "dropdown" || root.col-kinds[root.active-col] == "date") {
                root.begin-edit();
            }
        }
    }
    public function cell-double-clicked(r: int, c: int) {
        if (root.editing) {
            if (r != root.active-row || c != root.active-col) {
                root.begin-edit();
            }
        } else {
            root.select-cell(r, c);
            root.begin-edit();
        }
    }

    // Pilih nilai dropdown (klik opsi / Enter saat sorotan keyboard).
    public function pick-dropdown(val: string) {
        root.apply-cell-edit(val);
        root.dragging = false;
        root.editing = false;
        grid-scope.focus();
    }
    // Pilih tanggal dari kalender (format yyyy-MM-dd, seperti C#).
    public function pick-date(day: int) {
        if (day >= 1 && day <= root.cal-days-in-month) {
            root.apply-cell-edit("" + root.cal-year + "-" + (root.cal-month < 10 ? "0" + root.cal-month : root.cal-month) + "-" + (day < 10 ? "0" + day : day));
            root.dragging = false;
            root.editing = false;
            grid-scope.focus();
        }
    }
    // Tombol TODAY: tulis tanggal hari ini (cal-today-iso dari Rust) —
    // BUKAN hari yang sama di bulan yang sedang ditampilkan.
    public function pick-today() {
        root.apply-cell-edit(root.cal-today-iso);
        root.dragging = false;
        root.editing = false;
        grid-scope.focus();
    }
    // Geser hari terpilih di kalender (panah keyboard).
    public function cal-move(dx: int) {
        root.cal-selected-day = min(max(root.cal-selected-day + dx, 1), root.cal-days-in-month);
    }

    // Tulis nilai baru dari formula bar / input ke sel aktif.
    // Nilai asli diambil dari grid-orig (nilai saat dimuat) — itu yang
    // dicatat draft + dipakai jangkar guard (bukan nilai hasil edit
    // sebelumnya). Tanpa perubahan nilai: bukan draft (mencegah
    // draft-count ganda saat commit dua kali — Enter lalu kehilangan fokus).
    public function apply-cell-edit(val: string) {
        let r: int = root.active-row;
        let c: int = root.active-col;
        if (val != root.cell-text(r, c)) {
            let orig: string = root.cell-orig(r, c);
            root.grid[r][c] = val;
            root.has-draft = true;
            root.draft-count += 1;
            root.status-text = "● Perubahan belum disimpan (" + root.draft-count + " sel)";
            root.cell-edited(r, c, orig, val);
        }
    }

    // Fungsi Auto-Sum kolom Poin — dihitung Rust (bukan hardcode).
    public function calc-auto-sum() {
        root.auto-sum();
    }

    // Tambah baris baru — dikerjakan Rust (append model tidak bisa dari
    // .slint; Rust membaca grid tampil, menambah baris kosong, dan
    // mendorong ke kedua tampilan; row-count = panjang model).
    public function add-new-row() {
        root.add-row();
    }

    // Simpan perubahan — terapkan dulu edit yang sedang berjalan (supaya
    // tidak hilang saat klik Simpan selagi mengetik), lalu guard jalan di
    // Rust selama save-changes(): guard-result "" = lolos (baru bersihkan
    // draft), berisi pesan = diblokir (draft dipertahankan, pesan guard
    // tampil di status). Pesan sukses ditulis Rust (live vs lokal) —
    // .slint tidak menimpa status-text saat lolos.
    public function commit-save() {
        root.commit-edit();
        root.save-changes();
        if (root.guard-result == "") {
            root.has-draft = false;
            root.draft-count = 0;
            root.toast("Spreadsheet tersimpan");
        } else {
            root.status-text = root.guard-result;
            root.toast(root.guard-result);
        }
    }

    background: Design.app-bg;
    border-radius: root.outer-radius;

    VerticalLayout {
        padding: Design.space-md;
        spacing: Design.space-sm;

        // ===== 1. Toolbar Atas (Search, Aksi Baris, Zoom, Paging, Simpan, Popout) =====
        HorizontalLayout {
            height: 36px;
            spacing: Design.space-sm;

            // Search Bar
            Rectangle {
                horizontal-stretch: 1;
                height: 34px;
                border-radius: Design.radius-sm;
                background: Design.bg-input;
                border-color: Design.border-default;
                border-width: 1px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;

                    VerticalLayout {
                        alignment: center;
                        SvgIcon {
                            name: "search";
                            size: 14px;
                            icon-color: Design.text-muted;
                        }
                    }
                    TextInput {
                        text <=> root.search-query;
                        font-size: Design.font-body;
                        color: Design.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }

            // Tombol Tambah Baris
            Btn {
                label: "+ Baris";
                variant: "secondary";
                small: true;
                clicked => { root.commit-edit(); root.add-new-row(); }
            }

            // Tombol Auto-Sum
            Btn {
                label: "∑ SUM";
                variant: "secondary";
                small: true;
                clicked => { root.calc-auto-sum(); }
            }

            // Zoom Controls
            Rectangle {
                width: 90px;
                height: 32px;
                background: Design.surface-elevated;
                border-color: Design.separator;
                border-width: 1px;
                border-radius: Design.radius-sm;

                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;

                    Rectangle {
                        width: 24px; height: 100%;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.zoom-level > 0.8) { root.zoom-level -= 0.1; }
                            }
                        }
                        Text {
                            text: "-"; font-size: 14px; font-weight: 800;
                            color: Design.text-secondary; horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    Text {
                        text: (floor(root.zoom-level * 100)) + "%";
                        font-size: 10px; font-weight: 700; font-family: "JetBrains Mono";
                        color: Design.text-primary; vertical-alignment: center;
                    }
                    Rectangle {
                        width: 24px; height: 100%;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.zoom-level < 1.4) { root.zoom-level += 0.1; }
                            }
                        }
                        Text {
                            text: "+"; font-size: 14px; font-weight: 800;
                            color: Design.text-secondary; horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }

            // Paging jendela grid (100 baris/halaman — Slint tidak
            // memvirtualisasi; Rust memegang seluruh data).
            Rectangle {
                width: 148px;
                height: 32px;
                background: Design.surface-elevated;
                border-color: Design.separator;
                border-width: 1px;
                border-radius: Design.radius-sm;

                HorizontalLayout {
                    alignment: center;
                    spacing: 2px;

                    Rectangle {
                        width: 24px; height: 100%;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.commit-edit(); root.prev-page(); }
                        }
                        Text {
                            text: "‹"; font-size: 16px; font-weight: 800;
                            color: Design.text-secondary; horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.page-label;
                        font-size: 10px;
                        font-weight: 700;
                        font-family: "JetBrains Mono";
                        color: Design.text-primary;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 24px; height: 100%;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.commit-edit(); root.next-page(); }
                        }
                        Text {
                            text: "›"; font-size: 16px; font-weight: 800;
                            color: Design.text-secondary; horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }

            // Refresh Data
            Btn {
                label: "Muat Ulang";
                variant: "ghost";
                small: true;
                clicked => {
                    root.commit-edit();
                    root.refresh-data();
                    root.toast("Memuat ulang data dari Google Sheet...");
                }
            }

            // Simpan / Commit
            Btn {
                label: root.has-draft ? "Simpan (" + root.draft-count + ")" : "Simpan";
                variant: root.has-draft ? "primary" : "secondary";
                small: true;
                clicked => { root.commit-save(); }
            }

            // Tombol Buka Window Baru (jika sedang embedded) atau Tutup (jika standalone)
            if !root.is-standalone : Rectangle {
                width: 32px; height: 32px;
                background: pop-touch.has-hover ? Design.bg-hover : transparent;
                border-radius: Design.radius-sm;
                border-color: Design.separator;
                border-width: 1px;
                pop-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.commit-edit(); root.popout-window(); }
                }
                SvgIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: "external-link";
                    size: 14px;
                    icon-color: Design.text-secondary;
                }
            }
        }

        // ===== 2. Tabel DataGrid Spreadsheet =====
        // Flickable dua arah: kolom fixed-px (lebar dari header sheet)
        // bisa melewati lebar window (20 kolom ALL DATA REGULER ≈ 2,5
        // ribu px); baris dirender per jendela halaman (100 baris).
        // Hit-test overlay di dalam isi (koordinat isi, bukan viewport)
        // — hit-col (Rust) / row-from-y memakai offset Rust.
        grid-rect := Rectangle {
            vertical-stretch: 1;
            background: Design.card-bg;
            border-color: Design.separator;
            border-width: 1px;
            border-radius: Design.radius-md;
            clip: true;

            grid-scope := FocusScope {
                width: 100%;
                height: 100%;
                focus-on-click: false;
                // Navigasi + aksi keyboard (aktif juga saat fokus di editor
                // teks — key event membubbling ke scope ini, pola
                // main.slint keys-scope). Slint melarang dua KeyBinding
                // dengan tombol yang sama di satu scope — jadi satu
                // binding per tombol, mode (tidak edit / dropdown /
                // tanggal) dipilih di dalam activated. Enter saat mengedit
                // teks ditelan TextInput (accepted) sehingga binding
                // Return tidak ikut jalan.
                KeyBinding { keys: @keys(UpArrow); activated => { if (!root.editing) { root.move-active(-1, 0); } else if (root.col-kinds[root.active-col] == "dropdown") { root.dd-highlight = max(root.dd-highlight - 1, 0); } else if (root.col-kinds[root.active-col] == "date") { root.cal-move(-7); } } }
                KeyBinding { keys: @keys(DownArrow); activated => { if (!root.editing) { root.move-active(1, 0); } else if (root.col-kinds[root.active-col] == "dropdown") { root.dd-highlight = min(root.dd-highlight + 1, root.dd-items.length - 1); } else if (root.col-kinds[root.active-col] == "date") { root.cal-move(7); } } }
                KeyBinding { keys: @keys(LeftArrow); activated => { if (!root.editing) { root.move-active(0, -1); } else if (root.col-kinds[root.active-col] == "date") { root.cal-move(-1); } } }
                KeyBinding { keys: @keys(RightArrow); activated => { if (!root.editing) { root.move-active(0, 1); } else if (root.col-kinds[root.active-col] == "date") { root.cal-move(1); } } }
                KeyBinding { keys: @keys(Shift + UpArrow); activated => { if (!root.editing) { root.move-active-extend(-1, 0); } } }
                KeyBinding { keys: @keys(Shift + DownArrow); activated => { if (!root.editing) { root.move-active-extend(1, 0); } } }
                KeyBinding { keys: @keys(Shift + LeftArrow); activated => { if (!root.editing) { root.move-active-extend(0, -1); } } }
                KeyBinding { keys: @keys(Shift + RightArrow); activated => { if (!root.editing) { root.move-active-extend(0, 1); } } }
                KeyBinding { keys: @keys(Return); activated => { if (!root.editing) { root.begin-edit(); } else if (root.col-kinds[root.active-col] == "dropdown") { root.pick-dropdown(root.dd-items[root.dd-highlight]); } else if (root.col-kinds[root.active-col] == "date") { root.pick-date(root.cal-selected-day); } } }
                KeyBinding { keys: @keys(F2); activated => { if (!root.editing) { root.begin-edit(); } } }
                KeyBinding { keys: @keys(Control + D); activated => { if (!root.editing) { root.fill-down(); } } }
                KeyBinding { keys: @keys(Delete); activated => { if (!root.editing) { root.clear-cells(); } } }
                KeyBinding { keys: @keys(Backspace); activated => { if (!root.editing) { root.clear-cells(); } } }
                KeyBinding { keys: @keys(Escape); activated => { if (root.editing) { root.cancel-edit(); } } }
                // Ketik langsung saat sel terpilih (type-to-edit, pola
                // explorer.slint): satu karakter tercetak, tanpa modifier.
                // Apakah karakter bisa memulai edit diputuskan Rust
                // (is-typeahead-char — Slint tidak bisa menulis "\n").
                key-pressed(event) => {
                    if (!root.editing && event.text.character-count == 1 && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && root.is-typeahead-char(event.text)) {
                        root.begin-edit-with-text(event.text);
                        return accept;
                    }
                    reject
                }

                flick := Flickable {
                    width: 100%;
                    height: 100%;
                    content-width: root.content-width * 1px;
                    content-height: root.content-height;

                    content-rect := Rectangle {
                        width: flick.content-width;
                        height: flick.content-height;

                        VerticalLayout {
                            padding: 1px;
                            spacing: 0;
                            width: 100%;
                            height: 100%;

                            // Header Kolom (huruf + nama, dari Rust)
                            HorizontalLayout {
                                height: 28px;
                                spacing: 0;

                                // Header baris kosong di pojok kiri atas
                                Rectangle {
                                    width: 42px;
                                    background: Design.surface-elevated;
                                    border-color: Design.separator;
                                    border-width: 0.5px;
                                    Text { text: "#"; font-size: 10px; font-weight: 800; color: Design.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                }

                                for c in root.col-count : GridCell {
                                    width: root.col-widths[c] * 1px;
                                    text: root.col-letters[c] + "  " + root.col-headers[c];
                                    is-header: true;
                                    is-numeric: root.col-kinds[c] == "number";
                                }
                            }

                            // Baris-baris DataGrid (jendela halaman)
                            for r in root.row-count : HorizontalLayout {
                                height: 32px;
                                spacing: 0;

                                // Nomor Baris (nomor sheet asli, bukan 1..N
                                // jendela — live: header_row + view_start).
                                Rectangle {
                                    width: 42px;
                                    background: root.active-row == r ? Design.accent-subtle : Design.surface-elevated;
                                    border-color: Design.separator;
                                    border-width: 0.5px;
                                    Text {
                                        text: root.row-num-base + r;
                                        font-size: 11px;
                                        font-weight: 700;
                                        font-family: "JetBrains Mono";
                                        color: root.active-row == r ? Design.accent : Design.text-muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                for c in root.col-count : GridCell {
                                    width: root.col-widths[c] * 1px;
                                    text: root.grid[r][c];
                                    is-numeric: root.col-kinds[c] == "number";
                                    text-color: root.col-headers[c] == "STATUS" ? (root.grid[r][c] == "SELESAI" ? Design.status-success : root.grid[r][c] == "REVISI" ? Design.status-danger : Design.status-warning) : root.col-headers[c] == "POIN" ? Design.cat-points : Design.text-primary;
                                    is-active: root.active-row == r && root.active-col == c;
                                    is-selected: r < root.sel-rows.length && root.sel-rows[r] && root.focus-col == c;
                                    is-locked: root.col-locked[c] && !(c == root.key-col && root.grid[r][c] == "");
                                    kind: root.col-kinds[c];
                                    editing: root.editing && root.active-row == r && root.active-col == c;
                                    edit-initial: root.edit-initial;
                                    edit-select-all: root.edit-select-all;
                                    clicked => { root.cell-clicked(r, c); }
                                    double-clicked => { root.cell-double-clicked(r, c); }
                                    edited(text) => { root.apply-cell-edit(text); root.editing = false; }
                                    edit-changed(text) => { root.edit-text = text; }
                                }
                            }

                            // Ruang kosong pengisi ke bawah
                            Rectangle { vertical-stretch: 1; }
                        }

                        // Overlay hit-test: menangkap klik/seret/klik-ganda
                        // di seluruh isi grid saat TIDAK mengedit. Nonaktif
                        // saat mengedit supaya klik sampai ke TouchArea
                        // tiap sel (commit/cancel + pindah sel).
                        // Klik tunggal pada sel dropdown/tanggal langsung
                        // buka editornya (C# — "dulu harus klik ganda,
                        // jadi terasa tidak bisa diklik").
                        grid-overlay := TouchArea {
                            x: 0; y: 0; width: 100%; height: 100%;
                            enabled: !root.editing;
                            mouse-cursor: pointer;
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    grid-scope.focus();
                                    if (ev.modifiers.shift) {
                                        root.extend-selection(root.row-from-y(self.mouse-y), root.hit-col(self.mouse-x));
                                        root.dragging = true;
                                    } else if (ev.modifiers.control) {
                                        root.toggle-row(root.row-from-y(self.mouse-y), root.hit-col(self.mouse-x));
                                        root.dragging = true;
                                    } else {
                                        root.select-cell(root.row-from-y(self.mouse-y), root.hit-col(self.mouse-x));
                                        // Tekan sel dropdown/tanggal langsung buka editor
                                        // (C#) — pointer-up-nya hilang karena overlay
                                        // nonaktif saat mengedit, jadi drag TIDAK boleh
                                        // dimulai di sini (kalau tidak, dragging nyangkut
                                        // true dan gerak mouse tanpa klik ikut seleksi).
                                        if (root.col-kinds[root.active-col] == "dropdown" || root.col-kinds[root.active-col] == "date") {
                                            root.begin-edit();
                                        } else {
                                            root.dragging = true;
                                        }
                                    }
                                } else if (ev.kind == PointerEventKind.up) {
                                    root.dragging = false;
                                } else if (ev.kind == PointerEventKind.move && root.dragging) {
                                    root.extend-selection(root.row-from-y(self.mouse-y), root.hit-col(self.mouse-x));
                                }
                            }
                            double-clicked => { root.begin-edit(); }
                        }

    // Daftar opsi dropdown (C# ComboBox — langsung terbuka saat edit).
    if root.editing && root.col-kinds[root.active-col] == "dropdown" : Rectangle {
        x: root.dd-x;
        y: root.dd-below ? root.dd-cell-top + 32px : root.dd-cell-top - root.dd-list-height;
        width: max(root.dd-col-width, 120px);
        height: root.dd-list-height;
        background: Design.surface-elevated;
        border-color: Design.border-default;
        border-width: 1px;
        border-radius: Design.radius-sm;
        clip: true;
        VerticalLayout {
            for item[idx] in root.dd-items : Rectangle {
                height: 32px;
                background: idx == root.dd-highlight ? Design.accent-subtle : transparent;
                dd-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.pick-dropdown(item); }
                }
                Text {
                    text: item;
                    font-size: 12px;
                    font-weight: item == root.edit-initial ? 700 : 400;
                    color: item == root.edit-initial ? Design.accent : Design.text-primary;
                    vertical-alignment: center;
                    x: 10px;
                    width: parent.width - 34px;
                }
                if item == root.edit-initial : Text {
                    text: "✓";
                    font-size: 12px;
                    font-weight: 700;
                    color: Design.accent;
                    x: parent.width - 22px;
                    y: 0;
                    height: 100%;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Kalender tanggal (C# Calendar SingleDate + tombol TODAY).
    if root.editing && root.col-kinds[root.active-col] == "date" : Rectangle {
        x: root.cal-x;
        y: root.cal-below ? root.dd-cell-top + 32px : root.dd-cell-top - root.cal-height;
        width: 240px;
        height: root.cal-height;
        background: Design.surface-elevated;
        border-color: Design.border-default;
        border-width: 1px;
        border-radius: Design.radius-sm;
        clip: true;
        VerticalLayout {
            padding: 4px;
            spacing: 2px;
            // Header: ‹ bulan › + label + TODAY
            HorizontalLayout {
                height: 32px;
                spacing: 2px;
                Rectangle {
                    width: 28px; height: 28px;
                    background: cal-prev-touch.has-hover ? Design.bg-hover : transparent;
                    border-radius: Design.radius-sm;
                    cal-prev-touch := TouchArea { mouse-cursor: pointer; clicked => { root.cal-nav(-1); } }
                    Text { text: "‹"; font-size: 16px; font-weight: 700; color: Design.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text {
                    text: root.cal-label;
                    font-size: 12px;
                    font-weight: 700;
                    color: Design.text-primary;
                    horizontal-stretch: 1;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 28px; height: 28px;
                    background: cal-next-touch.has-hover ? Design.bg-hover : transparent;
                    border-radius: Design.radius-sm;
                    cal-next-touch := TouchArea { mouse-cursor: pointer; clicked => { root.cal-nav(1); } }
                    Text { text: "›"; font-size: 16px; font-weight: 700; color: Design.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 52px; height: 28px;
                    background: cal-today-touch.has-hover ? Design.accent-subtle : transparent;
                    border-color: Design.accent;
                    border-width: 1px;
                    border-radius: Design.radius-sm;
                    cal-today-touch := TouchArea { mouse-cursor: pointer; clicked => { root.pick-today(); } }
                    Text { text: "TODAY"; font-size: 10px; font-weight: 800; color: Design.accent; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            // Nama hari (Senin dulu, seperti sheet kantor)
            HorizontalLayout {
                height: 20px;
                spacing: 0;
                for wd in ["S", "S", "R", "K", "J", "S", "M"] : Text {
                    text: wd;
                    font-size: 10px;
                    font-weight: 700;
                    color: Design.text-muted;
                    width: 32px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            // Grid 6×7 hari (cal-cells: 42 angka, 0 = sel kosong)
            for dw in 6 : HorizontalLayout {
                height: 28px;
                spacing: 0;
                for dc in 7 : Rectangle {
                    width: 32px;
                    height: 28px;
                    visible: root.cal-cells[dw * 7 + dc] != 0;
                    background: root.cal-cells[dw * 7 + dc] == root.cal-selected-day ? Design.accent : (root.cal-cells[dw * 7 + dc] == root.cal-today ? Design.accent-subtle : transparent);
                    border-radius: Design.radius-sm;
                    day-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick-date(root.cal-cells[dw * 7 + dc]); }
                    }
                    Text {
                        text: root.cal-cells[dw * 7 + dc];
                        font-size: 12px;
                        font-weight: root.cal-cells[dw * 7 + dc] == root.cal-selected-day || root.cal-cells[dw * 7 + dc] == root.cal-today ? 700 : 400;
                        color: root.cal-cells[dw * 7 + dc] == root.cal-selected-day ? white : Design.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    } // tutup blok kalender
                    } // tutup content-rect
                } // tutup flick
            } // tutup grid-scope
        } // tutup grid-rect

        // ===== 3. Footer Status Bar =====
        // Pesan guard anti-menclok panjang (menyebut NO FAKTUR + kolom
        // + nilai lama/baru + "klik Muat Ulang") — status harus wrap ke
        // 2 baris, bukan elide satu baris (28 Nov 2026: pesan blokir
        // terpotong "..." sehingga instruksi Muat Ulang tak terbaca).
        HorizontalLayout {
            min-height: 22px;
            spacing: Design.space-sm;

            Text {
                text: root.status-text;
                font-size: Design.font-caption;
                font-weight: 600;
                color: root.has-draft ? Design.status-warning : Design.status-success;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }

            Text {
                text: root.total-rows == 0 ? "Belum ada baris" : "Menampilkan " + (root.page-start + 1) + "–" + (root.page-start + root.row-count) + " dari " + root.total-rows + " · Kolom: " + root.col-count + " (" + root.col-letters[0] + "–" + root.col-letters[root.col-count - 1] + ") · Sel Aktif: " + root.col-letters[root.active-col] + (root.row-num-base + root.active-row);
                font-size: 10px;
                font-family: "JetBrains Mono";
                color: Design.text-muted;
                vertical-alignment: center;
            }
        }
    }
}
