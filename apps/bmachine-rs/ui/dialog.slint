// Dialog Modal Fase 5:
// 1. Exit Confirmation: Sesuai MainWindow.axaml C# ("SYSTEM CONFIRMATION", "Sign Out of Session", tombol Sign Out + Cancel).
// 2. Batch Delete Confirmation: Konfirmasi hapus file permanen dari disk.
// 3. Update Dialog Window: Sesuai UpdateDialogWindow.axaml C# (lebar 380px, versi baru, tombol Perbarui Sekarang & Nanti).
// Dialog modal ditutup lewat Esc atau klik tombol terkait. Tidak ada tombol "← Kembali".

import { Design, Btn, HSeparator } from "design.slint";

export component ExitConfirmDialog inherits Rectangle {
    callback confirmed();
    callback cancelled();

    background: #B3000000; // Window dimmer C#

    TouchArea {
        width: 100%;
        height: 100%;
        // Klik di dimmer luar tidak menutup paksa dialog konfirmasi penting
    }

    Rectangle {
        x: (parent.width - 360px) / 2;
        y: (parent.height - 240px) / 2;
        width: 360px;
        height: 240px;
        background: Design.surface-elevated;
        border-color: Design.separator;
        border-width: 1px;
        border-radius: Design.radius-md;

        VerticalLayout {
            padding: 20px;
            spacing: 8px;
            alignment: center;

            Text {
                text: "SYSTEM CONFIRMATION";
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1.5px;
                color: Design.text-secondary;
                horizontal-alignment: center;
            }

            Rectangle { height: 4px; }

            Text {
                text: "Sign Out of Session";
                font-size: 18px;
                font-weight: 700;
                color: Design.text-primary;
                horizontal-alignment: center;
            }

            Text {
                text: "Are you sure you want to end your current session? Unsaved progress in active processes may be lost.";
                font-size: 12px;
                color: Design.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { height: 8px; }

            HorizontalLayout {
                spacing: 10px;
                Btn {
                    label: "Sign Out";
                    variant: "danger";
                    horizontal-stretch: 1;
                    clicked => { root.confirmed(); }
                }
                Btn {
                    label: "Cancel";
                    variant: "secondary";
                    horizontal-stretch: 1;
                    clicked => { root.cancelled(); }
                }
            }
        }
    }
}

export component UpdateDialog inherits Rectangle {
    in property <string> latest-version: "v8.4.0";
    in property <string> current-version: "v8.3.0";
    in property <string> size-text: "147 MB";
    in property <string> notes: "• Checklist Trello auto-refresh\n• Pembaruan skrip master & action";
    callback applied();
    callback dismissed();

    background: #B3000000;

    TouchArea {
        width: 100%;
        height: 100%;
    }

    Rectangle {
        x: (parent.width - 380px) / 2;
        y: (parent.height - 300px) / 2;
        width: 380px;
        height: 300px;
        background: Design.surface-elevated;
        border-color: Design.separator;
        border-width: 1px;
        border-radius: Design.radius-md;

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Text {
                    text: "PEMBARUAN TERSEDIA";
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    color: Design.accent;
                    vertical-alignment: center;
                }
                Rectangle {
                    background: Design.accent;
                    border-radius: Design.radius-sm;
                    height: 20px;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: root.latest-version;
                            font-size: 11px;
                            font-weight: 700;
                            color: #FFFFFF;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            Text {
                text: "Versi terpasang: " + root.current-version + "  •  Ukuran: " + root.size-text;
                font-size: Design.font-caption;
                color: Design.text-muted;
                horizontal-alignment: center;
            }

            HSeparator { }

            Text {
                text: "Catatan Rilis:";
                font-size: Design.font-caption;
                font-weight: 600;
                color: Design.text-primary;
            }

            Rectangle {
                background: Design.app-bg;
                border-radius: Design.radius-sm;
                border-color: Design.separator;
                border-width: 1px;
                height: 80px;
                HorizontalLayout {
                    padding: 8px;
                    Text {
                        text: root.notes;
                        font-size: 11px;
                        color: Design.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }

            HSeparator { }

            HorizontalLayout {
                spacing: 10px;
                Btn {
                    label: "Perbarui sekarang";
                    variant: "primary";
                    horizontal-stretch: 1;
                    clicked => { root.applied(); }
                }
                Btn {
                    label: "Nanti";
                    variant: "ghost";
                    horizontal-stretch: 1;
                    clicked => { root.dismissed(); }
                }
            }
        }
    }
}
