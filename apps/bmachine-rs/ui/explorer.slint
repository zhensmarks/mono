// ============================================================
// Explorer — port Rust/Slint dari OutputExplorerView + ExplorerWindow (C#).
// Referensi alur: EXPLORER_SPEC.md. Data contoh + semua urutan
// (sort/group/split) di ui/explorer-data.slint (digenerate).
//
// Aturan Slint yang dipakai di sini (lihat DESIGN_SYSTEM.md §18.5):
//  - lebar child Flickable diikat ke Rectangle pembungkus + x: 0.
//  - baris yang disembunyikan: tinggi 0 + visible: false.
//  - array hanya diganti utuh; mutasi (tambah/hapus/rename) memakai
//    pola "map per slot" + live-mode (urutan tampil = urutan array).
//  - callback ber-return-value TIDAK bisa dipanggil dari binding
//    (hanya dari event handler) — cek membership ditulis inline.
// ============================================================

import { Design, Card, HSeparator, Btn, IconBtn } from "design.slint";
import { ExplorerData } from "explorer-data.slint";

// ---------- Baris detail (layout Vertical) ----------
// 26px; 44px bila ada header grup di atasnya. Nama bisa jadi TextInput
// saat rename inline (hanya bagian nama yang di-select, ekstensi tidak).
component ExpRow inherits Rectangle {
    in property <string> name;
    in property <string> kind; // folder | link | file
    in property <string> size;
    in property <string> date;
    in property <string> loc;
    in property <bool> show-loc;
    in property <bool> selected;
    in property <bool> cut;
    in property <string> header; // "" = tanpa header grup
    in property <bool> renaming;
    in property <int> ext-len;
    in-out property <string> rename-draft;
    callback clicked();
    callback open();
    callback menu();
    callback rename-commit();
    callback rename-cancel();
    callback rename-edited(string);

    height: header == "" ? 26px : 44px;
    background: selected ? Design.accent-subtle : (row-touch.has-hover ? Design.bg-hover : transparent);
    border-radius: Design.radius-sm;
    opacity: cut ? 0.45 : 1;

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.open(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.menu();
            }
        }
    }

    VerticalLayout {
        spacing: 0;
        // Header grup (Date/Type) — bukan item, tidak bisa dipilih.
        Text {
            height: header == "" ? 0px : 18px;
            visible: header != "";
            text: header;
            font-size: 11px;
            font-weight: 800;
            color: Design.text-muted;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
        HorizontalLayout {
            height: 26px;
            spacing: Design.space-sm;
            padding-left: Design.space-sm;
            padding-right: Design.space-sm;
            // Lebar ikon TETAP 14px (sama dengan gutter header kolom)
            // supaya teks Nama baris sejajar dengan header "Nama".
            Text {
                text: kind == "folder" ? "▸" : kind == "link" ? "↪" : "▤";
                width: 14px;
                horizontal-alignment: center;
                font-size: Design.font-button;
                font-weight: 700;
                color: kind == "folder" ? Design.accent : Design.text-muted;
                vertical-alignment: center;
            }
            // Nama (atau editor rename inline di atasnya).
            Rectangle {
                horizontal-stretch: 1;
                Text {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: !root.renaming;
                    text: name;
                    font-size: 13px;
                    font-weight: kind == "folder" ? 700 : 400;
                    color: selected ? Design.accent : Design.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    x: 0; y: 2px; width: 100%; height: 22px;
                    visible: root.renaming;
                    background: Design.bg-input;
                    border-color: Design.border-focus;
                    border-width: 1px;
                    border-radius: Design.radius-sm;
                    clip: true;
                    rename-input := TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: 100%;
                        text <=> root.rename-draft;
                        font-size: 13px;
                        color: Design.text-primary;
                        selection-foreground-color: white;
                        selection-background-color: Design.accent;
                        vertical-alignment: center;
                        edited => { root.rename-edited(self.text); }
                        accepted => { root.rename-commit(); }
                    }
                }
            }
            Text {
                text: size;
                font-size: 12px;
                color: Design.text-secondary;
                vertical-alignment: center;
                width: 70px;
                horizontal-alignment: right;
            }
            Text {
                text: date;
                font-size: 12px;
                color: Design.text-secondary;
                vertical-alignment: center;
                width: 90px;
            }
            Text {
                text: show-loc ? loc : "";
                font-size: 12px;
                color: Design.text-muted;
                vertical-alignment: center;
                width: show-loc ? 140px : 0px;
                visible: show-loc;
                overflow: elide;
            }
            IconBtn {
                glyph: "⋯";
                variant: "ghost";
                scale: 1;
                size: 24px;
                clicked => { root.menu(); }
            }
        }
    }

    // Saat masuk mode rename: fokus input + select hanya bagian nama
    // (ekstensi tidak ikut) — seperti FocusAndSelectNamePart() di C#.
    changed renaming => {
        if (self.renaming) {
            rename-input.focus();
            rename-input.set-selection-offsets(0, root.name.character-count - root.ext-len);
        }
    }
}

// ---------- Kartu file (Horizontal / Thumbnail / Tiles) ----------
component ExpCard inherits Rectangle {
    in property <string> mode; // "horizontal" | "thumbnail" | "tiles"
    in property <string> name;
    in property <string> kind;
    in property <string> ext;
    in property <bool> selected;
    in property <bool> cut;
    callback clicked();
    callback open();
    callback menu();

    property <color> thumb-color: kind == "folder" ? Design.accent : ext == ".jpg" || ext == ".jpeg" || ext == ".png" ? Design.cat-points : ext == ".psd" ? Design.cat-revision : Design.text-muted;

    width: mode == "tiles" ? 240px : mode == "thumbnail" ? 140px : 150px;
    height: mode == "tiles" ? 56px : mode == "thumbnail" ? 180px : 64px;
    background: selected ? Design.accent-subtle : (card-touch.has-hover ? Design.bg-hover : transparent);
    border-color: selected ? Design.accent : Design.separator;
    border-width: 1px;
    border-radius: Design.radius-md;
    opacity: cut ? 0.45 : 1;

    card-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.open(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.menu();
            }
        }
    }

    // Thumbnail: kotak warna + nama di bawah.
    VerticalLayout {
        visible: root.mode == "thumbnail";
        padding: 8px;
        spacing: 6px;
        Rectangle {
            height: 124px;
            background: root.thumb-color;
            opacity: 0.18;
            border-color: root.thumb-color;
            border-width: 1px;
            border-radius: Design.radius-sm;
        }
        Text {
            text: name;
            font-size: 12px;
            font-weight: kind == "folder" ? 700 : 400;
            color: selected ? Design.accent : Design.text-primary;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-height: 32px;
            overflow: elide;
        }
    }
    // Glyph thumbnail — SAUDARA kotak tinted, bukan anaknya: opacity
    // 0.18 pada kotak ikut meredupkan anaknya (DESIGN_SYSTEM.md §11.1),
    // jadi glyph diletakkan di atas kotak sebagai overlay.
    Text {
        visible: root.mode == "thumbnail";
        x: 8px; y: 8px; width: parent.width - 16px; height: 124px;
        text: kind == "folder" ? "▸" : "▤";
        font-size: 32px;
        font-weight: 700;
        color: root.thumb-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // Tiles: ikon + nama berdampingan (240x56).
    HorizontalLayout {
        visible: root.mode == "tiles";
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Text {
            text: kind == "folder" ? "▸" : kind == "link" ? "↪" : "▤";
            font-size: 18px;
            font-weight: 700;
            color: kind == "folder" ? Design.accent : Design.text-muted;
            vertical-alignment: center;
        }
        Text {
            text: name;
            font-size: 13px;
            font-weight: kind == "folder" ? 700 : 400;
            color: selected ? Design.accent : Design.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Rectangle {
            width: 20px;
            height: 20px;
            card-menu-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.menu(); }
            }
            Text {
                text: "⋯";
                font-size: 12px;
                font-weight: 700;
                color: Design.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }
    // Horizontal: kartu ringkas (ikon + nama, maks 150px).
    VerticalLayout {
        visible: root.mode == "horizontal";
        padding: 8px;
        spacing: 4px;
        alignment: center;
        Text {
            text: kind == "folder" ? "▸" : kind == "link" ? "↪" : "▤";
            font-size: 18px;
            font-weight: 700;
            color: kind == "folder" ? Design.accent : Design.text-muted;
            horizontal-alignment: center;
        }
        Text {
            text: name;
            font-size: 12px;
            font-weight: kind == "folder" ? 700 : 400;
            color: selected ? Design.accent : Design.text-primary;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-height: 30px;
            overflow: elide;
        }
    }
}

// ---------- Baris menu konteks ----------
component CtxItem inherits Rectangle {
    in property <string> label;
    in property <bool> danger;
    in property <bool> bold;
    in property <bool> disabled;
    callback clicked();

    // Tinggi 0 saat disembunyikan: visible:false saja TETAP memakan
    // ruang layout (§11.1) — tanpa ini item menu yang tersembunyi
    // (mis. "Open in New Tab" untuk file) membuat isi menu meluber
    // keluar dari tinggi kartu menu yang dihitung eksplisit.
    height: root.visible ? 32px : 0px;
    background: disabled ? transparent : (ci-touch.has-hover ? Design.bg-hover : transparent);
    border-radius: Design.radius-sm;
    opacity: disabled ? 0.4 : 1;
    ci-touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: label;
        font-size: 12px;
        font-weight: bold ? 700 : 400;
        color: danger ? Design.status-danger : Design.text-primary;
        vertical-alignment: center;
        x: 10px;
        width: parent.width - 20px;
        overflow: elide;
    }
}

// ---------- Kartu tugas (Task Monitor) ----------
component TaskCard inherits Rectangle {
    in property <string> kind; // COPY | MOVE | DELETE
    in property <string> name;
    in property <int> prog; // 0..100
    in property <string> status; // run | done | failed | cancelled
    in property <string> size;
    callback cancel();
    callback retry();
    callback remove();

    property <color> badge-color: kind == "COPY" ? Design.accent : kind == "MOVE" ? Design.cat-revision : Design.status-danger;
    property <string> status-text: status == "run" ? "Berjalan" : status == "done" ? "Selesai" : status == "failed" ? "Gagal" : "Dibatalkan";
    property <int> eta-sec: status == "run" ? floor((100 - prog) * 0.12) : 0;

    // 100px = padding 12x2 + baris 20 + 8 + 36 + spacing 6x2.
    // Baris bawah 36px supaya Btn "Batalkan"/"Coba lagi" (36px)
    // muat — sebelumnya 20px sehingga tombol meluber keluar kartu.
    height: 100px;
    background: Design.bg-input;
    border-color: Design.separator;
    border-width: 1px;
    border-radius: Design.radius-md;
    VerticalLayout {
        padding: Design.space-md;
        spacing: 6px;
        HorizontalLayout {
            height: 20px;
            spacing: 8px;
            Rectangle {
                width: 52px;
                height: 20px;
                background: root.badge-color;
                border-radius: Design.radius-xs;
                Text {
                    text: kind;
                    font-size: 10px;
                    font-weight: 800;
                    letter-spacing: 1px;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
            Text {
                text: name;
                font-size: 13px;
                font-weight: 700;
                color: Design.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: root.status-text;
                font-size: 11px;
                font-weight: 700;
                color: status == "done" ? Design.status-success : status == "run" ? Design.accent : Design.status-danger;
                vertical-alignment: center;
            }
            Rectangle {
                width: 20px;
                height: 20px;
                rm-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.remove(); }
                }
                Text {
                    text: "×";
                    font-size: 14px;
                    font-weight: 700;
                    color: Design.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
        // Progress bar + %.
        HorizontalLayout {
            height: 8px;
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                background: Design.separator;
                border-radius: 4px;
                Rectangle {
                    x: 0; y: 0;
                    width: parent.width * prog / 100;
                    height: 100%;
                    background: status == "done" ? Design.status-success : root.badge-color;
                    border-radius: 4px;
                }
            }
            Text {
                text: prog + "%";
                font-size: 11px;
                font-weight: 700;
                color: Design.text-secondary;
                vertical-alignment: center;
                width: 34px;
                horizontal-alignment: right;
            }
        }
        HorizontalLayout {
            height: 36px;
            spacing: 8px;
            Text {
                text: size;
                font-size: 11px;
                color: Design.text-muted;
                vertical-alignment: center;
            }
            Text {
                text: status == "run" ? "12,4 MB/s" : "";
                font-size: 11px;
                color: Design.text-muted;
                vertical-alignment: center;
            }
            Text {
                text: status == "run" ? "ETA ~" + root.eta-sec + " dtk" : "";
                font-size: 11px;
                color: Design.text-muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Btn {
                label: "Batalkan";
                variant: "ghost";
                small: true;
                visible: status == "run";
                clicked => { root.cancel(); }
            }
            Btn {
                label: "Coba lagi";
                variant: "ghost";
                small: true;
                visible: status == "failed";
                clicked => { root.retry(); }
            }
        }
    }
}

export component ExplorerView inherits Rectangle {
    callback toast(string);
    callback close();
    callback send-to-batch(string, string, string, string, string);
    callback buat-master(string, string, string, string, string);
    callback open-settings-explorer();
    callback search-request(string, string);
    callback typeahead-request(string, string);
    callback esc-pressed();
    // Helper string (diimplementasi Rust di main.rs — Slint tidak
    // punya contains/substring; lihat DESIGN_SYSTEM.md §19).
    callback add-txt-ext(string) -> string;
    callback initials(string) -> string;
    callback split-ext(string) -> string;
    callback name-base(string) -> string;
    callback is-typeahead-char(string) -> bool;

    // ----- dari AppWindow -----
    in property <string> start-path: "";
    in-out property <[string]> sr-names: [];
    in-out property <[string]> sr-kinds: [];
    in-out property <[string]> sr-exts: [];
    in-out property <[string]> sr-bases: [];
    in-out property <[string]> sr-sizes: [];
    in-out property <[string]> sr-dates: [];
    in-out property <[string]> sr-previews: [];
    in-out property <[string]> sr-locs: [];
    in-out property <[string]> sr-paths: [];
    in-out property <int> sr-half: 0;
    in-out property <bool> sr-truncated: false;
    in-out property <int> ta-index: -1;

    data := ExplorerData { width: 0px; height: 0px; visible: false; }

    // ----- tab (maks 4; "" = slot kosong) -----
    in-out property <[string]> tabs-path: ["", "", "", ""];
    in-out property <[string]> tabs-name: ["", "", "", ""];
    in-out property <[bool]> tabs-pinned: [false, false, false, false];
    in-out property <[string]> tabs-label: ["", "", "", ""];
    in-out property <[int]> tabs-color: [0, 0, 0, 0];
    in-out property <int> tab-count: 1;
    in-out property <int> active-tab: 0;
    in-out property <int> tab-ctx: -1;
    property <[color]> pin-palette: [#F97316, #8B5CF6, #10B981, #3B82F6, #F43F5E, #FBBF24, #06B6D4, #EC4899];
    property <bool> any-pinned: root.tabs-pinned[0] || root.tabs-pinned[1] || root.tabs-pinned[2] || root.tabs-pinned[3];
    property <bool> show-tabbar: root.tab-count > 1 || root.any-pinned;

    // ----- navigasi -----
    in-out property <string> cur-key: "root";
    in-out property <string> cur-path: "";
    in-out property <string> cur-name: "";
    in-out property <string> up-key: "root";
    in-out property <string> up-path: "";
    in-out property <string> up-name: "";
    property <bool> can-up: root.cur-key != root.up-key;
    in-out property <[string]> it-names: data.root-names;
    in-out property <[string]> it-kinds: data.root-kinds;
    in-out property <[string]> it-exts: data.root-exts;
    in-out property <[string]> it-bases: data.root-bases;
    in-out property <[string]> it-sizes: data.root-sizes;
    in-out property <[string]> it-dates: data.root-dates;
    in-out property <[string]> it-previews: data.root-previews;
    in-out property <[string]> back-paths: ["", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> back-names: ["", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> back-keys: ["", "", "", "", "", "", "", "", "", ""];
    in-out property <int> back-count: 0;
    in-out property <[string]> fwd-paths: ["", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> fwd-names: ["", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> fwd-keys: ["", "", "", "", "", "", "", "", "", ""];
    in-out property <int> fwd-count: 0;
    // live-mode: true setelah mutasi lokal (tambah/hapus/rename) —
    // urutan tampil = urutan array (bukan permutasi precompute).
    in-out property <bool> live-mode: false;
    in-out property <int> live-count: 9;

    // Snapshot mutasi terakhir (satu folder) — supaya pindah folder
    // lalu kembali tidak menghilangkan item yang dibuat/dihapus.
    in-out property <string> snap-key: "";
    in-out property <[string]> snap-names: [];
    in-out property <[string]> snap-kinds: [];
    in-out property <[string]> snap-exts: [];
    in-out property <[string]> snap-bases: [];
    in-out property <[string]> snap-sizes: [];
    in-out property <[string]> snap-dates: [];
    in-out property <[string]> snap-previews: [];
    in-out property <int> snap-count: 0;
    in-out property <bool> snap-dirty: false;

    // ----- seleksi (12 slot; "" = kosong) -----
    in-out property <[string]> sel-names: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> sel-kinds: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> sel-exts: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> sel-bases: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> sel-previews: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> sel-sizes: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> sel-dates: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> cut-names: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <string> cut-folder: "";
    in-out property <[string]> cb-names: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> cb-kinds: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> cb-exts: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> cb-bases: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> cb-previews: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <int> cb-count: 0;
    in-out property <string> cb-mode: "";
    in-out property <string> cb-folder: "";
    in-out property <string> cb-source-path: "";
    // Slot sementara untuk operasi multi-array.
    in-out property <[string]> tmp-names: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <string> rename-ext: "";
    in-out property <string> rename-new: "";
    in-out property <string> dup-kind: "";
    in-out property <string> dup-ext: "";
    in-out property <string> dup-base: "";
    in-out property <string> dup-size: "";
    in-out property <string> dup-date: "";
    in-out property <string> dup-preview: "";
    in-out property <string> dup-name: "";
    in-out property <string> dup-name-base: "";
    in-out property <string> new-name: "";
    in-out property <string> new-ext: "";
    in-out property <string> new-base: "";
    in-out property <string> paste-name: "";
    in-out property <string> paste-base: "";
    in-out property <string> del-name: "";
    in-out property <int> del-count: 0;
    in-out property <int> tm-slot: -1;
    property <int> sel-count: (root.sel-names[0] != "" ? 1 : 0) + (root.sel-names[1] != "" ? 1 : 0) + (root.sel-names[2] != "" ? 1 : 0) + (root.sel-names[3] != "" ? 1 : 0) + (root.sel-names[4] != "" ? 1 : 0) + (root.sel-names[5] != "" ? 1 : 0) + (root.sel-names[6] != "" ? 1 : 0) + (root.sel-names[7] != "" ? 1 : 0) + (root.sel-names[8] != "" ? 1 : 0) + (root.sel-names[9] != "" ? 1 : 0) + (root.sel-names[10] != "" ? 1 : 0) + (root.sel-names[11] != "" ? 1 : 0);
    property <string> single-name: root.sel-names[0] != "" ? root.sel-names[0] : root.sel-names[1] != "" ? root.sel-names[1] : root.sel-names[2] != "" ? root.sel-names[2] : root.sel-names[3] != "" ? root.sel-names[3] : root.sel-names[4] != "" ? root.sel-names[4] : root.sel-names[5] != "" ? root.sel-names[5] : root.sel-names[6] != "" ? root.sel-names[6] : root.sel-names[7] != "" ? root.sel-names[7] : root.sel-names[8] != "" ? root.sel-names[8] : root.sel-names[9] != "" ? root.sel-names[9] : root.sel-names[10] != "" ? root.sel-names[10] : root.sel-names[11] != "" ? root.sel-names[11] : "";
