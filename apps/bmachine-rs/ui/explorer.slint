        root.sel-exts = [root.view-names.length > 0 ? root.view-exts[0] : "", root.view-names.length > 1 ? root.view-exts[1] : "", root.view-names.length > 2 ? root.view-exts[2] : "", root.view-names.length > 3 ? root.view-exts[3] : "", root.view-names.length > 4 ? root.view-exts[4] : "", root.view-names.length > 5 ? root.view-exts[5] : "", root.view-names.length > 6 ? root.view-exts[6] : "", root.view-names.length > 7 ? root.view-exts[7] : "", root.view-names.length > 8 ? root.view-exts[8] : "", root.view-names.length > 9 ? root.view-exts[9] : "", root.view-names.length > 10 ? root.view-exts[10] : "", root.view-names.length > 11 ? root.view-exts[11] : ""];
        root.sel-bases = [root.view-names.length > 0 ? root.view-bases[0] : "", root.view-names.length > 1 ? root.view-bases[1] : "", root.view-names.length > 2 ? root.view-bases[2] : "", root.view-names.length > 3 ? root.view-bases[3] : "", root.view-names.length > 4 ? root.view-bases[4] : "", root.view-names.length > 5 ? root.view-bases[5] : "", root.view-names.length > 6 ? root.view-bases[6] : "", root.view-names.length > 7 ? root.view-bases[7] : "", root.view-names.length > 8 ? root.view-bases[8] : "", root.view-names.length > 9 ? root.view-bases[9] : "", root.view-names.length > 10 ? root.view-bases[10] : "", root.view-names.length > 11 ? root.view-bases[11] : ""];
        root.sel-previews = [root.view-names.length > 0 ? root.view-previews[0] : "", root.view-names.length > 1 ? root.view-previews[1] : "", root.view-names.length > 2 ? root.view-previews[2] : "", root.view-names.length > 3 ? root.view-previews[3] : "", root.view-names.length > 4 ? root.view-previews[4] : "", root.view-names.length > 5 ? root.view-previews[5] : "", root.view-names.length > 6 ? root.view-previews[6] : "", root.view-names.length > 7 ? root.view-previews[7] : "", root.view-names.length > 8 ? root.view-previews[8] : "", root.view-names.length > 9 ? root.view-previews[9] : "", root.view-names.length > 10 ? root.view-previews[10] : "", root.view-names.length > 11 ? root.view-previews[11] : ""];
        root.sel-sizes = [root.view-names.length > 0 ? root.view-sizes[0] : "", root.view-names.length > 1 ? root.view-sizes[1] : "", root.view-names.length > 2 ? root.view-sizes[2] : "", root.view-names.length > 3 ? root.view-sizes[3] : "", root.view-names.length > 4 ? root.view-sizes[4] : "", root.view-names.length > 5 ? root.view-sizes[5] : "", root.view-names.length > 6 ? root.view-sizes[6] : "", root.view-names.length > 7 ? root.view-sizes[7] : "", root.view-names.length > 8 ? root.view-sizes[8] : "", root.view-names.length > 9 ? root.view-sizes[9] : "", root.view-names.length > 10 ? root.view-sizes[10] : "", root.view-names.length > 11 ? root.view-sizes[11] : ""];
        root.sel-dates = [root.view-names.length > 0 ? root.view-dates[0] : "", root.view-names.length > 1 ? root.view-dates[1] : "", root.view-names.length > 2 ? root.view-dates[2] : "", root.view-names.length > 3 ? root.view-dates[3] : "", root.view-names.length > 4 ? root.view-dates[4] : "", root.view-names.length > 5 ? root.view-dates[5] : "", root.view-names.length > 6 ? root.view-dates[6] : "", root.view-names.length > 7 ? root.view-dates[7] : "", root.view-names.length > 8 ? root.view-dates[8] : "", root.view-names.length > 9 ? root.view-dates[9] : "", root.view-names.length > 10 ? root.view-dates[10] : "", root.view-names.length > 11 ? root.view-dates[11] : ""];
        root.sel-paths = [root.view-names.length > 0 ? root.view-paths[0] : "", root.view-names.length > 1 ? root.view-paths[1] : "", root.view-names.length > 2 ? root.view-paths[2] : "", root.view-names.length > 3 ? root.view-paths[3] : "", root.view-names.length > 4 ? root.view-paths[4] : "", root.view-names.length > 5 ? root.view-paths[5] : "", root.view-names.length > 6 ? root.view-paths[6] : "", root.view-names.length > 7 ? root.view-paths[7] : "", root.view-names.length > 8 ? root.view-paths[8] : "", root.view-names.length > 9 ? root.view-paths[9] : "", root.view-names.length > 10 ? root.view-paths[10] : "", root.view-names.length > 11 ? root.view-paths[11] : ""];
        root.toast(root.sel-count + " item dipilih.");
    }

    callback select-only(string, string, string, string, string, string, string, string);
    select-only(name, kind, ext, base, size, date, preview, path) => {
        root.sel-names = [name, "", "", "", "", "", "", "", "", "", "", ""];
        root.sel-kinds = [kind, "", "", "", "", "", "", "", "", "", ""];
        root.sel-exts = [ext, "", "", "", "", "", "", "", "", "", ""];
        root.sel-bases = [base, "", "", "", "", "", "", "", "", ""];
        root.sel-sizes = [size, "", "", "", "", "", "", "", "", "", ""];
        root.sel-dates = [date, "", "", "", "", "", "", "", "", ""];
        root.sel-previews = [preview, "", "", "", "", "", "", "", "", ""];
        root.sel-paths = [path, "", "", "", "", "", "", "", "", "", ""];
    }

    // ================= CHUNK 3b: OPERASI =================

    callback name-exists(string) -> bool;
    name-exists(n) => {
        root.name-exists-req(n)
    }

    callback delete-blocked() -> string;
    delete-blocked() => {
        root.delete-blocked-req(root.sel-paths-joined, root.tabs-path-joined)
    }

    callback do-undo();
    do-undo() => {
        root.undo-req();
        // Pengaman: bila item terpilih sudah tidak ada di folder (mis.
        // Undo new/copy menghapusnya, atau select pasca-undo gagal),
        // bersihkan seleksi supaya preview tidak menampilkan nama hantu.
        if (root.single-name != "" && !root.name-exists(root.single-name)) {
            root.clear-selection();
        }
    }

    callback do-copy();
    do-copy() => {
        if (root.sel-count == 0) {
            root.toast("Pilih item dulu.");
        } else if (root.copy-req(root.sel-paths-joined, "copy")) {
            root.cut-names = ["", "", "", "", "", "", "", "", "", "", "", ""];
            root.cut-folder = "";
        }
    }
    callback do-cut();
    do-cut() => {
        if (root.sel-count == 0) {
            root.toast("Pilih item dulu.");
        } else if (root.copy-req(root.sel-paths-joined, "cut")) {
            root.cut-names = root.sel-names;
            root.cut-folder = root.cur-path;
        }
    }
    callback do-paste();
    do-paste() => {
        if (root.paste-req()) {
            root.cut-names = ["", "", "", "", "", "", "", "", "", "", "", ""];
            root.cut-folder = "";
            root.clear-selection();
        }
    }

    callback do-delete();
    do-delete() => {
        if (root.sel-count == 0) {
            root.toast("Pilih item dulu.");
        } else if (root.delete-blocked() != "") {
            root.toast("Folder sedang dibuka — tidak bisa dihapus: " + root.delete-blocked());
        } else if (root.delete-req(root.sel-paths-joined, false)) {
            root.clear-selection();
        }
    }
    callback confirm-perm-delete();
    confirm-perm-delete() => {
        root.dialog-open = false;
        if (root.sel-count == 0) {
            root.toast("Pilih item dulu.");
        } else if (root.delete-req(root.sel-paths-joined, true)) {
            root.clear-selection();
        }
    }
    callback do-duplicate();
    do-duplicate() => {
        if (root.sel-count == 0) {
            root.toast("Pilih item dulu.");
        } else if (root.sel-count > 1) {
            root.toast("Pilih satu item untuk diduplikasi.");
        } else {
            root.dup-count = 1;
            root.dialog-open = true;
            root.dialog-kind = "duplicate";
            root.dialog-target = root.single-name;
            root.ctx-open = false;
        }
    }

    callback confirm-duplicate();
    confirm-duplicate() => {
        root.dialog-open = false;
        root.duplicate-req(root.single-path, root.dup-count);
    }

    callback do-new-folder();
    do-new-folder() => {
        root.dialog-open = true;
        root.dialog-kind = "new-folder";
        root.dialog-text = "New Folder";
        root.dialog-target = "";
        root.ctx-open = false;
    }
    callback do-new-file();
    do-new-file() => {
        root.dialog-open = true;
        root.dialog-kind = "new-file";
        root.dialog-text = "New File.txt";
        root.dialog-target = "";
        root.ctx-open = false;
    }
    callback confirm-new-folder();
    confirm-new-folder() => {
        if (root.dialog-text == "") {
            root.toast("Nama tidak boleh kosong.");
        } else if (root.create-folder-req(root.cur-path, root.dialog-text)) {
            // Item baru jadi seleksi (ala C#) supaya seleksi = item yang
            // masuk mode rename; kalau tidak, rename salah sasaran.
            root.select-index(root.index-of(root.dialog-text));
            root.renaming = root.dialog-text;
            root.rename-ext = "";
            root.rename-draft = root.dialog-text;
            root.dialog-open = false;
        }
    }
    callback confirm-new-file();
    confirm-new-file() => {
        if (root.create-file-req(root.cur-path, root.add-txt-ext(root.dialog-text))) {
            root.select-index(root.index-of(root.add-txt-ext(root.dialog-text)));
            root.dialog-open = false;
        }
    }

    callback start-rename(string, string, string);
    start-rename(name, ext, base) => {
        root.renaming = name;
        root.rename-ext = ext;
        root.rename-draft = base;
        root.ctx-open = false;
    }
    callback cancel-rename();
    cancel-rename() => {
        root.renaming = "";
        root.rename-draft = "";
        // Input rename disembunyikan → fokus keyboard hilang; kembalikan
        // ke daftar supaya shortcut (Ctrl+Z, Delete, F2, ...) hidup lagi
        // (28 Nov 2026: Ctrl+Z mati setelah commit rename).
        root.focus-list();
    }
    callback commit-rename();
    commit-rename() => {
        if (root.renaming == "") {
        } else if (root.rename-draft == "") {
            root.toast("Nama tidak boleh kosong.");
        } else {
            root.rename-new = root.rename-draft + root.rename-ext;
            if (root.rename-new == root.renaming) {
                root.renaming = "";
                root.rename-draft = "";
                root.focus-list();
            // Target = item yang sedang diedit (`renaming`), BUKAN item
            // terpilih (`single-path`): setelah buat folder baru, seleksi
            // masih item lama sehingga rename salah sasaran (28 Nov 2026:
            // zeta.txt ikut ke-rename jadi FolderUji2).
            } else if (root.rename-req(root.join-path(root.cur-path, root.renaming), root.rename-new)) {
                // Seleksi mengikuti nama baru (kalau tidak, seleksi basi
                // menunjuk nama lama dan tak ada baris tersorot).
                root.select-index(root.index-of(root.rename-new));
                root.renaming = "";
                root.rename-draft = "";
                // focus-list SETELAH renaming="" — select-index memanggil
                // focus() sebelum input disembunyikan, jadi fokus hilang
                // lagi saat input rename menghilang.
                root.focus-list();
            }
        }
    }
    callback do-copy-path();
    do-copy-path() => {
        if (root.sel-count == 0) {
            root.copy-path-req(root.cur-path);
        } else {
            root.copy-path-req(root.sel-paths-joined);
        }
    }
    callback do-copy-name();
    do-copy-name() => {
        if (root.sel-count == 0) {
            root.toast("Pilih item dulu.");
        } else {
            root.copy-name-req(root.sel-names-joined);
        }
    }
    callback do-paste-path();
    do-paste-path() => { root.paste-path-req(); }
    callback do-batch-rename();
    do-batch-rename() => {
        if (root.sel-count == 0) {
            root.toast("Pilih item dulu.");
        } else {
            root.batch-rename-req(root.sel-paths-joined);
        }
    }

    callback tm-cancel(int);
    tm-cancel(i) => { root.task-cancel-req(i); }
    callback tm-pause(int);
    tm-pause(i) => { root.task-pause-req(i); }
    callback tm-resume(int);
    tm-resume(i) => { root.task-resume-req(i); }
    callback tm-retry(int);
    tm-retry(i) => { root.task-retry-req(i); }
    callback tm-remove(int);
    tm-remove(i) => { root.task-remove-req(i); }
    callback tm-clear-done();
    tm-clear-done() => { root.task-clear-done-req(); }

    callback switch-tab(int);
    switch-tab(idx) => {
        if (idx < 0 || idx >= root.tab-count || idx == root.active-tab) {
            return;
        }
        root.active-tab = idx;
        // Tab yang dipindah: folder sumber pindah tab; tab lama tetap
        // (path-nya tersimpan di tabs-path; state navigasi tunggal).
        root.load-folder(root.tabs-path[idx], root.tabs-name[idx], false);
    }
    callback next-tab();
    next-tab() => {
        if (root.tab-count > 1) {
            root.switch-tab(mod(root.active-tab + 1, root.tab-count));
        }
    }

    callback add-tab(string);
    add-tab(path) => {
        if (root.tab-count >= 4) {
            root.toast("Maksimal 4 tab.");
        } else if (root.tab-count == 0) {
            root.tabs-path = [path, "", "", ""];
            root.tabs-name = [root.base-name(path), "", "", ""];
            root.tabs-pinned = [false, false, false, false];
            root.tabs-label = ["", "", "", ""];
            root.tabs-color = [0, 0, 0, 0];
            root.tab-count = 1;
            root.active-tab = 0;
            root.load-folder(path, root.base-name(path), true);
        } else {
            root.tabs-path = [root.tabs-path[0], root.tab-count == 1 ? path : root.tabs-path[1], root.tab-count == 2 ? path : root.tabs-path[2], root.tab-count == 3 ? path : root.tabs-path[3]];
            root.tabs-name = [root.tabs-name[0], root.tab-count == 1 ? root.base-name(path) : root.tabs-name[1], root.tab-count == 2 ? root.base-name(path) : root.tabs-name[2], root.tab-count == 3 ? root.base-name(path) : root.tabs-name[3]];
            root.tab-count = root.tab-count + 1;
            root.active-tab = root.tab-count - 1;
            root.load-folder(path, root.base-name(path), true);
        }
    }

    callback close-tab(int);
    close-tab(idx) => {
        if (idx < 0 || idx >= root.tab-count) {
            return;
        }
        if (root.tab-count == 1) {
            // Tab terakhir: buka Explorer (tutup overlay), bukan
            // tab kosong — C# menutup ExplorerWindow.
            root.close();
        } else {
            root.tabs-path = idx == 0 ? [root.tabs-path[1], root.tabs-path[2], root.tabs-path[3], ""] : idx == 1 ? [root.tabs-path[0], root.tabs-path[2], root.tabs-path[3], ""] : idx == 2 ? [root.tabs-path[0], root.tabs-path[1], root.tabs-path[3], ""] : [root.tabs-path[0], root.tabs-path[1], root.tabs-path[2], ""];
            root.tabs-name = idx == 0 ? [root.tabs-name[1], root.tabs-name[2], root.tabs-name[3], ""] : idx == 1 ? [root.tabs-name[0], root.tabs-name[2], root.tabs-name[3], ""] : idx == 2 ? [root.tabs-name[0], root.tabs-name[1], root.tabs-name[3], ""] : [root.tabs-name[0], root.tabs-name[1], root.tabs-name[2], ""];
            root.tabs-pinned = idx == 0 ? [root.tabs-pinned[1], root.tabs-pinned[2], root.tabs-pinned[3], false] : idx == 1 ? [root.tabs-pinned[0], root.tabs-pinned[2], root.tabs-pinned[3], false] : idx == 2 ? [root.tabs-pinned[0], root.tabs-pinned[1], root.tabs-pinned[3], false] : [root.tabs-pinned[0], root.tabs-pinned[1], root.tabs-pinned[2], false];
            root.tabs-label = idx == 0 ? [root.tabs-label[1], root.tabs-label[2], root.tabs-label[3], ""] : idx == 1 ? [root.tabs-label[0], root.tabs-label[2], root.tabs-label[3], ""] : idx == 2 ? [root.tabs-label[0], root.tabs-label[1], root.tabs-label[3], ""] : [root.tabs-label[0], root.tabs-label[1], root.tabs-label[2], ""];
            root.tabs-color = idx == 0 ? [root.tabs-color[1], root.tabs-color[2], root.tabs-color[3], 0] : idx == 1 ? [root.tabs-color[0], root.tabs-color[2], root.tabs-color[3], 0] : idx == 2 ? [root.tabs-color[0], root.tabs-color[1], root.tabs-color[3], 0] : [root.tabs-color[0], root.tabs-color[1], root.tabs-color[2], 0];
            root.tab-count = root.tab-count - 1;
            if (root.active-tab == idx) {
                root.active-tab = idx == 0 ? 0 : idx - 1;
                root.load-folder(root.tabs-path[root.active-tab], root.tabs-name[root.active-tab], false);
            } else if (root.active-tab > idx) {
                root.active-tab = root.active-tab - 1;
            }
            if (root.any-pinned) {
                root.pins-save-req(root.tabs-path, root.tabs-name, root.tabs-pinned, root.tabs-label, root.tabs-color);
            }
        }
    }
    callback pin-tab(int);
    pin-tab(i) => {
        root.tabs-path = [root.tabs-path[i], i == 0 ? root.tabs-path[1] : root.tabs-path[0], i == 0 || i == 1 ? root.tabs-path[2] : root.tabs-path[1], i == 3 ? root.tabs-path[2] : root.tabs-path[3]];
        root.tabs-name = [root.tabs-name[i], i == 0 ? root.tabs-name[1] : root.tabs-name[0], i == 0 || i == 1 ? root.tabs-name[2] : root.tabs-name[1], i == 3 ? root.tabs-name[2] : root.tabs-name[3]];
        root.tabs-pinned = [true, i == 0 ? root.tabs-pinned[1] : root.tabs-pinned[0], i == 0 || i == 1 ? root.tabs-pinned[2] : root.tabs-pinned[1], i == 3 ? root.tabs-pinned[2] : root.tabs-pinned[3]];
        root.tabs-label = [root.initials(root.tabs-name[0]), i == 0 ? root.tabs-label[1] : root.tabs-label[0], i == 0 || i == 1 ? root.tabs-label[2] : root.tabs-label[1], i == 3 ? root.tabs-label[2] : root.tabs-label[3]];
        root.tabs-color = [0, i == 0 ? root.tabs-color[1] : root.tabs-color[0], i == 0 || i == 1 ? root.tabs-color[2] : root.tabs-color[1], i == 3 ? root.tabs-color[2] : root.tabs-color[3]];
        if (root.active-tab == i) {
            root.active-tab = 0;
        } else if (root.active-tab < i) {
            root.active-tab = root.active-tab + 1;
        }
        root.tab-ctx = -1;
        root.toast("Tab dipin: " + root.tabs-name[0]);
        if (root.any-pinned) {
            root.pins-save-req(root.tabs-path, root.tabs-name, root.tabs-pinned, root.tabs-label, root.tabs-color);
        }
    }
    callback unpin-tab(int);
    unpin-tab(i) => {
        root.tabs-pinned = [i == 0 ? false : root.tabs-pinned[0], i == 1 ? false : root.tabs-pinned[1], i == 2 ? false : root.tabs-pinned[2], i == 3 ? false : root.tabs-pinned[3]];
        root.tab-ctx = -1;
        root.toast("Pin dilepas.");
        if (root.any-pinned) {
            root.pins-save-req(root.tabs-path, root.tabs-name, root.tabs-pinned, root.tabs-label, root.tabs-color);
        }
    }
    callback cycle-tab-color();
    cycle-tab-color() => {
        if (root.tab-ctx >= 0) {
            root.tabs-color = [root.tab-ctx == 0 ? mod(root.tabs-color[0] + 1, 8) : root.tabs-color[0], root.tab-ctx == 1 ? mod(root.tabs-color[1] + 1, 8) : root.tabs-color[1], root.tab-ctx == 2 ? mod(root.tabs-color[2] + 1, 8) : root.tabs-color[2], root.tab-ctx == 3 ? mod(root.tabs-color[3] + 1, 8) : root.tabs-color[3]];
            if (root.any-pinned) {
                root.pins-save-req(root.tabs-path, root.tabs-name, root.tabs-pinned, root.tabs-label, root.tabs-color);
            }
        }
    }
    callback rename-tab-confirm();
    rename-tab-confirm() => {
        if (root.tab-ctx >= 0 && root.dialog-text != "") {
            root.tabs-label = [root.tab-ctx == 0 ? root.initials(root.dialog-text) : root.tabs-label[0], root.tab-ctx == 1 ? root.initials(root.dialog-text) : root.tabs-label[1], root.tab-ctx == 2 ? root.initials(root.dialog-text) : root.tabs-label[2], root.tab-ctx == 3 ? root.initials(root.dialog-text) : root.tabs-label[3]];
            root.dialog-open = false;
            root.tab-ctx = -1;
            if (root.any-pinned) {
                root.pins-save-req(root.tabs-path, root.tabs-name, root.tabs-pinned, root.tabs-label, root.tabs-color);
            }
        } else {
            root.toast("Label tidak boleh kosong.");
        }
    }
    callback open-tab-ctx(int);
    open-tab-ctx(i) => {
        root.tab-ctx = i;
        root.ctx-open = false;
    }

    callback cycle-sort();
    cycle-sort() => {
        root.ex-sort = root.ex-sort == "Name" ? "Date" : root.ex-sort == "Date" ? "Type" : "Name";
        root.toast("Sort: " + root.ex-sort + (root.ex-desc ? " (Menurun)" : " (Menaik)"));
        root.view-changed-req();
    }
    callback toggle-desc();
    toggle-desc() => {
        root.ex-desc = !root.ex-desc;
        root.toast("Urutan: " + (root.ex-desc ? "Menurun" : "Menaik"));
        root.view-changed-req();
    }
    callback cycle-group();
    cycle-group() => {
        root.ex-group = root.ex-group == "None" ? "Date" : root.ex-group == "Date" ? "Type" : "None";
        root.toast("Group: " + root.ex-group);
        root.view-changed-req();
    }
    callback set-layout(string);
    set-layout(mode) => {
        root.layout = mode;
        root.toast("Layout: " + mode + (mode == "Vertical" ? " (Ctrl+Shift+1)" : mode == "Horizontal" ? " (Ctrl+Shift+2)" : mode == "Thumbnail" ? " (Ctrl+Shift+3)" : mode == "Tiles" ? " (Ctrl+Shift+4)" : " (Ctrl+Shift+5)"));
        root.view-changed-req();
    }
    callback open-search();
    open-search() => { root.search-open = true; root.focus-target = "search"; }
    callback close-search();
    close-search() => { root.search-open = false; root.search-text = ""; root.searching = false; root.focus-list(); }
    callback search-edited(string);
    search-edited(text) => { root.search-text = text; root.searching = true; search-timer.restart(); }
    callback search-accepted();
    search-accepted() => { root.open-first-result(); }
    callback start-addr-edit();
    start-addr-edit() => { root.addr-editing = true; root.addr-text = root.cur-path; root.focus-target = "addr"; }
    callback commit-addr();
    commit-addr() => { root.addr-editing = false; root.nav-to-path(root.addr-text); root.focus-list(); }
    callback cancel-addr();
    cancel-addr() => { root.addr-editing = false; root.addr-text = ""; root.focus-list(); }
    callback open-ctx(string, string, string, string, string, bool);
    open-ctx(name, kind, ext, base, full-path, show-batch) => {
        root.ctx-open = true;
        root.ctx-is-bg = false;
        root.ctx-name = name;
        root.ctx-kind = kind;
        root.ctx-ext = ext;
        root.ctx-base = base;
        root.ctx-path = full-path;
        root.ctx-show-batch = show-batch;
        root.tab-ctx = -1;
    }
    callback open-bg-ctx();
    open-bg-ctx() => {
        root.ctx-open = true;
        root.ctx-is-bg = true;
        root.ctx-name = "";
        root.ctx-kind = "";
        root.ctx-show-batch = false;
        root.tab-ctx = -1;
    }
    callback close-ctx();
    close-ctx() => { root.ctx-open = false; }
    callback send-selected-to-batch();
    send-selected-to-batch() => {
        if (root.sel-count == 0) {
            root.toast("Pilih folder dulu.");
        } else if (!root.single-is-folder) {
            root.toast("Yang dipilih bukan folder.");
        } else {
            root.send-folder(root.single-path);
        }
    }
    callback send-folder(string);
    send-folder(folder) => {
        // folder = path penuh dari disk (sel-paths / ctx-path).
        root.send-to-batch(folder);
    }
    callback buat-master-ctx();
    buat-master-ctx() => {
        // Pemetaan folder contoh DIHAPUS 27 Nov 2026 (lihat send-folder).
        root.buat-master(root.ctx-path);
        root.ctx-open = false;
    }
    callback typeahead-char(string);
    typeahead-char(ch) => {
        root.ta-buffer = root.ta-buffer + ch;
        ta-timer.restart();
        root.typeahead-request(root.cur-path, root.ta-buffer);
    }
    esc-pressed() => {
        if (root.dialog-open) {
            root.dialog-open = false;
        } else if (root.tab-ctx >= 0) {
            root.tab-ctx = -1;
        } else if (root.ctx-open) {
            root.ctx-open = false;
        } else if (root.renaming != "") {
            root.cancel-rename();
        } else if (root.addr-editing) {
            root.cancel-addr();
        } else if (root.search-open) {
            root.close-search();
        } else if (root.ta-buffer != "") {
            root.ta-buffer = "";
        } else {
            root.close();
        }
    }


    // ============================================================
    // UI TREE
    // ============================================================
    // Tengah belah Split (mode search: sr-half; normal: ord-split-l.length).
    property <int> split-mid: root.searching-results ? root.sr-half : root.ord-split-l.length;
    // True saat fokus ada di editor teks (address bar / rename / search).
    property <bool> text-editing: root.addr-editing || root.renaming != "" || search-input.has-focus;

    // Klik kanan = kembali/tutup overlay (arahan abeng 26 Nov 16:58,
    // DESIGN_SYSTEM.md §10.11). TouchArea latar, anak pertama root
    // overlay, di belakang isi. Klik kanan pada item / filler file
    // area ditangkap TouchArea di atasnya (menu konteks); klik kanan
    // di area kosong lain (header, toolbar, sidebar, preview) jatuh
    // ke sini dan menutup overlay.
    explorer-back-touch := TouchArea {
        width: 100%; height: 100%;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.close();
            }
        }
    }

    list-scope := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;

        VerticalLayout {
            width: 100%; height: 100%;
            spacing: 0;

            // ---------- Tab bar ----------
            Rectangle {
                width: 100%;
                height: root.show-tabbar ? 36px : 0px;
                visible: root.show-tabbar;
                background: Design.card-bg;
                HorizontalLayout {
                    width: 100%; height: 100%;
                    spacing: 4px;
                    padding-left: 8px; padding-right: 8px;
                    for i in 8 : Rectangle {
                        width: i < root.tab-count ? (root.tabs-pinned[i] ? 30px : 150px) : 0px;
                        visible: i < root.tab-count;
                        height: 36px;
                        background: root.tabs-pinned[i] ? transparent : root.active-tab == i ? Design.accent-subtle : (tab-touch.has-hover ? Design.bg-hover : transparent);
                        border-radius: Design.radius-sm;
                        tab-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.switch-tab(i); }
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                    root.open-tab-ctx(i);
                                }
                            }
                        }
                        // Badge pin (20x20).
                        Rectangle {
                            visible: root.tabs-pinned[i];
                            width: 20px; height: 20px;
                            x: 5px; y: 8px;
                            background: root.pin-palette[root.tabs-color[i]];
                            border-radius: 5px;
                            Text {
                                text: root.tabs-label[i];
                                font-size: 11px; font-weight: 800; color: white;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                        }
                        Text {
                            visible: !root.tabs-pinned[i];
                            x: 8px; width: parent.width - 30px; height: 100%;
                            text: root.tabs-name[i];
                            font-size: 13px; font-weight: root.active-tab == i ? 700 : 400;
                            color: root.active-tab == i ? Design.accent : Design.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {
                            visible: !root.tabs-pinned[i] && root.active-tab == i;
                            x: 0; y: parent.height - 2px; width: 100%; height: 2px;
                            background: Design.accent;
                        }
                        Rectangle {
                            visible: !root.tabs-pinned[i] && (root.active-tab == i || tab-touch.has-hover);
                            x: parent.width - 24px; y: 9px; width: 18px; height: 18px;
                            Text {
                                text: "×";
                                font-size: 13px; font-weight: 700; color: Design.text-muted;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                            tab-x-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close-tab(i); }
                            }
                        }
                    }
                    IconBtn {
                        glyph: "+";
                        variant: "ghost";
                        size: 36px;
                        clicked => { root.add-tab(root.resolve-root-req()); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconBtn {
                        glyph: "×";
                        variant: "ghost";
                        size: 36px;
                        clicked => { root.close(); }
                    }
                }
                Rectangle {
                    x: 0; y: parent.height - 1px; width: 100%; height: 1px;
                    background: Design.separator;
                }
            }

            // ---------- Judul folder (bila hanya 1 tab, tidak di-pin) ----------
            Rectangle {
                width: 100%;
                height: root.show-tabbar ? 0px : 44px;
                visible: !root.show-tabbar;
                background: Design.card-bg;
                Text {
                    text: root.cur-name;
                    font-size: Design.font-h2; font-weight: 800;
                    color: Design.text-primary;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: 100%; height: 100%;
                }
                IconBtn {
                    glyph: "×";
                    variant: "ghost";
                    size: 32px;
                    x: parent.width - 40px; y: 6px;
                    clicked => { root.close(); }
                }
                Rectangle {
                    x: 0; y: parent.height - 1px; width: 100%; height: 1px;
                    background: Design.separator;
                }
            }

            // ---------- Path bar ----------
            Rectangle {
                width: 100%; height: root.ex-show-pathbar ? 40px : 0px;
                visible: root.ex-show-pathbar;
                background: Design.app-bg;
                HorizontalLayout {
                    width: 100%; height: 100%;
                    spacing: 6px;
                    padding-left: 8px; padding-right: 8px;
                    IconBtn {
                        glyph: "←";
                        variant: "ghost"; size: 36px;
                        opacity: root.back-count > 0 ? 1 : 0.35;
                        clicked => { root.go-back(); }
                    }
                    IconBtn {
                        glyph: "→";
                        variant: "ghost"; size: 36px;
                        opacity: root.fwd-count > 0 ? 1 : 0.35;
                        clicked => { root.go-forward(); }
                    }
                    IconBtn {
                        glyph: "↑";
                        variant: "ghost"; size: 36px;
                        opacity: root.can-up ? 1 : 0.35;
                        clicked => { root.go-up(); }
                    }
                    IconBtn {
                        glyph: "↻";
                        variant: "ghost"; size: 36px;
                        clicked => { root.refresh(); }
                    }
                    // Address bar dual-mode.
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: Design.bg-input;
                        border-color: root.addr-editing ? Design.border-focus : Design.separator;
                        border-width: 1px;
                        border-radius: Design.radius-sm;
                        clip: true;
                        Text {
                            visible: !root.addr-editing;
                            x: 8px; width: parent.width - 16px; height: 100%;
                            text: root.cur-path;
                            font-family: "JetBrains Mono";
                            font-size: 13px;
                            color: Design.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        addr-input := TextInput {
                            visible: root.addr-editing;
                            x: 8px; width: parent.width - 16px; height: 100%;
                            text <=> root.addr-text;
                            font-family: "JetBrains Mono";
                            font-size: 13px;
                            color: Design.text-primary;
                            selection-foreground-color: white;
                            selection-background-color: Design.accent;
                            vertical-alignment: center;
                            accepted => { root.commit-addr(); }
                        }
                        addr-touch := TouchArea {
                            visible: !root.addr-editing;
                            mouse-cursor: text;
                            clicked => { root.start-addr-edit(); }
                        }
                    }
                    Text {
                        text: root.shown-count + " items" + (root.sel-count > 0 ? ", " + root.sel-count + " selected" : "");
                        font-size: Design.font-body; font-weight: 700;
                        color: Design.text-primary;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        // Di layar sempit saat search terbuka, status
                        // disembunyikan (lebar 0) supaya field search
                        // tetap muat dan tidak terpotong di 520px.
                        width: root.search-open && root.width < 700px ? 0px : 180px;
                        visible: !(root.search-open && root.width < 700px);
                    }
                    Btn {
                        label: "Cari";
                        variant: "ghost"; small: true;
                        clicked => { root.open-search(); }
                    }
                    Rectangle {
                        width: root.search-open ? (root.width < 700px ? 140px : 220px) : 0px;
                        visible: root.search-open;
                        height: 36px;
                        background: Design.bg-input;
                        border-color: Design.border-focus;
                        border-width: 1px;
                        border-radius: Design.radius-sm;
                        clip: true;
                        search-input := TextInput {
                            x: 8px; width: parent.width - 34px; height: 100%;
                            text <=> root.search-text;
                            font-size: 13px;
                            color: Design.text-primary;
                            selection-foreground-color: white;
                            selection-background-color: Design.accent;
                            vertical-alignment: center;
                            edited => { root.search-edited(self.text); }
                            accepted => { root.search-accepted(); }
                        }
                        Rectangle {
                            x: parent.width - 26px; y: 8px; width: 20px; height: 20px;
                            Text {
                                text: "×";
                                font-size: 13px; font-weight: 700; color: Design.text-muted;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                            search-x-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close-search(); }
                            }
                        }
                    }
                }
            }

            // ---------- Toolbar ----------
            Rectangle {
                width: 100%; height: 40px;
                background: Design.app-bg;
                // Scroll horizontal di layar sempit (520px): semua
                // tombol tetap ada + label state utuh, digeser saja.
                Flickable {
                    width: 100%; height: 100%;
                    HorizontalLayout {
                        height: 100%;
                        spacing: 6px;
                        padding-left: 8px; padding-right: 8px;
                    Btn {
                        label: "Detail"; small: true;
                        variant: root.layout == "Vertical" ? "accent" : "secondary";
                        clicked => { root.set-layout("Vertical"); }
                    }
                    Btn {
                        label: "Daftar"; small: true;
                        variant: root.layout == "Horizontal" ? "accent" : "secondary";
                        clicked => { root.set-layout("Horizontal"); }
                    }
                    Btn {
                        label: "Thumb"; small: true;
                        variant: root.layout == "Thumbnail" ? "accent" : "secondary";
                        clicked => { root.set-layout("Thumbnail"); }
                    }
                    Btn {
                        label: "Tiles"; small: true;
                        variant: root.layout == "Tiles" ? "accent" : "secondary";
                        clicked => { root.set-layout("Tiles"); }
                    }
                    Btn {
                        label: "Split"; small: true;
                        variant: root.layout == "Split" ? "accent" : "secondary";
                        clicked => { root.set-layout("Split"); }
                    }
                    Rectangle { width: 1px; height: 24px; background: Design.separator; }
                    Btn {
                        label: "Sort: " + root.ex-sort; small: true;
                        clicked => { root.cycle-sort(); }
                    }
                    Btn {
                        label: root.ex-desc ? "↓ Z-A" : "↑ A-Z"; small: true;
                        clicked => { root.toggle-desc(); }
                    }
                    Btn {
                        label: "Group: " + root.ex-group; small: true;
                        clicked => { root.cycle-group(); }
                    }
                    Text {
                        text: "Mencari…";
                        font-size: 12px; color: Design.text-muted;
                        vertical-alignment: center;
                        visible: root.searching;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        label: "Kirim ke BATCH";
                        small: true; variant: "primary";
                        enabled: root.sel-count > 0;
                        clicked => { root.send-selected-to-batch(); }
                    }
                }
                }
            }

            // ---------- Body: sidebar + file area + preview ----------
            HorizontalLayout {
                width: 100%;
                vertical-stretch: 1;
                spacing: 0;

                // ----- Sidebar Quick Access (sembunyi bila < 700px) -----
                Rectangle {
                    width: root.width >= 700px ? 120px : 0px;
                    visible: root.width >= 700px;
                    background: Design.card-bg;
                    VerticalLayout {
                        width: 100%; height: 100%;
                        spacing: 0;
                        padding: 8px;
                        Text {
                            text: "QUICK ACCESS";
                            font-size: 11px; font-weight: 800; color: Design.text-muted;
                            letter-spacing: 1px;
                            height: 20px;
                        }
                        for i in 8 : Rectangle {
                            height: root.qa-paths[i] != "" ? 28px : 0px;
                            visible: root.qa-paths[i] != "";
                            background: qa-touch.has-hover ? Design.bg-hover : transparent;
                            border-radius: Design.radius-sm;
                            qa-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.nav-to-path(root.qa-paths[i]); }
                            }
                            HorizontalLayout {
                                width: 100%; height: 100%;
                                spacing: 4px;
                                padding-left: 6px; padding-right: 4px;
                                Text {
                                    text: root.qa-labels[i];
                                    font-size: 12px;
                                    color: root.cur-path == root.qa-paths[i] ? Design.accent : Design.text-primary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Rectangle {
                                    width: 16px; height: 16px;
                                    visible: qa-touch.has-hover;
                                    Text {
                                        text: "×";
                                        font-size: 12px; color: Design.text-muted;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: 100%; height: 100%;
                                    }
                                    qa-x-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.remove-qa(i); }
                                    }
                                }
                            }
                        }
                        // Catatan 28 Nov 2026: tombol "⚙ Explorer" sempat
                        // dikira hilang — ternyata selalu tampil (varian ghost:
                        // bg transparan, hanya label terlihat); yang terlihat
                        // seperti item QA "⊙ Explorer" adalah label tombol ini,
                        // karena daftar QA memang kosong di DB uji.
                        HSeparator { }
                        Btn {
                            label: "⚙ Explorer";
                            small: true; variant: "ghost";
                            clicked => { root.open-settings-explorer(); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // ----- File area -----
                file-area := Rectangle {
                    horizontal-stretch: 1;
                    background: Design.app-bg;
                    VerticalLayout {
                        width: 100%; height: 100%;
                        spacing: 0;
                        // Header kolom (hanya layout Vertical).
                        Rectangle {
                            width: 100%;
                            height: root.layout == "Vertical" ? 24px : 0px;
                            visible: root.layout == "Vertical";
                            background: Design.card-bg;
                            HorizontalLayout {
                                width: 100%; height: 100%;
                                spacing: 8px;
                                padding-left: 8px; padding-right: 8px;
                                Text {
                                    text: "";
                                    width: 14px;
                                }
                                Text {
                                    text: "Nama";
                                    font-size: 11px; font-weight: 800; color: Design.text-muted;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "Ukuran";
                                    font-size: 11px; font-weight: 800; color: Design.text-muted;
                                    vertical-alignment: center;
                                    width: 70px; horizontal-alignment: right;
                                }
                                Text {
                                    text: "Tanggal";
                                    font-size: 11px; font-weight: 800; color: Design.text-muted;
                                    vertical-alignment: center;
                                    width: 90px;
                                }
                                Text {
                                    text: "Lokasi";
                                    font-size: 11px; font-weight: 800; color: Design.text-muted;
                                    vertical-alignment: center;
                                    width: root.searching-results ? 140px : 0px;
                                    visible: root.searching-results;
                                }
                                Rectangle { width: 24px; }
                            }
                        }
                        // Area scroll (5 layout, 1 terlihat).
                        Rectangle {
                            width: 100%;
                            vertical-stretch: 1;
                            // Empty state (di belakang Flickable).
                            Text {
                                text: root.searching-results ? "Tidak ada hasil untuk '" + root.search-text + "'" : root.ex-root-error != "" ? root.ex-root-error : "Folder ini kosong";
                                font-size: 13px; color: Design.text-muted;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                                visible: root.shown-count == 0;
                            }

                            // -- Vertical (baris detail) --
                            vert-flick := Flickable {
                                visible: root.layout == "Vertical";
                                width: 100%; height: 100%;
                                VerticalLayout {
                                    width: file-area.width;
                                    x: 0;
                                    spacing: 2px;
                                    padding: 4px;
                                    for pos in 64 : ExpRow {
                                    height: pos < root.view-order.length && root.view-names[root.view-order[pos]] != "" ? (root.view-headers[pos] != "" ? 44px : 26px) : 0px;
                                    visible: pos < root.view-order.length && root.view-names[root.view-order[pos]] != "";
                                    name: root.view-names[root.view-order[pos]];
                                    kind: root.view-kinds[root.view-order[pos]];
                                    size: root.view-sizes[root.view-order[pos]];
                                    date: root.view-dates[root.view-order[pos]];
                                    loc: root.view-locs[root.view-order[pos]];
                                    show-loc: root.searching-results;
                                    selected: (root.view-names[root.view-order[pos]] == root.sel-names[0] || root.view-names[root.view-order[pos]] == root.sel-names[1] || root.view-names[root.view-order[pos]] == root.sel-names[2] || root.view-names[root.view-order[pos]] == root.sel-names[3] || root.view-names[root.view-order[pos]] == root.sel-names[4] || root.view-names[root.view-order[pos]] == root.sel-names[5] || root.view-names[root.view-order[pos]] == root.sel-names[6] || root.view-names[root.view-order[pos]] == root.sel-names[7] || root.view-names[root.view-order[pos]] == root.sel-names[8] || root.view-names[root.view-order[pos]] == root.sel-names[9] || root.view-names[root.view-order[pos]] == root.sel-names[10] || root.view-names[root.view-order[pos]] == root.sel-names[11]);
                                    cut: root.cut-folder == root.cur-key && (root.view-names[root.view-order[pos]] == root.cut-names[0] || root.view-names[root.view-order[pos]] == root.cut-names[1] || root.view-names[root.view-order[pos]] == root.cut-names[2] || root.view-names[root.view-order[pos]] == root.cut-names[3] || root.view-names[root.view-order[pos]] == root.cut-names[4] || root.view-names[root.view-order[pos]] == root.cut-names[5] || root.view-names[root.view-order[pos]] == root.cut-names[6] || root.view-names[root.view-order[pos]] == root.cut-names[7] || root.view-names[root.view-order[pos]] == root.cut-names[8] || root.view-names[root.view-order[pos]] == root.cut-names[9] || root.view-names[root.view-order[pos]] == root.cut-names[10] || root.view-names[root.view-order[pos]] == root.cut-names[11]);
                                    header: root.view-headers[pos];
                                    renaming: root.renaming != "" && root.renaming == root.view-names[root.view-order[pos]];
                                    ext-len: root.view-exts[root.view-order[pos]].character-count;
                                    rename-draft <=> root.rename-draft;
                                    modifiers(c) => { root.ctrl-held = c; }
                                    clicked => { if (root.ctrl-held) { root.select-toggle(root.view-names[root.view-order[pos]], root.view-kinds[root.view-order[pos]], root.view-exts[root.view-order[pos]], root.view-bases[root.view-order[pos]], root.view-sizes[root.view-order[pos]], root.view-dates[root.view-order[pos]], root.view-previews[root.view-order[pos]], root.searching-results ? root.sr-paths[pos] : root.join-path(root.cur-path, root.view-names[root.view-order[pos]])); } else { root.select-only(root.view-names[root.view-order[pos]], root.view-kinds[root.view-order[pos]], root.view-exts[root.view-order[pos]], root.view-bases[root.view-order[pos]], root.view-sizes[root.view-order[pos]], root.view-dates[root.view-order[pos]], root.view-previews[root.view-order[pos]], root.searching-results ? root.sr-paths[pos] : root.join-path(root.cur-path, root.view-names[root.view-order[pos]])); } }
