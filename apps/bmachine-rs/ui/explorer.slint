            root.dup-kind = root.single-kind;
            root.dup-ext = root.single-ext;
            root.dup-base = root.single-base;
            root.dup-size = root.single-size;
            root.dup-date = root.single-date;
            root.dup-preview = root.single-preview;
            root.dup-count = 1;
            root.dialog-open = true;
