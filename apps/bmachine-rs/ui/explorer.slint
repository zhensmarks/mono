    callback paste-one(int);
    paste-one(i) => {
        if (root.cb-names[i] != "") {
            if (root.first-empty < 0) {
                root.toast("Folder penuh (maks 12 item di mockup).");
            } else {
                root.paste-name = root.cb-names[i];
                root.paste-base = root.cb-bases[i];
                if (root.name-exists(root.paste-name)) {
                    root.paste-name = root.cb-bases[i] + " - Copy" + root.cb-exts[i];
                    root.paste-base = root.cb-bases[i] + " - Copy";
                    if (root.name-exists(root.paste-name)) {
                        root.paste-name = root.cb-bases[i] + " - Copy (2)" + root.cb-exts[i];
                        root.paste-base = root.cb-bases[i] + " - Copy (2)";
                    }
                }
                root.add-one(root.paste-name, root.cb-kinds[i], root.cb-exts[i], root.paste-base, root.cb-kinds[i] == "folder" ? "" : "1 KB", "26 Nov 2026", root.cb-previews[i]);
                root.push-undo(root.cb-mode == "cut" ? "move" : "copy", root.paste-name, "");
            }
        }
    }
    callback do-paste();
    do-paste() => {
        if (root.cb-count == 0) {
            root.toast("Clipboard kosong.");
        } else if (root.cb-mode == "cut" && root.cb-folder == root.cur-key) {
            root.toast("Sudah di folder ini");
        } else if (root.cb-mode == "cut" && root.paste-blocked()) {
            root.toast("Tidak bisa paste folder ke dalam folder itu sendiri.");
        } else {
            root.del-count = root.cb-count;
            root.paste-one(0);
            root.paste-one(1);
            root.paste-one(2);
            root.paste-one(3);
            root.paste-one(4);
            root.paste-one(5);
            root.paste-one(6);
            root.paste-one(7);
            root.paste-one(8);
            root.paste-one(9);
            root.paste-one(10);
            root.paste-one(11);
            if (root.cb-mode == "cut") {
                root.add-task("MOVE", root.del-count + " item", "");
                root.toast("Dipindahkan: " + root.del-count + " item.");
            } else {
                root.add-task("COPY", root.del-count + " item", "");
                root.toast("Disalin: " + root.del-count + " item.");
            }
            if (root.cb-mode == "cut") {
                root.cut-names = ["", "", "", "", "", "", "", "", "", "", "", ""];
                root.cut-folder = "";
                root.cb-names = ["", "", "", "", "", "", "", "", "", "", "", ""];
