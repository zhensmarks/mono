            root.dialog-target = root.single-name;
            root.ctx-open = false;
        }
    }

    callback confirm-duplicate();
    confirm-duplicate() => {
        root.dialog-open = false;
        if (root.dup-count >= 1) {
            root.dup-name = root.dup-base + " - Copy" + root.dup-ext;
            root.dup-name-base = root.dup-base + " - Copy";
            if (root.name-exists(root.dup-name)) {
