            root.rename-one(root.undo-names[0], root.undo-extra[0]);
            root.pop-undo();
        } else if (root.undo-kinds[0] == "new" || root.undo-kinds[0] == "copy") {
            root.toast("Undo: " + root.undo-names[0] + " dihapus.");
            root.remove-one(root.undo-names[0]);
            root.pop-undo();
        } else if (root.undo-kinds[0] == "move") {
            root.toast("Undo move: " + root.undo-names[0] + " dikembalikan ke folder asal (mockup: dihapus dari sini).");
