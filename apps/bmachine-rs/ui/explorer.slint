// ============================================================
// Explorer — port Rust/Slint dari OutputExplorerView + ExplorerWindow (C#).
// Referensi alur: EXPLORER_SPEC.md. Data + semua urutan
// (sort/group/split) dibaca dari disk oleh src/explorer.rs dan
// didorong ke sini sebagai array (bridge Rust <-> Slint di main.slint).
//
// Aturan Slint yang dipakai di sini (lihat DESIGN_SYSTEM.md §18.5):
//  - lebar child Flickable diikat ke Rectangle pembungkus + x: 0.
//  - baris yang disembunyikan: tinggi 0 + visible: false.
//  - array hanya diganti utuh (oleh Rust); seleksi memakai 12 slot.
//  - callback ber-return-value TIDAK bisa dipanggil dari binding
//    (hanya dari event handler) — cek membership ditulis inline.
// ============================================================

import { Design, Card, HSeparator, Btn, IconBtn } from "design.slint";

// ---------- Baris detail (layout Vertical) ----------
// 26px; 44px bila ada header grup di atasnya. Nama bisa jadi TextInput
// saat rename inline (hanya bagian nama yang di-select, ekstensi tidak).
component ExpRow inherits Rectangle {
    in property <string> name;
    in property <string> kind; // folder | link | file
    in property <string> size;
    in property <string> date;
    in property <string> loc;
    in property <bool> show-loc;
    in property <bool> selected;
    in property <bool> cut;
    in property <string> header; // "" = tanpa header grup
    in property <bool> renaming;
    in property <int> ext-len;
    in-out property <string> rename-draft;
    callback clicked();
    callback open();
    callback menu();
    callback back();
    callback forward();
    callback modifiers(bool);
    callback rename-commit();
    callback rename-cancel();
    callback rename-edited(string);

    height: header == "" ? 26px : 44px;
    background: selected ? Design.accent-subtle : (row-touch.has-hover ? Design.bg-hover : transparent);
    border-radius: Design.radius-sm;
    opacity: cut ? 0.45 : 1;

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.open(); }
        pointer-event(e) => {
            root.modifiers(e.modifiers.control);
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.menu();
            }
            if (e.button == PointerEventButton.back && e.kind == PointerEventKind.up) {
                root.back();
            }
            if (e.button == PointerEventButton.forward && e.kind == PointerEventKind.up) {
                root.forward();
            }
        }
    }

    VerticalLayout {
        spacing: 0;
        // Header grup (Date/Type) — bukan item, tidak bisa dipilih.
        Text {
            height: header == "" ? 0px : 18px;
            visible: header != "";
            text: header;
            font-size: 11px;
            font-weight: 800;
            color: Design.text-muted;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
        HorizontalLayout {
            height: 26px;
            spacing: Design.space-sm;
            padding-left: Design.space-sm;
            padding-right: Design.space-sm;
            // Lebar ikon TETAP 14px (sama dengan gutter header kolom)
            // supaya teks Nama baris sejajar dengan header "Nama".
            Text {
                text: kind == "folder" ? "▸" : kind == "link" ? "↪" : "▤";
                width: 14px;
                horizontal-alignment: center;
                font-size: Design.font-button;
                font-weight: 700;
                color: kind == "folder" ? Design.accent : Design.text-muted;
                vertical-alignment: center;
            }
            // Nama (atau editor rename inline di atasnya).
            Rectangle {
                horizontal-stretch: 1;
                Text {
                    x: 0; y: 0; width: 100%; height: 100%;
                    visible: !root.renaming;
                    text: name;
                    font-size: 13px;
                    font-weight: kind == "folder" ? 700 : 400;
                    color: selected ? Design.accent : Design.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    x: 0; y: 2px; width: 100%; height: 22px;
                    visible: root.renaming;
                    background: Design.bg-input;
                    border-color: Design.border-focus;
                    border-width: 1px;
                    border-radius: Design.radius-sm;
                    clip: true;
                    rename-input := TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: 100%;
                        text <=> root.rename-draft;
                        font-size: 13px;
                        color: Design.text-primary;
                        selection-foreground-color: white;
                        selection-background-color: Design.accent;
                        vertical-alignment: center;
                        edited => { root.rename-edited(self.text); }
                        accepted => { root.rename-commit(); }
                    }
                }
            }
            Text {
                text: size;
                font-size: 12px;
                color: Design.text-secondary;
                vertical-alignment: center;
                width: 70px;
                horizontal-alignment: right;
            }
            Text {
                text: date;
                font-size: 12px;
                color: Design.text-secondary;
                vertical-alignment: center;
                width: 90px;
            }
            Text {
                text: show-loc ? loc : "";
                font-size: 12px;
                color: Design.text-muted;
                vertical-alignment: center;
                width: show-loc ? 140px : 0px;
                visible: show-loc;
                overflow: elide;
            }
            IconBtn {
                glyph: "⋯";
                variant: "ghost";
                scale: 1;
                size: 24px;
                clicked => { root.menu(); }
            }
        }
    }

    // Saat masuk mode rename: fokus input + select hanya bagian nama
    // (ekstensi tidak ikut) — seperti FocusAndSelectNamePart() di C#.
    // focus() langsung di sini sering gagal (input baru muncul masih
    // tersembunyi); timer 50ms memasangnya setelah satu tick.
    property <bool> rename-focus-pending: false;
    rename-focus-timer := Timer {
        interval: 50ms;
        running: root.rename-focus-pending;
        triggered => {
            root.rename-focus-pending = false;
            rename-input.focus();
            rename-input.set-selection-offsets(0, root.name.character-count - root.ext-len);
        }
    }
    changed renaming => {
        if (self.renaming) {
            rename-input.focus();
            rename-input.set-selection-offsets(0, root.name.character-count - root.ext-len);
            root.rename-focus-pending = true;
        }
    }
}

// ---------- Kartu file (Horizontal / Thumbnail / Tiles) ----------
component ExpCard inherits Rectangle {
    in property <string> mode; // "horizontal" | "thumbnail" | "tiles"
    in property <string> name;
    in property <string> kind;
    in property <string> ext;
    in property <bool> selected;
    in property <bool> cut;
    callback clicked();
    callback open();
    callback menu();
    callback back();
    callback forward();
    callback modifiers(bool);

    property <color> thumb-color: kind == "folder" ? Design.accent : ext == ".jpg" || ext == ".jpeg" || ext == ".png" ? Design.cat-points : ext == ".psd" ? Design.cat-revision : Design.text-muted;

    width: mode == "tiles" ? 240px : mode == "thumbnail" ? 140px : 150px;
    height: mode == "tiles" ? 56px : mode == "thumbnail" ? 180px : 64px;
    background: selected ? Design.accent-subtle : (card-touch.has-hover ? Design.bg-hover : transparent);
    border-color: selected ? Design.accent : Design.separator;
    border-width: 1px;
    border-radius: Design.radius-md;
    opacity: cut ? 0.45 : 1;

    card-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.open(); }
        pointer-event(e) => {
            root.modifiers(e.modifiers.control);
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.menu();
            }
            if (e.button == PointerEventButton.back && e.kind == PointerEventKind.up) {
                root.back();
            }
            if (e.button == PointerEventButton.forward && e.kind == PointerEventKind.up) {
                root.forward();
            }
        }
    }

    // Thumbnail: kotak warna + nama di bawah.
    VerticalLayout {
        visible: root.mode == "thumbnail";
        padding: 8px;
        spacing: 6px;
        Rectangle {
            height: 124px;
            background: root.thumb-color;
            opacity: 0.18;
            border-color: root.thumb-color;
            border-width: 1px;
            border-radius: Design.radius-sm;
        }
        Text {
            text: name;
            font-size: 12px;
            font-weight: kind == "folder" ? 700 : 400;
            color: selected ? Design.accent : Design.text-primary;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-height: 32px;
            overflow: elide;
        }
    }
    // Glyph thumbnail — SAUDARA kotak tinted, bukan anaknya: opacity
    // 0.18 pada kotak ikut meredupkan anaknya (DESIGN_SYSTEM.md §11.1),
    // jadi glyph diletakkan di atas kotak sebagai overlay.
    Text {
        visible: root.mode == "thumbnail";
        x: 8px; y: 8px; width: parent.width - 16px; height: 124px;
        text: kind == "folder" ? "▸" : "▤";
        font-size: 32px;
        font-weight: 700;
        color: root.thumb-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // Tiles: ikon + nama berdampingan (240x56).
    HorizontalLayout {
        visible: root.mode == "tiles";
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Text {
            text: kind == "folder" ? "▸" : kind == "link" ? "↪" : "▤";
            font-size: 18px;
            font-weight: 700;
            color: kind == "folder" ? Design.accent : Design.text-muted;
            vertical-alignment: center;
        }
        Text {
            text: name;
            font-size: 13px;
            font-weight: kind == "folder" ? 700 : 400;
            color: selected ? Design.accent : Design.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Rectangle {
            width: 20px;
            height: 20px;
            card-menu-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.menu(); }
            }
            Text {
                text: "⋯";
                font-size: 12px;
                font-weight: 700;
                color: Design.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }
    // Horizontal: kartu ringkas (ikon + nama, maks 150px).
    VerticalLayout {
        visible: root.mode == "horizontal";
        padding: 8px;
        spacing: 4px;
        alignment: center;
        Text {
            text: kind == "folder" ? "▸" : kind == "link" ? "↪" : "▤";
            font-size: 18px;
            font-weight: 700;
            color: kind == "folder" ? Design.accent : Design.text-muted;
            horizontal-alignment: center;
        }
        Text {
            text: name;
            font-size: 12px;
            font-weight: kind == "folder" ? 700 : 400;
            color: selected ? Design.accent : Design.text-primary;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-height: 30px;
            overflow: elide;
        }
    }
}

// ---------- Baris menu konteks ----------
component CtxItem inherits Rectangle {
    in property <string> label;
    in property <bool> danger;
    in property <bool> bold;
    in property <bool> disabled;
    callback clicked();

    // Tinggi 0 saat disembunyikan: visible:false saja TETAP memakan
    // ruang layout (§11.1) — tanpa ini item menu yang tersembunyi
    // (mis. "Open in New Tab" untuk file) membuat isi menu meluber
    // keluar dari tinggi kartu menu yang dihitung eksplisit.
    height: root.visible ? 32px : 0px;
    background: disabled ? transparent : (ci-touch.has-hover ? Design.bg-hover : transparent);
    border-radius: Design.radius-sm;
    opacity: disabled ? 0.4 : 1;
    ci-touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: label;
        font-size: 12px;
        font-weight: bold ? 700 : 400;
        color: danger ? Design.status-danger : Design.text-primary;
        vertical-alignment: center;
        x: 10px;
        width: parent.width - 20px;
        overflow: elide;
    }
}

// ---------- Kartu tugas (Task Monitor) ----------
component TaskCard inherits Rectangle {
    in property <string> kind; // COPY | MOVE | DELETE
    in property <string> name;
    in property <int> prog; // 0..100
    in property <string> status; // run | merging | cancelling | paused | done | failed | cancelled
    in property <string> size; // "12,4 MB / 180 MB" (Rust, nyata)
    in property <string> speed; // "48,2 MB/s" / "Menghitung…" / "Dijeda" (Rust, nyata)
    in property <string> eta; // "hh:mm:ss" / "Menghitung…" / "--:--:--" (Rust, nyata)
    in property <string> route; // "dari … → ke …" (Rust, nyata)
    in property <string> error; // pesan error merah bila gagal (Rust)
    callback cancel();
    callback pause();
    callback resume();
    callback retry();
    callback remove();

    property <color> badge-color: kind == "COPY" ? Design.accent : kind == "MOVE" ? Design.cat-revision : Design.status-danger;
    property <string> status-text: status == "run" ? "Berjalan" : status == "merging" ? "Menggabungkan…" : status == "cancelling" ? "Membatalkan…" : status == "paused" ? "Dijeda" : status == "done" ? "Selesai" : status == "failed" ? "Gagal" : "Dibatalkan";
    property <color> pill-fg: status == "done" ? Design.status-success : status == "failed" ? Design.status-danger : status == "paused" ? Design.status-warning : status == "cancelled" ? Design.text-muted : Design.accent;
    property <bool> is-running: status == "run" || status == "merging" || status == "cancelling" || status == "paused";

    // 140px = padding 12x2 + baris 20 + 6 + route 16 + 6 + progress 8
    // + 6 + baris info 16 + 6 + baris tombol 36. Dua baris bawah
    // (info penuh + tombol) supaya "Batalkan" tidak meluber (28 Nov,
    // tm-03) DAN kecepatan/ETA tetap terbaca (teks gabungan satu baris
    // meng-elide ETA-nya).
    height: 140px;
    background: Design.bg-input;
    border-color: Design.separator;
    border-width: 1px;
    border-radius: Design.radius-md;
    VerticalLayout {
        padding: Design.space-md;
        spacing: 6px;
        HorizontalLayout {
            height: 20px;
            spacing: 8px;
            Rectangle {
                width: 52px;
                height: 20px;
                background: root.badge-color;
                border-radius: Design.radius-xs;
                Text {
                    text: kind;
                    font-size: 10px;
                    font-weight: 800;
                    letter-spacing: 1px;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
            Text {
                text: name;
                font-size: 13px;
                font-weight: 700;
                color: Design.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            // Pill status (C#): tinted bg + teks berwarna, bukan teks polos.
            Rectangle {
                height: 20px;
                width: pill-text.width + 16px;
                background: root.pill-fg.with-alpha(0.15);
                border-radius: 999px;
                pill-text := Text {
                    text: root.status-text;
                    font-size: 11px;
                    font-weight: 700;
                    color: root.pill-fg;
                    x: 8px;
                    height: 100%;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                width: 20px;
                height: 20px;
                // C#: "Hapus dari daftar" hanya saat TIDAK berjalan.
                visible: !root.is-running;
                rm-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.remove(); }
                }
                Text {
                    text: "×";
                    font-size: 14px;
                    font-weight: 700;
                    color: Design.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
        // Baris "dari … → ke …" (C#); bila gagal, pesan error merah.
        Text {
            height: 16px;
            text: status == "failed" && error != "" ? error : route;
            font-size: 11px;
            color: status == "failed" && error != "" ? Design.status-danger : Design.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
        // Progress bar + %.
        HorizontalLayout {
            height: 8px;
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                background: Design.separator;
                border-radius: 4px;
                Rectangle {
                    x: 0; y: 0;
                    width: parent.width * prog / 100;
                    height: 100%;
                    background: status == "done" ? Design.status-success : root.badge-color;
                    border-radius: 4px;
                }
            }
            Text {
                text: prog + "%";
                font-size: 11px;
                font-weight: 700;
                color: Design.text-secondary;
                vertical-alignment: center;
                width: 34px;
                horizontal-alignment: right;
            }
        }
        // Baris info: ukuran · kecepatan · ETA (lebar penuh, elide).
        Text {
            height: 16px;
            text: root.is-running ? size + " · " + speed + " · ETA " + eta : size;
            font-size: 11px;
            color: Design.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
        // Baris tombol: rata kanan (alignment end — Rectangle stretch
        // tidak mendorong tombol ke kanan di Slint 1.19, ditemukan
        // 28 Nov 2026: tombol duduk di x~960/1130, bukan di tepi).
        HorizontalLayout {
            height: 36px;
            spacing: 8px;
            alignment: end;
            Btn {
                label: "Jeda";
                variant: "ghost";
                small: true;
                visible: status == "run" || status == "merging";
                clicked => { root.pause(); }
            }
            Btn {
                label: "Lanjutkan";
                variant: "ghost";
                small: true;
                visible: status == "paused";
                clicked => { root.resume(); }
            }
            Btn {
                label: "Batalkan";
                variant: "ghost";
                small: true;
                visible: status == "run" || status == "merging" || status == "paused";
                clicked => { root.cancel(); }
            }
            Btn {
                label: "Coba lagi";
                variant: "ghost";
                small: true;
                visible: status == "failed";
                clicked => { root.retry(); }
            }
        }
    }
}

export component ExplorerView inherits Rectangle {
    // Font Explorer (C# Configs.Explorer.FontFamily) tersimpan di DB
    // lewat ex-font, tapi BELUM diterapkan ke baris: Slint 1.19 tidak
    // mengizinkan font-family di Rectangle (tidak diwariskan lewat
    // container) — butuh font-family per-Text, masih terbuka.
    callback toast(string);
    callback close();
    callback send-to-batch(string);
    callback buat-master(string);
    callback open-settings-explorer();
    callback search-request(string, string);
    callback typeahead-request(string, string);
    callback esc-pressed();
    // Operasi filesystem nyata — diimplementasi Rust di main.rs
    // (src/explorer.rs); dipetakan ke root.ex-* di main.slint.
    // Konvensi: bool = true bila berhasil (toast sudah diset Rust).
    callback load-folder-req(string) -> bool;
    callback parent-path(string) -> string;
    callback join-path(string, string) -> string;
    callback base-name(string) -> string;
    callback is-dir(string) -> bool;
    callback is-file(string) -> bool;
    callback index-of(string) -> int;
    callback name-exists-req(string) -> bool;
    callback preview-req(string);
    callback create-folder-req(string, string) -> bool;
    callback create-file-req(string, string) -> bool;
    callback rename-req(string, string) -> bool;
    callback delete-req(string, bool) -> bool;
    callback duplicate-req(string, int) -> bool;
    callback copy-req(string, string) -> bool;
    callback paste-req() -> bool;
    callback undo-req() -> bool;
    callback open-file-req(string, string) -> bool;
    callback copy-path-req(string) -> bool;
    callback copy-name-req(string) -> bool;
    callback paste-path-req();
    callback batch-rename-req(string) -> bool;
    callback delete-blocked-req(string, string) -> string;
    callback task-poll-req();
    callback task-cancel-req(int);
    callback task-pause-req(int);
    callback task-resume-req(int);
    callback task-retry-req(int);
    callback task-remove-req(int);
    callback task-clear-done-req();
    callback qa-add-req(string) -> bool;
    callback qa-remove-req(int) -> bool;
    callback pins-save-req([string], [string], [bool], [string], [int]);
    callback view-changed-req();
    callback resolve-root-req() -> string;
    // Helper string (diimplementasi Rust di main.rs — Slint tidak
    // punya contains/substring; lihat DESIGN_SYSTEM.md §19).
    callback add-txt-ext(string) -> string;
    callback initials(string) -> string;
    callback split-ext(string) -> string;
    callback name-base(string) -> string;
    callback is-typeahead-char(string) -> bool;

    // ----- dari AppWindow -----
    in property <string> start-path: "";
    in-out property <[string]> sr-names: [];
    in-out property <[string]> sr-kinds: [];
    in-out property <[string]> sr-exts: [];
    in-out property <[string]> sr-bases: [];
    in-out property <[string]> sr-sizes: [];
    in-out property <[string]> sr-dates: [];
    in-out property <[string]> sr-previews: [];
    in-out property <[string]> sr-locs: [];
    in-out property <[string]> sr-paths: [];
    in-out property <int> sr-half: 0;
    in-out property <bool> sr-truncated: false;
    in-out property <int> ta-index: -1;

    // ----- tab (maks 4; "" = slot kosong) -----
    in-out property <[string]> tabs-path: ["", "", "", ""];
    in-out property <[string]> tabs-name: ["", "", "", ""];
    in-out property <[bool]> tabs-pinned: [false, false, false, false];
    in-out property <[string]> tabs-label: ["", "", "", ""];
    in-out property <[int]> tabs-color: [0, 0, 0, 0];
    in-out property <int> tab-count: 1;
    in-out property <int> active-tab: 0;
    in-out property <int> tab-ctx: -1;
    property <[color]> pin-palette: [#F97316, #8B5CF6, #10B981, #3B82F6, #F43F5E, #FBBF24, #06B6D4, #EC4899];
    property <bool> any-pinned: root.tabs-pinned[0] || root.tabs-pinned[1] || root.tabs-pinned[2] || root.tabs-pinned[3];
    property <bool> show-tabbar: root.tab-count > 1 || root.any-pinned;

    // ----- navigasi -----
    // cur-key = alias cur-path (dulu kunci folder contoh "root"/"a"/...;
    // kini path penuh — dipakai can-up + cut-folder + tab).
    in-out property <string> cur-key: "";
    in-out property <string> cur-path: "";
    in-out property <string> cur-name: "";
    // Path hasil resolve Rust (ex-cur-path di main.slint): dipakai
    // load-folder saat arg path "" — Rust resolve "" ke root, tapi
    // Slint sebelumnya memakai arg mentah "" sehingga cur-path jadi ""
    // (address bar kosong, join-path jadi relatif, "Folder tidak
    // ditemukan: <nama>"). Ditemukan 28 Nov 2026 saat tes XButton1/2.
    in property <string> resolved-path: "";
    // can-up + root didorong Rust (ex-can-up / ex-root-* di main.slint).
    in-out property <bool> ex-can-up: false;
    in-out property <string> ex-root-path: "";
    in-out property <string> ex-root-error: "";
    // Path bar tampil/sembunyi (C# Configs.Explorer.ShowPathBar).
    in-out property <bool> ex-show-pathbar: true;
    // Font Explorer (C# Configs.Explorer.FontFamily).
    in-out property <string> ex-font: "Inter";
    property <bool> can-up: root.ex-can-up;
    // Isi folder saat ini — didorong Rust (ex-it-*) setiap load.
    in-out property <[string]> it-names: [];
    in-out property <[string]> it-kinds: [];
    in-out property <[string]> it-exts: [];
    in-out property <[string]> it-bases: [];
    in-out property <[string]> it-sizes: [];
    in-out property <[string]> it-dates: [];
    in-out property <[string]> it-previews: [];
    in-out property <[string]> it-paths: [];
    in-out property <[bool]> it-isdir: [];
    in-out property <[string]> back-paths: ["", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> back-names: ["", "", "", "", "", "", "", "", "", ""];
    in-out property <int> back-count: 0;
    in-out property <[string]> fwd-paths: ["", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> fwd-names: ["", "", "", "", "", "", "", "", "", ""];
    in-out property <int> fwd-count: 0;

    // ----- seleksi (12 slot; "" = kosong) -----
    in-out property <[string]> sel-names: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> sel-kinds: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> sel-exts: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> sel-bases: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> sel-previews: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> sel-sizes: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> sel-dates: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> sel-paths: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> cut-names: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <string> cut-folder: "";
    // Jumlah item di clipboard Rust (didorong ex-cb-count) — dipakai
    // enable/disable menu Paste. Data clipboard hidup di Rust.
    in-out property <int> cb-count: 0;
    in-out property <string> rename-ext: "";
    in-out property <string> rename-new: "";
    property <int> sel-count: (root.sel-names[0] != "" ? 1 : 0) + (root.sel-names[1] != "" ? 1 : 0) + (root.sel-names[2] != "" ? 1 : 0) + (root.sel-names[3] != "" ? 1 : 0) + (root.sel-names[4] != "" ? 1 : 0) + (root.sel-names[5] != "" ? 1 : 0) + (root.sel-names[6] != "" ? 1 : 0) + (root.sel-names[7] != "" ? 1 : 0) + (root.sel-names[8] != "" ? 1 : 0) + (root.sel-names[9] != "" ? 1 : 0) + (root.sel-names[10] != "" ? 1 : 0) + (root.sel-names[11] != "" ? 1 : 0);
