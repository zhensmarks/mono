    in-out property <string> dialog-kind: "";
    in-out property <string> dialog-text: "";
    in-out property <string> dialog-target: "";
    in-out property <int> dup-count: 1;
    in-out property <bool> ctx-open: false;
    in-out property <string> ctx-name: "";
    in-out property <string> ctx-kind: "";
    in-out property <bool> ctx-is-bg: false;
    in-out property <bool> ctx-show-batch: false;
    in-out property <string> ctx-ext: "";
    in-out property <string> ctx-base: "";
    in-out property <string> ctx-path: "";
    in-out property <string> ta-buffer: "";

    // ----- Quick Access (kosong — user tambah folder sendiri) -----
    in-out property <[string]> qa-paths: [];
    in-out property <[string]> qa-labels: [];

    // ----- undo (maks 10 entri di mockup; C#: 50) -----
    in-out property <[string]> undo-kinds: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> undo-names: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <[string]> undo-extra: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""];
    in-out property <int> undo-count: 0;

    // ----- Task Monitor (maks 3 tugas tampil) -----
    in-out property <bool> tm-visible: false;
    in-out property <[string]> tm-kind: ["", "", ""];
    in-out property <[string]> tm-name: ["", "", ""];
    in-out property <[int]> tm-prog: [0, 0, 0];
    in-out property <[string]> tm-status: ["", "", ""];
    in-out property <[string]> tm-size: ["", "", ""];

    // ----- urutan tampil (permutasi precompute per folder) -----
    // Perantara per varian sort/group — dipilih dulu per folder,
    // baru dipilih per sort/group (supaya ekspresi tidak raksasa).
    property <[int]> ord-name-asc: root.cur-key == "root" ? data.root-sort-name-asc : root.cur-key == "a" ? data.a-sort-name-asc : root.cur-key == "b" ? data.b-sort-name-asc : root.cur-key == "pf" ? data.pf-sort-name-asc : root.cur-key == "pfb" ? data.pfb-sort-name-asc : root.cur-key == "gen" ? data.gen-sort-name-asc : data.master-sort-name-asc;
    property <[int]> ord-name-desc: root.cur-key == "root" ? data.root-sort-name-desc : root.cur-key == "a" ? data.a-sort-name-desc : root.cur-key == "b" ? data.b-sort-name-desc : root.cur-key == "pf" ? data.pf-sort-name-desc : root.cur-key == "pfb" ? data.pfb-sort-name-desc : root.cur-key == "gen" ? data.gen-sort-name-desc : data.master-sort-name-desc;
    property <[int]> ord-date-asc: root.cur-key == "root" ? data.root-sort-date-asc : root.cur-key == "a" ? data.a-sort-date-asc : root.cur-key == "b" ? data.b-sort-date-asc : root.cur-key == "pf" ? data.pf-sort-date-asc : root.cur-key == "pfb" ? data.pfb-sort-date-asc : root.cur-key == "gen" ? data.gen-sort-date-asc : data.master-sort-date-asc;
    property <[int]> ord-date-desc: root.cur-key == "root" ? data.root-sort-date-desc : root.cur-key == "a" ? data.a-sort-date-desc : root.cur-key == "b" ? data.b-sort-date-desc : root.cur-key == "pf" ? data.pf-sort-date-desc : root.cur-key == "pfb" ? data.pfb-sort-date-desc : root.cur-key == "gen" ? data.gen-sort-date-desc : data.master-sort-date-desc;
    property <[int]> ord-type-asc: root.cur-key == "root" ? data.root-sort-type-asc : root.cur-key == "a" ? data.a-sort-type-asc : root.cur-key == "b" ? data.b-sort-type-asc : root.cur-key == "pf" ? data.pf-sort-type-asc : root.cur-key == "pfb" ? data.pfb-sort-type-asc : root.cur-key == "gen" ? data.gen-sort-type-asc : data.master-sort-type-asc;
