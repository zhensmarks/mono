            root.back-count = min(root.back-count + 1, 10);
            root.load-folder(root.fwd-paths[0], root.fwd-names[0], false);
            root.fwd-paths = [root.fwd-paths[1], root.fwd-paths[2], root.fwd-paths[3], root.fwd-paths[4], root.fwd-paths[5], root.fwd-paths[6], root.fwd-paths[7], root.fwd-paths[8], root.fwd-paths[9], ""];
            root.fwd-names = [root.fwd-names[1], root.fwd-names[2], root.fwd-names[3], root.fwd-names[4], root.fwd-names[5], root.fwd-names[6], root.fwd-names[7], root.fwd-names[8], root.fwd-names[9], ""];
            root.fwd-count = root.fwd-count - 1;
        }
    }

    callback go-up();
    go-up() => {
        if (!root.can-up) {
            root.toast("Sudah di folder root.");
        } else {
            root.load-folder(root.parent-path(root.cur-path), root.base-name(root.parent-path(root.cur-path)), true);
        }
    }

    callback refresh();
    refresh() => {
        root.load-folder(root.cur-path, root.cur-name, false);
        root.toast("Memuat ulang folder…");
    }

    // ============================================================
    // METODE — buka item
    // ============================================================
    callback open-item(string, string, string, string);
    open-item(name, kind, ext, full-path) => {
        if (kind == "folder" || (kind == "link" && root.is-dir(full-path))) {
            root.nav-to-path(full-path);
        } else {
            // File (termasuk shortcut-ke-file): buka via Rust
            // (default app; .psd/.tif/.webp = Photoshop smart-open di Windows).
            root.open-file-req(full-path, ext);
        }
    }

    callback open-first-result();
    open-first-result() => {
        if (root.sr-names.length > 0) {
            root.open-item(root.sr-names[0], root.sr-kinds[0], root.sr-exts[0], root.sr-paths[0]);
