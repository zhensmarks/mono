        root.sel-names = [root.view-names.length > 0 ? root.view-names[0] : "", root.view-names.length > 1 ? root.view-names[1] : "", root.view-names.length > 2 ? root.view-names[2] : "", root.view-names.length > 3 ? root.view-names[3] : "", root.view-names.length > 4 ? root.view-names[4] : "", root.view-names.length > 5 ? root.view-names[5] : "", root.view-names.length > 6 ? root.view-names[6] : "", root.view-names.length > 7 ? root.view-names[7] : "", root.view-names.length > 8 ? root.view-names[8] : "", root.view-names.length > 9 ? root.view-names[9] : "", root.view-names.length > 10 ? root.view-names[10] : "", root.view-names.length > 11 ? root.view-names[11] : ""];
