            root.fwd-count = min(root.fwd-count + 1, 10);
            root.load-folder(root.back-paths[0], root.back-names[0], false);
            root.back-paths = [root.back-paths[1], root.back-paths[2], root.back-paths[3], root.back-paths[4], root.back-paths[5], root.back-paths[6], root.back-paths[7], root.back-paths[8], root.back-paths[9], ""];
            root.back-names = [root.back-names[1], root.back-names[2], root.back-names[3], root.back-names[4], root.back-names[5], root.back-names[6], root.back-names[7], root.back-names[8], root.back-names[9], ""];
            root.back-count = root.back-count - 1;
        }
    }

    callback go-forward();
    go-forward() => {
        if (root.fwd-count == 0 || root.fwd-paths[0] == "") {
            root.toast("Tidak ada halaman berikutnya.");
        } else {
            root.back-paths = [root.cur-path, root.back-paths[0], root.back-paths[1], root.back-paths[2], root.back-paths[3], root.back-paths[4], root.back-paths[5], root.back-paths[6], root.back-paths[7], root.back-paths[8]];
