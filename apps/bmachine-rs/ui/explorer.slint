                                            loc: "";
                                            show-loc: false;
                                            selected: (root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[0] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[1] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[2] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[3] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[4] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[5] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[6] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[7] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[8] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[9] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[10] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[11]);
                                            cut: root.cut-folder == root.cur-key && (root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.cut-names[0] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.cut-names[1] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.cut-names[2] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.cut-names[3] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.cut-names[4] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.cut-names[5] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.cut-names[6] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.cut-names[7] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.cut-names[8] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.cut-names[9] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.cut-names[10] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.cut-names[11]);
                                            header: "";
                                            renaming: root.renaming != "" && root.renaming == root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]];
                                            ext-len: root.view-exts[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]].character-count;
                                            rename-draft <=> root.rename-draft;
                                            clicked => { root.select-toggle(root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-kinds[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-exts[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-bases[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-sizes[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-dates[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-previews[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]]); }
                                            open => { root.open-item(root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-kinds[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-exts[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.searching-results ? root.sr-paths[pos + root.split-mid] : root.cur-path + "\\" + root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]]); }
                                            menu => {
                                            if (!(root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[0] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[1] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[2] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[3] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[4] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[5] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[6] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[7] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[8] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[9] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[10] || root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]] == root.sel-names[11])) {
                                            root.select-only(root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-kinds[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-exts[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-bases[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-sizes[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-dates[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-previews[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]]);
                                            }
                                            root.open-ctx(root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-kinds[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-exts[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.view-bases[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], root.searching-results ? root.sr-paths[pos + root.split-mid] : root.cur-path + "\\" + root.view-names[root.searching-results || root.live-mode ? pos + root.split-mid : root.ord-split-r[pos]], true);
                                            }
                                            rename-commit => { root.commit-rename(); }
                                            rename-cancel => { root.cancel-rename(); }
                                            rename-edited(text) => { root.rename-draft = text; }
                                            }
                                        }
                                    }
                                    Rectangle {
                                    height: 300px;
                                    bg-touch-s := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.clear-selection(); }
                                    pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                    root.open-bg-ctx();
                                    }
                                    }
                                    }
                                    }
                                }
                            }

                        }
                    }
                }

                // ----- Preview (kanan, 280px; hanya 1 file) -----
                Rectangle {
                    width: root.width >= 900px && root.previewable ? 280px : 0px;
                    visible: root.width >= 900px && root.previewable;
                    background: Design.card-bg;
                    VerticalLayout {
                        width: 100%; height: 100%;
                        spacing: 8px;
                        padding: 12px;
                        HorizontalLayout {
                            height: 24px;
                            Text {
                                text: "PREVIEW";
                                font-size: 11px; font-weight: 800; color: Design.text-muted;
                                letter-spacing: 1px;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            IconBtn {
                                glyph: "×";
                                variant: "ghost"; size: 24px;
                                clicked => { root.clear-selection(); }
                            }
                        }
                        Text {
                            text: root.single-name;
                            font-size: 13px; font-weight: 700; color: Design.text-primary;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.single-size + "  •  " + root.single-date;
                            font-size: 11px; color: Design.text-muted;
                        }
                        HSeparator { }
                        Text {
                            text: root.preview-text;
                            font-size: 13px; color: Design.text-primary;
                            wrap: word-wrap;
                            vertical-alignment: top;
                            vertical-stretch: 1;
                        }
                    }
                }
            }
        }

        // ---------- Keyboard ----------
        // Guard: sebagian besar shortcut dimatikan saat mengetik
        // (address bar / rename / search). Esc, Ctrl+F, Alt+D
        // tetap aktif — itu justru jalan keluar dari mode edit.
        KeyBinding {
            keys: @keys(Escape);
            activated => { root.esc-pressed(); }
        }
        KeyBinding {
            keys: @keys(Control + F);
            activated => { root.open-search(); }
        }
        KeyBinding {
            keys: @keys(Alt + D);
            activated => { root.start-addr-edit(); }
        }
        KeyBinding {
            keys: @keys(F2);
            enabled: !root.text-editing;
            activated => {
                if (root.sel-count == 1) {
                    root.start-rename(root.single-name, root.single-ext, root.single-base);
                }
            }
        }
        KeyBinding {
            keys: @keys(Control + A);
            enabled: !root.text-editing;
            activated => { root.select-all(); }
        }
        KeyBinding {
            keys: @keys(Control + C);
            enabled: !root.text-editing;
            activated => { root.do-copy(); }
        }
        KeyBinding {
            keys: @keys(Control + X);
            enabled: !root.text-editing;
            activated => { root.do-cut(); }
        }
        KeyBinding {
            keys: @keys(Control + V);
            enabled: !root.text-editing;
            activated => { root.do-paste(); }
        }
        KeyBinding {
            keys: @keys(Control + Z);
            enabled: !root.text-editing;
            activated => { root.do-undo(); }
        }
        KeyBinding {
            keys: @keys(Delete);
            enabled: !root.text-editing;
            activated => { root.do-delete(); }
        }
        KeyBinding {
            keys: @keys(Shift + Delete);
            enabled: !root.text-editing;
            activated => {
                if (root.sel-count > 0) {
                    root.dialog-open = true;
                    root.dialog-kind = "perm-delete";
                    root.dialog-target = root.single-name;
                }
            }
        }
        KeyBinding {
            keys: @keys(Return);
            enabled: !root.text-editing;
            activated => {
                if (root.renaming != "") {
                    root.commit-rename();
                } else if (root.search-open) {
                    root.search-accepted();
                } else if (root.sel-count == 1) {
                    root.open-item(root.single-name, root.single-kind, root.single-ext, root.single-path);
                }
            }
        }
        KeyBinding {
            keys: @keys(Control + Shift + "1");
            enabled: !root.text-editing;
            activated => { root.set-layout("Vertical"); }
        }
        KeyBinding {
            keys: @keys(Control + Shift + "2");
            enabled: !root.text-editing;
            activated => { root.set-layout("Horizontal"); }
        }
        KeyBinding {
            keys: @keys(Control + Shift + "3");
            enabled: !root.text-editing;
            activated => { root.set-layout("Thumbnail"); }
        }
        KeyBinding {
            keys: @keys(Control + Shift + "4");
            enabled: !root.text-editing;
            activated => { root.set-layout("Tiles"); }
        }
        KeyBinding {
            keys: @keys(Control + Shift + "5");
            enabled: !root.text-editing;
            activated => { root.set-layout("Split"); }
        }
        KeyBinding {
            keys: @keys(Control + T);
            enabled: !root.text-editing;
            activated => { root.add-tab(); }
        }
        KeyBinding {
            keys: @keys(Control + W);
            enabled: !root.text-editing;
            activated => { root.close-tab(root.active-tab); }
        }
        KeyBinding {
            keys: @keys(Alt + LeftArrow);
            enabled: !root.text-editing;
            activated => { root.go-back(); }
        }
        KeyBinding {
            keys: @keys(Alt + RightArrow);
            enabled: !root.text-editing;
            activated => { root.go-forward(); }
        }
        KeyBinding {
            keys: @keys(Alt + UpArrow);
            enabled: !root.text-editing;
            activated => { root.go-up(); }
        }

        // Type-ahead: huruf/angka tanpa modifier saat daftar fokus
        // → lompat ke item pertama yang namanya diawali buffer.
        // Diputuskan di Rust (hanya [A-Za-z0-9 _-.] yang dihitung).
        key-pressed(event) => {
            if (event.text.character-count == 1 && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && !root.text-editing && root.is-typeahead-char(event.text)) {
                root.typeahead-char(event.text);
                return accept;
            }
            reject
        }
    }

    // ============================================================
    // CHUNK 5: METODE SISA + ELEMEN MENGAMBANG
    // ============================================================
    callback remove-qa(int);
    remove-qa(i) => {
        root.toast("Pin dihapus: " + root.qa-labels[i]);
        root.qa-paths = [i == 0 ? "" : root.qa-paths[0], i == 1 ? "" : root.qa-paths[1], i == 2 ? "" : root.qa-paths[2], i == 3 ? "" : root.qa-paths[3]];
        root.qa-labels = [i == 0 ? "" : root.qa-labels[0], i == 1 ? "" : root.qa-labels[1], i == 2 ? "" : root.qa-labels[2], i == 3 ? "" : root.qa-labels[3]];
    }
    callback focus-list();
    focus-list() => { list-scope.focus(); }
    callback open-in-new-tab(string);
    open-in-new-tab(path) => {
        root.ctx-open = false;
        root.add-tab();
        root.nav-to-path(path);
    }
    callback dialog-confirm();
    dialog-confirm() => {
        if (root.dialog-kind == "new-folder") { root.confirm-new-folder(); }
        else if (root.dialog-kind == "new-file") { root.confirm-new-file(); }
        else if (root.dialog-kind == "duplicate") { root.confirm-duplicate(); }
        else if (root.dialog-kind == "perm-delete") { root.confirm-perm-delete(); }
        else if (root.dialog-kind == "tab-rename") { root.rename-tab-confirm(); }
    }

    changed dialog-open => {
        if (self.dialog-open) {
            dialog-input.focus();
            dialog-input.set-selection-offsets(0, root.dialog-text.character-count);
        }
    }

    // ---------- Pil seleksi (bawah-tengah, bila > 1 terpilih) ----------
    Rectangle {
        visible: root.sel-count > 1;
        width: 220px; height: 36px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 52px;
        background: Design.card-bg;
        border-color: Design.separator;
        border-width: 1px;
        border-radius: 18px;
        Text {
            text: root.sel-count + " items selected";
            font-size: 13px; font-weight: 700; color: Design.text-primary;
            horizontal-alignment: center; vertical-alignment: center;
            width: 100%; height: 100%;
        }
    }

    // ---------- Pil type-ahead (di atas pil seleksi) ----------
    Rectangle {
        visible: root.ta-buffer != "";
        width: 120px; height: 32px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 96px;
        background: Design.accent;
        border-radius: 16px;
        Text {
            text: root.ta-buffer;
            font-size: 13px; font-weight: 700; color: white;
            horizontal-alignment: center; vertical-alignment: center;
            width: 100%; height: 100%;
        }
    }

    // ---------- Task Monitor (pojok kanan-bawah, 420px) ----------
    Rectangle {
        visible: root.tm-visible;
        width: 420px;
        // 92px = padding 12x2 + header 24 + footer 36 + spacing 8x2;
        // per kartu 108px = kartu 100 + spacing 8.
        height: 92px + (root.tm-status[0] != "" ? 108px : 0px) + (root.tm-status[1] != "" ? 108px : 0px) + (root.tm-status[2] != "" ? 108px : 0px);
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        background: Design.card-bg;
        border-color: Design.separator;
        border-width: 1px;
        border-radius: Design.radius-md;
        VerticalLayout {
            width: 100%; height: 100%;
            spacing: 8px;
            padding: 12px;
            HorizontalLayout {
                height: 24px;
                Text {
                    text: "TASK MONITOR";
                    font-size: 11px; font-weight: 800; color: Design.text-muted;
                    letter-spacing: 1px;
                    horizontal-stretch: 1; vertical-alignment: center;
                }
                IconBtn {
                    glyph: "×";
                    variant: "ghost"; size: 24px;
                    clicked => { root.tm-visible = false; }
                }
            }
            for i in 3 : TaskCard {
                height: root.tm-status[i] != "" ? 100px : 0px;
                visible: root.tm-status[i] != "";
                kind: root.tm-kind[i];
                name: root.tm-name[i];
                prog: root.tm-prog[i];
                status: root.tm-status[i];
                size: root.tm-size[i];
                cancel => { root.tm-cancel(i); }
                retry => { root.tm-retry(i); }
                remove => { root.tm-remove(i); }
            }
            HorizontalLayout {
                height: 36px;
                Rectangle { horizontal-stretch: 1; }
                Btn {
                    label: "Bersihkan yang selesai";
                    small: true; variant: "ghost";
                    clicked => { root.tm-clear-done(); }
                }
            }
        }
    }

    // ---------- Scrim menu konteks (klik di luar = tutup menu) ----------
    Rectangle {
        visible: root.ctx-open || root.tab-ctx >= 0;
        width: 100%; height: 100%;
        background: transparent;
        ctx-scrim-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.ctx-open = false;
                root.tab-ctx = -1;
            }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                    root.ctx-open = false;
                    root.tab-ctx = -1;
                }
            }
        }
    }

    // ---------- Menu konteks item ----------
    Rectangle {
        visible: root.ctx-open && !root.ctx-is-bg;
        width: 240px;
        height: 12px + 288px + (root.ctx-kind == "folder" ? 32px : 0px) + (root.ctx-show-batch ? 33px : 0px);
        x: parent.width - 280px;
        y: 160px;
        background: Design.card-bg;
        border-color: Design.separator;
        border-width: 1px;
        border-radius: Design.radius-md;
        VerticalLayout {
            width: 100%;
            spacing: 0;
            padding: 6px;
            CtxItem {
                label: "Open";
                clicked => { root.ctx-open = false; root.open-item(root.ctx-name, root.ctx-kind, root.ctx-ext, root.ctx-path); }
            }
            CtxItem {
                label: "Open in New Tab";
                visible: root.ctx-kind == "folder";
                clicked => { root.open-in-new-tab(root.ctx-path); }
            }
            CtxItem {
                label: "Copy";
                clicked => { root.ctx-open = false; root.do-copy(); }
            }
            CtxItem {
                label: "Cut";
                clicked => { root.ctx-open = false; root.do-cut(); }
            }
            CtxItem {
                label: "Paste";
                disabled: root.cb-count == 0;
                clicked => { root.ctx-open = false; root.do-paste(); }
            }
            CtxItem {
                label: "Rename";
                clicked => { root.start-rename(root.ctx-name, root.ctx-ext, root.ctx-base); }
            }
            CtxItem {
                label: "Duplicate";
                clicked => { root.ctx-open = false; root.do-duplicate(); }
            }
            CtxItem {
                label: "Delete";
                clicked => { root.ctx-open = false; root.do-delete(); }
            }
            CtxItem {
                label: "Permanent Delete";
                danger: true;
                clicked => {
                    root.ctx-open = false;
                    root.dialog-open = true;
                    root.dialog-kind = "perm-delete";
                    root.dialog-target = root.single-name;
                }
            }
            CtxItem {
                label: "Copy Path";
                clicked => { root.ctx-open = false; root.do-copy-path(); }
            }
            Rectangle {
                visible: root.ctx-show-batch;
                height: root.ctx-show-batch ? 1px : 0px;
                background: Design.separator;
            }
            CtxItem {
                label: "BUAT MASTER";
                bold: true;
                visible: root.ctx-show-batch;
                clicked => { root.buat-master-ctx(); }
            }
        }
    }

    // ---------- Menu konteks background ----------
    Rectangle {
        visible: root.ctx-open && root.ctx-is-bg;
        width: 240px;
        height: 205px;
        x: parent.width - 280px;
        y: 160px;
        background: Design.card-bg;
        border-color: Design.separator;
        border-width: 1px;
        border-radius: Design.radius-md;
        VerticalLayout {
            width: 100%;
            spacing: 0;
            padding: 6px;
            CtxItem {
                label: "New Folder";
                clicked => { root.do-new-folder(); }
            }
            CtxItem {
                label: "New File";
                clicked => { root.do-new-file(); }
            }
            CtxItem {
                label: "Paste";
                disabled: root.cb-count == 0;
                clicked => { root.ctx-open = false; root.do-paste(); }
            }
            CtxItem {
                label: "Select All";
                clicked => { root.ctx-open = false; root.select-all(); }
            }
            CtxItem {
                label: "Refresh";
                clicked => { root.ctx-open = false; root.refresh(); }
            }
            HSeparator { }
            CtxItem {
                label: (root.local-only ? "✓ " : "") + "This Folder Only";
                clicked => {
                    root.local-only = !root.local-only;
                    root.ctx-open = false;
                    root.toast(root.local-only ? "Tampilan disimpan untuk folder ini." : "Tampilan kembali ke global.");
                }
            }
        }
    }

    // ---------- Menu konteks tab ----------
    Rectangle {
        visible: root.tab-ctx >= 0;
        width: 200px;
        height: 12px + (root.tabs-pinned[root.tab-ctx] ? 128px : 64px);
        x: 8px;
        y: 40px;
        background: Design.card-bg;
        border-color: Design.separator;
        border-width: 1px;
        border-radius: Design.radius-md;
        VerticalLayout {
            width: 100%;
            spacing: 0;
            padding: 6px;
            CtxItem {
                label: "Pin Tab";
                visible: !root.tabs-pinned[root.tab-ctx];
                clicked => { root.pin-tab(root.tab-ctx); }
            }
            CtxItem {
                label: "Unpin Tab";
                visible: root.tabs-pinned[root.tab-ctx];
                clicked => { root.unpin-tab(root.tab-ctx); }
            }
            CtxItem {
                label: "Change Color";
                visible: root.tabs-pinned[root.tab-ctx];
                clicked => { root.cycle-tab-color(); }
            }
            CtxItem {
                label: "Rename…";
                visible: root.tabs-pinned[root.tab-ctx];
                clicked => {
                    root.dialog-open = true;
                    root.dialog-kind = "tab-rename";
                    root.dialog-text = root.tabs-label[root.tab-ctx];
                }
            }
            CtxItem {
                label: "Close Tab";
                clicked => { root.close-tab(root.tab-ctx); }
            }
        }
    }

    // ---------- Dialog overlay (spotlight) ----------
    Rectangle {
        visible: root.dialog-open;
        width: 100%; height: 100%;
        background: Design.overlay-dim;
        dialog-scrim-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.dialog-open = false; }
        }
        Rectangle {
            width: 420px;
            height: root.dialog-kind == "perm-delete" ? 184px : 220px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Design.card-bg;
            border-color: Design.separator;
            border-width: 1px;
            border-radius: Design.radius-md;
            VerticalLayout {
                width: 100%; height: 100%;
                spacing: 12px;
                padding: 20px;
                Text {
                    text: root.dialog-kind == "new-folder" ? "Folder Baru" : root.dialog-kind == "new-file" ? "File Baru" : root.dialog-kind == "duplicate" ? "Duplikat" : root.dialog-kind == "perm-delete" ? "Hapus Permanen" : "Rename Tab";
                    font-size: Design.font-h2; font-weight: 800;
                    color: Design.text-primary;
                }
                Text {
                    text: root.dialog-kind == "new-folder" ? "Nama folder baru di folder ini." : root.dialog-kind == "new-file" ? "Nama file baru di folder ini (tanpa \".\" otomatis +.txt)." : root.dialog-kind == "duplicate" ? "Buat salinan dari \"" + root.dialog-target + "\" (maks 100)." : root.dialog-kind == "perm-delete" ? "Hapus permanen \"" + root.dialog-target + "\"? Tidak bisa dibatalkan." : "Label baru tab (maks 2 huruf, contoh: GA).";
                    font-size: Design.font-body;
                    color: Design.text-secondary;
                    wrap: word-wrap;
                }
                Rectangle {
                    visible: root.dialog-kind == "new-folder" || root.dialog-kind == "new-file" || root.dialog-kind == "tab-rename";
                    height: 36px;
                    background: Design.bg-input;
                    border-color: Design.border-focus;
                    border-width: 1px;
                    border-radius: Design.radius-sm;
                    clip: true;
                    dialog-input := TextInput {
                        x: 10px; width: parent.width - 20px; height: 100%;
                        text <=> root.dialog-text;
                        font-size: 13px;
                        color: Design.text-primary;
                        selection-foreground-color: white;
                        selection-background-color: Design.accent;
                        vertical-alignment: center;
                        accepted => { root.dialog-confirm(); }
                    }
                }
                HorizontalLayout {
                    visible: root.dialog-kind == "duplicate";
                    height: 36px;
                    spacing: 12px;
                    Text {
                        text: "Jumlah salinan:";
                        font-size: 13px; color: Design.text-primary;
                        vertical-alignment: center;
                    }
                    Btn {
                        label: "−";
                        small: true;
                        clicked => { root.dup-count = max(1, root.dup-count - 1); }
                    }
                    Text {
                        text: root.dup-count;
                        font-size: Design.font-h3; font-weight: 700; color: Design.text-primary;
                        vertical-alignment: center;
                        width: 40px; horizontal-alignment: center;
                    }
                    Btn {
                        label: "+";
                        small: true;
                        clicked => { root.dup-count = min(100, root.dup-count + 1); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    height: 36px;
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        label: "Batal";
                        variant: "ghost";
                        clicked => { root.dialog-open = false; }
                    }
                    Btn {
                        label: root.dialog-kind == "perm-delete" ? "Hapus Permanen" : root.dialog-kind == "duplicate" ? "Duplikat" : root.dialog-kind == "tab-rename" ? "Simpan" : "Buat";
                        variant: root.dialog-kind == "perm-delete" ? "danger" : "primary";
                        clicked => { root.dialog-confirm(); }
                    }
                }
            }
        }
    }
}
