                                    Rectangle {
                                    height: 300px;
                                    bg-touch-s := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.clear-selection(); }
                                    pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                    root.open-bg-ctx();
                                    }
                                    if (e.button == PointerEventButton.back && e.kind == PointerEventKind.up) {
                                        root.go-back();
                                    }
                                    if (e.button == PointerEventButton.forward && e.kind == PointerEventKind.up) {
                                        root.go-forward();
                                    }
                                    }
                                    }
                                    }
