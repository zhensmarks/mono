    callback select-index(int);
    select-index(idx) => {
        root.clear-selection();
        root.sel-names = [root.it-names[idx], "", "", "", "", "", "", "", "", "", "", ""];
        root.sel-kinds = [root.it-kinds[idx], "", "", "", "", "", "", "", "", "", "", ""];
        root.sel-exts = [root.it-exts[idx], "", "", "", "", "", "", "", "", "", "", ""];
        root.sel-bases = [root.it-bases[idx], "", "", "", "", "", "", "", "", "", "", ""];
        root.sel-previews = [root.it-previews[idx], "", "", "", "", "", "", "", "", "", "", ""];
        root.sel-sizes = [root.it-sizes[idx], "", "", "", "", "", "", "", "", "", "", ""];
        root.sel-dates = [root.it-dates[idx], "", "", "", "", "", "", "", "", "", "", ""];
        // Scroll ke baris itu (layout Vertical: 26px per baris; di
        // layout lain hanya perkiraan — seleksi tetap benar).
        vert-flick.content-y = -(idx * 26px);
    }

    callback select-all();
