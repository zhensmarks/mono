        if (root.dup-count >= 3) {
            root.dup-name = root.dup-base + " - Copy (3)" + root.dup-ext;
            root.dup-name-base = root.dup-base + " - Copy (3)";
            if (root.name-exists(root.dup-name)) {
                root.dup-name = root.dup-base + " - Copy (4)" + root.dup-ext;
                root.dup-name-base = root.dup-base + " - Copy (4)";
            }
            root.add-one(root.dup-name, root.dup-kind, root.dup-ext, root.dup-name-base, root.dup-size, root.dup-date, root.dup-preview);
            root.push-undo("copy", root.dup-name, "");
        }
        if (root.dup-count >= 4) {
            root.dup-name = root.dup-base + " - Copy (4)" + root.dup-ext;
            root.dup-name-base = root.dup-base + " - Copy (4)";
            if (root.name-exists(root.dup-name)) {
                root.dup-name = root.dup-base + " - Copy (5)" + root.dup-ext;
                root.dup-name-base = root.dup-base + " - Copy (5)";
            }
            root.add-one(root.dup-name, root.dup-kind, root.dup-ext, root.dup-name-base, root.dup-size, root.dup-date, root.dup-preview);
            root.push-undo("copy", root.dup-name, "");
        }
        if (root.dup-count >= 5) {
            root.dup-name = root.dup-base + " - Copy (5)" + root.dup-ext;
            root.dup-name-base = root.dup-base + " - Copy (5)";
            if (root.name-exists(root.dup-name)) {
                root.dup-name = root.dup-base + " - Copy (6)" + root.dup-ext;
                root.dup-name-base = root.dup-base + " - Copy (6)";
            }
            root.add-one(root.dup-name, root.dup-kind, root.dup-ext, root.dup-name-base, root.dup-size, root.dup-date, root.dup-preview);
            root.push-undo("copy", root.dup-name, "");
        }
        root.add-task("COPY", root.dialog-target, "");
        root.toast("Diduplikasi: " + root.dup-count + " salinan (maks 5 per aksi di mockup).");
    }

    callback do-new-folder();
    do-new-folder() => {
        root.dialog-open = true;
        root.dialog-kind = "new-folder";
        root.dialog-text = "New Folder";
        root.dialog-target = "";
        root.ctx-open = false;
    }
    callback do-new-file();
    do-new-file() => {
        root.dialog-open = true;
        root.dialog-kind = "new-file";
        root.dialog-text = "New File.txt";
        root.dialog-target = "";
        root.ctx-open = false;
    }
    callback confirm-new-folder();
    confirm-new-folder() => {
        if (root.dialog-text == "") {
            root.toast("Nama tidak boleh kosong.");
        } else if (root.name-exists(root.dialog-text)) {
            root.toast("Nama sudah ada: " + root.dialog-text);
        } else {
            root.add-one(root.dialog-text, "folder", "", root.dialog-text, "", "26 Nov 2026", "");
            root.push-undo("new", root.dialog-text, "");
            root.renaming = root.dialog-text;
            root.rename-ext = "";
            root.rename-draft = root.dialog-text;
            root.toast("Folder dibuat: " + root.dialog-text);
            root.dialog-open = false;
        }
    }
    callback confirm-new-file();
    confirm-new-file() => {
        root.new-name = root.add-txt-ext(root.dialog-text);
        if (root.new-name == "") {
            root.toast("Nama tidak boleh kosong.");
        } else if (root.name-exists(root.new-name)) {
            root.toast("Nama sudah ada: " + root.new-name);
        } else {
            root.new-ext = root.split-ext(root.new-name);
            root.new-base = root.name-base(root.new-name);
            root.add-one(root.new-name, "file", root.new-ext, root.new-base, "1 KB", "26 Nov 2026", "");
            root.push-undo("new", root.new-name, "");
            root.toast("File dibuat: " + root.new-name);
            root.dialog-open = false;
        }
    }

    callback start-rename(string, string, string);
    start-rename(name, ext, base) => {
        root.renaming = name;
        root.rename-ext = ext;
        root.rename-draft = base;
        root.ctx-open = false;
    }
    callback cancel-rename();
    cancel-rename() => {
        root.renaming = "";
        root.rename-draft = "";
    }
    callback commit-rename();
    commit-rename() => {
        if (root.renaming == "") {
        } else if (root.rename-draft == "") {
            root.toast("Nama tidak boleh kosong.");
        } else {
            root.rename-new = root.rename-draft + root.rename-ext;
            if (root.rename-new == root.renaming) {
                root.renaming = "";
                root.rename-draft = "";
            } else if (root.name-exists(root.rename-new)) {
                root.toast("Nama sudah ada: " + root.rename-new);
            } else {
                root.push-undo("rename", root.rename-new, root.renaming);
                root.rename-one(root.renaming, root.rename-new);
                root.toast("Rename: " + root.renaming + " → " + root.rename-new);
                root.renaming = "";
                root.rename-draft = "";
            }
        }
    }
    callback do-copy-path();
    do-copy-path() => {
        if (root.sel-count == 0) {
            root.toast("Path disalin: " + root.cur-path);
        } else if (root.sel-count == 1) {
            root.toast("Path disalin: " + root.cur-path + "\\" + root.single-name);
        } else {
            root.toast("Disalin " + root.sel-count + " path.");
        }
    }

    callback add-task(string, string, string);
    add-task(kind, name, size) => {
        root.tm-slot = root.tm-status[0] == "" || root.tm-status[0] == "done" || root.tm-status[0] == "cancelled" ? 0 : root.tm-status[1] == "" || root.tm-status[1] == "done" || root.tm-status[1] == "cancelled" ? 1 : root.tm-status[2] == "" || root.tm-status[2] == "done" || root.tm-status[2] == "cancelled" ? 2 : -1;
        if (root.tm-slot < 0) {
            root.toast("Task Monitor penuh (3 tugas).");
        } else {
            root.tm-kind = [root.tm-slot == 0 ? kind : root.tm-kind[0], root.tm-slot == 1 ? kind : root.tm-kind[1], root.tm-slot == 2 ? kind : root.tm-kind[2]];
            root.tm-name = [root.tm-slot == 0 ? name : root.tm-name[0], root.tm-slot == 1 ? name : root.tm-name[1], root.tm-slot == 2 ? name : root.tm-name[2]];
            root.tm-prog = [root.tm-slot == 0 ? 0 : root.tm-prog[0], root.tm-slot == 1 ? 0 : root.tm-prog[1], root.tm-slot == 2 ? 0 : root.tm-prog[2]];
            root.tm-status = [root.tm-slot == 0 ? "run" : root.tm-status[0], root.tm-slot == 1 ? "run" : root.tm-status[1], root.tm-slot == 2 ? "run" : root.tm-status[2]];
            root.tm-size = [root.tm-slot == 0 ? size : root.tm-size[0], root.tm-slot == 1 ? size : root.tm-size[1], root.tm-slot == 2 ? size : root.tm-size[2]];
            root.tm-visible = true;
        }
    }
    callback tm-cancel(int);
    tm-cancel(i) => {
        root.tm-status = [i == 0 ? "cancelled" : root.tm-status[0], i == 1 ? "cancelled" : root.tm-status[1], i == 2 ? "cancelled" : root.tm-status[2]];
    }
    callback tm-retry(int);
    tm-retry(i) => {
        root.tm-status = [i == 0 ? "run" : root.tm-status[0], i == 1 ? "run" : root.tm-status[1], i == 2 ? "run" : root.tm-status[2]];
        root.tm-prog = [i == 0 ? 0 : root.tm-prog[0], i == 1 ? 0 : root.tm-prog[1], i == 2 ? 0 : root.tm-prog[2]];
    }
    callback tm-remove(int);
    tm-remove(i) => {
        root.tm-kind = [i == 0 ? "" : root.tm-kind[0], i == 1 ? "" : root.tm-kind[1], i == 2 ? "" : root.tm-kind[2]];
        root.tm-name = [i == 0 ? "" : root.tm-name[0], i == 1 ? "" : root.tm-name[1], i == 2 ? "" : root.tm-name[2]];
        root.tm-prog = [i == 0 ? 0 : root.tm-prog[0], i == 1 ? 0 : root.tm-prog[1], i == 2 ? 0 : root.tm-prog[2]];
        root.tm-status = [i == 0 ? "" : root.tm-status[0], i == 1 ? "" : root.tm-status[1], i == 2 ? "" : root.tm-status[2]];
        root.tm-size = [i == 0 ? "" : root.tm-size[0], i == 1 ? "" : root.tm-size[1], i == 2 ? "" : root.tm-size[2]];
        if (root.tm-status[0] == "" && root.tm-status[1] == "" && root.tm-status[2] == "") {
            root.tm-visible = false;
        }
    }
    callback tm-clear-done();
    tm-clear-done() => {
        root.tm-kind = [(root.tm-status[0] == "done" || root.tm-status[0] == "cancelled" || root.tm-status[0] == "failed") ? "" : root.tm-kind[0], (root.tm-status[1] == "done" || root.tm-status[1] == "cancelled" || root.tm-status[1] == "failed") ? "" : root.tm-kind[1], (root.tm-status[2] == "done" || root.tm-status[2] == "cancelled" || root.tm-status[2] == "failed") ? "" : root.tm-kind[2]];
        root.tm-name = [(root.tm-status[0] == "done" || root.tm-status[0] == "cancelled" || root.tm-status[0] == "failed") ? "" : root.tm-name[0], (root.tm-status[1] == "done" || root.tm-status[1] == "cancelled" || root.tm-status[1] == "failed") ? "" : root.tm-name[1], (root.tm-status[2] == "done" || root.tm-status[2] == "cancelled" || root.tm-status[2] == "failed") ? "" : root.tm-name[2]];
        root.tm-prog = [(root.tm-status[0] == "done" || root.tm-status[0] == "cancelled" || root.tm-status[0] == "failed") ? 0 : root.tm-prog[0], (root.tm-status[1] == "done" || root.tm-status[1] == "cancelled" || root.tm-status[1] == "failed") ? 0 : root.tm-prog[1], (root.tm-status[2] == "done" || root.tm-status[2] == "cancelled" || root.tm-status[2] == "failed") ? 0 : root.tm-prog[2]];
        root.tm-size = [(root.tm-status[0] == "done" || root.tm-status[0] == "cancelled" || root.tm-status[0] == "failed") ? "" : root.tm-size[0], (root.tm-status[1] == "done" || root.tm-status[1] == "cancelled" || root.tm-status[1] == "failed") ? "" : root.tm-size[1], (root.tm-status[2] == "done" || root.tm-status[2] == "cancelled" || root.tm-status[2] == "failed") ? "" : root.tm-size[2]];
        root.tm-status = [(root.tm-status[0] == "done" || root.tm-status[0] == "cancelled" || root.tm-status[0] == "failed") ? "" : root.tm-status[0], (root.tm-status[1] == "done" || root.tm-status[1] == "cancelled" || root.tm-status[1] == "failed") ? "" : root.tm-status[1], (root.tm-status[2] == "done" || root.tm-status[2] == "cancelled" || root.tm-status[2] == "failed") ? "" : root.tm-status[2]];
        if (root.tm-status[0] == "" && root.tm-status[1] == "" && root.tm-status[2] == "") {
            root.tm-visible = false;
        }
    }

    callback switch-tab(int);
    switch-tab(i) => {
        if (i != root.active-tab && i < root.tab-count) {
            root.active-tab = i;
            root.nav-to-path(root.tabs-path[i]);
        }
    }
    callback add-tab();
    add-tab() => {
        if (root.tab-count >= 4) {
            root.toast("Maksimal 4 tab.");
        } else {
            root.tabs-path = [root.tab-count == 0 ? "" : root.tabs-path[0], root.tab-count == 1 ? "" : root.tabs-path[1], root.tab-count == 2 ? "" : root.tabs-path[2], root.tab-count == 3 ? "" : root.tabs-path[3]];
            root.tabs-name = [root.tab-count == 0 ? "" : root.tabs-name[0], root.tab-count == 1 ? "" : root.tabs-name[1], root.tab-count == 2 ? "" : root.tabs-name[2], root.tab-count == 3 ? "" : root.tabs-name[3]];
            root.tabs-pinned = [root.tab-count == 0 ? false : root.tabs-pinned[0], root.tab-count == 1 ? false : root.tabs-pinned[1], root.tab-count == 2 ? false : root.tabs-pinned[2], root.tab-count == 3 ? false : root.tabs-pinned[3]];
            root.tabs-label = [root.tab-count == 0 ? "" : root.tabs-label[0], root.tab-count == 1 ? "" : root.tabs-label[1], root.tab-count == 2 ? "" : root.tabs-label[2], root.tab-count == 3 ? "" : root.tabs-label[3]];
            root.tabs-color = [root.tab-count == 0 ? 0 : root.tabs-color[0], root.tab-count == 1 ? 0 : root.tabs-color[1], root.tab-count == 2 ? 0 : root.tabs-color[2], root.tab-count == 3 ? 0 : root.tabs-color[3]];
            root.active-tab = root.tab-count;
            root.tab-count = root.tab-count + 1;
            root.load-folder("root", "", "", true);
        }
    }
    callback close-tab(int);
    close-tab(i) => {
        if (root.tab-count == 1) {
            root.close();
        } else {
            root.tabs-path = [i == 0 ? root.tabs-path[1] : root.tabs-path[0], i == 0 ? root.tabs-path[2] : i == 1 ? root.tabs-path[3] : root.tabs-path[1], i == 0 ? root.tabs-path[3] : i == 1 ? "" : i == 2 ? "" : root.tabs-path[2], ""];
            root.tabs-name = [i == 0 ? root.tabs-name[1] : root.tabs-name[0], i == 0 ? root.tabs-name[2] : i == 1 ? root.tabs-name[3] : root.tabs-name[1], i == 0 ? root.tabs-name[3] : i == 1 ? "" : i == 2 ? "" : root.tabs-name[2], ""];
            root.tabs-pinned = [i == 0 ? root.tabs-pinned[1] : root.tabs-pinned[0], i == 0 ? root.tabs-pinned[2] : i == 1 ? root.tabs-pinned[3] : root.tabs-pinned[1], i == 0 ? root.tabs-pinned[3] : i == 1 ? false : i == 2 ? false : root.tabs-pinned[2], false];
            root.tabs-label = [i == 0 ? root.tabs-label[1] : root.tabs-label[0], i == 0 ? root.tabs-label[2] : i == 1 ? root.tabs-label[3] : root.tabs-label[1], i == 0 ? root.tabs-label[3] : i == 1 ? "" : i == 2 ? "" : root.tabs-label[2], ""];
            root.tabs-color = [i == 0 ? root.tabs-color[1] : root.tabs-color[0], i == 0 ? root.tabs-color[2] : i == 1 ? root.tabs-color[3] : root.tabs-color[1], i == 0 ? root.tabs-color[3] : i == 1 ? 0 : i == 2 ? 0 : root.tabs-color[2], 0];
            root.tab-count = root.tab-count - 1;
            if (i < root.active-tab) {
                root.active-tab = root.active-tab - 1;
            } else if (i == root.active-tab) {
                root.active-tab = min(i, root.tab-count - 1);
            }
            root.nav-to-path(root.tabs-path[root.active-tab]);
        }
    }
    callback pin-tab(int);
    pin-tab(i) => {
        root.tabs-path = [root.tabs-path[i], i == 0 ? root.tabs-path[1] : root.tabs-path[0], i == 0 || i == 1 ? root.tabs-path[2] : root.tabs-path[1], i == 3 ? root.tabs-path[2] : root.tabs-path[3]];
        root.tabs-name = [root.tabs-name[i], i == 0 ? root.tabs-name[1] : root.tabs-name[0], i == 0 || i == 1 ? root.tabs-name[2] : root.tabs-name[1], i == 3 ? root.tabs-name[2] : root.tabs-name[3]];
        root.tabs-pinned = [true, i == 0 ? root.tabs-pinned[1] : root.tabs-pinned[0], i == 0 || i == 1 ? root.tabs-pinned[2] : root.tabs-pinned[1], i == 3 ? root.tabs-pinned[2] : root.tabs-pinned[3]];
        root.tabs-label = [root.initials(root.tabs-name[0]), i == 0 ? root.tabs-label[1] : root.tabs-label[0], i == 0 || i == 1 ? root.tabs-label[2] : root.tabs-label[1], i == 3 ? root.tabs-label[2] : root.tabs-label[3]];
        root.tabs-color = [0, i == 0 ? root.tabs-color[1] : root.tabs-color[0], i == 0 || i == 1 ? root.tabs-color[2] : root.tabs-color[1], i == 3 ? root.tabs-color[2] : root.tabs-color[3]];
        if (root.active-tab == i) {
            root.active-tab = 0;
        } else if (root.active-tab < i) {
            root.active-tab = root.active-tab + 1;
        }
        root.tab-ctx = -1;
        root.toast("Tab dipin: " + root.tabs-name[0]);
    }
    callback unpin-tab(int);
    unpin-tab(i) => {
        root.tabs-pinned = [i == 0 ? false : root.tabs-pinned[0], i == 1 ? false : root.tabs-pinned[1], i == 2 ? false : root.tabs-pinned[2], i == 3 ? false : root.tabs-pinned[3]];
        root.tab-ctx = -1;
        root.toast("Pin dilepas.");
    }
    callback cycle-tab-color();
    cycle-tab-color() => {
        if (root.tab-ctx >= 0) {
            root.tabs-color = [root.tab-ctx == 0 ? mod(root.tabs-color[0] + 1, 8) : root.tabs-color[0], root.tab-ctx == 1 ? mod(root.tabs-color[1] + 1, 8) : root.tabs-color[1], root.tab-ctx == 2 ? mod(root.tabs-color[2] + 1, 8) : root.tabs-color[2], root.tab-ctx == 3 ? mod(root.tabs-color[3] + 1, 8) : root.tabs-color[3]];
        }
    }
    callback rename-tab-confirm();
    rename-tab-confirm() => {
        if (root.tab-ctx >= 0 && root.dialog-text != "") {
            root.tabs-label = [root.tab-ctx == 0 ? root.initials(root.dialog-text) : root.tabs-label[0], root.tab-ctx == 1 ? root.initials(root.dialog-text) : root.tabs-label[1], root.tab-ctx == 2 ? root.initials(root.dialog-text) : root.tabs-label[2], root.tab-ctx == 3 ? root.initials(root.dialog-text) : root.tabs-label[3]];
            root.dialog-open = false;
            root.tab-ctx = -1;
        } else {
            root.toast("Label tidak boleh kosong.");
        }
    }
    callback open-tab-ctx(int);
    open-tab-ctx(i) => {
        root.tab-ctx = i;
        root.ctx-open = false;
    }

    callback cycle-sort();
    cycle-sort() => {
        root.ex-sort = root.ex-sort == "Name" ? "Date" : root.ex-sort == "Date" ? "Type" : "Name";
        root.toast("Sort: " + root.ex-sort + (root.ex-desc ? " (Menurun)" : " (Menaik)"));
    }
    callback toggle-desc();
    toggle-desc() => {
        root.ex-desc = !root.ex-desc;
        root.toast("Urutan: " + (root.ex-desc ? "Menurun" : "Menaik"));
    }
    callback cycle-group();
    cycle-group() => {
        root.ex-group = root.ex-group == "None" ? "Date" : root.ex-group == "Date" ? "Type" : "None";
        root.toast("Group: " + root.ex-group);
    }
    callback set-layout(string);
    set-layout(mode) => {
        root.layout = mode;
        root.toast("Layout: " + mode + (mode == "Vertical" ? " (Ctrl+Shift+1)" : mode == "Horizontal" ? " (Ctrl+Shift+2)" : mode == "Thumbnail" ? " (Ctrl+Shift+3)" : mode == "Tiles" ? " (Ctrl+Shift+4)" : " (Ctrl+Shift+5)"));
    }
    callback open-search();
    open-search() => { root.search-open = true; }
    callback close-search();
    close-search() => { root.search-open = false; root.search-text = ""; root.searching = false; }
    callback search-edited(string);
    search-edited(text) => { root.search-text = text; root.searching = true; search-timer.restart(); }
    callback search-accepted();
    search-accepted() => { root.open-first-result(); }
    callback start-addr-edit();
    start-addr-edit() => { root.addr-editing = true; root.addr-text = root.cur-path; }
    callback commit-addr();
    commit-addr() => { root.addr-editing = false; root.nav-to-path(root.addr-text); }
    callback cancel-addr();
    cancel-addr() => { root.addr-editing = false; root.addr-text = ""; }
    callback open-ctx(string, string, string, string, string, bool);
    open-ctx(name, kind, ext, base, full-path, show-batch) => {
        root.ctx-open = true;
        root.ctx-is-bg = false;
        root.ctx-name = name;
        root.ctx-kind = kind;
        root.ctx-ext = ext;
        root.ctx-base = base;
        root.ctx-path = full-path;
        root.ctx-show-batch = show-batch;
        root.tab-ctx = -1;
    }
    callback open-bg-ctx();
    open-bg-ctx() => {
        root.ctx-open = true;
        root.ctx-is-bg = true;
        root.ctx-name = "";
        root.ctx-kind = "";
        root.ctx-show-batch = false;
        root.tab-ctx = -1;
    }
    callback close-ctx();
    close-ctx() => { root.ctx-open = false; }
    callback send-selected-to-batch();
    send-selected-to-batch() => {
        if (root.sel-count == 0) {
            root.toast("Pilih folder dulu.");
        } else if (!root.single-is-folder) {
            root.toast("Yang dipilih bukan folder.");
        } else {
            root.send-folder(root.single-name);
        }
    }
    callback send-folder(string);
    send-folder(folder) => {
        // Pemetaan folder contoh DIHAPUS 27 Nov 2026 (keputusan abeng:
        // default publish harus bersih). Isi subfolder dibaca dari disk
        // saat folder nyata sudah bisa dibuka (menyusul Fase 6).
        root.send-to-batch(folder, "", "", "", "");
    }
    callback buat-master-ctx();
    buat-master-ctx() => {
        // Pemetaan folder contoh DIHAPUS 27 Nov 2026 (lihat send-folder).
        root.buat-master(root.ctx-name, "", "", "", "");
        root.ctx-open = false;
    }
    callback typeahead-char(string);
    typeahead-char(ch) => {
        root.ta-buffer = root.ta-buffer + ch;
        ta-timer.restart();
        root.typeahead-request(root.cur-key, root.ta-buffer);
    }
    esc-pressed() => {
        if (root.dialog-open) {
            root.dialog-open = false;
        } else if (root.tab-ctx >= 0) {
            root.tab-ctx = -1;
        } else if (root.ctx-open) {
            root.ctx-open = false;
        } else if (root.renaming != "") {
            root.cancel-rename();
        } else if (root.addr-editing) {
            root.cancel-addr();
        } else if (root.search-open) {
            root.close-search();
        } else if (root.ta-buffer != "") {
            root.ta-buffer = "";
        } else {
            root.close();
        }
    }


    // ============================================================
    // UI TREE
    // ============================================================
    // Tengah belah Split (mode search: sr-half; live-mode: belah dua).
    property <int> split-mid: root.searching-results ? root.sr-half : root.live-mode ? floor((root.live-count + 1) / 2) : root.ord-split-l.length;
    // True saat fokus ada di editor teks (address bar / rename / search).
    property <bool> text-editing: root.addr-editing || root.renaming != "" || search-input.has-focus;

    // Klik kanan = kembali/tutup overlay (arahan abeng 26 Nov 16:58,
    // DESIGN_SYSTEM.md §10.11). TouchArea latar, anak pertama root
    // overlay, di belakang isi. Klik kanan pada item / filler file
    // area ditangkap TouchArea di atasnya (menu konteks); klik kanan
    // di area kosong lain (header, toolbar, sidebar, preview) jatuh
    // ke sini dan menutup overlay.
    explorer-back-touch := TouchArea {
        width: 100%; height: 100%;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.close();
            }
        }
    }

    list-scope := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;

        VerticalLayout {
            width: 100%; height: 100%;
            spacing: 0;

            // ---------- Tab bar ----------
            Rectangle {
                width: 100%;
                height: root.show-tabbar ? 36px : 0px;
                visible: root.show-tabbar;
                background: Design.card-bg;
                HorizontalLayout {
                    width: 100%; height: 100%;
                    spacing: 4px;
                    padding-left: 8px; padding-right: 8px;
                    for i in 4 : Rectangle {
                        width: i < root.tab-count ? (root.tabs-pinned[i] ? 30px : 150px) : 0px;
                        visible: i < root.tab-count;
                        height: 36px;
                        background: root.tabs-pinned[i] ? transparent : root.active-tab == i ? Design.accent-subtle : (tab-touch.has-hover ? Design.bg-hover : transparent);
                        border-radius: Design.radius-sm;
                        tab-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.switch-tab(i); }
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                    root.open-tab-ctx(i);
                                }
                            }
                        }
                        // Badge pin (20x20).
                        Rectangle {
                            visible: root.tabs-pinned[i];
                            width: 20px; height: 20px;
                            x: 5px; y: 8px;
                            background: root.pin-palette[root.tabs-color[i]];
                            border-radius: 5px;
                            Text {
                                text: root.tabs-label[i];
                                font-size: 11px; font-weight: 800; color: white;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                        }
                        Text {
                            visible: !root.tabs-pinned[i];
                            x: 8px; width: parent.width - 30px; height: 100%;
                            text: root.tabs-name[i];
                            font-size: 13px; font-weight: root.active-tab == i ? 700 : 400;
                            color: root.active-tab == i ? Design.accent : Design.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {
                            visible: !root.tabs-pinned[i] && root.active-tab == i;
                            x: 0; y: parent.height - 2px; width: 100%; height: 2px;
                            background: Design.accent;
                        }
                        Rectangle {
                            visible: !root.tabs-pinned[i] && (root.active-tab == i || tab-touch.has-hover);
                            x: parent.width - 24px; y: 9px; width: 18px; height: 18px;
                            Text {
                                text: "×";
                                font-size: 13px; font-weight: 700; color: Design.text-muted;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                            tab-x-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close-tab(i); }
                            }
                        }
                    }
                    IconBtn {
                        glyph: "+";
                        variant: "ghost";
                        size: 36px;
                        clicked => { root.add-tab(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconBtn {
                        glyph: "×";
                        variant: "ghost";
                        size: 36px;
                        clicked => { root.close(); }
                    }
                }
                Rectangle {
                    x: 0; y: parent.height - 1px; width: 100%; height: 1px;
                    background: Design.separator;
                }
            }

            // ---------- Judul folder (bila hanya 1 tab, tidak di-pin) ----------
            Rectangle {
                width: 100%;
                height: root.show-tabbar ? 0px : 44px;
                visible: !root.show-tabbar;
                background: Design.card-bg;
                Text {
                    text: root.cur-name;
                    font-size: Design.font-h2; font-weight: 800;
                    color: Design.text-primary;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: 100%; height: 100%;
                }
                IconBtn {
                    glyph: "×";
                    variant: "ghost";
                    size: 32px;
                    x: parent.width - 40px; y: 6px;
                    clicked => { root.close(); }
                }
                Rectangle {
                    x: 0; y: parent.height - 1px; width: 100%; height: 1px;
                    background: Design.separator;
                }
            }

            // ---------- Path bar ----------
            Rectangle {
                width: 100%; height: 40px;
                background: Design.app-bg;
                HorizontalLayout {
                    width: 100%; height: 100%;
                    spacing: 6px;
                    padding-left: 8px; padding-right: 8px;
                    IconBtn {
                        glyph: "←";
                        variant: "ghost"; size: 36px;
                        opacity: root.back-count > 0 ? 1 : 0.35;
                        clicked => { root.go-back(); }
                    }
                    IconBtn {
                        glyph: "→";
                        variant: "ghost"; size: 36px;
                        opacity: root.fwd-count > 0 ? 1 : 0.35;
                        clicked => { root.go-forward(); }
                    }
                    IconBtn {
                        glyph: "↑";
                        variant: "ghost"; size: 36px;
                        opacity: root.can-up ? 1 : 0.35;
                        clicked => { root.go-up(); }
                    }
                    IconBtn {
                        glyph: "↻";
                        variant: "ghost"; size: 36px;
                        clicked => { root.refresh(); }
                    }
                    // Address bar dual-mode.
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: Design.bg-input;
                        border-color: root.addr-editing ? Design.border-focus : Design.separator;
                        border-width: 1px;
                        border-radius: Design.radius-sm;
                        clip: true;
                        Text {
                            visible: !root.addr-editing;
                            x: 8px; width: parent.width - 16px; height: 100%;
                            text: root.cur-path;
                            font-family: "JetBrains Mono";
                            font-size: 13px;
                            color: Design.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        addr-input := TextInput {
                            visible: root.addr-editing;
                            x: 8px; width: parent.width - 16px; height: 100%;
                            text <=> root.addr-text;
                            font-family: "JetBrains Mono";
                            font-size: 13px;
                            color: Design.text-primary;
                            selection-foreground-color: white;
                            selection-background-color: Design.accent;
                            vertical-alignment: center;
                            accepted => { root.commit-addr(); }
                        }
                        addr-touch := TouchArea {
                            visible: !root.addr-editing;
                            mouse-cursor: text;
                            clicked => { root.start-addr-edit(); }
                        }
                    }
                    Text {
                        text: root.shown-count + " items" + (root.sel-count > 0 ? ", " + root.sel-count + " selected" : "");
                        font-size: Design.font-body; font-weight: 700;
                        color: Design.text-primary;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        // Di layar sempit saat search terbuka, status
                        // disembunyikan (lebar 0) supaya field search
                        // tetap muat dan tidak terpotong di 520px.
                        width: root.search-open && root.width < 700px ? 0px : 180px;
                        visible: !(root.search-open && root.width < 700px);
                    }
                    Btn {
                        label: "Cari";
                        variant: "ghost"; small: true;
                        clicked => { root.open-search(); }
                    }
                    Rectangle {
                        width: root.search-open ? (root.width < 700px ? 140px : 220px) : 0px;
                        visible: root.search-open;
                        height: 36px;
                        background: Design.bg-input;
                        border-color: Design.border-focus;
                        border-width: 1px;
                        border-radius: Design.radius-sm;
                        clip: true;
                        search-input := TextInput {
                            x: 8px; width: parent.width - 34px; height: 100%;
                            text <=> root.search-text;
                            font-size: 13px;
                            color: Design.text-primary;
                            selection-foreground-color: white;
                            selection-background-color: Design.accent;
                            vertical-alignment: center;
                            edited => { root.search-edited(self.text); }
                            accepted => { root.search-accepted(); }
                        }
                        Rectangle {
                            x: parent.width - 26px; y: 8px; width: 20px; height: 20px;
                            Text {
                                text: "×";
                                font-size: 13px; font-weight: 700; color: Design.text-muted;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                            search-x-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close-search(); }
                            }
                        }
                    }
                }
            }

            // ---------- Toolbar ----------
            Rectangle {
                width: 100%; height: 40px;
                background: Design.app-bg;
                // Scroll horizontal di layar sempit (520px): semua
                // tombol tetap ada + label state utuh, digeser saja.
                Flickable {
                    width: 100%; height: 100%;
                    HorizontalLayout {
                        height: 100%;
                        spacing: 6px;
                        padding-left: 8px; padding-right: 8px;
                    Btn {
                        label: "Detail"; small: true;
                        variant: root.layout == "Vertical" ? "accent" : "secondary";
                        clicked => { root.set-layout("Vertical"); }
                    }
                    Btn {
                        label: "Daftar"; small: true;
                        variant: root.layout == "Horizontal" ? "accent" : "secondary";
                        clicked => { root.set-layout("Horizontal"); }
                    }
                    Btn {
                        label: "Thumb"; small: true;
                        variant: root.layout == "Thumbnail" ? "accent" : "secondary";
                        clicked => { root.set-layout("Thumbnail"); }
                    }
                    Btn {
                        label: "Tiles"; small: true;
                        variant: root.layout == "Tiles" ? "accent" : "secondary";
                        clicked => { root.set-layout("Tiles"); }
                    }
                    Btn {
                        label: "Split"; small: true;
                        variant: root.layout == "Split" ? "accent" : "secondary";
                        clicked => { root.set-layout("Split"); }
                    }
                    Rectangle { width: 1px; height: 24px; background: Design.separator; }
                    Btn {
                        label: "Sort: " + root.ex-sort; small: true;
                        clicked => { root.cycle-sort(); }
                    }
                    Btn {
                        label: root.ex-desc ? "↓ Z-A" : "↑ A-Z"; small: true;
                        clicked => { root.toggle-desc(); }
                    }
                    Btn {
                        label: "Group: " + root.ex-group; small: true;
                        clicked => { root.cycle-group(); }
                    }
                    Text {
                        text: "Mencari…";
                        font-size: 12px; color: Design.text-muted;
                        vertical-alignment: center;
                        visible: root.searching;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        label: "Kirim ke BATCH";
                        small: true; variant: "primary";
                        enabled: root.sel-count > 0;
                        clicked => { root.send-selected-to-batch(); }
                    }
                }
                }
            }

            // ---------- Body: sidebar + file area + preview ----------
            HorizontalLayout {
                width: 100%;
                vertical-stretch: 1;
                spacing: 0;

                // ----- Sidebar Quick Access (sembunyi bila < 700px) -----
                Rectangle {
                    width: root.width >= 700px ? 120px : 0px;
                    visible: root.width >= 700px;
                    background: Design.card-bg;
                    VerticalLayout {
                        width: 100%; height: 100%;
                        spacing: 0;
                        padding: 8px;
                        Text {
                            text: "QUICK ACCESS";
                            font-size: 11px; font-weight: 800; color: Design.text-muted;
                            letter-spacing: 1px;
                            height: 20px;
                        }
                        for i in 4 : Rectangle {
                            height: root.qa-paths[i] != "" ? 28px : 0px;
                            visible: root.qa-paths[i] != "";
                            background: qa-touch.has-hover ? Design.bg-hover : transparent;
                            border-radius: Design.radius-sm;
                            qa-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.nav-to-path(root.qa-paths[i]); }
                            }
                            HorizontalLayout {
                                width: 100%; height: 100%;
                                spacing: 4px;
                                padding-left: 6px; padding-right: 4px;
                                Text {
                                    text: root.qa-labels[i];
                                    font-size: 12px;
                                    color: root.cur-path == root.qa-paths[i] ? Design.accent : Design.text-primary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Rectangle {
                                    width: 16px; height: 16px;
                                    visible: qa-touch.has-hover;
                                    Text {
                                        text: "×";
                                        font-size: 12px; color: Design.text-muted;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: 100%; height: 100%;
                                    }
                                    qa-x-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.remove-qa(i); }
                                    }
                                }
                            }
                        }
                        HSeparator { }
                        Btn {
                            label: "⚙ Explorer";
                            small: true; variant: "ghost";
                            clicked => { root.open-settings-explorer(); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // ----- File area -----
                file-area := Rectangle {
                    horizontal-stretch: 1;
                    background: Design.app-bg;
                    VerticalLayout {
                        width: 100%; height: 100%;
                        spacing: 0;
                        // Header kolom (hanya layout Vertical).
                        Rectangle {
                            width: 100%;
                            height: root.layout == "Vertical" ? 24px : 0px;
                            visible: root.layout == "Vertical";
                            background: Design.card-bg;
                            HorizontalLayout {
                                width: 100%; height: 100%;
                                spacing: 8px;
                                padding-left: 8px; padding-right: 8px;
                                Text {
                                    text: "";
                                    width: 14px;
                                }
                                Text {
                                    text: "Nama";
                                    font-size: 11px; font-weight: 800; color: Design.text-muted;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "Ukuran";
                                    font-size: 11px; font-weight: 800; color: Design.text-muted;
                                    vertical-alignment: center;
                                    width: 70px; horizontal-alignment: right;
                                }
                                Text {
                                    text: "Tanggal";
                                    font-size: 11px; font-weight: 800; color: Design.text-muted;
                                    vertical-alignment: center;
                                    width: 90px;
                                }
                                Text {
                                    text: "Lokasi";
                                    font-size: 11px; font-weight: 800; color: Design.text-muted;
                                    vertical-alignment: center;
                                    width: root.searching-results ? 140px : 0px;
                                    visible: root.searching-results;
                                }
                                Rectangle { width: 24px; }
                            }
                        }
                        // Area scroll (5 layout, 1 terlihat).
                        Rectangle {
                            width: 100%;
                            vertical-stretch: 1;
                            // Empty state (di belakang Flickable).
                            Text {
                                text: root.searching-results ? "Tidak ada hasil untuk '" + root.search-text + "'" : "Folder ini kosong";
                                font-size: 13px; color: Design.text-muted;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                                visible: root.shown-count == 0;
                            }

                            // -- Vertical (baris detail) --
                            vert-flick := Flickable {
                                visible: root.layout == "Vertical";
                                width: 100%; height: 100%;
                                VerticalLayout {
                                    width: file-area.width;
                                    x: 0;
                                    spacing: 2px;
                                    padding: 4px;
                                    for pos in 32 : ExpRow {
                                    height: pos < root.view-order.length && root.view-names[root.view-order[pos]] != "" ? (root.view-headers[pos] != "" ? 44px : 26px) : 0px;
                                    visible: pos < root.view-order.length && root.view-names[root.view-order[pos]] != "";
                                    name: root.view-names[root.view-order[pos]];
                                    kind: root.view-kinds[root.view-order[pos]];
                                    size: root.view-sizes[root.view-order[pos]];
                                    date: root.view-dates[root.view-order[pos]];
                                    loc: root.view-locs[root.view-order[pos]];
                                    show-loc: root.searching-results;
                                    selected: (root.view-names[root.view-order[pos]] == root.sel-names[0] || root.view-names[root.view-order[pos]] == root.sel-names[1] || root.view-names[root.view-order[pos]] == root.sel-names[2] || root.view-names[root.view-order[pos]] == root.sel-names[3] || root.view-names[root.view-order[pos]] == root.sel-names[4] || root.view-names[root.view-order[pos]] == root.sel-names[5] || root.view-names[root.view-order[pos]] == root.sel-names[6] || root.view-names[root.view-order[pos]] == root.sel-names[7] || root.view-names[root.view-order[pos]] == root.sel-names[8] || root.view-names[root.view-order[pos]] == root.sel-names[9] || root.view-names[root.view-order[pos]] == root.sel-names[10] || root.view-names[root.view-order[pos]] == root.sel-names[11]);
                                    cut: root.cut-folder == root.cur-key && (root.view-names[root.view-order[pos]] == root.cut-names[0] || root.view-names[root.view-order[pos]] == root.cut-names[1] || root.view-names[root.view-order[pos]] == root.cut-names[2] || root.view-names[root.view-order[pos]] == root.cut-names[3] || root.view-names[root.view-order[pos]] == root.cut-names[4] || root.view-names[root.view-order[pos]] == root.cut-names[5] || root.view-names[root.view-order[pos]] == root.cut-names[6] || root.view-names[root.view-order[pos]] == root.cut-names[7] || root.view-names[root.view-order[pos]] == root.cut-names[8] || root.view-names[root.view-order[pos]] == root.cut-names[9] || root.view-names[root.view-order[pos]] == root.cut-names[10] || root.view-names[root.view-order[pos]] == root.cut-names[11]);
                                    header: root.view-headers[pos];
                                    renaming: root.renaming != "" && root.renaming == root.view-names[root.view-order[pos]];
                                    ext-len: root.view-exts[root.view-order[pos]].character-count;
                                    rename-draft <=> root.rename-draft;
                                    clicked => { root.select-toggle(root.view-names[root.view-order[pos]], root.view-kinds[root.view-order[pos]], root.view-exts[root.view-order[pos]], root.view-bases[root.view-order[pos]], root.view-sizes[root.view-order[pos]], root.view-dates[root.view-order[pos]], root.view-previews[root.view-order[pos]]); }
                                    open => { root.open-item(root.view-names[root.view-order[pos]], root.view-kinds[root.view-order[pos]], root.view-exts[root.view-order[pos]], root.searching-results ? root.sr-paths[pos] : root.cur-path + "\\" + root.view-names[root.view-order[pos]]); }
                                    menu => {
                                    if (!(root.view-names[root.view-order[pos]] == root.sel-names[0] || root.view-names[root.view-order[pos]] == root.sel-names[1] || root.view-names[root.view-order[pos]] == root.sel-names[2] || root.view-names[root.view-order[pos]] == root.sel-names[3] || root.view-names[root.view-order[pos]] == root.sel-names[4] || root.view-names[root.view-order[pos]] == root.sel-names[5] || root.view-names[root.view-order[pos]] == root.sel-names[6] || root.view-names[root.view-order[pos]] == root.sel-names[7] || root.view-names[root.view-order[pos]] == root.sel-names[8] || root.view-names[root.view-order[pos]] == root.sel-names[9] || root.view-names[root.view-order[pos]] == root.sel-names[10] || root.view-names[root.view-order[pos]] == root.sel-names[11])) {
                                    root.select-only(root.view-names[root.view-order[pos]], root.view-kinds[root.view-order[pos]], root.view-exts[root.view-order[pos]], root.view-bases[root.view-order[pos]], root.view-sizes[root.view-order[pos]], root.view-dates[root.view-order[pos]], root.view-previews[root.view-order[pos]]);
                                    }
                                    root.open-ctx(root.view-names[root.view-order[pos]], root.view-kinds[root.view-order[pos]], root.view-exts[root.view-order[pos]], root.view-bases[root.view-order[pos]], root.searching-results ? root.sr-paths[pos] : root.cur-path + "\\" + root.view-names[root.view-order[pos]], root.layout != "Thumbnail" && root.layout != "Tiles");
                                    }
                                    rename-commit => { root.commit-rename(); }
                                    rename-cancel => { root.cancel-rename(); }
                                    rename-edited(text) => { root.rename-draft = text; }
                                    }
                                    Rectangle {
                                    height: 300px;
                                    bg-touch-v := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.clear-selection(); }
                                    pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                    root.open-bg-ctx();
                                    }
                                    }
                                    }
                                    }
                                }
                            }

                            // -- Horizontal (kartu ringkas) --
                            Flickable {
                                visible: root.layout == "Horizontal";
                                width: 100%; height: 100%;
                                VerticalLayout {
                                    width: file-area.width;
                                    x: 0;
                                    spacing: 0;
                                    GridLayout {
                                        x: 0;
                                        width: file-area.width;
                                        spacing: 8px;
                                        padding: 8px;
                                        for pos in 32 : ExpCard {
                                    mode: "horizontal";
                                    row: floor(pos / 5);
                                    col: mod(pos, 5);
                                    width: pos < root.view-order.length && root.view-names[root.view-order[pos]] != "" ? 150px : 0px;
                                    height: pos < root.view-order.length && root.view-names[root.view-order[pos]] != "" ? 64px : 0px;
                                    visible: pos < root.view-order.length && root.view-names[root.view-order[pos]] != "";
                                    name: root.view-names[root.view-order[pos]];
                                    kind: root.view-kinds[root.view-order[pos]];
                                    ext: root.view-exts[root.view-order[pos]];
                                    selected: (root.view-names[root.view-order[pos]] == root.sel-names[0] || root.view-names[root.view-order[pos]] == root.sel-names[1] || root.view-names[root.view-order[pos]] == root.sel-names[2] || root.view-names[root.view-order[pos]] == root.sel-names[3] || root.view-names[root.view-order[pos]] == root.sel-names[4] || root.view-names[root.view-order[pos]] == root.sel-names[5] || root.view-names[root.view-order[pos]] == root.sel-names[6] || root.view-names[root.view-order[pos]] == root.sel-names[7] || root.view-names[root.view-order[pos]] == root.sel-names[8] || root.view-names[root.view-order[pos]] == root.sel-names[9] || root.view-names[root.view-order[pos]] == root.sel-names[10] || root.view-names[root.view-order[pos]] == root.sel-names[11]);
                                    cut: root.cut-folder == root.cur-key && (root.view-names[root.view-order[pos]] == root.cut-names[0] || root.view-names[root.view-order[pos]] == root.cut-names[1] || root.view-names[root.view-order[pos]] == root.cut-names[2] || root.view-names[root.view-order[pos]] == root.cut-names[3] || root.view-names[root.view-order[pos]] == root.cut-names[4] || root.view-names[root.view-order[pos]] == root.cut-names[5] || root.view-names[root.view-order[pos]] == root.cut-names[6] || root.view-names[root.view-order[pos]] == root.cut-names[7] || root.view-names[root.view-order[pos]] == root.cut-names[8] || root.view-names[root.view-order[pos]] == root.cut-names[9] || root.view-names[root.view-order[pos]] == root.cut-names[10] || root.view-names[root.view-order[pos]] == root.cut-names[11]);
                                    clicked => { root.select-toggle(root.view-names[root.view-order[pos]], root.view-kinds[root.view-order[pos]], root.view-exts[root.view-order[pos]], root.view-bases[root.view-order[pos]], root.view-sizes[root.view-order[pos]], root.view-dates[root.view-order[pos]], root.view-previews[root.view-order[pos]]); }
                                    open => { root.open-item(root.view-names[root.view-order[pos]], root.view-kinds[root.view-order[pos]], root.view-exts[root.view-order[pos]], root.searching-results ? root.sr-paths[pos] : root.cur-path + "\\" + root.view-names[root.view-order[pos]]); }
                                    menu => {
