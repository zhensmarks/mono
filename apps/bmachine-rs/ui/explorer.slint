e-name;
    property <string> preview-text: root.single-ext == ".docx" ? "(Preview for .docx: open with default app to view.)" : root.single-preview;

    // ----- sort / group / layout -----
    in-out property <string> ex-sort: "Name";
    in-out property <bool> ex-desc: false;
    in-out property <string> ex-group: "Date";
    in-out property <string> layout: "Vertical";
    in-out property <bool> local-only: false;

    // ----- search / address bar / rename / dialog / ctx -----
    in-out property <string> search-text: "";
    in-out property <bool> search-open: false;
    in-out property <bool> searching: false;
    in-out property <bool> addr-editing: false;
