// Windows — Komponen Window Sekunder Mandiri (OS Window Baru)
// Sesuai arsitektur C# (SpreadsheetWindow.axaml & CardListWindow.axaml)
// Dibuka saat pengguna mengklik tanda panah widget atau tombol "Buka Window Baru".

import { Design, Btn, SvgIcon, TextField } from "design.slint";
import { SpreadsheetComponent } from "spreadsheet.slint";
import { TrelloDetailPanel } from "trello-detail.slint";
import { RadialMenuView } from "radial.slint";
import { ToolboxView } from "modul.slint";

// ============================================================
// RADIAL MENU WINDOW — 320×320 transparent, topmost, cursor-centered.
// Mirrors C# RadialMenuWindow; screen positioning comes from Rust hook code.
// ============================================================
export component RadialMenuWindow inherits Window {
    title: "BMachine Radial Menu";
    width: 320px;
    height: 320px;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    default-font-family: Design.font-family;
    callback close-window();
    callback execute-script(string);
    callback toast(string);
    callback reset-wheel();
    callback release-execute();
    callback open-toolbox(string);
    in-out property <int> doc-tab-count: 1;
    // Gaya + geometri ring radial (lihat ui/radial.slint) — didorong
    // Rust saat radial dibuka / pengaturan berubah.
    in-out property <string> radial-style: "glass";
    in-out property <int> sector-count: 8;
    in-out property <[string]> wedge-cmds;
    in-out property <[string]> arc-cmds;
    in-out property <string> divider-cmds;
    in-out property <[length]> btn-x;
    in-out property <[length]> btn-y;

    wheel := RadialMenuView {
        x: 0; y: 0; width: 320px; height: 320px;
        doc-tab-count: root.doc-tab-count;
        radial-style: root.radial-style;
        sector-count: root.sector-count;
        wedge-cmds: root.wedge-cmds;
        arc-cmds: root.arc-cmds;
        divider-cmds: root.divider-cmds;
        btn-x: root.btn-x;
        btn-y: root.btn-y;
        back() => { root.close-window(); }
        toast(message) => { root.toast(message); }
        execute-script(name) => { root.execute-script(name); }
        open-toolbox(tab) => { root.open-toolbox(tab); }
    }

    reset-wheel() => { wheel.reset(); }
    release-execute() => { wheel.release-execute(); }
}

// ============================================================
// 1. TOOLBOX WINDOW — Window Mandiri Toolbox (C# ToolboxWindow:
//    1024×730, Min 680×580, CenterScreen). Dibuka dari radial
//    (submenu TOOLBOX / eksekusi psdbucin). Isi = ToolboxView yang
//    sama dengan overlay lama, hanya wadahnya window OS.
// ============================================================
export component ToolboxWindow inherits Window {
    title: "BMachine Toolbox";
    width: 1024px;
    height: 730px;
    // C# Min 680x580 tidak bisa dipasang bersama width/height di
    // Slint (satu Window tidak boleh punya width + min-width) —
    // ukuran buka 1024x730 tetap sama; lantai resize tidak ditegakkan.
    background: Design.app-bg;
    default-font-family: Design.font-family;

    callback close-window();
    callback toast(string);
    in-out property <string> tool-tab: "MantraNama";

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Custom Titlebar Toolbox Window
        Rectangle {
            height: 38px;
            background: Design.surface-elevated;
            border-color: Design.separator;
            border-width: 0.5px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                Text {
                    text: "BMachine Toolbox";
                    font-size: Design.font-body;
                    font-weight: 800;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // Tombol Tutup Window
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    background: tb-close-touch.has-hover ? Design.status-danger : transparent;
                    border-radius: Design.radius-sm;

                    tb-close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-window(); }
                    }

                    Text {
                        text: "×";
                        font-size: 18px;
                        font-weight: 700;
                        color: tb-close-touch.has-hover ? #ffffff : Design.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }

        // Isi Toolbox (komponen yang sama dengan overlay lama).
        tb := ToolboxView {
            width: 100%;
            vertical-stretch: 1;
            tool-tab <=> root.tool-tab;
            back() => { root.close-window(); }
            toast(text) => { root.toast(text); }
        }
    }
}

// ============================================================
// 2. REPORT BUG DIALOG — Window "Laporkan Bug" (C#
//    Views/Dialogs/MantraData/ReportBugDialog: 560 lebar,
//    CenterOwner, tanpa dekorasi). Dibuka dari flyout profil.
// ============================================================
export component ReportBugDialog inherits Window {
    title: "Laporkan Bug";
    width: 560px;
    height: 400px;
    background: Design.app-bg;
    no-frame: true;
    default-font-family: Design.font-family;

    callback close-window();
    callback send-report(string, string);
    callback toast(string);

    in-out property <string> summary-text: "";
    in-out property <string> detail-text: "";

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Titlebar: judul + tombol tutup (drag via titlebar tidak
        // didukung Slint tanpa chrome kustom; tutup via × / Batal).
        Rectangle {
            height: 38px;
            background: Design.surface-elevated;
            border-color: Design.separator;
            border-width: 0.5px;

            HorizontalLayout {
                padding-left: 22px;
                padding-right: 14px;
                spacing: 8px;

                Text {
                    text: "Laporkan Bug";
                    font-size: 16px;
                    font-weight: 600;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    background: bug-close-touch.has-hover ? Design.status-danger : transparent;
                    border-radius: Design.radius-sm;

                    bug-close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-window(); }
                    }

                    Text {
                        text: "×";
                        font-size: 18px;
                        font-weight: 700;
                        color: bug-close-touch.has-hover ? #ffffff : Design.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }

        VerticalLayout {
            padding: 22px;
            spacing: 0;

            Text {
                text: "Beri tahu kami apa yang terjadi. Laporan ini dikirim ke tim Project & Bug.";
                font-size: 12px;
                color: Design.text-secondary;
                wrap: word-wrap;
                height: 36px;
            }

            Text {
                text: "Ringkasan";
                font-size: 12px;
                color: Design.text-muted;
                height: 18px;
            }

            TextField {
                height: 36px;
                text <=> root.summary-text;
                placeholder: "Judul singkat: 'Tombol Ganti Semua tidak merespons'";
            }

            Text {
                text: "Detail";
                font-size: 12px;
                color: Design.text-muted;
                height: 18px;
            }

            Rectangle {
                height: 110px;
                background: Design.bg-input;
                border-color: Design.border-default;
                border-width: 1px;
                border-radius: Design.radius-sm;
                clip: true;

                TextInput {
                    x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px;
                    text <=> root.detail-text;
                    font-size: 13px;
                    color: Design.text-primary;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                padding-top: 18px;

                Rectangle {
                    width: 90px;
                    height: 36px;
                    Btn {
                        width: 100%; height: 100%;
                        label: "Batal";
                        variant: "secondary";
                        clicked => { root.close-window(); }
                    }
                }
                Rectangle {
                    width: 110px;
                    height: 36px;
                    Btn {
                        width: 100%; height: 100%;
                        label: "Kirim";
                        variant: "primary";
                        clicked => {
                            if (root.summary-text == "") {
                                root.toast("Isi ringkasan dulu");
                            } else {
                                root.send-report(root.summary-text, root.detail-text);
                            }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================
// 3. SPREADSHEET WINDOW — Window Mandiri Editor Spreadsheet
// ============================================================
export component SpreadsheetWindow inherits Window {
    title: "BMachine — Spreadsheet Editor";
    width: 1000px;
    height: 600px;
    background: Design.app-bg;
    default-font-family: Design.font-family;

    callback close-window();
    callback toast(string);
    // Guard + draft (Rust): teruskan ke SpreadsheetComponent.
    callback sheet-cell-edited(int, int, string, string);
    callback sheet-save();
    callback sheet-refresh();
    // Data grid + nilai asli + status guard/draft (diisi Rust saat window dibuat).
    // Default KOSONG (27 Nov 2026, keputusan abeng: default publish harus bersih).
    in-out property <[string]> col-a: [];
    in-out property <[string]> col-b: [];
    in-out property <[string]> col-c: [];
    in-out property <[string]> col-d: [];
    in-out property <[string]> col-e: [];
    in-out property <[string]> col-f: [];
    in-out property <[string]> col-a-orig: [];
    in-out property <[string]> col-b-orig: [];
    in-out property <[string]> col-c-orig: [];
    in-out property <[string]> col-d-orig: [];
    in-out property <[string]> col-e-orig: [];
    in-out property <[string]> col-f-orig: [];
    in-out property <bool> sheet-has-draft: false;
    in-out property <int> sheet-draft-count: 0;
    in-out property <string> sheet-status-text: "0 baris · Belum terhubung ke Google Sheets";
    in-out property <string> sheet-guard-result: "";
    // Drag window (C# SpreadsheetWindow.axaml: drag handle 46px di kiri,
    // Margin 0,0,420,0 — kanan 420px bebas untuk toolbar/tombol close).
    callback move-window(length, length);

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Custom Titlebar Spreadsheet Window — 46px (C# drag handle
        // Height 46); area drag hanya kiri (lebar − 420px), tombol
        // close di kanan-atas di luar area drag.
        Rectangle {
            height: 46px;
            background: Design.surface-elevated;
            border-color: Design.separator;
            border-width: 0.5px;

            sheet-drag := TouchArea {
                x: 0; y: 0;
                width: max(0px, parent.width - 420px);
                height: 100%;
                mouse-cursor: pointer;
                property <length> press-x: 0px;
                property <length> press-y: 0px;
                property <bool> dragging: false;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        self.press-x = self.mouse-x;
                        self.press-y = self.mouse-y;
                        self.dragging = true;
                    } else if (ev.kind == PointerEventKind.up) {
                        self.dragging = false;
                    } else if (ev.kind == PointerEventKind.move && self.dragging) {
                        root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
                    }
                }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    SvgIcon {
                        name: "layers";
                        size: 16px;
                        icon-color: Design.cat-points;
                    }
                }

                Text {
                    text: "BMachine — Spreadsheet Editor";
                    font-size: Design.font-body;
                    font-weight: 800;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // Tombol Tutup Window
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    background: close-touch.has-hover ? Design.status-danger : transparent;
                    border-radius: Design.radius-sm;

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-window(); }
                    }

                    Text {
                        text: "×";
                        font-size: 18px;
                        font-weight: 700;
                        color: close-touch.has-hover ? #ffffff : Design.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }

        // Isi Spreadsheet
        SpreadsheetComponent {
            is-standalone: true;
            col-a <=> root.col-a;
            col-b <=> root.col-b;
            col-c <=> root.col-c;
            col-d <=> root.col-d;
            col-e <=> root.col-e;
            col-f <=> root.col-f;
            col-a-orig <=> root.col-a-orig;
            col-b-orig <=> root.col-b-orig;
            col-c-orig <=> root.col-c-orig;
            col-d-orig <=> root.col-d-orig;
            col-e-orig <=> root.col-e-orig;
            col-f-orig <=> root.col-f-orig;
            has-draft <=> root.sheet-has-draft;
            draft-count <=> root.sheet-draft-count;
            status-text <=> root.sheet-status-text;
            guard-result <=> root.sheet-guard-result;
            cell-edited(r, c, orig, val) => { root.sheet-cell-edited(r, c, orig, val); }
            save-changes() => { root.sheet-save(); }
            refresh-data() => { root.sheet-refresh(); }
            toast(msg) => { root.toast(msg); }
            close-view() => { root.close-window(); }
        }
    }
}

// ============================================================
// 2. CARD LIST WINDOW — Window Mandiri Daftar Kartu Trello
// ============================================================
export component CardListWindow inherits Window {
    title: "BMachine — Trello Cards";
    // C# CardListWindow.axaml: 450x600, CenterScreen (posisi dihitung
    // Rust via center_over_main). Isi tetap list + splitter 6px +
    // panel detail 400 (UnifiedTrelloView.axaml:13-17) — hanya ukuran
    // yang disamakan, struktur tidak diubah.
    width: 450px;
    height: 600px;
    background: Design.app-bg;
    default-font-family: Design.font-family;

    in-out property <string> category: "EDITING";
    in-out property <color> category-accent: Design.cat-editing;
    in-out property <string> search-query: "";
    // -1 = belum ada kartu dipilih → tampil daftar (C# compact mode:
    // IsListScreenVisible). >= 0 = kartu dipilih → tampil detail
    // layar penuh (IsPanelScreenVisible). Window 450px selalu compact
    // (CompactThreshold 800 di C#) — daftar/detail TIDAK PERNAH
    // berdampingan di window ini.
    in-out property <int> selected-idx: -1;

    // Data Kartu Trello (kosong — diisi Rust saat sync Trello pertama).
    in-out property <[string]> card-titles: [];
    in-out property <[string]> card-subs: [];
    in-out property <[string]> card-due: [];
    in-out property <[bool]> card-done: [];

    callback close-window();
    callback toggle-done(int);
    callback toast(string);

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Custom Titlebar Card List Window
        Rectangle {
            height: 38px;
            background: Design.surface-elevated;
            border-color: Design.separator;
            border-width: 0.5px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                Rectangle {
                    width: 8px; height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: root.category-accent;
                }

                Text {
                    text: "Trello — " + root.category + " (" + root.card-titles.length + " Kartu)";
                    font-size: Design.font-body;
                    font-weight: 800;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // Tombol Tutup Window
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    background: card-close-touch.has-hover ? Design.status-danger : transparent;
                    border-radius: Design.radius-sm;

                    card-close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-window(); }
                    }

                    Text {
                        text: "×";
                        font-size: 18px;
                        font-weight: 700;
                        color: card-close-touch.has-hover ? #ffffff : Design.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }

        // Konten: daftar ATAU detail (compact, C# UnifiedTrelloView:
        // CompactThreshold 800; window 450px selalu compact — daftar
        // tampil saat belum ada kartu dipilih, detail layar penuh saat
        // ada kartu dipilih). `if` dipakai, bukan `visible` (visible:
        // false tetap makan ruang di layout Slint).
        HorizontalLayout {
            padding: Design.space-md;
            spacing: Design.space-md;

            // Kolom Kiri: Search & Daftar Kartu
            if root.selected-idx < 0 : VerticalLayout {
                horizontal-stretch: 1;
                spacing: Design.space-sm;

                // Search Bar
                Rectangle {
                    height: 32px;
                    border-radius: Design.radius-sm;
                    background: Design.bg-input;
                    border-color: Design.border-default;
                    border-width: 1px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            SvgIcon {
                                name: "search";
                                size: 13px;
                                icon-color: Design.text-muted;
                            }
                        }
                        TextInput {
                            text <=> root.search-query;
                            font-size: Design.font-body;
                            color: Design.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }

                // List Kartu
                Rectangle {
                    vertical-stretch: 1;
                    background: Design.card-bg;
                    border-color: Design.separator;
                    border-width: 1px;
                    border-radius: Design.radius-md;
                    clip: true;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;

                        for title[idx] in root.card-titles : Rectangle {
                            height: 52px;
                            border-radius: Design.radius-sm;
                            background: root.selected-idx == idx ? Design.accent-subtle : (row-touch.has-hover ? Design.bg-hover : transparent);
                            border-color: root.selected-idx == idx ? Design.accent : transparent;
                            border-width: 1px;

                            row-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.selected-idx = idx; }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;

                                // Checkbox selesai
                                Rectangle {
                                    width: 18px; height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: root.card-done[idx] ? root.category-accent : transparent;
                                    border-color: root.card-done[idx] ? root.category-accent : Design.separator;
                                    border-width: 1.5px;

                                    chk-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.card-done[idx] = !root.card-done[idx];
                                            root.toggle-done(idx);
                                        }
                                    }

                                    if root.card-done[idx] : SvgIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        name: "check";
                                        size: 12px;
                                        icon-color: #ffffff;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: title;
                                        font-size: Design.font-body;
                                        font-weight: 700;
                                        color: Design.text-primary;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.card-subs[idx];
                                        font-size: Design.font-caption;
                                        color: Design.text-secondary;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    text: root.card-due[idx];
                                    font-size: Design.font-caption;
                                    font-weight: 600;
                                    color: root.category-accent;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            // Kolom Kanan: Panel Detail (layar penuh saat ada kartu dipilih)
            if root.selected-idx >= 0 : Rectangle {
                horizontal-stretch: 1;
                background: Design.surface-elevated;
                border-color: Design.separator;
                border-width: 1px;
                border-radius: Design.radius-md;
                clip: true;

                TrelloDetailPanel {
                    x: 0; y: 0; width: 100%; height: 100%;
                    card-title: root.card-titles[root.selected-idx];
                    event-date: root.card-due[root.selected-idx];
                    due-text: "Due: " + root.card-due[root.selected-idx];
                    is-manual: false;
                    category-label: root.category;
                    accent: root.category-accent;
                    done: root.card-done[root.selected-idx];
                    description: "Edit pas foto sekolah — crop, centering kepala di guide, logo terlihat rapi dan warna seimbang.";
                    close() => { root.selected-idx = -1; root.toast("Detail ditutup"); }
                }
            }
        }
    }
}

// ============================================================
// 4. DYNAMIC BAR WINDOW — Floating mini-bar ala Dynamic Island
// (abeng 27 Nov 19:52): angka widget dashboard (EDITING /
// REVISION / LATE / POINTS) + notifikasi kartu masuk + poin
// bertambah — tanpa harus buka window utama.
// Window OS terpisah, no-frame, always-on-top, bisa di-drag.
// Klik angka → window utama ke tampilan terkait; klik lonceng
// (atau area kosong bar) → mengembang menampilkan notifikasi;
// klik notifikasi → tampilan terkait; klik kanan → tutup bar
// (dibuka lagi dari flyout profil / Settings).
// Angka HARUS dari sumber yang sama dengan widget dashboard
// (Rust menyalin properti AppWindow tiap 2 detik — bukan angka
// baru; lihat main.rs `bar sync timer`).
// ============================================================
// ===== Dynamic Bar — NOTCH HIDUP (rework 27 Nov 2026) =====
// Referensi: Nusa (rama2555.github.io/nusa) — "a living notch
// for Windows", native Rust. Keadaan diam = pill hitam kecil di
// atas-tengah layar berisi maskot sepasang mata putih bercahaya
// (TIDAK ada angka yang terlihat langsung). Hover → mengembang
// menampilkan status widget dashboard + notifikasi; mouse
// menjauh → mengecil lagi (Nusa: "Hover the notch to open it.
// Move away and it closes.").
// Mata berkedip (timer), pupil mengikuti kursor, tertidur
// setelah 45 detik tanpa aktivitas, menyapa (mata membesar)
// saat user kembali — perilaku maskot Nusa.
// Mode "pet": maskot jadi avatar bulat yang bisa di-drag ke mana
// saja dan bergerak sendiri (idle wander dari timer Rust).
// Voice: maskot bicara via SAPI Windows (Rust, src/voice.rs) —
// suara beneran, bukan bubble teks.
// Notch sendiri selalu hitam (ala Nusa) di semua tema; panel
// mengembang mengikuti token Design aktif (sync_design_to_bar).
// Satu mata maskot. Gaya mata (eye-style) — "nusa" (oval putih
// bercahaya + pupil hitam, bawaan), "baymax" (titik bundar tanpa
// pupil — titiknya sendiri yang bergeser mengikuti kursor),
// "bulat" (lingkaran putih besar + pupil, tanpa glow). Ukuran
// mata (eye-w/eye-h) tetap dari mood window (idle/happy/
// surprised/tidur/kedip) supaya semua animasi yang sudah ada
// tetap jalan di semua gaya.
component MascotEye inherits Rectangle {
    in property <length> eye-w: 14px;
    in property <length> eye-h: 18px;
    in property <length> pupil-dx: 0px;
    in property <length> pupil-dy: 0px;
    in property <bool> eye-closed: false;
    in property <string> eye-style: "nusa";

    // "bulat" = lingkaran: diameter = sisi terpanjang mata.
    property <length> dot-w: root.eye-style == "bulat" ? max(root.eye-w, root.eye-h) : root.eye-w;
    property <length> dot-h: root.eye-style == "bulat" ? max(root.eye-w, root.eye-h) : root.eye-h;

    width: root.eye-w + 10px;
    height: 34px;

    // Glow putih di belakang mata — hanya gaya Nusa.
    if root.eye-style == "nusa" : Rectangle {
        width: root.eye-w + 8px;
        height: root.eye-h + 8px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 12px;
        background: #ffffff;
        opacity: 0.14;
    }
    // Bola mata putih. Gaya Baymax: titiknya sendiri bergeser
    // mengikuti kursor (tidak ada pupil).
    Rectangle {
        width: root.dot-w;
        height: root.dot-h;
        x: (parent.width - self.width) / 2 + (root.eye-style == "baymax" ? root.pupil-dx : 0px);
        y: (parent.height - self.height) / 2 + (root.eye-style == "baymax" ? root.pupil-dy : 0px);
        border-radius: root.dot-w / 2;
        background: #ffffff;
        // Pupil hitam — hilang saat mata terpejam/tidur; gaya
        // Baymax tidak punya pupil.
        if !root.eye-closed && root.eye-style != "baymax" : Rectangle {
            width: 7px;
            height: 9px;
            x: (parent.width - self.width) / 2 + root.pupil-dx;
            y: (parent.height - self.height) / 2 + root.pupil-dy;
            border-radius: 4px;
            background: #0d0d0d;
        }
    }
}

// Sepasang mata maskot — dua MascotEye + garis penghubung gaya
// Baymax (hanya bila eye-style == "baymax"): garis putih dari
// tengah mata kiri ke tengah mata kanan, di belakang mata.
// (Di GIF referensi titik + garisnya hitam di atas latar terang;
// di atas pill hitam BMachine warnanya dibalik jadi putih supaya
// terbaca — lihat DESIGN_SYSTEM.md §21.)
component MascotEyes inherits Rectangle {
    in property <length> eye-w: 14px;
    in property <length> eye-h: 18px;
    in property <length> pupil-dx: 0px;
    in property <length> pupil-dy: 0px;
    in property <bool> eye-closed: false;
    in property <string> eye-style: "nusa";
    in property <length> gap: 12px;

    width: 2 * (root.eye-w + 10px) + root.gap;
    height: 34px;

    if root.eye-style == "baymax" : Rectangle {
        x: (root.eye-w + 10px) / 2;
        y: (parent.height - 2px) / 2;
        width: (root.eye-w + 10px) + root.gap;
        height: 2px;
        background: #ffffff;
    }
    HorizontalLayout {
        spacing: root.gap;
        MascotEye {
            eye-w: root.eye-w;
            eye-h: root.eye-h;
            pupil-dx: root.pupil-dx;
            pupil-dy: root.pupil-dy;
            eye-closed: root.eye-closed;
            eye-style: root.eye-style;
        }
        MascotEye {
            eye-w: root.eye-w;
            eye-h: root.eye-h;
            pupil-dx: root.pupil-dx;
            pupil-dy: root.pupil-dy;
            eye-closed: root.eye-closed;
            eye-style: root.eye-style;
        }
    }
}

// Slider volume OS di panel mengembang (ala overlay volume
// Nusa). Nilai 0..1; drag/klik di track langsung mengubahnya.
// `changed` dipanggil tiap gerakan — Rust men-debounce ke OS.
component VolumeSlider inherits Rectangle {
    in-out property <float> value: 0.5;
    in property <bool> enabled: true;
    callback changed(float);

    property <bool> pressed: false;
    height: 28px;

    // Track.
    Rectangle {
        width: 100%;
        height: 6px;
        y: (parent.height - self.height) / 2;
        border-radius: 3px;
        background: Design.separator;
    }
    // Fill (level saat ini).
    Rectangle {
        width: parent.width * root.value;
        height: 6px;
        y: (parent.height - self.height) / 2;
        border-radius: 3px;
        background: root.enabled ? Design.accent : Design.text-muted;
    }
    // Thumb.
    Rectangle {
        width: 14px;
        height: 14px;
        x: clamp(parent.width * root.value - 7px, 0px, parent.width - 14px);
        y: (parent.height - self.height) / 2;
        border-radius: 7px;
        background: #ffffff;
        border-color: root.enabled ? Design.accent : Design.text-muted;
        border-width: 1px;
    }
    slider-touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        enabled: root.enabled;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                root.pressed = true;
                root.value = clamp(self.mouse-x / self.width, 0, 1);
                root.changed(root.value);
            } else if (ev.kind == PointerEventKind.up) {
                root.pressed = false;
            } else if (ev.kind == PointerEventKind.cancel) {
                root.pressed = false;
            } else if (ev.kind == PointerEventKind.move && root.pressed) {
                root.value = clamp(self.mouse-x / self.width, 0, 1);
                root.changed(root.value);
            }
        }
    }
}

export component DynamicBarWindow inherits Window {
    title: "BMachine — Dynamic Bar";
    width: root.expanded ? 560px : (root.bar-mode == "pet" ? 84px : 150px);
    height: root.expanded ? root.expanded-height : root.pill-h;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    default-font-family: Design.font-family;

    callback close-window();
    callback move-window(length, length);
    callback save-position();
    callback open-category(string);
    callback open-notification(int);
    callback open-dashboard();
    callback expanded-changed(bool);
    callback volume-changed(float);
    callback volume-mute-clicked();

    in-out property <string> stat-editing: "0";
    in-out property <string> stat-revision: "0";
    in-out property <string> stat-late: "0";
    in-out property <string> stat-points: "0";
    in-out property <int> notif-count: 0;
    in-out property <[string]> notif-titles: [];
    in-out property <[string]> notif-subs: [];
    in-out property <[string]> notif-kinds: [];
    in-out property <[string]> notif-cats: [];
    in-out property <bool> expanded: false;
    // Mode notch (pill atas-tengah, posisi tetap) atau pet
    // (avatar bulat bebas, bisa di-drag + wander sendiri).
    in-out property <string> bar-mode: "notch";
    // Gaya mata maskot ("nusa" | "baymax" | "bulat") — dari
    // Settings → Appearance → Notch, DB Settings.Notch.EyeStyle.
    // Berlaku ke mata notch DAN mata blob pet bawaan (bukan
    // sprite PetDex — sprite adalah wajahnya sendiri).
    in-out property <string> eye-style: "nusa";
    // True saat mouse di dalam window (dipakai Rust: pet tidak
    // wander saat sedang di-hover).
    in-out property <bool> pet-hovering: false;
    // Volume OS (panel mengembang; Windows: Core Audio,
    // Linux: pactl/wpctl; bila tidak ada → slider nonaktif).
    in-out property <float> volume-f: 0.5;
    in-out property <bool> volume-muted: false;
    in-out property <bool> volume-available: true;
    // Mood maskot (diisi Rust dari event terakhir; "idle" bila
    // tidak ada): "idle" | "happy" | "surprised". Tidur dan
    // sapa dihitung sisi Slint (effective-mood di bawah).
    in-out property <string> pet-mood: "idle";
    // Pet PetDex aktif (mode pet saja): sprite sheet + frame saat
    // ini. Kosong = blob bawaan. Geometri frame (ukuran tampil
    // satu frame + jumlah kolom/baris atlas) diisi Rust dari sheet
    // yang sudah di-decode — frame 192×208 asli, tampil setinggi
    // pill pet (84px), lebar ikut rasio frame.
    in-out property <image> pet-sprite;
    in-out property <bool> pet-sprite-active: false;
    in-out property <int> pet-frame-col: 0;
    in-out property <int> pet-frame-row: 0;
    in-out property <length> pet-frame-w: 77px;
    in-out property <length> pet-frame-h: 84px;
    in-out property <int> pet-sheet-cols: 8;
    in-out property <int> pet-sheet-rows: 9;
    // Opacity sprite — selalu 1 (tidak di-fade antar state: state
    // berbalik Idle ↔ Running tiap langkah wander, fade akan
    // menahan sprite di opacity 0; lihat komentar timer frame
    // di main.rs).
    in-out property <float> pet-sprite-opacity: 1;

    // Tinggi pill dan panel mengembang.
    property <length> pill-h: root.bar-mode == "pet" ? 84px : 32px;
    property <length> pill-w: root.bar-mode == "pet" ? 84px : 150px;
    // Panel: padding 8 + baris chip 40 + baris volume 36 + baris
    // notifikasi maks 5 × 40 (atau 40 bila kosong) + footer 36
    // + padding 8.
    property <length> panel-h: 128px + max(1, min(root.notif-titles.length, 5)) * 40px;
    property <length> expanded-height: root.pill-h + 8px + root.panel-h;

    // --- Maskot: mata ---
    property <bool> blinking: false;
    property <bool> sleeping: false;
    property <bool> greeting: false;
    // Penghitung hover: tiap TouchArea di window ini menambah 1
    // saat di-hover, kurang 1 saat ditinggal. Panel hanya
    // menutup bila penghitung 0 (mouse benar-benar di luar
    // window) — supaya panel tidak menutup saat mouse pindah
    // dari notch ke chip/baris di dalam panel.
    property <int> hover-hold: 0;
    changed hover-hold => { root.pet-hovering = root.hover-hold > 0; }

    // Mood efektif maskot (bahasa ekspresi blob, ref
    // pet-ref-1.jpg): tidur → sleepy; sapa saat kembali →
    // happy; selebihnya mood dari Rust (idle/happy/surprised).
    // Semua transisi mata + mulut di-interpolasi (SYARAT
    // TEGAS abeng: gerakan pet harus smooth, jangan lompat).
    property <string> effective-mood: root.sleeping ? "sleepy" : (root.greeting ? "happy" : root.pet-mood);
    property <length> eye-w: root.effective-mood == "surprised" ? 22px : (root.bar-mode == "pet" ? 20px : 14px);
    property <length> eye-h: root.sleeping || root.blinking ? 2px : (root.effective-mood == "happy" ? (root.bar-mode == "pet" ? 8px : 12px) : (root.effective-mood == "surprised" ? (root.bar-mode == "pet" ? 30px : 22px) : (root.bar-mode == "pet" ? 24px : 18px)));
    animate eye-h { duration: 250ms; easing: ease-in-out; }
    animate eye-w { duration: 250ms; easing: ease-in-out; }
    // Mulut blob (hanya mode pet — pill notch 32px terlalu
    // pendek): idle garis tipis, happy senyum lebar,
    // surprised "o" kecil, sleepy garis sangat tipis.
    property <length> mouth-w: root.effective-mood == "happy" ? 22px : (root.effective-mood == "surprised" ? 10px : (root.effective-mood == "sleepy" ? 8px : 14px));
    property <length> mouth-h: root.effective-mood == "happy" ? 11px : (root.effective-mood == "surprised" ? 13px : (root.effective-mood == "sleepy" ? 2px : 3px));
    property <length> mouth-r: root.effective-mood == "surprised" ? 6px : 5px;
    // Pusat pill (untuk arah pupil) — berubah saat mengembang:
    // notch mengembang = pill 150px di tengah window 560px.
    property <length> pill-cx: root.expanded ? (root.bar-mode == "pet" ? 50px : 280px) : (root.bar-mode == "pet" ? 42px : 75px);
    property <length> pill-cy: root.bar-mode == "pet" ? 42px : 16px;
    property <length> pupil-dx: root.hover-hold > 0 ? clamp((bar-touch.mouse-x - root.pill-cx) / 60px, -1, 1) * 3px : 0px;
    property <length> pupil-dy: root.hover-hold > 0 ? clamp((bar-touch.mouse-y - root.pill-cy) / 40px, -1, 1) * 2px : 0px;

    // Kedip tiap ~3,4 detik (tutup 140ms).
    blink-timer := Timer {
        interval: 3400ms;
        running: true;
        triggered => {
            root.blinking = true;
            blink-off.restart();
        }
    }
    blink-off := Timer {
        interval: 140ms;
        triggered => { root.blinking = false; }
    }
    // Tidur setelah 45 detik tanpa hover; bangun + sapa
    // (mata membesar 1,6 detik) saat user kembali.
    sleep-timer := Timer {
        interval: 45s;
        running: true;
        triggered => { root.sleeping = true; }
    }
    greet-timer := Timer {
        interval: 1600ms;
        triggered => { root.greeting = false; }
    }
    // Jeda tutup: panel menutup 400ms setelah mouse keluar.
    close-timer := Timer {
        interval: 400ms;
        triggered => {
            if (root.hover-hold <= 0) {
                root.expanded = false;
            }
        }
    }

    changed expanded => { root.expanded-changed(root.expanded); }

    // State drag bersama — hanya mode pet yang bisa di-drag
    // (notch diam di atas-tengah seperti Nusa).
    property <length> drag-press-x: 0px;
    property <length> drag-press-y: 0px;
    property <bool> drag-pressed: false;
    property <bool> drag-dragging: false;

    // Latar sentuh seluruh window (paling bawah): hover →
    // mengembang; klik area kosong → buka dashboard; klik
    // kanan → tutup bar.
    bar-touch := TouchArea {
        x: 0; y: 0; width: 100%; height: 100%;
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover) {
                root.hover-hold += 1;
                root.expanded = true;
                root.sleeping = false;
                root.greeting = true;
                greet-timer.restart();
                sleep-timer.restart();
            } else {
                root.hover-hold -= 1;
                if (root.hover-hold <= 0) {
                    root.hover-hold = 0;
                    close-timer.restart();
                }
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                root.drag-press-x = self.mouse-x;
                root.drag-press-y = self.mouse-y;
                root.drag-pressed = true;
                root.drag-dragging = false;
            } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                if (root.drag-dragging) {
                    root.save-position();
                } else {
                    root.open-dashboard();
                }
                root.drag-pressed = false;
                root.drag-dragging = false;
            } else if (ev.kind == PointerEventKind.cancel) {
                root.drag-pressed = false;
                root.drag-dragging = false;
            } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                    root.drag-dragging = true;
                }
                if (root.drag-dragging) {
                    root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                }
            } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.close-window();
            }
        }
    }

    VerticalLayout {
        padding: 0;
        spacing: 8px;

        // ----- Pill notch / badan pet (hitam, mata putih) -----
        // Pet PetDex aktif (mode pet): latar hitam blob hilang —
        // sprite-nya sendiri yang menentukan bentuk (latar sheet
        // transparan, seperti PetDex Desktop).
        Rectangle {
            width: root.pill-w;
            x: root.expanded ? (root.bar-mode == "pet" ? 8px : (parent.width - root.pill-w) / 2) : 0px;
            height: root.pill-h;
            background: (root.pet-sprite-active && root.bar-mode == "pet") ? transparent : #0d0d0d;
            border-color: root.notif-count > 0 ? Design.accent : #ffffff26;
            border-width: (root.pet-sprite-active && root.bar-mode == "pet") ? 0px : 1px;
            border-radius: root.bar-mode == "pet" ? 42px : 16px;

            // Sprite PetDex — atlas utuh di dalam clip 84×84,
            // digeser per frame (kolom/baris dari Rust). Satu
            // frame tampil setinggi pill; lebar ikut rasio frame.
            if root.pet-sprite-active && root.bar-mode == "pet" : Rectangle {
                width: 100%;
                height: 100%;
                clip: true;
                Image {
                    source: root.pet-sprite;
                    width: root.pet-frame-w * root.pet-sheet-cols;
                    height: root.pet-frame-h * root.pet-sheet-rows;
                    x: -root.pet-frame-col * root.pet-frame-w;
                    y: -root.pet-frame-row * root.pet-frame-h;
                    opacity: root.pet-sprite-opacity;
                    animate opacity { duration: 200ms; easing: ease-in-out; }
                }
            }

            // Wajah maskot blob (hanya bila tidak ada sprite
            // PetDex aktif): mata + mulut putih, di tengah pill.
            // Mode notch hanya mata (pill 32px); mode pet mata +
            // mulut.
            if !root.pet-sprite-active : VerticalLayout {
                width: 100%;
                y: (parent.height - self.height) / 2;
                alignment: center;
                spacing: root.bar-mode == "pet" ? 7px : 0px;
                HorizontalLayout {
                    alignment: center;
                    MascotEyes {
                        eye-w: root.eye-w;
                        eye-h: root.eye-h;
                        pupil-dx: root.pupil-dx;
                        pupil-dy: root.pupil-dy;
                        eye-closed: root.sleeping || root.blinking || root.effective-mood == "happy" || root.effective-mood == "sleepy";
                        eye-style: root.eye-style;
                        gap: root.bar-mode == "pet" ? 14px : 12px;
                    }
                }
                // Mulut — bentuk berubah per mood, morfing
                // dianimasikan (smooth, bukan lompat). Dibungkus
                // HorizontalLayout supaya selalu di tengah
                // (anak VerticalLayout dengan lebar eksplisit
                // akan menempel kiri bila tidak dibungkus).
                if root.bar-mode == "pet" : HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: root.mouth-w;
                        height: root.mouth-h;
                        border-radius: root.mouth-r;
                        background: #ffffff;
                        animate width { duration: 250ms; easing: ease-in-out; }
                        animate height { duration: 250ms; easing: ease-in-out; }
                        animate border-radius { duration: 250ms; easing: ease-in-out; }
                    }
                }
            }

            // Titik aksen di ujung kanan bila ada notifikasi
            // belum dibaca (hanya mode notch — pet memakai
            // border aksen).
            if root.notif-count > 0 && root.bar-mode == "notch" : Rectangle {
                x: parent.width - 18px;
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Design.accent;
            }
        }

        // ----- Panel mengembang (hanya saat hover) -----
        if root.expanded : Rectangle {
            height: root.panel-h;
            background: Design.surface-elevated;
            border-color: Design.separator;
            border-width: 1px;
            border-radius: Design.radius-md;
            clip: true;

            VerticalLayout {
                padding: 8px;
                spacing: 0;

                // Baris 4 chip angka (status widget dashboard).
                HorizontalLayout {
                    height: 40px;
                    spacing: 4px;

                    // Chip EDITING
                    Rectangle {
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Design.radius-sm;
                        background: chip-ed-touch.has-hover ? Design.bg-hover : transparent;
                        chip-ed-touch := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                            }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    root.drag-press-x = self.mouse-x;
                                    root.drag-press-y = self.mouse-y;
                                    root.drag-pressed = true;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    if (root.drag-dragging) {
                                        root.save-position();
                                    } else {
                                        root.open-category("EDITING");
                                    }
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.cancel) {
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                    if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                        root.drag-dragging = true;
                                    }
                                    if (root.drag-dragging) {
                                        root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                    }
                                } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                    root.close-window();
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Rectangle {
                                width: 8px; height: 8px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: Design.cat-editing;
                            }
                            Text {
                                text: "EDITING";
                                font-size: 10px;
                                font-weight: 700;
                                color: Design.text-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.stat-editing;
                                font-size: 14px;
                                font-weight: 800;
                                color: Design.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Chip REVISION
                    Rectangle {
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Design.radius-sm;
                        background: chip-rev-touch.has-hover ? Design.bg-hover : transparent;
                        chip-rev-touch := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                            }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    root.drag-press-x = self.mouse-x;
                                    root.drag-press-y = self.mouse-y;
                                    root.drag-pressed = true;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    if (root.drag-dragging) {
                                        root.save-position();
                                    } else {
                                        root.open-category("REVISION");
                                    }
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.cancel) {
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                    if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                        root.drag-dragging = true;
                                    }
                                    if (root.drag-dragging) {
                                        root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                    }
                                } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                    root.close-window();
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Rectangle {
                                width: 8px; height: 8px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: Design.cat-revision;
                            }
                            Text {
                                text: "REVISION";
                                font-size: 10px;
                                font-weight: 700;
                                color: Design.text-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.stat-revision;
                                font-size: 14px;
                                font-weight: 800;
                                color: Design.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Chip LATE
                    Rectangle {
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Design.radius-sm;
                        background: chip-late-touch.has-hover ? Design.bg-hover : transparent;
                        chip-late-touch := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                            }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    root.drag-press-x = self.mouse-x;
                                    root.drag-press-y = self.mouse-y;
                                    root.drag-pressed = true;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    if (root.drag-dragging) {
                                        root.save-position();
                                    } else {
                                        root.open-category("LATE");
                                    }
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.cancel) {
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                    if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                        root.drag-dragging = true;
                                    }
                                    if (root.drag-dragging) {
                                        root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                    }
                                } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                    root.close-window();
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Rectangle {
                                width: 8px; height: 8px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: Design.cat-late;
                            }
                            Text {
                                text: "LATE";
                                font-size: 10px;
                                font-weight: 700;
                                color: Design.text-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.stat-late;
                                font-size: 14px;
                                font-weight: 800;
                                color: Design.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Chip POINTS
                    Rectangle {
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Design.radius-sm;
                        background: chip-pts-touch.has-hover ? Design.bg-hover : transparent;
                        chip-pts-touch := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                            }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    root.drag-press-x = self.mouse-x;
                                    root.drag-press-y = self.mouse-y;
                                    root.drag-pressed = true;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    if (root.drag-dragging) {
                                        root.save-position();
                                    } else {
                                        root.open-category("POINTS");
                                    }
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.cancel) {
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                    if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                        root.drag-dragging = true;
                                    }
                                    if (root.drag-dragging) {
                                        root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                    }
                                } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                    root.close-window();
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Rectangle {
                                width: 8px; height: 8px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: Design.cat-points;
                            }
                            Text {
                                text: "POINTS";
                                font-size: 10px;
                                font-weight: 700;
                                color: Design.text-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.stat-points;
                                font-size: 14px;
                                font-weight: 800;
                                color: Design.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Lonceng notifikasi + badge jumlah (klik =
                    // tutup panel manual).
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 16px;
                        background: bell-touch.has-hover ? Design.bg-hover : transparent;
                        bell-touch := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                            }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    root.drag-press-x = self.mouse-x;
                                    root.drag-press-y = self.mouse-y;
                                    root.drag-pressed = true;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    if (root.drag-dragging) {
                                        root.save-position();
                                    } else {
                                        root.expanded = !root.expanded;
                                    }
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.cancel) {
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                    if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                        root.drag-dragging = true;
                                    }
                                    if (root.drag-dragging) {
                                        root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                    }
                                } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                    root.close-window();
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            SvgIcon {
                                name: "bell";
                                size: 16px;
                                icon-color: root.notif-count > 0 ? Design.accent : Design.text-secondary;
                            }
                        }
                        if root.notif-count > 0 : Rectangle {
                            x: 18px;
                            y: -2px;
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            background: Design.status-danger;
                            Text {
                                text: root.notif-count > 9 ? "9+" : "" + root.notif-count;
                                font-size: 9px;
                                font-weight: 800;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }
                }

                // Baris volume OS (ala overlay volume Nusa) —
                // ganti shortcut radial volume yang dibatalkan
                // 27 Nov 20:41. Slider + persen + bisukan.
                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    vol-icon-touch := TouchArea {
                        width: 28px;
                        mouse-cursor: pointer;
                        enabled: root.volume-available;
                        changed has-hover => {
                            if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                        }
                        clicked => { root.volume-mute-clicked(); }
                        VerticalLayout {
                            alignment: center;
                            SvgIcon {
                                name: root.volume-muted ? "volume-x" : "volume";
                                size: 16px;
                                icon-color: root.volume-available ? Design.text-primary : Design.text-muted;
                            }
                        }
                    }
                    VolumeSlider {
                        horizontal-stretch: 1;
                        value <=> root.volume-f;
                        enabled: root.volume-available && !root.volume-muted;
                        changed(v) => { root.volume-changed(v); }
                    }
                    Text {
                        width: 44px;
                        text: !root.volume-available ? "—" : (root.volume-muted ? "Bisukan" : "" + Math.round(root.volume-f * 100) + "%");
                        font-size: 12px;
                        font-weight: 700;
                        color: root.volume-available ? Design.text-primary : Design.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }

                if root.notif-titles.length == 0 : Rectangle {
                    height: 40px;
                    Text {
                        text: "Belum ada notifikasi — kartu baru & poin bertambah muncul di sini";
                        font-size: 12px;
                        color: Design.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                for title[idx] in root.notif-titles : Rectangle {
                    height: 40px;
                    border-radius: Design.radius-sm;
                    background: row-touch.has-hover ? Design.bg-hover : transparent;
                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                root.drag-press-x = self.mouse-x;
                                root.drag-press-y = self.mouse-y;
                                root.drag-pressed = true;
                                root.drag-dragging = false;
                            } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                if (root.drag-dragging) {
                                    root.save-position();
                                } else {
                                    root.open-notification(idx);
                                }
                                root.drag-pressed = false;
                                root.drag-dragging = false;
                            } else if (ev.kind == PointerEventKind.cancel) {
                                root.drag-pressed = false;
                                root.drag-dragging = false;
                            } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                    root.drag-dragging = true;
                                }
                                if (root.drag-dragging) {
                                    root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                }
                            } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                root.close-window();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 8px; height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: root.notif-cats[idx] == "EDITING" ? Design.cat-editing : root.notif-cats[idx] == "REVISION" ? Design.cat-revision : root.notif-cats[idx] == "LATE" ? Design.cat-late : root.notif-cats[idx] == "POINTS" ? Design.cat-points : Design.accent;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                text: title;
                                font-size: 13px;
                                font-weight: 700;
                                color: Design.text-primary;
                                overflow: elide;
                            }
                            Text {
                                text: root.notif-subs[idx];
                                font-size: 11px;
                                color: Design.text-secondary;
                                overflow: elide;
                            }
                        }
                    }
                }

                // Footer: buka dashboard utama.
                Rectangle {
                    height: 36px;
                    border-radius: Design.radius-sm;
                    background: dash-touch.has-hover ? Design.bg-hover : transparent;
                    dash-touch := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                root.drag-press-x = self.mouse-x;
                                root.drag-press-y = self.mouse-y;
                                root.drag-pressed = true;
                                root.drag-dragging = false;
                            } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                if (root.drag-dragging) {
                                    root.save-position();
                                } else {
                                    root.open-dashboard();
                                }
                                root.drag-pressed = false;
                                root.drag-dragging = false;
                            } else if (ev.kind == PointerEventKind.cancel) {
                                root.drag-pressed = false;
                                root.drag-dragging = false;
                            } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                    root.drag-dragging = true;
                                }
                                if (root.drag-dragging) {
                                    root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                }
                            } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                root.close-window();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            SvgIcon {
                                name: "layers";
                                size: 14px;
                                icon-color: Design.accent;
                            }
                        }
                        Text {
                            text: "Buka Dashboard";
                            font-size: 13px;
                            font-weight: 700;
                            color: Design.accent;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}
