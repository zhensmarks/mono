// Windows — Komponen Window Sekunder Mandiri (OS Window Baru)
// Sesuai arsitektur C# (SpreadsheetWindow.axaml & CardListWindow.axaml)
// Dibuka saat pengguna mengklik tanda panah widget atau tombol "Buka Window Baru".

import { Design, Btn, IconBtn, SvgIcon, TextField, WindowControls, HSeparator } from "design.slint";
import { SpreadsheetComponent } from "spreadsheet.slint";
import { TrelloDetailPanel, CommentRow, MdLine, MdToolbar, MarkdownView, ApiComment } from "trello-detail.slint";
import { RadialMenuView } from "radial.slint";
import { ToolboxView } from "modul.slint";
import { BatchView, BatchRow, RegulerDirRow, RegulerSchoolRow } from "batch.slint";
import { DocView } from "doc.slint";

// ============================================================
// RADIAL MENU WINDOW — 320×320 transparent, topmost, cursor-centered.
// Mirrors C# RadialMenuWindow; screen positioning comes from Rust hook code.
// ============================================================
export component RadialMenuWindow inherits Window {
    title: "BMachine Radial Menu";
    width: 320px;
    height: 320px;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    default-font-family: Design.font-family;
    callback close-window();
    callback execute-script(string);
    callback toast(string);
    callback reset-wheel();
    callback release-execute();
    callback open-toolbox(string);
    in-out property <int> doc-tab-count: 1;
    // Gaya + geometri ring radial (lihat ui/radial.slint) — didorong
    // Rust saat radial dibuka / pengaturan berubah.
    in-out property <string> radial-style: "glass";
    in-out property <int> sector-count: 8;
    in-out property <[string]> wedge-cmds;
    in-out property <[string]> arc-cmds;
    in-out property <string> divider-cmds;
    in-out property <[length]> btn-x;
    in-out property <[length]> btn-y;

    wheel := RadialMenuView {
        x: 0; y: 0; width: 320px; height: 320px;
        doc-tab-count: root.doc-tab-count;
        radial-style: root.radial-style;
        sector-count: root.sector-count;
        wedge-cmds: root.wedge-cmds;
        arc-cmds: root.arc-cmds;
        divider-cmds: root.divider-cmds;
        btn-x: root.btn-x;
        btn-y: root.btn-y;
        back() => { root.close-window(); }
        toast(message) => { root.toast(message); }
        execute-script(name) => { root.execute-script(name); }
        open-toolbox(tab) => { root.open-toolbox(tab); }
    }

    reset-wheel() => { wheel.reset(); }
    release-execute() => { wheel.release-execute(); }
}

// ============================================================
// 1. TOOLBOX WINDOW — Window Mandiri Toolbox (C# ToolboxWindow:
//    1024×730, Min 680×580, CenterScreen). Dibuka dari radial
//    (submenu TOOLBOX / eksekusi psdbucin). Isi = ToolboxView yang
//    sama dengan overlay lama, hanya wadahnya window OS.
// ============================================================
export component ToolboxWindow inherits Window {
    title: "BMachine Toolbox";
    width: 1024px;
    height: 730px;
    // C# Min 680x580 tidak bisa dipasang bersama width/height di
    // Slint (satu Window tidak boleh punya width + min-width) —
    // ukuran buka 1024x730 tetap sama; lantai resize tidak ditegakkan.
    background: transparent;
    default-font-family: Design.font-family;
    // Chrome window (lihat DESIGN_SYSTEM.md §23): "native" = chrome
    // bawaan OS, lainnya frameless + titlebar kustom di bawah.
    // Didorong Rust saat window dibuat / pengaturan berubah.
    no-frame: root.chrome-style != "native";
    in-out property <string> chrome-style: "custom";
    in-out property <string> chrome-button-style: "icons";
    in-out property <string> chrome-button-position: "right";
    // Gaya toggle on/off ("classic" | "pill" | "outline") — didorong
    // Rust saat window dibuat / pengaturan berubah (lihat §5.2).
    in-out property <string> toggle-style: "classic";

    callback close-window();
    callback minimize-window();
    callback maximize-window();
    callback move-window(length, length);
    callback toast(string);
    in-out property <string> tool-tab: "MantraNama";

    // Latar window membulat (§23, 28 Nov 2026): Window transparan +
    // Rectangle ini yang memberi warna latar + radius sudut luar
    // (radius-xl mengikuti gaya sudut Settings; 0px saat chrome
    // native supaya frame OS tidak diganggu).
    win-bg := Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: Design.app-bg;
        border-radius: root.chrome-style == "native" ? 0px : Design.radius-xl;
    }


    // Drag strip mode headless (tanpa titlebar): seret 28px teratas
    // konten (di bawah elemen interaktif — tab/tombol tetap
    // menerima kliknya sendiri).
    if root.chrome-style == "headless" : TouchArea {
        x: 0; y: 0;
        width: 100%;
        height: 28px;
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <bool> dragging: false;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
                self.dragging = true;
            } else if (ev.kind == PointerEventKind.up) {
                self.dragging = false;
            } else if (ev.kind == PointerEventKind.move && self.dragging) {
                root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
            }
        }
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Custom Titlebar Toolbox Window (hanya saat chrome
        // "custom" / "wrapped"; saat "native" titlebar OS yang
        // tampil, saat "headless" tidak ada titlebar sama sekali).
        // Drag via TouchArea (dulu window ini mengandalkan frame OS
        // untuk dipindah — sejak chrome kustom, drag harus ada di
        // titlebar sendiri).
        if root.chrome-style == "custom" || root.chrome-style == "wrapped" : Rectangle {
            height: 38px;
            background: Design.surface-elevated;
            border-top-left-radius: Design.radius-xl;
            border-top-right-radius: Design.radius-xl;
            border-color: Design.separator;
            border-width: 0.5px;

            tb-drag := TouchArea {
                x: root.chrome-button-position == "left" ? 130px : 0px;
                y: 0;
                width: parent.width - (root.chrome-button-position == "left" ? 130px : 108px);
                height: 100%;
                property <length> press-x: 0px;
                property <length> press-y: 0px;
                property <bool> dragging: false;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        self.press-x = self.mouse-x;
                        self.press-y = self.mouse-y;
                        self.dragging = true;
                    } else if (ev.kind == PointerEventKind.up) {
                        self.dragging = false;
                    } else if (ev.kind == PointerEventKind.move && self.dragging) {
                        root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
                    }
                }
                double-clicked => { root.maximize-window(); }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                // Tombol kontrol di kiri (gaya macOS).
                if root.chrome-button-position == "left" : WindowControls {
                    y: (parent.height - self.height) / 2;
                    button-style: root.chrome-button-style;
                    minimize() => { root.minimize-window(); }
                    maximize() => { root.maximize-window(); }
                    close() => { root.close-window(); }
                }

                Text {
                    text: "BMachine Toolbox";
                    font-size: Design.font-body;
                    font-weight: 800;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // Tombol kontrol di kanan (gaya Windows, bawaan).
                if root.chrome-button-position == "right" : WindowControls {
                    y: (parent.height - self.height) / 2;
                    button-style: root.chrome-button-style;
                    minimize() => { root.minimize-window(); }
                    maximize() => { root.maximize-window(); }
                    close() => { root.close-window(); }
                }
            }
        }

        // Isi Toolbox — dalam panel rounded saat chrome "wrapped"
        // (titlebar tetap di frame; panel inset 8px).
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: root.chrome-style == "wrapped" ? 8px : 0px;
            padding-right: root.chrome-style == "wrapped" ? 8px : 0px;
            padding-top: root.chrome-style == "wrapped" ? 8px : 0px;
            padding-bottom: root.chrome-style == "wrapped" ? 8px : 0px;
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: root.chrome-style == "wrapped" ? Design.surface-elevated : transparent;
                border-color: Design.separator;
                border-width: root.chrome-style == "wrapped" ? 1px : 0px;
                border-radius: root.chrome-style == "wrapped" ? 12px : 0px;
                clip: true;

                // Isi Toolbox (komponen yang sama dengan overlay lama).
                tb := ToolboxView {
                    x: root.chrome-style == "wrapped" ? 8px : 0px;
                    y: root.chrome-style == "wrapped" ? 8px : 0px;
                    width: parent.width - (root.chrome-style == "wrapped" ? 16px : 0px);
                    height: parent.height - (root.chrome-style == "wrapped" ? 16px : 0px);
                    tool-tab <=> root.tool-tab;
                    toggle-style <=> root.toggle-style;
                    back() => { root.close-window(); }
                    toast(text) => { root.toast(text); }
                }
            }
        }
    }
}

// ============================================================
// 2. REPORT BUG DIALOG — Window "Laporkan Bug" (C#
//    Views/Dialogs/MantraData/ReportBugDialog: 560 lebar,
//    CenterOwner, tanpa dekorasi). Dibuka dari flyout profil.
// ============================================================
export component ReportBugDialog inherits Window {
    title: "Laporkan Bug";
    width: 560px;
    height: 400px;
    background: transparent;
    no-frame: true;
    default-font-family: Design.font-family;

    callback close-window();
    callback send-report(string, string);
    callback toast(string);

    in-out property <string> summary-text: "";
    in-out property <string> detail-text: "";

    // Latar window membulat (§23, 28 Nov 2026): Window transparan +
    // Rectangle ini yang memberi warna latar + radius sudut luar
    // (radius-xl mengikuti gaya sudut Settings; 0px saat chrome
    // native supaya frame OS tidak diganggu).
    win-bg := Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: Design.app-bg;
        border-radius: Design.radius-xl;
    }


    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Titlebar: judul + tombol tutup (drag via titlebar tidak
        // didukung Slint tanpa chrome kustom; tutup via × / Batal).
        Rectangle {
            height: 38px;
            background: Design.surface-elevated;
            border-top-left-radius: Design.radius-xl;
            border-top-right-radius: Design.radius-xl;
            border-color: Design.separator;
            border-width: 0.5px;

            HorizontalLayout {
                padding-left: 22px;
                padding-right: 14px;
                spacing: 8px;

                Text {
                    text: "Laporkan Bug";
                    font-size: 16px;
                    font-weight: 600;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    background: bug-close-touch.has-hover ? Design.status-danger : transparent;
                    border-radius: Design.radius-sm;

                    bug-close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-window(); }
                    }

                    Text {
                        text: "×";
                        font-size: 18px;
                        font-weight: 700;
                        color: bug-close-touch.has-hover ? #ffffff : Design.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }

        VerticalLayout {
            padding: 22px;
            spacing: 0;

            Text {
                text: "Beri tahu kami apa yang terjadi. Laporan ini dikirim ke tim Project & Bug.";
                font-size: 12px;
                color: Design.text-secondary;
                wrap: word-wrap;
                height: 36px;
            }

            Text {
                text: "Ringkasan";
                font-size: 12px;
                color: Design.text-muted;
                height: 18px;
            }

            TextField {
                height: 36px;
                text <=> root.summary-text;
                placeholder: "Judul singkat: 'Tombol Ganti Semua tidak merespons'";
            }

            Text {
                text: "Detail";
                font-size: 12px;
                color: Design.text-muted;
                height: 18px;
            }

            Rectangle {
                height: 110px;
                background: Design.bg-input;
                border-color: Design.border-default;
                border-width: 1px;
                border-radius: Design.radius-sm;
                clip: true;

                TextInput {
                    x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px;
                    text <=> root.detail-text;
                    font-size: 13px;
                    color: Design.text-primary;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                padding-top: 18px;

                Rectangle {
                    width: 90px;
                    height: 36px;
                    Btn {
                        width: 100%; height: 100%;
                        label: "Batal";
                        variant: "secondary";
                        clicked => { root.close-window(); }
                    }
                }
                Rectangle {
                    width: 110px;
                    height: 36px;
                    Btn {
                        width: 100%; height: 100%;
                        label: "Kirim";
                        variant: "primary";
                        clicked => {
                            if (root.summary-text == "") {
                                root.toast("Isi ringkasan dulu");
                            } else {
                                root.send-report(root.summary-text, root.detail-text);
                            }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================
// 3. SPREADSHEET WINDOW — Window Mandiri Editor Spreadsheet
// ============================================================
export component SpreadsheetWindow inherits Window {
    title: "BMachine — Spreadsheet Editor";
    width: 1000px;
    height: 600px;
    background: transparent;
    default-font-family: Design.font-family;
    // Chrome window (lihat DESIGN_SYSTEM.md §23): "native" = chrome
    // bawaan OS, lainnya frameless + titlebar kustom di bawah.
    // Didorong Rust saat window dibuat / pengaturan berubah.
    no-frame: root.chrome-style != "native";
    in-out property <string> chrome-style: "custom";
    in-out property <string> chrome-button-style: "icons";
    in-out property <string> chrome-button-position: "right";

    callback close-window();
    callback minimize-window();
    callback maximize-window();
    callback toast(string);
    // Guard + draft (Rust): teruskan ke SpreadsheetComponent.
    callback sheet-cell-edited(int, int, string, string);
    callback sheet-save();
    callback sheet-refresh();
    // Operasi spreadsheet beneran (Rust): teruskan ke SpreadsheetComponent.
    callback sheet-fill-down();
    callback sheet-clear-cells();
    callback sheet-auto-sum();
    callback sheet-cal-open(string);
    callback sheet-cal-nav(int);
    callback sheet-add-row();
    callback sheet-prev-page();
    callback sheet-next-page();
    callback sheet-hit-col(length) -> int;
    callback sheet-select-rows(int, int, int, int) -> [bool];
    callback sheet-is-typeahead-char(string) -> bool;
    // Data grid DINAMIS (28 Nov 2026 — nested model, kolom dari
    // header sheet) + nilai asli + status guard/draft (diisi Rust saat window dibuat).
    // Default KOSONG (27 Nov 2026, keputusan abeng: default publish harus bersih).
    in-out property <[[string]]> grid: [];
    in-out property <[[string]]> grid-orig: [];
    in-out property <[string]> col-headers: ["KODE", "SEKOLAH", "JENJANG", "STATUS", "POIN", "CATATAN", "TANGGAL"];
    in-out property <[string]> col-letters: ["A", "B", "C", "D", "E", "F", "G"];
    in-out property <[string]> col-kinds: ["text", "text", "dropdown", "dropdown", "number", "text", "date"];
    in-out property <[bool]> col-locked: [true, false, false, false, false, false, false];
    in-out property <[float]> col-widths: [110, 200, 80, 100, 90, 200, 100];
    in-out property <[float]> col-x-offsets: [0, 110, 310, 390, 490, 580, 780];
    in-out property <[[string]]> col-items: [[], [], ["TK", "PAUD", "SD", "SMP", "SMA", "SMK"], ["SELESAI", "PROSES", "REVISI", "ANTRIAN"], [], [], []];
    in-out property <int> key-col: 0;
    in-out property <int> page-start: 0;
    in-out property <int> page-size: 100;
    in-out property <int> total-rows: 0;
    in-out property <int> row-num-base: 1;
    in-out property <string> page-label: "";
    in-out property <bool> sheet-has-draft: false;
    in-out property <int> sheet-draft-count: 0;
    in-out property <string> sheet-status-text: "0 baris · Belum terhubung ke Google Sheets";
    in-out property <string> sheet-guard-result: "";
    // Seleksi multi-baris + kolom fokus (dibaca Rust saat fill-down /
    // clear-cells — diteruskan dari SpreadsheetComponent).
    in-out property <[bool]> sel-rows: [];
    in-out property <int> focus-col: 1;
    in-out property <int> cal-year: 2026;
    in-out property <int> cal-month: 1;
    in-out property <string> cal-label: "";
    in-out property <[int]> cal-cells: [];
    in-out property <int> cal-today: 0;
    in-out property <int> cal-days-in-month: 31;
    in-out property <string> cal-today-iso: "";
    in-out property <int> cal-selected-day: 0;
    // Drag window (C# SpreadsheetWindow.axaml: drag handle 46px di kiri,
    // Margin 0,0,420,0 — kanan 420px bebas untuk toolbar/tombol close).
    callback move-window(length, length);

    // Latar window membulat (§23, 28 Nov 2026): Window transparan +
    // Rectangle ini yang memberi warna latar + radius sudut luar
    // (radius-xl mengikuti gaya sudut Settings; 0px saat chrome
    // native supaya frame OS tidak diganggu).
    win-bg := Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: Design.app-bg;
        border-radius: root.chrome-style == "native" ? 0px : Design.radius-xl;
    }

    // Drag strip mode headless (tanpa titlebar): seret 28px teratas
    // konten (di bawah elemen interaktif — toolbar tetap menerima
    // kliknya sendiri).
    if root.chrome-style == "headless" : TouchArea {
        x: 0; y: 0;
        width: 100%;
        height: 28px;
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <bool> dragging: false;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
                self.dragging = true;
            } else if (ev.kind == PointerEventKind.up) {
                self.dragging = false;
            } else if (ev.kind == PointerEventKind.move && self.dragging) {
                root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
            }
        }
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Custom Titlebar Spreadsheet Window — 46px (C# drag handle
        // Height 46); area drag hanya kiri (lebar − 420px), tombol
        // close di kanan-atas di luar area drag. Hanya saat chrome
        // "custom" / "wrapped" (saat "native" titlebar OS yang
        // tampil, saat "headless" tidak ada titlebar sama sekali).
        if root.chrome-style == "custom" || root.chrome-style == "wrapped" : Rectangle {
            height: 46px;
            background: Design.surface-elevated;
            border-top-left-radius: Design.radius-xl;
            border-top-right-radius: Design.radius-xl;
            border-color: Design.separator;
            border-width: 0.5px;

            sheet-drag := TouchArea {
                x: root.chrome-button-position == "left" ? 130px : 0px;
                y: 0;
                width: max(0px, parent.width - 420px - (root.chrome-button-position == "left" ? 130px : 0px));
                height: 100%;
                mouse-cursor: pointer;
                property <length> press-x: 0px;
                property <length> press-y: 0px;
                property <bool> dragging: false;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        self.press-x = self.mouse-x;
                        self.press-y = self.mouse-y;
                        self.dragging = true;
                    } else if (ev.kind == PointerEventKind.up) {
                        self.dragging = false;
                    } else if (ev.kind == PointerEventKind.move && self.dragging) {
                        root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
                    }
                }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                // Tombol kontrol di kiri (gaya macOS).
                if root.chrome-button-position == "left" : WindowControls {
                    y: (parent.height - self.height) / 2;
                    button-style: root.chrome-button-style;
                    minimize() => { root.minimize-window(); }
                    maximize() => { root.maximize-window(); }
                    close() => { root.close-window(); }
                }

                VerticalLayout {
                    alignment: center;
                    SvgIcon {
                        name: "layers";
                        size: 16px;
                        icon-color: Design.cat-points;
                    }
                }

                Text {
                    text: "BMachine — Spreadsheet Editor";
                    font-size: Design.font-body;
                    font-weight: 800;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // Tombol kontrol di kanan (gaya Windows, bawaan).
                if root.chrome-button-position == "right" : WindowControls {
                    y: (parent.height - self.height) / 2;
                    button-style: root.chrome-button-style;
                    minimize() => { root.minimize-window(); }
                    maximize() => { root.maximize-window(); }
                    close() => { root.close-window(); }
                }
            }
        }

        // Isi Spreadsheet — dalam panel rounded saat chrome "wrapped"
        // (titlebar tetap di frame; panel inset 8px).
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: root.chrome-style == "wrapped" ? 8px : 0px;
            padding-right: root.chrome-style == "wrapped" ? 8px : 0px;
            padding-top: root.chrome-style == "wrapped" ? 8px : 0px;
            padding-bottom: root.chrome-style == "wrapped" ? 8px : 0px;
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: root.chrome-style == "wrapped" ? Design.surface-elevated : transparent;
                border-color: Design.separator;
                border-width: root.chrome-style == "wrapped" ? 1px : 0px;
                border-radius: root.chrome-style == "wrapped" ? 12px : 0px;
                clip: true;

                SpreadsheetComponent {
                    x: root.chrome-style == "wrapped" ? 8px : 0px;
                    y: root.chrome-style == "wrapped" ? 8px : 0px;
                    width: parent.width - (root.chrome-style == "wrapped" ? 16px : 0px);
                    height: parent.height - (root.chrome-style == "wrapped" ? 16px : 0px);
                    is-standalone: true;
                    outer-radius: root.chrome-style == "native" ? 0px : Design.radius-xl;
            grid <=> root.grid;
            grid-orig <=> root.grid-orig;
            col-headers <=> root.col-headers;
            col-letters <=> root.col-letters;
            col-kinds <=> root.col-kinds;
            col-locked <=> root.col-locked;
            col-widths <=> root.col-widths;
            col-x-offsets <=> root.col-x-offsets;
            col-items <=> root.col-items;
            key-col <=> root.key-col;
            page-start <=> root.page-start;
            page-size <=> root.page-size;
            total-rows <=> root.total-rows;
            row-num-base <=> root.row-num-base;
            page-label <=> root.page-label;
            cal-year <=> root.cal-year;
            cal-month <=> root.cal-month;
            cal-label <=> root.cal-label;
            cal-cells <=> root.cal-cells;
            cal-today <=> root.cal-today;
            cal-days-in-month <=> root.cal-days-in-month;
            cal-today-iso <=> root.cal-today-iso;
            cal-selected-day <=> root.cal-selected-day;
            sel-rows <=> root.sel-rows;
            focus-col <=> root.focus-col;
            has-draft <=> root.sheet-has-draft;
            draft-count <=> root.sheet-draft-count;
            status-text <=> root.sheet-status-text;
            guard-result <=> root.sheet-guard-result;
            cell-edited(r, c, orig, val) => { root.sheet-cell-edited(r, c, orig, val); }
            save-changes() => { root.sheet-save(); }
            refresh-data() => { root.sheet-refresh(); }
            fill-down() => { root.sheet-fill-down(); }
            clear-cells() => { root.sheet-clear-cells(); }
            auto-sum() => { root.sheet-auto-sum(); }
            cal-open(val) => { root.sheet-cal-open(val); }
            cal-nav(d) => { root.sheet-cal-nav(d); }
            add-row() => { root.sheet-add-row(); }
            prev-page() => { root.sheet-prev-page(); }
            next-page() => { root.sheet-next-page(); }
            hit-col(x) => { return root.sheet-hit-col(x); }
            select-rows(r, c, m, a) => { return root.sheet-select-rows(r, c, m, a); }
            is-typeahead-char(t) => { return root.sheet-is-typeahead-char(t); }
            toast(msg) => { root.toast(msg); }
            close-view() => { root.close-window(); }
                }
            }
        }
    }
}

// ============================================================
// 2. CARD LIST WINDOW — Window Mandiri Daftar Kartu Trello
// ============================================================
export component CardListWindow inherits Window {
    title: "BMachine — Trello Cards";
    // C# CardListWindow.axaml: 450x600, CenterScreen (posisi dihitung
    // Rust via center_over_main). Isi tetap list + splitter 6px +
    // panel detail 400 (UnifiedTrelloView.axaml:13-17) — hanya ukuran
    // yang disamakan, struktur tidak diubah.
    width: 450px;
    height: 600px;
    background: transparent;
    default-font-family: Design.font-family;
    // Chrome window (lihat DESIGN_SYSTEM.md §23): "native" = chrome
    // bawaan OS, lainnya frameless + titlebar kustom di bawah.
    // Didorong Rust saat window dibuat / pengaturan berubah.
    no-frame: root.chrome-style != "native";
    in-out property <string> chrome-style: "custom";
    in-out property <string> chrome-button-style: "icons";
    in-out property <string> chrome-button-position: "right";

    in-out property <string> category: "EDITING";
    in-out property <color> category-accent: Design.cat-editing;
    in-out property <string> search-query: "";
    // -1 = belum ada kartu dipilih → tampil daftar (C# compact mode:
    // IsListScreenVisible). >= 0 = kartu dipilih → tampil detail
    // layar penuh (IsPanelScreenVisible). Window 450px selalu compact
    // (CompactThreshold 800 di C#) — daftar/detail TIDAK PERNAH
    // berdampingan di window ini.
    in-out property <int> selected-idx: -1;
    // Komentar detail (in-out supaya Rust bisa membaca/menulis draft
    // saat CommentWindow dibuka/ditutup — sinkronisasi bolak-balik,
    // sama seperti AppWindow.detail-draft-*).
    in-out property <int> detail-added-count: 0;
    in-out property <string> detail-draft-1: "";
    in-out property <string> detail-draft-2: "";
    in-out property <string> detail-draft-3: "";
    // Komentar API kartu aktif (trello2, item 4) — diikat dua arah
    // ke panel detail; diisi Rust saat sub-panel "comments" dibuka.
    in-out property <[ApiComment]> detail-api-comments: [];
    in-out property <string> detail-comments-note: "";
    // Buka komentar kartu terpilih di CommentWindow (dari segmen
    // panah split button Comment di detail).
    callback open-comment-window();

    // Data Kartu Trello (kosong — diisi Rust saat sync Trello pertama).
    in-out property <[string]> card-titles: [];
    in-out property <[string]> card-subs: [];
    in-out property <[string]> card-due: [];
    in-out property <[bool]> card-done: [];
    // Data deskripsi/meta kartu (diisi Rust saat window dibuka dari
    // model AppWindow kategori aktif — sebelumnya deskripsi detail
    // masih mock hardcode).
    in-out property <[string]> card-desc: [];
    in-out property <[string]> card-ids: [];
    // ID API Trello asli tiap kartu (`c.id` — dipakai PUT deskripsi +
    // komentar ke API; sejajar card-ids yang berisi display id).
    // Diisi Rust saat window dibuka dari model AppWindow.
    in-out property <[string]> card-api-ids: [];
    in-out property <[string]> card-urls: [];
    in-out property <[string]> card-label1: [];
    in-out property <[string]> card-label2: [];
    in-out property <[int]> card-atts: [];
    // Nama + inisial user aktif (author komentar baru).
    in-out property <string> user-name: "USER";
    in-out property <string> user-initial: "U";

    callback close-window();
    callback minimize-window();
    callback maximize-window();
    callback move-window(length, length);
    callback toggle-done(int);
    callback toast(string);
    callback open-url(string);
    // Markdown (deskripsi & komentar): parsing di Rust — pure
    // supaya bisa dipanggil dari binding; toolbar editor via
    // md-insert; simpan deskripsi via save-desc (Rust:
    // edited_descs + model AppWindow).
    pure callback parse-md(string, length) -> [MdLine];
    callback md-insert(string, string, int, int) -> string;
    callback save-desc(string);
    // Komentar Trello nyata (trello2, item 4): muat komentar API
    // kartu (panel → Rust) + kirim komentar baru ke API.
    callback load-comments(string);
    callback comment-posted(string);

    // Latar window membulat (§23, 28 Nov 2026): Window transparan +
    // Rectangle ini yang memberi warna latar + radius sudut luar
    // (radius-xl mengikuti gaya sudut Settings; 0px saat chrome
    // native supaya frame OS tidak diganggu).
    win-bg := Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: Design.app-bg;
        border-radius: root.chrome-style == "native" ? 0px : Design.radius-xl;
    }


    // Drag strip mode headless (tanpa titlebar): seret 28px teratas
    // konten (di bawah elemen interaktif — search bar tetap
    // menerima kliknya sendiri).
    if root.chrome-style == "headless" : TouchArea {
        x: 0; y: 0;
        width: 100%;
        height: 28px;
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <bool> dragging: false;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
                self.dragging = true;
            } else if (ev.kind == PointerEventKind.up) {
                self.dragging = false;
            } else if (ev.kind == PointerEventKind.move && self.dragging) {
                root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
            }
        }
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Custom Titlebar Card List Window (hanya saat chrome
        // "custom" / "wrapped"; saat "native" titlebar OS yang
        // tampil, saat "headless" tidak ada titlebar sama sekali).
        // Drag via TouchArea (dulu window ini mengandalkan frame OS
        // untuk dipindah — sejak chrome kustom, drag harus ada di
        // titlebar sendiri).
        if root.chrome-style == "custom" || root.chrome-style == "wrapped" : Rectangle {
            height: 38px;
            background: Design.surface-elevated;
            border-top-left-radius: Design.radius-xl;
            border-top-right-radius: Design.radius-xl;
            border-color: Design.separator;
            border-width: 0.5px;

            card-drag := TouchArea {
                x: root.chrome-button-position == "left" ? 130px : 0px;
                y: 0;
                width: parent.width - (root.chrome-button-position == "left" ? 130px : 108px);
                height: 100%;
                property <length> press-x: 0px;
                property <length> press-y: 0px;
                property <bool> dragging: false;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        self.press-x = self.mouse-x;
                        self.press-y = self.mouse-y;
                        self.dragging = true;
                    } else if (ev.kind == PointerEventKind.up) {
                        self.dragging = false;
                    } else if (ev.kind == PointerEventKind.move && self.dragging) {
                        root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
                    }
                }
                double-clicked => { root.maximize-window(); }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                // Tombol kontrol di kiri (gaya macOS).
                if root.chrome-button-position == "left" : WindowControls {
                    y: (parent.height - self.height) / 2;
                    button-style: root.chrome-button-style;
                    minimize() => { root.minimize-window(); }
                    maximize() => { root.maximize-window(); }
                    close() => { root.close-window(); }
                }

                Rectangle {
                    width: 8px; height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: root.category-accent;
                }

                Text {
                    text: "Trello — " + root.category + " (" + root.card-titles.length + " Kartu)";
                    font-size: Design.font-body;
                    font-weight: 800;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // Tombol kontrol di kanan (gaya Windows, bawaan).
                if root.chrome-button-position == "right" : WindowControls {
                    y: (parent.height - self.height) / 2;
                    button-style: root.chrome-button-style;
                    minimize() => { root.minimize-window(); }
                    maximize() => { root.maximize-window(); }
                    close() => { root.close-window(); }
                }
            }
        }

        // Konten: daftar ATAU detail (compact, C# UnifiedTrelloView:
        // CompactThreshold 800; window 450px selalu compact — daftar
        // tampil saat belum ada kartu dipilih, detail layar penuh saat
        // ada kartu dipilih). `if` dipakai, bukan `visible` (visible:
        // false tetap makan ruang di layout Slint). Dalam panel
        // rounded saat chrome "wrapped" (titlebar tetap di frame;
        // panel inset 8px).
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: root.chrome-style == "wrapped" ? 8px : 0px;
            padding-right: root.chrome-style == "wrapped" ? 8px : 0px;
            padding-top: root.chrome-style == "wrapped" ? 8px : 0px;
            padding-bottom: root.chrome-style == "wrapped" ? 8px : 0px;
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: root.chrome-style == "wrapped" ? Design.surface-elevated : transparent;
                border-color: Design.separator;
                border-width: root.chrome-style == "wrapped" ? 1px : 0px;
                border-radius: root.chrome-style == "wrapped" ? 12px : 0px;
                clip: true;
                // Klik kanan = kembali/close (§10.11, 28 Nov 2026): di
                // detail → kembali ke daftar (selected-idx = -1), di
                // daftar → tutup window. TouchArea latar di belakang
                // isi; klik kanan di BARIS ditangani row-touch sendiri
                // (TouchArea men-grab semua Pressed termasuk kanan —
                // i-slint-core TouchArea::input_event), klik kanan di
                // area kosong sampai ke sini.
                cardlist-back-touch := TouchArea {
                    x: 0; y: 0; width: 100%; height: 100%;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                            if (root.selected-idx >= 0) {
                                root.selected-idx = -1;
                                root.toast("Detail ditutup");
                            } else {
                                root.close-window();
                            }
                        }
                    }
                }
        HorizontalLayout {
            x: root.chrome-style == "wrapped" ? 8px : 0px;
            y: root.chrome-style == "wrapped" ? 8px : 0px;
            width: parent.width - (root.chrome-style == "wrapped" ? 16px : 0px);
            height: parent.height - (root.chrome-style == "wrapped" ? 16px : 0px);
            padding: Design.space-md;
            spacing: Design.space-md;

            // Kolom Kiri: Search & Daftar Kartu
            if root.selected-idx < 0 : VerticalLayout {
                horizontal-stretch: 1;
                spacing: Design.space-sm;

                // Search Bar
                Rectangle {
                    height: 32px;
                    border-radius: Design.radius-sm;
                    background: Design.bg-input;
                    border-color: Design.border-default;
                    border-width: 1px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            SvgIcon {
                                name: "search";
                                size: 13px;
                                icon-color: Design.text-muted;
                            }
                        }
                        TextInput {
                            text <=> root.search-query;
                            font-size: Design.font-body;
                            color: Design.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }

                // List Kartu
                Rectangle {
                    vertical-stretch: 1;
                    background: Design.card-bg;
                    border-color: Design.separator;
                    border-width: 1px;
                    border-radius: Design.radius-md;
                    clip: true;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;

                        for title[idx] in root.card-titles : Rectangle {
                            height: 52px;
                            border-radius: Design.radius-sm;
                            background: root.selected-idx == idx ? Design.accent-subtle : (row-touch.has-hover ? Design.bg-hover : transparent);
                            border-color: root.selected-idx == idx ? Design.accent : transparent;
                            border-width: 1px;

                            row-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.selected-idx = idx; }
                                // Klik kanan di baris = tutup window
                                // (daftar tidak punya detail terbuka;
                                // TouchArea men-grab Pressed kanan jadi
                                // back-touch di belakang takkan kena).
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                        root.close-window();
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;

                                // Checkbox selesai
                                Rectangle {
                                    width: 18px; height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: root.card-done[idx] ? root.category-accent : transparent;
                                    border-color: root.card-done[idx] ? root.category-accent : Design.separator;
                                    border-width: 1.5px;

                                    chk-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.card-done[idx] = !root.card-done[idx];
                                            root.toggle-done(idx);
                                        }
                                        // Klik kanan di checkbox = tutup
                                        // window (sama seperti baris).
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                root.close-window();
                                            }
                                        }
                                    }

                                    if root.card-done[idx] : SvgIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        name: "check";
                                        size: 12px;
                                        icon-color: #ffffff;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: title;
                                        font-size: Design.font-body;
                                        font-weight: 700;
                                        color: Design.text-primary;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.card-subs[idx];
                                        font-size: Design.font-caption;
                                        color: Design.text-secondary;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    text: root.card-due[idx];
                                    font-size: Design.font-caption;
                                    font-weight: 600;
                                    color: root.category-accent;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // State kosong (trello2, item 6): pesan di tengah
                        // area daftar bila list ini tidak punya kartu.
                        if root.card-titles.length == 0 : VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: "Belum ada kartu di list ini";
                                font-size: 13px;
                                font-weight: 600;
                                color: Design.text-secondary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Tutup window ini lalu tekan ↻ di dashboard untuk memuat ulang";
                                font-size: 12px;
                                color: Design.text-muted;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            // Kolom Kanan: Panel Detail (layar penuh saat ada kartu dipilih)
            if root.selected-idx >= 0 : Rectangle {
                horizontal-stretch: 1;
                background: Design.surface-elevated;
                border-color: Design.separator;
                border-width: 1px;
                border-radius: Design.radius-md;
                clip: true;

                TrelloDetailPanel {
                    x: 0; y: 0; width: 100%; height: 100%;
                    card-title: root.card-titles[root.selected-idx];
                    event-date: root.card-due[root.selected-idx];
                    display-id: root.card-ids[root.selected-idx];
                    card-id: root.card-api-ids[root.selected-idx];
                    due-text: "Due: " + root.card-due[root.selected-idx];
                    is-manual: false;
                    card-url-override: root.card-urls[root.selected-idx];
                    category-label: root.category;
                    accent: root.category-accent;
                    done: root.card-done[root.selected-idx];
                    description: root.card-desc[root.selected-idx];
                    label-1: root.card-label1[root.selected-idx];
                    label-2: root.card-label2[root.selected-idx];
                    attachments-count: root.card-atts[root.selected-idx];
                    user-name: root.user-name;
                    user-initial: root.user-initial;
                    added-count <=> root.detail-added-count;
                    draft-1 <=> root.detail-draft-1;
                    draft-2 <=> root.detail-draft-2;
                    draft-3 <=> root.detail-draft-3;
                    api-comments <=> root.detail-api-comments;
                    comments-note <=> root.detail-comments-note;
                    load-comments(id) => { root.load-comments(id); }
                    comment-posted(t) => { root.comment-posted(t); }
                    open-comment-window => { root.open-comment-window(); }
                    close() => { root.selected-idx = -1; root.toast("Detail ditutup"); }
                    show-toast(t) => { root.toast(t); }
                    open-url(u) => { root.open-url(u); }
                    parse-md(s, w) => { root.parse-md(s, w) }
                    md-insert(kind, text, cur, anch) => { root.md-insert(kind, text, cur, anch) }
                    save-description(text) => { root.save-desc(text); }
                }
            }
                }
            }
        }
    }
}

// ============================================================
// COMMENT WINDOW — Komentar kartu di window OS terpisah.
// C# CommentWindow.axaml: 400×600, CenterScreen, Topmost, judul
// "Comments". Dibuka dari segmen panah (▸) split button Comment
// di detail kartu (C# OnOpenCommentWindowClicked: muat komentar
// kartu yang diklik dulu, buka window, tutup panel inline).
// Isi = CommentListView yang sama dengan panel Comments inline
// (daftar + quick reply + input); state komentar DIBAGI dengan
// detail pembuka — Rust mengisi added-count/draft-* saat dibuka
// dan menulisnya balik saat ditutup (mockup; API Trello asli
// Fase 6: fetch komentar + kirim via POST actions/comments).
// ============================================================
export component CommentWindow inherits Window {
    title: "Comments";
    width: 400px;
    height: 600px;
    background: transparent;
    default-font-family: Design.font-family;
    // C# Topmost=true.
    always-on-top: true;
    // Chrome window (lihat DESIGN_SYSTEM.md §23): "native" = chrome
    // bawaan OS, lainnya frameless + titlebar kustom di bawah.
    no-frame: root.chrome-style != "native";
    in-out property <string> chrome-style: "custom";
    in-out property <string> chrome-button-style: "icons";
    in-out property <string> chrome-button-position: "right";

    // Kartu yang komentarnya dibuka (diisi Rust saat dibuka).
    in-out property <string> card-title: "";
    in-out property <string> event-date: "";
    // Nama + inisial user aktif (author komentar baru).
    in-out property <string> user-name: "USER";
    in-out property <string> user-initial: "U";
    // Komentar tambahan (dibagi dengan detail pembuka; maks 3).
    in-out property <int> added-count: 0;
    in-out property <string> draft-1: "";
    in-out property <string> draft-2: "";
    in-out property <string> draft-3: "";
    // Tampilkan aktivitas (C#: ToggleShowActivityCommand — di port
    // hanya toggle + toast, belum ada data aktivitas).
    in-out property <bool> show-activity: true;
    // Kartu yang komentarnya dibuka (trello2, item 4): id API asli
    // (c.id) + komentar dari API + catatan muat. Diisi Rust saat
    // window dibuka.
    in-out property <string> card-id: "";
    in-out property <[ApiComment]> api-comments: [];
    in-out property <string> comments-note: "";

    callback close-window();
    callback minimize-window();
    callback maximize-window();
    callback move-window(length, length);
    callback toast(string);
    callback send-comment();
    // Komentar baru dikirim (dipicu send-comment setelah slot lokal
    // terisi) — Rust POST ke API Trello (trello2, item 4).
    callback comment-posted(string);
    callback open-url(string);
    // Markdown (komentar): parsing di Rust (src/markdown.rs) —
    // pure supaya bisa dipanggil dari binding; toolbar editor
    // via md-insert (Rust).
    pure callback parse-md(string, length) -> [MdLine];
    callback md-insert(string, string, int, int) -> string;

    property <string> comment-draft: "";

    send-comment => {
        if (root.comment-draft == "") {
            root.toast("Tulis komentar dulu");
        } else if (root.added-count == 0) {
            root.draft-1 = root.comment-draft;
            root.added-count = 1;
            root.comment-posted(root.comment-draft);
            root.comment-draft = "";
        } else if (root.added-count == 1) {
            root.draft-2 = root.comment-draft;
            root.added-count = 2;
            root.comment-posted(root.comment-draft);
            root.comment-draft = "";
        } else if (root.added-count == 2) {
            root.draft-3 = root.comment-draft;
            root.added-count = 3;
            root.comment-posted(root.comment-draft);
            root.comment-draft = "";
        } else {
            root.toast("Maks 3 komentar tambahan (mockup)");
        }
    }

    // Drag strip mode headless (tanpa titlebar): seret 28px teratas
    // konten (di bawah elemen interaktif — header tetap menerima
    // kliknya sendiri).
    if root.chrome-style == "headless" : TouchArea {
        x: 0; y: 0;
        width: 100%;
        height: 28px;
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <bool> dragging: false;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
                self.dragging = true;
            } else if (ev.kind == PointerEventKind.up) {
                self.dragging = false;
            } else if (ev.kind == PointerEventKind.move && self.dragging) {
                root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
            }
        }
    }

    // Latar window membulat (§23, 28 Nov 2026): Window transparan +
    // Rectangle ini yang memberi warna latar + radius sudut luar
    // (radius-xl mengikuti gaya sudut Settings; 0px saat chrome
    // native supaya frame OS tidak diganggu).
    win-bg := Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: Design.app-bg;
        border-radius: root.chrome-style == "native" ? 0px : Design.radius-xl;
    }

    // Klik kanan di area kosong = tutup window (§10.11, 28 Nov 2026 —
    // cermin panel komentar inline yang menutup saat klik kanan).
    // TouchArea latar di belakang isi; klik kanan di tombol/input
    // ditangani elemen itu sendiri (TouchArea men-grab Pressed).
    comment-back-touch := TouchArea {
        x: 0; y: 0; width: 100%; height: 100%;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.close-window();
            }
        }
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Custom Titlebar (hanya saat chrome "custom" / "wrapped";
        // saat "native" titlebar OS yang tampil, saat "headless"
        // tidak ada titlebar sama sekali).
        if root.chrome-style == "custom" || root.chrome-style == "wrapped" : Rectangle {
            height: 38px;
            background: Design.surface-elevated;
            border-top-left-radius: Design.radius-xl;
            border-top-right-radius: Design.radius-xl;
            border-color: Design.separator;
            border-width: 0.5px;

            comment-drag := TouchArea {
                x: root.chrome-button-position == "left" ? 130px : 0px;
                y: 0;
                width: parent.width - (root.chrome-button-position == "left" ? 130px : 108px);
                height: 100%;
                property <length> press-x: 0px;
                property <length> press-y: 0px;
                property <bool> dragging: false;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        self.press-x = self.mouse-x;
                        self.press-y = self.mouse-y;
                        self.dragging = true;
                    } else if (ev.kind == PointerEventKind.up) {
                        self.dragging = false;
                    } else if (ev.kind == PointerEventKind.move && self.dragging) {
                        root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
                    }
                }
                double-clicked => { root.maximize-window(); }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                if root.chrome-button-position == "left" : WindowControls {
                    y: (parent.height - self.height) / 2;
                    button-style: root.chrome-button-style;
                    minimize() => { root.minimize-window(); }
                    maximize() => { root.maximize-window(); }
                    close() => { root.close-window(); }
                }

                Text {
                    text: "Comments";
                    font-size: Design.font-body;
                    font-weight: 800;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                if root.chrome-button-position == "right" : WindowControls {
                    y: (parent.height - self.height) / 2;
                    button-style: root.chrome-button-style;
                    minimize() => { root.minimize-window(); }
                    maximize() => { root.maximize-window(); }
                    close() => { root.close-window(); }
                }
            }
        }

        // Isi (margin 20 ala C#; inset 8px saat chrome "wrapped").
        VerticalLayout {
            vertical-stretch: 1;
            padding: 20px;
            padding-left: root.chrome-style == "wrapped" ? 28px : 20px;
            padding-right: root.chrome-style == "wrapped" ? 28px : 20px;
            spacing: 12px;

            // Header: "Comments" + nama kartu + eye toggle + X.
            HorizontalLayout {
                height: 28px;
                spacing: 8px;
                Text {
                    text: "Comments";
                    font-size: 20px;
                    font-weight: 600;
                    color: Design.text-primary;
                    vertical-alignment: center;
                }
                Text {
                    text: root.card-title;
                    font-size: 12px;
                    color: Design.text-secondary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                IconBtn {
                    glyph: root.show-activity ? "◉" : "○";
                    variant: "ghost";
                    size: 28px;
                    clicked => {
                        root.show-activity = !root.show-activity;
                        root.toast(root.show-activity ? "Aktivitas ditampilkan" : "Aktivitas disembunyikan");
                    }
                }
                // X in-content HANYA saat chrome headless (abeng 28 Nov
                // 10:16 — X ganda "janggal"): saat chrome custom/wrapped
                // titlebar sudah punya X, saat native titlebar OS yang
                // punya X. C# sepenuhnya frameless sehingga butuh tombol
                // close pengganti di dalam konten; di port, X in-content
                // hanya untuk mode headless.
                if root.chrome-style == "headless" : IconBtn {
                    glyph: "×";
                    variant: "ghost";
                    size: 28px;
                    clicked => { root.close-window(); }
                }
            }
            // Chip tanggal event (C#: chip di bawah nama kartu, hanya
            // bila kartu punya tanggal).
            if root.event-date != "" && root.event-date != "—" : Rectangle {
                height: 26px;
                width: event-text.preferred-width + 20px;
                background: Design.card-bg;
                border-color: Design.separator;
                border-width: 1px;
                border-radius: 6px;
                event-text := Text {
                    text: root.event-date;
                    font-size: 11px;
                    font-weight: 600;
                    color: Design.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
            HSeparator { }
            // Daftar komentar (sama seperti panel Comments inline).
            Rectangle {
                vertical-stretch: 1;
                clip: true;
                comments-flick := Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    VerticalLayout {
                        x: 0; width: parent.width;
                        spacing: 12px;
                        // Komentar dari API Trello (trello2, item 4) —
                        // di atas komentar sesi ini (yang masih lokal).
                        if root.comments-note != "" : Text {
                            text: root.comments-note;
                            font-size: 12px;
                            color: Design.text-muted;
                            wrap: word-wrap;
                        }
                        for c in root.api-comments : CommentRow {
                            author: c.author;
                            time: c.time;
                            body: c.body;
                            initial: c.initial;
                            parse-md(s, w) => { root.parse-md(s, w) }
                            open-url(u) => { root.open-url(u); }
                            show-toast(t) => { root.toast(t); }
                        }
                        if root.added-count >= 1 : CommentRow {
                            author: root.user-name;
                            time: "baru saja";
                            body: root.draft-1;
                            initial: root.user-initial;
                            avatar-bg: Design.accent;
                            parse-md(s, w) => { root.parse-md(s, w) }
                            open-url(u) => { root.open-url(u); }
                            show-toast(t) => { root.toast(t); }
                        }
                        if root.added-count >= 2 : CommentRow {
                            author: root.user-name;
                            time: "baru saja";
                            body: root.draft-2;
                            initial: root.user-initial;
                            avatar-bg: Design.accent;
                            parse-md(s, w) => { root.parse-md(s, w) }
                            open-url(u) => { root.open-url(u); }
                            show-toast(t) => { root.toast(t); }
                        }
                        if root.added-count >= 3 : CommentRow {
                            author: root.user-name;
                            time: "baru saja";
                            body: root.draft-3;
                            initial: root.user-initial;
                            avatar-bg: Design.accent;
                            parse-md(s, w) => { root.parse-md(s, w) }
                            open-url(u) => { root.open-url(u); }
                            show-toast(t) => { root.toast(t); }
                        }
                    }
                }
            }
            // Balasan cepat (C#: Quick Replies).
            HorizontalLayout {
                height: 28px;
                spacing: 8px;
                Btn {
                    label: "Siap, diperbaiki.";
                    variant: "ghost";
                    small: true;
                    clicked => { root.comment-draft = "Siap, diperbaiki."; }
                }
                Btn {
                    label: "Sudah dicek.";
                    variant: "ghost";
                    small: true;
                    clicked => { root.comment-draft = "Sudah dicek."; }
                }
            }
            // Editor komentar (Markdown): toolbar + input multi-baris
            // + pratinjau live. Enter menyisipkan baris baru (bukan
            // kirim); kirim hanya via tombol →.
            MdToolbar {
                insert(kind) => {
                    root.comment-draft = root.md-insert(kind, root.comment-draft, comment-input.cursor-position-byte-offset, comment-input.anchor-position-byte-offset);
                }
            }
            HorizontalLayout {
                spacing: 8px;
                // TextField bawaan single-line 36px — editor komentar
                // multi-baris memakai TextInput mentah di dalam
                // Rectangle ala TextField (latar + border + radius).
                Rectangle {
                    horizontal-stretch: 1;
                    height: 56px;
                    background: Design.bg-input;
                    border-color: comment-input.has-focus ? Design.border-focus : Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-sm;
                    clip: true;
                    comment-input := TextInput {
                        x: 10px; y: 6px;
                        width: parent.width - 20px;
                        height: parent.height - 12px;
                        text <=> root.comment-draft;
                        font-size: 12px;
                        color: Design.text-primary;
                        selection-foreground-color: white;
                        selection-background-color: Design.accent;
                        wrap: word-wrap;
                        single-line: false;
                    }
                    Text {
                        text: "Write a comment... (@mention)";
                        font-size: 12px;
                        color: Design.text-muted;
                        x: 10px; y: 6px;
                        visible: root.comment-draft == "" && !comment-input.has-focus;
                    }
                }
                // Tombol rata bawah (input multi-baris).
                VerticalLayout {
                    alignment: end;
                    IconBtn {
                        glyph: "+";
                        variant: "ghost";
                        size: 36px;
                        clicked => { root.toast("Lampirkan file ke komentar (mockup — Fase 6)"); }
                    }
                }
                VerticalLayout {
                    alignment: end;
                    IconBtn {
                        glyph: "→";
                        variant: "accent";
                        size: 36px;
                        clicked => { root.send-comment(); }
                    }
                }
            }
            // Pratinjau komentar saat mengetik (maks ~100px).
            if root.comment-draft != "" : Rectangle {
                height: min(100px, comment-preview-md.preferred-height);
                clip: true;
                Flickable {
                    x: 0; y: 0; width: 100%; height: 100%;
                    viewport-height: comment-preview-md.preferred-height;
                    comment-preview-md := MarkdownView {
                        width: 100%;
                        source: root.comment-draft;
                        font-size: 12px;
                        parse-md(s, w) => { root.parse-md(s, w) }
                        open-url(u) => { root.open-url(u); }
                        show-toast(t) => { root.toast(t); }
                    }
                }
            }
        }
    }
}

// ============================================================
// 4. DYNAMIC BAR WINDOW — Floating mini-bar ala Dynamic Island
// (abeng 27 Nov 19:52): angka widget dashboard (EDITING /
// REVISION / LATE / POINTS) + notifikasi kartu masuk + poin
// bertambah — tanpa harus buka window utama.
// Window OS terpisah, no-frame, always-on-top, bisa di-drag.
// Klik angka → window utama ke tampilan terkait; klik lonceng
// (atau area kosong bar) → mengembang menampilkan notifikasi;
// klik notifikasi → tampilan terkait; klik kanan → tutup bar
// (dibuka lagi dari flyout profil / Settings).
// Angka HARUS dari sumber yang sama dengan widget dashboard
// (Rust menyalin properti AppWindow tiap 2 detik — bukan angka
// baru; lihat main.rs `bar sync timer`).
// ============================================================
// ===== Dynamic Bar — NOTCH HIDUP (rework 27 Nov 2026) =====
// Referensi: Nusa (rama2555.github.io/nusa) — "a living notch
// for Windows", native Rust. Keadaan diam = pill hitam kecil di
// atas-tengah layar berisi maskot sepasang mata putih bercahaya
// (TIDAK ada angka yang terlihat langsung). Hover → mengembang
// menampilkan status widget dashboard + notifikasi; mouse
// menjauh → mengecil lagi (Nusa: "Hover the notch to open it.
// Move away and it closes.").
// Mata berkedip (timer), pupil mengikuti kursor, tertidur
// setelah 45 detik tanpa aktivitas, menyapa (mata membesar)
// saat user kembali — perilaku maskot Nusa.
// Mode "pet": maskot jadi avatar bulat yang bisa di-drag ke mana
// saja dan bergerak sendiri (idle wander dari timer Rust).
// Voice: maskot bicara via SAPI Windows (Rust, src/voice.rs) —
// suara beneran, bukan bubble teks.
// Notch sendiri selalu hitam (ala Nusa) di semua tema; panel
// mengembang mengikuti token Design aktif (sync_design_to_bar).
// Satu mata maskot. Gaya mata (eye-style) — "nusa" (oval putih
// bercahaya + pupil hitam, bawaan), "baymax" (titik bundar tanpa
// pupil — titiknya sendiri yang bergeser mengikuti kursor),
// "bulat" (lingkaran putih besar + pupil, tanpa glow). Ukuran
// mata (eye-w/eye-h) tetap dari mood window (idle/happy/
// surprised/tidur/kedip) supaya semua animasi yang sudah ada
// tetap jalan di semua gaya.
component MascotEye inherits Rectangle {
    in property <length> eye-w: 14px;
    in property <length> eye-h: 18px;
    in property <length> pupil-dx: 0px;
    in property <length> pupil-dy: 0px;
    in property <bool> eye-closed: false;
    in property <string> eye-style: "nusa";

    // "bulat" = lingkaran: diameter = sisi terpanjang mata.
    property <length> dot-w: root.eye-style == "bulat" ? max(root.eye-w, root.eye-h) : root.eye-w;
    property <length> dot-h: root.eye-style == "bulat" ? max(root.eye-w, root.eye-h) : root.eye-h;

    width: root.eye-w + 10px;
    height: 34px;

    // Glow di belakang mata — hanya gaya Nusa. Warna mengikuti
    // tema (text-primary: putih di gelap, gelap di terang).
    if root.eye-style == "nusa" : Rectangle {
        width: root.eye-w + 8px;
        height: root.eye-h + 8px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 12px;
        background: Design.text-primary;
        opacity: 0.14;
    }
    // Bola mata. Warna mengikuti tema (text-primary) supaya tetap
    // kontras dengan pill yang juga mengikuti tema.
    Rectangle {
        width: root.dot-w;
        height: root.dot-h;
        x: (parent.width - self.width) / 2 + (root.eye-style == "baymax" ? root.pupil-dx : 0px);
        y: (parent.height - self.height) / 2 + (root.eye-style == "baymax" ? root.pupil-dy : 0px);
        border-radius: root.dot-w / 2;
        background: Design.text-primary;
        // Pupil — warna latar pill (surface-elevated): hilang saat
        // mata terpejam/tidur; gaya Baymax tidak punya pupil.
        if !root.eye-closed && root.eye-style != "baymax" : Rectangle {
            width: 7px;
            height: 9px;
            x: (parent.width - self.width) / 2 + root.pupil-dx;
            y: (parent.height - self.height) / 2 + root.pupil-dy;
            border-radius: 4px;
            background: Design.surface-elevated;
        }
    }
}

// Sepasang mata maskot — dua MascotEye + garis penghubung gaya
// Baymax (hanya bila eye-style == "baymax"): garis putih dari
// tengah mata kiri ke tengah mata kanan, di belakang mata.
// (Di GIF referensi titik + garisnya hitam di atas latar terang;
// di atas pill hitam BMachine warnanya dibalik jadi putih supaya
// terbaca — lihat DESIGN_SYSTEM.md §21.)
component MascotEyes inherits Rectangle {
    in property <length> eye-w: 14px;
    in property <length> eye-h: 18px;
    in property <length> pupil-dx: 0px;
    in property <length> pupil-dy: 0px;
    in property <bool> eye-closed: false;
    in property <string> eye-style: "nusa";
    in property <length> gap: 12px;

    width: 2 * (root.eye-w + 10px) + root.gap;
    height: 34px;

    if root.eye-style == "baymax" : Rectangle {
        x: (root.eye-w + 10px) / 2;
        y: (parent.height - 2px) / 2;
        width: (root.eye-w + 10px) + root.gap;
        height: 2px;
        background: Design.text-primary;
    }
    HorizontalLayout {
        spacing: root.gap;
        MascotEye {
            eye-w: root.eye-w;
            eye-h: root.eye-h;
            pupil-dx: root.pupil-dx;
            pupil-dy: root.pupil-dy;
            eye-closed: root.eye-closed;
            eye-style: root.eye-style;
        }
        MascotEye {
            eye-w: root.eye-w;
            eye-h: root.eye-h;
            pupil-dx: root.pupil-dx;
            pupil-dy: root.pupil-dy;
            eye-closed: root.eye-closed;
            eye-style: root.eye-style;
        }
    }
}

// Slider volume OS di panel mengembang (ala overlay volume
// Nusa). Nilai 0..1; drag/klik di track langsung mengubahnya.
// `changed` dipanggil tiap gerakan — Rust men-debounce ke OS.
component VolumeSlider inherits Rectangle {
    in-out property <float> value: 0.5;
    in property <bool> enabled: true;
    callback changed(float);

    property <bool> pressed: false;
    height: 28px;

    // Track.
    Rectangle {
        width: 100%;
        height: 6px;
        y: (parent.height - self.height) / 2;
        border-radius: 3px;
        background: Design.separator;
    }
    // Fill (level saat ini).
    Rectangle {
        width: parent.width * root.value;
        height: 6px;
        y: (parent.height - self.height) / 2;
        border-radius: 3px;
        background: root.enabled ? Design.accent : Design.text-muted;
    }
    // Thumb.
    Rectangle {
        width: 14px;
        height: 14px;
        x: clamp(parent.width * root.value - 7px, 0px, parent.width - 14px);
        y: (parent.height - self.height) / 2;
        border-radius: 7px;
        background: #ffffff;
        border-color: root.enabled ? Design.accent : Design.text-muted;
        border-width: 1px;
    }
    slider-touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        enabled: root.enabled;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                root.pressed = true;
                root.value = clamp(self.mouse-x / self.width, 0, 1);
                root.changed(root.value);
            } else if (ev.kind == PointerEventKind.up) {
                root.pressed = false;
            } else if (ev.kind == PointerEventKind.cancel) {
                root.pressed = false;
            } else if (ev.kind == PointerEventKind.move && root.pressed) {
                root.value = clamp(self.mouse-x / self.width, 0, 1);
                root.changed(root.value);
            }
        }
    }
}

export component DynamicBarWindow inherits Window {
    title: "BMachine — Dynamic Bar";
    width: root.expanded ? 560px : (root.bar-mode == "pet" ? 84px : 150px);
    height: root.bar-display == "line" ? 4px : (root.expanded ? root.expanded-height : root.pill-h);
    background: transparent;
    no-frame: true;
    always-on-top: true;
    default-font-family: Design.font-family;

    callback close-window();
    callback move-window(length, length);
    callback save-position();
    callback open-category(string);
    callback open-notification(int);
    callback open-dashboard();
    callback expanded-changed(bool);
    callback volume-changed(float);
    callback volume-mute-clicked();

    in-out property <string> stat-editing: "0";
    in-out property <string> stat-revision: "0";
    in-out property <string> stat-late: "0";
    in-out property <string> stat-points: "0";
    in-out property <int> notif-count: 0;
    in-out property <[string]> notif-titles: [];
    in-out property <[string]> notif-subs: [];
    in-out property <[string]> notif-kinds: [];
    in-out property <[string]> notif-cats: [];
    in-out property <bool> expanded: false;
    // Mode notch (pill atas-tengah, posisi tetap) atau pet
    // (avatar bulat bebas, bisa di-drag + wander sendiri).
    in-out property <string> bar-mode: "notch";
    // Tampilan notch oleh auto-hide (diisi Rust, timer 500ms):
    // "full" = pill 150×32 biasa; "line" = garis tipis 4px
    // (window lain maksimal). "hidden" tidak ada di sini —
    // Rust menyembunyikan window-nya (w.hide()).
    in-out property <string> bar-display: "full";
    // Gaya mata maskot ("nusa" | "baymax" | "bulat") — dari
    // Settings → Appearance → Notch, DB Settings.Notch.EyeStyle.
    // Berlaku ke mata notch DAN mata blob pet bawaan (bukan
    // sprite PetDex — sprite adalah wajahnya sendiri).
    in-out property <string> eye-style: "nusa";
    // True saat mouse di dalam window (dipakai Rust: pet tidak
    // wander saat sedang di-hover).
    in-out property <bool> pet-hovering: false;
    // Volume OS (panel mengembang; Windows: Core Audio,
    // Linux: pactl/wpctl; bila tidak ada → slider nonaktif).
    in-out property <float> volume-f: 0.5;
    in-out property <bool> volume-muted: false;
    in-out property <bool> volume-available: true;
    // Mood maskot (diisi Rust dari event terakhir; "idle" bila
    // tidak ada): "idle" | "happy" | "surprised". Tidur dan
    // sapa dihitung sisi Slint (effective-mood di bawah).
    in-out property <string> pet-mood: "idle";
    // Pet PetDex aktif (mode pet saja): sprite sheet + frame saat
    // ini. Kosong = blob bawaan. Geometri frame (ukuran tampil
    // satu frame + jumlah kolom/baris atlas) diisi Rust dari sheet
    // yang sudah di-decode — frame 192×208 asli, tampil setinggi
    // pill pet (84px), lebar ikut rasio frame.
    in-out property <image> pet-sprite;
    in-out property <bool> pet-sprite-active: false;
    in-out property <int> pet-frame-col: 0;
    in-out property <int> pet-frame-row: 0;
    in-out property <length> pet-frame-w: 77px;
    in-out property <length> pet-frame-h: 84px;
    in-out property <int> pet-sheet-cols: 8;
    in-out property <int> pet-sheet-rows: 9;
    // Opacity sprite — selalu 1 (tidak di-fade antar state: state
    // berbalik Idle ↔ Running tiap langkah wander, fade akan
    // menahan sprite di opacity 0; lihat komentar timer frame
    // di main.rs).
    in-out property <float> pet-sprite-opacity: 1;

    // Tinggi pill dan panel mengembang.
    property <length> pill-h: root.bar-mode == "pet" ? 84px : 32px;
    property <length> pill-w: root.bar-mode == "pet" ? 84px : 150px;
    // Panel: padding 8 + baris chip 40 + baris volume 36 + baris
    // notifikasi maks 5 × 40 (atau 40 bila kosong) + footer 36
    // + padding 8.
    property <length> panel-h: 128px + max(1, min(root.notif-titles.length, 5)) * 40px;
    property <length> expanded-height: root.pill-h + 8px + root.panel-h;

    // --- Maskot: mata ---
    property <bool> blinking: false;
    property <bool> sleeping: false;
    property <bool> greeting: false;
    // Penghitung hover: tiap TouchArea di window ini menambah 1
    // saat di-hover, kurang 1 saat ditinggal. Panel hanya
    // menutup bila penghitung 0 (mouse benar-benar di luar
    // window) — supaya panel tidak menutup saat mouse pindah
    // dari notch ke chip/baris di dalam panel.
    property <int> hover-hold: 0;
    changed hover-hold => { root.pet-hovering = root.hover-hold > 0; }

    // Mood efektif maskot (bahasa ekspresi blob, ref
    // pet-ref-1.jpg): tidur → sleepy; sapa saat kembali →
    // happy; selebihnya mood dari Rust (idle/happy/surprised).
    // Semua transisi mata + mulut di-interpolasi (SYARAT
    // TEGAS abeng: gerakan pet harus smooth, jangan lompat).
    property <string> effective-mood: root.sleeping ? "sleepy" : (root.greeting ? "happy" : root.pet-mood);
    property <length> eye-w: root.effective-mood == "surprised" ? 22px : (root.bar-mode == "pet" ? 20px : 14px);
    property <length> eye-h: root.sleeping || root.blinking ? 2px : (root.effective-mood == "happy" ? (root.bar-mode == "pet" ? 8px : 12px) : (root.effective-mood == "surprised" ? (root.bar-mode == "pet" ? 30px : 22px) : (root.bar-mode == "pet" ? 24px : 18px)));
    animate eye-h { duration: 250ms; easing: ease-in-out; }
    animate eye-w { duration: 250ms; easing: ease-in-out; }
    // Mulut blob (hanya mode pet — pill notch 32px terlalu
    // pendek): idle garis tipis, happy senyum lebar,
    // surprised "o" kecil, sleepy garis sangat tipis.
    property <length> mouth-w: root.effective-mood == "happy" ? 22px : (root.effective-mood == "surprised" ? 10px : (root.effective-mood == "sleepy" ? 8px : 14px));
    property <length> mouth-h: root.effective-mood == "happy" ? 11px : (root.effective-mood == "surprised" ? 13px : (root.effective-mood == "sleepy" ? 2px : 3px));
    property <length> mouth-r: root.effective-mood == "surprised" ? 6px : 5px;
    // Pusat pill (untuk arah pupil) — berubah saat mengembang:
    // notch mengembang = pill 150px di tengah window 560px.
    property <length> pill-cx: root.expanded ? (root.bar-mode == "pet" ? 50px : 280px) : (root.bar-mode == "pet" ? 42px : 75px);
    property <length> pill-cy: root.bar-mode == "pet" ? 42px : 16px;
    property <length> pupil-dx: root.hover-hold > 0 ? clamp((bar-touch.mouse-x - root.pill-cx) / 60px, -1, 1) * 3px : 0px;
    property <length> pupil-dy: root.hover-hold > 0 ? clamp((bar-touch.mouse-y - root.pill-cy) / 40px, -1, 1) * 2px : 0px;

    // Kedip tiap ~3,4 detik (tutup 140ms).
    blink-timer := Timer {
        interval: 3400ms;
        running: true;
        triggered => {
            root.blinking = true;
            blink-off.restart();
        }
    }
    blink-off := Timer {
        interval: 140ms;
        triggered => { root.blinking = false; }
    }
    // Tidur setelah 45 detik tanpa hover; bangun + sapa
    // (mata membesar 1,6 detik) saat user kembali.
    sleep-timer := Timer {
        interval: 45s;
        running: true;
        triggered => { root.sleeping = true; }
    }
    greet-timer := Timer {
        interval: 1600ms;
        triggered => { root.greeting = false; }
    }
    // Jeda tutup: panel menutup 400ms setelah mouse keluar.
    close-timer := Timer {
        interval: 400ms;
        triggered => {
            if (root.hover-hold <= 0) {
                root.expanded = false;
            }
        }
    }

    changed expanded => { root.expanded-changed(root.expanded); }

    // State drag bersama — hanya mode pet yang bisa di-drag
    // (notch diam di atas-tengah seperti Nusa).
    property <length> drag-press-x: 0px;
    property <length> drag-press-y: 0px;
    property <bool> drag-pressed: false;
    property <bool> drag-dragging: false;

    // Latar sentuh seluruh window (paling bawah): hover →
    // mengembang; klik area kosong → buka dashboard; klik
    // kanan → tutup bar. Mode garis (auto-hide): dinonaktifkan
    // — garis tidak boleh mengembang / menelan klik, klik
    // menembus ke aplikasi di bawahnya.
    bar-touch := TouchArea {
        x: 0; y: 0; width: 100%; height: 100%;
        enabled: root.bar-display != "line";
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover) {
                root.hover-hold += 1;
                root.expanded = true;
                root.sleeping = false;
                root.greeting = true;
                greet-timer.restart();
                sleep-timer.restart();
            } else {
                root.hover-hold -= 1;
                if (root.hover-hold <= 0) {
                    root.hover-hold = 0;
                    close-timer.restart();
                }
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                root.drag-press-x = self.mouse-x;
                root.drag-press-y = self.mouse-y;
                root.drag-pressed = true;
                root.drag-dragging = false;
            } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                if (root.drag-dragging) {
                    root.save-position();
                } else {
                    root.open-dashboard();
                }
                root.drag-pressed = false;
                root.drag-dragging = false;
            } else if (ev.kind == PointerEventKind.cancel) {
                root.drag-pressed = false;
                root.drag-dragging = false;
            } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                    root.drag-dragging = true;
                }
                if (root.drag-dragging) {
                    root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                }
            } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.close-window();
            }
        }
    }

    VerticalLayout {
        padding: 0;
        spacing: 8px;

        // Garis tipis auto-hide (window lain maksimal, mis.
        // browser — ref layzee, abeng 28 Nov 11:59): seberkas
        // garis selebar pill di tengah atas, tidak nutupin
        // tombol close tab; hover tidak mengembang (bar-touch
        // dinonaktifkan di mode ini). Warna separator supaya
        // kelihatan di wallpaper apa pun (bukan hitam mentah).
        if root.bar-display == "line" : Rectangle {
            width: root.pill-w;
            height: 4px;
            background: Design.separator;
            border-radius: 2px;
        }

        // ----- Pill notch / badan pet (mengikuti tema) -----
        // Latar = surface-elevated (gelap di tema gelap, putih di
        // tema terang) + border 1px separator supaya pill kelihatan
        // di wallpaper apa pun; mata/mulut = text-primary (kontras
        // dengan latar). Dulu latar hardcode #0d0d0d + border putih
        // 15% — pill nyaris tak terlihat di desktop gelap dan tetap
        // hitam di mode Terang (temuan Windows 28 Nov 2026).
        // Pet PetDex aktif (mode pet): latar hitam blob hilang —
        // sprite-nya sendiri yang menentukan bentuk (latar sheet
        // transparan, seperti PetDex Desktop).
        Rectangle {
            visible: root.bar-display != "line";
            width: root.pill-w;
            x: root.expanded ? (root.bar-mode == "pet" ? 8px : (parent.width - root.pill-w) / 2) : 0px;
            height: root.pill-h;
            background: (root.pet-sprite-active && root.bar-mode == "pet") ? transparent : Design.surface-elevated;
            border-color: root.notif-count > 0 ? Design.accent : Design.separator;
            border-width: (root.pet-sprite-active && root.bar-mode == "pet") ? 0px : 1px;
            border-radius: root.bar-mode == "pet" ? 42px : 16px;

            // Sprite PetDex — atlas utuh di dalam clip 84×84,
            // digeser per frame (kolom/baris dari Rust). Satu
            // frame tampil setinggi pill; lebar ikut rasio frame.
            if root.pet-sprite-active && root.bar-mode == "pet" : Rectangle {
                width: 100%;
                height: 100%;
                clip: true;
                Image {
                    source: root.pet-sprite;
                    width: root.pet-frame-w * root.pet-sheet-cols;
                    height: root.pet-frame-h * root.pet-sheet-rows;
                    x: -root.pet-frame-col * root.pet-frame-w;
                    y: -root.pet-frame-row * root.pet-frame-h;
                    opacity: root.pet-sprite-opacity;
                    animate opacity { duration: 200ms; easing: ease-in-out; }
                }
            }

            // Wajah maskot blob (hanya bila tidak ada sprite
            // PetDex aktif): mata + mulut mengikuti tema (text-primary),
            // di tengah pill. Mode notch hanya mata (pill 32px);
            // mode pet mata + mulut.
            if !root.pet-sprite-active : VerticalLayout {
                width: 100%;
                y: (parent.height - self.height) / 2;
                alignment: center;
                spacing: root.bar-mode == "pet" ? 7px : 0px;
                HorizontalLayout {
                    alignment: center;
                    MascotEyes {
                        eye-w: root.eye-w;
                        eye-h: root.eye-h;
                        pupil-dx: root.pupil-dx;
                        pupil-dy: root.pupil-dy;
                        eye-closed: root.sleeping || root.blinking || root.effective-mood == "happy" || root.effective-mood == "sleepy";
                        eye-style: root.eye-style;
                        gap: root.bar-mode == "pet" ? 14px : 12px;
                    }
                }
                // Mulut — bentuk berubah per mood, morfing
                // dianimasikan (smooth, bukan lompat). Dibungkus
                // HorizontalLayout supaya selalu di tengah
                // (anak VerticalLayout dengan lebar eksplisit
                // akan menempel kiri bila tidak dibungkus).
                if root.bar-mode == "pet" : HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: root.mouth-w;
                        height: root.mouth-h;
                        border-radius: root.mouth-r;
                        background: Design.text-primary;
                        animate width { duration: 250ms; easing: ease-in-out; }
                        animate height { duration: 250ms; easing: ease-in-out; }
                        animate border-radius { duration: 250ms; easing: ease-in-out; }
                    }
                }
            }

            // Titik aksen di ujung kanan bila ada notifikasi
            // belum dibaca (hanya mode notch — pet memakai
            // border aksen).
            if root.notif-count > 0 && root.bar-mode == "notch" : Rectangle {
                x: parent.width - 18px;
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Design.accent;
            }
        }

        // ----- Panel mengembang (hanya saat hover) -----
        if root.expanded : Rectangle {
            height: root.panel-h;
            background: Design.surface-elevated;
            border-color: Design.separator;
            border-width: 1px;
            border-radius: Design.radius-md;
            clip: true;

            VerticalLayout {
                padding: 8px;
                spacing: 0;

                // Baris 4 chip angka (status widget dashboard).
                HorizontalLayout {
                    height: 40px;
                    spacing: 4px;

                    // Chip EDITING
                    Rectangle {
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Design.radius-sm;
                        background: chip-ed-touch.has-hover ? Design.bg-hover : transparent;
                        chip-ed-touch := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                            }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    root.drag-press-x = self.mouse-x;
                                    root.drag-press-y = self.mouse-y;
                                    root.drag-pressed = true;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    if (root.drag-dragging) {
                                        root.save-position();
                                    } else {
                                        root.open-category("EDITING");
                                    }
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.cancel) {
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                    if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                        root.drag-dragging = true;
                                    }
                                    if (root.drag-dragging) {
                                        root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                    }
                                } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                    root.close-window();
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Rectangle {
                                width: 8px; height: 8px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: Design.cat-editing;
                            }
                            Text {
                                text: "EDITING";
                                font-size: 10px;
                                font-weight: 700;
                                color: Design.text-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.stat-editing;
                                font-size: 14px;
                                font-weight: 800;
                                color: Design.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Chip REVISION
                    Rectangle {
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Design.radius-sm;
                        background: chip-rev-touch.has-hover ? Design.bg-hover : transparent;
                        chip-rev-touch := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                            }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    root.drag-press-x = self.mouse-x;
                                    root.drag-press-y = self.mouse-y;
                                    root.drag-pressed = true;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    if (root.drag-dragging) {
                                        root.save-position();
                                    } else {
                                        root.open-category("REVISION");
                                    }
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.cancel) {
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                    if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                        root.drag-dragging = true;
                                    }
                                    if (root.drag-dragging) {
                                        root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                    }
                                } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                    root.close-window();
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Rectangle {
                                width: 8px; height: 8px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: Design.cat-revision;
                            }
                            Text {
                                text: "REVISION";
                                font-size: 10px;
                                font-weight: 700;
                                color: Design.text-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.stat-revision;
                                font-size: 14px;
                                font-weight: 800;
                                color: Design.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Chip LATE
                    Rectangle {
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Design.radius-sm;
                        background: chip-late-touch.has-hover ? Design.bg-hover : transparent;
                        chip-late-touch := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                            }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    root.drag-press-x = self.mouse-x;
                                    root.drag-press-y = self.mouse-y;
                                    root.drag-pressed = true;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    if (root.drag-dragging) {
                                        root.save-position();
                                    } else {
                                        root.open-category("LATE");
                                    }
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.cancel) {
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                    if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                        root.drag-dragging = true;
                                    }
                                    if (root.drag-dragging) {
                                        root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                    }
                                } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                    root.close-window();
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Rectangle {
                                width: 8px; height: 8px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: Design.cat-late;
                            }
                            Text {
                                text: "LATE";
                                font-size: 10px;
                                font-weight: 700;
                                color: Design.text-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.stat-late;
                                font-size: 14px;
                                font-weight: 800;
                                color: Design.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Chip POINTS
                    Rectangle {
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Design.radius-sm;
                        background: chip-pts-touch.has-hover ? Design.bg-hover : transparent;
                        chip-pts-touch := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                            }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    root.drag-press-x = self.mouse-x;
                                    root.drag-press-y = self.mouse-y;
                                    root.drag-pressed = true;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    if (root.drag-dragging) {
                                        root.save-position();
                                    } else {
                                        root.open-category("POINTS");
                                    }
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.cancel) {
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                    if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                        root.drag-dragging = true;
                                    }
                                    if (root.drag-dragging) {
                                        root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                    }
                                } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                    root.close-window();
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Rectangle {
                                width: 8px; height: 8px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: Design.cat-points;
                            }
                            Text {
                                text: "POINTS";
                                font-size: 10px;
                                font-weight: 700;
                                color: Design.text-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.stat-points;
                                font-size: 14px;
                                font-weight: 800;
                                color: Design.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Lonceng notifikasi + badge jumlah (klik =
                    // tutup panel manual).
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 16px;
                        background: bell-touch.has-hover ? Design.bg-hover : transparent;
                        bell-touch := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                            }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    root.drag-press-x = self.mouse-x;
                                    root.drag-press-y = self.mouse-y;
                                    root.drag-pressed = true;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    if (root.drag-dragging) {
                                        root.save-position();
                                    } else {
                                        root.expanded = !root.expanded;
                                    }
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.cancel) {
                                    root.drag-pressed = false;
                                    root.drag-dragging = false;
                                } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                    if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                        root.drag-dragging = true;
                                    }
                                    if (root.drag-dragging) {
                                        root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                    }
                                } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                    root.close-window();
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            SvgIcon {
                                name: "bell";
                                size: 16px;
                                icon-color: root.notif-count > 0 ? Design.accent : Design.text-secondary;
                            }
                        }
                        if root.notif-count > 0 : Rectangle {
                            x: 18px;
                            y: -2px;
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            background: Design.status-danger;
                            Text {
                                text: root.notif-count > 9 ? "9+" : "" + root.notif-count;
                                font-size: 9px;
                                font-weight: 800;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }
                }

                // Baris volume OS (ala overlay volume Nusa) —
                // ganti shortcut radial volume yang dibatalkan
                // 27 Nov 20:41. Slider + persen + bisukan.
                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    vol-icon-touch := TouchArea {
                        width: 28px;
                        mouse-cursor: pointer;
                        enabled: root.volume-available;
                        changed has-hover => {
                            if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                        }
                        clicked => { root.volume-mute-clicked(); }
                        VerticalLayout {
                            alignment: center;
                            SvgIcon {
                                name: root.volume-muted ? "volume-x" : "volume";
                                size: 16px;
                                icon-color: root.volume-available ? Design.text-primary : Design.text-muted;
                            }
                        }
                    }
                    VolumeSlider {
                        horizontal-stretch: 1;
                        value <=> root.volume-f;
                        enabled: root.volume-available && !root.volume-muted;
                        changed(v) => { root.volume-changed(v); }
                    }
                    Text {
                        width: 44px;
                        text: !root.volume-available ? "—" : (root.volume-muted ? "Bisukan" : "" + Math.round(root.volume-f * 100) + "%");
                        font-size: 12px;
                        font-weight: 700;
                        color: root.volume-available ? Design.text-primary : Design.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }

                if root.notif-titles.length == 0 : Rectangle {
                    height: 40px;
                    Text {
                        text: "Belum ada notifikasi — kartu baru & poin bertambah muncul di sini";
                        font-size: 12px;
                        color: Design.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                for title[idx] in root.notif-titles : Rectangle {
                    height: 40px;
                    border-radius: Design.radius-sm;
                    background: row-touch.has-hover ? Design.bg-hover : transparent;
                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                root.drag-press-x = self.mouse-x;
                                root.drag-press-y = self.mouse-y;
                                root.drag-pressed = true;
                                root.drag-dragging = false;
                            } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                if (root.drag-dragging) {
                                    root.save-position();
                                } else {
                                    root.open-notification(idx);
                                }
                                root.drag-pressed = false;
                                root.drag-dragging = false;
                            } else if (ev.kind == PointerEventKind.cancel) {
                                root.drag-pressed = false;
                                root.drag-dragging = false;
                            } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                    root.drag-dragging = true;
                                }
                                if (root.drag-dragging) {
                                    root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                }
                            } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                root.close-window();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 8px; height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: root.notif-cats[idx] == "EDITING" ? Design.cat-editing : root.notif-cats[idx] == "REVISION" ? Design.cat-revision : root.notif-cats[idx] == "LATE" ? Design.cat-late : root.notif-cats[idx] == "POINTS" ? Design.cat-points : Design.accent;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                text: title;
                                font-size: 13px;
                                font-weight: 700;
                                color: Design.text-primary;
                                overflow: elide;
                            }
                            Text {
                                text: root.notif-subs[idx];
                                font-size: 11px;
                                color: Design.text-secondary;
                                overflow: elide;
                            }
                        }
                    }
                }

                // Footer: buka dashboard utama.
                Rectangle {
                    height: 36px;
                    border-radius: Design.radius-sm;
                    background: dash-touch.has-hover ? Design.bg-hover : transparent;
                    dash-touch := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if (self.has-hover) { root.hover-hold += 1; } else { root.hover-hold -= 1; if (root.hover-hold < 0) { root.hover-hold = 0; } }
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                root.drag-press-x = self.mouse-x;
                                root.drag-press-y = self.mouse-y;
                                root.drag-pressed = true;
                                root.drag-dragging = false;
                            } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                if (root.drag-dragging) {
                                    root.save-position();
                                } else {
                                    root.open-dashboard();
                                }
                                root.drag-pressed = false;
                                root.drag-dragging = false;
                            } else if (ev.kind == PointerEventKind.cancel) {
                                root.drag-pressed = false;
                                root.drag-dragging = false;
                            } else if (ev.kind == PointerEventKind.move && root.drag-pressed && root.bar-mode == "pet") {
                                if (abs(self.mouse-x - root.drag-press-x) > 5px || abs(self.mouse-y - root.drag-press-y) > 5px) {
                                    root.drag-dragging = true;
                                }
                                if (root.drag-dragging) {
                                    root.move-window(self.mouse-x - root.drag-press-x, self.mouse-y - root.drag-press-y);
                                }
                            } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                root.close-window();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            SvgIcon {
                                name: "layers";
                                size: 14px;
                                icon-color: Design.accent;
                            }
                        }
                        Text {
                            text: "Buka Dashboard";
                            font-size: 13px;
                            font-weight: 700;
                            color: Design.accent;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}

// ============================================================
// BATCH WINDOW — tab BATCH yang dilepas (tear-off, 28 Nov 2026).
// Isinya BatchView yang SAMA dengan tab embedded di AppWindow
// (ui/batch.slint) — jangan duplikasi tampilan. State BATCH hidup
// di Rust; window ini disinkronkan dari AppWindow
// (sync_batch_window di src/main.rs) tiap kali state berubah.
// Tutup window ini (× titlebar / OS × / Esc tidak) -> BATCH kembali
// ke dashboard (dock, Rust). Chrome mengikuti pengaturan aktif
// (push_chrome_to_batch) seperti window sekunder lain.
// ============================================================
export component BatchWindow inherits Window {
    title: "BMachine — BATCH";
    width: 1100px;
    height: 700px;
    // Lebar minimum 520px (seperti AppWindow) tidak bisa dipasang
    // bersama width/height di Slint — lantai resize tidak ditegakkan
    // (pola sama seperti ToolboxWindow); konten tetap rapi di 520px.
    background: transparent;
    default-font-family: Design.font-family;
    // Chrome window (lihat DESIGN_SYSTEM.md §23): "native" = chrome
    // bawaan OS, lainnya frameless + titlebar kustom di bawah.
    // Didorong Rust saat window dibuat / pengaturan berubah.
    no-frame: root.chrome-style != "native";
    in-out property <string> chrome-style: "custom";
    in-out property <string> chrome-button-style: "icons";
    in-out property <string> chrome-button-position: "right";

    // Skala UI dari ukuran window sendiri (rumus sama seperti AppWindow).
    property <float> ui-scale: max(1, min(min(((self.width - 40px) / 1px) / 600, ((self.height - 98px) / 1px) / 400), 1.8));
    property <length> titlebar-height: (root.chrome-style == "custom" || root.chrome-style == "wrapped") ? 38px : 0px;
    // Tinggi panel TIDAK dihitung di sini lagi (BatchView pakai
    // vertical-stretch — rumus lama lupa titlebar AppWindow).

    // --- State BATCH (pass-through ke BatchView; semua diisi Rust) ---
    in-out property <[BatchRow]> src-rows: [];
    in-out property <[BatchRow]> out-rows: [];
    in-out property <string> src-name: "";
    in-out property <string> selected-output: "";
    in-out property <bool> batch-out-pending: true;
    in-out property <bool> has-manifest: false;
    in-out property <int> batch-sel-count: 0;
    in-out property <string> ctx-node: "";
    in-out property <string> ctx-node-id: "";
    in-out property <string> ctx-panel: "SOURCE";
    in-out property <bool> ctx-is-dir: false;
    in-out property <bool> ctx-is-root: false;
    in-out property <bool> newfolder-open: false;
    in-out property <string> newfolder-panel: "";
    in-out property <string> newfolder-parent: "";
    in-out property <string> newfolder-name: "";
    in-out property <[string]> batch-working-set-names: [];
    in-out property <int> batch-working-set-idx: -1;
    in-out property <int> batch-file-count-ext-idx: 0;
    in-out property <string> batch-file-count-ext-label: "jpg";
    in-out property <bool> reguler-manage-open: false;
    in-out property <[RegulerDirRow]> reguler-dirs: [];
    in-out property <int> reguler-scan-dir-idx: -1;
    in-out property <[RegulerSchoolRow]> reguler-scan-rows: [];
    in-out property <string> reguler-scan-status: "";
    in-out property <string> reguler-filter: "";
    in-out property <[string]> reguler-months: ["Semua bulan"];
    in-out property <int> reguler-month-idx: 0;
    in-out property <[string]> batch-scripts: ["buat_master", "manasik", "wisuda", "pasfoto", "profesi"];
    in-out property <bool> batch-running: false;

    callback close-window();
    callback minimize-window();
    callback maximize-window();
    callback move-window(length, length);
    // Toast diteruskan ke AppWindow (toast hanya ada di dashboard).
    callback batch-toast(string);
    // Callbacks BATCH -> Rust (diteruskan ke AppWindow via invoke_*).
    callback batch-pick-folder();
    callback batch-add-folder(string);
    callback batch-row-clicked(string, string);
    callback batch-row-right-down(string, string);
    callback batch-row-right-up(string, string);
    callback batch-toggle-expand(string, string);
    callback batch-open-ctx(string, string);
    callback batch-close-ctx();
    callback batch-ctx-new-subfolder();
    callback batch-ctx-replace-auto();
    callback batch-ctx-replace-manual();
    callback batch-ctx-copy-path();
    callback batch-ctx-copy-output-path();
    callback batch-ctx-delete();
    callback batch-confirm-new-folder(string, string);
    callback batch-cancel-new-folder();
    callback batch-run-script(string);
    callback batch-copy-master();
    callback batch-stop();
    callback batch-replace-auto();
    callback batch-refresh();
    callback batch-clear();
    callback batch-list-open-school(int);
    callback batch-working-set-picked(int);
    callback batch-file-count-ext-picked(int);
    callback batch-back-to-list();
    callback batch-reguler-refresh();
    callback batch-reguler-manage();
    callback batch-reguler-close();
    callback batch-reguler-add();
    callback batch-reguler-remove(int);
    callback batch-reguler-toggle-lock(int);
    callback batch-reguler-select-dir(int);
    callback batch-reguler-filter-changed(string);
    callback batch-reguler-month-picked(int);
    callback batch-open-task-manager();

    // Latar window membulat (§23, 28 Nov 2026): Window transparan +
    // Rectangle ini yang memberi warna latar + radius sudut luar
    // (radius-xl mengikuti gaya sudut Settings; 0px saat chrome
    // native supaya frame OS tidak diganggu).
    win-bg := Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: Design.app-bg;
        border-radius: root.chrome-style == "native" ? 0px : Design.radius-xl;
    }


    // Drag strip mode headless (tanpa titlebar): seret 28px teratas
    // konten (pola sama seperti CardListWindow).
    if root.chrome-style == "headless" : TouchArea {
        x: 0; y: 0;
        width: 100%;
        height: 28px;
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <bool> dragging: false;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
                self.dragging = true;
            } else if (ev.kind == PointerEventKind.up) {
                self.dragging = false;
            } else if (ev.kind == PointerEventKind.move && self.dragging) {
                root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
            }
        }
    }

    forward-focus: batch-keys-scope;
    batch-keys-scope := FocusScope {
        width: 100%; height: 100%;
        focus-on-click: false;
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if (root.reguler-manage-open) {
                    root.batch-reguler-close();
                } else if (root.ctx-node != "") {
                    root.batch-close-ctx();
                }
            }
        }

        VerticalLayout {
            width: 100%; height: 100%;
            padding: 0;
            spacing: 0;

            // Custom Titlebar Batch Window (hanya saat chrome "custom" /
            // "wrapped"; saat "native" titlebar OS yang tampil, saat
            // "headless" tidak ada titlebar sama sekali).
            if root.chrome-style == "custom" || root.chrome-style == "wrapped" : Rectangle {
                height: 38px;
                background: Design.surface-elevated;
                border-top-left-radius: Design.radius-xl;
                border-top-right-radius: Design.radius-xl;
                border-color: Design.separator;
                border-width: 0.5px;

                batch-drag := TouchArea {
                    x: root.chrome-button-position == "left" ? 130px : 0px;
                    y: 0;
                    width: parent.width - (root.chrome-button-position == "left" ? 130px : 108px);
                    height: 100%;
                    property <length> press-x: 0px;
                    property <length> press-y: 0px;
                    property <bool> dragging: false;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                            self.press-x = self.mouse-x;
                            self.press-y = self.mouse-y;
                            self.dragging = true;
                        } else if (ev.kind == PointerEventKind.up) {
                            self.dragging = false;
                        } else if (ev.kind == PointerEventKind.move && self.dragging) {
                            root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
                        }
                    }
                    double-clicked => { root.maximize-window(); }
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;

                    if root.chrome-button-position == "left" : WindowControls {
                        y: (parent.height - self.height) / 2;
                        button-style: root.chrome-button-style;
                        minimize() => { root.minimize-window(); }
                        maximize() => { root.maximize-window(); }
                        close() => { root.close-window(); }
                    }

                    Text {
                        text: "BATCH" + (root.src-name != "" ? " — " + root.src-name : "");
                        font-size: Design.font-body;
                        font-weight: 800;
                        color: Design.text-primary;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if root.chrome-button-position == "right" : WindowControls {
                        y: (parent.height - self.height) / 2;
                        button-style: root.chrome-button-style;
                        minimize() => { root.minimize-window(); }
                        maximize() => { root.maximize-window(); }
                        close() => { root.close-window(); }
                    }
                }
            }

            BatchView {
                vertical-stretch: 1;
                ui-scale: root.ui-scale;
                content-width: root.width - 16px;
                show-tear-off: false;
                src-rows <=> root.src-rows;
                out-rows <=> root.out-rows;
                src-name <=> root.src-name;
                selected-output <=> root.selected-output;
                batch-out-pending <=> root.batch-out-pending;
                has-manifest <=> root.has-manifest;
                batch-sel-count <=> root.batch-sel-count;
                ctx-node <=> root.ctx-node;
                ctx-node-id <=> root.ctx-node-id;
                ctx-panel <=> root.ctx-panel;
                ctx-is-dir <=> root.ctx-is-dir;
                ctx-is-root <=> root.ctx-is-root;
                newfolder-open <=> root.newfolder-open;
                newfolder-panel <=> root.newfolder-panel;
                newfolder-parent <=> root.newfolder-parent;
                newfolder-name <=> root.newfolder-name;
                batch-working-set-names <=> root.batch-working-set-names;
                batch-working-set-idx <=> root.batch-working-set-idx;
                batch-file-count-ext-idx <=> root.batch-file-count-ext-idx;
                batch-file-count-ext-label <=> root.batch-file-count-ext-label;
                reguler-manage-open <=> root.reguler-manage-open;
                reguler-dirs <=> root.reguler-dirs;
                reguler-scan-dir-idx <=> root.reguler-scan-dir-idx;
                reguler-scan-rows <=> root.reguler-scan-rows;
                reguler-scan-status <=> root.reguler-scan-status;
                reguler-filter <=> root.reguler-filter;
                reguler-months <=> root.reguler-months;
                reguler-month-idx <=> root.reguler-month-idx;
                batch-scripts <=> root.batch-scripts;
                batch-running <=> root.batch-running;
                batch-pick-folder() => { root.batch-pick-folder(); }
                batch-add-folder(path) => { root.batch-add-folder(path); }
                batch-row-clicked(panel, id) => { root.batch-row-clicked(panel, id); }
                batch-row-right-down(panel, id) => { root.batch-row-right-down(panel, id); }
                batch-row-right-up(panel, id) => { root.batch-row-right-up(panel, id); }
                batch-toggle-expand(panel, id) => { root.batch-toggle-expand(panel, id); }
                batch-open-ctx(panel, id) => { root.batch-open-ctx(panel, id); }
                batch-close-ctx() => { root.batch-close-ctx(); }
                batch-ctx-new-subfolder() => { root.batch-ctx-new-subfolder(); }
                batch-ctx-replace-auto() => { root.batch-ctx-replace-auto(); }
                batch-ctx-replace-manual() => { root.batch-ctx-replace-manual(); }
                batch-ctx-copy-path() => { root.batch-ctx-copy-path(); }
                batch-ctx-copy-output-path() => { root.batch-ctx-copy-output-path(); }
                batch-ctx-delete() => { root.batch-ctx-delete(); }
                batch-confirm-new-folder(name, panel) => { root.batch-confirm-new-folder(name, panel); }
                batch-cancel-new-folder() => { root.batch-cancel-new-folder(); }
                batch-run-script(name) => { root.batch-run-script(name); }
                batch-copy-master() => { root.batch-copy-master(); }
                batch-stop() => { root.batch-stop(); }
                batch-replace-auto() => { root.batch-replace-auto(); }
                batch-refresh() => { root.batch-refresh(); }
                batch-clear() => { root.batch-clear(); }
                batch-list-open-school(idx) => { root.batch-list-open-school(idx); }
                batch-working-set-picked(idx) => { root.batch-working-set-picked(idx); }
                batch-file-count-ext-picked(idx) => { root.batch-file-count-ext-picked(idx); }
                batch-back-to-list() => { root.batch-back-to-list(); }
                batch-reguler-refresh() => { root.batch-reguler-refresh(); }
                batch-reguler-manage() => { root.batch-reguler-manage(); }
                batch-reguler-close() => { root.batch-reguler-close(); }
                batch-reguler-add() => { root.batch-reguler-add(); }
                batch-reguler-remove(idx) => { root.batch-reguler-remove(idx); }
                batch-reguler-toggle-lock(idx) => { root.batch-reguler-toggle-lock(idx); }
                batch-reguler-select-dir(idx) => { root.batch-reguler-select-dir(idx); }
                batch-reguler-filter-changed(text) => { root.batch-reguler-filter-changed(text); }
                batch-reguler-month-picked(idx) => { root.batch-reguler-month-picked(idx); }
                batch-open-task-manager() => { root.batch-open-task-manager(); }
                show-toast(t) => { root.batch-toast(t); }
            }
        }
    }
}

// ============================================================
// DOC WINDOW — Instan Redaksi terlepas (tear-off DOC, 28 Nov 2026).
// Pola sama seperti BatchWindow (§16.10): DocView bersama dipakai
// AppWindow (embedded di Panel Samping) dan window ini; AppWindow
// sumber kebenaran tunggal, Rust menyinkronkan via sync_doc_window.
// Tutup (× titlebar / Esc / OS ×) -> dock kembali ke tab panel.
// ============================================================
export component DocWindow inherits Window {
    title: "BMachine — DOC";
    width: 560px;
    height: 640px;
    background: transparent;
    default-font-family: Design.font-family;
    // Chrome window (§23): "native" = chrome bawaan OS, lainnya
    // frameless + titlebar kustom di bawah. Didorong Rust saat window
    // dibuat / pengaturan berubah.
    no-frame: root.chrome-style != "native";
    in-out property <string> chrome-style: "custom";
    in-out property <string> chrome-button-style: "icons";
    in-out property <string> chrome-button-position: "right";

    // Skala UI dari ukuran window sendiri (rumus sama seperti AppWindow).
    property <float> ui-scale: max(1, min(min(((self.width - 40px) / 1px) / 600, ((self.height - 98px) / 1px) / 400), 1.8));
    property <length> titlebar-height: (root.chrome-style == "custom" || root.chrome-style == "wrapped") ? 38px : 0px;

    // --- State DOC (pass-through ke DocView; semua diisi Rust) ---
    in-out property <string> doc-school: "";
    in-out property <string> doc-address: "";
    in-out property <[string]> doc-tab-titles: ["Redaksi 1"];
    in-out property <int> doc-tab-idx: 0;
    in-out property <bool> doc-show-second-logo: false;
    in-out property <string> doc-logo-path: "";
    in-out property <string> doc-logo2-path: "";
    in property <bool> doc-logo-exists: false;
    in property <bool> doc-logo2-exists: false;
    in property <[string]> doc-names: [];
    in property <[string]> doc-paths: [];
    in property <[bool]> doc-exists: [];
    in-out property <int> doc-sel-idx: -1;

    callback close-window();
    callback minimize-window();
    callback maximize-window();
    callback move-window(length, length);
    // Toast diteruskan ke AppWindow (toast hanya ada di dashboard).
    callback doc-toast(string);
    // Callbacks DOC -> Rust (diteruskan ke AppWindow via invoke_*).
    callback doc-open-settings();
    callback doc-toggle-second-logo();
    callback doc-reset();
    callback doc-sync();
    callback doc-tab-add();
    callback doc-tab-select(int);
    callback doc-tab-close(int);
    callback doc-school-edited(string);
    callback doc-address-edited(string);
    callback doc-from-ps(string);
    callback doc-copy-field(string);
    callback doc-pick-logo(int);
    callback doc-clear-logo(int);
    callback doc-send-logo(int);
    callback doc-paste-logo(int);
    callback doc-add();
    callback doc-open(int);
    callback doc-remove(int);

    // Latar window membulat (§23, 28 Nov 2026): Window transparan +
    // Rectangle ini yang memberi warna latar + radius sudut luar
    // (radius-xl mengikuti gaya sudut Settings; 0px saat chrome
    // native supaya frame OS tidak diganggu).
    win-bg := Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: Design.app-bg;
        border-radius: root.chrome-style == "native" ? 0px : Design.radius-xl;
    }


    // Drag strip mode headless (tanpa titlebar): seret 28px teratas
    // konten (pola sama seperti CardListWindow).
    if root.chrome-style == "headless" : TouchArea {
        x: 0; y: 0;
        width: 100%;
        height: 28px;
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <bool> dragging: false;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
                self.dragging = true;
            } else if (ev.kind == PointerEventKind.up) {
                self.dragging = false;
            } else if (ev.kind == PointerEventKind.move && self.dragging) {
                root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
            }
        }
    }

    forward-focus: doc-keys-scope;
    doc-keys-scope := FocusScope {
        width: 100%; height: 100%;
        focus-on-click: false;
        KeyBinding {
            keys: @keys(Escape);
            activated => { root.close-window(); }
        }

        // Klik kanan di area kosong = tutup window (§10.11, 28 Nov 2026).
        // TouchArea latar di belakang isi; klik kanan di tombol/slot
        // DocView ditangani elemen itu sendiri (TouchArea men-grab Pressed).
        doc-back-touch := TouchArea {
            x: 0; y: 0; width: 100%; height: 100%;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    root.close-window();
                }
            }
        }

        VerticalLayout {
            width: 100%; height: 100%;
            padding: 0;
            spacing: 0;

            // Custom Titlebar Doc Window (hanya saat chrome "custom" /
            // "wrapped"; saat "native" titlebar OS yang tampil, saat
            // "headless" tidak ada titlebar sama sekali).
            if root.chrome-style == "custom" || root.chrome-style == "wrapped" : Rectangle {
                height: 38px;
                background: Design.surface-elevated;
                border-top-left-radius: Design.radius-xl;
                border-top-right-radius: Design.radius-xl;
                border-color: Design.separator;
                border-width: 0.5px;

                doc-drag := TouchArea {
                    x: root.chrome-button-position == "left" ? 130px : 0px;
                    y: 0;
                    width: parent.width - (root.chrome-button-position == "left" ? 130px : 108px);
                    height: 100%;
                    property <length> press-x: 0px;
                    property <length> press-y: 0px;
                    property <bool> dragging: false;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                            self.press-x = self.mouse-x;
                            self.press-y = self.mouse-y;
                            self.dragging = true;
                        } else if (ev.kind == PointerEventKind.up) {
                            self.dragging = false;
                        } else if (ev.kind == PointerEventKind.move && self.dragging) {
                            root.move-window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
                        }
                    }
                    double-clicked => { root.maximize-window(); }
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;

                    if root.chrome-button-position == "left" : WindowControls {
                        y: (parent.height - self.height) / 2;
                        button-style: root.chrome-button-style;
                        minimize() => { root.minimize-window(); }
                        maximize() => { root.maximize-window(); }
                        close() => { root.close-window(); }
                    }

                    Text {
                        text: "DOC" + (root.doc-school != "" ? " — " + root.doc-school : "");
                        font-size: Design.font-body;
                        font-weight: 800;
                        color: Design.text-primary;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if root.chrome-button-position == "right" : WindowControls {
                        y: (parent.height - self.height) / 2;
                        button-style: root.chrome-button-style;
                        minimize() => { root.minimize-window(); }
                        maximize() => { root.maximize-window(); }
                        close() => { root.close-window(); }
                    }
                }
            }

            VerticalLayout {
                vertical-stretch: 1;
                padding: 16px;
                DocView {
                    vertical-stretch: 1;
                    show-tear-off: false;
                    two-col: true;
                    doc-school <=> root.doc-school;
                    doc-address <=> root.doc-address;
                    doc-tab-titles <=> root.doc-tab-titles;
                    doc-tab-idx <=> root.doc-tab-idx;
                    doc-show-second-logo <=> root.doc-show-second-logo;
                    doc-logo-path <=> root.doc-logo-path;
                    doc-logo2-path <=> root.doc-logo2-path;
                    doc-logo-exists: root.doc-logo-exists;
                    doc-logo2-exists: root.doc-logo2-exists;
                    doc-names: root.doc-names;
                    doc-paths: root.doc-paths;
                    doc-exists: root.doc-exists;
                    doc-sel-idx <=> root.doc-sel-idx;
                    doc-open-settings() => { root.doc-open-settings(); }
                    doc-toggle-second-logo() => { root.doc-toggle-second-logo(); }
                    doc-reset() => { root.doc-reset(); }
                    doc-sync() => { root.doc-sync(); }
                    doc-tab-add() => { root.doc-tab-add(); }
                    doc-tab-select(idx) => { root.doc-tab-select(idx); }
                    doc-tab-close(idx) => { root.doc-tab-close(idx); }
                    doc-school-edited(text) => { root.doc-school-edited(text); }
                    doc-address-edited(text) => { root.doc-address-edited(text); }
                    doc-from-ps(field) => { root.doc-from-ps(field); }
                    doc-copy-field(field) => { root.doc-copy-field(field); }
                    doc-pick-logo(n) => { root.doc-pick-logo(n); }
                    doc-clear-logo(n) => { root.doc-clear-logo(n); }
                    doc-send-logo(n) => { root.doc-send-logo(n); }
                    doc-paste-logo(n) => { root.doc-paste-logo(n); }
                    doc-add() => { root.doc-add(); }
                    doc-open(idx) => { root.doc-open(idx); }
                    doc-remove(idx) => { root.doc-remove(idx); }
                }
            }
        }
    }
}

// ============================================================
// DOC SETTINGS WINDOW — "Pengaturan DOC" (C# DocSettingsWindow).
// Dua TextBox multiline: "Teks Nama (placeholder)" dan "Teks Alamat
// (placeholder)", satu variasi per baris. Saat kirim ke Photoshop
// hanya layer yang teksnya cocok daftar ini yang diganti
// (case-insensitive, spasi berlebih diabaikan); daftar kosong = field
// itu tidak diganti. Default = kosongkan kedua daftar. Dibuat baru
// tiap dibuka (pola ReportBugDialog — hide->show reuse tidak andal).
// ============================================================
export component DocSettingsWindow inherits Window {
    title: "Pengaturan DOC";
    width: 520px;
    height: 460px;
    background: transparent;
    no-frame: true;
    default-font-family: Design.font-family;

    callback close-window();
    callback save-settings(string, string);
    callback toast(string);

    in-out property <string> name-text: "";
    in-out property <string> address-text: "";

    // Latar window membulat (§23, 28 Nov 2026): Window transparan +
    // Rectangle ini yang memberi warna latar + radius sudut luar
    // (radius-xl mengikuti gaya sudut Settings; 0px saat chrome
    // native supaya frame OS tidak diganggu).
    win-bg := Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: Design.app-bg;
        border-radius: Design.radius-xl;
    }

    forward-focus: doc-settings-keys;
    doc-settings-keys := FocusScope {
        width: 100%; height: 100%;
        focus-on-click: false;
        KeyBinding {
            keys: @keys(Escape);
            activated => { root.close-window(); }
        }

        VerticalLayout {
            padding: 0;
            spacing: 0;

            // Titlebar: judul + tombol tutup.
            Rectangle {
                height: 38px;
                background: Design.surface-elevated;
                border-top-left-radius: Design.radius-xl;
                border-top-right-radius: Design.radius-xl;
                border-color: Design.separator;
                border-width: 0.5px;

                HorizontalLayout {
                    padding-left: 22px;
                    padding-right: 14px;
                    spacing: 8px;

                    Text {
                        text: "Pengaturan DOC";
                        font-size: 16px;
                        font-weight: 600;
                        color: Design.text-primary;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        background: doc-settings-close-touch.has-hover ? Design.status-danger : transparent;
                        border-radius: Design.radius-sm;

                        doc-settings-close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close-window(); }
                        }

                        Text {
                            text: "×";
                            font-size: 18px;
                            font-weight: 700;
                            color: doc-settings-close-touch.has-hover ? #ffffff : Design.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }

            VerticalLayout {
                padding: 22px;
                spacing: Design.space-sm;

                Text {
                    text: "Teks Nama (placeholder)";
                    font-size: Design.font-caption;
                    font-weight: 700;
                    color: Design.text-muted;
                }
                Text {
                    text: "Satu variasi per baris — contoh: TK DELAPAN MATA AIR";
                    font-size: Design.font-caption;
                    color: Design.text-muted;
                }
                Rectangle {
                    height: 110px;
                    background: Design.bg-input;
                    border-color: Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-sm;
                    TextInput {
                        x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 12px;
                        text <=> root.name-text;
                        font-size: Design.font-body;
                        color: Design.text-primary;
                        wrap: word-wrap;
                    }
                }

                Text {
                    text: "Teks Alamat (placeholder)";
                    font-size: Design.font-caption;
                    font-weight: 700;
                    color: Design.text-muted;
                }
                Text {
                    text: "Satu variasi per baris — contoh: JL. SARI ENDAH NO. 7A";
                    font-size: Design.font-caption;
                    color: Design.text-muted;
                }
                Rectangle {
                    height: 110px;
                    background: Design.bg-input;
                    border-color: Design.border-default;
                    border-width: 1px;
                    border-radius: Design.radius-sm;
                    TextInput {
                        x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 12px;
                        text <=> root.address-text;
                        font-size: Design.font-body;
                        color: Design.text-primary;
                        wrap: word-wrap;
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Btn {
                        label: "Default";
                        variant: "ghost";
                        clicked => {
                            root.name-text = "";
                            root.address-text = "";
                        }
                    }
                    Btn {
                        label: "Batal";
                        variant: "ghost";
                        clicked => { root.close-window(); }
                    }
                    Btn {
                        label: "Simpan";
                        variant: "primary";
                        clicked => { root.save-settings(root.name-text, root.address-text); }
                    }
                }
            }
        }
    }
}
