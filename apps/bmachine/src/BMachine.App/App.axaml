<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:BMachine.UI"
             xmlns:converters="using:BMachine.UI.Converters"
             x:Class="BMachine.App.App"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <!-- <FluentTheme /> -->
        <StyleInclude Source="avares://Semi.Avalonia/Themes/Index.axaml" />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://BMachine.UI/Styles/BMachineDesignSystem.axaml" />
        <StyleInclude Source="avares://BMachine.UI/Styles/TrelloNavigation.axaml" />
        
        <!-- ==================================================================== -->
        <!-- FIX: Remove Semi.Avalonia default block background on button text    -->
        <!-- ==================================================================== -->
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Typography now handled by BMachineDesignSystem.axaml -->

        <!-- ==================================================================== -->
        <!-- CUSTOM CONTEXT MENU STYLES (Rounded, Solid Black, Premium)           -->
        <!-- ==================================================================== -->
        
        <!-- ============================================== -->
        <!--        AUTOCOMPLETE BOX                        -->
        <!-- ============================================== -->
        <Style Selector="AutoCompleteBox">
            <Setter Property="MinimumPrefixLength" Value="0" />
            <Setter Property="FilterMode" Value="Contains" />
        </Style>
        
        <!-- ContextMenu (ControlTheme override is in Application.Resources) -->
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- MenuItem -->
        <Style Selector="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Triggers for MenuItem States -->
        <Style Selector="MenuItem:not(:empty) /template/ PathIcon#PART_ChevronPath">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Force Chevron Visibility (for empty Initial ItemsSource) -->
        <Style Selector="MenuItem.ForceChevron /template/ PathIcon#PART_ChevronPath">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
             <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
        </Style>
        <Style Selector="MenuItem:pressed /template/ Border#PART_LayoutRoot">
             <Setter Property="Background" Value="{DynamicResource MenuSelectedBrush}"/>
        </Style>
        <Style Selector="MenuItem:disabled">
             <Setter Property="Opacity" Value="0.4"/>
        </Style>
        
        <!-- Separator -->
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            Height="{TemplateBinding Height}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter>
        </Style>
        
        <!-- Special Button Style for Context Menu Top Row -->
        <Style Selector="Button.ContextMenuAction">
            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
        </Style>
        <Style Selector="Button.ContextMenuAction:pointerover">
            <Setter Property="Background" Value="{DynamicResource MenuSelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.ContextMenuAction:pressed">
             <Setter Property="Background" Value="{DynamicResource MenuSelectedBrush}"/>
        </Style>

        <!-- Button.Clear now in BMachineDesignSystem.axaml (ghost) -->
        
        <!-- Button.Primary now in BMachineDesignSystem.axaml -->

        <!-- Button.Accent now in BMachineDesignSystem.axaml -->

        <!-- Button.Action now in BMachineDesignSystem.axaml (primary) -->

        <!-- Button.Muted now in BMachineDesignSystem.axaml (secondary) -->

        <!-- ToolTip now in BMachineDesignSystem.axaml -->

        <Style Selector="Control">
            <Setter Property="ToolTip.ShowDelay" Value="800"/>
        </Style>

        <!-- TextBox/ComboBox now in BMachineDesignSystem.axaml (Radius 6, Bg #0C0C0E) -->

        <!-- ==================================================================== -->
        <!-- TERMINAL TOGGLE SWITCH STYLE (Modern Premium Pill)                  -->
        <!-- Usage: <ToggleButton Classes="Switch"/>                             -->
        <!-- ==================================================================== -->
        <Style Selector="ToggleButton.Switch">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="SwitchTrack"
                            Background="{DynamicResource SwitchOffBackgroundBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SwitchOffBorderBrush}"
                            CornerRadius="12"
                            Width="44" Height="24" Opacity="1">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.25"/>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                            </Transitions>
                        </Border.Transitions>
                        <Grid>
                            <!-- Thumb -->
                            <Border x:Name="SwitchThumb"
                                    Width="18" Height="18"
                                    CornerRadius="9"
                                    Background="{DynamicResource TextSecondaryBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="3,0,0,0"
                                    BoxShadow="0 2 4 0 #40000000">
                                <Border.Transitions>
                                    <Transitions>
                                        <ThicknessTransition Property="Margin" Duration="0:0:0.25">
                                            <ThicknessTransition.Easing>
                                                <SplineEasing X1="0.2" Y1="0" X2="0" Y2="1"/>
                                            </ThicknessTransition.Easing>
                                        </ThicknessTransition>
                                        <BrushTransition Property="Background" Duration="0:0:0.25"/>
                                        <DoubleTransition Property="Width" Duration="0:0:0.15"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Switch: Checked State -->
        <Style Selector="ToggleButton.Switch:checked /template/ Border#SwitchTrack">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="ToggleButton.Switch:checked /template/ Border#SwitchThumb">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="23,0,0,0"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #60000000"/>
        </Style>

        <!-- Switch: Unchecked State -->
        <Style Selector="ToggleButton.Switch:unchecked /template/ Border#SwitchThumb">
            <Setter Property="Margin" Value="3,0,0,0"/>
        </Style>

        <!-- Switch: Hover States -->
        <Style Selector="ToggleButton.Switch:pointerover /template/ Border#SwitchTrack">
            <Setter Property="Background" Value="{DynamicResource SwitchHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="ToggleButton.Switch:checked:pointerover /template/ Border#SwitchTrack">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="ToggleButton.Switch:focus /template/ Border#SwitchTrack">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="ToggleButton.Switch:disabled">
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
        <Style Selector="ToggleButton.Switch:disabled /template/ Border#SwitchTrack">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="ToggleButton.Switch:disabled /template/ Border#SwitchThumb">
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

        <!-- Switch: Pressed States (Thumb stretches slightly) -->
        <Style Selector="ToggleButton.Switch:pressed /template/ Border#SwitchThumb">
            <Setter Property="Width" Value="22"/>
        </Style>
        <Style Selector="ToggleButton.Switch:checked:pressed /template/ Border#SwitchThumb">
            <Setter Property="Margin" Value="19,0,0,0"/>
        </Style>


        <!-- PopupRoot: Standard transparency for popups (Fixes macOS solid white box) -->
        <Style Selector="PopupRoot">
            <Setter Property="TransparencyLevelHint" Value="Transparent" />
        </Style>

    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://BMachine.UI/Styles/TablerIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />

            <!-- ======================================================================== -->
            <!-- CONTEXT MENU ControlTheme Override (overrides Semi.Avalonia default)     -->
            <!-- ======================================================================== -->
            <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                BoxShadow="0 6 16 0 #80000000">
                            <ScrollViewer>
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                                KeyboardNavigation.TabNavigation="Continue"
                                                Grid.IsSharedSizeScope="True"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ======================================================================== -->
            <!-- MENUITEM ControlTheme Override (overrides Semi.Avalonia default)          -->
            <!-- ======================================================================== -->
            <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="Regular"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Panel>
                            <Border Name="PART_LayoutRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Icon / Check -->
                                    <Panel Width="20" Height="20" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center">
                                        <ContentPresenter Name="PART_IconPresenter"
                                                          Content="{TemplateBinding Icon}"
                                                          Width="16" Height="16"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <PathIcon Name="PART_CheckPath"
                                                  Data="{StaticResource IconCheck2}"
                                                  Width="14" Height="14"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  IsVisible="False"/>
                                    </Panel>
                                    <!-- Header -->
                                    <ContentPresenter Name="PART_HeaderPresenter"
                                                      Content="{TemplateBinding Header}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Grid.Column="1"/>
                                    <!-- Input Gesture (Shortcut) -->
                                    <TextBlock Name="PART_InputGestureText"
                                               Grid.Column="2"
                                               Classes="InputGestureText"
                                               Text="{TemplateBinding InputGesture, Converter={StaticResource KeyGestureConverter}}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="20,0,6,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <!-- Submenu Chevron -->
                                    <PathIcon Name="PART_ChevronPath"
                                              Grid.Column="2"
                                              Data="{StaticResource IconChevronRight}"
                                              Width="14" Height="14"
                                              Margin="10,0,6,0"
                                              VerticalAlignment="Center"
                                              IsVisible="False"/>
                                </Grid>
                            </Border>
                            <!-- SubMenu Popup -->
                            <Popup Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="-4"
                                   IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="5"
                                        Margin="4,0,0,0"
                                        BoxShadow="0 4 12 0 #66000000">
                                    <ScrollViewer>
                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        Grid.IsSharedSizeScope="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Panel>
                    </ControlTemplate>
                </Setter>
                <!-- Hover state -->
                <Style Selector="^ /template/ Border#PART_LayoutRoot:pointerover">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Style>
                <!-- MenuItem with children: show chevron -->
                <Style Selector="^:empty /template/ PathIcon#PART_ChevronPath">
                    <Setter Property="IsVisible" Value="False"/>
                </Style>
                <Style Selector="^:not(:empty) /template/ PathIcon#PART_ChevronPath">
                    <Setter Property="IsVisible" Value="True"/>
                </Style>
            </ControlTheme>

            <!-- Fix for DataGrid Fluent Theme Crash: Missing SystemControlTransparentBrush -->
            <SolidColorBrush x:Key="SystemControlTransparentBrush" Color="Transparent" />

            <!-- Card Border Brush (Dynamic) -->
            <SolidColorBrush x:Key="CardBorderBrush" Color="Transparent"/>
            
            <!-- Shared Tabler outline icons are merged from BMachine.UI/Styles/TablerIcons.axaml. -->

            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Light" Source="avares://BMachine.UI/Themes/LightTheme.axaml" />
                <ResourceInclude x:Key="Dark" Source="avares://BMachine.UI/Themes/DarkTheme.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
