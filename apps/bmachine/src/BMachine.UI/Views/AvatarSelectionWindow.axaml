<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BMachine.UI.Views.AvatarSelectionWindow"
        x:Name="Root"
        Title="Select Avatar"
        Width="480" Height="400" MinWidth="400" MinHeight="320"
        WindowStartupLocation="CenterOwner" CanResize="True"
        SystemDecorations="None" Background="Transparent"
        TransparencyLevelHint="Transparent"
        FontFamily="{DynamicResource FontPrimary}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Styles>
        <Style Selector="Button.AvatarItem">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.AvatarItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
        </Style>
    </Window.Styles>
    <Border Background="{DynamicResource AppBackgroundBrush}"
            CornerRadius="{DynamicResource RadiusMd}" ClipToBounds="True"
            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto" Background="{DynamicResource CardBackgroundBrush}">
                <Border Name="DragHeader" Background="Transparent" Padding="16,12"
                        PointerPressed="OnHeaderPointerPressed">
                    <TextBlock Text="Select Avatar" FontWeight="SemiBold" FontSize="14"/>
                </Border>
                <Button Name="CloseButton" Grid.Column="1" Classes="Clear"
                        Width="32" Height="32" Padding="8" Margin="0,4,8,4"
                        Click="OnCancelClick" ToolTip.Tip="Close"
                        AutomationProperties.Name="Close avatar picker">
                    <PathIcon Data="{DynamicResource IconX}" Width="14" Height="14"/>
                </Button>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,128" Margin="16,12">
                <Grid RowDefinitions="Auto,*" Margin="0,0,16,0">
                    <TextBlock Text="Presets" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <ScrollViewer Name="PresetScroll" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="AvatarItem"
                                            Command="{Binding #Root.DataContext.SelectAvatarCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Source}" AutomationProperties.Name="{Binding Source}">
                                        <Border CornerRadius="{DynamicResource RadiusSm}" ClipToBounds="True">
                                            <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                <StackPanel Name="PreviewPanel" Grid.Column="1" Spacing="12">
                    <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Border Width="120" Height="120" HorizontalAlignment="Left"
                            CornerRadius="{DynamicResource RadiusSm}" ClipToBounds="True"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
                        <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"/>
                    </Border>
                    <Button Command="{Binding UploadPhotoCommand}" Content="Upload Photo"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Border Name="DialogFooter" Grid.Row="2" Padding="16,12"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SeparatorBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding DebugStatus}" FontSize="11"
                               Foreground="{DynamicResource StatusDangerBrush}" TextWrapping="Wrap"
                               MaxHeight="36" IsVisible="{Binding DebugStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Click="OnCancelClick" Content="Cancel"/>
                        <Button Command="{Binding ConfirmCommand}" Content="Save" Classes="Primary"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
