<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BMachine.UI.ViewModels"
             xmlns:models="using:BMachine.UI.Models.MantraData"
             xmlns:local="using:BMachine.UI.Views"
             xmlns:converters="using:BMachine.UI.Converters"
             x:Class="BMachine.UI.Views.MantraDataView"
             x:DataType="vm:MantraDataViewModel"
             Background="Transparent"
             DragDrop.AllowDrop="True">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextSheetCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousSheetCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Resources>
        <local:PhotoFilterEqualsConverter x:Key="FilterEq"/>
        <converters:WorkflowStepColorConverter x:Key="WorkflowStepColorConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Application Default Typography --><!-- DataGrid Excel-Like Minimalist Dark: Solid border, absolutely no jump/scale animation on click.
             Cell selection is driven by code (per-cell Background/BorderBrush), not by row selection. -->
        <Style Selector="DataGridCell">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Mask Avalonia theme row-based cell highlight; real per-cell highlight is applied in code -->
        <Style Selector="DataGridCell:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridCell:current">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="DataGridColumnHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Tool Buttons: Explicit ContentPresenter background prevents transparent button bug -->
        <Style Selector="Button.ToolBtn">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.ToolBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.ToolBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.ToolBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
        </Style>

        <!-- Primary Action Button: Explicit ContentPresenter background prevents transparent button bug -->
        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.ActionBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.ActionBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryPressedBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>

        <!-- Multi-sheet Tab Items -->
        <Style Selector="ListBox.SheetTabs ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBox.SheetTabs ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBox.SheetTabs ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="ListBox.SheetTabs ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.SegTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.SegTab:pointerover">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.SegTab.Active">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>

        <!-- Opsi di dalam popup sortir status foto -->
        <Style Selector="Button.FilterOption">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.FilterOption:pointerover">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
        </Style>
        <Style Selector="Button.FilterOption:pressed">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBrush}"/>
        </Style>
        <Style Selector="Button.FilterOption:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.FilterOption.Active">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <Grid Grid.Row="0" Margin="0,2,0,8" RowDefinitions="Auto, Auto">
            <DockPanel Grid.Row="0" LastChildFill="False" Background="{DynamicResource BgInputBrush}">
                <Menu DockPanel.Dock="Left" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12">
                    <MenuItem Header="File">
                        <MenuItem Header="Tabel Baru" Command="{Binding NewTableCommand}" InputGesture="Ctrl+N"/>
                        <MenuItem Header="Buka File Excel/Word..." Click="OnOpenFileClicked" InputGesture="Ctrl+O"/>
                        <MenuItem Header="Simpan ke DATER" Command="{Binding ExportDaterCommand}" InputGesture="Ctrl+S"/>
                        <MenuItem Header="Tutup Data (Clear)" Command="{Binding ClearDataCommand}" InputGesture="Ctrl+W"/>
                    </MenuItem>
                    <MenuItem Header="Edit">
                        <MenuItem Header="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" InputGesture="Ctrl+Z"/>
                        <MenuItem Header="Redo" Command="{Binding RedoLastCommand}" IsEnabled="{Binding CanRedo}" InputGesture="Ctrl+Shift+Z"/>
                    </MenuItem>
                    <MenuItem Header="Data">
                        <MenuItem Header="Pembersihan Cepat (AI/Rule)..." Command="{Binding OpenCleanerDialogCommand}" InputGesture="F3"/>
                        <MenuItem Header="Atur Kolom..." Command="{Binding OpenTransformDialogCommand}" InputGesture="F8"/>
                        <MenuItem Header="Rapikan Semua (Smart Clean)" Command="{Binding CleanupAllCommand}"/>
                    </MenuItem>
                    <MenuItem Header="Bantuan">
                        <MenuItem Header="Laporkan Bug..." Click="OnReportBugClick" InputGesture="F1"/>
                    </MenuItem>
                </Menu>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Atur Kolom" Classes="ToolBtn"
                            MinHeight="32" Padding="12,5" Margin="0,0,6,0"
                            ToolTip.Tip="Buka susunan kolom hasil (Atur Kolom, F8)"
                            Command="{Binding OpenTransformDialogCommand}"/>
                    <Button Content="Proses Photoshop" Classes="ToolBtn" MinHeight="32" Padding="12,5"
                            Command="{Binding ProcessPhotoshopCommand}"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- WORKFLOW INDICATOR: Import → Clean → Transform → Export → Done -->
        <Border Grid.Row="1" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4"
                Padding="8,6" Margin="0,2,0,4" IsVisible="{Binding HasData}">
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <!-- Step 1: Import -->
                <Border Padding="10,4" CornerRadius="4" Background="{Binding CurrentWorkflowStep, Converter={StaticResource WorkflowStepColorConverter}, ConverterParameter=Import}" Margin="0,0,2,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="📥" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Import" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="→" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                
                <!-- Step 2: Clean -->
                <Border Padding="10,4" CornerRadius="4" Background="{Binding CurrentWorkflowStep, Converter={StaticResource WorkflowStepColorConverter}, ConverterParameter=Clean}" Margin="0,0,2,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="🧹" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Clean" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="→" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                
                <!-- Step 3: Transform -->
                <Border Padding="10,4" CornerRadius="4" Background="{Binding CurrentWorkflowStep, Converter={StaticResource WorkflowStepColorConverter}, ConverterParameter=Transform}" Margin="0,0,2,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="✨" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Transform" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="→" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                
                <!-- Step 4: Export -->
                <Border Padding="10,4" CornerRadius="4" Background="{Binding CurrentWorkflowStep, Converter={StaticResource WorkflowStepColorConverter}, ConverterParameter=Export}" Margin="0,0,2,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="💾" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Export" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="→" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                
                <!-- Step 5: Done -->
                <Border Padding="10,4" CornerRadius="4" Background="{Binding CurrentWorkflowStep, Converter={StaticResource WorkflowStepColorConverter}, ConverterParameter=Done}" Margin="0,0,2,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="✅" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Done" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Sheet tabs (kiri) + tombol sortir status foto dengan popup (kanan) -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4"
                    Padding="4,2" Margin="0,2,0,0" IsVisible="{Binding HasData}">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                    <!-- Kiri: tab sheet -->
                    <DockPanel Grid.Column="0">
                        <TextBlock Text="Sheet:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,8,0"/>
                        <ListBox Classes="SheetTabs" ItemsSource="{Binding SheetNames}" SelectedIndex="{Binding CurrentSheetIndex, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </DockPanel>

                    <!-- Tengah: kotak pencarian cepat (filter real-time) -->
                    <TextBox Grid.Column="1" x:Name="QuickSearchBox"
                             Text="{Binding SearchFilter, Mode=TwoWay}"
                             Height="24" MinWidth="220" MaxWidth="360" Margin="8,0"
                             HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4"
                             Padding="8,0" FontSize="11.5"
                             Watermark="Cari data... (nama, NIS, dll)"/>

                    <!-- Kanan: tombol pembuka popup sortir status foto -->
                    <Button Grid.Column="2" x:Name="PhotoFilterButton" Classes="SegTab"
                            VerticalAlignment="Center" Margin="0,0,2,0" MinHeight="24" Padding="10,3"
                            Click="OnPhotoFilterButtonClicked">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock x:Name="PhotoFilterButtonLabel" Text="Status Foto" VerticalAlignment="Center"/>
                            <Border CornerRadius="7" Padding="6,0" Background="{DynamicResource ButtonSecondaryBackgroundBrush}">
                                <TextBlock x:Name="PhotoFilterButtonCount" Text="{Binding TotalRows}"
                                           FontSize="9.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Border>
                            <PathIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Popup dropdown pilihan filter status foto -->
            <Popup x:Name="PhotoFilterPopup" Grid.Row="1"
                   PlacementTarget="{Binding #PhotoFilterButton}"
                   Placement="BottomEdgeAlignedRight"
                   HorizontalOffset="0" VerticalOffset="4"
                   IsLightDismissEnabled="True">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderHoverBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="6" BoxShadow="0 6 20 8 #33000000" MinWidth="200">
                    <StackPanel x:Name="PhotoFilterList" Orientation="Vertical" Spacing="2">
                        <Button Classes="FilterOption" Tag="SEMUA" Click="OnPhotoFilterOptionClicked">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Semua" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalRows}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Classes="FilterOption" Tag="REVIEW" Click="OnPhotoFilterOptionClicked">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Perlu Review" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ReviewCount}" FontSize="11" Foreground="{DynamicResource LogWarningBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Classes="FilterOption" Tag="GANDA" Click="OnPhotoFilterOptionClicked">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Ambigu / Ganda" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding GandaCount}" FontSize="11" Foreground="{DynamicResource LogInfoBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Classes="FilterOption" Tag="COCOK" Click="OnPhotoFilterOptionClicked">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Cocok" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CocokCount}" FontSize="11" Foreground="{DynamicResource LogSuccessBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Classes="FilterOption" Tag="BELUM" Click="OnPhotoFilterOptionClicked">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Belum Ada" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding BelumCount}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

        <!-- Data appears after source file loads. -->
        <!-- Main content area: Empty state shown when no data; DataGrid shown when data loaded -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid x:Name="GridContainer">
                <DataGrid x:Name="MainDataGrid"
                          IsVisible="{Binding HasData}"
                          ItemsSource="{Binding FilteredRows}"
                          AutoGenerateColumns="False"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="True"
                          CanUserSortColumns="False"
                          SelectionMode="Extended"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          FrozenColumnCount="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          BorderThickness="0"
                          Background="Transparent"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          HorizontalGridLinesBrush="{DynamicResource SeparatorBrush}"
                          VerticalGridLinesBrush="{DynamicResource SeparatorBrush}"
                          SelectionChanged="OnDataGridSelectionChanged"
                          BeginningEdit="OnDataGridBeginningEdit"
                          CellEditEnded="OnDataGridCellEditEnded"
                          DoubleTapped="OnDataGridDoubleTapped"
                          PointerPressed="OnDataGridPointerPressed">

                    <!-- Context Menu -->
                    <!-- Context Menu -->
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Opened="OnContextMenuOpened">
                            <!-- Common table and selection actions -->
                            <MenuItem Tag="Copy" Header="Salin" InputGesture="Ctrl+C" Click="OnMenuCopyClicked"/>
                            <MenuItem Tag="Paste" Header="Tempel" InputGesture="Ctrl+V" Click="OnMenuPasteClicked"/>
                            <MenuItem Tag="FindReplace" Header="Cari dan Ganti..." InputGesture="Ctrl+F" Click="OnMenuFindReplaceClicked"/>
                            <Separator Background="{DynamicResource BgHoverBrush}"/>

                            <!-- Row actions -->
                            <MenuItem Tag="InsertRow" Header="Tambah Baris Baru" Click="OnMenuInsertRowClicked"/>
                            <MenuItem Tag="ColorTag" Header="Tandai Baris (Warna)">
                                <MenuItem Tag="ColorGreen" Header="Hijau (Valid)" Click="OnMenuColorGreenClicked"/>
                                <MenuItem Tag="ColorBlue" Header="Biru (Info)" Click="OnMenuColorBlueClicked"/>
                                <MenuItem Tag="ColorAmber" Header="Kuning (Periksa)" Click="OnMenuColorAmberClicked"/>
                                <MenuItem Tag="ColorRed" Header="Merah (Error)" Click="OnMenuColorRedClicked"/>
                                <Separator Background="{DynamicResource BgHoverBrush}"/>
                                <MenuItem Tag="ColorClear" Header="Hapus Tanda Warna" Click="OnMenuColorClearClicked"/>
                            </MenuItem>
                            <Separator Background="{DynamicResource BgHoverBrush}"/>

                            <!-- Transform and format actions -->
                            <MenuItem Tag="GenderTransform" Header="L/P → Jenis Kelamin" Click="OnQuickGenderTransformClicked"/>
                            <MenuItem Tag="DateTransform" Header="dd-MM-yyyy → Tanggal Indonesia" Click="OnQuickDateTransformClicked"/>
                            <MenuItem Tag="TitleCase" Header="Rapikan Teks (Title Case)" Click="OnMenuTitleCaseClicked"/>
                            <MenuItem Tag="DateFormatFull" Header="Format Tanggal (DD MMMM YYYY)" Click="OnMenuDateFormatFullClicked"/>
                            <MenuItem Tag="PhonePrefix" Header="Format No. HP (+62 / 08)" Click="OnMenuPhonePrefixClicked"/>
                            <Separator Background="{DynamicResource BgHoverBrush}"/>

                            <!-- Less frequent data restructuring -->
                            <MenuItem Tag="CustomMerge" Header="Gabung Kolom..." Click="OnMenuCustomMergeClicked"/>
                            <MenuItem Tag="SplitColumn" Header="Pisah Kolom (Split)..." Click="OnMenuSplitColumnClicked"/>
                            <Separator Background="{DynamicResource BgHoverBrush}"/>

                            <!-- Column management -->
                            <MenuItem Tag="AutoFit" Header="Otomatis Ukuran Kolom" Click="OnMenuAutoFitClicked"/>
                            <MenuItem Tag="InsertColumnLeft" Header="Sisipkan Kolom di Kiri" Click="OnMenuInsertColumnLeftClicked"/>
                            <MenuItem Tag="InsertColumnRight" Header="Sisipkan Kolom di Kanan" Click="OnMenuInsertColumnRightClicked"/>
                            <MenuItem Tag="MoveColumnLeft" Header="Pindahkan Kolom ke Kiri" Click="OnMenuMoveColumnLeftClicked"/>
                            <MenuItem Tag="MoveColumnRight" Header="Pindahkan Kolom ke Kanan" Click="OnMenuMoveColumnRightClicked"/>
                            <MenuItem Tag="RenameColumn" Header="Ganti Nama Kolom..." Click="OnMenuRenameColumnClicked"/>
                            <Separator Background="{DynamicResource BgHoverBrush}"/>

                            <!-- Destructive actions stay near the end -->
                            <MenuItem Tag="ClearCells" Header="Kosongkan Sel" InputGesture="Delete" Click="OnMenuClearCellsClicked"/>
                            <MenuItem Tag="DeleteRows" Header="Hapus Baris Terpilih" Click="OnMenuDeleteRowsClicked"/>
                            <MenuItem Tag="DeleteColumn" Header="Hapus Kolom Ini" Click="OnMenuDeleteColumnClicked"/>
                            <Separator Background="{DynamicResource BgHoverBrush}"/>

                            <!-- Context-menu settings -->
                            <MenuItem Header="Atur Menu Klik Kanan..." Click="OnMenuConfigureContextMenuClicked"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <Border x:Name="EmptyPrompt" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="10" Margin="24" IsVisible="{Binding !HasData}">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="820" Margin="0,10">
                        <StackPanel Orientation="Vertical" Spacing="22">

                            <!-- Header -->
                            <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="MANTRADATA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" LetterSpacing="3"/>
                                <TextBlock Text="Mulai Pencocokan Data" FontSize="26" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Pilih data utama untuk mulai. Folder foto dan master PSD bersifat opsional dan bisa diatur kapan saja."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="560" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Step Cards -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Center">
                                <Grid.MaxWidth>780</Grid.MaxWidth>

                                <!-- Step 1 -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16,14" Margin="6" MaxWidth="240">
                                    <StackPanel Orientation="Vertical" Spacing="6">
                                        <TextBlock Text="01" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="Pilih Data Utama" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource ButtonSecondaryForegroundBrush}"/>
                                        <TextBlock Text="File Excel atau Word berisi tabel nama yang akan dicocokkan dengan foto."
                                                   FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                        <Button Classes="ActionBtn" Content="Buka File Excel / Word" MinHeight="32"
                                                HorizontalAlignment="Stretch" Click="OnOpenFileClicked" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Step 2 -->
                                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16,14" Margin="6" MaxWidth="240">
                                    <StackPanel Orientation="Vertical" Spacing="6">
                                        <TextBlock Text="02" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="Master PSD" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource ButtonSecondaryForegroundBrush}"/>
                                        <TextBlock Text="Template Photoshop untuk pengisian otomatis. Opsional."
                                                   FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                        <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6"
                                                Padding="8,4" HorizontalAlignment="Left" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding MasterPsdStatus}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <Button Classes="ToolBtn" Content="Pilih folder PSD" MinHeight="32"
                                                HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                                Command="{Binding PickMasterPsdFolderCommand}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Step 3 -->
                                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16,14" Margin="6" MaxWidth="240">
                                    <StackPanel Orientation="Vertical" Spacing="6">
                                        <TextBlock Text="03" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="Folder Foto" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource ButtonSecondaryForegroundBrush}"/>
                                        <TextBlock Text="Kumpulan foto peserta. Pencocokan otomatis berjalan setelah data dimuat."
                                                   FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                        <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6"
                                                Padding="8,4" HorizontalAlignment="Left" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding PhotoFolderStatus}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <Button Classes="ToolBtn" Content="Pilih folder foto" MinHeight="32"
                                                HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                                Command="{Binding PickPhotoFolderCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Hint + Shortcuts -->
                            <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Center">
                                <TextBlock Text="Seret file langsung ke area ini, atau gunakan pintasan berikut"
                                           Foreground="{DynamicResource TextFaintBrush}" FontSize="11" TextAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="Ctrl+N  Tabel Baru" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="F3  Pembersihan AI" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="F8  Atur Kolom" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="Ctrl+F  Cari &amp; Ganti" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Drag Glow Overlay (Pure Text, No Icons) -->
                <Border x:Name="DragOverlay" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="2"
                        CornerRadius="10" IsVisible="False" IsHitTestVisible="False">
                    <TextBlock Text="Lepaskan di sini — Excel/Word untuk data, folder JPG untuk foto, folder PSD untuk master"
                               FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource AccentColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Fill Handle: kotak kecil pojok kanan-bawah ActiveCell (Excel) -->
                <Border x:Name="FillHandle"
                        IsVisible="False"
                        IsHitTestVisible="True"
                        Width="7" Height="7"
                        Background="{DynamicResource AccentColorBrush}"
                        BorderBrush="{DynamicResource TextPrimaryBrush}"
                        BorderThickness="0.5"
                        CornerRadius="1"
                        Cursor="Cross"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        PointerPressed="OnFillHandlePointerPressed"
                        PointerMoved="OnFillHandlePointerMoved"
                        PointerReleased="OnFillHandlePointerReleased"/>
</Grid>
        </Border>

        <!-- Floating: Dropdown Cari & Ganti Cepat (menurun ke bawah, rata tengah dgn kotak Cari data) -->
        <Border Grid.Row="1" IsVisible="{Binding IsAdvancedSearchOpen}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,31,0"
                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,8" BoxShadow="0 4 16 6 #1A000000">
            <StackPanel Orientation="Vertical" Spacing="6" Width="140">
                <TextBlock Text="Ganti dengan" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                <TextBox Text="{Binding ReplaceText, Mode=TwoWay}" MinHeight="32"
                         VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,0" FontSize="11"
                         Watermark="Ganti teks..."/>
                <Button Content="Ganti Semua" Classes="ToolBtn" MinHeight="32" Padding="12,5"
                        FontWeight="SemiBold"
                        Command="{Binding QuickReplaceAllCommand}"/>
            </StackPanel>
        </Border>

        <!-- ═══ 3. STATUS BAR FOOTER BENTO (Pure Text) ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,6" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsLoading}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <!-- Info master PSD -->
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="PSD" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MasterPsdStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Width="1" Height="12" Background="{DynamicResource ButtonSecondaryHoverBrush}" VerticalAlignment="Center"/>
                    <!-- Info folder foto (JPG dihitung) -->
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="FOTO" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PhotoFolderStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Width="1" Height="12" Background="{DynamicResource ButtonSecondaryHoverBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusBarAggregatesText" Text=""
                               FontSize="11" Foreground="{DynamicResource AccentColorBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Width="1" Height="12" Background="{DynamicResource ButtonSecondaryHoverBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalRows, StringFormat='Data: {0} baris'}"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedRowCount, StringFormat='Terpilih: {0}'}"
                               FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
