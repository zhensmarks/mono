<UserControl xmlns="https://github.com/avaloniaui" xmlns:views="using:BMachine.UI.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BMachine.UI.ViewModels"
             xmlns:models="using:BMachine.UI.Models"
             xmlns:controls="using:BMachine.UI.Controls"
             x:Class="BMachine.UI.Views.CardDetailPanelHost"
             x:DataType="vm:BaseTrelloListViewModel">
    <Grid>
        <!-- Side Panel: Card Details -->
        <Border x:Name="Part_DetailPanel" HorizontalAlignment="Stretch"  Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource PanelDividerBrush}" BorderThickness="1,0,0,0"
                IsVisible="{Binding IsDetailPanelOpen}"
                PointerPressed="OnDetailPanelPointerPressed">
            <Grid RowDefinitions="Auto, *, Auto" Margin="20">
                <ScrollViewer x:Name="Part_DetailScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Margin="0">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="4">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="8,4" Margin="0,0,8,0" IsVisible="{Binding SelectedCard.HasCoverDisplayName}">
                                        <TextBlock Text="{Binding SelectedCard.CoverDisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="8,4" Margin="0,0,8,0" IsVisible="{Binding SelectedCard.HasEventDate}">
                                        <TextBlock Text="{Binding SelectedCard.EventDateText}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding SelectedCard.Name}" FontWeight="Bold" FontSize="24" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="32"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding $parent[UserControl].DataContext.CloseDetailPanelCommand}"
                                    Classes="PanelClose" VerticalAlignment="Top">
                                <PathIcon Data="{StaticResource IconX}"/>
                            </Button>
                        </Grid>

                        <WrapPanel Orientation="Horizontal">
                            <!-- ID Badge -->
                            <Button Command="{Binding OpenSpreadsheetAndSearchCommand}" CommandParameter="{Binding SelectedCard.DisplayId}"
                                    IsVisible="{Binding SelectedCard.HasDisplayId}" Cursor="Hand" ToolTip.Tip="Click to Open Sheet &amp; Search ID"
                                    Classes="Muted" Height="30" Padding="10,0" CornerRadius="{DynamicResource RadiusSm}" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="ID:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedCard.DisplayId}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Attachments Badge -->
                            <Button Command="{Binding $parent[UserControl].DataContext.ShowAttachmentsCommand}" CommandParameter="{Binding SelectedCard}"
                                    IsVisible="{Binding SelectedCard.HasAttachments}" Cursor="Hand" ToolTip.Tip="View Attachments"
                                    Classes="Muted" Height="30" Padding="10,0" CornerRadius="{DynamicResource RadiusSm}" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="Attachments:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedCard.AttachmentCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Due Date Badge -->
                            <Border Background="{DynamicResource ButtonSecondaryBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Height="30" Padding="10,0" Margin="0,0,8,6" VerticalAlignment="Center"
                                    IsVisible="{Binding SelectedCard.DueDateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="Due:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedCard.DueDateText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Labels -->
                            <ItemsControl ItemsSource="{Binding SelectedCard.Labels}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding BgColorHex}" BorderBrush="{Binding BorderColorHex}" BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusSm}" Padding="10,5" Margin="0,0,8,6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding TextColorHex}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>

                        <!-- ACTION BUTTONS -->
                        <Separator Margin="0,4,0,10"/>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <!-- Comment Button -->
                            <Button Command="{Binding $parent[UserControl].DataContext.ShowCommentsCommand}" CommandParameter="{Binding SelectedCard}"
                                    Classes="Muted" Height="32" Padding="12,0" CornerRadius="{DynamicResource RadiusSm}" Margin="0,0,8,6" Cursor="Hand" ToolTip.Tip="Comments">
                                <TextBlock Text="Comment" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Button>
                            
                            <!-- Checklist Button -->
                            <Button Command="{Binding $parent[UserControl].DataContext.ShowChecklistsCommand}" CommandParameter="{Binding SelectedCard}"
                                    Classes="Muted" Height="32" Padding="12,0" CornerRadius="{DynamicResource RadiusSm}" Margin="0,0,8,6" Cursor="Hand" ToolTip.Tip="Checklists">
                                <TextBlock Text="Checklist" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Button>
                            
                            <!-- Move Button -->
                            <Button Command="{Binding $parent[UserControl].DataContext.StartMoveCardCommand}" CommandParameter="{Binding SelectedCard}"
                                    IsEnabled="{Binding IsOnline}" IsVisible="{Binding !SelectedCard.IsManual}"
                                    Classes="Muted" Height="32" Padding="12,0" CornerRadius="{DynamicResource RadiusSm}" Margin="0,0,8,6" Cursor="Hand" ToolTip.Tip="Move Card">
                                <TextBlock Text="Move" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Button>
                            
                            <!-- Unlink Button -->
                            <Button Command="{ReflectionBinding $parent[UserControl].DataContext.RemoveManualCardCommand}" CommandParameter="{Binding SelectedCard}"
                                    IsVisible="{Binding SelectedCard.IsManual}"
                                    Classes="Muted" Height="32" Padding="12,0" CornerRadius="{DynamicResource RadiusSm}" Margin="0,0,8,6" Cursor="Hand" ToolTip.Tip="Unlink Card">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Unlink" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <Separator Margin="0,6,0,0"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Description" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" BringIntoViewOnFocusChange="False">
                                <controls:FormattedTextBlock Text="{Binding SelectedCard.Description}"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             FontSize="12"/>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Side Panel: Comments -->
        <Border x:Name="Part_CommentPanel" HorizontalAlignment="Stretch"  Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="0"
                IsVisible="{Binding IsCommentPanelOpen}"
                PointerPressed="OnSubPanelPointerPressed">
            <Grid RowDefinitions="Auto, *, Auto" Margin="20">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Comments" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Left" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding SelectedCard.Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300" TextAlignment="Left" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                        <Button Command="{Binding $parent[UserControl].DataContext.ToggleShowActivityCommand}"
                                Classes="Muted" Height="32" Padding="12,0" CornerRadius="{DynamicResource RadiusSm}" Cursor="Hand" VerticalAlignment="Center"
                                ToolTip.Tip="Show / hide activity">
                            <Grid>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Hide details" VerticalAlignment="Center"
                                           IsVisible="{Binding $parent[UserControl].DataContext.ShowActivity}"/>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Show details" VerticalAlignment="Center"
                                           IsVisible="{Binding !$parent[UserControl].DataContext.ShowActivity}"/>
                            </Grid>
                        </Button>
                        <Button Classes="ghostIcon" Click="OnOpenCommentWindowClicked"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip.Tip="Open in New Window" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconOpenWindow}" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                        <Button Command="{Binding $parent[UserControl].DataContext.CloseCommentsPanelCommand}"
                                Classes="PanelClose" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconX}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <views:CommentListView Grid.Row="1"/>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <StackPanel VerticalAlignment="Bottom" Spacing="8">
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSm}" Padding="8" Margin="0,0,0,8"
                                IsVisible="{Binding HasPendingAttachments}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Attachments" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding PendingAttachments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:PendingAttachmentItem">
                                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="4" Margin="0,0,6,6"
                                                    Width="70" Height="70" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                           IsVisible="{Binding IsImage}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <StackPanel IsVisible="{Binding !IsImage}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                                        <PathIcon Data="{StaticResource IconFile}" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding FileName}" FontSize="8" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" MaxWidth="60"/>
                                                    </StackPanel>
                                                    <Button Command="{Binding $parent[UserControl].DataContext.RemoveAttachmentCommand}" CommandParameter="{Binding}"
                                                            Width="16" Height="16" CornerRadius="{DynamicResource RadiusSm}" Padding="0"
                                                            Background="{DynamicResource OverlayBrush}" BorderThickness="0" Cursor="Hand"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <TextBlock Text="X" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSm}" Padding="10" Margin="0,0,0,8"
                                IsVisible="{Binding IsPresetPanelOpen}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Quick Replies (Max 5)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                <ItemsControl ItemsSource="{Binding CommentPresets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                                <Button Classes="ghost" Command="{Binding $parent[UserControl].DataContext.UsePresetCommand}" CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                         BorderThickness="0" Padding="8,4" Cursor="Hand">
                                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Button>
                                                <Button Classes="ghostIcon" Grid.Column="1" Command="{Binding $parent[UserControl].DataContext.DeleteCommentPresetCommand}" CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand">
                                                    <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" Foreground="{DynamicResource StatusDangerBrush}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding CommentPresets.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBox Text="{Binding NewPresetText}" Watermark="New preset... (Enter to save)"
                                             Background="Transparent" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="8" Margin="0,0,8,0">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding $parent[UserControl].DataContext.AddCommentPresetCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <Button Classes="ghostIcon" Grid.Column="1" Command="{Binding $parent[UserControl].DataContext.AddCommentPresetCommand}"
                                            Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" ToolTip.Tip="Save Preset">
                                        <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Foreground="{DynamicResource StatusSuccessBrush}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSm}" Padding="6" Margin="0,0,0,4" MaxHeight="140"
                                IsVisible="{Binding IsMentionPopupOpen}">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding FilteredMembers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:TrelloMember">
                                            <Button Classes="ghost" Command="{Binding $parent[UserControl].DataContext.SelectMentionCommand}" CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                     BorderThickness="0" Padding="6,4" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="22" Height="22" CornerRadius="{DynamicResource RadiusSm}" Background="{DynamicResource AccentColorBrush}">
                                                        <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="#0A0A0A" FontWeight="Bold" FontSize="9"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" FontSize="11"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <TextBox x:Name="Part_CommentTextBox"
                                     Text="{Binding NewCommentText}" Watermark="Write a comment... (@mention)"
                                     Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="20" Padding="12,10"
                                     Margin="0" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="40" MaxHeight="120" FontSize="13">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding $parent[UserControl].DataContext.SendCommentCommand}"/>
                            </TextBox.KeyBindings>
                            <TextBox.InnerLeftContent>
                                <Button Classes="ghostIcon" x:Name="Part_InlineAttachButton"
                                        Command="{Binding $parent[UserControl].DataContext.AddAttachmentCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="8,0,0,0" Margin="0" Cursor="Hand"
                                        ToolTip.Tip="Attach Image">
                                    <PathIcon Data="{StaticResource IconPaperclip}" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                            </TextBox.InnerLeftContent>
                                <TextBox.InnerRightContent>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" VerticalAlignment="Bottom">
                                        <Button Classes="ghostIcon" Command="{Binding $parent[UserControl].DataContext.TogglePresetPanelCommand}"
                                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip.Tip="Quick Replies"
                                                Width="32" Height="32" Margin="0,0,0,4">
                                            <Border Background="{DynamicResource SeparatorBrush}" CornerRadius="{DynamicResource RadiusPill}" Width="32" Height="32">
                                                <PathIcon Data="{StaticResource IconChevronUp}" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </Button>
                                        <Button Classes="ghostIcon" Command="{Binding $parent[UserControl].DataContext.SendCommentCommand}"
                                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip.Tip="Send Comment"
                                                Width="32" Height="32" Margin="0,0,0,4">
                                            <Border Background="{DynamicResource AccentColorBrush}" CornerRadius="{DynamicResource RadiusPill}" Width="32" Height="32">
                                                <PathIcon Data="{StaticResource IconSend}" Width="14" Height="14" Foreground="White" Margin="2,0,0,0"/>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </TextBox.InnerRightContent>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Side Panel: Checklist -->
        <Border x:Name="Part_ChecklistPanel" HorizontalAlignment="Stretch"  Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="0"
                IsVisible="{Binding IsChecklistPanelOpen}"
                PointerPressed="OnSubPanelPointerPressed">
            <Grid RowDefinitions="Auto, *, Auto" Margin="20">
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Checklists" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Left" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding SelectedCard.Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300" TextAlignment="Left" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding $parent[UserControl].DataContext.CloseChecklistPanelCommand}"
                            Classes="PanelClose" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconX}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="20">
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingChecklists}" Height="4" Margin="0,20" Foreground="{DynamicResource AccentColorBrush}" CornerRadius="{DynamicResource RadiusXxs}"/>
                        <TextBlock Text="No checklists found." IsVisible="{Binding !Checklists.Count}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>

                        <ListBox ItemsSource="{Binding Checklists}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerTheme>
                                <ControlTheme TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </ControlTheme>
                            </ListBox.ItemContainerTheme>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="10" Margin="0,0,0,24">
                                        <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,4">
                                            <PathIcon Data="{StaticResource IconCheckSquare}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                            <Button Classes="ghostIcon" Grid.Column="2"
                                                    Command="{Binding $parent[UserControl].DataContext.DeleteChecklistCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="8,4" Cursor="Hand" ToolTip.Tip="Delete Checklist">
                                                <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" Foreground="{DynamicResource StatusDangerBrush}"/>
                                            </Button>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              Content="{Binding Name}" Margin="5,2"
                                                              Command="{Binding $parent[UserControl].DataContext.ToggleCheckItemCommand}"
                                                              CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusXl}" Padding="16" IsVisible="{Binding IsDuplicateMode}" Margin="0,0,0,10" BoxShadow="0 4 12 0 #10000000">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Duplicate Checklist" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Spacing="5">
                                <TextBlock Text="New Name:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding DuplicateChecklistName}" Watermark="#EDITING USER_PROFILE" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Source:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Grid ColumnDefinitions="*, Auto">
                                    <Border Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="{DynamicResource RadiusMd}">
                                        <AutoCompleteBox x:Name="Part_ChecklistSourceBox" Grid.Column="0" ItemsSource="{Binding Checklists}"
                                                         SelectedItem="{Binding SelectedSourceChecklist}"
                                                         ValueMemberBinding="{Binding Name}"
                                                         Watermark="Select source..."
                                                         HorizontalAlignment="Stretch"
                                                         FilterMode="Contains"
                                                         MinimumPrefixLength="0"
                                                         MaxDropDownHeight="160" Background="Transparent" BorderThickness="0" Padding="10,8" FontSize="13"/>
                                    </Border>
                                    <Button Classes="ghost" Grid.Column="1" Content="X" ToolTip.Tip="Clear"
                                             BorderThickness="0" Padding="6,4" Cursor="Hand"
                                            Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                                            Command="{Binding $parent[UserControl].DataContext.ClearSourceChecklistCommand}"
                                            IsVisible="{Binding SelectedSourceChecklist, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                </Grid>
                            </StackPanel>
                            <Grid ColumnDefinitions="*, *" Margin="0,5,0,0">
                                <Button Grid.Column="0" Content="Cancel" Command="{Binding $parent[UserControl].DataContext.ToggleDuplicateModeCommand}"
                                        Classes="secondary" HorizontalAlignment="Stretch" Height="36" Padding="16,0"/>
                                <Button Grid.Column="1" Content="Create Copy" Command="{Binding $parent[UserControl].DataContext.DuplicateChecklistCommand}"
                                        Classes="primary" HorizontalAlignment="Stretch" Height="36" Padding="16,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding $parent[UserControl].DataContext.ToggleDuplicateModeCommand}"
                            IsVisible="{Binding !IsDuplicateMode}"
                            Classes="primary" HorizontalAlignment="Center" Height="36" Padding="16,0" Cursor="Hand"
                            Content="Duplicate Checklist"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Side Panel: Move Card -->
        <Border x:Name="Part_MovePanel" HorizontalAlignment="Stretch"  Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="0"
                IsVisible="{Binding IsMovePanelOpen}"
                PointerPressed="OnSubPanelPointerPressed">
            <Grid RowDefinitions="Auto, *, Auto" Margin="20">
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Move Card" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Left" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding SelectedCard.Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300" TextAlignment="Left" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding $parent[UserControl].DataContext.CloseMovePanelCommand}"
                            Classes="PanelClose" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconX}"/>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="20">
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingMoveData}" Height="4" Margin="0,0,0,10" Foreground="{DynamicResource AccentColorBrush}" CornerRadius="{DynamicResource RadiusXxs}"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Destination Board" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="{DynamicResource RadiusXl}">
                            <AutoCompleteBox x:Name="Part_MoveBoardBox" ItemsSource="{Binding AvailableBoards}"
                                             SelectedItem="{Binding SelectedMoveBoard}"
                                             ValueMemberBinding="{Binding Name}"
                                             Watermark="Search board..."
                                             HorizontalAlignment="Stretch"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="0"
                                             MaxDropDownHeight="160"
                                             Background="Transparent" BorderThickness="0" Padding="12,10" FontSize="13"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Destination List" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="{DynamicResource RadiusXl}">
                            <AutoCompleteBox x:Name="Part_MoveListBox" ItemsSource="{Binding AvailableLists}"
                                             SelectedItem="{Binding SelectedMoveList}"
                                             ValueMemberBinding="{Binding Name}"
                                             Watermark="Search list..."
                                             HorizontalAlignment="Stretch"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="0"
                                             IsEnabled="{Binding SelectedMoveBoard, Converter={x:Static ObjectConverters.IsNotNull}}"
                                             MaxDropDownHeight="160"
                                             Background="Transparent" BorderThickness="0" Padding="12,10" FontSize="13"/>
                        </Border>
                    </StackPanel>

                    <Button Command="{Binding $parent[UserControl].DataContext.MoveCardCommand}"
                            Classes="primary"
                            Height="38" Padding="16,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Margin="0,10,0,0"
                            IsEnabled="{Binding SelectedMoveList, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Content="Confirm Move"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Side Panel: Attachments -->
        <Border x:Name="Part_AttachmentPanel" HorizontalAlignment="Stretch"  Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="0"
                IsVisible="{Binding IsAttachmentPanelOpen}"
                PointerPressed="OnSubPanelPointerPressed">
            <Grid RowDefinitions="Auto, *, Auto" Margin="20">
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Attachments" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Left" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding SelectedCard.Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300" TextAlignment="Left" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding $parent[UserControl].DataContext.CloseAttachmentPanelCommand}"
                            Classes="PanelClose" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconX}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="20">
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingAttachments}" Height="4" Margin="0,20" Foreground="{DynamicResource AccentColorBrush}" CornerRadius="{DynamicResource RadiusXxs}"/>
                        <TextBlock Text="No attachments." IsVisible="{Binding !Attachments.Count}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>

                        <ListBox ItemsSource="{Binding Attachments}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Classes="attachWrap"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerTheme>
                                <ControlTheme TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </ControlTheme>
                            </ListBox.ItemContainerTheme>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="5" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" ClipToBounds="True">
                                        <Grid RowDefinitions="*, Auto">
                                            <Button Classes="ghostIcon" Grid.Row="0" Command="{Binding $parent[UserControl].DataContext.OpenAttachmentCommand}" CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0">
                                                <Panel>
                                                    <Image Source="{Binding Thumbnail}" IsVisible="{Binding IsImage}" Stretch="UniformToFill"/>
                                                    <PathIcon IsVisible="{Binding !IsImage}" Data="{StaticResource IconFile}"
                                                              Foreground="{DynamicResource TextSecondaryBrush}" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                                </Panel>
                                            </Button>

                                            <Button Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{DynamicResource OverlayBrush}" CornerRadius="{DynamicResource RadiusSm}" Margin="5" Padding="4"
                                                    Command="{Binding $parent[UserControl].DataContext.DownloadAttachmentCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="Download File">
                                                <PathIcon Data="{StaticResource IconDownload}" Foreground="White" Width="14" Height="14"/>
                                            </Button>

                                            <Grid Grid.Row="0" Background="{DynamicResource ScrimSoftBrush}" IsVisible="{Binding IsDownloading}">
                                                <ProgressBar IsIndeterminate="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>

                                            <Border Grid.Row="1" Background="{DynamicResource OverlayBrush}" Padding="8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                                    <TextBlock Text="{Binding Bytes}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
