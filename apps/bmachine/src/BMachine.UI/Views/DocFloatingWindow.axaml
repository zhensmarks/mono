<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:BMachine.UI.Views"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="430"
        x:Class="BMachine.UI.Views.DocFloatingWindow"
        Title="Instan Redaksi"
        Width="460" Height="430"
        MinWidth="360" MinHeight="320"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Topmost="False"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="1" CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" MinHeight="58" Margin="14,8,14,0">
                <!-- Only the header background starts a move drag; Doc fields and buttons remain clickable. -->
                <Border Grid.ColumnSpan="2" Background="Transparent" PointerPressed="OnDragRegionPointerPressed"/>
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="INSTAN REDAKSI" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Nama, alamat, dan logo" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="danger" Command="{Binding BatchVM.ResetDocCommand}" ToolTip.Tip="Reset Semua (Nama, Alamat, Logo)"
                            Width="32" Height="32">
                        <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" Foreground="{DynamicResource ButtonDangerForegroundBrush}"/>
                    </Button>
                    <Button Classes="docTool" Click="OnOpenDocSettingsClick" ToolTip.Tip="Pengaturan Teks DOC (Nama &amp; Alamat yang dicari)"
                            Width="32" Height="32">
                        <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Classes="docTool" Command="{Binding BatchVM.ToggleSecondLogoCommand}" ToolTip.Tip="Tambah / Hapus Logo Alternatif"
                            Width="32" Height="32">
                        <PathIcon Data="{StaticResource IconCirclePlus}" Width="14" Height="14" Foreground="{DynamicResource AccentBlueBrush}"/>
                    </Button>
                    <Button Classes="secondary" Content="Close" Height="32" Padding="10,0"
                            ToolTip.Tip="Close and return Doc to the Log Panel" Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="0,8,0,0"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0">
                <views:DocPanelView/>
            </Border>
        </Grid>
    </Border>
</Window>
