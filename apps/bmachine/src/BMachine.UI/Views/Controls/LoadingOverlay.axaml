<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BMachine.UI.Views.Controls.LoadingOverlay"
             IsVisible="{Binding IsLoading}">
    <Border Background="#B0000000" ZIndex="999">
        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="32,24"
                MaxWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 24 0 #60000000">
            <StackPanel Orientation="Vertical" Spacing="16" HorizontalAlignment="Center">
                <!-- Spinner -->
                <Border Width="48" Height="48" 
                        BorderBrush="{DynamicResource AccentBlueBrush}"
                        BorderThickness="4"
                        CornerRadius="24"
                        HorizontalAlignment="Center">
                    <Border.Styles>
                        <Style Selector="Border">
                            <Style.Animations>
                                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="RotateTransform.Angle" Value="0"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="RotateTransform.Angle" Value="360"/>
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Border.Styles>
                    <Border.RenderTransform>
                        <RotateTransform/>
                    </Border.RenderTransform>
                </Border>
                
                <!-- Message -->
                <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding LoadingTitle}" 
                               FontSize="15" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextAlignment="Center"
                               IsVisible="{Binding LoadingTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding LoadingMessage}" 
                               FontSize="12.5" 
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="280"
                               IsVisible="{Binding LoadingMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
                
                <!-- Progress Bar (optional) -->
                <ProgressBar Value="{Binding LoadingProgress}" 
                             Maximum="100"
                             Height="6"
                             MinWidth="240"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             IsVisible="{Binding ShowProgress}"
                             Foreground="{DynamicResource AccentBlueBrush}"
                             Background="{DynamicResource BgInputBrush}"/>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
