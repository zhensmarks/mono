<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="520"
        x:Class="BMachine.UI.Views.Dialogs.DocSettingsWindow"
        Title="Pengaturan DOC"
        Width="520" Height="540"
        MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Styles>

        <Style Selector="Button.Action">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Action /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryPressedBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>

        <Style Selector="Button.Muted">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Muted /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Muted:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Muted:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBrush}"/>
        </Style>

        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="TextBlock.Hint">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">

            <!-- ═══ TITLE BAR ═══ -->
            <Grid Grid.Row="0" Height="40" Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="PENGATURAN DOC"
                           VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"
                           FontSize="12" LetterSpacing="1"
                           Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"/>

                <Button Grid.Column="1" Classes="WindowClose" Click="OnCloseButtonClick">
                    <PathIcon Data="{StaticResource IconX}"/>
                </Button>

                <Rectangle Grid.ColumnSpan="2" Height="1" Fill="#232326" VerticalAlignment="Bottom"/>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="16">
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">

                        <StackPanel Spacing="4">
                            <TextBlock Text="Teks Sumber yang Dicari" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Classes="Hint"
                                       Text="Tentukan teks asli (placeholder) yang ada di dalam PSD. Saat Anda mengirim Nama/Alamat dari tab DOC ke Photoshop, hanya layer yang teksnya cocok dengan daftar di bawah ini yang akan diganti. Isi satu teks per baris."/>
                        </StackPanel>

                        <!-- NAMA -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="FieldLabel" Text="Teks Nama (placeholder)"/>
                            <TextBox x:Name="TxtNameSources" Height="84"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Watermark="TK DELAPAN MATA AIR"/>
                            <TextBlock Classes="Hint"
                                       Text="Contoh: TK DELAPAN MATA AIR. Pencocokan mengabaikan besar/kecil huruf dan spasi berlebih."/>
                        </StackPanel>

                        <!-- ALAMAT -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="FieldLabel" Text="Teks Alamat (placeholder)"/>
                            <TextBox x:Name="TxtAddressSources" Height="110"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Watermark="JL. SARI ENDAH NO. 7A GEGERKALONG HILIR BANDUNG"/>
                            <TextBlock Classes="Hint"
                                       Text="Bisa lebih dari satu baris jika template PSD memakai variasi alamat yang berbeda. Satu variasi per baris."/>
                        </StackPanel>

                        <Border Background="#10181F26" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="FieldLabel" Text="Catatan"/>
                                <TextBlock Classes="Hint"
                                           Text="Jika daftar dibiarkan kosong, penggantian teks untuk field tersebut tidak akan dijalankan. Tekan &quot;Default&quot; untuk mengembalikan daftar bawaan."/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ FOOTER ═══ -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14,0,0">
                    <Button Grid.Column="0" Classes="Muted" Content="Default" Click="OnResetDefaultClick"
                            ToolTip.Tip="Kembalikan daftar teks sumber ke bawaan"/>

                    <TextBlock x:Name="StatusText" Grid.Column="1" Text=""
                               Foreground="#60A5FA" FontSize="11.5" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="12,0"/>

                    <Button Grid.Column="2" Classes="Muted" Content="Batal" MinWidth="90" Click="OnCancelClick"/>
                    <Button Grid.Column="3" Classes="Action" Content="Simpan" MinWidth="100"
                            Margin="10,0,0,0" Click="OnSaveClick"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
