<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:BMachine.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="300"
        x:Class="BMachine.UI.Views.Dialogs.UpdateDialogWindow"
        Title="Pembaharuan Tersedia"
        Width="380"
        SizeToContent="Height"
        MinWidth="340" MinHeight="200" MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        CanResize="True"
        ShowInTaskbar="False"
        Topmost="True">

    <!-- Topmost="True": selalu di atas jendela utama aplikasi. Tanpa ini dialog
         muncul di belakang MainWindow dan semua kliknya jatuh ke window di
         belakangnya (tombol "Nanti" jadi tidak bisa ditekan). -->
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="14,12">

            <!-- Header: drag region -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="{DynamicResource RadiusPill}" VerticalAlignment="Top"
                        Background="{DynamicResource AccentColorBrush}">
                    <PathIcon Data="{StaticResource IconDownload}" Width="20" Height="20" Foreground="{DynamicResource TextOnPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="PEMBARUAN TERSEDIA" FontSize="11" FontWeight="Bold" LetterSpacing="1.2"
                                   Foreground="{DynamicResource AccentColorBrush}"/>
                        <Border Background="{DynamicResource AccentColorBrush}" CornerRadius="{DynamicResource RadiusPill}" Padding="8,2">
                            <TextBlock Text="{Binding LatestVersion, StringFormat='v{0}'}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextOnPrimaryBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource MenuHoverBrush}" CornerRadius="{DynamicResource RadiusPill}" Padding="8,2"
                                IsVisible="{Binding UpdateSizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding UpdateSizeText}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentVersion, StringFormat='Versi saat ini: {0}'}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Classes="ghost" Click="OnCloseClick" Width="28" Height="28"
                        ToolTip.Tip="Tutup" Cursor="Hand" Background="Transparent" BorderThickness="0">
                    <PathIcon Data="{StaticResource IconX}" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>

            <!-- Badan: catatan rilis. MaxHeight + scroll supaya dialog tetap pendek walau
                 changelog gabungan beberapa versi (SizeToContent=Height hanya setinggi isi). -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                <StackPanel Spacing="6">
                    <TextBlock Text="Aplikasi menutup dan membuka ulang sendiri saat update dipasang. Pekerjaanmu tetap aman."
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding UpdateNoteItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                    <Border Grid.Column="0" Width="4" Height="4" CornerRadius="{DynamicResource RadiusXxs}" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentColorBrush}" IsVisible="{Binding !IsHeader}"/>
                                    <!-- Poin catatan -->
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="300"
                                               Foreground="{DynamicResource TextPrimaryBrush}" IsVisible="{Binding !IsHeader}"/>
                                    <!-- Pemisah versi: baris "vX" dari changelog gabungan -->
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="300"
                                               Margin="0,6,0,2" Foreground="{DynamicResource AccentColorBrush}" IsVisible="{Binding IsHeader}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <ProgressBar IsIndeterminate="True" Width="140" Height="3" VerticalAlignment="Center"
                                     IsVisible="{Binding IsApplyingUpdate}"/>
                        <TextBlock Text="{Binding UpdateActionStatus}" FontSize="11.5" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{DynamicResource AccentColorBrush}"
                                   IsVisible="{Binding UpdateActionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Aksi: kedua tombol dipaksa Height/Padding sama supaya sejajar.
                 Tanpa ini tombol "Nanti" (tanpa ikon) lebih pendek dari "Perbarui sekarang". -->
            <!-- Panel pemilih komponen (hanya tampil kalau manifest punya field "components"):
                 user bisa centang mana yang mau di-update (Aplikasi / Master / Action / Opsi). -->
            <Border Grid.Row="2" IsVisible="{Binding SelectComponentsVisible}" Margin="0,0,0,10"
                    Background="{DynamicResource BgInputBrush}" CornerRadius="6" Padding="10,8"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock Text="Pembaruan komponen" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="Pilih mana yang mau di-update. Modifikasi kamu di komponen yang tidak dicentang TIDAK akan disentuh."
                               FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding UpdateComponents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1"
                                      IsVisible="{Binding Changed}">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Included, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                              ToolTip.Tip="Centang untuk meng-update komponen ini"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PathsDisplay}" FontSize="10"
                                               Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"
                                               IsVisible="{Binding HasMultiplePaths}" MaxWidth="90" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto" Margin="0,12,0,0">
                <Button Grid.Column="0" Command="{Binding ApplyUpdateCommand}" IsEnabled="{Binding !IsApplyingUpdate}"
                        Classes="Action" Cursor="Hand" HorizontalAlignment="Left"
                        MinHeight="36" Padding="16,8" MinWidth="150"
                        BorderThickness="1" BorderBrush="{DynamicResource ButtonPrimaryBackgroundBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconDownload}" Width="15" Height="15"/>
                        <TextBlock Text="Perbarui sekarang" FontSize="12.5"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Command="{Binding DismissUpdateCommand}" Classes="Muted" Cursor="Hand"
                        Margin="10,0,0,0" MinHeight="36" Padding="16,8" MinWidth="90" VerticalAlignment="Center">
                    <TextBlock Text="Nanti" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
