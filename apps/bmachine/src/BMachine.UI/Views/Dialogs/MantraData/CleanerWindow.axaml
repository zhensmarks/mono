<local:MantraDialogBase xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BMachine.UI.Views.Dialogs.MantraData"
        x:Class="BMachine.UI.Views.Dialogs.MantraData.CleanerWindow"
        Title="Pembersihan Cepat"
        Width="700" Height="550"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Styles><Style Selector="Button.ChromeClose">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ChromeClose:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>

        <Style Selector="Button.Apply">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Apply /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Apply:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Apply:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryPressedBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>

        <Style Selector="Button.Cancel">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Cancel /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Cancel:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Cancel:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBrush}"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">

        <!-- ═══ WINDOW TITLE BAR ═══ -->
        <Grid Grid.Row="0" Height="40" Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding $parent[Window].Title, FallbackValue=Pembersihan Cepat}"
                       VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"/>

            <Button Grid.Column="1" Classes="WindowClose" Click="OnCloseButtonClick">
                <PathIcon Data="{StaticResource IconX}"/>
            </Button>

            <Rectangle Grid.ColumnSpan="2" Height="1" Fill="#232326" VerticalAlignment="Bottom"/>
        </Grid>

    <Grid Grid.Row="1" Margin="20" RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Pembersihan Cepat Data" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Asisten menganalisis data di komputer ini. Pilih perubahan yang akan diterapkan. Peringatan identitas tidak pernah diperbaiki otomatis. Semua tindakan dapat di-Undo."
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Suggestions List -->
        <Border Grid.Row="1" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <ItemsControl x:Name="SuggestionsListBox" ItemsSource="{Binding Suggestions}"
                                  Background="Transparent">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="14" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="6">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding Applicable}"
                                                  Foreground="{DynamicResource ButtonSecondaryForegroundBrush}"
                                                  FontWeight="Medium"
                                                  FontSize="13">
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <TextBlock Text="{Binding Detail}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Margin="24,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyStatePanel" IsVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="Tidak ada rekomendasi pembersihan." FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ButtonSecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Data sudah bersih, spasi rapi, dan tidak ada header berulang."
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Terapkan yang dipilih" Classes="Apply"
                    Cursor="Hand" Click="OnApplyClicked"/>
            <Button Content="Batal" Classes="Cancel"
                    Cursor="Hand" Click="OnCancelClicked"/>
        </StackPanel>
        </Grid>
        </Grid>
    </Border>
</local:MantraDialogBase>
