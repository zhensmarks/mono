<local:MantraDialogBase xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BMachine.UI.Views.Dialogs.MantraData"
        x:Class="BMachine.UI.Views.Dialogs.MantraData.ReportBugDialog"
        Title="Laporkan Bug"
        Width="560"
        MinWidth="520" MinHeight="280"
        MaxHeight="680"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Styles>
        <Style Selector="Button.Action">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Action /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryPressedBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>

        <Style Selector="Button.Muted">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Muted /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Muted:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Muted:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBrush}"/>
        </Style>

        <Style Selector="Button.WindowClose">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.WindowClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Border Margin="14" Padding="22" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto">

                <!-- Title bar: drag + close. Tanpa ikon, teks saja. -->
                <Grid Grid.Row="0" Margin="-22,-22,-22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="Transparent" PointerPressed="OnTitleBarPointerPressed" Padding="22,8,0,12">
                        <TextBlock Text="Laporkan Bug" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <Button Grid.Column="1" Classes="WindowClose" Click="OnCloseButtonClick"
                            Margin="0,4,10,0" ToolTip.Tip="Tutup">
                        <PathIcon Data="{StaticResource IconX}"/>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1" Text="Beri tahu kami apa yang terjadi. Laporan ini dikirim ke tim Project &amp; Bug."
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,14"/>

                <!-- Ringkasan -->
                <TextBlock Grid.Row="2" Text="Ringkasan" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="SummaryBox" Grid.Row="3" Height="36" FontSize="13" VerticalContentAlignment="Center"
                         Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                         CornerRadius="6" Padding="10,0" Watermark="Judul singkat: 'Tombol Ganti Semua tidak merespons'"/>

                <!-- Detail -->
                <TextBlock Grid.Row="4" Text="Detail" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,14,0,6"/>
                <TextBox x:Name="DetailBox" Grid.Row="5" Height="110" FontSize="13"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                         CornerRadius="6" Padding="10,8" Watermark="Apa yang kamu lakukan sebelumnya? Apa yang seharusnya terjadi?"/>

                <!-- Tombol -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,18,0,0">
                    <Button Classes="Muted" Content="Batal" MinWidth="90" Click="OnCloseButtonClick"/>
                    <Button Classes="Action" Content="Kirim" MinWidth="110" Click="OnSendClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</local:MantraDialogBase>
