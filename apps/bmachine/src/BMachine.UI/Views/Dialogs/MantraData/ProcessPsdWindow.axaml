<local:MantraDialogBase xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BMachine.UI.Views.Dialogs.MantraData"
        x:Class="BMachine.UI.Views.Dialogs.MantraData.ProcessPsdWindow"
        Title="Proses Rendering Photoshop"
        Width="820" Height="680"
        MinWidth="700" MinHeight="580"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Styles><Style Selector="Button.ChromeClose">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ChromeClose:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>

        <!-- Primary Action Button with solid card background -->
        <Style Selector="Button.Action">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Action /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryPressedBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Action:disabled">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>
        <Style Selector="Button.Action:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="#52525B"/>
        </Style>

        <!-- Secondary Muted Button with clear border & dark card background -->
        <Style Selector="Button.Muted">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Muted /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Muted:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Muted:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBrush}"/>
        </Style>

        <!-- Small card button -->
        <Style Selector="Button.SmallBtn">
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="#2C2C30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.SmallBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="BorderBrush" Value="#2C2C30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.SmallBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A30"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.SmallBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#25252A"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">

        <!-- ═══ WINDOW TITLE BAR ═══ -->
        <Grid Grid.Row="0" Height="40" Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding $parent[Window].Title, FallbackValue=Proses Rendering Photoshop}"
                       VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"/>

            <Button Grid.Column="1" Classes="WindowClose" Click="OnCloseButtonClick">
                <PathIcon Data="{StaticResource IconX}"/>
            </Button>

            <Rectangle Grid.ColumnSpan="2" Height="1" Fill="#232326" VerticalAlignment="Bottom"/>
        </Grid>

    <Border Grid.Row="1" Margin="16" Padding="20" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Proses Rendering Photoshop" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Pilih folder template PSD dan folder foto siswa yang akan dirender."
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 2. Form Zones -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <!-- Mode toggle -->
                    <CheckBox x:Name="ChkRevision" Content="Mode Revisi — perbarui kolom terpilih tanpa mengganti foto"
                              FontSize="12" Foreground="#C9D1D9" IsChecked="False"
                              Checked="OnRevisionModeChanged" Unchecked="OnRevisionModeChanged"/>

                    <!-- Zone 1: Folder Template PSD -->
                    <Border x:Name="DropZonePsd" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14"
                            DragDrop.AllowDrop="True" DragDrop.DragEnter="OnPsdDragEnter" DragDrop.DragOver="OnPsdDragOver" DragDrop.DragLeave="OnPsdDragLeave" DragDrop.Drop="OnPsdDrop">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Folder Template PSD" FontSize="12" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                                <Border x:Name="BadgePsd" Grid.Column="1" Background="#21262D" CornerRadius="10" Padding="8,2">
                                    <TextBlock x:Name="TxtBadgePsd" Text="Belum Dipilih" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>

                            <StackPanel Spacing="2">
                                <TextBlock x:Name="TxtPsdFolderName" Text="Tarik &amp; lepas folder PSD ke sini atau klik untuk browse"
                                           FontSize="12" FontWeight="Medium" Foreground="#C9D1D9" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtPsdPath" Text="Mendukung folder berisikan file dokumen .psd"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button x:Name="BtnClearPsd" Classes="SmallBtn" Content="Reset"
                                        IsVisible="False" Click="OnClearPsdClick"/>
                                <Button Classes="SmallBtn" Content="Pilih Folder PSD" Click="OnBrowsePsdClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Zone 2: Folder Foto Siswa -->
                    <Border x:Name="DropZonePhoto" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14"
                            DragDrop.AllowDrop="True" DragDrop.DragEnter="OnPhotoDragEnter" DragDrop.DragOver="OnPhotoDragOver" DragDrop.DragLeave="OnPhotoDragLeave" DragDrop.Drop="OnPhotoDrop">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Folder Foto Siswa / Objek" FontSize="12" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                                <Border x:Name="BadgePhoto" Grid.Column="1" Background="#21262D" CornerRadius="10" Padding="8,2">
                                    <TextBlock x:Name="TxtBadgePhoto" Text="Belum Dipilih" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>

                            <StackPanel Spacing="2">
                                <TextBlock x:Name="TxtPhotoFolderName" Text="Tarik &amp; lepas folder foto ke sini atau klik untuk browse"
                                           FontSize="12" FontWeight="Medium" Foreground="#C9D1D9" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtPhotoPath" Text="Mendukung file foto format .png, .jpg, .jpeg, atau .psd"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button x:Name="BtnClearPhoto" Classes="SmallBtn" Content="Reset"
                                        IsVisible="False" Click="OnClearPhotoClick"/>
                                <Button Classes="SmallBtn" Content="Pilih Folder Foto" Click="OnBrowsePhotoClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Zone Revisi: pemilihan kolom -->
                    <Border x:Name="PanelRevision" Background="{DynamicResource BgInputBrush}" BorderBrush="#2D333B" BorderThickness="1" CornerRadius="8" Padding="14" IsVisible="False">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Kolom yang ingin diperbarui" FontSize="12" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                                <Button Grid.Column="1" Classes="SmallBtn" Content="Kosongkan Pilihan" Click="OnClearRevisionFieldsClick"/>
                            </Grid>
                            <TextBlock Text="Hanya teks pada kolom yang dicentang akan diperbarui. Foto tidak dimasukkan ulang."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <WrapPanel x:Name="RevFieldsWrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Zone 3: Verification & Readiness Summary -->
                    <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="TxtSummaryTitle" Text="Status Verifikasi"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="#828896"/>
                                <TextBlock x:Name="TxtSummaryMessage" Text="Menunggu pemilihan folder..."
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                <Border x:Name="PillPsdReady" CornerRadius="10" Background="#21262D" Padding="8,2">
                                    <TextBlock x:Name="TxtPillPsd" Text="PSD: -" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                                <Border x:Name="PillPhotoReady" CornerRadius="10" Background="#21262D" Padding="8,2">
                                    <TextBlock x:Name="TxtPillPhoto" Text="Foto: -" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Bottom Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
                <Button Classes="Muted" Content="Batal" MinWidth="90" Click="OnCancelClick"/>
                <Button x:Name="BtnSubmit" Classes="Action" Content="Mulai" MinWidth="180"
                        Click="OnSubmitClick" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
    </Border>
</local:MantraDialogBase>
