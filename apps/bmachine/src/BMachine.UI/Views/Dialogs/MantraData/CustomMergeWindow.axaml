<local:MantraDialogBase xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BMachine.UI.Views.Dialogs.MantraData"
        x:Class="BMachine.UI.Views.Dialogs.MantraData.CustomMergeWindow"
        Title="Gabung Kolom"
        Width="520" Height="560"
        MinWidth="480" MinHeight="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Styles>

        <Style Selector="Button.Action">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Action /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryPressedBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>

        <Style Selector="Button.Muted">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Muted /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Muted:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Muted:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBrush}"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">

        <!-- ═══ WINDOW TITLE BAR ═══ -->
        <Grid Grid.Row="0" Height="40" Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding $parent[Window].Title, FallbackValue=Gabung Kolom}"
                       VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"/>

            <Button Grid.Column="1" Classes="WindowClose" Click="OnCloseButtonClick">
                <PathIcon Data="{StaticResource IconX}"/>
            </Button>

            <Rectangle Grid.ColumnSpan="2" Height="1" Fill="#232326" VerticalAlignment="Bottom"/>
        </Grid>

    <Border Grid.Row="1" Margin="16" Padding="20" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Gabung Kolom" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Pilih kolom dan format gabungan data secara instan." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <!-- 1. Kolom Terpilih -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Kolom yang digabung:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                            <WrapPanel x:Name="PanelSelectedColumns" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- 2. Pilihan Format -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Pilihan Format:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="RbSpace" Content="Spasi (A B)" Margin="0,0,6,8"
                                         IsCheckedChanged="OnPresetChanged" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                            <RadioButton x:Name="RbBracket" Content="Kurung A (B)" Margin="0,0,6,8"
                                         IsCheckedChanged="OnPresetChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                            <RadioButton x:Name="RbComma" Content="Koma (A, B)" Margin="0,0,0,8"
                                         IsCheckedChanged="OnPresetChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                            <RadioButton x:Name="RbPipe" Content="Pipa (A | B)" Margin="0,0,6,0"
                                         IsCheckedChanged="OnPresetChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                            <RadioButton x:Name="RbNewline" Content="Baris Baru" Margin="0,0,6,0"
                                         IsCheckedChanged="OnPresetChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                            <RadioButton x:Name="RbCustom" Content="Custom..." Margin="0,0,0,0"
                                         IsCheckedChanged="OnPresetChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Custom Separator box -->
                    <Grid x:Name="PanelCustomSep" ColumnDefinitions="Auto, *" IsVisible="False" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0" Text="Karakter Pemisah:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtCustomSep" Grid.Column="1" Height="32" FontSize="12" VerticalContentAlignment="Center"
                                 TextChanged="OnCustomSepChanged" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                 CornerRadius="6" Padding="10,0"/>
                    </Grid>

                    <!-- 3. Nama Kolom Hasil -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Nama Kolom Hasil:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TxtNewColName" Height="34" FontSize="12.5" VerticalContentAlignment="Center"
                                 Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" CornerRadius="6" Padding="10,0"/>
                    </StackPanel>

                    <!-- 4. Pratinjau Baris 1 -->
                    <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Hasil Baris 1:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtPreview" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- 5. Opsi Hapus Kolom Asal -->
                    <CheckBox x:Name="ChkDeleteSource" Content="Hapus kolom asal setelah digabung"
                              IsChecked="True" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
                <Button Classes="Muted" Content="Batal" MinWidth="90" Click="OnCancelClick"/>
                <Button Classes="Action" Content="Gabung Sekarang" MinWidth="150" Click="OnMergeClick"/>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
    </Border>
</local:MantraDialogBase>
