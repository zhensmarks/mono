<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:BMachine.UI.Views"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="BMachine.UI.Views.SpreadsheetWindow"
        Title="Spreadsheet Editor"
        Width="1000" Height="600"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Background="{DynamicResource AppBackgroundBrush}"
        TransparencyLevelHint="Mica">

    <Grid>
        <!-- Content Wrapper -->
        <Border Margin="0" Background="{DynamicResource CardBackgroundBrush}" 
                CornerRadius="6" BorderThickness="0">
            <Grid>
                <!-- Drag Handle (left side only, leaves right ~400px for toolbar controls) -->
                <Border Height="46" VerticalAlignment="Top" Background="Transparent" 
                        HorizontalAlignment="Stretch"
                        ZIndex="5" Cursor="Hand"
                        Margin="0,0,420,0"
                        PointerPressed="OnHeaderPointerPressed"/>

                <!-- Shared top-right close button; SpreadsheetView reserves this toolbar space. -->
                <Button Grid.Column="1" Classes="WindowClose" Click="CloseButton_Click"
                        ToolTip.Tip="Close" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,7,8,0" ZIndex="10">
                    <PathIcon Data="{StaticResource IconX}"/>
                </Button>

                <!-- Spreadsheet Content (full height, no title bar offset) -->
                <views:SpreadsheetView Margin="0" x:Name="SpreadsheetViewControl"/>
            </Grid>
        </Border>
    </Grid>
</Window>
