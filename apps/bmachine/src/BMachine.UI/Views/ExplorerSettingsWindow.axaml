<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:BMachine.UI.ViewModels"
        xmlns:views="using:BMachine.UI.Views"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="540"
        x:Class="BMachine.UI.Views.ExplorerSettingsWindow"
        x:DataType="vm:OutputExplorerViewModel"
        Title="Explorer Settings"
        Width="480" Height="540" MinWidth="440" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        FontFamily="{DynamicResource FontPrimary}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Styles>

        <Style Selector="RadioButton.Segmented">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.Segmented:checked">
            <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBackgroundBrush}"/>
        </Style>
        <Style Selector="RadioButton.Segmented:pointerover:not(:checked)">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
        </Style>

    </Window.Styles>

    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusXl}" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto" Background="{DynamicResource CardBackgroundBrush}">
                <Border Name="DragHeader" Background="Transparent" Padding="16,12" PointerPressed="OnHeaderPointerPressed">
                    <TextBlock Text="Explorer Settings" FontSize="14" FontWeight="SemiBold"/>
                </Border>
                <Button Grid.Column="1" Classes="Clear" Width="32" Height="32" Padding="8" Margin="0,4,8,4"
                        Click="Close_Click" ToolTip.Tip="Close" AutomationProperties.Name="Close Explorer Settings">
                    <PathIcon Data="{DynamicResource IconX}" Width="14" Height="14"/>
                </Button>
            </Grid>
            <Border Grid.Row="1" Margin="16,12,16,0" Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="{DynamicResource RadiusSm}" Padding="3" BorderThickness="1"
                    BorderBrush="{DynamicResource SeparatorBrush}">
                <Grid ColumnDefinitions="*,*">
                    <RadioButton Classes="Segmented" GroupName="ExplorerSettingsTabs" IsChecked="{Binding ExplorerSettingsVM.IsGeneralTabVisible}">
                        <TextBlock Text="General" Foreground="{Binding $parent[RadioButton].Foreground}"/>
                    </RadioButton>
                    <RadioButton Grid.Column="1" Classes="Segmented" GroupName="ExplorerSettingsTabs" IsChecked="{Binding ExplorerSettingsVM.IsShortcutsTabVisible}">
                        <TextBlock Text="Appearance &amp; Shortcuts" Foreground="{Binding $parent[RadioButton].Foreground}"/>
                    </RadioButton>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="16,12,16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding ExplorerSettingsVM.IsGeneralTabVisible}">
                <!-- GENERAL TAB -->
                <Grid>
                    <StackPanel Spacing="12" Margin="0,0,8,0">
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource RadiusMd}" Padding="14" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}">
                            <StackPanel Spacing="12">
                                <Grid RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Text="DEFAULT EXPLORER PATH" FontWeight="Bold" FontSize="10" LetterSpacing="1.2" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="1" Text="The root folder to open when the Explorer starts." FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ExplorerSettingsVM.DefaultExplorerPath}" Margin="0,0,8,0" Watermark="C:\Output..." VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse" Classes="primary" Command="{Binding ExplorerSettingsVM.BrowsePathCommand}" CommandParameter="DefaultExplorerPath" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource RadiusMd}" Padding="14" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}">
                            <StackPanel Spacing="12">
                                <Grid RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Text="VIEW MODE" FontWeight="Bold" FontSize="10" LetterSpacing="1.2" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="1" Text="Choose how files and folders are displayed by default." FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Grid>
                                <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="3" HorizontalAlignment="Stretch" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}">
                                    <Grid ColumnDefinitions="*,*,*">
                                        <RadioButton Grid.Column="0" IsChecked="{Binding IsVerticalLayout}" Classes="Segmented" FontSize="11">
                                            <TextBlock Text="List" Foreground="{Binding $parent[RadioButton].Foreground}" FontSize="11"/>
                                        </RadioButton>
                                        <RadioButton Grid.Column="1" IsChecked="{Binding IsHorizontalLayout}" Classes="Segmented" FontSize="11">
                                            <TextBlock Text="Grid" Foreground="{Binding $parent[RadioButton].Foreground}" FontSize="11"/>
                                        </RadioButton>
                                        <RadioButton Grid.Column="2" IsChecked="{Binding IsThumbnailLayout}" Classes="Segmented" FontSize="11">
                                            <TextBlock Text="Thumbnails" Foreground="{Binding $parent[RadioButton].Foreground}" FontSize="11"/>
                                        </RadioButton>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource RadiusMd}" Padding="14" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="LAYOUT &amp; NAVIGATION" FontWeight="Bold" FontSize="10" LetterSpacing="1.2" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Grid RowDefinitions="Auto,Auto" Margin="0,0,8,0">
                                        <TextBlock Text="Show Path Bar" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Row="1" Text="Display breadcrumb path bar at the top." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                    <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsShowPathBar}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                </ScrollViewer>
                <Grid IsVisible="{Binding ExplorerSettingsVM.IsShortcutsTabVisible}">
                    <views:ExplorerSettingsView DataContext="{Binding ExplorerSettingsVM}"/>
                </Grid>
            </Grid>
            <Border Grid.Row="3" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SeparatorBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Drag the title bar to move this window" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Done" Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
