<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:BMachine.UI.ViewModels"
        xmlns:views="using:BMachine.UI.Views"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
        x:Class="BMachine.UI.Views.ToolboxWindow"
        x:DataType="vm:ToolboxViewModel"
        Title="BMachine Toolbox"
        Width="1024" Height="730"
        MinWidth="680" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Styles>

        <!-- ═══════════════════════════════════════════
             HYBRID MINIMALIST DARK
             Principles: flat bento, 1px border, typographic
             contrast, zero glow, zero glass dekor
        ═══════════════════════════════════════════ -->

        <!-- NAV BAR — flat, bordered, no shadow -->
        <Style Selector="Border.Nav">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <!-- TAB BUTTONS — modern minimal planner-style with bottom indicator -->
        <Style Selector="Button.Tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="14,8,14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.Tab.on">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.Tab.on /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- BENTO CARD — flat, 1px border, no shadow -->
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <!-- SECTION LABEL — uppercase monospace eyebrow -->
        <Style Selector="TextBlock.Section">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        </Style>

        <!-- PATH — monospace, dim -->
        <Style Selector="TextBlock.Path">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- BODY LABEL -->
        <Style Selector="TextBlock.Body">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <!-- FIELD LABEL -->
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- INPUT -->
        <Style Selector="TextBox.Input">
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBox.Input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
        </Style>

        <Style Selector="NumericUpDown.Input">
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>

        <Style Selector="CheckBox.Option">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- PRIMARY BUTTON — always visible, explicitly targets Avalonia template border -->
        <Style Selector="Button.Action">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Action /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryPressedBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Action:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- SECONDARY / OUTLINED BUTTON -->
        <Style Selector="Button.Muted">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Muted /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.Muted:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>

        <!-- DANGER -->
        <Style Selector="Button.Warn">
            <Setter Property="Background" Value="{DynamicResource ButtonDangerBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Warn /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonDangerBackgroundBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Warn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonDangerHoverBrush}"/>
        </Style>

        <!-- PROGRESS BAR -->
        <Style Selector="ProgressBar.Bar">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
            <Setter Property="Height" Value="3"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>

        <!-- LISTBOX (Preview) -->
        <Style Selector="ListBox.Preview">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.Preview ListBoxItem">
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- LISTBOX (Advanced file/pair lists) -->
        <Style Selector="ListBox.Adv">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.Adv ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ListBox.Adv ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.Adv ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>

        <!-- LISTBOX (Advanced thumbnail grid) -->
        <Style Selector="ListBox.AdvThumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.AdvThumb ListBoxItem">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style Selector="ListBox.AdvThumb ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.AdvThumb ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>

        <!-- DROP CARD (folder input as wide drop zone) -->
        <Style Selector="Border.DropCard">
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.DropCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
        </Style>

        <!-- DIVIDER -->
        <Style Selector="Rectangle.Divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Margin" Value="0,12"/>
        </Style>

        <!-- SEGMENTED MODE SWITCH (List / Thumbnail) -->
        <Style Selector="Border.SegWrap">
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style Selector="Button.Seg">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Seg /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Seg:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.Seg.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.Seg:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- BACK BUTTON -->
        <Style Selector="Button.Back">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Back /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.Back:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.Back:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.Back:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- ADVANCED MODE ENTRY BUTTON (accent gradient pill) -->
        <Style Selector="Button.AdvEntry">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.AdvEntry /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFFFFF33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#3B82F6" Offset="0"/>
                    <GradientStop Color="#6366F1" Offset="1"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.AdvEntry:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#4F8FF7" Offset="0"/>
                    <GradientStop Color="#7C7CF5" Offset="1"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.AdvEntry:pressed /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#2F6FD6" Offset="0"/>
                    <GradientStop Color="#5252D9" Offset="1"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        
        <!-- ═══ WINDOW CHROME / TITLE BAR ═══ -->
        <Grid Grid.Row="0" Height="40" Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="BMachine Toolbox" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
            
            <Button Grid.Column="1" Classes="Muted" Content="Laporkan Bug" Height="26" FontSize="11" Padding="10,0" Margin="0,0,8,0" Click="OnReportBugClick" ToolTip.Tip="Kirim laporan bug"/>

            <Button Grid.Column="2" Classes="WindowClose" Click="OnCloseButtonClick" ToolTip.Tip="Close Toolbox">
                <PathIcon Data="{StaticResource IconX}"/>
            </Button>
            
            <!-- Separator -->
            <Rectangle Grid.ColumnSpan="3" Height="1" Fill="{DynamicResource SeparatorBrush}" VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="1">
        <!-- LAYOUT CONSTRAINT MOCKS (Independent from content to prevent shrink-lock & ensure stretching) -->
        <!-- PathTextBoxWidth simulates Window width minus left/right paddings and button sizes -->
        <Panel x:Name="PathTextBoxWidth" Margin="44,0,150,0" IsHitTestVisible="False" />
        <!-- StatusTextWidth simulates Window width minus two buttons in the action bar -->
        <Panel x:Name="StatusTextWidth" Margin="44,0,320,0" IsHitTestVisible="False" />

        <!-- ═══ CONTENT ═══ -->
        <Grid ZIndex="0"
              Margin="20,85,20,20"
              IsVisible="{Binding !PsdBucinVM.IsManualModeActive}">
            <Grid>

                <!-- ═══════════════════════
                     MANTRA BUCIN
                ═══════════════════════ -->
                <Grid IsVisible="{Binding IsPsdBucinVisible}" RowDefinitions="*,16,Auto" MinHeight="480">

                    <!-- SETUP VIEW -->
                    <Grid Grid.Row="0" IsVisible="{Binding !PsdBucinVM.IsManualModeActive}" RowDefinitions="*,16,*,16,Auto">

                        <!-- Master PSD -->
                        <Border Grid.Row="0" x:Name="MasterDropZone" Classes="Card" DragDrop.AllowDrop="True">
                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                <TextBlock Grid.Row="0" Classes="Section" Text="MASTER &amp; OUTPUT" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Rectangle Grid.Row="1" Classes="Divider" Margin="0,0,0,0"/>
                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Classes="Input" Text="{Binding PsdBucinVM.MasterDirectory}" Watermark="Ketik/Paste path, atau Drag &amp; Drop folder kesini" MinWidth="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" Width="{Binding #PathTextBoxWidth.Bounds.Width}"/>
                                    <Button Grid.Column="1" Classes="Muted" Content="Pilih" Margin="8,0,0,0" Padding="12,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Click="OnPsdSelectMasterClick"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Foto JPG -->
                        <Border Grid.Row="2" x:Name="PhotoDropZone" Classes="Card" DragDrop.AllowDrop="True">
                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                <TextBlock Grid.Row="0" Classes="Section" Text="INPUT" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Rectangle Grid.Row="1" Classes="Divider" Margin="0,0,0,0"/>
                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Classes="Input" Text="{Binding PsdBucinVM.PhotoDirectory}" Watermark="Ketik/Paste path, atau Drag &amp; Drop folder kesini" MinWidth="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" Width="{Binding #PathTextBoxWidth.Bounds.Width}"/>
                                    <Button Grid.Column="1" Classes="Muted" Content="Pilih" Margin="8,0,0,0" Padding="12,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Click="OnPsdSelectPhotoClick"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Progress -->
                        <Border Grid.Row="4" Classes="Card" IsVisible="{Binding PsdBucinVM.IsProcessing}">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="Section" Text="MEMPROSES"/>
                                <ProgressBar Classes="Bar"
                                             Minimum="0"
                                             Maximum="{Binding PsdBucinVM.ProgressMaximum}"
                                             Value="{Binding PsdBucinVM.ProgressValue}"/>
                                <TextBlock Classes="Body" Text="{Binding PsdBucinVM.ProgressText}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Action Bar (Rata Bawah) -->
                    <Border Grid.Row="2" Classes="Card" IsVisible="{Binding !PsdBucinVM.IsProcessing}">
                        <Grid ColumnDefinitions="*,12,Auto,8,Auto">
                            <TextBlock Grid.Column="0" Classes="Body"
                                       Text="{Binding PsdBucinVM.StatusText}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" Width="{Binding #StatusTextWidth.Bounds.Width}"/>
                            <Button Grid.Column="2" Classes="Muted" Content="Clear"
                                    Command="{Binding PsdBucinVM.ClearPathsCommand}"/>
                            <Button Grid.Column="4" Classes="Action" Content="MULAI"
                                    Command="{Binding PsdBucinVM.StartManualViewerCommand}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════
                     MANTRA NAMA
                ═══════════════════════ -->
                <Grid IsVisible="{Binding IsMantraNamaVisible}">
                <Border Classes="Card" IsVisible="{Binding MantraNamaVM.IsAdvancedMode}" Padding="20,18" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,2*,3*,Auto,Auto" RowSpacing="12">
                        <!-- Header: Back + Title + Segmented Mode Switch -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,16,*,Auto">
                            <Button Grid.Column="0" Classes="Back"
                                    Command="{Binding MantraNamaVM.ExitAdvancedModeCommand}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Kembali" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="&#x2728;" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource AccentColorBrush}"/>
                                    <TextBlock Classes="Section" Text="ADVANCED MODE" FontSize="12"/>
                                </StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Text="Samakan nama file: kiri = referensi, kanan = target"/>
                            </StackPanel>
                            <Border Grid.Column="3" Classes="SegWrap" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="Seg" Classes.on="{Binding MantraNamaVM.IsListMode}"
                                            Command="{Binding MantraNamaVM.SetListModeCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="&#x2630;" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="List" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="Seg" Classes.on="{Binding MantraNamaVM.IsThumbnailMode}"
                                            Command="{Binding MantraNamaVM.SetThumbnailModeCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="&#x25A6;" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="Thumbnail" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <!-- Folder Inputs (whole card = drop zone) -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,10,*">
                            <Border Grid.Column="0" x:Name="NamaAdvancedReferenceDropZone" Classes="DropCard"
                                    DragDrop.AllowDrop="True" ToolTip.Tip="Seret folder atau file ke sini">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Background="Transparent" DragDrop.AllowDrop="True">
                                    <TextBlock Grid.Column="0" Text="&#x1F4C1;" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource AccentColorBrush}"/>
                                    <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="2,0" DragDrop.AllowDrop="True"
                                             Text="{Binding MantraNamaVM.AdvancedReferenceDirectory}"
                                             Watermark="Folder kiri: referensi (seret folder / file)"/>
                                    <Button Grid.Column="2" Classes="Muted" Content="Pilih" Padding="12,0"
                                            VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                            Click="OnNamaAdvancedReferenceFolderClick"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" x:Name="NamaAdvancedTargetDropZone" Classes="DropCard"
                                    DragDrop.AllowDrop="True" ToolTip.Tip="Seret folder atau file ke sini">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Background="Transparent" DragDrop.AllowDrop="True">
                                    <TextBlock Grid.Column="0" Text="&#x1F4C1;" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource AccentColorBrush}"/>
                                    <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="2,0" DragDrop.AllowDrop="True"
                                             Text="{Binding MantraNamaVM.AdvancedTargetDirectory}"
                                             Watermark="Folder kanan: target (seret folder / file)"/>
                                    <Button Grid.Column="2" Classes="Muted" Content="Pilih" Padding="12,0"
                                            VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                            Click="OnNamaAdvancedTargetFolderClick"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <!-- File Panels (fluid, scroll internal) -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,10,*">
                            <Border Grid.Column="0" x:Name="NamaAdvancedReferencePanel" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10" DragDrop.AllowDrop="True">
                                <Grid RowDefinitions="Auto,Auto,*">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Classes="FieldLabel" Text="REFERENSI KIRI" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding MantraNamaVM.AdvancedReferenceCount}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="96" ItemsSource="{Binding MantraNamaVM.SortOptions}" SelectedItem="{Binding MantraNamaVM.AdvancedSortBy}" ToolTip.Tip="Urutkan berdasarkan nama/nomor atau tipe"/>
                                        <ComboBox Grid.Column="2" Width="112" Margin="6,0,0,0" ItemsSource="{Binding MantraNamaVM.AdvancedFileFilters}" SelectedItem="{Binding MantraNamaVM.AdvancedReferenceFilter}"/>
                                        <ComboBox Grid.Column="3" Width="64" Margin="6,0,0,0" IsVisible="{Binding MantraNamaVM.IsThumbnailMode}"
                                                  ItemsSource="{Binding MantraNamaVM.ColumnOptions}" SelectedItem="{Binding MantraNamaVM.AdvancedReferenceColumns}"
                                                  ToolTip.Tip="Jumlah kolom thumbnail"/>
                                    </Grid>
                                    <TextBox Grid.Row="1" Classes="Input" Padding="10,7" FontSize="12" Text="{Binding MantraNamaVM.AdvancedReferenceSearch}" Watermark="Cari file..." Margin="0,6"/>
                                    <ListBox Grid.Row="2" Classes="Adv" IsVisible="{Binding !MantraNamaVM.IsThumbnailMode}"
                                             ItemsSource="{Binding MantraNamaVM.AdvancedReferenceFiles}" SelectedItem="{Binding MantraNamaVM.SelectedAdvancedReference}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Border Grid.ColumnSpan="2" IsVisible="{Binding IsHeader}" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="&#x1F4C1;" FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FolderLabel}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding NewName}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="0" IsVisible="{Binding !IsHeader}" Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" IsVisible="{Binding IsPaired}" Text="TERPASANG" FontSize="9" Foreground="{DynamicResource AccentColorBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <ListBox Grid.Row="2" Classes="AdvThumb" IsVisible="{Binding MantraNamaVM.IsThumbnailMode}"
                                             ItemsSource="{Binding MantraNamaVM.AdvancedReferenceFiles}" SelectedItem="{Binding MantraNamaVM.SelectedAdvancedReference}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel><ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding $parent[Window].DataContext.MantraNamaVM.AdvancedReferenceColumns}"/>
                                        </ItemsPanelTemplate></ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <Grid Margin="3">
                                                <Border IsVisible="{Binding IsHeader}" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" VerticalAlignment="Top">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FolderLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding NewName}" FontSize="9" Foreground="{DynamicResource TextFaintBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel IsVisible="{Binding !IsHeader}" Spacing="4">
                                                    <Viewbox Stretch="Uniform">
                                                        <Border Width="150" Height="200" CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}" ClipToBounds="True">
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                                        </Border>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding OriginalName}" FontSize="10" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" x:Name="NamaAdvancedTargetPanel" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10" DragDrop.AllowDrop="True">
                                <Grid RowDefinitions="Auto,Auto,*">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Classes="FieldLabel" Text="TARGET KANAN" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding MantraNamaVM.AdvancedTargetCount}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="96" ItemsSource="{Binding MantraNamaVM.SortOptions}" SelectedItem="{Binding MantraNamaVM.AdvancedSortBy}" ToolTip.Tip="Urutkan berdasarkan nama/nomor atau tipe"/>
                                        <ComboBox Grid.Column="2" Width="112" Margin="6,0,0,0" ItemsSource="{Binding MantraNamaVM.AdvancedFileFilters}" SelectedItem="{Binding MantraNamaVM.AdvancedTargetFilter}"/>
                                        <ComboBox Grid.Column="3" Width="64" Margin="6,0,0,0" IsVisible="{Binding MantraNamaVM.IsThumbnailMode}"
                                                  ItemsSource="{Binding MantraNamaVM.ColumnOptions}" SelectedItem="{Binding MantraNamaVM.AdvancedTargetColumns}"
                                                  ToolTip.Tip="Jumlah kolom thumbnail"/>
                                    </Grid>
                                    <TextBox Grid.Row="1" Classes="Input" Padding="10,7" FontSize="12" Text="{Binding MantraNamaVM.AdvancedTargetSearch}" Watermark="Cari file..." Margin="0,6"/>
                                    <ListBox Grid.Row="2" Classes="Adv" IsVisible="{Binding !MantraNamaVM.IsThumbnailMode}"
                                             ItemsSource="{Binding MantraNamaVM.AdvancedTargetFiles}" SelectedItem="{Binding MantraNamaVM.SelectedAdvancedTarget}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Border Grid.ColumnSpan="2" IsVisible="{Binding IsHeader}" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="&#x1F4C1;" FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FolderLabel}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding NewName}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="0" IsVisible="{Binding !IsHeader}" Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" IsVisible="{Binding IsPaired}" Text="TERPASANG" FontSize="9" Foreground="{DynamicResource AccentColorBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <ListBox Grid.Row="2" Classes="AdvThumb" IsVisible="{Binding MantraNamaVM.IsThumbnailMode}"
                                             ItemsSource="{Binding MantraNamaVM.AdvancedTargetFiles}" SelectedItem="{Binding MantraNamaVM.SelectedAdvancedTarget}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel><ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding $parent[Window].DataContext.MantraNamaVM.AdvancedTargetColumns}"/>
                                        </ItemsPanelTemplate></ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <Grid Margin="3">
                                                <Border IsVisible="{Binding IsHeader}" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" VerticalAlignment="Top">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FolderLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding NewName}" FontSize="9" Foreground="{DynamicResource TextFaintBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel IsVisible="{Binding !IsHeader}" Spacing="4">
                                                    <Viewbox Stretch="Uniform">
                                                        <Border Width="150" Height="200" CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}" ClipToBounds="True">
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                                        </Border>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding OriginalName}" FontSize="10" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                        <!-- Pair review list (bounded, scroll internal) -->
                        <Border Grid.Row="3" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="96">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="USULAN PASANGAN — PERIKSA GAMBAR SEBELUM MENERAPKAN"/>
                                        <TextBlock Text="Urutan hanya saran awal, bukan pengenalan identitas. Semua draf BELUM DITINJAU; bandingkan thumbnail sebelum memilih baris untuk ditinjau." FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding MantraNamaVM.AdvancedUnmatchedSummary}" FontSize="9" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="190" ItemsSource="{Binding MantraNamaVM.AdvancedPairFilterOptions}"
                                              SelectedItem="{Binding MantraNamaVM.AdvancedPairFilter}" VerticalAlignment="Center"
                                              ToolTip.Tip="Filter usulan belum ditinjau, konflik, atau file tanpa pasangan."/>
                                    <Button Grid.Column="2" Classes="Muted" Content="Tandai pilihan terlihat sudah ditinjau"
                                            Command="{Binding MantraNamaVM.ReviewVisibleAdvancedPairsCommand}"
                                            VerticalAlignment="Center" ToolTip.Tip="Pilih baris yang sudah dibandingkan secara visual, lalu tandai sekali. Konflik tetap diblokir."/>
                                </Grid>
                                <ListBox x:Name="NamaAdvancedPairList" Grid.Row="1" Classes="Adv" IsVisible="{Binding MantraNamaVM.ShowPairList}" DragDrop.AllowDrop="True"
                                         ItemsSource="{Binding MantraNamaVM.VisibleAdvancedPairs}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="42,*,16,42,190,*,Auto,Auto,Auto" ColumnSpacing="7" Margin="0,3"
                                                  Background="Transparent" DragDrop.AllowDrop="True">
                                                <Border Grid.Column="0" Width="38" Height="48" CornerRadius="4" Background="{DynamicResource CardBackgroundBrush}" ClipToBounds="True" VerticalAlignment="Center">
                                                    <Image Source="{Binding ReferencePreview.Thumbnail}" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ReferenceName}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="REFERENSI" FontSize="9" Foreground="{DynamicResource TextFaintBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#x2192;" HorizontalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="3" Width="38" Height="48" CornerRadius="4" Background="{DynamicResource CardBackgroundBrush}" ClipToBounds="True" VerticalAlignment="Center">
                                                    <Image Source="{Binding SelectedTargetItem.Thumbnail}" Stretch="Uniform"/>
                                                </Border>
                                                <ComboBox Grid.Column="4" ItemsSource="{Binding TargetOptions}" SelectedItem="{Binding SelectedTargetItem}"
                                                          MinWidth="150" ToolTip.Tip="Pilih ulang target untuk referensi ini; thumbnail akan berubah untuk ditinjau lagi.">
                                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <StackPanel Grid.Column="5" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ResultName}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="9" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFaintBrush}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="6" Content="Pilih" IsChecked="{Binding IsSelectedForBulkReview}" VerticalAlignment="Center"
                                                          ToolTip.Tip="Pilih baris ini setelah memastikan gambarnya secara visual."/>
                                                <StackPanel Grid.Column="7" Spacing="2" VerticalAlignment="Center">
                                                    <CheckBox Content="Dicek" IsChecked="{Binding IsReviewed}" VerticalAlignment="Center"
                                                              ToolTip.Tip="Tandai hanya setelah membandingkan thumbnail referensi dan target."/>
                                                    <TextBlock Text="{Binding ReviewStateLabel}" FontSize="8" Foreground="{DynamicResource TextFaintBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="8" Content="Hapus" Classes="Muted" Padding="10,3" FontSize="11" VerticalAlignment="Center"
                                                        Command="{Binding $parent[Window].DataContext.MantraNamaVM.RemoveAdvancedPairCommand}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ListBox Grid.Row="1" Classes="Adv" IsVisible="{Binding MantraNamaVM.ShowUnmatchedFiles}"
                                         ItemsSource="{Binding MantraNamaVM.AdvancedUnmatchedFiles}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="110,*" ColumnSpacing="10" Margin="0,3">
                                                <TextBlock Text="{Binding Side}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <!-- Status + Progress -->
                        <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Classes="Body" Text="{Binding MantraNamaVM.StatusText}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True"
                                         IsVisible="{Binding MantraNamaVM.IsProcessing}"
                                         Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource AccentColorBrush}"/>
                        </Grid>
                        <!-- Actions -->
                        <Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,Auto,*,Auto,10,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Margin="0,0,14,0">
                                <CheckBox Classes="Option" Content="Sertakan subfolder"
                                          IsChecked="{Binding MantraNamaVM.AdvancedIncludeSubfolders}"/>
                                <CheckBox Classes="Option" Content="Kelompokkan per folder"
                                          IsVisible="{Binding MantraNamaVM.AdvancedIncludeSubfolders}"
                                          IsChecked="{Binding MantraNamaVM.AdvancedGroupByFolder}"
                                          ToolTip.Tip="Urutkan dan kelompokkan file sesuai foldernya"/>
                                <CheckBox Classes="Option" Content="Rename file kembar (nama sama beda tipe)"
                                          IsChecked="{Binding MantraNamaVM.AdvancedRenameSiblings}"
                                          ToolTip.Tip="Jika aktif, file di target dengan nama depan sama (misal .png) otomatis ikut direname"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="Muted" Content="Hapus Semua"
                                    Command="{Binding MantraNamaVM.ClearAdvancedPairsCommand}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Classes="Muted" Content="{Binding MantraNamaVM.UndoLabel}"
                                    IsVisible="{Binding MantraNamaVM.CanUndo}" Margin="8,0,0,0"
                                    Command="{Binding MantraNamaVM.UndoAdvancedRenameCommand}"
                                    IsEnabled="{Binding !MantraNamaVM.IsProcessing}" VerticalAlignment="Center"/>
                            <Button Grid.Column="4" Classes="Muted" Content="Pasangkan"
                                    Command="{Binding MantraNamaVM.AddAdvancedPairCommand}"
                                    IsVisible="{Binding MantraNamaVM.IsThumbnailMode}" VerticalAlignment="Center"/>
                            <Button Grid.Column="4" Classes="Muted" Content="Buat usulan"
                                    Command="{Binding MantraNamaVM.RefreshAutoPairCommand}"
                                    VerticalAlignment="Center" ToolTip.Tip="Membuat draf menurut urutan tampilan; semua pasangan belum ditinjau dan tidak akan diterapkan otomatis."/>
                            <Button Grid.Column="6" Classes="Action" Content="Terapkan yang dicek"
                                    Command="{Binding MantraNamaVM.ExecuteAdvancedRenameCommand}"
                                    IsEnabled="{Binding !MantraNamaVM.IsProcessing}" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
                <Grid RowDefinitions="*,16,Auto" IsVisible="{Binding !MantraNamaVM.IsAdvancedMode}" MinHeight="480">

                    <!-- Preview table (Atas - Fluid Height) -->
                    <Border Grid.Row="0" Classes="Card">
                        <Grid RowDefinitions="Auto,12,Auto,12,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Classes="Section" Text="PREVIEW HASIL (Drag &amp; Drop Folder Kesini)" VerticalAlignment="Center"/>
                                    <Button Classes="AdvEntry" Command="{Binding MantraNamaVM.ToggleAdvancedModeCommand}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="Advanced Mode" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBox Grid.Column="1" Classes="Input" Width="200" Padding="8,4" FontSize="11" 
                                         Watermark="Filter nama/ekstensi..." Text="{Binding MantraNamaVM.FilterText}"/>
                            </Grid>
                            <Rectangle Grid.Row="1" Classes="Divider" Margin="0"/>
                            <!-- Column headers -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,28,*">
                                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Nama Asli" FontWeight="Medium"/>
                                <TextBlock Grid.Column="2" Classes="FieldLabel" Text="Nama Baru" FontWeight="Medium"/>
                            </Grid>
                            <!-- Rows -->
                            <ListBox Grid.Row="4" Classes="Preview"
                                     ScrollViewer.IsScrollChainingEnabled="False"
                                     ScrollViewer.IsScrollInertiaEnabled="False"
                                     ItemsSource="{Binding MantraNamaVM.PreviewList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,28,*,Auto" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding OriginalName}"
                                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource FontMono}"/>
                                            <TextBlock Grid.Column="1" Text="->"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding NewName}"
                                                       FontSize="12" Foreground="#9CA3AF"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource FontMono}"/>
                                            <Button Grid.Column="3" Content="X" Width="24" Height="24" 
                                                    Padding="0" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                                                    Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0"
                                                    Command="{Binding $parent[Window].DataContext.MantraNamaVM.RemoveItemCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Konfigurasi & Action (Bawah - Fixed Height) -->
                    <Border Grid.Row="2" Classes="Card">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                                <!-- Find / Replace row -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,10,*" Margin="0,0,0,12">
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Classes="FieldLabel" Text="Cari"/>
                                        <TextBox Classes="Input" Text="{Binding MantraNamaVM.FindText}"
                                                 Watermark="teks atau regex"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="5">
                                        <TextBlock Classes="FieldLabel" Text="Ganti dengan"/>
                                        <TextBox Classes="Input" Text="{Binding MantraNamaVM.ReplaceText}"
                                                 Watermark="teks pengganti"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Opsi Lanjutan Panel (Dipindah ke atas tombol) -->
                                <Border Grid.Row="1" IsVisible="{Binding MantraNamaVM.IsOptionsExpanded}"
                                        Background="{DynamicResource BgInputBrush}" CornerRadius="7" Padding="14,12"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Margin="0,0,0,12">
                                    <WrapPanel Orientation="Horizontal">
                                        <CheckBox Classes="Option" Content="Regex" Width="140"
                                                  IsChecked="{Binding MantraNamaVM.UseRegex}" Margin="0,0,0,6"/>
                                        <CheckBox Classes="Option" Content="Case Sensitive" Width="140"
                                                  IsChecked="{Binding MantraNamaVM.CaseSensitive}" Margin="0,0,0,6"/>
                                        <CheckBox Classes="Option" Content="Ganti Semua" Width="140"
                                                  IsChecked="{Binding MantraNamaVM.MatchAllOccurrences}" Margin="0,0,0,6"/>
                                        <CheckBox Classes="Option" Content="Skip Ekstensi" Width="140"
                                                  IsChecked="{Binding MantraNamaVM.ExcludeExtension}" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </Border>

                                <Button Grid.Row="2" Classes="Muted" HorizontalAlignment="Center" Command="{Binding MantraNamaVM.ToggleOptionsCommand}" Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Opsi Lanjutan" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="11"
                                                   Text=">" IsVisible="{Binding !MantraNamaVM.IsOptionsExpanded}"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}"/>
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="11"
                                                   Text="v" IsVisible="{Binding MantraNamaVM.IsOptionsExpanded}"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}"/>
                                    </Grid>
                                </Button>

                                <!-- Action row -->
                                <Grid Grid.Row="3" ColumnDefinitions="*,10,Auto,8,Auto">
                                    <TextBlock Grid.Column="0" Classes="Body"
                                               Text="{Binding MantraNamaVM.StatusText}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" Width="{Binding #StatusTextWidth.Bounds.Width}"/>
                                    <Button Grid.Column="2" Classes="Muted" Content="Clear"
                                            Command="{Binding MantraNamaVM.ClearListCommand}"/>
                                    <Button Grid.Column="4" Classes="Action" Content="Eksekusi Rename"
                                            Command="{Binding MantraNamaVM.ExecuteRenameCommand}"/>
                                </Grid>

                            </Grid>
                    </Border>

                </Grid>

                <!-- ═══════════════════════
                     MANTRA GANDA
                ═══════════════════════ -->
                </Grid>
                <Grid IsVisible="{Binding IsMantraGandaVisible}" RowDefinitions="*,16,Auto" MinHeight="480">

                    <!-- Content (Atas) -->
                    <Grid Grid.Row="0" RowDefinitions="*,16,*,16,Auto">
                        <!-- File Master -->
                        <Border Grid.Row="0" x:Name="GandaMasterDropZone" Classes="Card" DragDrop.AllowDrop="True">
                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                <TextBlock Grid.Row="0" Classes="Section" Text="FILE / FOLDER MASTER" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Rectangle Grid.Row="1" Classes="Divider" Margin="0,0,0,0"/>
                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Classes="Input" Text="{Binding MantraGandaVM.MasterPath}" Watermark="Ketik/Paste path, atau Drag &amp; Drop file/folder kesini" MinWidth="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" Width="{Binding #PathTextBoxWidth.Bounds.Width}"/>
                                    <Button Grid.Column="1" Classes="Muted" Content="Pilih" Margin="8,0,0,0" Padding="12,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Click="OnGandaSelectFileClick"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Folder Data -->
                        <Border Grid.Row="2" x:Name="GandaDataDropZone" Classes="Card" DragDrop.AllowDrop="True">
                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                <TextBlock Grid.Row="0" Classes="Section" Text="FOLDER DATA (OPSIONAL)" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Rectangle Grid.Row="1" Classes="Divider" Margin="0,0,0,0"/>
                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Classes="Input" Text="{Binding MantraGandaVM.DataFolder}" Watermark="Ketik/Paste path, atau Drag &amp; Drop folder kesini" MinWidth="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" Width="{Binding #PathTextBoxWidth.Bounds.Width}"/>
                                    <Button Grid.Column="1" Classes="Muted" Content="Pilih" Margin="8,0,0,0" Padding="12,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Click="OnGandaSelectDataFolderClick"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Progress -->
                        <Border Grid.Row="4" Classes="Card" IsVisible="{Binding MantraGandaVM.IsProcessing}">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="Section" Text="MENGGANDAKAN"/>
                                <ProgressBar Classes="Bar"
                                             Minimum="0"
                                             Maximum="{Binding MantraGandaVM.ProgressMaximum}"
                                             Value="{Binding MantraGandaVM.ProgressValue}"/>
                                <TextBlock Classes="Body" Text="{Binding MantraGandaVM.StatusText}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Konfigurasi & Action (Bawah) -->
                    <Border Grid.Row="2" Classes="Card">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Classes="Section" Text="KONFIGURASI" Margin="0,0,0,12" IsVisible="{Binding MantraGandaVM.IsManualConfigVisible}"/>
                            <Rectangle Grid.Row="1" Classes="Divider" Margin="0,0,0,12" IsVisible="{Binding MantraGandaVM.IsManualConfigVisible}"/>
                            <Grid Grid.Row="2" RowDefinitions="Auto,12,Auto" ColumnDefinitions="*,16,*" Margin="0,0,0,12" IsVisible="{Binding MantraGandaVM.IsManualConfigVisible}">
                                <!-- Row 0 -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                    <TextBlock Classes="FieldLabel" Text="Jumlah duplikat"/>
                                    <NumericUpDown Classes="Input"
                                                   Value="{Binding MantraGandaVM.DuplicateCount}"
                                                   Minimum="1" Maximum="10000"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6">
                                    <TextBlock Classes="FieldLabel" Text="Mulai dari nomor"/>
                                    <NumericUpDown Classes="Input"
                                                   Value="{Binding MantraGandaVM.StartNumber}"
                                                   Minimum="0"/>
                                </StackPanel>
                                <!-- Row 2 -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                                    <TextBlock Classes="FieldLabel" Text="Pemisah (_, -, spasi)"/>
                                    <TextBox Classes="Input" Text="{Binding MantraGandaVM.Separator}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6">
                                    <TextBlock Classes="FieldLabel" Text="Nama Dasar (Opsional)"/>
                                    <TextBox Classes="Input" Text="{Binding MantraGandaVM.CustomBaseName}" Watermark="kosong = nama asli"/>
                                </StackPanel>
                            </Grid>

                            <Rectangle Grid.Row="3" Classes="Divider" Margin="0,0,0,12" IsVisible="{Binding MantraGandaVM.IsManualConfigVisible}"/>

                            <!-- Action bar rata bawah -->
                            <Grid Grid.Row="4" ColumnDefinitions="*,12,Auto,8,Auto,8,Auto">
                                <TextBlock Grid.Column="0" Classes="Body"
                                           Text="{Binding MantraGandaVM.StatusText}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" Width="{Binding #StatusTextWidth.Bounds.Width}"/>
                                <Button Grid.Column="2" Classes="Muted" Content="Clear"
                                        Command="{Binding MantraGandaVM.ClearPathsCommand}"/>
                                <Button Grid.Column="4" Classes="Warn" Content="Stop"
                                        IsVisible="{Binding MantraGandaVM.IsProcessing}"
                                        Command="{Binding MantraGandaVM.StopDuplicateCommand}"/>
                                <Button Grid.Column="6" Classes="Action" Content="{Binding MantraGandaVM.ActionButtonText}"
                                        IsVisible="{Binding !MantraGandaVM.IsProcessing}"
                                        Command="{Binding MantraGandaVM.ExecuteDuplicateCommand}"/>
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>

                <!-- ═══════════════════════
                     MANTRA DATA
                ═══════════════════════ -->
                <Grid IsVisible="{Binding IsMantraDataVisible}">
                    <views:MantraDataView DataContext="{Binding MantraDataVM}"/>
                </Grid>

            </Grid>
        </Grid>

        <!-- VIEWER VIEW (manual) -->
        <Grid Grid.Row="1" Margin="20,16,20,20" RowDefinitions="Auto,*,Auto" IsVisible="{Binding PsdBucinVM.IsManualModeActive}" MinHeight="480">

            <!-- Top bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,14,Auto,8,Auto" Margin="0,0,0,14">
                <TextBlock Grid.Column="0" Classes="Section"
                           Text="{Binding PsdBucinVM.ManualProgressText}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="Path"
                           Text="{Binding PsdBucinVM.ManualFilename}"
                           VerticalAlignment="Center" Margin="14,0"/>
                
                <CheckBox Grid.Column="2" Classes="Option" Content="Mode Ketik"
                          IsChecked="{Binding PsdBucinVM.IsTypingMode}" VerticalAlignment="Center"/>

                <Button Grid.Column="4" Classes="Muted" Content="Skip (Esc)"
                        Command="{Binding PsdBucinVM.SkipManualCommand}"/>
                <Button Grid.Column="6" Classes="Warn" Content="Keluar"
                        Command="{Binding PsdBucinVM.ExitManualModeCommand}"/>
            </Grid>

            <!-- Image & Loading Overlay -->
            <Border Grid.Row="1"
                    Background="#000000"
                    BorderBrush="#1A1A1D"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True"
                    Margin="0,0,0,14">
                <Grid>
                    <Image Source="{Binding PsdBucinVM.CurrentManualImage}" Stretch="Uniform"
                           IsVisible="{Binding !PsdBucinVM.IsLoadingImage}">
                        <Image.RenderTransform>
                            <RotateTransform Angle="{Binding PsdBucinVM.ImageRotation}" />
                        </Image.RenderTransform>
                    </Image>
                    
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding PsdBucinVM.IsLoadingImage}" Spacing="10">
                        <TextBlock Text="Membuka gambar..." Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="#99000000" IsVisible="{Binding PsdBucinVM.IsProcessing}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <TextBlock Text="Menyimpan..." Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Shortcut buttons -->
            <Grid Grid.Row="2">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding !PsdBucinVM.IsTypingMode}">
                    <ItemsControl ItemsSource="{Binding PsdBucinVM.ManualPsdButtons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ManualPsdButton">
                                <Button Background="Transparent" Padding="0" Cursor="Hand" Margin="4"
                                        x:CompileBindings="False"
                                        Command="{Binding $parent[Window].DataContext.PsdBucinVM.ProcessSingleManualCommand}"
                                        CommandParameter="{Binding Path}">
                                    <Border CornerRadius="7" Padding="16,10"
                                            Background="{Binding ColorHex}"
                                            BorderBrush="#FFFFFF14" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <!-- Editable KBD key badge -->
                                            <Border Background="#00000030"
                                                    BorderBrush="#FFFFFF22" BorderThickness="1"
                                                    CornerRadius="4" Padding="4,0">
                                                <TextBox Text="{Binding ShortcutKey, Mode=TwoWay}"
                                                         Foreground="#FFFFFFBB" FontSize="12"
                                                         FontFamily="{DynamicResource FontMono}"
                                                         Background="Transparent" BorderThickness="0"
                                                         Padding="4,2" MinWidth="24" MaxLength="1"
                                                         TextAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Typing Mode -->
                <StackPanel IsVisible="{Binding PsdBucinVM.IsTypingMode}" Spacing="10" HorizontalAlignment="Center">
                    <AutoCompleteBox Classes="Input" Width="400"
                                     Watermark="Ketik nama template lalu tekan Enter..."
                                     Text="{Binding PsdBucinVM.SearchQuery, Mode=TwoWay}"
                                     ItemsSource="{Binding PsdBucinVM.ManualPsdButtons}"
                                     SelectedItem="{Binding PsdBucinVM.SelectedPsdButton, Mode=TwoWay}"
                                     ValueMemberBinding="{ReflectionBinding Name}"
                                     FilterMode="ContainsOrdinal"
                                     MinimumPrefixLength="1"
                                     x:Name="TypingModeTextBox">
                        <AutoCompleteBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding PsdBucinVM.ExecuteTypingModeCommand}"/>
                        </AutoCompleteBox.KeyBindings>
                    </AutoCompleteBox>
                    <TextBlock Classes="Body" Text="Ketik nama atau shortcut lalu tekan Enter. Tekan Esc untuk skip." HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

        </Grid>

        <!-- ═══ NAV (FLOATING) — Trello board pill (card bordered, short indicator) ═══ -->
        <Border ZIndex="10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="8" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                IsVisible="{Binding !PsdBucinVM.IsManualModeActive}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton Classes="TrelloBoardTab CompactTab" GroupName="ToolboxTabs" IsChecked="{Binding IsPsdBucinVisible}" Command="{Binding SwitchTabCommand}" CommandParameter="{x:Static vm:ToolboxTab.PsdBucin}">
                    <TextBlock Text="MANTRA BUCIN" FontSize="12" FontWeight="SemiBold"/>
                </RadioButton>
                <RadioButton Classes="TrelloBoardTab CompactTab" GroupName="ToolboxTabs" IsChecked="{Binding IsMantraNamaVisible}" Command="{Binding SwitchTabCommand}" CommandParameter="{x:Static vm:ToolboxTab.MantraNama}">
                    <TextBlock Text="MANTRA NAMA" FontSize="12" FontWeight="SemiBold"/>
                </RadioButton>
                <RadioButton Classes="TrelloBoardTab CompactTab" GroupName="ToolboxTabs" IsChecked="{Binding IsMantraGandaVisible}" Command="{Binding SwitchTabCommand}" CommandParameter="{x:Static vm:ToolboxTab.MantraGanda}">
                    <TextBlock Text="MANTRA GANDA" FontSize="12" FontWeight="SemiBold"/>
                </RadioButton>
                <RadioButton Classes="TrelloBoardTab CompactTab" GroupName="ToolboxTabs" IsChecked="{Binding IsMantraDataVisible}" Command="{Binding SwitchTabCommand}" CommandParameter="{x:Static vm:ToolboxTab.MantraData}">
                    <TextBlock Text="MANTRA DATA" FontSize="12" FontWeight="SemiBold"/>
                </RadioButton>
            </StackPanel>
        </Border>

        </Grid>
    </Grid>
</Window>
