<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BMachine.UI.ViewModels"
             xmlns:models="using:BMachine.UI.Models"
             xmlns:controls="using:BMachine.UI.Controls"
             xmlns:views="using:BMachine.UI.Views"
             xmlns:converters="using:BMachine.UI.Converters"
             x:Class="BMachine.UI.Views.RevisionCardListView"
             x:DataType="vm:RevisionCardListViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid x:Name="Part_RootGrid" Background="{DynamicResource AppBackgroundBrush}" SizeChanged="OnRootGridSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Main Content -->
        <Grid x:Name="Part_MainContent" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header (Removed for Unified Tab View) -->
            
            <!-- Cards List -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Cards}"
                     Margin="10,0,10,20"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.Styles>
                            <Style Selector="CheckBox">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                            <Style Selector="CheckBox /template/ Border#PART_Border">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:TrelloCard">
                                <Panel>
                                <!-- Separator View -->
                                <Border IsVisible="{Binding IsSeparator}" Margin="0,24,0,8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                         <PathIcon Data="{StaticResource IconCheckSquare}" Width="14" Height="14" Foreground="{DynamicResource AccentRevisionBrush}"/>
                                         <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Black" LetterSpacing="2" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Normal Card View -->
                                <Button Command="{Binding $parent[UserControl].DataContext.SelectCardCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding !IsSeparator}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Padding="0" BorderThickness="0" Background="Transparent"
                                        Margin="0" CornerRadius="8"
                                        MinHeight="60">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Button.Styles>

                                    <Border x:Name="CardContainer" CornerRadius="8"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="14,10" MinHeight="60"
                                            BoxShadow="0 1 3 0 #20000000"
                                            Classes.selected="{Binding IsActive}"
                                            DragDrop.AllowDrop="True" DragDrop.DragOver="OnCardDragOver" DragDrop.Drop="OnCardDrop" DragDrop.DragLeave="OnCardDragLeave">
                                        <Border.Transitions>
                                            <Transitions>
                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                                                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
                                            </Transitions>
                                        </Border.Transitions>
                                        <Border.Styles>
                                            <Style Selector="Border.selected">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentRevisionBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="Background" Value="#10F97316"/>
                                            </Style>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                                                <Setter Property="BoxShadow" Value="0 3 8 0 #40000000"/>
                                            </Style>
                                            <Style Selector="Border.dragging">
                                                <Setter Property="Opacity" Value="0.25"/>
                                            </Style>
                                        </Border.Styles>

                                        <Grid>
                                            <!-- Cover Line (Top edge line when card has cover) -->
                                            <Border Height="2" VerticalAlignment="Top" Margin="-14,-10,-14,0" CornerRadius="8,8,0,0"
                                                    Background="{Binding CoverColor}" Opacity="0.9"
                                                    IsVisible="{Binding HasCover}"/>

                                            <!-- Content Grid: Col 0 (Indicator) + Col 1 (Checkbox) + Col 2 (Title) + Col 3 (Badges) -->
                                            <Grid ColumnDefinitions="Auto, Auto, *, Auto" VerticalAlignment="Stretch">
                                                <!-- Active Indicator Bar -->
                                                <Border Grid.Column="0" Width="3" Height="14" CornerRadius="1.5"
                                                        Background="{DynamicResource AccentRevisionBrush}"
                                                        Margin="0,0,8,0" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsActive}"/>

                                                <!-- Checkbox -->
                                                <CheckBox Grid.Column="1"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Margin="0,0,10,0" VerticalAlignment="Center"
                                                          Command="{Binding $parent[UserControl].DataContext.SelectionChangedCommand}"/>

                                                <!-- Title -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Name}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="0,1"/>

                                            <!-- Status Badges (Right Side) -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="6">
                                                <!-- Checklist status -->
                                                <Border CornerRadius="6" Padding="6,3" BorderThickness="1"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding HasChecklist}"
                                                        ToolTip.Tip="{Binding ChecklistTooltip}">
                                                    <Border.BorderBrush>
                                                        <MultiBinding Converter="{StaticResource BoolToColorConverter}" ConverterParameter="border">
                                                            <Binding Path="IsChecklistDone"/>
                                                        </MultiBinding>
                                                    </Border.BorderBrush>
                                                    <Border.Background>
                                                        <MultiBinding Converter="{StaticResource BoolToColorConverter}" ConverterParameter="bg">
                                                            <Binding Path="IsChecklistDone"/>
                                                        </MultiBinding>
                                                    </Border.Background>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                                            <Ellipse.Fill>
                                                                <MultiBinding Converter="{StaticResource BoolToColorConverter}" ConverterParameter="dot">
                                                                    <Binding Path="IsChecklistDone"/>
                                                                </MultiBinding>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding ChecklistStatusLabel}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <TextBlock.Foreground>
                                                                <MultiBinding Converter="{StaticResource BoolToColorConverter}" ConverterParameter="text">
                                                                    <Binding Path="IsChecklistDone"/>
                                                                </MultiBinding>
                                                            </TextBlock.Foreground>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
            </ListBox>

            <!-- FAB Refresh Button Removed -->
        </Grid>

        <!-- Separator list | panel (hanya di tampilan yang menampilkan list + panel) -->
        <Border Grid.Column="1" Width="1" Background="{DynamicResource NavigationDividerBrush}" IsHitTestVisible="False">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsAnyPanelOpen"/>
                    <Binding Path="!IsPanelHostedExternally"/>
                </MultiBinding>
            </Border.IsVisible>
        </Border>

        <views:CardDetailPanelHost Grid.Column="2" IsVisible="{Binding !IsPanelHostedExternally}"/>

        <!-- Garis posisi sisip: satu overlay global, selalu di atas kartu mana pun -->
        <Border x:Name="Part_DropLine" Height="5" CornerRadius="2.5"
                HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Margin="6,-9999,6,0" IsVisible="False" ZIndex="950" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource AccentRevisionColor}"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="6" OffsetX="0" OffsetY="1" Opacity="0.6"/>
            </Border.Effect>
        </Border>

        <!-- Ghost kartu yang di-drag (mengikuti kursor seperti Trello) -->
        <Panel Grid.Column="0" Grid.ColumnSpan="3" IsHitTestVisible="False" ZIndex="900">
            <Border x:Name="Part_DragGhost" IsVisible="False" CornerRadius="10"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="-9999,-9999,0,0" Opacity="0.95"
                    BorderBrush="{DynamicResource AccentRevisionBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="18" OffsetX="0" OffsetY="4" Opacity="0.55"/>
                </Border.Effect>
                <Border.Background>
                    <SolidColorBrush Color="#F0111113"/>
                </Border.Background>
                <Image x:Name="Part_DragGhostImage" Stretch="Uniform"/>
            </Border>
        </Panel>
    </Grid>
</UserControl>


