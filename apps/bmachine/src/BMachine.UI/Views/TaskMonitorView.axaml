<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BMachine.UI.ViewModels"
             xmlns:svc="using:BMachine.UI.Services"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="280"
             x:Class="BMachine.UI.Views.TaskMonitorView">

    <UserControl.Styles>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="MinHeight" Value="4"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="0"
            ClipToBounds="True">

        <Grid RowDefinitions="Auto, *, Auto">

            <!-- Header: drag area + title + count + toggle + close -->
            <Border Grid.Row="0" Padding="12,9"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,0,0,1"
                    PointerPressed="OnHeaderPointerPressed"
                    Cursor="SizeAll">
                <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto">
                    <TextBlock Grid.Column="0" Text="File Operations"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="6,1"
                            CornerRadius="8" VerticalAlignment="Center"
                            Background="{DynamicResource AccentLowOpacityBrush}">
                        <TextBlock Text="{Binding ActiveTasks.Count}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBlueBrush}"/>
                    </Border>

                    <Button Grid.Column="3" Classes="IconBtn" Margin="4,0" Click="OnToggleClick"
                            ToolTip.Tip="Tampilkan / sembunyikan daftar"
                            VerticalAlignment="Center">
                        <Panel>
                            <PathIcon Data="{StaticResource IconChevronDown}"
                                      Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                      IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <PathIcon Data="{StaticResource IconChevronUp}"
                                      Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                      IsVisible="{Binding !IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Panel>
                    </Button>
                    <Button Grid.Column="4" Classes="IconBtn" Margin="0" Click="OnCloseClick"
                            ToolTip.Tip="Tutup" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconX}" Width="14" Height="14"
                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Task list -->
            <ScrollViewer Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl ItemsSource="{Binding ActiveTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:FileTaskItem">
                            <Border Padding="12,9" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *, Auto">

                                    <!-- Badge: COPY / MOVE / DELETE -->
                                    <Border Grid.Row="0" Grid.Column="0" Padding="6,1" CornerRadius="4"
                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                            Background="{DynamicResource AccentLowOpacityBrush}">
                                        <TextBlock FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBlueBrush}"
                                                   Text="{Binding TypeLabel}"/>
                                    </Border>

                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}"
                                               FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                                    <!-- Right: status / cancel / remove / retry -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="Berjalan" FontSize="11" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsRunning}"
                                                   Foreground="{DynamicResource AccentBlueBrush}"/>
                                        <TextBlock Text="Selesai" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentGreenBrush}"
                                                   IsVisible="{Binding IsCompleted}"/>
                                        <TextBlock Text="Gagal" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentRedBrush}"
                                                   IsVisible="{Binding IsFailed}"/>
                                        <TextBlock Text="Dibatalkan" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   IsVisible="{Binding IsCancelled}"/>

                                        <Button Classes="IconBtn" VerticalAlignment="Center" ToolTip.Tip="Batalkan"
                                                Command="{Binding $parent[UserControl].DataContext.CancelTaskCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsRunning}">
                                            <PathIcon Data="{StaticResource IconX}" Width="12" Height="12"
                                                      Foreground="{DynamicResource AccentRedBrush}"/>
                                        </Button>
                                        <Button Classes="IconBtn" VerticalAlignment="Center" ToolTip.Tip="Coba lagi"
                                                Command="{Binding $parent[UserControl].DataContext.RetryTaskCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsFailed}">
                                            <PathIcon Data="{StaticResource IconRetry}" Width="12" Height="12"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                        <Button Classes="IconBtn" VerticalAlignment="Center" ToolTip.Tip="Hapus dari daftar"
                                                Command="{Binding $parent[UserControl].DataContext.RemoveTaskCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding !IsRunning}">
                                            <PathIcon Data="{StaticResource IconX}" Width="12" Height="12"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Row 1: progress + persen + speed + ETA (running) -->
                                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                          ColumnDefinitions="*, Auto" IsVisible="{Binding IsRunning}">
                                        <ProgressBar Grid.Column="0" Value="{Binding Progress}" Maximum="100"
                                                     VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Progress, StringFormat='{}{0:F0}%'}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Speed, StringFormat='{}{0:F1} MB/s'}"
                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Eta, StringFormat='sisa {0}'}"
                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 1: source (completed) -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0"
                                               Text="{Binding SourceFolderDisplay, StringFormat='Dari: {0}'}"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               IsVisible="{Binding IsCompleted}"/>

                                    <!-- Row 1: error (failed) -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0"
                                               Text="{Binding ErrorMessage}" FontSize="11"
                                               Foreground="{DynamicResource AccentRedBrush}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding IsFailed}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="12,7"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
                <Button HorizontalAlignment="Right" Content="Bersihkan yang selesai"
                        Command="{Binding ClearCompletedCommand}"
                        Classes="Secondary" FontSize="11" Padding="10,4"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
