<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BMachine.UI.ViewModels"
             xmlns:models="using:BMachine.UI.Models"
             xmlns:controls="using:BMachine.UI.Controls"
             x:Class="BMachine.UI.Views.CommentListView"
             x:DataType="vm:BaseTrelloListViewModel">

    <!-- Satu sumber daftar comment: dipakai CardDetailPanelHost dan CommentWindow -->
    <ScrollViewer x:Name="Part_CommentScrollViewer" BringIntoViewOnFocusChange="False">
        <StackPanel Spacing="15">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingComments}" Height="2" Margin="0,20" Foreground="{DynamicResource AccentBlueBrush}"/>
            <TextBlock Text="No comments yet." IsVisible="{Binding !Comments.Count}"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>

            <ItemsControl ItemsSource="{Binding Comments}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TrelloComment">
                        <StackPanel>
                            <Border IsVisible="{Binding IsActivity, Converter={x:Static BoolConverters.Not}}" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12" BoxShadow="0 2 10 0 #05000000">
                                <Grid RowDefinitions="Auto, *">
                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MemberCreatorName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Date, StringFormat='{}{0:dd MMM HH:mm}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsMine}">
                                            <Button Command="{Binding $parent[UserControl].DataContext.BeginEditCommentCommand}" CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" ToolTip.Tip="Edit Comment"
                                                    IsVisible="{Binding !IsEditing}">
                                                <PathIcon Data="{StaticResource IconEdit}" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>
                                            <Button Command="{Binding $parent[UserControl].DataContext.DeleteCommentCommand}" CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" ToolTip.Tip="Delete Comment"
                                                    IsVisible="{Binding !IsEditing}">
                                                <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" Foreground="#ef4444"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <controls:FormattedTextBlock Text="{Binding Text}"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                                     FontSize="13"
                                                                     IsVisible="{Binding !IsEditing}"/>

                                        <StackPanel IsVisible="{Binding IsEditing}" Spacing="6" Margin="0,8,0,0">
                                            <TextBox Text="{Binding EditText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                                     Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="12" BorderThickness="1"
                                                     Padding="12" FontSize="13"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <Button Content="Cancel" Command="{Binding $parent[UserControl].DataContext.CancelEditCommentCommand}" CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Padding="12,6" CornerRadius="8" Cursor="Hand" FontSize="12" FontWeight="Medium"/>
                                                <Button Content="Save" Command="{Binding $parent[UserControl].DataContext.SaveEditCommentCommand}" CommandParameter="{Binding}"
                                                        Background="{DynamicResource AccentColorBrush}" Foreground="White" Padding="12,6" CornerRadius="8" Cursor="Hand" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Activity row (move/transfer/completed) -->
                            <Border Padding="6,2" Margin="0,0,0,8" Background="Transparent">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsActivity"/>
                                        <Binding Path="$parent[UserControl].DataContext.ShowActivity"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                                    <Border Grid.Column="0" Width="4" Height="4" CornerRadius="2" Background="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ActivityText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Date, StringFormat='{}{0:dd MMM HH:mm}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
