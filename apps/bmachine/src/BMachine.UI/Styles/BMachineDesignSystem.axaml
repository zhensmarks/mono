<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ================================================================ -->
    <!-- BMACHINE DESIGN SYSTEM v1.0                                      -->
    <!-- Aturan terpusat: font, warna, radius, hover, icon, spacing       -->
    <!-- Semua view WAJIB pakai token & Classes di file ini.              -->
    <!-- Jangan hardcode warna/radius/font di View lagi.                  -->
    <!-- ================================================================ -->

    <Styles.Resources>
        <!-- ── Typography ── -->
        <FontFamily x:Key="FontPrimary">Inter, Segoe UI Variable, Segoe UI, SF Pro Text, Helvetica Neue, Arial, sans-serif</FontFamily>
        <FontFamily x:Key="FontMono">Cascadia Code, JetBrains Mono, Consolas, monospace</FontFamily>

        <!-- ── Radius scale (selaras) ── -->
        <CornerRadius x:Key="RadiusSm">6</CornerRadius>
        <CornerRadius x:Key="RadiusMd">8</CornerRadius>
        <CornerRadius x:Key="RadiusLg">10</CornerRadius>
        <CornerRadius x:Key="RadiusXl">12</CornerRadius>
        <CornerRadius x:Key="RadiusPill">999</CornerRadius>

        <!-- ── Spacing scale ── -->
        <Thickness x:Key="SpaceXs">4</Thickness>
        <Thickness x:Key="SpaceSm">8</Thickness>
        <Thickness x:Key="SpaceMd">12</Thickness>
        <Thickness x:Key="SpaceLg">16</Thickness>
        <Thickness x:Key="SpaceXl">20</Thickness>

        <!-- ── Icon sizes (selaras) ── -->
        <x:Double x:Key="IconXs">12</x:Double>
        <x:Double x:Key="IconSm">14</x:Double>
        <x:Double x:Key="IconMd">16</x:Double>
        <x:Double x:Key="IconLg">18</x:Double>
        <x:Double x:Key="IconXl">24</x:Double>

        <!-- Semantic color-state brushes are defined per mode in DarkTheme/LightTheme. -->
    </Styles.Resources>

    <!-- ================================================================ -->
    <!-- WINDOW BASE STYLE                                                -->
    <!-- Semua window BMachine otomatis mengikuti warna Background        -->
    <!-- dan Teks dari Pengaturan Appearance (AppBackgroundBrush).        -->
    <!-- ================================================================ -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ================================================================ -->
    <!-- TYPOGRAPHY                                                       -->
    <!-- ================================================================ -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0.3" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="LetterSpacing" Value="1.2" />
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ================================================================ -->
    <!-- CARD / BENTO                                                     -->
    <!-- Selaras: Background CardBackgroundBrush, Border SeparatorBrush,   -->
    <!-- Radius 10, Padding 16-20, tanpa shadow/glow                      -->
    <!-- ================================================================ -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.cardSm">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="{StaticResource SpaceLg}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- ================================================================ -->
    <!-- BUTTON — 4 varian selaras                                        -->
    <!-- primary (Action) : high-contrast semantic brushes resolved by theme -->
    <!-- secondary (Muted): #1C1C1F + border #3F3F46 / hover #27272B       -->
    <!-- ghost (Clear)    : transparent / hover #10FFFFFF                 -->
    <!-- danger (Warn)    : #1C0F0F + border #5A2020 / hover #2A1010      -->
    <!-- Semua: Radius 6, Height 36, Font 12.5 SemiBold, transition 0.15s -->
    <!-- ================================================================ -->
    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <!-- StatWidget exception: allow auto height, not 36 -->
    <Style Selector="Button.StatBtn">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="110" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- Primary = Action (canonical) -->
    <Style Selector="Button.primary, Button.Action">
        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter, Button.Action /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter, Button.Action:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryHoverBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter, Button.Action:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryPressedBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled, Button.Action:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button:disabled, ToggleButton:disabled, RadioButton:disabled">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- Secondary = Muted (canonical) -->
    <Style Selector="Button.secondary, Button.Muted">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter, Button.Muted /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter, Button.Muted:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}" />
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter, Button.Muted:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBrush}" />
    </Style>

    <!-- Small Doc toolbar controls share the same accessible theme states in both layouts. -->
    <Style Selector="Button.docTool">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.docTool:pointerover">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.docTool:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBrush}" />
    </Style>
    <Style Selector="Button.docTool:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
    </Style>
    <Style Selector="Button.docTool:disabled">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- Ghost = Clear -->
    <Style Selector="Button.ghost, Button.Clear">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Height" Value="NaN" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter, Button.Clear /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter, Button.Clear:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter, Button.Clear:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgActiveBrush}" />
    </Style>

    <!-- Danger = Warn -->
    <Style Selector="Button.danger, Button.Warn">
        <Setter Property="Background" Value="{DynamicResource ButtonDangerBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter, Button.Warn /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDangerBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter, Button.Warn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDangerHoverBrush}" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter, Button.Warn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDangerPressedBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}" />
    </Style>
    <Style Selector="Button.danger:focus, Button.Warn:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
    </Style>
    <Style Selector="Button.danger:disabled, Button.Warn:disabled">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- Accent (outline) -->
    <Style Selector="Button.accent, Button.Accent">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ Border#PART_Border, Button.Accent:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>

    <!-- ================================================================ -->
    <!-- TEXTBOX — selaras                                                -->
    <!-- Default: Bg #0C0C0E, Border #232326, Radius 6, Padding 10,       -->
    <!-- Height 36, hover Border #3F3F46, focus Border #4B4B52 + 1px      -->
    <!-- ================================================================ -->
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentColorBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentColorBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgInputHoverBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
    </Style>
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- Variants -->
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="Padding" Value="12,0,10,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
    </Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
    </Style>

    <!-- ================================================================ -->
    <!-- COMBOBOX / AUTOCOMPLETEBOX / NUMERICUPDOWN — selaras dengan TextBox -->
    <!-- ================================================================ -->
    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,0,8,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="AutoCompleteBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="NumericUpDown:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
    </Style>
    <Style Selector="NumericUpDown:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
    </Style>

    <!-- ================================================================ -->
    <!-- CHECKBOX — selaras                                               -->
    <!-- Box 16x16, Radius 4, Border #3F3F46, checked Bg Accent,          -->
    <!-- hover Border #52525B, transition 0.15s                           -->
    <!-- ================================================================ -->
    <Style Selector="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="CheckBox /template/ Border#PART_Border">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
    </Style>
    <Style Selector="CheckBox:checked:pointerover /template/ Border#PART_Border">
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="CheckBox:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- ================================================================ -->
    <!-- TOGGLE SWITCH — sudah ada di App.axaml, diselaraskan di sini     -->
    <!-- Track 44x24, Thumb 18, Radius 12, transition 0.25s               -->
    <!-- ================================================================ -->
    <!-- Switch style tetap di App.axaml (ToggleButton.Switch) agar tidak duplikat.
         Token di sini memastikan warna konsisten. -->

    <!-- ================================================================ -->
    <!-- ICON — selaras                                                   -->
    <!-- PathIcon default 16, warna TextSecondary, hover TextPrimary      -->
    <!-- Ukuran pakai token: IconXs 12, IconSm 14, IconMd 16, IconLg 18  -->
    <!-- ================================================================ -->
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="{StaticResource IconMd}" />
        <Setter Property="Height" Value="{StaticResource IconMd}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Path Data="{TemplateBinding Data}"
                      Fill="Transparent"
                      Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1.8"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Stretch="Uniform"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="PathIcon.xs">
        <Setter Property="Width" Value="{StaticResource IconXs}" />
        <Setter Property="Height" Value="{StaticResource IconXs}" />
    </Style>
    <Style Selector="PathIcon.sm">
        <Setter Property="Width" Value="{StaticResource IconSm}" />
        <Setter Property="Height" Value="{StaticResource IconSm}" />
    </Style>
    <Style Selector="PathIcon.lg">
        <Setter Property="Width" Value="{StaticResource IconLg}" />
        <Setter Property="Height" Value="{StaticResource IconLg}" />
    </Style>
    <Style Selector="PathIcon.xl">
        <Setter Property="Width" Value="{StaticResource IconXl}" />
        <Setter Property="Height" Value="{StaticResource IconXl}" />
    </Style>
    <!-- Icon di dalam button: ikut warna button -->
    <Style Selector="Button PathIcon">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <!-- Icon-only controls share a 32 px target and visible hover/pressed/focus states. -->
    <Style Selector="Button.IconBtn, Button.iconBtn">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.IconBtn:pointerover, Button.iconBtn:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.IconBtn:pressed, Button.iconBtn:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBrush}" />
    </Style>
    <Style Selector="Button.IconBtn:focus, Button.iconBtn:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
    </Style>
    <Style Selector="Button.IconBtn:disabled, Button.iconBtn:disabled">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.IconBtn.primary, Button.iconBtn.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.IconBtn.primary:pointerover, Button.iconBtn.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
    </Style>
    <Style Selector="Button.IconBtn.primary:pressed, Button.iconBtn.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryPressedBrush}" />
    </Style>

    <!-- Custom window-close buttons share one compact hit target and glyph size. -->
    <Style Selector="Button.WindowClose">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.WindowClose:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.WindowClose:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.WindowClose:disabled">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.WindowClose:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.WindowClose:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.WindowClose PathIcon">
        <Setter Property="Width" Value="{StaticResource IconSm}" />
        <Setter Property="Height" Value="{StaticResource IconSm}" />
    </Style>

    <!-- Inline side-panel dismiss controls use one smaller, consistent hit target. -->
    <Style Selector="Button.PanelClose">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.PanelClose:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}" />
    </Style>
    <Style Selector="Button.PanelClose:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.PanelClose:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDangerHoverBrush}" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.PanelClose:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDangerPressedBrush}" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.PanelClose PathIcon">
        <Setter Property="Width" Value="{StaticResource IconSm}" />
        <Setter Property="Height" Value="{StaticResource IconSm}" />
    </Style>

    <!-- ================================================================ -->
    <!-- SEPARATOR / DIVIDER                                              -->
    <!-- ================================================================ -->
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource SeparatorBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,12" />
    </Style>
    <Style Selector="Rectangle.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{DynamicResource SeparatorBrush}" />
        <Setter Property="Margin" Value="0,12" />
    </Style>

    <!-- Shared navigation divider. Horizontal rows use a vertical stroke;
         vertical stacks can add the horizontal class for the rotated form. -->
    <Style Selector="Border.navigationSeparator">
        <Setter Property="Background" Value="{DynamicResource NavigationDividerBrush}" />
        <Setter Property="Width" Value="2" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.navigationSeparator.horizontal">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="2" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <!-- ================================================================ -->
    <!-- TOOLTIP — selaras                                                -->
    <!-- ================================================================ -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="#0A0A0A" />
        <Setter Property="Foreground" Value="#E4E4E7" />
        <Setter Property="BorderBrush" Value="#232326" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
    </Style>

    <!-- ================================================================ -->
    <!-- PANEL DIVIDER — aturan layout panel                              -->
    <!-- Setiap panel yang tampil berdampingan dengan konten lain WAJIB   -->
    <!-- diberi garis pemisah 1px lewat Classes="panel-divider" di sisi   -->
    <!-- panel. Panel yang tampil sendirian (single view, mengisi window) -->
    <!-- TIDAK boleh diberi garis pemisah.                                -->
    <!-- ================================================================ -->
    <Style Selector="Border.panel-divider">
        <Setter Property="Width" Value="1" />
        <Setter Property="MinWidth" Value="1" />
        <Setter Property="Background" Value="{DynamicResource NavigationDividerBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ================================================================ -->
    <!-- SCROLLBAR — selalu tampil di kolomnya sendiri (tidak overlay)     -->
    <!-- Konten tidak tertutup scrollbar. Tidak hidden.                    -->
    <!-- ================================================================ -->
    <!-- ScrollViewer override: scrollbar di gutter sendiri (bukan overlay),
         auto-hide: invisible saat diam, muncul saat pointer masuk. -->
    <Styles.Resources>
    <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
                    <ScrollContentPresenter Name="PART_ContentPresenter"
                                            Grid.Row="0" Grid.Column="0"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                            VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                            ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
                        <ScrollContentPresenter.GestureRecognizers>
                            <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                                     CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                                     IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}"/>
                        </ScrollContentPresenter.GestureRecognizers>
                    </ScrollContentPresenter>
                    <ScrollBar Name="PART_VerticalScrollBar"
                               Orientation="Vertical" Grid.Column="1"
                               Width="8" Margin="8,6,0,6" Opacity="0" />
                    <ScrollBar Name="PART_HorizontalScrollBar"
                               Orientation="Horizontal" Grid.Row="1"
                               Height="8" Margin="6,8,6,0" Opacity="0" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ScrollBar#PART_VerticalScrollBar">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:pointerover /template/ ScrollBar#PART_HorizontalScrollBar">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </ControlTheme>
</Styles.Resources>
</Styles>
