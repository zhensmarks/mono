<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ================================================================ -->
    <!-- TRELLO NAVIGATION DESIGN SYSTEM                                  -->
    <!-- Mimics trello.com header + board navigation                      -->
    <!-- Header: #026AA7 / #0079BF, buttons rgba(255,255,255,0.2-0.4)     -->
    <!-- Board tabs: underline indicator #0079BF, hover #091E4214         -->
    <!-- Adapted for BMachine dark theme (#121212 / #1A1C20)              -->
    <!-- ================================================================ -->
    <Styles.Resources>
        <!-- Trello core palette -->
        <Color x:Key="TrelloBlue">#0079BF</Color>
        <Color x:Key="TrelloDarkBlue">#026AA7</Color>
        <Color x:Key="TrelloHeaderBg">#026AA7</Color>
        <Color x:Key="TrelloBoardBg">#0079BF</Color>
        <!-- Translucent whites for header buttons -->
        <Color x:Key="TrelloBtnBg">#33FFFFFF</Color>        <!-- 20% white -->
        <Color x:Key="TrelloBtnHoverBg">#4DFFFFFF</Color>   <!-- 30% white -->
        <Color x:Key="TrelloBtnActiveBg">#66FFFFFF</Color>  <!-- 40% white -->
        <Color x:Key="TrelloBtnPressedBg">#80FFFFFF</Color> <!-- 50% white -->
        <SolidColorBrush x:Key="TrelloBlueBrush" Color="{StaticResource TrelloBlue}" />
        <SolidColorBrush x:Key="TrelloDarkBlueBrush" Color="{StaticResource TrelloDarkBlue}" />
        <SolidColorBrush x:Key="TrelloHeaderBrush" Color="{StaticResource TrelloHeaderBg}" />
        <SolidColorBrush x:Key="TrelloBtnBgBrush" Color="{StaticResource TrelloBtnBg}" />
        <SolidColorBrush x:Key="TrelloBtnHoverBrush" Color="{StaticResource TrelloBtnHoverBg}" />
        <SolidColorBrush x:Key="TrelloBtnActiveBrush" Color="{StaticResource TrelloBtnActiveBg}" />
        <SolidColorBrush x:Key="TrelloTextBrush" Color="White" />
        <SolidColorBrush x:Key="TrelloTextSecondaryBrush" Color="#CCFFFFFF" />
        <!-- Board tab tokens (light/dark adaptive via DynamicResource fallback) -->
        <SolidColorBrush x:Key="TrelloTabHoverBg" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="TrelloTabActiveBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TrelloTabActiveTextBrush" Color="{StaticResource TrelloBlue}" />
    </Styles.Resources>

    <!-- ================================================================ -->
    <!-- TRELLO HEADER BAR CONTAINER                                      -->
    <!-- Usage: <Border Classes="TrelloHeaderBar">                        -->
    <!-- ================================================================ -->
    <Style Selector="Border.TrelloHeaderBar">
        <Setter Property="Background" Value="{StaticResource TrelloHeaderBrush}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BoxShadow" Value="0 1 0 0 #1A000000" />
    </Style>
    <Style Selector="Border.TrelloHeaderBarDark">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- ================================================================ -->
    <!-- TRELLO NAV BUTTON (Header pill)                                  -->
    <!-- RadioButton with icon+text, Trello header logic                  -->
    <!-- States: default translucent, hover 30%, checked solid white/blue -->
    <!-- ================================================================ -->
    <Style Selector="RadioButton.TrelloNavButton">
        <Setter Property="Background" Value="{StaticResource TrelloBtnBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TrelloTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- Hover: 30% white -->
    <Style Selector="RadioButton.TrelloNavButton:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{StaticResource TrelloBtnHoverBrush}" />
    </Style>
    <!-- Checked: solid white bg, Trello blue text, bold -->
    <Style Selector="RadioButton.TrelloNavButton:checked">
        <Setter Property="Background" Value="{StaticResource TrelloTabActiveBg}" />
        <Setter Property="Foreground" Value="{StaticResource TrelloBlueBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="RadioButton.TrelloNavButton:checked /template/ Border#PART_Border">
        <Setter Property="Background" Value="{StaticResource TrelloTabActiveBg}" />
        <Setter Property="BoxShadow" Value="0 1 2 0 #1A000000" />
    </Style>
    <Style Selector="RadioButton.TrelloNavButton:checked PathIcon">
        <Setter Property="Foreground" Value="{StaticResource TrelloBlueBrush}" />
    </Style>
    <Style Selector="RadioButton.TrelloNavButton:checked TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TrelloBlueBrush}" />
    </Style>
    <!-- Pressed -->
    <Style Selector="RadioButton.TrelloNavButton:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{StaticResource TrelloBtnPressedBg}" />
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="RadioButton.TrelloNavButton:checked:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="#E6E6E6" />
    </Style>
    <!-- Disabled -->
    <Style Selector="RadioButton.TrelloNavButton:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Dark variant for use on dark backgrounds (CardBackground) -->
    <Style Selector="RadioButton.TrelloNavButton.dark">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="RadioButton.TrelloNavButton.dark:pointerover">
        <Setter Property="Background" Value="{StaticResource TrelloTabHoverBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.TrelloNavButton.dark:checked">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ================================================================ -->
    <!-- TRELLO BOARD TAB - trello.com style                              -->
    <!-- Active: subtle background #22272B + short centered underline 20px -->
    <!-- Mimics screenshot: dark pill with 3px short blue line at bottom  -->
    <!-- ================================================================ -->
    <Style Selector="RadioButton.TrelloBoardTab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Panel>
                        <Grid Margin="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <Border Name="PART_Indicator"
                                Width="14" Height="3"
                                CornerRadius="1.5"
                                Background="{DynamicResource AccentBlueBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,3"
                                Opacity="0" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.TrelloBoardTab:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.TrelloBoardTab:checked">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="RadioButton.TrelloBoardTab:focus /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="RadioButton.TrelloBoardTab:checked /template/ Border#PART_Root">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="RadioButton.TrelloBoardTab:checked:focus /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="RadioButton.TrelloBoardTab:checked /template/ Border#PART_Indicator">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="RadioButton.TrelloBoardTab:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleHoverBrush}" />
    </Style>

    <Style Selector="RadioButton.LogPanelTab, RadioButton.CompactTab">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="RadioButton.LogPanelTab">
        <Setter Property="Padding" Value="0,5" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="RadioButton.CompactTab">
        <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style Selector="RadioButton.LogPanelTab:checked /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="RadioButton.LogPanelTab:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>
    <Style Selector="RadioButton.LogPanelTab:checked:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleHoverBrush}" />
    </Style>
    <Style Selector="RadioButton.LogPanelTab:focus /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="RadioButton.LogPanelTab:pressed /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBrush}" />
    </Style>
    <Style Selector="RadioButton.LogPanelTab:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="RadioButton.TrelloBoardTab PathIcon">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
    </Style>
    <Style Selector="RadioButton.CompactTab /template/ ContentPresenter">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Nav band shared metrics: both nav groups use these so they match -->
    <Style Selector="Border.navBand">
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Button.navChip">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <!-- Responsive nav density: host view root gets NavSm/NavXs class by width -->
    <Style Selector=".NavSm RadioButton.LogPanelTab, .NavSm RadioButton.CompactTab, .NavSm Button.navChip">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector=".NavSm RadioButton.CompactTab">
        <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style Selector=".NavSm RadioButton TextBlock.navLabel, .NavSm Button.navChip TextBlock.navLabel">
        <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector=".NavXs RadioButton.LogPanelTab, .NavXs RadioButton.CompactTab, .NavXs Button.navChip">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="9" />
    </Style>
    <Style Selector=".NavXs RadioButton.CompactTab">
        <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style Selector=".NavXs RadioButton TextBlock.navLabel, .NavXs Button.navChip TextBlock.navLabel">
        <Setter Property="FontSize" Value="9" />
    </Style>

    <!-- Active underline follows the tab size (14x3 base) -->
    <Style Selector=".NavSm RadioButton.TrelloBoardTab /template/ Border#PART_Indicator">
        <Setter Property="Width" Value="12" />
    </Style>
    <Style Selector=".NavXs RadioButton.TrelloBoardTab /template/ Border#PART_Indicator">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="2" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Nav icons follow the tab size too -->
    <Style Selector=".NavSm Border.searchBar">
        <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector=".NavXs Border.searchBar">
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- Icon-only nav chip (profile): content-sized like the explorer icon tab, so the
         gap on both sides of the icon matches (MinWidth here left dead space that made
         the icon look pushed to the left). -->
    <Style Selector="Button.navIconChip">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=".NavSm Button.navIconChip">
        <Setter Property="Padding" Value="7,0" />
    </Style>
    <Style Selector=".NavXs Button.navIconChip">
        <Setter Property="Padding" Value="6,0" />
    </Style>

    <!-- Icon-only tab keeps its own tight width instead of a full star slot -->
    <Style Selector="RadioButton.navIconTab">
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector=".NavSm RadioButton.navIconTab">
        <Setter Property="Padding" Value="7,0" />
    </Style>
    <Style Selector=".NavXs RadioButton.navIconTab">
        <Setter Property="Padding" Value="6,0" />
    </Style>

    <Style Selector="PathIcon.navIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector=".NavSm PathIcon.navIcon">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
    </Style>
    <Style Selector=".NavXs PathIcon.navIcon">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <!-- Attachment tiles + DOC fields shrink in narrow hosts -->
    <Style Selector="WrapPanel.attachWrap">
        <Setter Property="ItemWidth" Value="160" />
        <Setter Property="ItemHeight" Value="160" />
    </Style>
    <Style Selector=".NavSm WrapPanel.attachWrap">
        <Setter Property="ItemWidth" Value="140" />
        <Setter Property="ItemHeight" Value="140" />
    </Style>
    <Style Selector=".NavXs WrapPanel.attachWrap">
        <Setter Property="ItemWidth" Value="118" />
        <Setter Property="ItemHeight" Value="118" />
    </Style>
    <Style Selector=".NavSm Button.docTool">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector=".NavXs Button.docTool">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector=".NavSm Border.logoDrop">
        <Setter Property="MinHeight" Value="80" />
    </Style>
    <Style Selector=".NavXs Border.logoDrop">
        <Setter Property="MinHeight" Value="64" />
    </Style>

    <Style Selector="TextBox.docField">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector=".NavSm TextBox.docField">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="6,5,38,5" />
    </Style>
    <Style Selector=".NavXs TextBox.docField">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="5,4,34,4" />
    </Style>

    <!-- ================================================================ -->
    <!-- TRELLO HEADER BUTTON (regular Button, not Radio)                 -->
    <!-- For Create, Search, etc.                                         -->
    <!-- ================================================================ -->
    <Style Selector="Button.TrelloHeaderButton">
        <Setter Property="Background" Value="{StaticResource TrelloBtnBgBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.TrelloHeaderButton:pointerover /template/ Border">
        <Setter Property="Background" Value="{StaticResource TrelloBtnHoverBrush}" />
    </Style>
    <Style Selector="Button.TrelloHeaderButton:pressed /template/ Border">
        <Setter Property="Background" Value="{StaticResource TrelloBtnActiveBrush}" />
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <!-- Primary variant (solid white) -->
    <Style Selector="Button.TrelloHeaderButton.primary">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource TrelloBlueBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.TrelloHeaderButton.primary:pointerover /template/ Border">
        <Setter Property="Background" Value="#F0F0F0" />
    </Style>

    <!-- ================================================================ -->
    <!-- TRELLO PILL CONTAINER (segmented control wrapper)                -->
    <!-- Mimics Trello's board menu pill container                        -->
    <!-- ================================================================ -->
    <Style Selector="Border.TrelloPillContainer">
        <Setter Property="Background" Value="#0F1A2E" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#1E2D4A" />
    </Style>
    <Style Selector="Border.TrelloPillContainer.light">
        <Setter Property="Background" Value="#F1F2F4" />
        <Setter Property="BorderBrush" Value="#DFE1E6" />
    </Style>
</Styles>
