<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors -->
    <Color x:Key="AppBackground">#F5F5F5</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="AccentBlue">#3b82f6</Color>
    <Color x:Key="AccentOrange">#f97316</Color>
    <Color x:Key="AccentPurple">#1d4ed8</Color>
    <Color x:Key="AccentPoints">#f97316</Color>
    <!-- In Light Mode, Primary Text is Dark, Secondary is Gray -->
    <Color x:Key="TextPrimary">#121212</Color>
    <Color x:Key="TextSecondary">#666666</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource AppBackground}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource CardBackground}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{DynamicResource AccentBlue}"/>
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{DynamicResource AccentOrange}"/>
    <SolidColorBrush x:Key="AccentPointsBrush" Color="{DynamicResource AccentPoints}"/>
    <SolidColorBrush x:Key="AccentLowOpacityBrush" Color="#1A3B82F6"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#DFFFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="White"/>
    <!-- Subtle elevated surface (popup stat strip, avatar viewer) -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="NavigationDividerBrush" Color="#737D8B"/>
    <SolidColorBrush x:Key="RadialMenuHoverForegroundBrush" Color="#121212"/>

    <!-- Shared presentation tokens (resolved by the active theme). -->
    <SolidColorBrush x:Key="BgHoverBrush" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="BgActiveBrush" Color="#1A3B82F6"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgInputHoverBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E1E5EA"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#52525B"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#52525B"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#263B82F6"/>
    <SolidColorBrush x:Key="AccentSubtleHoverBrush" Color="#333B82F6"/>
    <SolidColorBrush x:Key="ButtonSecondaryBackgroundBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="ButtonSecondaryForegroundBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="ButtonSecondaryBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ButtonSecondaryHoverBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="ButtonSecondaryPressedBrush" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="ButtonPrimaryBackgroundBrush" Color="#EDEDED"/>
    <SolidColorBrush x:Key="ButtonPrimaryForegroundBrush" Color="#111111"/>
    <SolidColorBrush x:Key="ButtonPrimaryHoverBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonPrimaryPressedBrush" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="ButtonDangerBackgroundBrush" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="ButtonDangerForegroundBrush" Color="#991B1B"/>
    <SolidColorBrush x:Key="ButtonDangerBorderBrush" Color="#FECACA"/>
    <SolidColorBrush x:Key="ButtonDangerHoverBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="ButtonDangerPressedBrush" Color="#FECACA"/>
    <SolidColorBrush x:Key="SwitchOffBackgroundBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="SwitchOffBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="SwitchHoverBackgroundBrush" Color="#D1D5DB"/>

    <!-- Log Brushes (Darker for Light Theme) -->
    <SolidColorBrush x:Key="LogInfoBrush" Color="#004d99"/>     <!-- Dark Blue -->
    <SolidColorBrush x:Key="LogSystemBrush" Color="#006666"/>   <!-- Dark Teal -->
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#15803d"/>  <!-- Dark Green -->
    <SolidColorBrush x:Key="LogWarningBrush" Color="#c2410c"/>  <!-- Dark Orange -->
    <SolidColorBrush x:Key="LogErrorBrush" Color="#b91c1c"/>    <!-- Dark Red -->
    <SolidColorBrush x:Key="LogDebugBrush" Color="#525252"/>    <!-- Dark Gray -->

    <!-- TERMINAL SPECIFIC COLORS -->
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#F8F9FA"/> <!-- Light Gray BG for Light Theme -->
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#1F2937"/>       <!-- Gray-800 -->
    <SolidColorBrush x:Key="TerminalInfoBrush" Color="#1d4ed8"/>       <!-- Blue-700 (Readable on White) -->
    <SolidColorBrush x:Key="TerminalSuccessBrush" Color="#15803d"/>    <!-- Green-700 -->
    <SolidColorBrush x:Key="TerminalWarningBrush" Color="#c2410c"/>    <!-- Orange-700 -->
    <SolidColorBrush x:Key="TerminalErrorBrush" Color="#b91c1c"/>      <!-- Red-700 -->
    <SolidColorBrush x:Key="TerminalSystemBrush" Color="#0f766e"/>     <!-- Teal-700 -->
    <SolidColorBrush x:Key="TerminalDebugBrush" Color="#4b5563"/>      <!-- Gray-600 -->

    <!-- Menu & Navigation Selection -->
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#10000000"/>
    <SolidColorBrush x:Key="MenuSelectedBrush" Color="#C9C9C9"/>

    <!-- Legacy/Missing Brushes -->
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{DynamicResource CardBackground}"/>
    <SolidColorBrush x:Key="AccentEditingBrush" Color="{DynamicResource AccentBlue}"/>
    <SolidColorBrush x:Key="AccentRevisionBrush" Color="{DynamicResource AccentOrange}"/>
    <SolidColorBrush x:Key="AccentLateBrush" Color="#ef4444"/>
    <SolidColorBrush x:Key="AccentRevisionLowOpacityBrush" Color="#33f97316"/>

    <!-- Dialog Accents -->
    <SolidColorBrush x:Key="AccentRedBrush" Color="#dc2626"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#16a34a"/>

     <!-- Default Shared Accents (Prevent crash/empty if ThemeService delays) -->
    <SolidColorBrush x:Key="AccentColorBrush" Color="{DynamicResource AccentBlue}"/>
    <Color x:Key="AccentColor">#3b82f6</Color>

    <!-- Icon geometry is supplied by the shared Tabler outline dictionary. -->
</ResourceDictionary>
