<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors -->
    <Color x:Key="AppBackground">#121212</Color>
    <Color x:Key="CardBackground">#1A1C20</Color>
    <Color x:Key="AccentBlue">#3b82f6</Color>
    <Color x:Key="AccentOrange">#f97316</Color>
    <Color x:Key="AccentPurple">#1d4ed8</Color>
    <Color x:Key="AccentPoints">#f97316</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#99FFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource AppBackground}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource CardBackground}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{DynamicResource AccentBlue}"/>
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{DynamicResource AccentOrange}"/>
    <SolidColorBrush x:Key="AccentPointsBrush" Color="{DynamicResource AccentPoints}"/>
    <SolidColorBrush x:Key="AccentLowOpacityBrush" Color="#263B82F6"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#CC000000"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="White"/>
    <!-- Subtle elevated surface (popup stat strip, avatar viewer) -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#202226"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#26282C"/>
    <SolidColorBrush x:Key="NavigationDividerBrush" Color="#656A73"/>
    <SolidColorBrush x:Key="RadialMenuHoverForegroundBrush" Color="#FFFFFF"/>

    <!-- Shared presentation tokens (resolved by the active theme). -->
    <SolidColorBrush x:Key="BgHoverBrush" Color="#25282D"/>
    <SolidColorBrush x:Key="BgActiveBrush" Color="#333B82F6"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="#0C0C0E"/>
    <SolidColorBrush x:Key="BgInputHoverBrush" Color="#111113"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#303036"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#484850"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#5B8DEF"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#3A3D42"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#8B8B92"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#263B82F6"/>
    <SolidColorBrush x:Key="AccentSubtleHoverBrush" Color="#333B82F6"/>
    <SolidColorBrush x:Key="ButtonSecondaryBackgroundBrush" Color="#1C1C1F"/>
    <SolidColorBrush x:Key="ButtonSecondaryForegroundBrush" Color="#E4E4E7"/>
    <SolidColorBrush x:Key="ButtonSecondaryBorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="ButtonSecondaryHoverBrush" Color="#27272B"/>
    <SolidColorBrush x:Key="ButtonSecondaryPressedBrush" Color="#222226"/>
    <SolidColorBrush x:Key="ButtonPrimaryBackgroundBrush" Color="#EDEDED"/>
    <SolidColorBrush x:Key="ButtonPrimaryForegroundBrush" Color="#111111"/>
    <SolidColorBrush x:Key="ButtonPrimaryHoverBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonPrimaryPressedBrush" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="ButtonDangerBackgroundBrush" Color="#2A1114"/>
    <SolidColorBrush x:Key="ButtonDangerForegroundBrush" Color="#FF9FA5"/>
    <SolidColorBrush x:Key="ButtonDangerBorderBrush" Color="#7A353C"/>
    <SolidColorBrush x:Key="ButtonDangerHoverBrush" Color="#37171C"/>
    <SolidColorBrush x:Key="ButtonDangerPressedBrush" Color="#451A21"/>
    <SolidColorBrush x:Key="SwitchOffBackgroundBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="SwitchOffBorderBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="SwitchHoverBackgroundBrush" Color="#25FFFFFF"/>

    <!-- Log Brushes (Lighter for Dark Theme) -->
    <SolidColorBrush x:Key="LogInfoBrush" Color="#60a5fa"/>     <!-- Light Blue -->
    <SolidColorBrush x:Key="LogSystemBrush" Color="#2dd4bf"/>   <!-- Teal -->
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#4ade80"/>  <!-- Light Green -->
    <SolidColorBrush x:Key="LogWarningBrush" Color="#fb923c"/>  <!-- Orange -->
    <SolidColorBrush x:Key="LogErrorBrush" Color="#f87171"/>    <!-- Light Red -->
    <SolidColorBrush x:Key="LogDebugBrush" Color="#9ca3af"/>    <!-- Gray -->

    <!-- TERMINAL SPECIFIC COLORS -->
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#E5E7EB"/>       <!-- Gray-200 -->
    <SolidColorBrush x:Key="TerminalInfoBrush" Color="#60a5fa"/>       <!-- Blue-400 -->
    <SolidColorBrush x:Key="TerminalSuccessBrush" Color="#4ade80"/>    <!-- Green-400 -->
    <SolidColorBrush x:Key="TerminalWarningBrush" Color="#fb923c"/>    <!-- Orange-400 -->
    <SolidColorBrush x:Key="TerminalErrorBrush" Color="#f87171"/>      <!-- Red-400 -->
    <SolidColorBrush x:Key="TerminalSystemBrush" Color="#2dd4bf"/>     <!-- Teal-400 -->
    <SolidColorBrush x:Key="TerminalDebugBrush" Color="#9ca3af"/>      <!-- Gray-400 -->
    <!-- Menu & Navigation Selection -->
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="MenuSelectedBrush" Color="#1E1E1E"/>

    <!-- Legacy/Missing Brushes -->
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{DynamicResource CardBackground}"/>
    <SolidColorBrush x:Key="AccentEditingBrush" Color="{DynamicResource AccentBlue}"/>
    <SolidColorBrush x:Key="AccentRevisionBrush" Color="{DynamicResource AccentOrange}"/>
    <SolidColorBrush x:Key="AccentLateBrush" Color="#ef4444"/>
    <SolidColorBrush x:Key="AccentRevisionLowOpacityBrush" Color="#33f97316"/>

    <!-- Dialog Accents -->
    <SolidColorBrush x:Key="AccentRedBrush" Color="#ef4444"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#22c55e"/>

    <!-- Default Shared Accents (Prevent crash/empty if ThemeService delays) -->
    <SolidColorBrush x:Key="AccentColorBrush" Color="{DynamicResource AccentBlue}"/>
    <Color x:Key="AccentColor">#3b82f6</Color>

    <!-- Icon geometry is supplied by the shared Tabler outline dictionary. -->
</ResourceDictionary>
