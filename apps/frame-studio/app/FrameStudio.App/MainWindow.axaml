<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FrameStudio.App.MainWindow"
        Title="Frame Studio"
        Width="1280" Height="800" MinWidth="1120" MinHeight="680"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ExtendClientAreaToDecorationsHint="False">
  <Grid RowDefinitions="56,*,28">
    <Border Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="22,0">
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Frame Studio" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Alur kerja template PSD" Classes="muted" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Demo frame · sintetis" Classes="ToolBtn small" Click="OnOpenFrameToolPrototype" ToolTip.Tip="Demo terpisah dengan aset sintetis; bukan editor PSD." />
          <TextBlock Text="01 Master" FontSize="11" FontWeight="SemiBold" />
          <TextBlock Text="/" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
          <TextBlock Text="02 Foto" Classes="muted" />
          <TextBlock Text="/" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
          <TextBlock Text="03 Ekspor" Classes="muted" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="236,*,276" Margin="16,12,16,10" ColumnSpacing="12" IsEnabled="{Binding !IsExporting}">
      <Border Grid.Column="0" Classes="panel">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="13">
            <StackPanel Spacing="3">
              <TextBlock Text="Bahan kerja" Classes="h2" />
              <TextBlock Text="Pilih master dan foto sumber." Classes="muted" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="PSD master" Classes="sectionTitle" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Text="{Binding MasterPathDisplayText}" PlaceholderText="Belum ada master" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Pilih" Classes="ToolBtn small" Click="OnChooseMaster" />
              </Grid>
              <TextBlock Text="{Binding TemplateStatus}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>

            <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" />

            <StackPanel Spacing="7">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBlock Text="Foto sumber" Classes="sectionTitle" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Tambah" Classes="ToolBtn small" Click="OnChoosePhotos" IsEnabled="{Binding CanManageSourcePhotos}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Text="{Binding SourcePath}" PlaceholderText="Folder foto" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Pilih folder" Classes="ToolBtn small" Click="OnChooseSourceFolder" IsEnabled="{Binding CanManageSourcePhotos}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding SourcePhotos.Count, StringFormat='{}{0} foto dalam antrean'}" Classes="muted" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Bersihkan" Classes="ToolBtn small" Click="OnClearQueue" IsEnabled="{Binding CanManageSourcePhotos}" />
              </Grid>
              <ListBox x:Name="PhotoQueue" ItemsSource="{Binding SourcePhotos}" SelectionChanged="OnQueueSelectionChanged" IsEnabled="{Binding CanManageSourcePhotos}" Height="190" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="queueItem">
                      <Grid ColumnDefinitions="38,*" ColumnSpacing="8" MinHeight="40">
                        <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource CanvasBackgroundBrush}" ClipToBounds="True" VerticalAlignment="Center">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Foto dapat ditarik ke pratinjau." Classes="muted" IsVisible="{Binding IsImageSlotSelected}" />
              <Button Content="Pasangkan ke slot terpilih" Classes="ToolBtn" Click="OnAssignPhoto" IsEnabled="{Binding CanAssignSelectedPhoto}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="10" MinWidth="400">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
          <TextBlock Text="Kanvas" Classes="h2" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{Binding ManualFrameToolLabel}" Classes="ToolBtn small" Click="OnToggleManualFrameTool" IsEnabled="{Binding CanUseManualFrameTool}" IsVisible="{Binding HasTemplatePreview}" />
          <TextBlock Grid.Column="2" Text="{Binding ManualFrameToolHelp}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasTemplatePreview}" />
          <TextBlock Grid.Column="3" Text="{Binding DocumentDimensions}" Classes="muted" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource CanvasBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}" ClipToBounds="True" Padding="14">
          <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1300" MaxHeight="720">
            <Canvas x:Name="TemplateArtboard" Width="1200" Height="800" Background="{DynamicResource CanvasBackgroundBrush}">
              <Image x:Name="TemplateCompositeImage" Width="1200" Height="800" Stretch="Uniform" IsVisible="{Binding HasTemplatePreview}" />
            </Canvas>
          </Viewbox>
        </Border>
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" IsVisible="{Binding IsImageSlotSelected}" IsEnabled="{Binding CanAdjustSelectedSlot}">
              <TextBlock Text="Zoom" Classes="muted" VerticalAlignment="Center" />
              <Slider x:Name="ZoomSlider" Minimum="0.5" Maximum="3" Value="{Binding Zoom, Mode=TwoWay}" Width="105" />
              <TextBlock Text="{Binding ZoomLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding RotationLabel}" Classes="muted" VerticalAlignment="Center" />
              <Button Content="−5°" Classes="ToolBtn small" Click="OnRotateLeft" />
              <Button Content="+5°" Classes="ToolBtn small" Click="OnRotateRight" />
              <Button Content="Reset" Classes="ToolBtn small" Click="OnResetCrop" />
            </StackPanel>
            <TextBlock Text="Edit teks di inspector." Classes="muted" VerticalAlignment="Center" IsVisible="{Binding HasTextCandidateSelected}" />
            <Button Grid.Column="1" Content="Ekspor PNG" Classes="ActionBtn" IsEnabled="{Binding CanExportPngCopies}" Click="OnExportPngCopies" ToolTip.Tip="{Binding ExportNotice}" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <TextBlock Text="Folder hasil" Classes="muted" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding OutputPath}" PlaceholderText="Pilih folder output" IsReadOnly="True" />
            <Button Grid.Column="2" Content="Pilih" Classes="ToolBtn small" Click="OnChooseOutputFolder" />
          </Grid>
        </Grid>
      </Grid>

      <Border Grid.Column="2" Classes="panel">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <StackPanel Spacing="3">
            <TextBlock Text="Pengaturan" Classes="h2" />
            <TextBlock Text="Pilih area yang dikenali untuk melihat detailnya." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !IsFallbackPreviewMode}" />
            <TextBlock Text="Pratinjau ini hanya menampilkan isi tersimpan." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsFallbackPreviewMode}" />
            <TextBlock Text="{Binding PhotoSlotSetupNotice}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding ShowPhotoSlotSetupNotice}" />
            <TextBlock Text="{Binding WorkflowStructureNotice}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasTemplatePreview}" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <StackPanel Spacing="6" IsVisible="{Binding ShowDetectedAreaList}">
                <TextBlock Text="Area" Classes="sectionTitle" />
                <ItemsControl ItemsSource="{Binding Slots}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="slotItem" Classes.selected="{Binding IsSelected}" PointerPressed="OnSlotPointerPressed">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DisplayValue}" Classes="muted" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <TextBlock Text="{Binding EmptyInspectorText}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding ShowEmptyInspector}" />

              <StackPanel Spacing="8" IsVisible="{Binding HasSelectedSlot}">
                <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" />
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding SelectedSlot.Label}" Classes="sectionTitle" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Atur foto atau teks slot ini di sini." Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="PhotoFrame" Width="128" Height="150" HorizontalAlignment="Center" Background="{DynamicResource CanvasBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" ClipToBounds="True" DragDrop.AllowDrop="{Binding CanPlaceSelectedSlot}" DragDrop.DragOver="OnCanvasDragOver" DragDrop.Drop="OnCanvasDrop" PointerPressed="OnPreviewPointerPressed" PointerMoved="OnPreviewPointerMoved" PointerReleased="OnPreviewPointerReleased" IsEnabled="{Binding CanPlaceSelectedSlot}" IsVisible="{Binding IsImageSlotSelected}">
                  <Grid>
                    <Image x:Name="PreviewImage" Source="{Binding SelectedPhoto.Image}" Stretch="UniformToFill" IsVisible="{Binding HasPreviewImage}" />
                    <StackPanel IsVisible="{Binding !HasSelectedPhoto}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5" Margin="10">
                      <TextBlock Text="Pilih foto" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Text="atau tarik foto ke frame" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="Pratinjau tidak tersedia" IsVisible="{Binding HasPreviewUnavailable}" FontSize="11" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8" />
                  </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" IsEnabled="{Binding CanPlaceSelectedSlot}" IsVisible="{Binding IsImageSlotSelected}">
                  <Button Content="Isi frame" Classes="ToolBtn small" Click="OnFillFrame" />
                  <Button Content="Muat penuh" Classes="ToolBtn small" Click="OnFitFrame" />
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding HasTextCandidateSelected}">
                  <TextBox Text="{Binding SelectedSlot.Value, Mode=TwoWay}" PlaceholderText="Isi nama atau alamat" IsEnabled="{Binding CanEditPhotoTextLogo}" TextChanged="OnPreviewTextChanged" />
                  <TextBlock Text="Teks ditambahkan sebagai overlay PNG; teks asli pada komposit mungkin tetap terlihat." Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding IsFallbackPreviewMode}">
                <StackPanel Spacing="3">
                  <TextBlock Text="Pratinjau tersimpan · hanya-baca" Classes="sectionTitle" />
                  <TextBlock Text="Layer PSD tetap hanya-baca. Frame manual dan foto hanya menjadi overlay pada PNG copy." Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Expander Header="Detail lanjutan · struktur layer" IsExpanded="False">
                  <StackPanel Spacing="7" Margin="0,8,0,0">
                    <TextBlock Text="{Binding LayerTreeSummaryText}" Classes="muted" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding LayerTreeRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="queueItem">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                              <TextBlock Text="{Binding Kind}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top" />
                              <StackPanel Grid.Column="1" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <TextBlock Text="{Binding StructurePath}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" FontFamily="monospace" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding IndentPrefix}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" FontFamily="monospace" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding Details}" FontSize="10" Classes="muted" TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Status}" ToolTip.Tip="{Binding Status}" FontSize="11" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding EngineNotice}" ToolTip.Tip="{Binding EngineDetails}" FontSize="10" Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</Window>
