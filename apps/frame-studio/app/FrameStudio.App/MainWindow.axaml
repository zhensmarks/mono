<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FrameStudio.App.MainWindow"
        Title="Frame Studio"
        Width="1480" Height="920" MinWidth="1040" MinHeight="680"
        Background="#111419"
        ExtendClientAreaToDecorationsHint="False">
  <Grid RowDefinitions="70,*,30">
    <Border Grid.Row="0" Background="#171B22" BorderBrush="#2A3039" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,0">
        <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
          <Border Width="36" Height="36" CornerRadius="10" Background="#D7F06B" VerticalAlignment="Center">
            <TextBlock Text="F" Foreground="#15180E" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="FRAME STUDIO" FontSize="15" FontWeight="Bold" LetterSpacing="1.2" />
            <TextBlock Text="Photo template workspace" FontSize="11" Foreground="#8D96A4" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border Background="#242A31" CornerRadius="10" Padding="12,7"><TextBlock Text="1  Template" FontSize="12" Foreground="#DDE2E8" /></Border>
          <TextBlock Text="›" Foreground="#697381" FontSize="16" VerticalAlignment="Center" />
          <Border Background="#242A31" CornerRadius="10" Padding="12,7"><TextBlock Text="2  Foto &amp; data" FontSize="12" Foreground="#DDE2E8" /></Border>
          <TextBlock Text="›" Foreground="#697381" FontSize="16" VerticalAlignment="Center" />
          <Border Background="#242A31" CornerRadius="10" Padding="12,7"><TextBlock Text="3  Tinjau" FontSize="12" Foreground="#DDE2E8" /></Border>
        </StackPanel>
        <Button Grid.Column="2" Classes="secondary" Content="Buka PSD master" Click="OnChooseMaster" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="280,*,300" Margin="18,16,18,14" ColumnSpacing="14">
      <!-- Files and source queue -->
      <Border Grid.Column="0" Background="#191E25" BorderBrush="#2A3039" BorderThickness="1" CornerRadius="14" Padding="15">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10">
          <StackPanel Spacing="3">
            <TextBlock Text="FILE &amp; ANTREAN" FontSize="10" FontWeight="Bold" LetterSpacing="1.5" Foreground="#9AA4B2" />
            <TextBlock Text="Siapkan bahan" FontSize="19" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="PSD master" FontSize="12" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding MasterPath}" Watermark="Pilih file PSD" IsReadOnly="True" MinHeight="36" />
              <Button Grid.Column="1" Classes="secondary" Content="Pilih" Click="OnChooseMaster" />
            </Grid>
            <TextBlock Text="{Binding TemplateStatus}" FontSize="10" Foreground="#AAB2BD" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="Folder foto / source" FontSize="12" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding SourcePath}" Watermark="Pilih folder atau foto" IsReadOnly="True" MinHeight="36" />
              <Button Grid.Column="1" Classes="secondary" Content="Pilih" Click="OnChooseSourceFolder" />
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="3" Spacing="6">
            <TextBlock Text="Folder hasil" FontSize="12" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding OutputPath}" Watermark="Pilih folder hasil" IsReadOnly="True" MinHeight="36" />
              <Button Grid.Column="1" Classes="secondary" Content="Pilih" Click="OnChooseOutputFolder" />
            </Grid>
          </StackPanel>
          <Grid Grid.Row="4" RowDefinitions="Auto,*,Auto" RowSpacing="7">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="ANTREAN FOTO" FontSize="10" FontWeight="Bold" LetterSpacing="1.4" Foreground="#9AA4B2" />
                <TextBlock Text="{Binding SourcePhotos.Count, StringFormat='{}{0} foto'}" FontSize="12" Foreground="#C8CED7" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary" Content="Tambah foto" Click="OnChoosePhotos" VerticalAlignment="Center" />
            </Grid>
            <ListBox Grid.Row="1" x:Name="PhotoQueue" ItemsSource="{Binding SourcePhotos}" SelectionChanged="OnQueueSelectionChanged" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="9" Margin="0,2" MinHeight="58">
                    <Border Width="48" Height="48" CornerRadius="8" Background="#272E37" ClipToBounds="True" VerticalAlignment="Center">
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                      <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="Pratinjau source" FontSize="10" Foreground="#8E99A8" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="•" Foreground="#D7F06B" FontSize="18" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="2" Classes="primary" Content="Pasangkan ke kandidat terpilih" Click="OnAssignPhoto" HorizontalAlignment="Stretch" />
          </Grid>
          <Border Grid.Row="5" Background="#20262E" BorderBrush="#343C47" BorderThickness="1" CornerRadius="10" Padding="10">
            <TextBlock Text="Gunakan pemilih file untuk menambah foto. Penempatan ke slot hanya tersimpan sebagai pratinjau lokal." FontSize="10" Foreground="#B4BDC8" TextWrapping="Wrap" />
          </Border>
          <Button Grid.Row="6" Classes="secondary" Content="Bersihkan antrean" Click="OnClearQueue" HorizontalAlignment="Stretch" />
        </Grid>
      </Border>

      <!-- Actual stored composite and a separate, local photo crop preview -->
      <Grid Grid.Column="1" RowDefinitions="48,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="PSD COMPOSITE" FontSize="10" FontWeight="Bold" LetterSpacing="1.5" Foreground="#9AA4B2" />
            <TextBlock Text="{Binding DocumentDimensions}" FontSize="15" FontWeight="SemiBold" />
          </StackPanel>
          <Border Grid.Column="1" Background="#292F38" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
            <TextBlock Text="HANYA-BACA" Foreground="#D7F06B" FontSize="10" FontWeight="Bold" LetterSpacing="1.0" />
          </Border>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,205" ColumnSpacing="10">
          <Border Grid.Column="0" Background="#171B21" BorderBrush="#343C47" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="12">
            <Grid>
              <Image x:Name="TemplateCompositeImage" Stretch="Uniform" IsVisible="{Binding HasTemplatePreview}" />
              <StackPanel IsVisible="{Binding !HasTemplatePreview}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="280">
                <TextBlock Text="Tidak ada composite untuk ditampilkan" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="{Binding TemplatePreviewNotice}" FontSize="11" Foreground="#AAB2BD" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="1" Background="#191E25" BorderBrush="#2A3039" BorderThickness="1" CornerRadius="14" Padding="11">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <StackPanel Spacing="3">
                <TextBlock Text="FOTO TERPILIH" FontSize="10" FontWeight="Bold" LetterSpacing="1.1" Foreground="#9AA4B2" />
                <TextBlock Text="Crop 2:3 · lokal saja" FontSize="12" FontWeight="SemiBold" />
              </StackPanel>
              <Border Grid.Row="1" x:Name="PhotoFrame" Width="126" Height="189" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#14181E" BorderBrush="#525E6D" BorderThickness="1" CornerRadius="8" ClipToBounds="True" DragDrop.AllowDrop="True" DragDrop.DragOver="OnCanvasDragOver" DragDrop.Drop="OnCanvasDrop" PointerPressed="OnPreviewPointerPressed" PointerMoved="OnPreviewPointerMoved" PointerReleased="OnPreviewPointerReleased">
                <Grid>
                  <Image x:Name="PreviewImage" Source="{Binding SelectedPhoto.Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasPreviewImage}" />
                  <StackPanel IsVisible="{Binding !HasSelectedPhoto}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7" Margin="8">
                    <TextBlock Text="Pilih foto" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="atau gunakan pemilih file" FontSize="10" Foreground="#9BA5B2" HorizontalAlignment="Center" TextAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="Pratinjau tidak tersedia" IsVisible="{Binding HasPreviewUnavailable}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <TextBlock Grid.Row="2" Text="Crop, zoom, rotasi, dan posisi tidak masuk ke composite atau file PSD." FontSize="9" Foreground="#AAB2BD" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Zoom" FontSize="10" Foreground="#AAB2BD" VerticalAlignment="Center" />
            <Slider x:Name="ZoomSlider" Minimum="0.5" Maximum="2" Value="{Binding Zoom, Mode=TwoWay}" Width="105" />
            <Button Classes="secondary" Content="−5°" Click="OnRotateLeft" />
            <Button Classes="secondary" Content="+5°" Click="OnRotateRight" />
            <Button Classes="secondary" Content="Reset" Click="OnResetCrop" />
          </StackPanel>
          <Button Grid.Column="1" Classes="primary" Content="Export flattened preview PNG" IsEnabled="{Binding CanExportFlattenedPreview}" Click="OnExportFlattenedPreview" ToolTip.Tip="Exports the stored PSD composite only; slot assignments are not applied." />
        </Grid>
      </Grid>

      <!-- Name-inferred candidates and preview-only edits -->
      <Border Grid.Column="2" Background="#191E25" BorderBrush="#2A3039" BorderThickness="1" CornerRadius="14" Padding="14">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
          <StackPanel Spacing="3">
            <TextBlock Text="LAYER CANDIDATES" FontSize="10" FontWeight="Bold" LetterSpacing="1.4" Foreground="#9AA4B2" />
            <TextBlock Text="{Binding TemplateStatus}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Row="1" Background="#242A32" CornerRadius="8" Padding="9,7">
            <TextBlock Text="Jenis kandidat hanya ditebak dari nama layer; bukan bukti mask atau layer yang dapat diedit." FontSize="10" Foreground="#D7F06B" TextWrapping="Wrap" />
          </Border>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Slots}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}}" BorderBrush="#363E49" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,3" PointerPressed="OnSlotPointerPressed">
                    <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8">
                      <Border Width="30" Height="30" CornerRadius="8" Background="#2B323C" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Kind}" FontSize="8" FontWeight="Bold" Foreground="#D7F06B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DisplayValue}" FontSize="10" Foreground="#A1ABB8" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="KANDIDAT" FontSize="7" Foreground="#AAB2BD" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border Grid.Row="3" Background="#20262E" BorderBrush="#343C47" BorderThickness="1" CornerRadius="10" Padding="10">
            <StackPanel Spacing="6">
              <TextBlock Text="Nilai teks pratinjau" FontSize="12" FontWeight="SemiBold" />
              <TextBox Text="{Binding SelectedSlot.Value, Mode=TwoWay}" Watermark="Hanya untuk catatan pratinjau" IsEnabled="{Binding HasTextCandidateSelected}" TextChanged="OnPreviewTextChanged" />
              <TextBlock Text="Teks dan pemetaan foto/logo bersifat lokal; tidak disimpan ke PSD." FontSize="9" Foreground="#AAB2BD" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Grid.Row="4" Background="#2B241D" BorderBrush="#5B4930" BorderThickness="1" CornerRadius="10" Padding="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Ekspor terbatas" FontSize="11" FontWeight="SemiBold" Foreground="#F1D39C" />
              <TextBlock Text="Hanya PNG dari composite tersimpan. Tidak ada PSD berlapis atau salinan per siswa." FontSize="10" Foreground="#D1C0A6" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#171B22" BorderBrush="#2A3039" BorderThickness="0,1,0,0" Padding="18,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Ellipse Width="7" Height="7" Fill="#D7F06B" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="10" Foreground="#B5BEC9" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding EngineNotice}" FontSize="9" Foreground="#8D96A4" VerticalAlignment="Center" Margin="10,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
