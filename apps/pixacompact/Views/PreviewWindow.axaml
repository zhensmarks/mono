                                                    </Button>

                            <Border Height="1" Background="{StaticResource EditorBorder}" Margin="4,6"/>
                                                    <Button x:Name="BtnQuickMask" Classes="editor-tool quick-mask" Click="OnQuickMaskClick" Width="36" Height="36" ToolTip.Tip="{DynamicResource Tip_QuickMask}">
                                                        <PathIcon Data="M20.6,12L20.5,13.5L20.1,14.9L19.4,16.3L18.6,17.5L17.5,18.6L16.3,19.4L14.9,20.1L13.5,20.5L12,20.6L10.5,20.5L9.1,20.1L7.7,19.4L6.5,18.6L5.4,17.5L4.6,16.3L3.9,14.9L3.5,13.5L3.4,12L3.5,10.5L3.9,9.1L4.6,7.7L5.4,6.5L6.5,5.4L7.7,4.6L9.1,3.9L10.5,3.5L12,3.4L13.5,3.5L14.9,3.9L16.3,4.6L17.5,5.4L18.6,6.5L19.4,7.7L20.1,9.1L20.5,10.5L20.6,12ZM18.9,12L18.8,13.3L18.4,14.6L17.7,15.8L16.9,16.9L15.8,17.7L14.6,18.4L13.3,18.8L12,18.9L10.7,18.8L9.4,18.4L8.2,17.7L7.1,16.9L6.3,15.8L5.6,14.6L5.2,13.3L5.1,12L5.2,10.7L5.6,9.4L6.3,8.2L7.1,7.1L8.2,6.3L9.4,5.6L10.7,5.2L12,5.1L13.3,5.2L14.6,5.6L15.8,6.3L16.9,7.1L17.7,8.2L18.4,9.4L18.8,10.7L18.9,12ZM12.4,8.2L14.7,5.9L13.9,5.1L11.6,7.4ZM12.4,10.6L16.2,6.8L15.4,6L11.6,9.8ZM12.4,13L17.5,7.9L16.7,7.1L11.6,12.2ZM12.4,15.4L18.5,9.3L17.7,8.5L11.6,14.6ZM12.4,17.8L19.1,11.1L18.3,10.3L11.6,17ZM13.4,19.2L19.2,13.4L18.4,12.6L12.6,18.4Z" Width="16" Height="16" Foreground="White"/>
                                                    </Button>
                                                    <Button x:Name="BtnMaskView" Classes="editor-tool" Click="OnMaskViewClick" Width="36" Height="36" ToolTip.Tip="{DynamicResource Tip_MaskView}">
                                                        <PathIcon Data="M20.6,12L20.5,13.5L20.1,14.9L19.4,16.3L18.6,17.5L17.5,18.6L16.3,19.4L14.9,20.1L13.5,20.5L12,20.6L10.5,20.5L9.1,20.1L7.7,19.4L6.5,18.6L5.4,17.5L4.6,16.3L3.9,14.9L3.5,13.5L3.4,12L3.5,10.5L3.9,9.1L4.6,7.7L5.4,6.5L6.5,5.4L7.7,4.6L9.1,3.9L10.5,3.5L12,3.4L13.5,3.5L14.9,3.9L16.3,4.6L17.5,5.4L18.6,6.5L19.4,7.7L20.1,9.1L20.5,10.5L20.6,12ZM18.9,12L18.8,13.3L18.4,14.6L17.7,15.8L16.9,16.9L15.8,17.7L14.6,18.4L13.3,18.8L12,18.9L10.7,18.8L9.4,18.4L8.2,17.7L7.1,16.9L6.3,15.8L5.6,14.6L5.2,13.3L5.1,12L5.2,10.7L5.6,9.4L6.3,8.2L7.1,7.1L8.2,6.3L9.4,5.6L10.7,5.2L12,5.1L13.3,5.2L14.6,5.6L15.8,6.3L16.9,7.1L17.7,8.2L18.4,9.4L18.8,10.7L18.9,12ZM12,5.1L12,18.9L11.3,18.9L10.6,18.7L9.9,18.6L9.2,18.3L8.6,18L7.9,17.6L7.4,17.1L6.9,16.6L6.4,16.1L6,15.4L5.7,14.8L5.4,14.1L5.3,13.4L5.1,12.7L5.1,12L5.1,11.3L5.3,10.6L5.4,9.9L5.7,9.2L6,8.5L6.4,7.9L6.9,7.4L7.4,6.9L7.9,6.4L8.5,6L9.2,5.7L9.9,5.4L10.6,5.3L11.3,5.1L12,5.1L12,18.9Z" Width="16" Height="16" Foreground="White"/>
                                                    </Button>
                                                    <Button x:Name="BtnRefineHair" Classes="editor-tool" Click="OnRefineHairClick" Width="36" Height="36" ToolTip.Tip="Refine Hair (AI)">
                                                        <PathIcon Data="M16.3,9.4L16.2,10.4L15.8,11.4L15.2,12.3L14.4,12.9L13.5,13.4L12.5,13.7L11.5,13.7L10.5,13.4L9.6,12.9L8.8,12.3L8.2,11.4L7.8,10.4L7.7,9.4L7.8,8.4L8.2,7.4L8.8,6.5L9.6,5.9L10.5,5.4L11.5,5.1L12.5,5.1L13.5,5.4L14.4,5.9L15.2,6.5L15.8,7.4L16.2,8.4L16.3,9.4ZM8,8.6L6,7.2L8.4,7.4ZM8.5,7.3L7.1,5.3L9.3,6.3ZM9.4,6.2L8.8,3.9L10.5,5.6ZM10.7,5.5L10.9,3.1L11.9,5.3ZM12.1,5.3L13.1,3.1L13.3,5.5ZM13.5,5.6L15.2,3.9L14.6,6.2ZM14.7,6.3L16.9,5.3L15.5,7.3ZM15.6,7.4L18,7.2L16,8.6ZM4.5,21.5L6,17.6L9,16L9.2,14.6L14.8,14.6L15,16L18,17.6L19.5,21.5Z" Width="16" Height="16" Foreground="White"/>
                                                    </Button>
                            <!-- Grup view: overlay & AI -->
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="0" Grid.Column="1">
                    <!-- STATE 1: Normal Preview (Side-by-Side) -->
                    <Grid x:Name="PanelNormalPreview" ColumnDefinitions="*, 2, *" Margin="10,0,10,10">
                        <!-- Original -->
                        <Grid x:Name="PanelOriginalColumn" Grid.Column="0" RowDefinitions="*, Auto">
                            <Border x:Name="BrdOriginal" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Background="#0DFFFFFF" CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <Image Name="ImgOriginal" Stretch="Uniform" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           PointerPressed="OnImagePointerPressed" PointerMoved="OnImagePointerMoved"
                                           PointerReleased="OnImagePointerReleased" PointerWheelChanged="OnImagePointerWheelChanged">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                <TranslateTransform X="0" Y="0" />
                                                <RotateTransform Angle="{Binding $parent[views:PreviewWindow].RotationOriginal}" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                    <!-- Rotate Button Overlay -->
                                    <Button Click="OnRotateOriginalClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                            Background="#80000000" CornerRadius="6" Padding="6" BorderThickness="0" ToolTip.Tip="{DynamicResource Tip_RotateOriginal}" IsVisible="False">
                                        <PathIcon Data="M12,4C14.2,4 16.2,4.8 17.6,6.3C20.7,9.4 20.7,14.5 17.6,17.6C15.8,19.5 13.3,20.2 11,19.9V21.9C13.9,22.2 16.9,21.2 19.1,19C23,15.1 23,8.9 19,5C17.1,3.1 14.5,2.1 12,2V0L7,4L12,8V4Z"
                                                 Width="14" Height="14" Foreground="White">
                                            <PathIcon.RenderTransform>
                                                <RotateTransform Angle="90"/>
                                            </PathIcon.RenderTransform>
                                        </PathIcon>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Label_Original}" HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>

                        <!-- Separator -->
                        <GridSplitter x:Name="SplitterPreview" Grid.Column="1" Width="2" Background="#40808080" ResizeBehavior="PreviousAndNext"/>

                        <!-- Result -->
                        <Grid Grid.Column="2" RowDefinitions="*, Auto">
                            <Border x:Name="BrdResult" BorderBrush="#60FFFFFF" BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                                    Background="#252525"
                                    BoxShadow="0 4 24 0 #88000000, 0 1 4 0 #44000000">
                                <Grid>
                                    <Image Name="ImgResult" Stretch="Uniform" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" Focusable="True"
                                           PointerPressed="OnImagePointerPressed" PointerMoved="OnImagePointerMoved"
                                           PointerReleased="OnImagePointerReleased" PointerWheelChanged="OnImagePointerWheelChanged">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                <TranslateTransform X="0" Y="0" />
                                                <RotateTransform Angle="{Binding $parent[views:PreviewWindow].RotationResult}" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                    <!-- Overlay quick mask: area seleksi ditandai merah -->
                                    <Image x:Name="ImgQuickMask" Stretch="Uniform" Margin="5"
                                           IsVisible="False" IsHitTestVisible="False"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                <TranslateTransform X="0" Y="0" />
                                                <RotateTransform Angle="{Binding $parent[views:PreviewWindow].RotationResult}" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                    <!-- Overlay "Bandingkan": Original semi-transparan di atas kanvas editor -->
                                    <Image x:Name="ImgOriginalCompare" Stretch="Uniform" Margin="5"
                                           IsVisible="False" IsHitTestVisible="False" Opacity="0.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                <TranslateTransform X="0" Y="0" />
                                                <RotateTransform Angle="{Binding $parent[views:PreviewWindow].RotationResult}" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                    <!-- Overlay editor: marquee, anchor pen, brush cursor, marching ants -->
                                    <Canvas x:Name="EditOverlay" IsVisible="False" IsHitTestVisible="False"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"
                                            Width="{Binding #ImgResult.Bounds.Width}" Height="{Binding #ImgResult.Bounds.Height}"
                                            ClipToBounds="False" ZIndex="100"/>
                                    <Path x:Name="SelectionAntsShadow" IsHitTestVisible="False" ZIndex="101"
                                          Stroke="#DD111111" StrokeThickness="3" StrokeDashArray="4,4" Fill="Transparent"/>
                                    <Path x:Name="SelectionAnts" IsHitTestVisible="False" ZIndex="102"
                                          Stroke="White" StrokeThickness="1" StrokeDashArray="4,4" Fill="Transparent"/>


                                    <!-- Spinner Refine Hair -->
                                    <Border x:Name="PanelRefineBusy" IsVisible="False" Background="#B0000000" CornerRadius="3">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                            <Grid Classes="spinning" Width="28" Height="28" HorizontalAlignment="Center">
                                                <PathIcon Data="M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z" Width="28" Height="28" Foreground="{DynamicResource AccentBlueBrush}"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtRefineBusy" Text="{DynamicResource Refine_Processing}" FontSize="12" Foreground="{StaticResource EditorTextPrimary}" HorizontalAlignment="Center"/>
                                            <Button x:Name="BtnRefineCancel" Content="{DynamicResource Btn_Cancel}" FontSize="11" Padding="12,4" CornerRadius="3"
                                                    Background="{StaticResource EditorBtnBg}" Foreground="White" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Editor status bar -->
                                    
                                    <!-- Rotate Button Overlay -->
                                    <Button Click="OnRotateResultClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                            Background="#80000000" CornerRadius="6" Padding="6" BorderThickness="0" ToolTip.Tip="{DynamicResource Tip_RotateResult}" IsVisible="False">
                                        <PathIcon Data="M12,4C14.2,4 16.2,4.8 17.6,6.3C20.7,9.4 20.7,14.5 17.6,17.6C15.8,19.5 13.3,20.2 11,19.9V21.9C13.9,22.2 16.9,21.2 19.1,19C23,15.1 23,8.9 19,5C17.1,3.1 14.5,2.1 12,2V0L7,4L12,8V4Z"
                                                 Width="14" Height="14" Foreground="White">
                                            <PathIcon.RenderTransform>
                                                <RotateTransform Angle="90"/>
                                            </PathIcon.RenderTransform>
                                        </PathIcon>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TxtResultLabel" Grid.Row="1" Text="{DynamicResource Label_Result}" HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Grid>

                    <!-- Ghost Loading Overlay -->
                    <Grid x:Name="OverlayLoading" ColumnDefinitions="*, 2, *" Margin="10,0,10,10" IsVisible="False">
                        <!-- Left Skeleton -->
                        <Border Grid.Column="0" Classes="shimmer" Background="#15FFFFFF" CornerRadius="8" ClipToBounds="True">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                                <PathIcon Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M5,19V5H19V19H5M6,17H18L14.25,12L11.25,16L9,13L6,17Z" Width="48" Height="48" Foreground="#20FFFFFF"/>
                            </StackPanel>
                        </Border>
                        <!-- Right Skeleton -->
                        <Border Grid.Column="2" Classes="shimmer" Background="#15FFFFFF" CornerRadius="8" ClipToBounds="True">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                                <PathIcon Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M5,19V5H19V19H5M6,17H18L14.25,12L11.25,16L9,13L6,17Z" Width="48" Height="48" Foreground="#20FFFFFF"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                <Border x:Name="PanelRightEditor" Grid.Row="0" Grid.Column="2" IsVisible="False" Width="240"
                        Background="{StaticResource EditorSurface}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="1,0,0,0" Padding="0" Margin="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DockRightPanel" Spacing="0">

                            <Border x:Name="PanelProperties" Width="240" Background="{StaticResource EditorSurface}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,0,0,1">
                                <StackPanel Spacing="0">
                                    <Border Background="{StaticResource EditorSurface}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,0,0,1" Padding="12,8">
                                        <TextBlock Text="{DynamicResource Panel_Properties}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EditorTextSecondary}" VerticalAlignment="Center"/>
                                    </Border>

                            <!-- SELECTION SECTION -->
                            <Border Background="{StaticResource EditorSurface}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,0,0,1" Padding="8,8">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource Panel_Selection}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EditorTextSecondary}" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnToggleEditorPanel" Classes="editor-compact" Grid.Column="1" Content="{DynamicResource Btn_Panel}" Click="OnToggleEditorPanel" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtSelStatus" Text="{DynamicResource SelStatus_None}" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource EditorTextSecondary}"/>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2" Margin="0,1">
                                        <Button x:Name="BtnSelAllPanel" Classes="editor-compact" ToolTip.Tip="{DynamicResource Tip_SelectAll}" Grid.Column="0" Content="{DynamicResource Btn_All}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                        <Button x:Name="BtnSelNonePanel" Classes="editor-compact" ToolTip.Tip="{DynamicResource Tip_Deselect}" Grid.Column="1" Content="{DynamicResource Btn_None}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                        <Button x:Name="BtnSelInvertPanel" Classes="editor-compact" ToolTip.Tip="{DynamicResource Tip_InvertSel}" Grid.Column="2" Content="{DynamicResource Btn_Invert}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,4">
                                        <TextBlock Text="{DynamicResource Opt_Pixels}" FontSize="10" Foreground="{StaticResource EditorTextDisabled}" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldSelGrowPxPanel" Grid.Column="1" Margin="8,0" Minimum="1" Maximum="200" Value="4" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtSelGrowPxPanel" Grid.Column="2" Text="4" FontSize="10" Width="24" Foreground="{StaticResource EditorTextPrimary}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2" Margin="0,1">
                                        <Button x:Name="BtnSelGrowPanel" Classes="editor-compact" ToolTip.Tip="{DynamicResource Tip_GrowSel}" Grid.Column="0" Content="{DynamicResource Btn_Grow}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                        <Button x:Name="BtnSelShrinkPanel" Classes="editor-compact" ToolTip.Tip="{DynamicResource Tip_ShrinkSel}" Grid.Column="1" Content="{DynamicResource Btn_Shrink}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                        <Button x:Name="BtnSelFeatherPanel" Classes="editor-compact" Grid.Column="2" Content="{DynamicResource Btn_Feather}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="2" Margin="0,1">
                                        <Button x:Name="BtnSelSavePanel" Classes="editor-compact" Grid.Column="0" Content="{DynamicResource Btn_SaveSel}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                        <Button x:Name="BtnSelLoadPanel" Classes="editor-compact" Grid.Column="1" Content="{DynamicResource Btn_LoadSel}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- MASK SECTION -->
                            <Border Background="{StaticResource EditorSurface}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,0,0,1" Padding="8,8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource Panel_Mask}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EditorTextSecondary}" VerticalAlignment="Center"/>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2" Margin="0,1">
                                        <Button x:Name="BtnApplyErasePanel" Classes="editor-compact" Grid.Column="0" Content="{DynamicResource Btn_Erase}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                        <Button x:Name="BtnApplyRestorePanel" Classes="editor-compact" Grid.Column="1" Content="{DynamicResource Btn_Restore}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                        <Button x:Name="BtnApplyFillPanel" Classes="editor-compact" Grid.Column="2" Content="{DynamicResource Btn_Fill}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2" Margin="0,1">
                                        <Button x:Name="BtnMaskExpandPanel" Classes="editor-compact" Grid.Column="0" Content="{DynamicResource Btn_Expand}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                        <Button x:Name="BtnMaskContractPanel" Classes="editor-compact" Grid.Column="1" Content="{DynamicResource Btn_Contract}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                        <Button x:Name="BtnMaskFeatherPanel" Classes="editor-compact" Grid.Column="2" Content="{DynamicResource Btn_Feather}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}"/>
                                    </Grid>
                                    <Button x:Name="BtnMaskDefringePanel" Classes="editor-compact" Content="{DynamicResource Btn_Defringe}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                                </StackPanel>
                            </Border>

                            <!-- HISTORY SECTION -->
                            <Border x:Name="PanelHistory" Width="240" Background="{StaticResource EditorSurface}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,0,0,1" Padding="12,10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource Panel_History}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EditorTextSecondary}" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource EditorBg}" CornerRadius="3" Padding="4" MaxHeight="200">
                                        <ListBox x:Name="LstHistory" Background="Transparent" BorderThickness="0" FontSize="10" Foreground="{StaticResource EditorTextSecondary}" ScrollViewer.VerticalScrollBarVisibility="Auto" AutoScrollToSelectedItem="False"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- LAYERS SECTION -->
                            <Border x:Name="PanelDocLayers" Width="240" Background="{StaticResource EditorSurface}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0" Padding="12,10" IsVisible="True">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource Panel_Layers}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EditorTextSecondary}" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource EditorBg}" CornerRadius="3" Padding="4" MaxHeight="220">
                                        <ItemsControl x:Name="LayerList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="views:LayerViewModel">
                                                    <Border Padding="4" Margin="0,1" CornerRadius="4" Background="#15FFFFFF">
                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                            <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="32" Height="32" Margin="0,0,6,0"/>
                                                            <CheckBox Grid.Column="1" IsChecked="{Binding Visible}" Width="20" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11" Foreground="{StaticResource EditorTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Opacity, StringFormat='{}{0:0}%'}" FontSize="9" Foreground="{StaticResource EditorTextDisabled}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <Grid ColumnDefinitions="*,*,*,*">
                                        <Button x:Name="BtnLayerAdd" Classes="editor-compact" Grid.Column="0" Content="+" FontSize="11" Foreground="{StaticResource EditorTextPrimary}" Margin="0,0,2,0"/>
                                        <Button x:Name="BtnLayerDelete" Classes="editor-compact" Grid.Column="1" Content="−" FontSize="11" Foreground="{StaticResource EditorTextPrimary}" Margin="2,0"/>
                                        <Button x:Name="BtnLayerDup" Classes="editor-compact" Grid.Column="2" Content="Dup" FontSize="11" Foreground="{StaticResource EditorTextPrimary}" Margin="2,0"/>
                                        <Button x:Name="BtnLayerMerge" Classes="editor-compact" Grid.Column="3" Content="Merge" FontSize="11" Foreground="{StaticResource EditorTextPrimary}" Margin="2,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border x:Name="PanelEditorStatus" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" IsVisible="False"
                        Height="{StaticResource EditorStatusBarHeight}"
                        Background="{StaticResource EditorSurface}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,1,0,0"
                        Padding="12,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                        <TextBlock x:Name="TxtEditorTool" Grid.Column="0" Text="{DynamicResource Tool_Pan}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource EditorTextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Grid.Column="1" Width="1" Background="{StaticResource EditorBorder}" Margin="0,8"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock x:Name="TxtZoom" Text="100%" FontSize="11" Foreground="{StaticResource EditorTextSecondary}" Width="52"/>
                            <TextBlock x:Name="TxtEditorImageSize" Text="-" FontSize="11" Foreground="{StaticResource EditorTextSecondary}"/>
                            <TextBlock x:Name="TxtSelInfo" Text="{DynamicResource Status_SelNone}" FontSize="11" Foreground="{StaticResource EditorTextSecondary}"/>
                            <TextBlock x:Name="TxtEditorUndo" Text="" FontSize="11" Foreground="{StaticResource EditorTextSecondary}"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtEditorHint" Grid.Column="4" Text="{DynamicResource Hint_Default}"
                                   FontSize="11" Foreground="{StaticResource EditorTextSecondary}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="700"/>
                    </Grid>
                </Border>
            </Grid>
<Border Grid.Row="4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Background="#0AFFFFFF" Padding="15,10" MinHeight="55">
                 <Grid>
                     <!-- Center: Navigation Buttons & Photoshop & Toast -->
                     <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                          <!-- Navigation and Actions -->
                          <StackPanel x:Name="PanelNavigation" Orientation="Horizontal" Spacing="20" IsVisible="True">
                              <Button Click="OnPreviousClick" Width="36" Height="36" CornerRadius="8" Background="#15FFFFFF" BorderThickness="1" BorderBrush="#30FFFFFF" ToolTip.Tip="{DynamicResource Tip_Prev}">
                                  <PathIcon Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                              </Button>

                              <ToggleButton x:Name="BtnCompareBottom" Content="{DynamicResource Btn_Compare}" FontSize="11" Padding="12,8" CornerRadius="8" Background="#15FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="{DynamicResource Tip_Compare}" VerticalAlignment="Center"/>

                              <Button x:Name="BtnFooterMode" IsVisible="True" Click="OnFooterModeClick" Padding="20,8" Background="#206366F1" BorderBrush="#806366F1" BorderThickness="1" CornerRadius="8" ToolTip.Tip="{DynamicResource Tip_OpenPhotoshop}">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                      <PathIcon x:Name="IconFooterMode" Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V5H19V19M11,14.5V11.5H13C14.1,11.5 15,12.4 15,13.5C15,14.6 14.1,15.5 13,15.5H11M11,10H13C14.93,10 16.5,11.57 16.5,13.5C16.5,15.43 14.93,17 13,17H9.5V7H11V10Z" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                                      <TextBlock x:Name="TxtFooterMode" Text="{DynamicResource Footer_OpenEditor}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                  </StackPanel>
                              </Button>

                              <Button Click="OnNextClick" Width="36" Height="36" CornerRadius="8" Background="#15FFFFFF" BorderThickness="1" BorderBrush="#30FFFFFF" ToolTip.Tip="{DynamicResource Tip_Next}">
                                  <PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                              </Button>
                          </StackPanel>

                          <!-- Save Toast Notification -->
                          <Border x:Name="ToastNotification" Background="#18A05A" CornerRadius="8" Padding="15,8" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#40FFFFFF" BorderThickness="1">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                  <PathIcon x:Name="ToastIcon" Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.58L21,7Z" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                                  <TextBlock Text="{DynamicResource Toast_Saved}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                              </StackPanel>
                          </Border>
                     </Grid>
                 </Grid>
            </Border>
        </Grid>
    </Border>
</Window>