<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:PixelcutCompact.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="PixelcutCompact.Views.PreviewWindow"
        Title="Preview"
        WindowStartupLocation="CenterOwner"
        Width="1020" Height="680"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        Focusable="True"
        KeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PixelcutCompact/Resources/EditorTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="avares://PixelcutCompact/Resources/EditorStyles.axaml"/>
    </Window.Styles>

    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
            <!-- Header (Draggable) -->
            <Grid Grid.Row="0" Background="Transparent" ColumnDefinitions="*, Auto" MinHeight="45" PointerPressed="OnHeaderPointerPressed">
                  <!-- Left: Title & Icon -->
                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="15,0,0,0">
                      <Grid Width="14" Height="14" VerticalAlignment="Center">
                          <PathIcon x:Name="ImgHeaderIcon" Data="M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5M3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3H5A2,2 0 0,0 3,5M5,5H19V19H5V5Z" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                          <!-- Premium Spinner: Circular track and dynamic spinning arc with rounded caps -->
                          <Grid x:Name="ImgLoadingIcon" Classes="spinning" Width="14" Height="14" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                              <!-- Background track -->
                              <Ellipse Width="12" Height="12" Stroke="#20FFFFFF" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                              <!-- Glowing spinning indicator -->
                              <Path Data="M 11,6 A 5,5 0 1,1 6,1"
                                    Stroke="{DynamicResource AccentBlueBrush}"
                                    StrokeThickness="1.5"
                                    StrokeLineCap="Round"
                                    Width="12" Height="12"
                                    Stretch="Fill"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                          </Grid>
                      </Grid>
                      <TextBlock x:Name="TxtTitle" Text="{DynamicResource Title_Preview}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>

                  <!-- Right: Buttons -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <!-- Settings Button with Flyout -->
                      <Button VerticalAlignment="Center" Width="45" Height="45" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="{DynamicResource Tip_KeyboardShortcuts}" Click="OnPreferencesClick">
                          <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.47,2.42C14.43,2.18 14.23,2 14,2H10C9.77,2 9.57,2.18 9.53,2.42L9.13,5.07C8.52,5.32 7.96,5.65 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.53,21.58C9.57,21.82 9.77,22 10,22H14C14.23,22 14.43,21.82 14.47,21.58L14.87,18.93C15.48,18.68 16.04,18.35 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z" Width="16" Height="16"/>
                      </Button>

                      <!-- Editor Mode Header Controls -->
                      <Border x:Name="ChipEditMode" IsVisible="False" Background="{StaticResource EditorAccent}" CornerRadius="3" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="MODE EDITOR" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                      </Border>

                      <Button x:Name="BtnExitEditHeader" Classes="editor-compact" IsVisible="False" Content="{DynamicResource Btn_Done}" ToolTip.Tip="{DynamicResource Tip_ExitEditor}" VerticalAlignment="Center" Padding="12,6" Margin="0,0,8,0" Foreground="White" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>

                      <!-- Close Button -->
                      <Button Click="OnCloseClick" VerticalAlignment="Center" Content="✕" Width="45" Height="45" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                  </StackPanel>
            </Grid>

            <!-- Workspace focus and tool docking remain available while panels are rearranged. -->
            <!-- Edit-mode Menu Bar (Photoshop-style). Document actions live here, NOT in the tool rail:
                 File = document, Edit = undo/fill/make-selection, Select = selection ops, View = overlays. -->
            <Border x:Name="PanelMenuBar" Grid.Row="1" IsVisible="False" Height="{StaticResource EditorMenuBarHeight}"
                    Background="{StaticResource EditorSurface}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,0,0,1" Padding="6,2">
                <Menu x:Name="EditMenu" Classes="editor-menubar" Background="Transparent">
                    <MenuItem Header="{DynamicResource Menu_File}" Classes="editor-menuitem">
                        <MenuItem x:Name="MiSaveEdit" Header="{DynamicResource Menu_Save}" Click="OnSaveEditClick" Classes="editor-menuitem"/>
                        <MenuItem x:Name="MiSaveAsEdit" Header="{DynamicResource Menu_SaveAs}" Click="OnSaveAsEditClick" Classes="editor-menuitem"/>
                        <Separator/>
                        <MenuItem x:Name="MiRevertEdit" Header="{DynamicResource Menu_Revert}" Click="OnRevertEditClick" Classes="editor-menuitem"/>
                        <MenuItem x:Name="MiDiscardEdit" Header="{DynamicResource Menu_Discard}" Click="OnRevertEditClick" Classes="editor-menuitem"/>
                        <Separator/>
                        <MenuItem x:Name="MiExitEdit" Header="{DynamicResource Menu_ExitEdit}" Click="OnExitEditClick" Classes="editor-menuitem"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Menu_Edit}" Classes="editor-menuitem">
                        <MenuItem x:Name="MiUndo" Header="{DynamicResource Menu_Undo}" Click="OnUndoClick" Classes="editor-menuitem"/>
                        <MenuItem x:Name="MiRedo" Header="{DynamicResource Menu_Redo}" Click="OnRedoClick" Classes="editor-menuitem"/>
                        <Separator/>
                        <MenuItem x:Name="MiFillBlack" Header="{DynamicResource Menu_FillBlack}" Classes="editor-menuitem"/>
                        <MenuItem x:Name="MiFillWhite" Header="{DynamicResource Menu_FillWhite}" Classes="editor-menuitem"/>
                        <Separator/>
                        <MenuItem x:Name="MiMakeSelection" Header="{DynamicResource Menu_MakeSelection}" Classes="editor-menuitem"/>
                        <MenuItem x:Name="MiMakeSelectionAdd" Header="{DynamicResource Menu_AddToSelection}" Classes="editor-menuitem"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Menu_Select}" Classes="editor-menuitem">
                        <MenuItem x:Name="MiSelectAll" Header="{DynamicResource Menu_SelectAll}" Classes="editor-menuitem"/>
                        <MenuItem x:Name="MiDeselect" Header="{DynamicResource Menu_Deselect}" Classes="editor-menuitem"/>
                        <MenuItem x:Name="MiInvertSelection" Header="{DynamicResource Menu_Inverse}" Classes="editor-menuitem"/>
                        <Separator/>
                        <MenuItem x:Name="MiGrowSelection" Header="{DynamicResource Menu_Grow}" Classes="editor-menuitem"/>
                        <MenuItem x:Name="MiShrinkSelection" Header="{DynamicResource Menu_Shrink}" Classes="editor-menuitem"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Menu_View}" Classes="editor-menuitem">
                        <MenuItem x:Name="MiCompare" Header="{DynamicResource Menu_Compare}" ToggleType="CheckBox" Classes="editor-menuitem"/>
                        <MenuItem x:Name="MiQuickMask" Header="{DynamicResource Menu_QuickMask}" ToggleType="CheckBox" Classes="editor-menuitem"/>
                        <MenuItem x:Name="MiMaskView" Header="{DynamicResource Menu_MaskView}" ToggleType="CheckBox" Classes="editor-menuitem"/>
                    </MenuItem>
                </Menu>
            </Border>


            <!-- Parked here until the editor applies the saved dock position. -->
            

            <!-- Options Bar (Tool-specific settings) -->
            <Border x:Name="PanelOptionsBar" Grid.Row="2"
                    Background="{StaticResource EditorSurfaceAlt}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,0,0,1" Padding="12,0"
                    IsVisible="False" Height="{StaticResource EditorOptionsBarHeight}" CornerRadius="0" ClipToBounds="True">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Judul tool aktif (tipografi tetap, layout tidak lompat antar tool) -->
                    <TextBlock x:Name="TxtOptionsTitle" Grid.Column="0" Text="{DynamicResource Tool_Pan}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource EditorTextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0" Width="118" TextTrimming="CharacterEllipsis"/>
                    <!-- Toggle Bandingkan: selalu terlihat di mode edit, kanan options bar -->
                    <ToggleButton x:Name="BtnCompareOptions" Grid.Column="2" Classes="editor-compact" Content="{DynamicResource Btn_Compare}"
                                  FontSize="11" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"
                                  ToolTip.Tip="{DynamicResource Tip_CompareOptions}"/>
                    <!-- ScrollViewer mencegah grup tool menimpa toggle saat jendela sempit -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <!-- Selection Mode (Replace/Add/Subtract/Intersect): Grid 4 kolom sama lebar.
                         Paling kiri ala Photoshop agar tidak terpotong saat bar penuh. -->
                    <StackPanel x:Name="OptSelectionModeGroup" Orientation="Horizontal" Spacing="0" IsVisible="False" VerticalAlignment="Center" Grid.IsSharedSizeScope="True">
                        <Grid VerticalAlignment="Center" ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ModeBtn"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ModeBtn"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ModeBtn"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ModeBtn"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="BtnModeReplace" Grid.Column="0" Classes="editor-compact" Padding="6,4" Content="{DynamicResource SelMode_New}" IsChecked="True" FontSize="11" Foreground="White" IsCheckedChanged="OnSelectionModeClick" ToolTip.Tip="{DynamicResource Tip_SelModeNew}"/>
                            <ToggleButton x:Name="BtnModeAdd" Grid.Column="1" Classes="editor-compact" Padding="6,4" Content="{DynamicResource SelMode_Add}" FontSize="11" Foreground="White" IsCheckedChanged="OnSelectionModeClick" ToolTip.Tip="{DynamicResource Tip_SelModeAdd}"/>
                            <ToggleButton x:Name="BtnModeSubtract" Grid.Column="2" Classes="editor-compact" Padding="6,4" Content="{DynamicResource SelMode_Sub}" FontSize="11" Foreground="White" IsCheckedChanged="OnSelectionModeClick" ToolTip.Tip="{DynamicResource Tip_SelModeSub}"/>
                            <ToggleButton x:Name="BtnModeIntersect" Grid.Column="3" Classes="editor-compact" Padding="6,4" Content="{DynamicResource SelMode_Intersect}" FontSize="11" Foreground="White" IsCheckedChanged="OnSelectionModeClick" ToolTip.Tip="{DynamicResource Tip_SelModeIntersect}"/>
                        </Grid>
                        <Border Width="1" Background="{StaticResource EditorBorder}" Margin="8,0"/>
                    </StackPanel>

                    <!-- Brush Settings -->
                    <StackPanel x:Name="OptBrushGroup" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <TextBlock Text="{DynamicResource Opt_Size}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                        <Slider x:Name="SldBrushSize" VerticalAlignment="Center" Minimum="1" Maximum="2000" Value="60" Width="110" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtBrushSize" Text="60 px" VerticalAlignment="Center" Foreground="{StaticResource EditorTextPrimary}" FontSize="11" Width="45"/>
                        <TextBlock Text="{DynamicResource Opt_Softness}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                        <Slider x:Name="SldBrushHardness" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="30" Width="110" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtBrushHardness" Text="30%" VerticalAlignment="Center" Foreground="{StaticResource EditorTextPrimary}" FontSize="11" Width="30"/>
                        <Grid x:Name="BrushModeButtonGrid" ColumnDefinitions="*,*" ColumnSpacing="2" Width="164" VerticalAlignment="Center">
                            <Button x:Name="BtnBrushAdvanced" Grid.Column="0" Classes="editor-compact" Content="{DynamicResource Btn_Advanced}" FontSize="11" Foreground="White" ToolTip.Tip="{DynamicResource Tip_ShowOpacityFlow}"/>
                            <Button x:Name="BtnBrushRestore" Grid.Column="1" Classes="editor-compact" Content="{DynamicResource BrushMode_Erase}" Click="OnBrushModeClick" FontSize="11" Foreground="White" ToolTip.Tip="{DynamicResource Tip_BrushRestore}"/>
                        </Grid>
                        <StackPanel x:Name="OptBrushAdvancedGroup" Orientation="Horizontal" Spacing="8" IsVisible="False">
                            <TextBlock Text="{DynamicResource Opt_Opacity}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                            <Slider x:Name="SldBrushOpacity" VerticalAlignment="Center" Minimum="1" Maximum="100" Value="100" Width="100" IsSnapToTickEnabled="True" TickFrequency="1"/>
                            <TextBlock x:Name="TxtBrushOpacity" Text="100%" VerticalAlignment="Center" Foreground="{StaticResource EditorTextPrimary}" FontSize="11" Width="35"/>
                            <TextBlock Text="{DynamicResource Opt_Flow}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                            <Slider x:Name="SldBrushFlow" VerticalAlignment="Center" Minimum="1" Maximum="100" Value="100" Width="100" IsSnapToTickEnabled="True" TickFrequency="1"/>
                            <TextBlock x:Name="TxtBrushFlow" Text="100%" VerticalAlignment="Center" Foreground="{StaticResource EditorTextPrimary}" FontSize="11" Width="35"/>
                        </StackPanel>
                        <Border Width="1" Background="{StaticResource EditorBorder}" Margin="8,0"/>
                    </StackPanel>

                    <!-- Magic Wand Settings -->
                    <StackPanel x:Name="OptWandGroup" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <TextBlock Text="{DynamicResource Opt_Tolerance}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                        <Slider x:Name="SldWandTolerance" VerticalAlignment="Center" Minimum="0" Maximum="255" Value="32" Width="110" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtWandTolerance" Text="32" VerticalAlignment="Center" Foreground="{StaticResource EditorTextPrimary}" FontSize="11" Width="25"/>
                        <CheckBox x:Name="ChkWandContiguous" Content="{DynamicResource Btn_Contiguous}" IsChecked="True" VerticalAlignment="Center" Foreground="White" FontSize="11"/>
                        <CheckBox x:Name="ChkWandSampleAlpha" Content="{DynamicResource Btn_SampleAlpha}" IsChecked="False" VerticalAlignment="Center" Foreground="White" FontSize="11"/>
                        <CheckBox x:Name="ChkWand8Conn" Content="{DynamicResource Btn_8Connected}" IsChecked="False" VerticalAlignment="Center" Foreground="White" FontSize="11"/>
                        <Border Width="1" Background="{StaticResource EditorBorder}" Margin="8,0"/>
                    </StackPanel>

                    <!-- Selection Settings -->
                    <StackPanel x:Name="OptSelectionGroup" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <TextBlock Text="{DynamicResource Opt_Feather}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                        <Slider x:Name="SldSelectionFeather" VerticalAlignment="Center" Minimum="0" Maximum="50" Value="0" Width="110" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtSelectionFeather" Text="0 px" VerticalAlignment="Center" Foreground="{StaticResource EditorTextPrimary}" FontSize="11" Width="35"/>
                        <CheckBox x:Name="ChkAntiAlias" Content="{DynamicResource Btn_AntiAlias}" IsChecked="True" VerticalAlignment="Center" Foreground="White" FontSize="11"/>
                        <Border Width="1" Background="{StaticResource EditorBorder}" Margin="8,0"/>
                    </StackPanel>

                    <!-- Refine Edge Settings -->
                    <StackPanel x:Name="OptRefineEdgeGroup" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <TextBlock Text="{DynamicResource Opt_Size}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                        <Slider x:Name="SldRefineEdgeSize" VerticalAlignment="Center" Minimum="5" Maximum="100" Value="30" Width="110" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtRefineEdgeSize" Text="30 px" VerticalAlignment="Center" Foreground="{StaticResource EditorTextPrimary}" FontSize="11" Width="40"/>
                        <TextBlock Text="{DynamicResource Opt_Feather}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                        <Slider x:Name="SldRefineEdgeFeather" VerticalAlignment="Center" Minimum="0" Maximum="20" Value="2" Width="110" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtRefineEdgeFeather" Text="2 px" VerticalAlignment="Center" Foreground="{StaticResource EditorTextPrimary}" FontSize="11" Width="35"/>
                        <Border Width="1" Background="{StaticResource EditorBorder}" Margin="8,0"/>
                    </StackPanel>

                    <!-- Pen Path Settings -->
                    <StackPanel x:Name="OptPenGroup" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <TextBlock Text="{DynamicResource Opt_Thickness}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                        <Slider x:Name="SldPenThickness" VerticalAlignment="Center" Minimum="1" Maximum="8" Value="2" Width="110" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtPenThickness" Text="2 px" VerticalAlignment="Center" Foreground="{StaticResource EditorTextPrimary}" FontSize="11" Width="30"/>
                        <Border Width="1" Background="{StaticResource EditorBorder}" Margin="8,0"/>
                    </StackPanel>

                    <!-- (Grow/Shrink ada di panel kanan + menu Select; tidak duplikat di sini
                         agar options bar muat di semua lebar jendela) -->

                    <!-- Status/Hint Area -->

                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Grid x:Name="EditorWorkspaceGrid" Grid.Row="3" RowDefinitions="*,Auto" ColumnDefinitions="Auto,*,Auto"
                  Background="{StaticResource EditorBg}">
                <Border x:Name="PanelToolRail" Grid.Row="0" Grid.Column="0" IsVisible="False"
                        Width="{StaticResource EditorRailWidth}"
                        Background="{StaticResource EditorSurface}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,0,1,0"
                        Padding="8,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <!-- Grup seleksi -->
                                                    <Button x:Name="BtnToolMove" Classes="editor-tool" Tag="Move" Click="OnToolClick" Width="36" Height="36" ToolTip.Tip="{DynamicResource Tip_ToolMove}">
                                                        <PathIcon Data="M10.5,5.4L13.5,5.4L13.5,18.6L10.5,18.6ZM5.4,10.5L18.6,10.5L18.6,13.5L5.4,13.5ZM12,1.8L9,6.6L15,6.6ZM12,22.2L9,17.4L15,17.4ZM1.8,12L6.6,9L6.6,15ZM22.2,12L17.4,9L17.4,15Z" Width="16" Height="16" Foreground="White"/>
                                                    </Button>
                                                    <Button x:Name="BtnToolRectMarquee" Classes="editor-tool" Tag="RectMarquee" Click="OnToolClick" Width="36" Height="36" ToolTip.Tip="{DynamicResource Tip_ToolRectMarquee}">
                                                        <PathIcon Data="M4,4L7.2,4L7.2,6L4,6ZM4,18L7.2,18L7.2,20L4,20ZM4,4L6,4L6,7.2L4,7.2ZM18,4L20,4L20,7.2L18,7.2ZM8.9,4L12.1,4L12.1,6L8.9,6ZM8.9,18L12.1,18L12.1,20L8.9,20ZM4,8.9L6,8.9L6,12.1L4,12.1ZM18,8.9L20,8.9L20,12.1L18,12.1ZM13.8,4L17,4L17,6L13.8,6ZM13.8,18L17,18L17,20L13.8,20ZM4,13.8L6,13.8L6,17L4,17ZM18,13.8L20,13.8L20,17L18,17ZM18,4L20,4L20,6L18,6ZM18,18L20,18L20,20L18,20ZM4,18L6,18L6,20L4,20ZM18,18L20,18L20,20L18,20Z" Width="16" Height="16" Foreground="White"/>
                                                    </Button>
                                                    <Button x:Name="BtnToolEllipseMarquee" Classes="editor-tool" Tag="EllipseMarquee" Click="OnToolClick" Width="36" Height="36" ToolTip.Tip="{DynamicResource Tip_ToolEllipseMarquee}">
                                                        <PathIcon Data="M21.1,12L21,12.6L21,13.1L20.8,13.6L20.7,14.2L18.6,13.6L18.8,13.2L18.9,12.8L18.9,12.4L18.9,12ZM20.2,15.2L19.8,15.7L19.5,16.2L19.1,16.6L18.6,17.1L17.1,15.6L17.4,15.3L17.7,15L18,14.7L18.3,14.3ZM17.6,17.8L17.1,18.2L16.5,18.4L15.9,18.7L15.3,18.9L14.6,17L15,16.8L15.5,16.6L15.9,16.4L16.3,16.2ZM14,19.3L13.4,19.4L12.7,19.4L12,19.4L11.3,19.4L11.5,17.3L12,17.3L12.5,17.3L13,17.3L13.5,17.2ZM10,19.3L9.3,19.1L8.7,18.9L8.1,18.7L7.5,18.5L8.5,16.6L9,16.8L9.5,17L10,17.1L10.5,17.2ZM6.4,17.8L5.8,17.5L5.4,17.1L4.9,16.7L4.5,16.2L6.3,15L6.6,15.3L6.9,15.6L7.3,15.9L7.7,16.2ZM3.8,15.2L3.6,14.7L3.4,14.2L3.2,13.7L3.1,13.1L5.1,12.8L5.2,13.2L5.4,13.6L5.5,14L5.7,14.3ZM2.9,12L3,11.4L3,10.9L3.2,10.4L3.3,9.8L5.4,10.4L5.2,10.8L5.1,11.2L5.1,11.6L5,12ZM3.8,8.8L4.2,8.3L4.5,7.8L4.9,7.4L5.4,6.9L6.9,8.4L6.6,8.7L6.3,9L6,9.3L5.7,9.7ZM6.4,6.2L6.9,5.8L7.5,5.6L8.1,5.3L8.7,5.1L9.4,7L9,7.2L8.5,7.4L8.1,7.6L7.7,7.8ZM10,4.7L10.6,4.6L11.3,4.6L12,4.6L12.7,4.6L12.5,6.7L12,6.7L11.5,6.7L11,6.7L10.5,6.8ZM14,4.7L14.7,4.9L15.3,5.1L15.9,5.3L16.5,5.5L15.5,7.4L15,7.2L14.5,7L14,6.9L13.5,6.8ZM17.6,6.2L18.2,6.5L18.6,6.9L19.1,7.3L19.5,7.8L17.7,9L17.4,8.7L17.1,8.4L16.7,8.1L16.3,7.8ZM20.2,8.8L20.4,9.3L20.6,9.8L20.8,10.3L20.9,10.9L18.9,11.2L18.8,10.8L18.6,10.4L18.5,10L18.3,9.7Z" Width="16" Height="16" Foreground="White"/>
                                                    </Button>
                                                    <Button x:Name="BtnToolLasso" Classes="editor-tool" Tag="Lasso" Click="OnToolClick" Width="36" Height="36" ToolTip.Tip="{DynamicResource Tip_ToolLasso}">
