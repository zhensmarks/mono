                                                        <PathIcon Data="M12,1.7L13.4,4.3L14.4,7.2L14.6,10.2L13.7,13.5L12,14.7L10.3,13.5L9.4,10.2L9.6,7.2L10.6,4.3ZM13.6,8.6L13.4,9.3L13,9.9L12.4,10.2L11.6,10.2L11,9.9L10.6,9.3L10.4,8.6L10.6,7.9L11,7.3L11.6,7L12.4,7L13,7.3L13.4,7.9L13.6,8.6ZM11.5,10.4L12.5,10.4L12.5,13.4L11.5,13.4Z" Width="16" Height="16" Foreground="White"/>
