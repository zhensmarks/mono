                            <Border Height="1" Background="{StaticResource EditorBorder}" Margin="4,6"/>
                            <!-- Grup brush -->
                                                    <Button x:Name="BtnToolBrush" Classes="editor-tool" Tag="Brush" Click="OnToolClick" Width="36" Height="36" ToolTip.Tip="{DynamicResource Tip_ToolBrush}">
                                                        <PathIcon Data="M19,5L17.7,5.8L16.4,7L15.1,8.5L13.8,10.5L15.6,12.3L16.8,10.5L17.8,8.7L18.5,6.9L19,5ZM13.8,10.5L15.6,12.3L12.8,15.1L11,13.3ZM10.5,12.8L3.8,19.5L6.6,22.3L13.3,15.6ZM7.2,20.9L7,21.8L6.4,22.5L5.6,22.8L4.8,22.8L4,22.5L3.4,21.8L3.2,20.9L3.4,20L4,19.3L4.8,19L5.6,19L6.4,19.3L7,20L7.2,20.9Z" Width="16" Height="16" Foreground="White"/>
