<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:PixelcutCompact.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="PixelcutCompact.Views.PreviewWindow"
        Title="Preview"
        WindowStartupLocation="CenterOwner"
        Width="1020" Height="680"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        Focusable="True"
        KeyDown="OnPreviewKeyDown">
        
    <Window.Styles>
        <Style Selector="Border.shimmer">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="Opacity" Value="0.1"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:0.75">
                        <Setter Property="Opacity" Value="0.5"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:1.5">
                        <Setter Property="Opacity" Value="0.1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
            <!-- Header (Draggable) -->
            <Grid Grid.Row="0" Background="Transparent" ColumnDefinitions="*, Auto" MinHeight="45" PointerPressed="OnHeaderPointerPressed">
                  <!-- Left: Title & Icon -->
                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="15,0,0,0">
                      <Grid Width="14" Height="14" VerticalAlignment="Center">
                          <PathIcon x:Name="ImgHeaderIcon" Data="M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5M3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3H5A2,2 0 0,0 3,5M5,5H19V19H5V5Z" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                          <!-- Premium Spinner: Circular track and dynamic spinning arc with rounded caps -->
                          <Grid x:Name="ImgLoadingIcon" Classes="spinning" Width="14" Height="14" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                              <!-- Background track -->
                              <Ellipse Width="12" Height="12" Stroke="#20FFFFFF" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                              <!-- Glowing spinning indicator -->
                              <Path Data="M 11,6 A 5,5 0 1,1 6,1" 
                                    Stroke="{DynamicResource AccentBlueBrush}" 
                                    StrokeThickness="1.5" 
                                    StrokeLineCap="Round" 
                                    Width="12" Height="12"
                                    Stretch="Fill"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                          </Grid>
                      </Grid>
                      <TextBlock x:Name="TxtTitle" Text="Preview Sebelum/Sesudah" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>

                  <!-- Right: Buttons -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <!-- Settings Button with Flyout -->
                      <Button VerticalAlignment="Center" Width="45" Height="45" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="Settings Shortcuts">
                          <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.47,2.42C14.43,2.18 14.23,2 14,2H10C9.77,2 9.57,2.18 9.53,2.42L9.13,5.07C8.52,5.32 7.96,5.65 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.53,21.58C9.57,21.82 9.77,22 10,22H14C14.23,22 14.43,21.82 14.47,21.58L14.87,18.93C15.48,18.68 16.04,18.35 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z" Width="16" Height="16"/>
                          <Button.Flyout>
                              <Flyout Placement="BottomEdgeAlignedRight" Opened="OnSettingsFlyoutOpened">
                                  <Border Background="#1C1C1F" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="12" Padding="15" Width="280">
                                      <StackPanel Spacing="12">
                                          <!-- Title -->
                                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,5">
                                              <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.47,2.42C14.43,2.18 14.23,2 14,2H10C9.77,2 9.57,2.18 9.53,2.42L9.13,5.07C8.52,5.32 7.96,5.65 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.53,21.58C9.57,21.82 9.77,22 10,22H14C14.23,22 14.43,21.82 14.47,21.58L14.87,18.93C15.48,18.68 16.04,18.35 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z" Width="14" Height="14" Foreground="{DynamicResource AccentBlueBrush}"/>
                                              <TextBlock Text="Shortcuts Settings" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                          </StackPanel>
                                          
                                          <!-- Separator -->
                                          <!-- Editor Beta Mode Toggle -->
                                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                              <TextBlock Text="Editor Mode (Beta)" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                              <CheckBox x:Name="ChkEditorBetaMode" Grid.Column="1" IsCheckedChanged="OnEditorBetaModeToggled" ToolTip.Tip="Aktifkan editor mask dan selection"/>
                                          </Grid>
                                          
                                          <!-- Separator -->
                                          <Border Height="1" Background="#22FFFFFF" Margin="0,5"/>
                                          <!-- Next Image -->
                                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                              <TextBlock Text="Next Image" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                              <TextBox x:Name="TxtNextShortcut" Grid.Column="1" Width="110" TextAlignment="Center" 
                                                       IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" 
                                                       Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="6" 
                                                       Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                                       Cursor="Hand" ToolTip.Tip="Klik lalu tekan tombol" Watermark="Press key..."/>
                                          </Grid>
                                          
                                          <!-- Prev Image -->
                                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                              <TextBlock Text="Prev Image" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                              <TextBox x:Name="TxtPrevShortcut" Grid.Column="1" Width="110" TextAlignment="Center" 
                                                       IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" 
                                                       Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="6" 
                                                       Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                                       Cursor="Hand" ToolTip.Tip="Klik lalu tekan tombol" Watermark="Press key..."/>
                                          </Grid>
                                          
                                          <!-- Photoshop -->
                                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                              <TextBlock Text="Open Photoshop" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                              <TextBox x:Name="TxtPhotoshopShortcut" Grid.Column="1" Width="110" TextAlignment="Center" 
                                                       IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" 
                                                       Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="6" 
                                                       Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                                       Cursor="Hand" ToolTip.Tip="Klik lalu tekan tombol" Watermark="Press key..."/>
                                          </Grid>

                                          <!-- Rotate Image -->
                                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                              <TextBlock Text="Rotate Image" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                              <TextBox x:Name="TxtRotateShortcut" Grid.Column="1" Width="110" TextAlignment="Center" 
                                                       IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" 
                                                       Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="6" 
                                                       Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                                       Cursor="Hand" ToolTip.Tip="Klik lalu tekan tombol" Watermark="Press key..."/>
                                          </Grid>

                                          <!-- Fit Screen -->
                                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                              <TextBlock Text="Fit Screen" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                              <TextBox x:Name="TxtFitScreenShortcut" Grid.Column="1" Width="110" TextAlignment="Center" 
                                                       IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" 
                                                       Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="6" 
                                                       Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                                       Cursor="Hand" ToolTip.Tip="Klik lalu tekan tombol" Watermark="Press key..."/>
                                          </Grid>
                                          
                                          <!-- Separator -->
                                          <Border Height="1" Background="#22FFFFFF" Margin="0,5"/>
                                          
                                          <!-- Background Type -->
                                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                              <TextBlock Text="Background" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                                              <ComboBox x:Name="CboBgType" Grid.Column="1" Width="110" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="6" SelectionChanged="OnBgTypeChanged" Foreground="White">
                                                  <ComboBoxItem Content="Default"/>
                                                  <ComboBoxItem Content="Checkerboard"/>
                                                  <ComboBoxItem Content="Solid Color"/>
                                              </ComboBox>
                                          </Grid>
                                          
                                          <!-- Solid Color Picker: Preset Swatches -->
                                          <StackPanel x:Name="PanelSolidColor" Margin="0,4" IsVisible="False" Spacing="6">
                                              <TextBlock Text="Warna Latar" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                              <!-- Row 1 -->
                                              <WrapPanel Orientation="Horizontal" ItemWidth="24" ItemHeight="24">
                                                  <!-- White -->
                                                  <Button x:Name="SwColor_FFFFFF" Width="22" Height="22" Margin="1" Padding="0" Background="#FFFFFF" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Putih (#FFFFFF)"/>
                                                  <!-- Light Gray -->
                                                  <Button x:Name="SwColor_D1D5DB" Width="22" Height="22" Margin="1" Padding="0" Background="#D1D5DB" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Abu Muda (#D1D5DB)"/>
                                                  <!-- Gray -->
                                                  <Button x:Name="SwColor_6B7280" Width="22" Height="22" Margin="1" Padding="0" Background="#6B7280" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Abu (#6B7280)"/>
                                                  <!-- Dark Gray -->
                                                  <Button x:Name="SwColor_1F2937" Width="22" Height="22" Margin="1" Padding="0" Background="#1F2937" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Abu Gelap (#1F2937)"/>
                                                  <!-- Black -->
                                                  <Button x:Name="SwColor_000000" Width="22" Height="22" Margin="1" Padding="0" Background="#000000" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Hitam (#000000)"/>
                                                  <!-- Red -->
                                                  <Button x:Name="SwColor_EF4444" Width="22" Height="22" Margin="1" Padding="0" Background="#EF4444" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Merah (#EF4444)"/>
                                                  <!-- Orange -->
                                                  <Button x:Name="SwColor_F97316" Width="22" Height="22" Margin="1" Padding="0" Background="#F97316" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Oranye (#F97316)"/>
                                                  <!-- Yellow -->
                                                  <Button x:Name="SwColor_EAB308" Width="22" Height="22" Margin="1" Padding="0" Background="#EAB308" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Kuning (#EAB308)"/>
                                                  <!-- Green -->
                                                  <Button x:Name="SwColor_22C55E" Width="22" Height="22" Margin="1" Padding="0" Background="#22C55E" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Hijau (#22C55E)"/>
                                                  <!-- Green Screen -->
                                                  <Button x:Name="SwColor_00FF00" Width="22" Height="22" Margin="1" Padding="0" Background="#00FF00" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Green Screen (#00FF00)"/>
                                                  <!-- Blue -->
                                                  <Button x:Name="SwColor_3B82F6" Width="22" Height="22" Margin="1" Padding="0" Background="#3B82F6" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Biru (#3B82F6)"/>
                                                  <!-- Purple -->
                                                  <Button x:Name="SwColor_8B5CF6" Width="22" Height="22" Margin="1" Padding="0" Background="#8B5CF6" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="Ungu (#8B5CF6)"/>
                                              </WrapPanel>
                                              <!-- Active color preview + hex display -->
                                              <Grid ColumnDefinitions="Auto, *">
                                                  <Border x:Name="BrdCurrentColor" Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                  <TextBlock x:Name="TxtCurrentColorHex" Grid.Column="1" Text="#FFFFFF" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center" FontFamily="Consolas, Monospace"/>
                                              </Grid>
                                          </StackPanel>
                                          
                                          <!-- Checkerboard Color Swatches -->
                                          <StackPanel x:Name="PanelCheckerColor" Margin="0,4" IsVisible="False" Spacing="6">
                                              <TextBlock Text="Warna Kotak 1 (Terang)" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                              <WrapPanel Orientation="Horizontal" ItemWidth="24" ItemHeight="24">
                                                  <Button x:Name="CkColor1_FFFFFF" Width="22" Height="22" Margin="1" Padding="0" Background="#FFFFFF" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="Putih"/>
                                                  <Button x:Name="CkColor1_CCCCCC" Width="22" Height="22" Margin="1" Padding="0" Background="#CCCCCC" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="Abu Sangat Muda"/>
                                                  <Button x:Name="CkColor1_999999" Width="22" Height="22" Margin="1" Padding="0" Background="#999999" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="Abu Muda"/>
                                                  <Button x:Name="CkColor1_666666" Width="22" Height="22" Margin="1" Padding="0" Background="#666666" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="Abu"/>
                                                  <Button x:Name="CkColor1_4D4D4D" Width="22" Height="22" Margin="1" Padding="0" Background="#4D4D4D" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="Abu Tua"/>
                                              </WrapPanel>
                                              <TextBlock Text="Warna Kotak 2 (Gelap)" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                              <WrapPanel Orientation="Horizontal" ItemWidth="24" ItemHeight="24">
                                                  <Button x:Name="CkColor2_AAAAAA" Width="22" Height="22" Margin="1" Padding="0" Background="#AAAAAA" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="Abu Sedang"/>
                                                  <Button x:Name="CkColor2_555555" Width="22" Height="22" Margin="1" Padding="0" Background="#555555" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="Abu Gelap"/>
                                                  <Button x:Name="CkColor2_333333" Width="22" Height="22" Margin="1" Padding="0" Background="#333333" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="Hampir Hitam"/>
                                                  <Button x:Name="CkColor2_1A1A1A" Width="22" Height="22" Margin="1" Padding="0" Background="#1A1A1A" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="Sangat Gelap"/>
                                                  <Button x:Name="CkColor2_000000" Width="22" Height="22" Margin="1" Padding="0" Background="#000000" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="Hitam"/>
                                              </WrapPanel>
                                              <!-- Preview kedua kotak -->
                                              <Grid ColumnDefinitions="Auto,Auto,*">
                                                  <Border x:Name="BrdChecker1Preview" Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#333333" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                  <Border x:Name="BrdChecker2Preview" Grid.Column="1" Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#4D4D4D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                  <TextBlock x:Name="TxtCheckerHex" Grid.Column="2" Text="#333333 / #4D4D4D" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center" FontFamily="Consolas, Monospace"/>
                                              </Grid>
                                          </StackPanel>
                                          
                                          <!-- Save Button -->
                                          <Button Content="Save Configuration" Click="OnSaveSettingsClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0" Padding="15,8" Background="{DynamicResource AccentBlueBrush}" Foreground="White" FontWeight="SemiBold" CornerRadius="8" Cursor="Hand"/>
                                      </StackPanel>
                                  </Border>
                              </Flyout>
                          </Button.Flyout>
                      </Button>
                      
                      <!-- Editor Mode Header Controls -->
                      <Border x:Name="ChipEditMode" IsVisible="False" Background="#1F6FEB" CornerRadius="10" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="MODE EDITOR" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                      </Border>
                      <Button x:Name="BtnEnterEditHeader" IsVisible="False" Content="Mulai Edit" VerticalAlignment="Center" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource AccentBlueBrush}" Foreground="White" FontSize="12" FontWeight="SemiBold" CornerRadius="8" Cursor="Hand"/>
                      <Button x:Name="BtnExitEditHeader" IsVisible="False" Content="Selesai" VerticalAlignment="Center" Padding="12,6" Margin="0,0,8,0" Background="#374151" Foreground="White" FontSize="12" FontWeight="SemiBold" CornerRadius="8" Cursor="Hand"/>
                      
                      <!-- Close Button -->
                      <Button Click="OnCloseClick" VerticalAlignment="Center" Content="✕" Width="45" Height="45" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                  </StackPanel>
            </Grid>

            <!-- Editor Tool Rail (Horizontal Top Toolbar) -->
            <Border x:Name="PanelToolRail" Grid.Row="1" VerticalAlignment="Top" Margin="0,0,0,0"
                    Background="#1A1C20" BorderBrush="#2A2A2E" BorderThickness="0,0,0,1" Padding="8,6"
                    IsVisible="False" Height="48" CornerRadius="0" ClipToBounds="True">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <!-- Selection Tools Group -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                        <Button x:Name="BtnToolMove" Tag="Move" Click="OnToolClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Move Tool (V) - Geser selection aktif">
                            <PathIcon Data="M13,6H11V11H6V13H11V18H13V13H18V11H13V6M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnToolRectMarquee" Tag="RectMarquee" Click="OnToolClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Rectangular Marquee (M) - Shift=persegi, Alt=dari pusat">
                            <PathIcon Data="M3,3H21V21H3V3M5,5V19H19V5H5Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnToolEllipseMarquee" Tag="EllipseMarquee" Click="OnToolClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Elliptical Marquee (Shift+M) - Shift=lingkaran">
                            <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnToolPolyLasso" Tag="PolyLasso" Click="OnToolClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Polygonal Lasso - Klik titik-titik sudut">
                            <PathIcon Data="M2,2V8L8,14V22H16V14L22,8V2H2M4,4H20V7L14,13V20H10V13L4,7V4Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnToolWand" Tag="MagicWand" Click="OnToolClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Magic Wand (W) - Klik area mirip warna">
                            <PathIcon Data="M7.5,5.6L5,7L6.4,4.5L5,2L7.5,3.4L10,2L8.6,4.5L10,7L7.5,5.6M19.5,15.4L22,14L20.6,16.5L22,19L19.5,17.6L17,19L18.4,16.5L17,14L19.5,15.4M22,2L20.6,4.5L22,7L19.5,5.6L17,7L18.4,4.5L17,2L19.5,3.4L22,2M13.34,12.78L15.78,10.34L13.66,8.22L11.22,10.66L13.34,12.78M14.37,7.29L16.71,9.63C17.1,10 17.1,10.65 16.71,11.04L5.04,22.71C4.65,23.1 4,23.1 3.63,22.71L1.29,20.37C0.9,20 0.9,19.35 1.29,18.96L12.96,7.29C13.35,6.9 14,6.9 14.37,7.29Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnToolPen" Tag="Pen" Click="OnToolClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Pen Tool (P) - Klik untuk titik sudut, drag untuk kurva">
                            <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Border Width="1" Background="#30FFFFFF" Margin="6,4"/>
                    </StackPanel>

                    <!-- Paint Tools Group -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left">
                        <Button x:Name="BtnToolBrush" Tag="Brush" Click="OnToolClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Brush (B) - Pulihkan atau hapus mask">
                            <PathIcon Data="M20.71,4.04C21.1,3.65 21.1,3 20.71,2.63L18.37,0.29C18,-0.1 17.35,-0.1 16.96,0.29L15.12,2.12L18.87,5.87M3,14.25V18H6.75L17.81,6.93L14.06,3.18L3,14.25M5.92,15.08L5,14.16L14.31,4.85L15.23,5.77L5.92,15.08Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnToolEraser" Tag="Eraser" Click="OnToolClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Penghapus (E) - Hapus area dari mask">
                            <PathIcon Data="M16.24,3.56L21.19,8.5C21.97,9.29 21.97,10.55 21.19,11.34L12,20.53C11.21,21.31 9.95,21.31 9.16,20.53L2.81,14.17C2.03,13.38 2.03,12.12 2.81,11.34L11.95,2.2C12.74,1.41 14,1.41 14.79,2.2L16.24,3.56M4.22,11.34L10.59,17.71L18.47,9.83L12.11,3.46L4.22,11.34Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnToolRefineEdge" Tag="RefineEdge" Click="OnToolClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Refine Edge Brush - Sapu di tepi selection">
                            <PathIcon Data="M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5M3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3H5A2,2 0 0,0 3,5M5,5H19V19H5V5Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnToolPan" Tag="Pan" Click="OnToolClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Pan Tool (H) - Geser/zoom gambar">
                            <PathIcon Data="M13,6V11H18V7.75L22.25,12L18,16.25V13H13V18H16.25L12,22.25L7.75,18H11V13H6V16.25L1.75,12L6,7.75V11H11V6H7.75L12,1.75L16.25,6H13Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Border Width="1" Background="#30FFFFFF" Margin="6,4"/>
                    </StackPanel>

                    <!-- Quick Actions Group -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button x:Name="BtnSelectAll" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Select All (Ctrl+A)">
                            <PathIcon Data="M3,3H21V21H3V3M5,5V19H19V5H5Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnSelectNone" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Deselect (Ctrl+D)">
                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnInvertSelection" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Invert Selection (Ctrl+Shift+I)">
                            <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M4,12H12V4C7.58,4 4,7.58 4,12Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnQuickMask" Click="OnQuickMaskClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Quick Mask (Q): overlay merah menandai area seleksi">
                            <PathIcon Data="M12,2C17.52,2 22,6.48 22,12C22,17.52 17.52,22 12,22C6.48,22 2,17.52 2,12C2,6.48 6.48,2 12,2M12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4M12,6C14.21,6 16,7.79 16,10C16,11.5 15.2,12.77 14,13.46V16H10V13.46C8.8,12.77 8,11.5 8,10C8,7.79 9.79,6 12,6Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnRefineHair" Click="OnRefineHairClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Refine Hair (AI)">
                            <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6C13.93,6 15.5,7.57 15.5,9.5C15.5,10.09 15.35,10.65 15.08,11.13L17,15H15L13.5,12L12,15L10.5,12L9,15H7L8.92,11.13C8.65,10.65 8.5,10.09 8.5,9.5C8.5,7.57 10.07,6 12,6Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Border Width="1" Background="#30FFFFFF" Margin="6,4"/>
                    </StackPanel>

                    <!-- Undo/Redo and Save Group -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                        <Button x:Name="BtnUndo" Click="OnUndoClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Undo (Ctrl+Z)">
                            <PathIcon Data="M12.5,8C9.85,8 7.45,9.16 5.75,11L2,7.25V16H11L7.04,12.04C8.26,10.77 10.27,10 12.5,10C16.55,10 19.85,12.81 20.75,16.5L22.64,16C21.5,11.25 17.36,8 12.5,8Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnRedo" Click="OnRedoClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Redo (Ctrl+Y)">
                            <PathIcon Data="M11.5,8C14.15,8 16.55,9.16 18.25,11L22,7.25V16H13L16.96,12.04C15.74,10.77 13.73,10 11.5,10C7.45,10 4.15,12.81 3.25,16.5L1.36,16C2.5,11.25 6.64,8 11.5,8Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Border Width="1" Background="#30FFFFFF" Margin="6,4"/>
                        <Button x:Name="BtnSaveEdit" Click="OnSaveEditClick" Width="36" Height="36" Background="#2048D17A" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Save (Ctrl+S)">
                            <PathIcon Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnSaveAsEdit" Click="OnSaveAsEditClick" Width="36" Height="36" Background="#153B82F6" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Save As">
                            <PathIcon Data="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M12,19L16,15H13.5V12H10.5V15H8L12,19Z" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnExitEdit" Click="OnExitEditClick" Width="36" Height="36" Background="#15FFFFFF" BorderThickness="0" CornerRadius="6" ToolTip.Tip="Exit Editor (Esc)">
                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="16" Height="16" Foreground="#EF4444"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Options Bar (Tool-specific settings) -->
            <Border x:Name="PanelOptionsBar" Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,0"
                    Background="#16161A" BorderBrush="#2A2A2E" BorderThickness="0,0,0,1" Padding="12,6"
                    IsVisible="False" Height="40" CornerRadius="0" ClipToBounds="True">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
                    <!-- Brush Settings -->
                    <StackPanel x:Name="OptBrushGroup" Grid.Column="0" Orientation="Horizontal" Spacing="12" IsVisible="False">
                        <TextBlock Text="Ukuran:" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                        <Slider x:Name="SldBrushSize" Minimum="1" Maximum="2000" Value="60" Width="80" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtBrushSize" Text="60 px" VerticalAlignment="Center" Foreground="White" FontSize="11" Width="45"/>
                        <TextBlock Text="Softness:" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11" Margin="8,0,0,0"/>
                        <Slider x:Name="SldBrushHardness" Minimum="0" Maximum="100" Value="30" Width="60" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtBrushHardness" Text="30%" VerticalAlignment="Center" Foreground="White" FontSize="11" Width="30"/>
                        <Button x:Name="BtnBrushAdvanced" Content="Lanjutan" Padding="8,4" Background="#15FFFFFF" BorderThickness="0" CornerRadius="4" FontSize="11" Foreground="White" ToolTip.Tip="Tampilkan opsi opacity dan flow"/>
                        <StackPanel x:Name="OptBrushAdvancedGroup" Orientation="Horizontal" Spacing="8" IsVisible="False">
                            <TextBlock Text="Opacity:" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                            <Slider x:Name="SldBrushOpacity" Minimum="1" Maximum="100" Value="100" Width="60" IsSnapToTickEnabled="True" TickFrequency="1"/>
                            <TextBlock x:Name="TxtBrushOpacity" Text="100%" VerticalAlignment="Center" Foreground="White" FontSize="11" Width="35"/>
                            <TextBlock Text="Flow:" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                            <Slider x:Name="SldBrushFlow" Minimum="1" Maximum="100" Value="100" Width="60" IsSnapToTickEnabled="True" TickFrequency="1"/>
                            <TextBlock x:Name="TxtBrushFlow" Text="100%" VerticalAlignment="Center" Foreground="White" FontSize="11" Width="35"/>
                        </StackPanel>
                        <Button x:Name="BtnBrushRestore" Content="Hapus" Click="OnBrushModeClick" Padding="10,4" Background="#15FFFFFF" BorderThickness="0" CornerRadius="4" FontSize="11" Foreground="White" ToolTip.Tip="Mode Hapus/Pulihkan (X)"/>
                        <Border Width="1" Background="#30FFFFFF" Margin="8,0"/>
                    </StackPanel>

                    <!-- Magic Wand Settings -->
                    <StackPanel x:Name="OptWandGroup" Grid.Column="1" Orientation="Horizontal" Spacing="12" IsVisible="False">
                        <TextBlock Text="Tolerance:" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                        <Slider x:Name="SldWandTolerance" Minimum="0" Maximum="255" Value="32" Width="80" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtWandTolerance" Text="32" VerticalAlignment="Center" Foreground="White" FontSize="11" Width="25"/>
                        <CheckBox x:Name="ChkWandContiguous" Content="Contiguous" IsChecked="True" VerticalAlignment="Center" Foreground="White" FontSize="11" Margin="8,0,0,0"/>
                        <CheckBox x:Name="ChkWandSampleAlpha" Content="Sample Alpha" IsChecked="False" VerticalAlignment="Center" Foreground="White" FontSize="11" Margin="8,0,0,0"/>
                        <CheckBox x:Name="ChkWand8Conn" Content="8-Connected" IsChecked="False" VerticalAlignment="Center" Foreground="White" FontSize="11" Margin="8,0,0,0"/>
                        <Border Width="1" Background="#30FFFFFF" Margin="8,0"/>
                    </StackPanel>

                    <!-- Selection Settings -->
                    <StackPanel x:Name="OptSelectionGroup" Grid.Column="2" Orientation="Horizontal" Spacing="12" IsVisible="False">
                        <TextBlock Text="Feather:" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                        <Slider x:Name="SldSelectionFeather" Minimum="0" Maximum="50" Value="0" Width="80" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtSelectionFeather" Text="0 px" VerticalAlignment="Center" Foreground="White" FontSize="11" Width="35"/>
                        <CheckBox x:Name="ChkAntiAlias" Content="Anti-alias" IsChecked="True" VerticalAlignment="Center" Foreground="White" FontSize="11" Margin="8,0,0,0"/>
                        <Border Width="1" Background="#30FFFFFF" Margin="8,0"/>
                    </StackPanel>

                    <!-- Refine Edge Settings -->
                    <StackPanel x:Name="OptRefineEdgeGroup" Grid.Column="3" Orientation="Horizontal" Spacing="12" IsVisible="False">
                        <TextBlock Text="Size:" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                        <Slider x:Name="SldRefineEdgeSize" Minimum="5" Maximum="100" Value="30" Width="60" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtRefineEdgeSize" Text="30 px" VerticalAlignment="Center" Foreground="White" FontSize="11" Width="40"/>
                        <TextBlock Text="Feather:" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11" Margin="8,0,0,0"/>
                        <Slider x:Name="SldRefineEdgeFeather" Minimum="0" Maximum="20" Value="2" Width="60" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtRefineEdgeFeather" Text="2 px" VerticalAlignment="Center" Foreground="White" FontSize="11" Width="35"/>
                        <Border Width="1" Background="#30FFFFFF" Margin="8,0"/>
                    </StackPanel>

                    <!-- Selection Mode (Replace/Add/Subtract/Intersect) -->
                    <StackPanel x:Name="OptSelectionModeGroup" Grid.Column="4" Orientation="Horizontal" Spacing="4" IsVisible="False">
                        <ToggleButton x:Name="BtnModeReplace" Content="New" IsChecked="True" Padding="8,4" Background="#15FFFFFF" BorderThickness="0" CornerRadius="4" FontSize="11" Foreground="White" IsCheckedChanged="OnSelectionModeClick" ToolTip.Tip="Mode: Selection baru"/>
                        <ToggleButton x:Name="BtnModeAdd" Content="Add" Padding="8,4" Background="#15FFFFFF" BorderThickness="0" CornerRadius="4" FontSize="11" Foreground="White" IsCheckedChanged="OnSelectionModeClick" ToolTip.Tip="Mode: Tambah ke selection"/>
                        <ToggleButton x:Name="BtnModeSubtract" Content="Sub" Padding="8,4" Background="#15FFFFFF" BorderThickness="0" CornerRadius="4" FontSize="11" Foreground="White" IsCheckedChanged="OnSelectionModeClick" ToolTip.Tip="Mode: Kurangi selection"/>
                        <ToggleButton x:Name="BtnModeIntersect" Content="Intersect" Padding="8,4" Background="#15FFFFFF" BorderThickness="0" CornerRadius="4" FontSize="11" Foreground="White" IsCheckedChanged="OnSelectionModeClick" ToolTip.Tip="Mode: Irisan selection"/>
                        <Border Width="1" Background="#30FFFFFF" Margin="8,0"/>
                    </StackPanel>

                    <!-- Grow/Shrink Selection -->
                    <StackPanel x:Name="OptSelGrowGroup" Grid.Column="5" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <TextBlock Text="Grow:" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                        <Slider x:Name="SldSelGrowPx" Minimum="1" Maximum="50" Value="5" Width="50" IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <TextBlock x:Name="TxtSelGrowPx" Text="5 px" VerticalAlignment="Center" Foreground="White" FontSize="11" Width="35"/>
                        <Button x:Name="BtnSelGrow" Content="Grow" Padding="6,3" Background="#15FFFFFF" BorderThickness="0" CornerRadius="4" FontSize="10" Foreground="White" ToolTip.Tip="Perluas selection"/>
                        <Button x:Name="BtnSelShrink" Content="Shrink" Padding="6,3" Background="#15FFFFFF" BorderThickness="0" CornerRadius="4" FontSize="10" Foreground="White" ToolTip.Tip="Ciutkan selection"/>
                        <Border Width="1" Background="#30FFFFFF" Margin="8,0"/>
                    </StackPanel>

                    <!-- Status/Hint Area -->
                    <TextBlock x:Name="TxtEditorHint" Grid.Column="6" Text="Pilih tool untuk mulai mengedit mask." VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#80FFFFFF" FontSize="11"/>
                </Grid>
            </Border>
            <Grid Grid.Row="3" ColumnDefinitions="*, Auto">
                <Grid Grid.Column="0">
                    <!-- STATE 1: Normal Preview (Side-by-Side) -->
                    <Grid x:Name="PanelNormalPreview" ColumnDefinitions="*, 2, *" Margin="10,0,10,10">
                        <!-- Original -->
                        <Grid x:Name="PanelOriginalColumn" Grid.Column="0" RowDefinitions="*, Auto">
                            <Border x:Name="BrdOriginal" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Background="#0DFFFFFF" CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <Image Name="ImgOriginal" Stretch="Uniform" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           PointerPressed="OnImagePointerPressed" PointerMoved="OnImagePointerMoved" 
                                           PointerReleased="OnImagePointerReleased" PointerWheelChanged="OnImagePointerWheelChanged">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                <TranslateTransform X="0" Y="0" />
                                                <RotateTransform Angle="{Binding $parent[views:PreviewWindow].RotationOriginal}" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                    <!-- Rotate Button Overlay -->
                                    <Button Click="OnRotateOriginalClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" 
                                            Background="#80000000" CornerRadius="6" Padding="6" BorderThickness="0" ToolTip.Tip="Rotate Original" IsVisible="False">
                                        <PathIcon Data="M12,4C14.2,4 16.2,4.8 17.6,6.3C20.7,9.4 20.7,14.5 17.6,17.6C15.8,19.5 13.3,20.2 11,19.9V21.9C13.9,22.2 16.9,21.2 19.1,19C23,15.1 23,8.9 19,5C17.1,3.1 14.5,2.1 12,2V0L7,4L12,8V4Z" 
                                                 Width="14" Height="14" Foreground="White">
                                            <PathIcon.RenderTransform>
                                                <RotateTransform Angle="90"/>
                                            </PathIcon.RenderTransform>
                                        </PathIcon>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Original" HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>

                        <!-- Separator -->
                        <GridSplitter x:Name="SplitterPreview" Grid.Column="1" Width="2" Background="#40808080" ResizeBehavior="PreviousAndNext"/>

                        <!-- Result -->
                        <Grid Grid.Column="2" RowDefinitions="*, Auto">
                            <Border x:Name="BrdResult" BorderBrush="#60FFFFFF" BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                                    Background="#252525"
                                    BoxShadow="0 4 24 0 #88000000, 0 1 4 0 #44000000">
                                <Grid>
                                    <Image Name="ImgResult" Stretch="Uniform" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%"
                                           PointerPressed="OnImagePointerPressed" PointerMoved="OnImagePointerMoved"
                                           PointerReleased="OnImagePointerReleased" PointerWheelChanged="OnImagePointerWheelChanged">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                <TranslateTransform X="0" Y="0" />
                                                <RotateTransform Angle="{Binding $parent[views:PreviewWindow].RotationResult}" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                    <!-- Overlay quick mask: area seleksi ditandai merah -->
                                    <Image x:Name="ImgQuickMask" Stretch="Uniform" Margin="5"
                                           IsVisible="False" IsHitTestVisible="False"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                <TranslateTransform X="0" Y="0" />
                                                <RotateTransform Angle="{Binding $parent[views:PreviewWindow].RotationResult}" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                    <!-- Overlay "Bandingkan": Original semi-transparan di atas kanvas editor -->
                                    <Image x:Name="ImgOriginalCompare" Stretch="Uniform" Margin="5"
                                           IsVisible="False" IsHitTestVisible="False" Opacity="0.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                <TranslateTransform X="0" Y="0" />
                                                <RotateTransform Angle="{Binding $parent[views:PreviewWindow].RotationResult}" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                    <!-- Overlay editor: marquee, anchor pen, brush cursor, marching ants -->
                                    <Canvas x:Name="EditOverlay" IsVisible="False" IsHitTestVisible="False"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"
                                            Width="{Binding #ImgResult.Bounds.Width}" Height="{Binding #ImgResult.Bounds.Height}"
                                            ClipToBounds="False" ZIndex="100"/>
                                    <Path x:Name="SelectionAntsShadow" IsHitTestVisible="False" ZIndex="101"
                                          Stroke="#DD111111" StrokeThickness="3" StrokeDashArray="4,4" Fill="Transparent"/>
                                    <Path x:Name="SelectionAnts" IsHitTestVisible="False" ZIndex="102"
                                          Stroke="White" StrokeThickness="1" StrokeDashArray="4,4" Fill="Transparent"/>
                                    <!-- View controls (compare + zoom) -->
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Spacing="4">
                                        <ToggleButton x:Name="BtnCompare" Content="Bandingkan" FontSize="10" Padding="8,4" CornerRadius="6"
                                                      Background="#CC1A1D21" Foreground="White" BorderThickness="0" ToolTip.Tip="Tampilkan Original di atas hasil"/>
                                        <NumericUpDown x:Name="ZoomControl" Minimum="0.2" Maximum="20" Increment="0.1" Value="1" FormatString="0.0"
                                                       Width="92" FontSize="10" Background="#CC1A1D21" Foreground="White"/>
                                    </StackPanel>
                                    <!-- Tombol Edit (pill, tengah-bawah kanvas) -->
                                    <Button x:Name="BtnEnterEdit" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                                            Background="#E63B82F6" CornerRadius="18" Padding="16,9" BorderThickness="0" ToolTip.Tip="Mulai edit mask (shortcut: E)">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <PathIcon Data="M20.71,4.63L19.37,3.29C19,2.9 18.35,2.9 17.96,3.29L9,12.25L11.75,15L20.71,6.04C21.1,5.65 21.1,5 20.71,4.63M7,14A3,3 0 0,0 4,17C4,18.31 2.84,19 2,19C2.92,20.22 4.5,21 6,21A4,4 0 0,0 10,17A3,3 0 0,0 7,14Z" Width="15" Height="15" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="Mulai Edit" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Spinner Refine Hair -->
                                    <Border x:Name="PanelRefineBusy" IsVisible="False" Background="#B0000000" CornerRadius="6">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                            <Grid Classes="spinning" Width="28" Height="28" HorizontalAlignment="Center">
                                                <PathIcon Data="M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z" Width="28" Height="28" Foreground="{DynamicResource AccentBlueBrush}"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtRefineBusy" Text="Memproses Refine Hair…" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                                            <Button x:Name="BtnRefineCancel" Content="Batal" FontSize="11" Padding="12,4" CornerRadius="6"
                                                    Background="#30FFFFFF" Foreground="White" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Editor status bar -->
                                    <Border x:Name="PanelEditorStatus" IsVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                            Background="#CC101216" Padding="8,4">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                <TextBlock x:Name="TxtEditorTool" Text="Pan" FontSize="10" Foreground="#93C5FD"/>
                                                <TextBlock x:Name="TxtEditorImageSize" Text="-" FontSize="10" Foreground="#9CA3AF"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtSelInfo" Grid.Column="1" Text="Selection: -" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                                <TextBlock x:Name="TxtEditorUndo" Text="Undo 0 / Redo 0" FontSize="10" Foreground="#9CA3AF"/>
                                                <TextBlock x:Name="TxtZoom" Text="Zoom 100%" FontSize="10" Foreground="#9CA3AF"/>
                                                <TextBlock x:Name="TxtEditorProvider" Text="ONNX" FontSize="10" Foreground="#6B7280"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Rotate Button Overlay -->
                                    <Button Click="OnRotateResultClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" 
                                            Background="#80000000" CornerRadius="6" Padding="6" BorderThickness="0" ToolTip.Tip="Rotate Result" IsVisible="False">
                                        <PathIcon Data="M12,4C14.2,4 16.2,4.8 17.6,6.3C20.7,9.4 20.7,14.5 17.6,17.6C15.8,19.5 13.3,20.2 11,19.9V21.9C13.9,22.2 16.9,21.2 19.1,19C23,15.1 23,8.9 19,5C17.1,3.1 14.5,2.1 12,2V0L7,4L12,8V4Z" 
                                                 Width="14" Height="14" Foreground="White">
                                            <PathIcon.RenderTransform>
                                                <RotateTransform Angle="90"/>
                                            </PathIcon.RenderTransform>
                                        </PathIcon>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Result" HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Grid>

                    <!-- Ghost Loading Overlay -->
                    <Grid x:Name="OverlayLoading" ColumnDefinitions="*, 2, *" Margin="10,0,10,10" IsVisible="False">
                        <!-- Left Skeleton -->
                        <Border Grid.Column="0" Classes="shimmer" Background="#15FFFFFF" CornerRadius="8" ClipToBounds="True">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                                <PathIcon Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M5,19V5H19V19H5M6,17H18L14.25,12L11.25,16L9,13L6,17Z" Width="48" Height="48" Foreground="#20FFFFFF"/>
                            </StackPanel>
                        </Border>
                        <!-- Right Skeleton -->
                        <Border Grid.Column="2" Classes="shimmer" Background="#15FFFFFF" CornerRadius="8" ClipToBounds="True">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                                <PathIcon Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M5,19V5H19V19H5M6,17H18L14.25,12L11.25,16L9,13L6,17Z" Width="48" Height="48" Foreground="#20FFFFFF"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Panel Kanan: Selection / Mask / History / Layers -->
                <Border x:Name="PanelRightEditor" Grid.Column="1" IsVisible="False" Width="240"
                        Background="#1A1D21" BorderBrush="#2D3139" BorderThickness="1,0,0,0" Padding="0" Margin="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="0">

                            <!-- SELECTION SECTION -->
                            <Border Background="#252830" BorderBrush="#2D3139" BorderThickness="0,0,0,1" Padding="12,10">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <PathIcon Grid.Column="0" Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z" Width="14" Height="14" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="SELECTION" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <Button x:Name="BtnToggleEditorPanel" Grid.Column="2" Content="Panel" FontSize="9" Padding="6,2" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtSelStatus" Text="No active selection" FontSize="10" TextWrapping="Wrap" Foreground="#9CA3AF"/>
                                    <Grid ColumnDefinitions="*,*,*" Margin="0,2">
                                        <Button x:Name="BtnSelAllPanel" Grid.Column="0" Content="All" FontSize="10" Padding="0,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB" Margin="0,0,2,0"/>
                                        <Button x:Name="BtnSelNonePanel" Grid.Column="1" Content="None" FontSize="10" Padding="0,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB" Margin="2,0"/>
                                        <Button x:Name="BtnSelInvertPanel" Grid.Column="2" Content="Invert" FontSize="10" Padding="0,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB" Margin="2,0,0,0"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,4">
                                        <TextBlock Text="Pixels:" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldSelGrowPxPanel" Grid.Column="1" Margin="8,0" Minimum="1" Maximum="200" Value="4" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtSelGrowPxPanel" Grid.Column="2" Text="4" FontSize="10" Width="24" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button x:Name="BtnSelGrowPanel" Content="Grow" FontSize="10" Padding="12,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB"/>
                                        <Button x:Name="BtnSelShrinkPanel" Content="Shrink" FontSize="10" Padding="12,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB"/>
                                        <Button x:Name="BtnSelFeatherPanel" Content="Feather" FontSize="10" Padding="12,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button x:Name="BtnSelSavePanel" Content="Save Sel" FontSize="10" Padding="10,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB"/>
                                        <Button x:Name="BtnSelLoadPanel" Content="Load Sel" FontSize="10" Padding="10,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- MASK SECTION -->
                            <Border Background="#1A1D21" BorderBrush="#2D3139" BorderThickness="0,0,0,1" Padding="12,10">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z" Width="14" Height="14" Foreground="#F59E0B"/>
                                        <TextBlock Text="MASK" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*,*" Margin="0,2">
                                        <Button x:Name="BtnApplyErasePanel" Grid.Column="0" Content="Erase" FontSize="10" Padding="0,4" CornerRadius="4" Background="#3B1F1F" BorderThickness="0" Foreground="#FCA5A5" Margin="0,0,2,0"/>
                                        <Button x:Name="BtnApplyRestorePanel" Grid.Column="1" Content="Restore" FontSize="10" Padding="0,4" CornerRadius="4" Background="#1F3B2A" BorderThickness="0" Foreground="#86EFAC" Margin="2,0"/>
                                        <Button x:Name="BtnApplyFillPanel" Grid.Column="2" Content="Fill" FontSize="10" Padding="0,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB" Margin="2,0,0,0"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*" Margin="0,2">
                                        <Button x:Name="BtnMaskExpandPanel" Grid.Column="0" Content="Expand" FontSize="10" Padding="0,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB" Margin="0,0,2,0"/>
                                        <Button x:Name="BtnMaskContractPanel" Grid.Column="1" Content="Contract" FontSize="10" Padding="0,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB" Margin="2,0"/>
                                        <Button x:Name="BtnMaskFeatherPanel" Grid.Column="2" Content="Feather" FontSize="10" Padding="0,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB" Margin="2,0,0,0"/>
                                    </Grid>
                                    <Button x:Name="BtnMaskDefringePanel" Content="Defringe" FontSize="10" Padding="10,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>

                            <!-- HISTORY SECTION -->
                            <Border Background="#252830" BorderBrush="#2D3139" BorderThickness="0,0,0,1" Padding="12,10">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z" Width="14" Height="14" Foreground="#60A5FA"/>
                                        <TextBlock Text="HISTORY" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Background="#1A1D21" CornerRadius="6" Padding="4" MaxHeight="200">
                                        <ListBox x:Name="LstHistory" Background="Transparent" BorderThickness="0" FontSize="10" Foreground="#9CA3AF" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- LAYERS SECTION -->
                            <Border x:Name="PanelDocLayers" Background="#1A1D21" BorderBrush="#2D3139" BorderThickness="0" Padding="12,10" IsVisible="False">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M12,2L2,7L12,12L22,7L12,2M2,17L12,22L22,17L2,17M2,12L12,17L22,12L2,12Z" Width="14" Height="14" Foreground="#34D399"/>
                                        <TextBlock Text="LAYERS" FontSize="11" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Background="#12141A" CornerRadius="6" Padding="4" MaxHeight="220">
                                        <ItemsControl x:Name="LayerList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="views:LayerViewModel">
                                                    <Border Padding="4" Margin="0,1" CornerRadius="4" Background="#15FFFFFF">
                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                            <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="32" Height="32" Margin="0,0,6,0"/>
                                                            <CheckBox Grid.Column="1" IsChecked="{Binding Visible}" Width="20" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11" Foreground="#E5E7EB" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Opacity, StringFormat='{}{0:0}%'}" FontSize="9" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <Grid ColumnDefinitions="*,*,*,*">
                                        <Button x:Name="BtnLayerAdd" Grid.Column="0" Content="+" FontSize="11" Padding="0,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB" Margin="0,0,2,0"/>
                                        <Button x:Name="BtnLayerDelete" Grid.Column="1" Content="−" FontSize="11" Padding="0,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB" Margin="2,0"/>
                                        <Button x:Name="BtnLayerDup" Grid.Column="2" Content="Dup" FontSize="10" Padding="0,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB" Margin="2,0"/>
                                        <Button x:Name="BtnLayerMerge" Grid.Column="3" Content="Merge" FontSize="10" Padding="0,4" CornerRadius="4" Background="#374151" BorderThickness="0" Foreground="#E5E7EB" Margin="2,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border Grid.Row="4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Background="#0AFFFFFF" Padding="15,10" MinHeight="55">
                 <Grid>
                     <!-- Center: Navigation Buttons & Photoshop & Toast -->
                     <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                          <!-- Navigation and Actions -->
                          <StackPanel x:Name="PanelNavigation" Orientation="Horizontal" Spacing="20" IsVisible="True">
                              <Button Click="OnPreviousClick" Width="36" Height="36" CornerRadius="8" Background="#15FFFFFF" BorderThickness="1" BorderBrush="#30FFFFFF" ToolTip.Tip="Sebelumnya">
                                  <PathIcon Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                              </Button>
                              
                              <Button x:Name="BtnFooterMode" IsVisible="True" Click="OnFooterModeClick" Padding="20,8" Background="#206366F1" BorderBrush="#806366F1" BorderThickness="1" CornerRadius="8" ToolTip.Tip="Buka Photoshop">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                      <PathIcon x:Name="IconFooterMode" Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V5H19V19M11,14.5V11.5H13C14.1,11.5 15,12.4 15,13.5C15,14.6 14.1,15.5 13,15.5H11M11,10H13C14.93,10 16.5,11.57 16.5,13.5C16.5,15.43 14.93,17 13,17H9.5V7H11V10Z" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                                      <TextBlock x:Name="TxtFooterMode" Text="PHOTOSHOP" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                  </StackPanel>
                              </Button>
                              
                              <Button Click="OnNextClick" Width="36" Height="36" CornerRadius="8" Background="#15FFFFFF" BorderThickness="1" BorderBrush="#30FFFFFF" ToolTip.Tip="Berikutnya">
                                  <PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                              </Button>
                          </StackPanel>
                          
                          <!-- Save Toast Notification -->
                          <Border x:Name="ToastNotification" Background="#18A05A" CornerRadius="8" Padding="15,8" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#40FFFFFF" BorderThickness="1">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                  <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.58L21,7Z" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                                  <TextBlock Text="Perubahan berhasil disimpan" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                              </StackPanel>
                          </Border>
                     </Grid>
                 </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
