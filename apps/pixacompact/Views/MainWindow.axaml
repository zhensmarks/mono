<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PixelcutCompact.ViewModels"
        xmlns:cv="clr-namespace:PixelcutCompact.Converters"
        xmlns:models="using:PixelcutCompact.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="PixelcutCompact.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Pixa Compact"

        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        CornerRadius="0"
        Background="{DynamicResource CardBackgroundBrush}">

    <Window.Resources>
        <cv:LuminanceToBrushConverter x:Key="LuminanceToBrushConverter"/>
        <cv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <cv:BooleanToStatusBrushConverter x:Key="BooleanToStatusBrushConverter"/>
        <cv:BooleanToActiveAccountBrushConverter x:Key="BooleanToActiveAccountBrushConverter"/>
        <cv:PathToBitmapConverter x:Key="PathToBitmapConverter"/>

        <!-- Icons -->
        <StreamGeometry x:Key="IconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</StreamGeometry>
        <StreamGeometry x:Key="IconRetry">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.86,17.53 19.79,14.15L17.65,13.62C16.96,16.27 14.73,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M14,19H18V5H14M6,19H10V5H6V19Z</StreamGeometry>
        <StreamGeometry x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.35 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.35 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</StreamGeometry>
        <StreamGeometry x:Key="IconProcess">M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M10,16.5L16,12L10,7.5V16.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronDown">M7,10L12,15L17,10H7Z</StreamGeometry>
        <StreamGeometry x:Key="IconLightning">M11,15H6L13,1V9H18L11,23V15Z</StreamGeometry>
        <StreamGeometry x:Key="IconMonitor">M21,16C22.1,16 23,15.1 23,14V4C23,2.9 22.1,2 21,2H3C1.9,2 1,2.9 1,4V14C1,15.1 1.9,16 3,16H10V18H8V20H16V18H14V16H21M3,4H21V14H3V4Z</StreamGeometry>
        <StreamGeometry x:Key="IconCloud">M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14C0,17.31 2.69,20 6,20H19C21.76,20 24,17.76 24,15C24,12.36 21.95,10.22 19.35,10.04Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <!-- Compact Tooltip Style -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Swatch warna (kotak kecil klik untuk pilih warna preset) -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.swatch:pointerover">
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.swatch:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="FlyoutPresenter.ModeFlyout">
            <Setter Property="Background" Value="#1A1C20"/>
            <Setter Property="BorderBrush" Value="#2A2C30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- Style untuk Kartu Opsi Pemilih Engine -->
        <Style Selector="Button.engine-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.engine-card:pointerover">
        </Style>
        <Style Selector="Button.engine-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        </Style>
        <Style Selector="Button.engine-card.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1F2D78C4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
        </Style>

        <!-- Style untuk Kartu List Item File -->
        <Style Selector="Border.file-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.file-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        </Style>
        <Style Selector="Border.dashboard-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.dashboard-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
        </Style>

        <!-- State proses memakai aksen yang sama dengan pilihan aktif. -->
        <Style Selector="Border.file-card.processing">
            <Setter Property="Background" Value="#1F2D78C4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
        </Style>
        <Style Selector="Border.file-card.processing:pointerover">
            <Setter Property="Background" Value="#2B2D78C4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
        </Style>

        <!-- Done State (Green glow) -->
        <Style Selector="Border.file-card.done">
            <Setter Property="Background" Value="#1010B981"/>
            <Setter Property="BorderBrush" Value="#2010B981"/>
        </Style>
        <Style Selector="Border.file-card.done:pointerover">
            <Setter Property="Background" Value="#1A10B981"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
        </Style>

        <!-- Failed State (Red glow) -->
        <Style Selector="Border.file-card.failed">
            <Setter Property="Background" Value="#10EF4444"/>
            <Setter Property="BorderBrush" Value="#50EF4444"/>
        </Style>
        <Style Selector="Border.file-card.failed:pointerover">
            <Setter Property="Background" Value="#1AEF4444"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
        </Style>

        <!-- Active progress is conveyed by the visible spinner, not a per-card pulse. -->
        <!-- ProgressBar indeterminate accent color -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
        </Style>
        <!-- Title is clickable, but must not show button hover treatment -->
        <Style Selector="Button.title-model-selector:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.title-model-selector:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.title-model-selector:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.title-model-selector:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Styles>

    <!-- Main Border for Window Outline -->
    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True">
      <Panel>
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Height="56" Background="Transparent" ColumnDefinitions="Auto, *, Auto, Auto">
                 <!-- Drag Area with Padding -->
                 <Border Grid.Column="0" Grid.ColumnSpan="4" Background="Transparent" Padding="12,0" PointerPressed="OnHeaderPointerPressed">
                     <Panel />
                 </Border>

                   <!-- Left Area: Model Title Selector -->
                   <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="12,0">

                       <!-- Model Selector (styled as title) -->
                       <Button x:Name="EngineSelectorButton"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               BorderThickness="0"
                               Padding="8"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="Bold"
                               Cursor="Hand"
                               Classes="title-model-selector"
                               ToolTip.Tip="Pilih engine pemrosesan">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding SelectedEngineDisplayName}" VerticalAlignment="Center"/>
                          </StackPanel>
                          <Button.Flyout>
                              <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="ModeFlyout">
                                  <StackPanel Width="290" Spacing="10">
                                      <!-- Header -->
                                      <StackPanel Spacing="2">
                                          <TextBlock Text="Engine Remove BG" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                          <TextBlock Text="Pilih mode &amp; engine pemrosesan" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                      </StackPanel>
                                      <Separator Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2"/>
                                      <!-- Opsi Stack -->
                                      <StackPanel Spacing="6">
                                          <Button Command="{Binding SelectEngineCommand}" CommandParameter="PIXA"
                                                  Classes="engine-card pixa" Classes.selected="{Binding IsPixaSelected}">
                                              <Grid ColumnDefinitions="Auto, *, Auto">
                                                  <Border Grid.Column="0" Width="3" Height="24" CornerRadius="1.5" Background="#10B981" Margin="0,0,10,0"/>
                                                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                      <StackPanel Orientation="Horizontal" Spacing="6">
                                                          <PathIcon Data="{StaticResource IconLightning}" Width="12" Height="12" Foreground="#10B981" VerticalAlignment="Center"/>
                                                          <TextBlock Text="PIXA (Default)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                      </StackPanel>
                                                      <TextBlock Text="Sangat Cepat • Berbasis Cloud" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                  </StackPanel>
                                                  <PathIcon Grid.Column="2" Data="{StaticResource IconCheck}" Width="10" Height="10" Foreground="{DynamicResource AccentBlueBrush}" IsVisible="{Binding IsPixaSelected}"/>
                                              </Grid>
                                          </Button>
                                          <Button Command="{Binding SelectEngineCommand}" CommandParameter="REMBG"
                                                  Classes="engine-card rembg" Classes.selected="{Binding IsRembgSelected}">
                                              <Grid ColumnDefinitions="Auto, *, Auto">
                                                  <Border Grid.Column="0" Width="3" Height="24" CornerRadius="1.5" Background="#6366F1" Margin="0,0,10,0"/>
                                                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                      <StackPanel Orientation="Horizontal" Spacing="6">
                                                          <PathIcon Data="{StaticResource IconMonitor}" Width="12" Height="12" Foreground="#6366F1" VerticalAlignment="Center"/>
                                                          <TextBlock Text="REMBG (Offline AI)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                      </StackPanel>
                                                      <TextBlock Text="100% Privat • Komputer Lokal" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                  </StackPanel>
                                                  <PathIcon Grid.Column="2" Data="{StaticResource IconCheck}" Width="10" Height="10" Foreground="{DynamicResource AccentBlueBrush}" IsVisible="{Binding IsRembgSelected}"/>
                                              </Grid>
                                          </Button>
                                          <Button Command="{Binding SelectEngineCommand}" CommandParameter="REMBG_ONLINE"
                                                  Classes="engine-card rembg-online" Classes.selected="{Binding IsRembgOnlineSelected}">
                                              <Grid ColumnDefinitions="Auto, *, Auto">
                                                  <Border Grid.Column="0" Width="3" Height="24" CornerRadius="1.5" Background="#8B5CF6" Margin="0,0,10,0"/>
                                                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                      <StackPanel Orientation="Horizontal" Spacing="6">
                                                          <PathIcon Data="{StaticResource IconCloud}" Width="12" Height="12" Foreground="#8B5CF6" VerticalAlignment="Center"/>
                                                          <TextBlock Text="REMBG Online AI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                      </StackPanel>
                                                      <TextBlock Text="Otomatis Web • Awan" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                  </StackPanel>
                                                  <PathIcon Grid.Column="2" Data="{StaticResource IconCheck}" Width="10" Height="10" Foreground="{DynamicResource AccentBlueBrush}" IsVisible="{Binding IsRembgOnlineSelected}"/>
                                              </Grid>
                                          </Button>
                                          <Button Command="{Binding SelectEngineCommand}" CommandParameter="NOBG_SPACE"
                                                  Classes="engine-card nobg-space" Classes.selected="{Binding IsNobgSpaceSelected}">
                                              <Grid ColumnDefinitions="Auto, *, Auto">
                                                  <Border Grid.Column="0" Width="3" Height="24" CornerRadius="1.5" Background="#3B82F6" Margin="0,0,10,0"/>
                                                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                      <StackPanel Orientation="Horizontal" Spacing="6">
                                                          <PathIcon Data="{StaticResource IconCloud}" Width="12" Height="12" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                                          <TextBlock Text="NOBG Space" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                      </StackPanel>
                                                      <TextBlock Text="Playwright Web • Awan" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                  </StackPanel>
                                                  <PathIcon Grid.Column="2" Data="{StaticResource IconCheck}" Width="10" Height="10" Foreground="{DynamicResource AccentBlueBrush}" IsVisible="{Binding IsNobgSpaceSelected}"/>
                                              </Grid>
                                          </Button>
                                          <Button Command="{Binding SelectEngineCommand}" CommandParameter="BG_ERASER"
                                                  Classes="engine-card bg-eraser" Classes.selected="{Binding IsBgEraserSelected}">
                                              <Grid ColumnDefinitions="Auto, *, Auto">
                                                  <Border Grid.Column="0" Width="3" Height="24" CornerRadius="1.5" Background="#F97316" Margin="0,0,10,0"/>
                                                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                      <StackPanel Orientation="Horizontal" Spacing="6">
                                                          <PathIcon Data="{StaticResource IconCloud}" Width="12" Height="12" Foreground="#F97316" VerticalAlignment="Center"/>
                                                          <TextBlock Text="BG Eraser" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                      </StackPanel>
                                                      <TextBlock Text="Playwright Web • Awan" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                  </StackPanel>
                                                  <PathIcon Grid.Column="2" Data="{StaticResource IconCheck}" Width="10" Height="10" Foreground="{DynamicResource AccentBlueBrush}" IsVisible="{Binding IsBgEraserSelected}"/>
                                              </Grid>
                                          </Button>
                                      </StackPanel>
                                      <!-- REMBG Model -->
                                      <StackPanel Spacing="4" IsVisible="{Binding IsRembgSelected}" Margin="0,4,0,0">
                                          <Separator Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,6"/>
                                          <TextBlock Text="Model AI REMBG Offline" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                          <ComboBox SelectedItem="{Binding RembgModel}" ItemsSource="{Binding RembgModels}" HorizontalAlignment="Stretch"/>
                                      </StackPanel>
                                  </StackPanel>
                              </Flyout>
                          </Button.Flyout>
                      </Button>
                  </StackPanel>

                 <!-- Window Controls (Right aligned) -->
                 <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">

                     <!-- View Toggle Button -->
                     <Button Command="{Binding OpenGalleryCommand}"
                             Classes="icon"
                             Background="Transparent" BorderThickness="0"
                             VerticalAlignment="Center" ToolTip.Tip="Buka Gallery View (Jendela Baru)"
                             CornerRadius="6" AutomationProperties.Name="Buka galeri">
                         <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                              <!-- Show Grid Icon when in List Mode (to switch to Grid) -->
                              <PathIcon Data="M2,2H11V11H2V2M2,13H11V22H2V13M13,2H22V11H13V2M13,13H22V22H13V13Z"
                                        Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                              <!-- Show List Icon when in Grid Mode (to switch to List) -->
                              <PathIcon Data="M3,4H21V8H3V4M3,10H21V14H3V10M3,16H21V20H3V16Z"
                                        Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"
                                        IsVisible="False"/>
                         </Panel>
                         <Button.Styles>
                             <Style Selector="Button:pointerover /template/ ContentPresenter">
                                 <Setter Property="Background" Value="#1AFFFFFF"/>
                             </Style>
                             <Style Selector="Button:pressed /template/ ContentPresenter">
                                 <Setter Property="Background" Value="#2AFFFFFF"/>
                             </Style>
                         </Button.Styles>
                     </Button>

                     <Button Click="OnCloseWindow"
                             Classes="icon quiet"
                             Width="40" Height="40"
                             VerticalAlignment="Center" HorizontalAlignment="Center"
                             ToolTip.Tip="Tutup" AutomationProperties.Name="Tutup PixaCompact">
                         <PathIcon Data="{StaticResource IconClose}"
                                   Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                     </Button>
                 </StackPanel>
            </Grid>

            <!-- Main Content Area with Tabs -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="0" Padding="0" ClipToBounds="True"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0">


            <Grid Grid.Row="1" RowDefinitions="Auto, *">
                <!-- Centered Segmented Tabs (Image Style) -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CardBackgroundBrush}" Padding="0">
                    <Grid ColumnDefinitions="*, Auto" HorizontalAlignment="Stretch">

                        <!-- Segmented Control Container -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                ClipToBounds="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0"
                                >

                            <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="CornerRadius" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="MinHeight" Value="40"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="ClipToBounds" Value="True"/>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Background" Value="#0AFFFFFF"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <!-- Active Tab gets Accent Color -->
                                        <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
                                        <Setter Property="ZIndex" Value="10"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
                                    </Style>

                                    <!-- Text Colors -->
                                    <Style Selector="ListBoxItem:selected TextBlock.tab-title">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                    <Style Selector="ListBoxItem TextBlock.tab-title">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>

                                    <!-- Icons Color -->
                                    <Style Selector="ListBoxItem:selected PathIcon.status-icon">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected Ellipse.status-icon">
                                        <Setter Property="Fill" Value="#FFFFFF"/>
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected TextBlock.close-icon">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </Style>

                                    <!-- Separator (Right border on all but last item) -->
                                    <!-- Since we can't easily target 'not last' in Avalonia 11 styles without nth-child, we just put right border on all, and hide the ListBox container's right border, or just use a subtle right border. -->
                                    <Style Selector="ListBoxItem Border.separator">
                                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected Border.separator">
                                        <Setter Property="BorderThickness" Value="0,0,0,0"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="separator" Padding="8,4,8,4" Background="Transparent" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding ProgressText}">
                                            <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">

                                                <!-- Status Icon -->
                                                <Grid Grid.Column="0" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <!-- Idle -->
                                                    <Ellipse Classes="status-icon" Width="6" Height="6" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.4" IsVisible="{Binding IsWaiting}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <!-- Done -->
                                                    <PathIcon Classes="status-icon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="#10B981" IsVisible="{Binding IsDone}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <!-- Processing: determinate progress ring (mengikuti progres tab) -->
                                                    <Grid IsVisible="{Binding IsProcessing}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <!-- Track (dim full ring) -->
                                                        <Ellipse Width="16" Height="16" Stroke="#22FFFFFF" StrokeThickness="2.5"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <!-- Progress arc: StartAngle -90 = atas, SweepAngle ikut ProgressSweep -->
                                                        <Arc Classes="status-icon" Width="16" Height="16" Fill="Transparent"
                                                             Stroke="#FFFFFF" StrokeThickness="2.5" StrokeLineCap="Round"
                                                             StartAngle="-90" SweepAngle="{Binding ProgressSweep}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Arc.Styles>
                                                                <Style Selector="Arc">
                                                                    <Style.Animations>
                                                                        <!-- Pulse halus biar terlihat hidup -->
                                                                        <Animation Duration="0:0:1.4" IterationCount="Infinite" Easing="LinearEasing">
                                                                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                                            <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.5"/></KeyFrame>
                                                                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                                        </Animation>
                                                                    </Style.Animations>
                                                                </Style>
                                                            </Arc.Styles>
                                                        </Arc>
                                                    </Grid>
                                                </Grid>

                                                <!-- Folder Name with TextWrapping -->
                                                <TextBlock Grid.Column="1" Classes="tab-title" Text="{Binding Title}" FontSize="12.5"
                                                           TextWrapping="Wrap" MaxLines="2" TextAlignment="Center" HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Center" LineHeight="14" TextTrimming="CharacterEllipsis" Margin="4,0"
                                                           ToolTip.Tip="{Binding Title}"/>

                                                <!-- Close Button -->
                                                <Button Grid.Column="2" x:CompileBindings="False" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                        Classes="tab-icon quiet" Margin="4,0,0,0" VerticalAlignment="Center"
                                                        ToolTip.Tip="Tutup tab" AutomationProperties.Name="Tutup tab">
                                                    <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12"
                                                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Add Tab Button -->
                        <Button Grid.Column="1" Command="{Binding AddTabCommand}" Classes="icon quiet" Width="40" Margin="0"
                                CornerRadius="7" VerticalAlignment="Stretch"
                                ToolTip.Tip="Tambah tab" AutomationProperties.Name="Tambah tab">
                            <PathIcon Data="M 11 4 L 11 11 L 4 11 L 4 13 L 11 13 L 11 20 L 13 20 L 13 13 L 20 13 L 20 11 L 13 11 L 13 4 Z"
                                      Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                </Style>
                                <Style Selector="Button:pointerover TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Style>
                            </Button.Styles>
                        </Button>

                    </Grid>
                </Border>

                <!-- TAB CONTENT -->
                <ContentControl Grid.Row="1" Content="{Binding SelectedTab}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="vm:ProcessTabViewModel">
<Grid DragDrop.AllowDrop="True" Background="Transparent" RowDefinitions="*">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto" MinWidth="0" MaxWidth="500"/>
                            </Grid.ColumnDefinitions>

                            <!-- FILE LIST AREA -->
                            <Grid Grid.Column="0" RowDefinitions="*">
                                <!-- Empty State -->
                                <Grid Grid.Row="0" IsVisible="{Binding !HasFiles}" PointerPressed="OnDashboardPointerPressed" Cursor="Hand">
                                    <Border Classes="dashboard-card" Margin="40,50" CornerRadius="16" Padding="40,50" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                                             <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="32" Padding="16"
                                                     HorizontalAlignment="Center" Width="64" Height="64"
                                                     BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                                 <PathIcon Data="M21 16.5C21 16.88 20.79 17.21 20.47 17.38L12.57 21.82C12.41 21.94 12.21 22 12 22C11.79 22 11.59 21.94 11.43 21.82L3.53 17.38C3.21 17.21 3 16.88 3 16.5V7.5C3 7.12 3.21 6.79 3.53 6.62L11.43 2.18C11.59 2.06 11.79 2 12 2C12.21 2 12.41 2.06 12.57 2.18L20.47 6.62C20.79 6.79 21 7.12 21 7.5V16.5M12 4.15L6.04 7.5L12 10.85L17.96 7.5L12 4.15M5 15.91L11 19.29V12.58L5 9.21V15.91M19 15.91V9.21L13 12.58V19.29L19 15.91Z"
                                                           Width="32" Height="32" Foreground="{DynamicResource AccentBlueBrush}"/>
                                             </Border>
                                             <StackPanel Spacing="12" HorizontalAlignment="Center">
                                                 <TextBlock Text="Pilih gambar atau folder untuk diproses" FontSize="13"
                                                            Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                                                 <TextBlock Text="• Klik di sini untuk memilih file&#10;• Atau tarik dan lepas file/folder" FontSize="11"
                                                            Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                                             </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- ListBox with native draggable scrollbar -->
                                <ListBox x:Name="FileListBox" Grid.Row="0" IsVisible="{Binding HasFiles}"
                                         ItemsSource="{Binding Files}" Background="Transparent"
                                         Margin="0,10,0,10"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                                         SelectionMode="Multiple" DoubleTapped="OnFileDoubleTapped">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="10,0,20,8"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <ControlTemplate>
                                                    <ContentPresenter Background="{TemplateBinding Background}"
                                                                      BorderBrush="{TemplateBinding BorderBrush}"
                                                                      BorderThickness="{TemplateBinding BorderThickness}"
                                                                      CornerRadius="{TemplateBinding CornerRadius}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Content="{TemplateBinding Content}"
                                                                      Padding="{TemplateBinding Padding}"
                                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                </ControlTemplate>
                                            </Setter>
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="file-card"
                                                    Classes.processing="{Binding IsProcessing}"
                                                    Classes.done="{Binding IsDone}"
                                                    Classes.failed="{Binding IsFailed}"
                                                    Padding="10,8"
                                                    Margin="0,0,0,4"
                                                    PointerPressed="OnFileItemPointerPressed">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" MinHeight="0" Padding="0"
                                                              IsHitTestVisible="False"/>

                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Preview" Command="{Binding DataContext.(vm:MainWindowViewModel).PreviewItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding .}"/>
                                                            <MenuItem Header="Buka Folder" Command="{Binding DataContext.(vm:MainWindowViewModel).OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding .}"/>
                                                            <Separator/>
                                                            <MenuItem Header="Retry" Command="{Binding DataContext.(vm:MainWindowViewModel).RetrySingleItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding .}"/>
                                                            <MenuItem Header="Hapus" Command="{Binding DataContext.(vm:MainWindowViewModel).RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding .}"/>
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>

                                                    <!-- Left: Name & Progress -->
                                                    <Grid Grid.Column="1" RowDefinitions="Auto, Auto, Auto" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,0,4"/>

                                                        <TextBlock Grid.Row="1" Text="{Binding Status}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   IsVisible="{Binding !IsFailed}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                                        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" FontSize="10" FontWeight="Bold" Foreground="#EF4444"
                                                                   IsVisible="{Binding IsFailed}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                                        <ProgressBar Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                                                                     Foreground="{DynamicResource AccentBlueBrush}" Background="Transparent" BorderThickness="0"
                                                                     IsIndeterminate="True"
                                                                     IsVisible="{Binding IsProcessing}"/>
                                                    </Grid>

                                                    <!-- Right: Size & Status -->
                                                    <StackPanel Grid.Column="2" Margin="15,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                            <!-- Preview Button -->
                                                            <Button Command="{Binding DataContext.(vm:MainWindowViewModel).PreviewItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding .}"
                                                                    Classes="icon quiet" Padding="0"
                                                                    IsVisible="{Binding HasResult}"
                                                                    ToolTip.Tip="Preview Hasil" AutomationProperties.Name="Preview hasil">
                                                                <PathIcon Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                                                                          Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </Button>

                                                            <TextBlock Text="{Binding OriginalSizeDisplay}" FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center" TextTrimming="None" TextWrapping="NoWrap"/>

                                                            <PathIcon Data="M5 12h14M12 5l7 7-7 7" Width="10" Height="10"
                                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                                      VerticalAlignment="Center"
                                                                      IsVisible="{Binding IsDone}"/>

                                                            <TextBlock Text="{Binding ResultSizeDisplay}" FontSize="11"
                                                                       Foreground="{DynamicResource AccentBlueBrush}"
                                                                       VerticalAlignment="Center" TextTrimming="None" TextWrapping="NoWrap"
                                                                       IsVisible="{Binding IsDone}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- SPLITTER -->
                            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" ResizeDirection="Columns"
                                          IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsPreviewPaneVisible}"/>

                            <!-- PREVIEW PANE -->
                            <Border Grid.Column="2" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsPreviewPaneVisible}"
                                    Width="300" Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0">
                                <Grid>
                                    <!-- No Selection State -->
                                    <Grid IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedPreviewItem, Converter={x:Static ObjectConverters.IsNull}}">
                                        <TextBlock Text="Pilih file untuk preview" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>

                                    <!-- Selection Content -->
                                    <Grid IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedPreviewItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          RowDefinitions="Auto, *, Auto">


                                        <!-- Header Info -->
                                        <Grid Grid.Row="0" Margin="15" ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Spacing="5">
                                                 <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedPreviewItem.FileName}" FontWeight="Bold"
                                                            Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="16"/>
                                                 <StackPanel Orientation="Horizontal" Spacing="10">
                                                     <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedPreviewItem.ResultSizeDisplay, StringFormat='Result: {0}'}" FontSize="12" Foreground="{DynamicResource AccentBlueBrush}"/>
                                                     <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedPreviewItem.OriginalSizeDisplay, StringFormat='Original: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                 </StackPanel>
                                            </StackPanel>

                                            <!-- Close Button -->
                                            <Button Grid.Column="1" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TogglePreviewPaneCommand}"
                                                    Width="28" Height="28" Padding="0"
                                                    Background="Transparent" BorderThickness="0" CornerRadius="4"
                                                    VerticalAlignment="Top" HorizontalAlignment="Right"
                                                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="Tutup Panel" AutomationProperties.Name="Tutup panel preview">
                                                <PathIcon Data="{StaticResource IconClose}"
                                                          Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="#1AFFFFFF"/>
                                                    </Style>
                                                </Button.Styles>
                                            </Button>
                                        </Grid>

                                        <!-- Images -->
                                        <ScrollViewer Grid.Row="1" Padding="15,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Spacing="15">
                                                <!-- Result -->
                                                <Border CornerRadius="6" ClipToBounds="True" Background="#10000000" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedPreviewItem.HasResult}">
                                                    <StackPanel>
                                                        <Image Source="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedPreviewItem.ResultPath, Converter={StaticResource PathToBitmapConverter}}" Stretch="Uniform" MaxHeight="250"/>
                                                        <Border Background="#20000000" Padding="5">
                                                            <TextBlock Text="OUTPUT" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Original -->
                                                <Border CornerRadius="6" ClipToBounds="True" Background="#10000000">
                                                    <StackPanel>
                                                        <Image Source="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedPreviewItem.FilePath, Converter={StaticResource PathToBitmapConverter}}" Stretch="Uniform" MaxHeight="250"/>
                                                        <Border Background="#20000000" Padding="5">
                                                            <TextBlock Text="INPUT" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <!-- Actions -->
                                        <StackPanel Grid.Row="2" Margin="15" Spacing="10">
                                            <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenFullPreviewWindowCommand}"
                                                    CommandParameter="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedPreviewItem}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                     <PathIcon Data="M21 19V5C21 3.89 20.1 3 19 3H5C3.9 3 3 3.89 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19M8.5 13.5L11 16.5L14.5 12L19 18H5L8.5 13.5Z" Width="16" Height="16"/>
                                                     <TextBlock Text="Full Preview"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>



            </Border>

            <!-- Footer / Controls -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                    Padding="15,10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto, *">
                    <!-- Status + Counter -->
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

                        <!-- Log Button -->
                        <Button Command="{Binding ToggleLogCommand}" Classes="icon quiet" ToolTip.Tip="Lihat Log"
                                AutomationProperties.Name="Lihat log">
                            <PathIcon Data="M3,4H21V8H3V4M3,10H21V14H3V10M3,16H21V20H3V16Z" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>

                        <!-- Settings Button -->
                        <Button Command="{Binding ShowSettingsCommand}" Classes="icon quiet" ToolTip.Tip="Pengaturan"
                                AutomationProperties.Name="Buka pengaturan">
                            <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>

                        <!-- VPN Status (Compact) -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="{Binding VpnStatus}" Background="Transparent">
                            <Ellipse Width="8" Height="8" Fill="{Binding IsVpnActive, Converter={StaticResource BooleanToStatusBrushConverter}}"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="{DynamicResource CardBorderBrush}" VerticalAlignment="Center"/>

                        <!-- Progress Counter Card -->
                        <Border Background="#0DFFFFFF" CornerRadius="6" Padding="10,4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                                <!-- Mini Ring: shows done fraction -->
                                <Grid Width="28" Height="28" VerticalAlignment="Center">
                                    <!-- Idle/Done state: static ring -->
                                    <Grid IsVisible="{Binding !IsProcessing}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Track ring (outer) -->
                                        <Ellipse Width="24" Height="24" Stroke="#20FFFFFF" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <!-- Done: check icon in center -->
                                        <PathIcon Data="{StaticResource IconCheck}" Width="9" Height="9" Foreground="#10B981" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  IsVisible="{Binding IsCurrentTabAllDone}"/>
                                        <!-- Idle: small dot in center -->
                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.35"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsVisible="{Binding !IsCurrentTabAllDone}"/>
                                    </Grid>
                                    <!-- Processing: The entire spinner grid rotates around its own center -->
                                    <Grid IsVisible="{Binding IsProcessing}" Width="24" Height="24"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RenderTransformOrigin="50%,50%">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Grid.RenderTransform>
                                        <Grid.Styles>
                                            <Style Selector="Grid">
                                                <Style.Animations>
                                                    <Animation Duration="0:0:0.9" IterationCount="Infinite" Easing="LinearEasing">
                                                        <KeyFrame Cue="0%">
                                                            <Setter Property="RotateTransform.Angle" Value="0"/>
                                                        </KeyFrame>
                                                        <KeyFrame Cue="100%">
                                                            <Setter Property="RotateTransform.Angle" Value="360"/>
                                                        </KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </Grid.Styles>
                                        <!-- Dim track -->
                                        <Ellipse Width="22" Height="22" Stroke="#18FFFFFF" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <!-- Bright leading arc (top quarter, rotates with parent grid) -->
                                        <Arc Width="22" Height="22" StartAngle="0" SweepAngle="270"
                                             Stroke="{DynamicResource AccentBlueBrush}" StrokeThickness="2.5"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>

                                <!-- Counter Text -->
                                <StackPanel VerticalAlignment="Center" Spacing="0">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProcessedCount}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text=" / " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FilesCount}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-1,0,0"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Actions: secondary (kiri) + primary Remove BG (paling kanan).
                         StackPanel rata-kanan agar tombol selalu rapat ke kanan. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" VerticalAlignment="Center">

                        <!-- Retry Button (senada: transparent + hover, tanpa border) -->
                        <Button Command="{Binding RetrySmallFilesCommand}" IsVisible="{Binding IsRetryVisible}"
                                Classes="icon"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="6"
                                ToolTip.Tip="Ulangi (Error)" AutomationProperties.Name="Ulangi file gagal">
                            <PathIcon Data="{StaticResource IconRetry}"
                                      Width="16" Height="16"
                                      Foreground="#EF4444"/>
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1AEF4444"/>
                                </Style>
                            </Button.Styles>
                        </Button>

                        <!-- Delete Button (senada: transparent + hover, tanpa border) -->
                        <Button Command="{Binding ClearCommand}"
                                Classes="icon"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="6"
                                ToolTip.Tip="Hapus Semua" AutomationProperties.Name="Hapus semua file">
                            <PathIcon Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,19V6H17V19H7M9,8V17H11V8H9M13,8V17H15V8H13Z"
                                      Width="16" Height="16"
                                      Foreground="{Binding TrashButtonBrush}"/>
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                </Style>
                            </Button.Styles>
                        </Button>

                        <!-- Pause/Resume Button (Processing) -->
                        <Button Command="{Binding PauseCommand}"
                                IsVisible="{Binding IsProcessing}"
                                Classes="icon primary"
                                ToolTip.Tip="Jeda / Lanjut Proses" AutomationProperties.Name="Jeda atau lanjutkan proses">
                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconPause}" Width="14" Height="14" IsVisible="{Binding !IsPaused}"
                                          Foreground="{Binding AccentColor, Converter={StaticResource LuminanceToBrushConverter}}" />
                                <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14" IsVisible="{Binding IsPaused}"
                                          Foreground="{Binding AccentColor, Converter={StaticResource LuminanceToBrushConverter}}" />
                            </Panel>
                        </Button>

                        <!-- Stop Button -->
                        <Button Command="{Binding StopCommand}"
                                IsVisible="{Binding IsProcessing}"
                                Classes="icon danger"
                                ToolTip.Tip="Hentikan Proses" AutomationProperties.Name="Hentikan proses">
                            <PathIcon Data="M18,18H6V6H18V18Z" Width="14" Height="14" Foreground="White"/>
                        </Button>

                        <!-- Process Button — PRIMARY, paling kanan -->
                        <Button Command="{Binding ProcessRemoveBgCommand}"
                                IsVisible="{Binding !IsProcessing}"
                                IsEnabled="{Binding HasFiles}"
                                Classes="primary" Padding="14,0" CornerRadius="7"
                                MinHeight="34"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                ToolTip.Tip="Mulai Hapus Background" AutomationProperties.Name="Mulai hapus background">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconProcess}" Width="14" Height="14"
                                          Foreground="{Binding AccentColor, Converter={StaticResource LuminanceToBrushConverter}}" />
                                <TextBlock Text="Remove BG" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{Binding AccentColor, Converter={StaticResource LuminanceToBrushConverter}}"/>
                            </StackPanel>
                            <Button.Styles>
                                <Style Selector="Button:disabled">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Style>
                            </Button.Styles>
                        </Button>

                        <!-- Photoshop Button (hidden for now) -->
                        <Button Command="{Binding OpenSelectedInPhotoshopCommand}"
                                IsVisible="False"
                                Background="#001E36" BorderBrush="#31A8FF" BorderThickness="1"
                                CornerRadius="6" Padding="8,0" MinHeight="34"
                                ToolTip.Tip="Buka di Photoshop (Multi-Select)">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="M4,2C2.89,2 2,2.89 2,4V20C2,21.11 2.89,22 4,22H20C21.11,22 22,21.11 22,20V4C22,2.89 21.11,2 20,2H4M4,4H20V20H4V4M6.5,7V10H9V12H6.5V17H11V14.5H8.5V13H12V9H9.5V8.5H12V7H6.5M13,9V14H14.5V12.5H16A1.5,1.5 0 0,0 17.5,11A1.5,1.5 0 0,0 16,9.5H13M14.5,10.5H16V11H14.5V10.5Z"
                                        Width="12" Height="12" Foreground="#31A8FF"/>
                                <TextBlock Text="{Binding SelectedCount}" Foreground="#31A8FF" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Toast Notification (Floating) -->
        <Border Margin="20,0,20,60" IsVisible="{Binding IsToastVisible}" ZIndex="200"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8" Padding="12,8"
                BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1"
                BoxShadow="0 4 20 0 #40000000"
                HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <PathIcon Grid.Column="0" Data="{Binding ToastIconData}" Width="16" Height="16"
                          Foreground="{Binding ToastIconBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Command="{Binding DismissToastCommand}"
                        Classes="icon quiet" Margin="8,0,0,0"
                        ToolTip.Tip="Tutup" AutomationProperties.Name="Tutup pemberitahuan">
                    <PathIcon Data="{StaticResource IconClose}"
                              Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>
         </Border>



<!-- Overlay: Settings -->
                            <Grid Grid.Column="0" Grid.ColumnSpan="3" IsVisible="{Binding IsSettingsOpen}" ZIndex="100">
                                 <!-- Background Dimmer (Button for Click-to-Close) -->
                                 <Button Background="#AA000000" Command="{Binding CloseSettingsCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                         CornerRadius="0" BorderThickness="0">
                                     <Button.Styles>
                                         <Style Selector="Button:pointerover /template/ ContentPresenter">
                                             <Setter Property="Background" Value="#AA000000"/>
                                         </Style>
                                     </Button.Styles>
                                 </Button>

                                 <Border Width="460" MaxHeight="500" VerticalAlignment="Center" HorizontalAlignment="Center"
                                         Background="{DynamicResource CardBackgroundBrush}"
                                         CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                         Padding="22,18"
                                         BoxShadow="0 10 40 0 #55000000">
                                     <Grid RowDefinitions="Auto, *, Auto">
                                         <!-- Header -->
                                         <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
                                             <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                             <TextBlock Text="Pengaturan" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                         </StackPanel>

                                         <!-- Content (Scrollable) -->
                                         <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="0,0,16,0">
                                             <StackPanel Spacing="14">
                                                <TextBlock Text="Model Remove BG"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           IsVisible="False"/>
                                                <!-- Remove BG Engine -->
                                                <Grid ColumnDefinitions="160, *" IsVisible="False">
                                                    <TextBlock Grid.Column="0" Text="Model Remove BG" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <ComboBox Grid.Column="1" Width="154" HorizontalAlignment="Right" Height="28"
                                                              SelectedItem="{Binding SelectedRemoveBgEngineOption}"
                                                              ItemsSource="{Binding RemoveBgEngineOptions}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Label}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>

                                                <!-- REMBG Model -->
                                                <Grid ColumnDefinitions="160, *" IsVisible="{Binding IsRembgSelected}">
                                                    <TextBlock Grid.Column="0" Text="REMBG Model" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <ComboBox Grid.Column="1" Width="154" HorizontalAlignment="Right" Height="28"
                                                              SelectedItem="{Binding RembgModel}"
                                                              ItemsSource="{Binding RembgModels}"/>
                                                </Grid>

                                                <!-- REMBG CLI Path (Optional) -->
                                                <Grid ColumnDefinitions="160, *" IsVisible="{Binding IsRembgSelected}">
                                                    <TextBlock Grid.Column="0" Text="Path rembg (opsional)" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <TextBox Grid.Column="1" Text="{Binding RembgExecutablePath}" Width="154" HorizontalAlignment="Right"
                                                             Watermark="contoh: C:\Python312\Scripts\rembg.exe" Height="28" Padding="8,4"/>
                                                </Grid>

                                                <!-- GPU Acceleration -->
                                                <Grid ColumnDefinitions="160, *" IsVisible="{Binding IsRembgSelected}">
                                                    <TextBlock Grid.Column="0" Text="Akselerasi GPU" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseGpuForRembg}" OnContent="ON" OffContent="OFF"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Alpha Matting -->
                                                <Grid ColumnDefinitions="160, *" IsVisible="{Binding IsRembgSelected}">
                                                    <TextBlock Grid.Column="0" Text="Alpha Matting" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AlphaMattingEnabled}" OnContent="ON" OffContent="OFF"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Alpha Matting Tuning -->
                                                <StackPanel IsVisible="{Binding IsAlphaMattingTuningVisible}" Spacing="8" Margin="0,5,0,5">
                                                    <Grid ColumnDefinitions="160, *, 30">
                                                        <TextBlock Grid.Column="0" Text="Erode Size" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="50" Value="{Binding AlphaMattingErodeSize}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="5,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding AlphaMattingErodeSize}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="160, *, 30">
                                                        <TextBlock Grid.Column="0" Text="Foreground Thresh" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding AlphaMattingForegroundThreshold}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="5,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding AlphaMattingForegroundThreshold}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="160, *, 30">
                                                        <TextBlock Grid.Column="0" Text="Background Thresh" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding AlphaMattingBackgroundThreshold}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="5,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding AlphaMattingBackgroundThreshold}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Grid>
                                                    <Button Content="Reset Default" Command="{Binding ResetAlphaMattingCommand}"
                                                            HorizontalAlignment="Right" FontSize="10" Padding="8,4" Background="Transparent"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                                                </StackPanel>

                                                <!-- REMBG OFFLINE RESOURCES MANAGER -->
                                                <Border Background="#10000000" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" IsVisible="{Binding IsRembgSelected}">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="Manajer Resource REMBG (All-in-One)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="Download engine Rembg portable beserta model secara otomatis. Aplikasi akan memprioritaskan versi lokal ini."
                                                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,4,0,0">
                                                            <TextBlock Grid.Column="0" Text="Status:" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding RembgInstallStatus}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0"
                                                                       Foreground="{Binding IsRembgInstalled, Converter={StaticResource BooleanToStatusBrushConverter}}"/>

                                                            <Button Grid.Column="2" Content="Install" Command="{Binding InstallRembgOfflineCommand}"
                                                                    IsVisible="{Binding !IsRembgInstalled}" IsEnabled="{Binding !IsInstallingRembg}"
                                                                    Background="{DynamicResource AccentBlueBrush}" Foreground="White" FontSize="11" Height="24" Padding="10,0"/>

                                                            <Button Grid.Column="3" Content="Hapus" Command="{Binding UninstallRembgOfflineCommand}"
                                                                    IsVisible="{Binding IsRembgInstalled}"
                                                                    Background="#EF4444" Foreground="White" FontSize="11" Height="24" Padding="10,0" Margin="5,0,0,0"/>
                                                        </Grid>

                                                        <ProgressBar IsVisible="{Binding IsInstallingRembg}" Value="{Binding RembgInstallProgress}" Maximum="100" Height="4" Margin="0,4,0,0" Foreground="{DynamicResource AccentBlueBrush}"/>
                                                    </StackPanel>
                                                </Border>

                                                <Grid ColumnDefinitions="160, *" IsVisible="False">
                                                    <TextBlock Grid.Column="0" Text="Mix Proxy" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding MixProxyEnabled}" OnContent="ON" OffContent="OFF"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>

                                                <Grid ColumnDefinitions="160, *" IsVisible="False">
                                                    <TextBlock Grid.Column="0" Text="Daftar Proxy" VerticalAlignment="Top"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding MixProxyList}" Width="220" HorizontalAlignment="Right"
                                                             Watermark="opsional: kosongkan untuk mode proxy otomatis"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="120" Padding="8,6"/>
                                                </Grid>

                                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,4,0,4"/>
                                                <TextBlock Text="Browser"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="Browser Playwright digunakan untuk proses Remove BG via web. Reset sesi akan menutup browser yang sedang idle — sesi baru dibuat otomatis saat proses berikutnya dimulai."
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>

                                                <Grid ColumnDefinitions="160, *">
                                                    <TextBlock Grid.Column="0" Text="Reset Sesi Browser" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <Button Grid.Column="1" Command="{Binding ResetBrowserCommand}"
                                                            Width="220" HorizontalAlignment="Right" Height="28"
                                                            Classes="quiet"
                                                            ToolTip.Tip="Tutup browser Playwright yang idle. Browser fresh akan dibuat saat proses berikutnya."
                                                            AutomationProperties.Name="Reset sesi browser">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14"/>
                                                            <TextBlock Text="Reset Browser Session"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <Grid ColumnDefinitions="160, *">
                                                    <TextBlock Grid.Column="0" Text="Tampilkan Browser" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowBrowser}"
                                                                  OnContent="Tampil" OffContent="Tersembunyi"
                                                                  HorizontalAlignment="Right" />
                                                </Grid>

                                                <!-- Ukuran Batch: kirim ke editor batch-edit per N file sekaligus -->
                                                <Grid ColumnDefinitions="160, *">
                                                    <TextBlock Grid.Column="0" Text="Ukuran Batch" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center" Spacing="8">
                                                        <TextBlock Text="foto sekaligus" FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <NumericUpDown Value="{Binding BatchSize}" Minimum="1" Maximum="10000"
                                                                       Increment="10"
                                                                       Width="110" Height="30" FontSize="12"
                                                                       ToolTip.Tip="Jumlah foto yang dikirim sekaligus ke editor batch. Akun gratis pixelcut maks 100 per sesi. Kalau list lebih dari angka ini (mis. 150), otomatis dipecah jadi 100 lalu 50 — diproses BERURUTAN. Kalau login Pro bisa dinaikkan sampai 10000."/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid ColumnDefinitions="160, *">
                                                    <TextBlock Grid.Column="0" Text="Tutup Browser Setelah Selesai" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCloseBrowser}"
                                                                  OnContent="Ya" OffContent="Tidak"
                                                                  HorizontalAlignment="Right" />
                                                </Grid>

                                                <Grid ColumnDefinitions="160, *">
                                                    <TextBlock Grid.Column="0" Text="Ukuran per Tab" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center" Spacing="8">
                                                        <TextBlock Text="foto per sub-batch" FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <NumericUpDown Value="{Binding BatchSubSize}" Minimum="1" Maximum="100"
                                                                       Increment="5"
                                                                       Width="110" Height="30" FontSize="12"
                                                                       ToolTip.Tip="Batch besar dipecah jadi sub-batch kecil supaya tidak crash mid-way. Disarankan 20-30."/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid ColumnDefinitions="160, *">
                                                    <TextBlock Grid.Column="0" Text="Login Akun Pixelcut" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <Button Grid.Column="1" Command="{Binding OpenBrowserForLoginCommand}"
                                                            Width="220" HorizontalAlignment="Right" Height="34" Classes="quiet"
                                                            ToolTip.Tip="Buka browser untuk login akun pixelcut. Sesi login tersimpan di profil, jadi proses otomatis berikutnya sudah login."
                                                            AutomationProperties.Name="Buka browser untuk login akun">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <PathIcon Data="{StaticResource IconLogin}" Width="14" Height="14"/>
                                                            <TextBlock Text="Buka Browser (Login Akun)"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>


                                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2,0,2"/>
                                                <TextBlock Text="Daftar Akun (Round-Robin)"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                                                <Grid ColumnDefinitions="160, *">
                                                    <TextBlock Grid.Column="0" Text="Round-Robin Aktif" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                                                               ToolTip.Tip="Kalau aktif dan ada akun terdaftar, antrian diproses bergiliran antar akun. Saat satu akun limit, otomatis pindah ke akun berikutnya."/>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseAccountRotation}"
                                                                  OnContent="Aktif" OffContent="Nonaktif"
                                                                  HorizontalAlignment="Right"/>
                                                </Grid>

                                                <ListBox ItemsSource="{Binding Accounts}"
                                                         SelectedItem="{Binding SelectedAccount}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         MaxHeight="240">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:PixaAccount">
                                                            <Border Margin="0,2,0,2" Padding="6,4" CornerRadius="6"
                                                                    BorderThickness="2"
                                                                    BorderBrush="{Binding IsActive, Converter={StaticResource BooleanToActiveAccountBrushConverter}}"
                                                                    Background="{DynamicResource CardBackgroundBrush}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0"
                                                                             VerticalAlignment="Center"
                                                                             Fill="{Binding IsActive, Converter={StaticResource BooleanToActiveAccountBrushConverter}}"/>
                                                                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2">
                                                                        <TextBox Text="{Binding Name}" FontSize="12" MinHeight="0" Height="26" Padding="6,2"
                                                                                 Watermark="Nama akun"/>
                                                                        <TextBlock Text="{Binding SessionStatusText}" FontSize="10"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="2" Margin="6,0,0,0" Height="30" FontSize="11" Classes="quiet"
                                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoginAccountCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="Buka browser dengan profil akun ini untuk login manual (sesi tersimpan)."
                                                                            AutomationProperties.Name="Login akun">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <PathIcon Data="{StaticResource IconLogin}" Width="13" Height="13"/>
                                                                            <TextBlock Text="Login"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Grid.Column="3" Margin="4,0,0,0" Classes="icon danger"
                                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveAccountCommand}"
                                                                            ToolTip.Tip="Hapus akun ini dari daftar."
                                                                            AutomationProperties.Name="Hapus akun"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                                    <Button Height="34" FontSize="12" Classes="quiet"
                                                            Command="{Binding AddAccountCommand}"
                                                            ToolTip.Tip="Tambah akun baru ke daftar rotasi."
                                                            AutomationProperties.Name="Tambah akun">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14"/>
                                                            <TextBlock Text="Tambah Akun"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="icon quiet"
                                                            Command="{Binding MoveAccountUpCommand}"
                                                            ToolTip.Tip="Naikkan urutan akun terpilih."
                                                            AutomationProperties.Name="Naikkan akun">
                                                        <PathIcon Data="{StaticResource IconChevronUp}" Width="16" Height="16"/>
                                                    </Button>
                                                    <Button Classes="icon quiet"
                                                            Command="{Binding MoveAccountDownCommand}"
                                                            ToolTip.Tip="Turunkan urutan akun terpilih."
                                                            AutomationProperties.Name="Turunkan akun">
                                                        <PathIcon Data="{StaticResource IconChevronDown}" Width="16" Height="16"/>
                                                    </Button>
                                                    <Button Height="34" FontSize="12" Classes="quiet"
                                                            Command="{Binding ResetAccountStatusCommand}"
                                                            ToolTip.Tip="Reset counter &amp; status limit semua akun (mulai sesi baru)."
                                                            AutomationProperties.Name="Reset status akun">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14"/>
                                                            <TextBlock Text="Reset Status"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <Border Background="#10000000" BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10">
                                                    <StackPanel Spacing="7">
                                                        <TextBlock Text="Cadangan akun" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="JSON menyimpan nama, urutan, batas sesi, akun aktif, dan pengenal profil—bukan API key, cookie, atau sesi login. Cadangkan folder BrowserProfile_&lt;suffix&gt; secara terpisah; jika folder tidak dipulihkan, login ulang melalui tombol Login akun."
                                                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                                            <Button Content="Ekspor JSON" Click="OnExportAccountBackupClick" Height="28" FontSize="11"/>
                                                            <Button Content="Pulihkan JSON" Click="OnImportAccountBackupClick" Height="28" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2,0,2"/>
                                                <TextBlock Text="Tampilan Warna"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                                                 <!-- Theme -->
                                                 <Grid ColumnDefinitions="160, *" RowDefinitions="Auto">
                                                     <TextBlock Grid.Column="0" Text="Mode Gelap" VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                     <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkTheme}" OnContent="" OffContent=""
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                 </Grid>

                                                 <!-- Accent Color: swatch preset (ringan) + input hex -->
                                                <Grid ColumnDefinitions="160, *">
                                                     <TextBlock Grid.Column="0" Text="Warna Aksen" VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="6">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                            <Button Classes="swatch" Background="#3b82f6" Command="{Binding SetAccentColorCommand}" CommandParameter="#3b82f6" ToolTip.Tip="Biru"/>
                                                            <Button Classes="swatch" Background="#8b5cf6" Command="{Binding SetAccentColorCommand}" CommandParameter="#8b5cf6" ToolTip.Tip="Ungu"/>
                                                            <Button Classes="swatch" Background="#10b981" Command="{Binding SetAccentColorCommand}" CommandParameter="#10b981" ToolTip.Tip="Hijau"/>
                                                            <Button Classes="swatch" Background="#f97316" Command="{Binding SetAccentColorCommand}" CommandParameter="#f97316" ToolTip.Tip="Oranye"/>
                                                            <Button Classes="swatch" Background="#ef4444" Command="{Binding SetAccentColorCommand}" CommandParameter="#ef4444" ToolTip.Tip="Merah"/>
                                                            <Button Classes="swatch" Background="#ec4899" Command="{Binding SetAccentColorCommand}" CommandParameter="#ec4899" ToolTip.Tip="Pink"/>
                                                        </StackPanel>
                                                        <TextBox Text="{Binding AccentColorHex}" Width="154" HorizontalAlignment="Right" Watermark="#HEX"
                                                                 VerticalAlignment="Center" FontSize="12" Height="28" Padding="8,4"/>
                                                    </StackPanel>
                                                 </Grid>

                                                 <!-- Custom Background: swatch preset + input hex -->
                                                <Grid ColumnDefinitions="160, *">
                                                     <TextBlock Grid.Column="0" Text="Warna Background" VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="6">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                            <Button Classes="swatch" Background="#121212" Command="{Binding SetBackgroundColorCommand}" CommandParameter="#121212" ToolTip.Tip="Hitam"/>
                                                            <Button Classes="swatch" Background="#1E1E1E" Command="{Binding SetBackgroundColorCommand}" CommandParameter="#1E1E1E" ToolTip.Tip="Abu Gelap"/>
                                                            <Button Classes="swatch" Background="#1A1C20" Command="{Binding SetBackgroundColorCommand}" CommandParameter="#1A1C20" ToolTip.Tip="Navy Gelap"/>
                                                            <Button Classes="swatch" Background="#2D2A3E" Command="{Binding SetBackgroundColorCommand}" CommandParameter="#2D2A3E" ToolTip.Tip="Ungu Gelap"/>
                                                            <Button Classes="swatch" Background="#1F2937" Command="{Binding SetBackgroundColorCommand}" CommandParameter="#1F2937" ToolTip.Tip="Slate"/>
                                                            <Button Classes="icon quiet"
                                                                    Command="{Binding ResetBackgroundColorCommand}" ToolTip.Tip="Reset ke default tema"
                                                                    AutomationProperties.Name="Reset warna latar">
                                                                <PathIcon Data="{StaticResource IconRefresh}" Width="15" Height="15"/>
                                                            </Button>
                                                        </StackPanel>
                                                        <TextBox Text="{Binding CurrentBackgroundColorHex}" Width="154" HorizontalAlignment="Right" Watermark="Default tema"
                                                                 VerticalAlignment="Center" FontSize="12" Height="28" Padding="8,4"/>
                                                    </StackPanel>
                                                 </Grid>
                                             </StackPanel>
                                         </ScrollViewer>

                                         <!-- Footer -->
                                         <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="0,14,0,0">
                                             <Button Grid.Column="0"
                                                     Command="{Binding SaveSettingsAndCloseCommand}"
                                                     IsEnabled="{Binding IsSettingsDirty}"
                                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                     Content="Simpan" Height="34"
                                                     Margin="0,0,10,0"
                                                     Background="{DynamicResource AccentBlueBrush}"
                                                     Foreground="{Binding AccentColor, Converter={StaticResource LuminanceToBrushConverter}}"
                                                     FontWeight="SemiBold"/>
                                             <Button Grid.Column="1"
                                                     Command="{Binding CloseSettingsCommand}"
                                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                     Content="Tutup" Height="34"
                                                     Background="#4B5563"
                                                     BorderBrush="#6B7280" BorderThickness="1"
                                                     Foreground="White"
                                                     FontWeight="SemiBold"/>
                                         </Grid>
                                     </Grid>
                                 </Border>
                             </Grid>
<!-- Overlay: Alert/Notification -->
                            <Grid Grid.Column="0" Grid.ColumnSpan="3" IsVisible="{Binding IsAlertOpen}" ZIndex="110">
                                <!-- Background Dimmer using Button for robustness -->
                                <Button Background="#AA000000" Command="{Binding CloseAlertCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                         CornerRadius="0" BorderThickness="0">
                                     <Button.Styles>
                                         <Style Selector="Button:pointerover /template/ ContentPresenter">
                                             <Setter Property="Background" Value="#AA000000"/>
                                         </Style>
                                     </Button.Styles>
                                 </Button>

                                <Border Width="300" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Padding="24"
                                        BoxShadow="0 10 40 0 #55000000">
                                    <StackPanel Spacing="20">
                                        <PathIcon Data="{StaticResource IconCheck}" Width="32" Height="32" Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding AlertMessage}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <Button Command="{Binding CloseAlertCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Content="OK" Margin="0,5,0,0"
                                                Background="{DynamicResource AccentBlueBrush}"
                                                Foreground="{Binding AccentColor, Converter={StaticResource LuminanceToBrushConverter}}"
                                                FontWeight="SemiBold" CornerRadius="6"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
<!-- Log Overlay -->
         <Grid IsVisible="{Binding IsLogOpen}" ZIndex="300" Background="#AA000000">
             <Button Background="Transparent" Command="{Binding ToggleLogCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="0" BorderThickness="0"/>
             <Border MaxWidth="700" MaxHeight="500" Margin="40" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                     Background="{DynamicResource CardBackgroundBrush}"
                     CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                     Padding="15" BoxShadow="0 10 40 0 #66000000">
                 <Grid RowDefinitions="Auto, *">
                     <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                         <PathIcon Data="M3,4H21V8H3V4M3,10H21V14H3V10M3,16H21V20H3V16Z" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                         <TextBlock Text="Log Proses" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                     </StackPanel>
                     <Border Grid.Row="1" Background="#0DFFFFFF" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                         <TextBox Text="{Binding LogOutput}" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0"
                                  FontFamily="Consolas, Monospace" FontSize="11" Foreground="#D4D4D4"
                                  TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  Padding="10"/>
                     </Border>
                 </Grid>
             </Border>
         </Grid>

         <!-- Confirm Import Dialog Overlay -->
         <Grid IsVisible="{Binding IsConfirmImportOpen}" ZIndex="300" Background="#AA000000">
             <Border Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                     Background="{DynamicResource CardBackgroundBrush}"
                     CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                     Padding="24"
                     BoxShadow="0 10 40 0 #66000000">
                 <StackPanel Spacing="16">
                     <!-- Icon & Title -->
                     <StackPanel Orientation="Horizontal" Spacing="12">
                         <!-- Yellow/Orange Triangle Warning Icon -->
                         <PathIcon Data="M12,2L1,21H23L12,2M12,6L19.53,19H4.47L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z"
                                   Width="20" Height="20" Foreground="#F59E0B" VerticalAlignment="Center"/>
                         <TextBlock Text="Peringatan Impor Folder" FontSize="15" FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                     </StackPanel>

                     <!-- Message -->
                     <TextBlock Text="{Binding ConfirmImportMessage}" FontSize="12.5"
                                Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="18"/>

                     <!-- Info Alert style hint -->
                     <Border Background="#15F59E0B" BorderBrush="#30F59E0B" BorderThickness="1" Padding="8" CornerRadius="4">
                         <TextBlock Text="Menyetujui akan memasukkan folder ini ke daftar aman sesi ini saja (di-reset setelah aplikasi ditutup)."
                                    FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                     </Border>

                     <!-- Buttons -->
                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                         <!-- Batal Button -->
                         <Button Content="Batal" Command="{Binding CancelImportCommand}"
                                 Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Padding="16,6" FontSize="12" Cursor="Hand" CornerRadius="6" />

                         <!-- Izinkan Button -->
                         <Button Content="Izinkan Proses" Command="{Binding AllowImportCommand}"
                                 Background="{DynamicResource AccentBlueBrush}" Foreground="White"
                                 Padding="16,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" CornerRadius="6" />
                     </StackPanel>
                 </StackPanel>
             </Border>
         </Grid>
       </Panel>
    </Border>
</Window>
