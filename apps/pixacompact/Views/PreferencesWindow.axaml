<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PixelcutCompact.Views.PreferencesWindow"
        Title="{DynamicResource Pref_Title}"
        Width="720" Height="580"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource EditorSurface}"
        Foreground="{StaticResource EditorTextPrimary}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PixelcutCompact/Resources/EditorTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource EditorTextSecondary}"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{StaticResource EditorBtnBgHover}"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{StaticResource EditorAccentDark}"/>
            <Setter Property="Foreground" Value="{StaticResource EditorTextPrimary}"/>
        </Style>
        <Style Selector="ListBoxItem:focus">
            <Setter Property="BorderBrush" Value="{StaticResource EditorFocus}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*, Auto">
        <!-- Konten: daftar kategori kiri + halaman kanan ala Photoshop Preferences -->
        <Grid Grid.Row="0" ColumnDefinitions="168, *">
            <Border Grid.Column="0" Background="{StaticResource EditorBg}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,0,1,0">
                <ListBox x:Name="LstCategories" Background="Transparent" BorderThickness="0"
                         Padding="6" SelectionChanged="OnCategoryChanged" SelectedIndex="0">
                    <ListBoxItem Content="{DynamicResource Pref_General}" Padding="10,9"/>
                    <ListBoxItem Content="{DynamicResource Pref_Language}" Padding="10,9"/>
                    <ListBoxItem Content="{DynamicResource Pref_Pen}" Padding="10,9"/>
                    <ListBoxItem Content="{DynamicResource Pref_Shortcuts}" Padding="10,9"/>
                </ListBox>
            </Border>
            <ScrollViewer Grid.Column="1" Padding="18,14" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="0" MaxWidth="500">
                    <StackPanel x:Name="PageGeneral" Spacing="2">
                        <TextBlock Text="{DynamicResource Pref_General}" FontWeight="SemiBold" Foreground="{StaticResource EditorTextPrimary}" FontSize="14" Margin="0,0,0,6"/>
                        <!-- Editor Beta Mode Toggle -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_BetaMode}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <CheckBox x:Name="ChkEditorBetaMode" Grid.Column="1" IsCheckedChanged="OnEditorBetaModeToggled" ToolTip.Tip="{DynamicResource Tip_BetaMode}"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource EditorBorder}" Margin="0,8"/>

                        <!-- === EDITOR EKSTERNAL === -->
                        <!-- Header: label + pilihan combo di satu baris -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                            <TextBlock Text="{DynamicResource Set_ExternalEditor}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{StaticResource EditorTextPrimary}"
                                       FontSize="12" TextWrapping="Wrap" ToolTip.Tip="{DynamicResource Tip_ExternalEditor}"/>
                            <ComboBox x:Name="CboExternalEditor" Grid.Column="1" Width="130"
                                      Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6"
                                      Foreground="{StaticResource EditorTextPrimary}" SelectionChanged="OnExternalEditorKindChanged">
                                <ComboBoxItem Content="PhotoCraft"/>
                                <ComboBoxItem Content="Photoshop"/>
                                <ComboBoxItem Content="Custom"/>
                            </ComboBox>
                        </Grid>

                        <!-- Path executable: label + textbox + tombol browse -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{DynamicResource Set_ExternalEditorPath}"
                                       VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}"
                                       FontSize="12" Margin="0,0,8,0" ToolTip.Tip="{DynamicResource Tip_ExternalEditorPath}"/>
                            <TextBox x:Name="TxtExternalEditorPath" Grid.Column="1"
                                     IsReadOnly="True" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}"
                                     CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}"
                                     FontSize="11" Watermark="{DynamicResource Watermark_ExternalEditorPath}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnBrowseExternalEditor" Grid.Column="2" Classes="quiet"
                                    Content="{DynamicResource Btn_Browse}" Click="OnBrowseExternalEditorClick"
                                    Margin="6,0,0,0" Padding="10,5" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="TxtExternalEditorHint" Text=""
                                   FontSize="10" Foreground="{StaticResource EditorTextSecondary}"
                                   TextWrapping="Wrap" Margin="0,4,0,4"/>


                        <!-- Background Type -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_Background}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <ComboBox x:Name="CboBgType" Grid.Column="1" Width="110" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" SelectionChanged="OnBgTypeChanged" Foreground="{StaticResource EditorTextPrimary}">
                                <ComboBoxItem Content="{DynamicResource Bg_Default}"/>
                                <ComboBoxItem Content="{DynamicResource Bg_Checker}"/>
                                <ComboBoxItem Content="{DynamicResource Bg_Solid}"/>
                            </ComboBox>
                        </Grid>

                        <!-- Solid Color Picker: Preset Swatches -->
                        <StackPanel x:Name="PanelSolidColor" Margin="0,4" IsVisible="False" Spacing="6">
                            <TextBlock Text="{DynamicResource Bg_SolidLabel}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                            <!-- Row 1 -->
                            <WrapPanel Orientation="Horizontal" ItemWidth="32" ItemHeight="32">
                                <!-- White -->
                                <Button x:Name="SwColor_FFFFFF" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#FFFFFF" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_WhiteHex}" AutomationProperties.Name="{DynamicResource Color_WhiteHex}"/>
                                <!-- Light Gray -->
                                <Button x:Name="SwColor_D1D5DB" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#D1D5DB" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_LightGrayHex}" AutomationProperties.Name="{DynamicResource Color_LightGrayHex}"/>
                                <!-- Gray -->
                                <Button x:Name="SwColor_6B7280" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#6B7280" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_GrayHex}" AutomationProperties.Name="{DynamicResource Color_GrayHex}"/>
                                <!-- Dark Gray -->
                                <Button x:Name="SwColor_1F2937" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#1F2937" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_DarkGrayHex}" AutomationProperties.Name="{DynamicResource Color_DarkGrayHex}"/>
                                <!-- Black -->
                                <Button x:Name="SwColor_000000" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#000000" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_BlackHex}" AutomationProperties.Name="{DynamicResource Color_BlackHex}"/>
                                <!-- Red -->
                                <Button x:Name="SwColor_EF4444" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#EF4444" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_Red}" AutomationProperties.Name="{DynamicResource Color_Red}"/>
                                <!-- Orange -->
                                <Button x:Name="SwColor_F97316" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#F97316" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_Orange}" AutomationProperties.Name="{DynamicResource Color_Orange}"/>
                                <!-- Yellow -->
                                <Button x:Name="SwColor_EAB308" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#EAB308" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_Yellow}" AutomationProperties.Name="{DynamicResource Color_Yellow}"/>
                                <!-- Green -->
                                <Button x:Name="SwColor_22C55E" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#22C55E" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_Green}" AutomationProperties.Name="{DynamicResource Color_Green}"/>
                                <!-- Green Screen -->
                                <Button x:Name="SwColor_00FF00" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#00FF00" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Tip_GreenScreen}" AutomationProperties.Name="{DynamicResource Tip_GreenScreen}"/>
                                <!-- Blue -->
                                <Button x:Name="SwColor_3B82F6" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#3B82F6" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_Blue}" AutomationProperties.Name="{DynamicResource Color_Blue}"/>
                                <!-- Purple -->
                                <Button x:Name="SwColor_8B5CF6" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#8B5CF6" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_Magenta}" AutomationProperties.Name="{DynamicResource Color_Magenta}"/>
                            </WrapPanel>
                            <!-- Active color preview + hex display -->
                            <Grid ColumnDefinitions="Auto, *">
                                <Border x:Name="BrdCurrentColor" Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtCurrentColorHex" Grid.Column="1" Text="#FFFFFF" FontSize="11" Foreground="{StaticResource EditorTextSecondary}" VerticalAlignment="Center" FontFamily="Consolas, Monospace"/>
                            </Grid>
                        </StackPanel>

                        <!-- Checkerboard Color Swatches -->
                        <StackPanel x:Name="PanelCheckerColor" Margin="0,4" IsVisible="False" Spacing="6">
                            <TextBlock Text="{DynamicResource Bg_Color1}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                            <WrapPanel Orientation="Horizontal" ItemWidth="32" ItemHeight="32">
                                <Button x:Name="CkColor1_FFFFFF" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#FFFFFF" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="{DynamicResource Color_White}" AutomationProperties.Name="{DynamicResource Color_White}"/>
                                <Button x:Name="CkColor1_CCCCCC" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#CCCCCC" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="{DynamicResource Color_VeryLightGray}" AutomationProperties.Name="{DynamicResource Color_VeryLightGray}"/>
                                <Button x:Name="CkColor1_999999" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#999999" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="{DynamicResource Color_LightGray}" AutomationProperties.Name="{DynamicResource Color_LightGray}"/>
                                <Button x:Name="CkColor1_666666" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#666666" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="{DynamicResource Color_Gray}" AutomationProperties.Name="{DynamicResource Color_Gray}"/>
                                <Button x:Name="CkColor1_4D4D4D" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#4D4D4D" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="{DynamicResource Color_OldGray}" AutomationProperties.Name="{DynamicResource Color_OldGray}"/>
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource Bg_Color2}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                            <WrapPanel Orientation="Horizontal" ItemWidth="32" ItemHeight="32">
                                <Button x:Name="CkColor2_AAAAAA" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#AAAAAA" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="{DynamicResource Color_MidGray}" AutomationProperties.Name="{DynamicResource Color_MidGray}"/>
                                <Button x:Name="CkColor2_555555" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#555555" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="{DynamicResource Color_DarkGray}" AutomationProperties.Name="{DynamicResource Color_DarkGray}"/>
                                <Button x:Name="CkColor2_333333" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#333333" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="{DynamicResource Color_NearBlack}" AutomationProperties.Name="{DynamicResource Color_NearBlack}"/>
                                <Button x:Name="CkColor2_1A1A1A" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#1A1A1A" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="{DynamicResource Color_VeryDark}" AutomationProperties.Name="{DynamicResource Color_VeryDark}"/>
                                <Button x:Name="CkColor2_000000" Classes="swatch" Width="28" Height="28" Margin="2" Padding="0" Background="#000000" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="{DynamicResource Color_Black}" AutomationProperties.Name="{DynamicResource Color_Black}"/>
                            </WrapPanel>
                            <!-- Preview kedua kotak -->
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <Border x:Name="BrdChecker1Preview" Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#333333" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Border x:Name="BrdChecker2Preview" Grid.Column="1" Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#4D4D4D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtCheckerHex" Grid.Column="2" Text="{DynamicResource Bg_CheckerColors}" FontSize="10" Foreground="{StaticResource EditorTextSecondary}" VerticalAlignment="Center" FontFamily="Consolas, Monospace"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PageLanguage" IsVisible="False" Spacing="2">
                        <TextBlock Text="{DynamicResource Pref_Language}" FontWeight="SemiBold" Foreground="{StaticResource EditorTextPrimary}" FontSize="14" Margin="0,0,0,6"/>
                        <!-- Bahasa / Language -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_Language}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <ComboBox x:Name="CboEditorLanguage" Grid.Column="1" Width="110" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="White" SelectionChanged="OnEditorLanguageChanged">
                                <ComboBoxItem Content="Indonesia"/>
                                <ComboBoxItem Content="English"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="PagePen" IsVisible="False" Spacing="2">
                        <TextBlock Text="{DynamicResource Pref_Pen}" FontWeight="SemiBold" Foreground="{StaticResource EditorTextPrimary}" FontSize="14" Margin="0,0,0,6"/>
                        <!-- Warna garis Pen -->
                        <TextBlock Text="{DynamicResource Set_PenColor}" Foreground="{StaticResource EditorTextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" VerticalAlignment="Center">
                            <StackPanel x:Name="PenSwatchRowSettings" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                            <Button x:Name="BtnPenCustomColorSettings" Classes="editor-compact" Content="{DynamicResource Btn_Custom}" FontSize="10" Foreground="White" ToolTip.Tip="{DynamicResource Tip_CustomPathColor}"/>
                        </StackPanel>
                        <!-- Tebal garis Pen -->
                        <TextBlock Text="{DynamicResource Set_PenThickness}" Foreground="{StaticResource EditorTextSecondary}" FontSize="12" Margin="0,10,0,0"/>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                            <Slider x:Name="SldPenThickness" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPenThickness" Grid.Column="1" FontSize="12" Foreground="{StaticResource EditorTextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="PageShortcuts" IsVisible="False" Spacing="2">
                        <TextBlock Text="{DynamicResource Pref_Shortcuts}" FontWeight="SemiBold" Foreground="{StaticResource EditorTextPrimary}" FontSize="14" Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource Set_PreviewNote}" TextWrapping="Wrap" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                        <!-- Next Image -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_NextImage}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <TextBox x:Name="TxtNextShortcut" Grid.Column="1" Width="110" TextAlignment="Center"
                                     IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown"
                                     Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6"
                                     Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                     Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/>
                        </Grid>

                        <!-- Prev Image -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_PrevImage}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <TextBox x:Name="TxtPrevShortcut" Grid.Column="1" Width="110" TextAlignment="Center"
                                     IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown"
                                     Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6"
                                     Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                     Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/>
                        </Grid>

                        <!-- Photoshop -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Text_OpenPhotoshop}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <TextBox x:Name="TxtPhotoshopShortcut" Grid.Column="1" Width="110" TextAlignment="Center"
                                     IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown"
                                     Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6"
                                     Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                     Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/>
                        </Grid>

                        <!-- Rotate Image -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_RotateImage}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <TextBox x:Name="TxtRotateShortcut" Grid.Column="1" Width="110" TextAlignment="Center"
                                     IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown"
                                     Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6"
                                     Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                     Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/>
                        </Grid>

                        <!-- Fit Screen -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_FitScreen}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <TextBox x:Name="TxtFitScreenShortcut" Grid.Column="1" Width="110" TextAlignment="Center"
                                     IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown"
                                     Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6"
                                     Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                     Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource EditorBorder}" Margin="0,5"/>
                        <TextBlock Text="{DynamicResource Set_EditActions}" FontWeight="SemiBold" Foreground="{StaticResource EditorTextPrimary}" FontSize="12"/>
                        <TextBlock Text="{DynamicResource Set_EditActionsNote}" TextWrapping="Wrap" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_Pan}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditPanShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_Move}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditMoveShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_Lasso}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditLassoShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_PolygonLasso}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditPolyLassoShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_MagicWand}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditWandShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_Pen}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditPenShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_Brush}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditBrushShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_Eraser}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditEraserShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_RefineEdge}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditRefineEdgeShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_RectMarquee}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditRectMarqueeShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_EllipseMarquee}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditEllipseMarqueeShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_BrushSizeDown}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditBrushSizeDownShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_BrushSizeUp}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditBrushSizeUpShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_ToggleBrushMode}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditBrushModeShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_QuickMask}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditQuickMaskShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_MaskDelete}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditMaskDeleteShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_MaskRestore}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditMaskRestoreShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_MakeSelection}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditMakeSelectionShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_MaskView}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditMaskViewShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="{StaticResource EditorBtnBg}" BorderBrush="{StaticResource EditorBtnBorder}" CornerRadius="6" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <TextBlock Text="{DynamicResource Set_FixedNote}" FontWeight="SemiBold" Foreground="{StaticResource EditorTextSecondary}" FontSize="11" Margin="0,8,0,4"/>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Undo}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+Z" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Redo}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+Shift+Z" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_SaveInPlace}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+S" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_SelectAll}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+A" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Deselect}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+D" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_InvertSel}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+Shift+I" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_GrowSel}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+J" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_ShrinkSel}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+Shift+J" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_RevertAll}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="F12" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_AddToSel}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+Shift+Enter" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Hud}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Alt+Right-drag" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Hardness}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Shift+[ / Shift+]" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Opacity}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="1..0" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Nudge}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Arrows / Shift+Arrows" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Tab}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Tab" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_ZoomKeys}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl++ / - / 0 / 1" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_CancelClose}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Escape" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_SaveCopy}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+Shift+S" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_CloseWindow}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+W" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Preferences}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+K" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <TextBlock Text="{DynamicResource Set_PathNote}" TextWrapping="Wrap" Foreground="{StaticResource EditorTextSecondary}" FontSize="10"/>
                        <Button Classes="quiet" Content="{DynamicResource Set_RestoreDefaults}" Click="OnRestoreShortcutDefaultsClick" HorizontalAlignment="Stretch" Padding="10,7" FontWeight="SemiBold" CornerRadius="6"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Tombol OK / Batal: seragam ukuran -->
        <Border Grid.Row="1" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,1,0,0" Background="{StaticResource EditorSurfaceAlt}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="BtnCancel" Classes="quiet" Content="{DynamicResource Btn_Cancel}" Width="104" Height="36"
                        Padding="0,8" HorizontalContentAlignment="Center" FontSize="12"
                        Click="OnCancelClick"/>
                <Button x:Name="BtnOk" Classes="primary" Content="{DynamicResource Btn_OK}" Width="104" Height="36"
                        Padding="0,8" HorizontalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"
                        Click="OnOkClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
