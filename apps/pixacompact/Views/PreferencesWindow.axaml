<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PixelcutCompact.Views.PreferencesWindow"
        Title="{DynamicResource Pref_Title}"
        Width="720" Height="580"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#2B2B2B"
        Foreground="White">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PixelcutCompact/Resources/EditorTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid RowDefinitions="*, Auto">
        <!-- Konten: daftar kategori kiri + halaman kanan ala Photoshop Preferences -->
        <Grid Grid.Row="0" ColumnDefinitions="168, *">
            <Border Grid.Column="0" Background="#242424" BorderBrush="#3A3A3A" BorderThickness="0,0,1,0">
                <ListBox x:Name="LstCategories" Background="Transparent" BorderThickness="0"
                         Padding="6" SelectionChanged="OnCategoryChanged" SelectedIndex="0">
                    <ListBoxItem Content="{DynamicResource Pref_General}" Padding="10,9"/>
                    <ListBoxItem Content="{DynamicResource Pref_Language}" Padding="10,9"/>
                    <ListBoxItem Content="{DynamicResource Pref_Pen}" Padding="10,9"/>
                    <ListBoxItem Content="{DynamicResource Pref_Shortcuts}" Padding="10,9"/>
                </ListBox>
            </Border>
            <ScrollViewer Grid.Column="1" Padding="18,14" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="0" MaxWidth="500">
                    <StackPanel x:Name="PageGeneral" Spacing="2">
                        <TextBlock Text="{DynamicResource Pref_General}" FontWeight="SemiBold" Foreground="{StaticResource EditorTextPrimary}" FontSize="14" Margin="0,0,0,6"/>
                        <!-- Editor Beta Mode Toggle -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_BetaMode}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <CheckBox x:Name="ChkEditorBetaMode" Grid.Column="1" IsCheckedChanged="OnEditorBetaModeToggled" ToolTip.Tip="{DynamicResource Tip_BetaMode}"/>
                        </Grid>
                        <!-- Background Type -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_Background}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <ComboBox x:Name="CboBgType" Grid.Column="1" Width="110" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" SelectionChanged="OnBgTypeChanged" Foreground="White">
                                <ComboBoxItem Content="{DynamicResource Bg_Default}"/>
                                <ComboBoxItem Content="{DynamicResource Bg_Checker}"/>
                                <ComboBoxItem Content="{DynamicResource Bg_Solid}"/>
                            </ComboBox>
                        </Grid>

                        <!-- Solid Color Picker: Preset Swatches -->
                        <StackPanel x:Name="PanelSolidColor" Margin="0,4" IsVisible="False" Spacing="6">
                            <TextBlock Text="{DynamicResource Bg_SolidLabel}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                            <!-- Row 1 -->
                            <WrapPanel Orientation="Horizontal" ItemWidth="24" ItemHeight="24">
                                <!-- White -->
                                <Button x:Name="SwColor_FFFFFF" Width="22" Height="22" Margin="1" Padding="0" Background="#FFFFFF" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_WhiteHex}"/>
                                <!-- Light Gray -->
                                <Button x:Name="SwColor_D1D5DB" Width="22" Height="22" Margin="1" Padding="0" Background="#D1D5DB" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_LightGrayHex}"/>
                                <!-- Gray -->
                                <Button x:Name="SwColor_6B7280" Width="22" Height="22" Margin="1" Padding="0" Background="#6B7280" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_GrayHex}"/>
                                <!-- Dark Gray -->
                                <Button x:Name="SwColor_1F2937" Width="22" Height="22" Margin="1" Padding="0" Background="#1F2937" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_DarkGrayHex}"/>
                                <!-- Black -->
                                <Button x:Name="SwColor_000000" Width="22" Height="22" Margin="1" Padding="0" Background="#000000" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_BlackHex}"/>
                                <!-- Red -->
                                <Button x:Name="SwColor_EF4444" Width="22" Height="22" Margin="1" Padding="0" Background="#EF4444" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_Red}"/>
                                <!-- Orange -->
                                <Button x:Name="SwColor_F97316" Width="22" Height="22" Margin="1" Padding="0" Background="#F97316" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_Orange}"/>
                                <!-- Yellow -->
                                <Button x:Name="SwColor_EAB308" Width="22" Height="22" Margin="1" Padding="0" Background="#EAB308" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_Yellow}"/>
                                <!-- Green -->
                                <Button x:Name="SwColor_22C55E" Width="22" Height="22" Margin="1" Padding="0" Background="#22C55E" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_Green}"/>
                                <!-- Green Screen -->
                                <Button x:Name="SwColor_00FF00" Width="22" Height="22" Margin="1" Padding="0" Background="#00FF00" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Tip_GreenScreen}"/>
                                <!-- Blue -->
                                <Button x:Name="SwColor_3B82F6" Width="22" Height="22" Margin="1" Padding="0" Background="#3B82F6" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_Blue}"/>
                                <!-- Purple -->
                                <Button x:Name="SwColor_8B5CF6" Width="22" Height="22" Margin="1" Padding="0" Background="#8B5CF6" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnColorSwatchClick" ToolTip.Tip="{DynamicResource Color_Magenta}"/>
                            </WrapPanel>
                            <!-- Active color preview + hex display -->
                            <Grid ColumnDefinitions="Auto, *">
                                <Border x:Name="BrdCurrentColor" Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtCurrentColorHex" Grid.Column="1" Text="#FFFFFF" FontSize="11" Foreground="{StaticResource EditorTextSecondary}" VerticalAlignment="Center" FontFamily="Consolas, Monospace"/>
                            </Grid>
                        </StackPanel>

                        <!-- Checkerboard Color Swatches -->
                        <StackPanel x:Name="PanelCheckerColor" Margin="0,4" IsVisible="False" Spacing="6">
                            <TextBlock Text="{DynamicResource Bg_Color1}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                            <WrapPanel Orientation="Horizontal" ItemWidth="24" ItemHeight="24">
                                <Button x:Name="CkColor1_FFFFFF" Width="22" Height="22" Margin="1" Padding="0" Background="#FFFFFF" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="{DynamicResource Color_White}"/>
                                <Button x:Name="CkColor1_CCCCCC" Width="22" Height="22" Margin="1" Padding="0" Background="#CCCCCC" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="{DynamicResource Color_VeryLightGray}"/>
                                <Button x:Name="CkColor1_999999" Width="22" Height="22" Margin="1" Padding="0" Background="#999999" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="{DynamicResource Color_LightGray}"/>
                                <Button x:Name="CkColor1_666666" Width="22" Height="22" Margin="1" Padding="0" Background="#666666" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="{DynamicResource Color_Gray}"/>
                                <Button x:Name="CkColor1_4D4D4D" Width="22" Height="22" Margin="1" Padding="0" Background="#4D4D4D" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker1SwatchClick" ToolTip.Tip="{DynamicResource Color_OldGray}"/>
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource Bg_Color2}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                            <WrapPanel Orientation="Horizontal" ItemWidth="24" ItemHeight="24">
                                <Button x:Name="CkColor2_AAAAAA" Width="22" Height="22" Margin="1" Padding="0" Background="#AAAAAA" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="{DynamicResource Color_MidGray}"/>
                                <Button x:Name="CkColor2_555555" Width="22" Height="22" Margin="1" Padding="0" Background="#555555" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="{DynamicResource Color_DarkGray}"/>
                                <Button x:Name="CkColor2_333333" Width="22" Height="22" Margin="1" Padding="0" Background="#333333" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="{DynamicResource Color_NearBlack}"/>
                                <Button x:Name="CkColor2_1A1A1A" Width="22" Height="22" Margin="1" Padding="0" Background="#1A1A1A" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="{DynamicResource Color_VeryDark}"/>
                                <Button x:Name="CkColor2_000000" Width="22" Height="22" Margin="1" Padding="0" Background="#000000" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Click="OnChecker2SwatchClick" ToolTip.Tip="{DynamicResource Color_Black}"/>
                            </WrapPanel>
                            <!-- Preview kedua kotak -->
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <Border x:Name="BrdChecker1Preview" Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#333333" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Border x:Name="BrdChecker2Preview" Grid.Column="1" Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#4D4D4D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtCheckerHex" Grid.Column="2" Text="{DynamicResource Bg_CheckerColors}" FontSize="10" Foreground="{StaticResource EditorTextSecondary}" VerticalAlignment="Center" FontFamily="Consolas, Monospace"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PageLanguage" IsVisible="False" Spacing="2">
                        <TextBlock Text="{DynamicResource Pref_Language}" FontWeight="SemiBold" Foreground="{StaticResource EditorTextPrimary}" FontSize="14" Margin="0,0,0,6"/>
                        <!-- Bahasa / Language -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_Language}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <ComboBox x:Name="CboEditorLanguage" Grid.Column="1" Width="110" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="White" SelectionChanged="OnEditorLanguageChanged">
                                <ComboBoxItem Content="Indonesia"/>
                                <ComboBoxItem Content="English"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="PagePen" IsVisible="False" Spacing="2">
                        <TextBlock Text="{DynamicResource Pref_Pen}" FontWeight="SemiBold" Foreground="{StaticResource EditorTextPrimary}" FontSize="14" Margin="0,0,0,6"/>
                        <!-- Warna garis Pen -->
                        <TextBlock Text="{DynamicResource Set_PenColor}" Foreground="{StaticResource EditorTextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" VerticalAlignment="Center">
                            <StackPanel x:Name="PenSwatchRowSettings" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                            <Button x:Name="BtnPenCustomColorSettings" Classes="editor-compact" Content="{DynamicResource Btn_Custom}" FontSize="10" Foreground="White" ToolTip.Tip="{DynamicResource Tip_CustomPathColor}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PageShortcuts" IsVisible="False" Spacing="2">
                        <TextBlock Text="{DynamicResource Pref_Shortcuts}" FontWeight="SemiBold" Foreground="{StaticResource EditorTextPrimary}" FontSize="14" Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource Set_PreviewNote}" TextWrapping="Wrap" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                        <!-- Next Image -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_NextImage}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <TextBox x:Name="TxtNextShortcut" Grid.Column="1" Width="110" TextAlignment="Center"
                                     IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown"
                                     Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3"
                                     Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                     Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/>
                        </Grid>

                        <!-- Prev Image -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_PrevImage}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <TextBox x:Name="TxtPrevShortcut" Grid.Column="1" Width="110" TextAlignment="Center"
                                     IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown"
                                     Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3"
                                     Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                     Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/>
                        </Grid>

                        <!-- Photoshop -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Text_OpenPhotoshop}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <TextBox x:Name="TxtPhotoshopShortcut" Grid.Column="1" Width="110" TextAlignment="Center"
                                     IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown"
                                     Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3"
                                     Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                     Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/>
                        </Grid>

                        <!-- Rotate Image -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_RotateImage}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <TextBox x:Name="TxtRotateShortcut" Grid.Column="1" Width="110" TextAlignment="Center"
                                     IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown"
                                     Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3"
                                     Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                     Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/>
                        </Grid>

                        <!-- Fit Screen -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <TextBlock Text="{DynamicResource Set_FitScreen}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/>
                            <TextBox x:Name="TxtFitScreenShortcut" Grid.Column="1" Width="110" TextAlignment="Center"
                                     IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown"
                                     Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3"
                                     Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold"
                                     Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource EditorBorder}" Margin="0,5"/>
                        <TextBlock Text="{DynamicResource Set_EditActions}" FontWeight="SemiBold" Foreground="{StaticResource EditorTextPrimary}" FontSize="12"/>
                        <TextBlock Text="{DynamicResource Set_EditActionsNote}" TextWrapping="Wrap" Foreground="{StaticResource EditorTextSecondary}" FontSize="11"/>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_Pan}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditPanShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_Move}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditMoveShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_Lasso}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditLassoShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_PolygonLasso}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditPolyLassoShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_MagicWand}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditWandShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_Pen}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditPenShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_Brush}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditBrushShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_Eraser}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditEraserShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_RefineEdge}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditRefineEdgeShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_RectMarquee}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditRectMarqueeShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_EllipseMarquee}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditEllipseMarqueeShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_BrushSizeDown}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditBrushSizeDownShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_BrushSizeUp}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditBrushSizeUpShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_ToggleBrushMode}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditBrushModeShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_QuickMask}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditQuickMaskShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_MaskDelete}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditMaskDeleteShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_MaskRestore}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditMaskRestoreShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_MakeSelection}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditMakeSelectionShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Sc_MaskView}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBox x:Name="TxtEditMaskViewShortcut" Grid.Column="1" Width="100" TextAlignment="Center" IsReadOnly="True" KeyDown="OnShortcutTextBoxKeyDown" Background="#10FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="3" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{DynamicResource Set_ClickPress}" Watermark="{DynamicResource Set_PressKey}"/></Grid>
                        <TextBlock Text="{DynamicResource Set_FixedNote}" FontWeight="SemiBold" Foreground="{StaticResource EditorTextSecondary}" FontSize="11" Margin="0,8,0,4"/>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Undo}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+Z" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Redo}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+Shift+Z" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_SaveInPlace}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+S" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_SelectAll}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+A" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Deselect}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+D" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_InvertSel}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+Shift+I" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_GrowSel}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+J" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_ShrinkSel}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+Shift+J" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_RevertAll}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="F12" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_AddToSel}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl+Shift+Enter" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Hud}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Alt+Right-drag" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Hardness}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Shift+[ / Shift+]" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Opacity}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="1..0" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Nudge}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Arrows / Shift+Arrows" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_Tab}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Tab" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_ZoomKeys}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl++ / - / 0 / 1" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2"><TextBlock Text="{DynamicResource Fx_CancelClose}" VerticalAlignment="Center" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Escape" Foreground="{StaticResource EditorTextSecondary}" FontSize="12"/></Grid>
                        <TextBlock Text="{DynamicResource Set_PathNote}" TextWrapping="Wrap" Foreground="{StaticResource EditorTextSecondary}" FontSize="10"/>
                        <Button Content="{DynamicResource Set_RestoreDefaults}" Click="OnRestoreShortcutDefaultsClick" HorizontalAlignment="Stretch" Padding="10,7" Background="{StaticResource EditorBtnBg}" Foreground="White" FontWeight="SemiBold" CornerRadius="3" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Tombol OK / Batal: seragam ukuran -->
        <Border Grid.Row="1" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Background="#242424" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="BtnCancel" Content="{DynamicResource Btn_Cancel}" Width="96"
                        Padding="0,8" HorizontalContentAlignment="Center" FontSize="12"
                        Background="#3A3A3A" Foreground="White" CornerRadius="3" Cursor="Hand"
                        Click="OnCancelClick"/>
                <Button x:Name="BtnOk" Content="{DynamicResource Btn_OK}" Width="96"
                        Padding="0,8" HorizontalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"
                        Background="#31A8FF" Foreground="White" CornerRadius="3" Cursor="Hand"
                        Click="OnOkClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
